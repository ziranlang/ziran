#!/usr/bin/env -S ziran run --target=c
// Whole-suite build times. Run through bench.zi and Alpha's build-queue.
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_tree_linux"
#import "std/float_text"
#import "std/json_document"
#import "std/number_text"
#import "std/process_run_linux"
#import "std/text_tools"
#import "std/timer_linux"
Stats :: #import "benchmark_statistics";
using Vectors :: #import "std/vec"

// Build-time samples for one column; Vec views need a named field.
ColumnSamples :: struct { values: Vec(float64); }
SETTINGS: [16]string = .["DISPLAY","WAYLAND_DISPLAY","XAUTHORITY","DBUS_SESSION_BUS_ADDRESS",
    "ZIRAN_PROFILE","ZIRAN_VM_PROFILE","ZIRAN_LEARN=off","CFLAGS=-O2","GOTOOLCHAIN=local",
    "GOPROXY=off","GOSUMDB=off","GOWORK=off","GOFLAGS=","GO111MODULE=off","GOMAXPROCS=2","LDFLAGS="];
Capture :: (command: string) -> (output: string, code: s32) {
    args: [3]string = .["/bin/sh","-ec",command]
    options: ProcessOptions = .{arguments=args[:],environment=SETTINGS[:],capture_output=true,merge_error=true}
    run: ProcessRun
    if !RunProcess(options,*run) { return "", 127 }
    return TextDetach(TextCopy(BuilderFinish(run.output))), run.code
}
PutText :: (doc: *JsonDocument, node: s32, name: string, value: string) {
    JsonSet(doc,node,name,JsonNewStringCopy(doc,value))
}
PutReal :: (doc: *JsonDocument, node: s32, name: string, value: float64) {
    JsonSet(doc,node,name,JsonNewNumber(doc,Float64Repr(value)))
}
// Fixed commands; caller text is never interpolated into shell source.
BuildCommand :: (column: s32) -> string {
    if column == 0 { return "cc -O2 -std=c11 -DSTANDARD_REFERENCE bench/standard/reference.c bench/standard/host.c -lm -o build/standard-compile/c" }
    if column == 1 { return "go build -o build/standard-compile/go build/standard-compile/reference.go build/standard-compile/host.go" }
    if column == 2 { return "build/bin/ziran build --target=c --exe --root bench --module-path std --module-path standard=bench/standard --entry standard_compile_entry:main -o build/standard-compile/generated bench/standard_compile_entry.zi" }
    if column == 3 { return "build/bin/zi2zx --root bench/standard --module-path std --entry entry:main -o build/standard-compile/native.zx bench/standard/entry.zi && cc -O2 -std=c11 -Iinclude bench/standard_compile_host.c build/libziran.a -lm -pthread -ldl -o build/standard-compile/native && build/standard-compile/native build/standard-compile/native.zx" }
    return "build/bin/zi2zx --root bench/standard --module-path std --entry entry:main -o build/standard-compile/wasm.zx bench/standard/entry.zi && build/bin/zx2wasm -o build/standard-compile/suite.wasm build/standard-compile/wasm.zx"
}
Number :: (value: s64) -> string {
    buffer: [64]u8
    return TextDetach(TextCopy(FormatInteger(value,buffer[:])))
}
Validate :: (column: s32, repetition: s32) -> bool {
    // The 11 timed builds cover every workload; warmup checks Fibonacci.
    kind := ifx repetition == 0 then cast(s32)0 else repetition-1
    probes: [11]s64 = .[10,10,10,17,5,6,10,5,8,17,10]
    oracle_args: [5]string = .["build/standard-compile/c - ",Number(kind)," ",Number(probes[kind])," 11 oracle"]
    oracle_text, oracle_code := Capture(TextJoin(oracle_args[:],""))
    oracle: JsonDocument
    if oracle_code != 0 || !JsonRead(*oracle,oracle_text) { return false }
    expected := JsonString(*oracle,JsonMember(*oracle,oracle.root,"result"))
    parsed, valid := TextInteger(expected)
    if !valid { return false }
    // Only formatted integers enter these shell commands.
    program := ifx column == 0 then "build/standard-compile/c - " else "build/standard-compile/go - "
    if column == 2 { program = "build/standard-compile/generated/standard_compile_entry " }
    if column == 3 { program = "build/standard-compile/native build/standard-compile/native.zx " }
    if column == 4 { program = "node bench/standard/host.cjs build/standard-compile/suite.wasm " }
    suffix := ifx column == 2 then "" else ifx column == 3 then " " else " 11 "
    args: [7]string = .[program,Number(kind)," ",Number(probes[kind]),suffix,
        ifx column == 2 then "" else Number(parsed),""]
    command := TextJoin(args[:],"")
    text, code := Capture(command)
    if code != 0 { print("validation failed: %\n%\n",command,text); return false }
    if column == 2 || column == 3 { return TextTrim(text) == expected }
    doc: JsonDocument
    return JsonRead(*doc,text) && JsonString(*doc,JsonMember(*doc,doc.root,"result")) == expected
}
main :: (argc: s32, argv: **u8) -> s32 {
    output := "bench/results/standard/compile.json"
    if argc == 2 && TextFromCString(argv[1]) == "--help" {
        print("standard_compile.zi [--out PATH] [--validate]\n"); return 0
    }
    validate_only := argc == 2 && TextFromCString(argv[1]) == "--validate"
    if argc == 3 && TextFromCString(argv[1]) == "--out" { output = TextFromCString(argv[2]) }
    else if argc != 1 && !validate_only { return 2 }
    host, host_code := Capture("hostname -s")
    virt, virt_code := Capture("systemd-detect-virt")
    if host_code != 0 || TextTrim(host) != "alpha" || virt_code != 1 || TextTrim(virt) != "none" {
        print("compile benchmarks require the physical Alpha host\n"); return 2
    }
    if IsFile(output) || !CreateDirectories("build/standard-compile") || !CreateDirectories(PathParent(output)) { return 2 }
    revision, revision_code := Capture("git rev-parse HEAD")
    provenance_command := "sha256sum build/bin/ziran build/bin/zi2c build/bin/zi2zx build/bin/zx2wasm build/libziran.a bench/standard_compile.zi bench/standard_compile_entry.zi bench/standard_compile_host.c bench/standard/entry.zi bench/standard/kernels.zi bench/standard/reference.c bench/standard/host.c bench/standard/reference.go bench/standard/host.go"
    provenance, provenance_code := Capture(provenance_command)
    if revision_code != 0 || provenance_code != 0 { return 1 }
    doc: JsonDocument; root := JsonNewObject(*doc)
    JsonSet(*doc,root,"schema_version",JsonNewInteger(*doc,1))
    PutText(*doc,root,"revision",TextTrim(revision)); PutText(*doc,root,"host",TextTrim(host))
    cpu, cpu_code := Capture("sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1")
    versions, versions_code := Capture("cc --version | head -1; go version; node --version")
    stamp, stamp_code := Capture("date -u +%Y-%m-%dT%H:%M:%SZ")
    if cpu_code != 0 || versions_code != 0 || stamp_code != 0 { return 1 }
    PutText(*doc,root,"cpu",TextTrim(cpu)); PutText(*doc,root,"versions",TextTrim(versions))
    PutText(*doc,root,"measured_at",TextTrim(stamp))
    PutText(*doc,root,"virtualization","none"); PutText(*doc,root,"learning","off")
    PutText(*doc,root,"source_and_tool_sha256",provenance)
    PutText(*doc,root,"methodology","Whole standard suite; warm filesystem/toolchain caches. One warmup then 11 fresh application builds, rotating target order. Generated C includes cc -O2/link; native includes ZX frontend, host cc/link and native instantiation. Wasm includes ZX frontend and wasm emission, excludes V8 compilation. Validation outside timing. Go source nonce forces application cache miss; standard-library cache stays warm. No fast compiler mode exists. Symmetric inclusive 1.5xIQR; raw samples retained.")
    JsonSet(*doc,root,"checks",JsonNewBool(*doc,false))
    JsonSet(*doc,root,"samples",JsonNewInteger(*doc,11))
    columns: [5]string = .["c","go","generated-c","native","wasm"]
    samples: [5]ColumnSamples
    raw := JsonNewArray(*doc); JsonSet(*doc,root,"builds",raw)
    reference, reference_ok := ReadEntireFile("bench/standard/reference.go")
    go_host, host_ok := ReadEntireFile("bench/standard/host.go")
    if !reference_ok || !host_ok || !WriteEntireFile("build/standard-compile/host.go",go_host) { return 1 }
    last := ifx validate_only then cast(s32)0 else cast(s32)11
    for repetition: cast(s32)0..last {
        for offset: cast(s32)0..4 {
            column := (offset + repetition) % 5
            nonce: [64]u8
            parts: [3]string = .[reference,"\n// compile sample ",FormatInteger(MonotonicNanoseconds(),nonce[:])]
            if column == 1 && !WriteEntireFile("build/standard-compile/reference.go",TextJoin(parts[:],"")) { return 1 }
            if column == 2 {
                cleaned, clean_code := Capture("rm -rf -- build/standard-compile/generated")
                if clean_code != 0 { print("%",cleaned); return 1 }
            }
            command := BuildCommand(column)
            args: [3]string = .["/bin/sh","-ec",command]
            options: ProcessOptions = .{arguments=args[:],environment=SETTINGS[:],output_path="build/standard-compile/build.log",merge_error=true}
            run: ProcessRun
            started := MonotonicNanoseconds()
            ok := RunProcess(options,*run)
            milliseconds := cast(float64)(MonotonicNanoseconds()-started)/1000000.0
            if !ok || run.code != 0 { print("build failed: % (see build/standard-compile/build.log)\n",command); return 1 }
            if !Validate(column,repetition) { return 1 }
            if repetition > 0 { unused VecPush(samples[column].values,milliseconds) }
            row := JsonNewObject(*doc); unused JsonAppend(*doc,raw,row)
            PutText(*doc,row,"target",columns[column]); PutText(*doc,row,"command",command)
            JsonSet(*doc,row,"warmup",JsonNewBool(*doc,repetition == 0))
            JsonSet(*doc,row,"repetition",JsonNewInteger(*doc,repetition))
            PutReal(*doc,row,"wall_ms",milliseconds)
            JsonSet(*doc,row,"output_verified",JsonNewBool(*doc,true))
            progress: [2]string = .[output,".partial"]
            if !validate_only && !WriteEntireFile(TextJoin(progress[:],""),JsonWrite(*doc,root,JsonPythonStyle(2))) { return 1 }
            print("% sample % verified\n",columns[column],repetition)
        }
    }
    after, after_code := Capture(provenance_command)
    if after_code != 0 || after != provenance { print("sources/tools changed during measurement\n"); return 1 }
    if validate_only { return 0 }
    summary := JsonNewObject(*doc); JsonSet(*doc,root,"targets",summary)
    for column: cast(s32)0..4 {
        column_samples := *samples[column]
        analyzed := Stats.BenchmarkAnalyze(column_samples.values[:])
        if !analyzed.valid { return 1 }
        cell := JsonNewObject(*doc); JsonSet(*doc,summary,columns[column],cell)
        PutReal(*doc,cell,"median_ms",analyzed.median)
        values := JsonNewArray(*doc); JsonSet(*doc,cell,"raw_ms",values)
        for value: column_samples.values { unused JsonAppend(*doc,values,JsonNewNumber(*doc,Float64Repr(value))) }
        excluded := JsonNewArray(*doc); JsonSet(*doc,cell,"excluded_indices",excluded)
        for index: analyzed.excluded { unused JsonAppend(*doc,excluded,JsonNewInteger(*doc,index)) }
    }
    JsonSet(*doc,root,"complete",JsonNewBool(*doc,true))
    return ifx WriteEntireFile(output,JsonWrite(*doc,root,JsonPythonStyle(2))) then 0 else 1
}
