// C executable adapter for the same runtime-selected standard kernels.
K :: #import "standard/kernels";
libc :: #system_library "libc";
Parse :: (text: *u8) -> s64 #foreign libc "atoll";
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 3 { return 2 }
    print("%\n",K.Run(Parse(argv[1]),Parse(argv[2])))
    return 0
}
