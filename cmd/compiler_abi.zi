using Lir :: #import "compiler_lowered_ir"
using Image :: #import "compiler_machine_image"
using Machine :: #import "compiler_machine_ir"
using Target :: #import "compiler_target"

// Target facts for machine lowering, allocation and verification. Callers
// ask for registers and supported forms through the exported queries below
// and never name a target's registers themselves.

#scope_file

// Register numbers follow the x86-64 encoding order. Register classes keep
// general and XMM numbers in separate namespaces.
X64Register :: enum s32 {
    Rax; Rcx; Rdx; Rbx; Rsp; Rbp; Rsi; Rdi; R8; R9; R10; R11; R12; R13; R14; R15
}

AbiClass :: (program: LirProgram, type_id: s32) -> MachineRegisterClass {
    if type_id < 0 || type_id >= program.types.count { return .Invalid }
    type := program.types[type_id]
    if type.kind == .Float { return .Float }
    if type.kind == .Bool || type.kind == .Integer || type.kind == .Pointer ||
        type.kind == .Function { return .General }
    if type.kind == .Array || type.kind == .Record { return .Stack }
    if type.kind == .Vector { return .Vector }
    return .Invalid
}

AbiSize :: (program: LirProgram, type_id: s32, depth: s32) -> s64 {
    if depth > 256 || type_id < 0 || type_id >= program.types.count { return -1 }
    type := program.types[type_id]
    if type.kind == .Void { return 0 }
    if type.kind == .Bool { return 1 }
    if type.kind == .Integer || type.kind == .Float {
        if type.bits <= 0 || type.bits > 64 { return -1 }
        return (type.bits + 7) / 8
    }
    if type.kind == .Pointer || type.kind == .Function { return 8 }
    if type.kind == .Array {
        element := AbiSize(program, type.element, depth + 1)
        if element < 0 || type.count < 0 || type.count > 9223372036854775807 / ifx element > 0 then element else 1 {
            return -1
        }
        return element * type.count
    }
    if type.kind == .Record {
        size: s64
        for field: type.fields {
            part := AbiSize(program, field, depth + 1)
            if part < 0 || size > 9223372036854775807 - part { return -1 }
            size += part
        }
        return size
    }
    return -1
}

#scope_export

// Operands that an instruction form fixes to one register on the target.
MachineAbiFixedUse :: enum s32 { Invalid; DivideDividend; DivideResult; DivideClobber; ShiftCount }

MachineAbiClass :: (program: LirProgram, type_id: s32) -> MachineRegisterClass {
    return AbiClass(program, type_id)
}

MachineAbiTypeSize :: (program: LirProgram, type_id: s32) -> s64 {
    return AbiSize(program, type_id, 0)
}

MachineAbiArgumentRegister :: (target: TargetDescription, class: MachineRegisterClass,
    ordinal: s32) -> s32 {
    if !TargetMachineLoweringSupported(target) || ordinal < 0 { return -1 }
    if target.arch == .AArch64 {
        // AAPCS64 passes the first eight general arguments in x0-x7 and the
        // first eight floating/vector arguments in v0-v7. Machine float
        // registers use the same numbering as their v encodings. Records,
        // arrays and vectors stay on the stack, as on x86-64.
        if (class == .General || class == .Float) && ordinal < 8 { return ordinal }
        return -1
    }
    if target.arch == .ArmV7 {
        // Generated functions pass general arguments in pairs 0 and 1
        // (r0:r1, r2:r3) and floats in d0-d5; d7 is the float scratch.
        if class == .General && ordinal < 2 { return ordinal }
        if class == .Float && ordinal < 6 { return ordinal }
        return -1
    }
    if class == .General {
        registers: [6]s32 = .[cast(s32)X64Register.Rdi, cast(s32)X64Register.Rsi,
            cast(s32)X64Register.Rdx, cast(s32)X64Register.Rcx,
            cast(s32)X64Register.R8, cast(s32)X64Register.R9]
        if ordinal < registers.count { return registers[ordinal] }
    }
    if class == .Float && ordinal < 8 { return ordinal }
    return -1
}

MachineAbiResultRegister :: (target: TargetDescription, class: MachineRegisterClass) -> s32 {
    if !TargetMachineLoweringSupported(target) { return -1 }
    if target.arch == .AArch64 || target.arch == .ArmV7 {
        if class == .General || class == .Float { return 0 }
        return -1
    }
    if class == .General { return cast(s32)X64Register.Rax }
    if class == .Float { return 0 }
    return -1
}

// The register the target requires for USE, or -1 when the form places no
// fixed-register constraint there. Linux x86-64 divides RDX:RAX by the
// divisor, leaving the quotient in RAX and clobbering RDX, and shifts by CL.
MachineAbiFixedRegister :: (target: TargetDescription, use: MachineAbiFixedUse) -> s32 {
    if !TargetMachineLoweringSupported(target) { return -1 }
    if target.arch == .AArch64 || target.arch == .ArmV7 {
        // Divides and variable shifts take arbitrary registers (ARMv7 divides
        // through a runtime helper); divide-by-zero and range traps are
        // encoded inline per target.
        return -1
    }
    if use == .DivideDividend || use == .DivideResult { return cast(s32)X64Register.Rax }
    if use == .DivideClobber { return cast(s32)X64Register.Rdx }
    if use == .ShiftCount { return cast(s32)X64Register.Rcx }
    return -1
}

// Whether the implemented native call ABI passes and returns CLASS in
// registers. SysV scalar general and float values use their independent
// register sequences; vectors remain outside the native scalar contract.
MachineAbiCallRegisterClass :: (target: TargetDescription, class: MachineRegisterClass) -> bool {
    return TargetMachineLoweringSupported(target) && (class == .General || class == .Float)
}

// Whether the target's relocation of KIND can carry ADDEND. A Linux x86-64
// global address is a rip-relative 32-bit field; direct calls, function
// addresses and the fuel counter carry no addend.
MachineAbiRelocationAddend :: (target: TargetDescription, kind: MachineRelocationKind, addend: s64) -> bool {
    if !TargetMachineLoweringSupported(target) { return false }
    if target.arch == .AArch64 || target.arch == .ArmV7 {
        // Addresses materialize as MOVZ/MOVK or MOVW/MOVT halfwords;
        // symbolic addends beyond the field are not carried per halfword.
        return addend == 0
    }
    if kind == .GlobalAddress || kind == .ConstantAddress {
        return addend >= -2147483648 && addend <= 2147483647
    }
    return addend == 0
}

MachineAbiCallGeneralClobbers :: (target: TargetDescription) -> u64 {
    if !TargetMachineLoweringSupported(target) { return 0 }
    if target.arch == .AArch64 {
        // x0-x17 are caller-saved. x18 is the platform register and is
        // reserved from allocation, so calls never need to declare it.
        return 0x3ffff
    }
    if target.arch == .ArmV7 {
        // Pairs 0 and 1 (r0-r3) and pair 5 (r12, lr) are caller-saved;
        // pairs 2-4 (r4-r9) are callee-saved.
        return 0x23
    }
    return (cast(u64)1 << cast(u64)X64Register.Rax) |
        (cast(u64)1 << cast(u64)X64Register.Rcx) |
        (cast(u64)1 << cast(u64)X64Register.Rdx) |
        (cast(u64)1 << cast(u64)X64Register.Rsi) |
        (cast(u64)1 << cast(u64)X64Register.Rdi) |
        (cast(u64)1 << cast(u64)X64Register.R8) |
        (cast(u64)1 << cast(u64)X64Register.R9) |
        (cast(u64)1 << cast(u64)X64Register.R10) |
        (cast(u64)1 << cast(u64)X64Register.R11)
}

MachineAbiCallFloatClobbers :: (target: TargetDescription) -> u64 {
    if !TargetMachineLoweringSupported(target) { return 0 }
    if target.arch == .AArch64 {
        // v0-v7 and v16-v31 are caller-saved; the low halves of v8-v15 are
        // callee-saved.
        return 0xffff00ff
    }
    if target.arch == .ArmV7 {
        // d0-d7 are caller-saved, d8-d15 callee-saved.
        return 0xff
    }
    return 0xffff
}

MachineAbiPhysicalClass :: (target: TargetDescription, class: MachineRegisterClass,
    physical: s32) -> bool {
    if physical < 0 { return false }
    if class == .General { return physical < target.general_registers }
    if class == .Float { return physical < target.float_registers }
    if class == .Vector { return physical < target.vector_registers }
    return false
}

// One fixed-register instruction form the target lower materializes.
MachineAbiForm :: enum s32 { Invalid; BytesEqual; Resize }

// The register an indirect call's target lives in at the call. The call
// sequence writes the hidden result pointer (rax; AArch64 x8) and the copy
// scratch of stack arguments (r11; x15) before it calls, so the target must
// be elsewhere: r10 and x9 are caller-saved and pass no argument.
MachineAbiIndirectCallRegister :: (target: TargetDescription) -> s32 {
    if !TargetMachineLoweringSupported(target) { return -1 }
    if target.arch == .AArch64 { return 9 }
    if target.arch == .ArmV7 { return 4 }
    return cast(s32)X64Register.R10
}

// A general register an encoder may clobber inside one instruction without
// an IR-visible home. x86 uses R11 for bit and byte scratch; AArch64 keeps
// the same numbering because x11 carries no cross-instruction role.
MachineAbiScratchRegister :: (target: TargetDescription) -> s32 {
    if !TargetMachineLoweringSupported(target) { return -1 }
    if target.arch == .ArmV7 { return 1 }
    return 11
}

// The callee-saved register a looping x86-64 function keeps its step budget
// in, or -1 where budgets stay in the instance counter.
MachineAbiFuelRegister :: (target: TargetDescription) -> s32 {
    if target.arch != .X86_64 || !TargetMachineLoweringSupported(target) { return -1 }
    return cast(s32)X64Register.R15
}

// The callee-saved register a function that builds its returned aggregate
// where the caller wants it keeps that address in for its whole body, or -1
// where results are always copied. Allocation never gives it to a value.
MachineAbiResultPointerRegister :: (target: TargetDescription) -> s32 {
    if target.arch != .X86_64 || !TargetMachineLoweringSupported(target) { return -1 }
    return cast(s32)X64Register.R14
}

// The address scratch of dynamic aggregate and element addressing.
MachineAbiAddressScratchRegister :: (target: TargetDescription) -> s32 {
    if !TargetMachineLoweringSupported(target) { return -1 }
    // ARMv7 pair 5 (r12, lr) is its bank scratch and never holds a value.
    if target.arch == .ArmV7 { return 5 }
    return 10
}

// A floating register an encoder may clobber inside one instruction.
MachineAbiScratchFloatRegister :: (target: TargetDescription) -> s32 {
    if !TargetMachineLoweringSupported(target) { return -1 }
    if target.arch == .AArch64 { return 31 }
    if target.arch == .ArmV7 { return 7 }
    return 15
}

// USE register INDEX of a fixed form: BytesEqual exposes left, left count,
// right and right count; Resize exposes pointer, old count and new count.
MachineAbiFormFixedRegister :: (target: TargetDescription, form: MachineAbiForm,
    index: s32) -> s32 {
    if !TargetMachineLoweringSupported(target) || index < 0 { return -1 }
    if target.arch == .AArch64 {
        // Byte-compare and resize loops run on x10-x13 with x14-x16 spare.
        if form == .BytesEqual && index < 4 { return 10 + index }
        if form == .Resize && index < 3 { return 10 + index }
        return -1
    }
    if target.arch == .ArmV7 {
        // Byte compare on pairs 0-3; resize on pairs 0-2.
        if form == .BytesEqual && index < 4 { return index }
        if form == .Resize && index < 3 { return index }
        return -1
    }
    if form == .BytesEqual {
        registers: [4]s32 = .[cast(s32)X64Register.Rdi, cast(s32)X64Register.Rcx,
            cast(s32)X64Register.Rsi, cast(s32)X64Register.Rdx]
        if index < registers.count { return registers[index] }
        return -1
    }
    if form == .Resize {
        registers: [3]s32 = .[cast(s32)X64Register.Rdi, cast(s32)X64Register.Rsi,
            cast(s32)X64Register.Rdx]
        if index < registers.count { return registers[index] }
        return -1
    }
    return -1
}

// CLOBBER register INDEX of a fixed form. Resize on x86 declares every SysV
// caller-saved register so allocation keeps no value in one across the call;
// AArch64 declares the same eight slots for its x10-x13 loop registers and
// additional spares, while the emitted sequence preserves x0-x17 itself.
MachineAbiFormClobberRegister :: (target: TargetDescription, form: MachineAbiForm,
    index: s32) -> s32 {
    if !TargetMachineLoweringSupported(target) || index < 0 { return -1 }
    if target.arch == .AArch64 {
        if form == .BytesEqual && index < 3 { return 14 + index }
        if form == .Resize {
            clobbers: [8]s32 = .[13, 14, 15, 16, 17, 9, 10, 11]
            if index < clobbers.count { return clobbers[index] }
        }
        return -1
    }
    if target.arch == .ArmV7 {
        // The forms consume their count inputs; resize calls the runtime
        // through a veneer that keeps every register.
        if form == .BytesEqual && index < 3 { return index + 1 }
        if form == .Resize && index < 2 { return index + 1 }
        return -1
    }
    if form == .BytesEqual {
        clobbers: [3]s32 = .[cast(s32)X64Register.Rdi, cast(s32)X64Register.Rsi,
            cast(s32)X64Register.Rcx]
        if index < clobbers.count { return clobbers[index] }
        return -1
    }
    if form == .Resize {
        clobbers: [8]s32 = .[cast(s32)X64Register.Rdi, cast(s32)X64Register.Rsi,
            cast(s32)X64Register.Rdx, cast(s32)X64Register.Rcx, 8, 9, 10, 11]
        if index < clobbers.count { return clobbers[index] }
        return -1
    }
    return -1
}
