    if expression.kind == .CONDITIONAL {
        return merge(check, pointer_view_origin(check, expression.right), pointer_view_origin(check, expression.third))
    }
    if expression.kind == .UNARY && IR.CText(*expression.op[0]) == "&" {
        return pointer_address_origin(check, expression.right)
