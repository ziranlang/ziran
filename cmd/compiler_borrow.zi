pointer_address_origin :: (check: *BorrowCheck, index: s32) -> Origin {
    if index < 0 { return Origin.{} }
    expression := check.current.fn.exprs[index]
    if expression.kind == .INDEX || expression.kind == .MEMBER || expression.kind == .POINTER_MEMBER {
        base := check.current.fn.exprs[expression.left]
        if base.type[0] == #char "*" { return pointer_view_origin(check, expression.left) }
        if expression.kind == .INDEX && (SliceElementType(base.type, null, 0) != 0 || IR.CText(base.type) == "string") {
