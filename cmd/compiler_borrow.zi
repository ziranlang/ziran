    (result_storage_0[0]).lent_vec |= (b).lent_vec
    (result_storage_0[0]).global_vec |= (b).global_vec
    result_storage_0.borrowed_pointers |= b.borrowed_pointers
    result_storage_0.readonly_bytes |= b.readonly_bytes
    if ((b).depth > (result_storage_0[0]).depth) {
        (result_storage_0[0]).depth = (b).depth
    }
    (result_storage_0[0]).invalid |= (b).invalid
    (result_storage_0[0]).unknown |= (b).unknown
