readonly_pointer_destination :: (check: *BorrowCheck, index: s32) -> bool {
    if index < 0 { return false }
    expression := check.current.fn.exprs[index]
    if expression.kind == .INDEX || expression.kind == .POINTER_MEMBER {
        if pointer_view_origin(check, expression.left).readonly_bytes != 0 { return true }
        if expression.kind == .INDEX &&
        expression_origin(check, expression.left).readonly_bytes != 0 { return true }
        return readonly_pointer_destination(check, expression.left)
    }
    if expression.kind == .UNARY && IR.CText(*expression.op[0]) == "*" {
        return pointer_view_origin(check, expression.right).readonly_bytes != 0
