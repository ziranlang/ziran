#scope_file
exclusive_borrow_branch :: (check: *BorrowCheck, branch: s32) -> bool {
    current := check.branch
    while branch > 0 && current > 0 {
        first := check.branches[branch]
        second := check.branches[current]
        if first.group == 0 { branch = first.parent; continue }
        if second.group == 0 { current = second.parent; continue }
        if first.group == second.group { return branch != current }
        if first.group > second.group { branch = first.parent }
        else { current = second.parent }
    }
    return false
}

// A must-clear proof is deliberately separate from the global may-origin
// fixed point. Clearing one owner never removes another owner's possible loan.
#scope_file
loan_global :: (check: *BorrowCheck, module: *IR.ZirModule, name: *u8) -> s32 {
    owner: *IR.ZirModule
    global: *IR.ZirGlobal
    if ResolveGlobal(module, name, *owner, *global) != 1 { return -1 }
    index := pointer_index_get(*check.global_index, cast(*void)owner, cast(*void)global)
    if index >= 0 { read_global(check, index) }
    return index
}

#scope_file
loan_close :: (fn: *IR.ZirFunction, begin: s32, end: s32) -> s32 {
    depth: s32 = 1
    for at: begin + 1..end - 1 {
        kind := fn.stmts[at].kind
        if kind == .IF || kind == .WHILE || kind == .BLOCK_OPEN { depth += 1 }
        if kind == .BLOCK_CLOSE { depth -= 1; if depth == 0 { return at } }
    }
    return end
}

#scope_file
loan_static :: (fn: *IR.ZirFunction, index: s32) -> bool {
    if index < 0 { return true }
    expression := *fn.exprs[index]
    if expression.kind == .STRING || expression.kind == .INT || expression.kind == .FLOAT { return true }
    if expression.kind == .IDENT {
        return IR.CText(expression.name) == "null" || IR.CText(expression.name) == "false" || IR.CText(expression.name) == "true"
    }
    if expression.kind != .COMPOUND && expression.kind != .FIELD_INIT { return false }
    if !loan_static(fn, expression.left) || !loan_static(fn, expression.right) || !loan_static(fn, expression.third) { return false }
    child := expression.first_child
    while child >= 0 {
        if !loan_static(fn, child) { return false }
        child = fn.exprs[child].next_sibling
    }
    return true
}

#scope_file
readonly_builtin :: (name: *u8) -> bool {
    text := IR.CText(name)
    return text == "print" || text == "assert" || text == "TextView" ||
    text == "VecSlice" || text == "VecGet" || text == "zi_sqrt" || BitBuiltin(name) != 0
}

// Root masks: owning view cell, backing storage, unresolved reference. Local
// value copies own separate cells. Only references inherit their source root.
#scope_file
loan_roots :: (check: *BorrowCheck, frame: BorrowLoanFrame, index: s32, statement: s32) -> s32 {
    fn := frame.function.fn
    if index < 0 { return 0 }
    expression := *fn.exprs[index]
    if expression.kind == .MEMBER || expression.kind == .POINTER_MEMBER || expression.kind == .INDEX || expression.kind == .SLICE {
        return loan_roots(check, frame, expression.left, statement)
    }
    if expression.kind == .UNARY { return loan_roots(check, frame, expression.right, statement) }
    if expression.kind == .CAST { return loan_roots(check, frame, expression.first_child, statement) }
    if expression.kind == .CONDITIONAL {
        return loan_roots(check, frame, expression.right, statement) | loan_roots(check, frame, expression.third, statement)
    }
    if expression.kind == .CALL {
        if readonly_builtin(expression.name) {
            name := IR.CText(expression.name)
            if name == "TextView" || name == "VecSlice" || name == "VecGet" {
                return loan_roots(check, frame, expression.first_child, statement)
            }
            return 0
        }
        owner: *IR.ZirModule
        callee: *IR.ZirFunction
        ResolveFunction(frame.function.module, expression.name, *owner, *callee)
        summary := function_summary(check, callee)
        // Opaque native handles have caller-managed pointees. Their unknown
        // address does not borrow every global; borrowed views still may.
        native_pointer := expression.type[0] == #char "*"
        if summary == null { return ifx native_pointer then 0 else 4 }
        origin := summary.returned
        roots: s32 = 0
        if has_global(origin, frame.view) != 0 { roots |= 1 }
        if has_global(origin, frame.backing) != 0 { roots |= 2 }
        child := expression.first_child
        while child >= 0 {
            parameter := fn.exprs[child].argument_index
            if parameter >= 0 && parameter < 64 && ((origin.parameters | origin.pointees | origin.borrowed_pointers) & (1 << cast(u64)parameter)) != 0 {
                roots |= loan_roots(check, frame, child, statement)
            }
            child = fn.exprs[child].next_sibling
        }
        if origin.unknown != 0 && !native_pointer { roots |= 4 }
        return roots
    }
    if expression.kind != .IDENT { return 0 }
    // Skip declarations in scopes already closed at this point. Union pointer
    // reassignments conservatively; none can manufacture a must-clear fact.
    skipped: s32 = 0
    aliases: s32 = 0
    at := statement - 1
    while at >= 0 {
        previous := *fn.stmts[at]
        if previous.kind == .BLOCK_CLOSE { skipped += 1 }
        if previous.kind == .IF || previous.kind == .WHILE || previous.kind == .BLOCK_OPEN {
            if skipped > 0 { skipped -= 1; at -= 1; continue }
        }
        if skipped == 0 {
            if previous.kind == .ASSIGN && previous.lhs_root >= 0 {
                lhs := *fn.exprs[previous.lhs_root]
                if lhs.kind == .IDENT && strcmp(lhs.name, expression.name) == 0 &&
                (lhs.type[0] == #char "*" || SliceElementType(lhs.type, null, 0) != 0) {
                    aliases |= loan_roots(check, frame, previous.expr_root, at)
                }
            }
            if previous.kind == .DECL && strcmp(previous.names.name, expression.name) == 0 {
                if previous.type[0] != #char "*" && SliceElementType(previous.type, null, 0) == 0 { return 0 }
                return aliases | loan_roots(check, frame, previous.expr_root, at)
            }
        }
        at -= 1
    }
    parameters := ParametersOf(FunctionArgs(fn))
    for parameter: cast(s32)0..parameters.count - 1 {
        if strcmp(parameters.items.items[parameter].name, expression.name) != 0 { continue }
        if parameter >= 64 { return aliases | 4 }
        bit := 1 << cast(u64)parameter
        if (frame.view_parameters & bit) != 0 { aliases |= 1 }
        if (frame.backing_parameters & bit) != 0 { aliases |= 2 }
        return aliases
    }
    global := loan_global(check, frame.function.module, expression.name)
    if global == frame.view { aliases |= 1 }
    if global == frame.backing { aliases |= 2 }
    if global >= 0 && global != frame.view && global != frame.backing {
        binding := *check.globals[global]
        if binding.type.items[0] == #char "*" || SliceElementType(*binding.type.items[0], null, 0) != 0 {
            origin := check.global_origins[global]
            if has_global(origin, frame.view) != 0 { aliases |= 1 }
            if has_global(origin, frame.backing) != 0 { aliases |= 2 }
            if binding.address_known != 0 && binding.address_backing.root != null {
                if binding.address_backing.root.global_index == frame.view { aliases |= 1 }
                if binding.address_backing.root.global_index == frame.backing { aliases |= 2 }
            }
            // A native pointer cell does not alias every global. Its checked
            // origins and explicit addresses describe any tracked pointee.
        }
    }
    return aliases
}

#scope_file
loan_whole_global :: (check: *BorrowCheck, frame: BorrowLoanFrame, index: s32, statement: s32) -> s32 {
    fn := frame.function.fn
    if index < 0 || fn.exprs[index].kind != .IDENT { return -1 }
    name := fn.exprs[index].name
    skipped: s32 = 0
    at := statement - 1
    while at >= 0 {
        previous := *fn.stmts[at]
        if previous.kind == .BLOCK_CLOSE { skipped += 1 }
        if previous.kind == .IF || previous.kind == .WHILE || previous.kind == .BLOCK_OPEN {
            if skipped > 0 { skipped -= 1; at -= 1; continue }
        }
        if skipped == 0 && previous.kind == .DECL && strcmp(previous.names.name, name) == 0 { return -1 }
        at -= 1
    }
    parameters := ParametersOf(FunctionArgs(fn))
    for parameter: cast(s32)0..parameters.count - 1 {
        if strcmp(parameters.items.items[parameter].name, name) == 0 { return -1 }
    }
    return loan_global(check, frame.function.module, name)
}

// May-origins and retaining bodies only grow. Distinct fields must retain
// distinct obligations instead of merging to an uncleared common ancestor.
#scope_file
retain_global_loans :: (check: *BorrowCheck, view: *BorrowBinding, destination: BorrowPlace, origin: Origin) {
    if origin.globals == null { return }
    path := ifx destination.root == view then destination.path else null
    for backing: cast(s32)0..check.global_count - 1 {
        if has_global(origin, backing) == 0 { continue }
        loan := check.retained_loans
        while loan != null {
            if loan.view == view.global_index && loan.backing == backing && same_path(loan.path, path) != 0 { break }
            loan = loan.next
        }
        if loan == null {
            loan = cast(*BorrowRetainedLoan)AllocateOrExit(size_of(BorrowRetainedLoan))
            loan[0] = BorrowRetainedLoan.{view.global_index, backing, path, .{}, check.retained_loans}
            check.retained_loans = loan
        }
        function := pointer_index_get(*check.function_index, cast(*void)check.current.fn, null)
        found := false
        for index: cast(s32)0..loan.retainers.count - 1 {
            if loan.retainers.items[index] == function { found = true; break }
        }
        if found { continue }
        list_index(check, *loan.retainers, function)
        check.changed = 1
        check.clock += 1
        view.changed_at = check.clock
        check.views_changed_at = check.clock
    }
}

// A parameter can stand for the whole owner only while it keeps the exact
// incoming reference. Rebinding or shadowing it invalidates that identity.
#scope_file
loan_stable_parameter :: (fn: *IR.ZirFunction, name: *u8) -> bool {
    for at: cast(s32)0..fn.stmt_count - 1 {
        statement := *fn.stmts[at]
        if statement.kind == .DECL && strcmp(statement.names.name, name) == 0 { return false }
        if statement.kind == .ASSIGN && statement.lhs_root >= 0 {
            lhs := *fn.exprs[statement.lhs_root]
            if lhs.kind == .IDENT && strcmp(lhs.name, name) == 0 { return false }
        }
    }
    for index: cast(s32)0..fn.expr_count - 1 {
        expression := *fn.exprs[index]
        if expression.kind == .UNARY && expression.right >= 0 &&
        (IR.CText(*expression.op[0]) == "*" || IR.CText(*expression.op[0]) == "&") {
            operand := *fn.exprs[expression.right]
            if operand.kind == .IDENT && strcmp(operand.name, name) == 0 { return false }
        }
    }
    return true
}

// Only direct named fields establish a partial clear. An indexed write may
// clear one element, and a pointer alias may name another owner entirely.
#scope_file
loan_global_place :: (check: *BorrowCheck, frame: BorrowLoanFrame, index: s32, statement: s32) -> BorrowPlace {
    if index < 0 { return .{} }
    expression := *frame.function.fn.exprs[index]
    if expression.kind == .MEMBER || expression.kind == .POINTER_MEMBER {
        owner := loan_global_place(check, frame, expression.left, statement)
        // A pointer stored inside the owner may point to a different record.
        if owner.path != null && frame.function.fn.exprs[expression.left].type[0] == #char "*" { return .{} }
        return append_place(check, owner, expression.name, 0)
    }
    if expression.kind == .UNARY && (IR.CText(*expression.op[0]) == "*" || IR.CText(*expression.op[0]) == "&") {
        return loan_global_place(check, frame, expression.right, statement)
    }
    if expression.kind == .IDENT {
        parameters := ParametersOf(FunctionArgs(frame.function.fn))
        for parameter: cast(s32)0..parameters.count - 1 {
            if parameter < 64 && (frame.whole_view_parameters & (1 << cast(u64)parameter)) != 0 &&
            strcmp(parameters.items.items[parameter].name, expression.name) == 0 &&
            loan_stable_parameter(frame.function.fn, expression.name) {
                return root_place(*check.globals[frame.view])
            }
        }
    }
    global := loan_whole_global(check, frame, index, statement)
    if global != frame.view { return .{} }
    return root_place(*check.globals[global])
}

#scope_file
loan_clears_owner :: (check: *BorrowCheck, frame: BorrowLoanFrame, index: s32, statement: s32) -> bool {
    destination := loan_global_place(check, frame, index, statement)
    if destination.root == null { return false }
    if destination.path == null { return true }
    return path_within(destination.path, frame.path) != 0
}

#scope_file
loan_merge :: (first: BorrowLoanFlow, second: BorrowLoanFlow) -> BorrowLoanFlow {
    result := first
    result.safe = first.safe && second.safe
    result.touched = first.touched || second.touched
    result.clear = (!first.live || first.clear) && (!second.live || second.clear)
    result.live = first.live || second.live
    result.return_clear = (!first.returned || first.return_clear) && (!second.returned || second.return_clear)
    result.returned = first.returned || second.returned
    return result
}

#scope_file
loan_relevant :: (summary: *BorrowFunction, frame: BorrowLoanFrame, mask: s32) -> bool {
    item := summary.mutations
    while item != null {
        if (mask & 1) != 0 {
            direct := item.global == frame.view
            parameter := item.parameter >= 0 && item.parameter < 64 &&
                (frame.view_parameters & (1 << cast(u64)item.parameter)) != 0
            exact := direct || (parameter && (frame.whole_view_parameters & (1 << cast(u64)item.parameter)) != 0)
            if (direct || parameter) && (!exact || paths_overlap(item.path, frame.path) != 0) { return true }
        }
        if (mask & 2) != 0 && (item.global == frame.backing ||
            (item.parameter >= 0 && item.parameter < 64 && (frame.backing_parameters & (1 << cast(u64)item.parameter)) != 0)) { return true }
        item = item.next
    }
    return false
}

#scope_file
loan_apply_call :: (check: *BorrowCheck, frame: BorrowLoanFrame, index: s32, statement: s32, flow: BorrowLoanFlow) -> BorrowLoanFlow {
    expression := *frame.function.fn.exprs[index]
    if readonly_builtin(expression.name) { return flow }
    owner: *IR.ZirModule
    callee: *IR.ZirFunction
    ResolveFunction(frame.function.module, expression.name, *owner, *callee)
    summary := function_summary(check, callee)
    nested := BorrowLoanFrame.{summary, frame.view, frame.backing, 0, 0, -1, -1, frame.path, 0}
    unknown: bool = false
    child := expression.first_child
    while child >= 0 {
        parameter := frame.function.fn.exprs[child].argument_index
        roots := loan_roots(check, frame, child, statement)
        if parameter >= 0 && parameter < 64 {
            if (roots & 5) != 0 { nested.view_parameters |= 1 << cast(u64)parameter }
            owner_place := loan_global_place(check, frame, child, statement)
            if owner_place.root != null && owner_place.path == null &&
            frame.function.fn.exprs[child].type[0] == #char "*" && callee != null {
                parameters := ParametersOf(FunctionArgs(callee))
                if parameter < parameters.count && loan_stable_parameter(callee, parameters.items.items[parameter].name) {
                    nested.whole_view_parameters |= 1 << cast(u64)parameter
                }
            }
            if (roots & 6) != 0 { nested.backing_parameters |= 1 << cast(u64)parameter }
        } else if roots != 0 { unknown = true }
        if (roots & 4) != 0 { unknown = true }
        child = frame.function.fn.exprs[child].next_sibling
    }
    result := flow
    if summary == null || callee.is_extern != 0 {
        // Opaque effects cannot establish a clear. References to the owner may
        // replace it, and references to backing may write immediately.
        // An indirect callback can reenter a global writer even with no
        // reference arguments. Direct native foreign calls keep their explicit
        // caller-managed memory contract.
        callback := expression.slot_type != null && expression.slot_type[0] != 0
        if nested.backing_parameters != 0 || unknown || callback { result.safe = result.safe && result.clear; result.touched = true }
        if nested.view_parameters != 0 || unknown { result.clear = false }
        if unknown { result.safe = false }
        return result
    }
    if callee.checked == 0 { result.safe = false; result.clear = false; return result }
    if !loan_relevant(summary, nested, 3) && !summary.global_callbacks { return result }
    effect := loan_function(check, nested, flow.clear)
    result.safe = result.safe && effect.safe
    result.touched = result.touched || effect.touched
    result.clear = effect.clear
    return result
}

#scope_file
loan_expression :: (check: *BorrowCheck, frame: BorrowLoanFrame, index: s32, statement: s32, flow: BorrowLoanFlow) -> BorrowLoanFlow {
    if index < 0 || flow.stopped { return flow }
    fn := frame.function.fn
    expression := *fn.exprs[index]
    result := flow
    if expression.is_move != 0 {
        if statement == frame.stop_statement && index == frame.stop_expression { result.stopped = true; return result }
        roots := loan_roots(check, frame, index, statement)
        if (roots & 2) != 0 { result.safe = result.safe && result.clear; result.touched = true }
        if (roots & 1) != 0 { result.clear = false }
    }
    result = loan_expression(check, frame, expression.left, statement, result)
    if expression.kind == .CONDITIONAL {
        yes := loan_expression(check, frame, expression.right, statement, result)
        no := loan_expression(check, frame, expression.third, statement, result)
        if yes.stopped { return yes }; if no.stopped { return no }
        result = loan_merge(yes, no)
    } else if expression.kind == .BINARY && (IR.CText(*expression.op[0]) == "&&" || IR.CText(*expression.op[0]) == "||") {
        right := loan_expression(check, frame, expression.right, statement, result)
        if right.stopped { return right }
        result = loan_merge(result, right)
    } else {
        result = loan_expression(check, frame, expression.right, statement, result)
        result = loan_expression(check, frame, expression.third, statement, result)
    }
    child := expression.first_child
    while child >= 0 && !result.stopped {
        result = loan_expression(check, frame, child, statement, result)
        child = fn.exprs[child].next_sibling
    }
    if result.stopped { return result }
    if statement == frame.stop_statement && index == frame.stop_expression { result.stopped = true; return result }
    if expression.kind == .CALL { result = loan_apply_call(check, frame, index, statement, result) }
    return result
}

#scope_file
loan_sequence :: (check: *BorrowCheck, frame: BorrowLoanFrame, begin: s32, end: s32, flow: BorrowLoanFlow) -> BorrowLoanFlow {
    fn := frame.function.fn
    result := flow
    at := begin
    while at < end && result.live && !result.stopped {
        statement := *fn.stmts[at]
        if statement.kind == .DEFER {
            // Registration cannot grant an early clear. Unrelated deferred
            // cleanup leaves this proof alone; a relevant deferred effect is
            // conservatively rejected rather than executed at registration.
            no_clear := loan_expression(check, frame, statement.expr_root, at,
                BorrowLoanFlow.{false, true, true, false, true, false, false})
            cleared := loan_expression(check, frame, statement.expr_root, at,
                BorrowLoanFlow.{true, true, true, false, true, false, false})
            if no_clear.touched || cleared.touched || no_clear.clear || !cleared.clear || !no_clear.safe || !cleared.safe {
                result.clear = false; result.safe = false
            }
            at += 1; continue
        }
        // A checked function that never writes the owner preserves an entry
        // clear across backedges. Otherwise retain the conservative loop fact.
        if statement.kind == .WHILE && loan_relevant(frame.function, frame, 1) { result.clear = false }
        result = loan_expression(check, frame, statement.lhs_root, at, result)
        result = loan_expression(check, frame, statement.expr_root, at, result)
        if result.stopped { return result }
        if at == frame.stop_statement && frame.stop_expression < 0 { result.stopped = true; return result }
        if statement.kind == .IF {
            close := loan_close(fn, at, end)
            alternative := close + 1
            yes := loan_sequence(check, frame, at + 1, close, result)
            if statement.expr_root < 0 { result = yes; at = alternative; continue }
            if yes.stopped { return yes }
            no := result
            if alternative < end && fn.stmts[alternative].kind == .IF && fn.stmts[alternative].is_else != 0 {
                // Recurse over the entire else-if chain, but not the following
                // shared sequence. loan_branch_end finds its final close.
                last := loan_branch_end(fn, alternative, end)
                no = loan_sequence(check, frame, alternative, last + 1, result)
                alternative = last + 1
            }
            if no.stopped { return no }
            result = loan_merge(yes, no)
            at = alternative; continue
        }
        if statement.kind == .WHILE {
            close := loan_close(fn, at, end)
            // The loop may execute zero times. An unchanged owner preserves
            // the entry fact; writes, breaks and continues cannot grant one.
            iteration := result
            iteration = loan_sequence(check, frame, at + 1, close, iteration)
            if iteration.stopped { return iteration }
            result.safe = result.safe && iteration.safe
            result.touched = result.touched || iteration.touched
            result.clear = result.clear && iteration.clear && (!iteration.returned || iteration.return_clear)
            result.return_clear = result.return_clear && (!iteration.returned || iteration.return_clear)
            result.returned = result.returned || iteration.returned
            at = close + 1; continue
        }
        if statement.kind == .BLOCK_OPEN {
            close := loan_close(fn, at, end)
            result = loan_sequence(check, frame, at + 1, close, result)
            at = close + 1; continue
        }
        if statement.kind == .ASSIGN {
            roots := loan_roots(check, frame, statement.lhs_root, at)
            if (roots & 2) != 0 { result.safe = result.safe && result.clear; result.touched = true }
            if (roots & 1) != 0 {
                destination := loan_global_place(check, frame, statement.lhs_root, at)
                // A write to a disjoint named field cannot reinstall this loan.
                if destination.root == null || paths_overlap(destination.path, frame.path) != 0 {
                    result.clear = loan_clears_owner(check, frame, statement.lhs_root, at) &&
                    IR.CText(*statement.assignment_op[0]) == "=" && loan_static(fn, statement.expr_root)
                }
            }
            if (roots & 4) != 0 {
                if loan_relevant(frame.function, frame, 2) { result.safe = false }
                result.clear = false
            }
        }
        if statement.kind == .RETURN {
            result.return_clear = (!result.returned || result.return_clear) && result.clear
            result.returned = true; result.live = false
        }
        if statement.kind == .BREAK || statement.kind == .CONTINUE {
            result.clear = false; result.live = false
            result.returned = true; result.return_clear = false
        }
        if statement.kind == .CASE || statement.kind == .IF_CASE { result.clear = false; result.safe = false }
        at += 1
    }
    return result
}

#scope_file
loan_branch_end :: (fn: *IR.ZirFunction, begin: s32, end: s32) -> s32 {
    close := loan_close(fn, begin, end)
    next := close + 1
    if next < end && fn.stmts[next].kind == .IF && fn.stmts[next].is_else != 0 { return loan_branch_end(fn, next, end) }
    return close
}

#scope_file
loan_function :: (check: *BorrowCheck, frame: BorrowLoanFrame, clear: bool) -> BorrowLoanFlow {
    proof := check.loan_proofs
    while proof != null {
        previous := proof.frame
        if previous.function == frame.function && previous.view == frame.view && previous.backing == frame.backing &&
        previous.view_parameters == frame.view_parameters && previous.backing_parameters == frame.backing_parameters && previous.whole_view_parameters == frame.whole_view_parameters &&
        same_path(previous.path, frame.path) != 0 && proof.input_clear == clear {
            if proof.complete { return proof.result }
            // A recursive edge cannot prove a clear. Its checked mutation
            // summary still proves safety when it cannot write this backing.
            return BorrowLoanFlow.{clear && !loan_relevant(frame.function, frame, 1),
                !loan_relevant(frame.function, frame, 2) && (!frame.function.global_callbacks || clear),
                true, false, true, false, false}
        }
        proof = proof.next
    }
    proof = cast(*BorrowLoanProof)AllocateOrExit(size_of(BorrowLoanProof))
    proof[0] = BorrowLoanProof.{frame, clear, false, .{}, check.loan_proofs}
    check.loan_proofs = proof
    result := loan_sequence(check, frame, 0, frame.function.fn.stmt_count, BorrowLoanFlow.{clear, true, true, false, true, false, false})
    result.clear = (!result.live || result.clear) && (!result.returned || result.return_clear)
    proof.result = result
    proof.complete = true
    return result
}

// A retained view cannot cross a call boundary when every checked body that
// installs it ends that exact loan on every return. Writes inside those bodies
// still run the ordered prefix proof; clearing after a write cannot excuse it.
#scope_file
loan_entry_clear :: (check: *BorrowCheck, loan: *BorrowRetainedLoan) -> bool {
    if loan.retainers.count == 0 { return false }
    for index: cast(s32)0..loan.retainers.count - 1 {
        retainer := *check.functions[loan.retainers.items[index]]
        unused function_summary(check, retainer.fn)
        frame := BorrowLoanFrame.{retainer, loan.view, loan.backing, 0, 0, -1, -1, loan.path, 0}
        effect := loan_function(check, frame, true)
        if !effect.clear || !effect.safe { return false }
    }
    return true
}

#scope_file
global_loan_path_ended :: (check: *BorrowCheck, loan: *BorrowRetainedLoan) -> bool {
    frame := BorrowLoanFrame.{check.current, loan.view, loan.backing, 0, 0, check.loan_statement, -1, loan.path, 0}
    if check.loan_move >= 0 { frame.stop_expression = check.loan_move }
    if check.loan_call != null {
        frame.stop_expression = cast(s32)((cast(usize)check.loan_call - cast(usize)check.current.fn.exprs) / size_of(IR.ZirExpr))
    }
    prefix := loan_sequence(check, frame, 0, check.current.fn.stmt_count, BorrowLoanFlow.{false, true, true, false, true, false, false})
    if !prefix.stopped { return false }
    if !prefix.clear && loan_entry_clear(check, loan) {
        prefix = loan_sequence(check, frame, 0, check.current.fn.stmt_count, BorrowLoanFlow.{true, true, true, false, true, false, false})
    }
    if check.loan_call == null { return prefix.clear }
    effect := loan_apply_call(check, frame, frame.stop_expression, check.loan_statement,
        BorrowLoanFlow.{prefix.clear, true, true, false, true, false, false})
    return effect.safe && effect.touched
}

#scope_file
global_loan_ended :: (check: *BorrowCheck, view: s32, destination: BorrowPlace) -> bool {
    if view < 0 || destination.root == null || destination.root.global_index < 0 { return false }
    loan := check.retained_loans
    found := false
    while loan != null {
        if loan.view == view && loan.backing == destination.root.global_index {
            found = true
            if !global_loan_path_ended(check, loan) { return false }
        }
        loan = loan.next
    }
    return found
}

#scope_file
text_backing_conflict :: (check: *BorrowCheck, destination: BorrowPlace) -> s32 {
    {
        i: s32 = 0
        while check_loop_210 := (i < (check).active_count) {
            if (!((((check).active)[i]).vec != 0) && (places_overlap((((check).active)[i]).backing, destination) != 0) &&
                !exclusive_borrow_branch(check, check.active[i].branch) &&
                (check.global_loans_ready || check.active[i].owner_global < 0) &&
                !global_loan_ended(check, check.active[i].owner_global, destination)) {
                return 1
            }
