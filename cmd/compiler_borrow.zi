    item := cast(*BorrowReturnedBacking)AllocateOrExit(size_of(BorrowReturnedBacking))
    item[0] = BorrowReturnedBacking.{parameter, global, path, function.returned_backings}
    function.returned_backings = item
    check.changed = 1
    summary_changed(check)
}

