#scope_export

ZirCFunctionSym :: struct {
    source: [IR.ZIR_NAME_MAX]u8 #c "char"
    c: [IR.ZIR_NAME_MAX * 3]u8 #c "char"
}

ZirCHeaderUse :: struct {
    module: *IR.ZirModule #c "const ZirModule *"
    use: u8
}

ZirCHeaderUses :: struct {
    items: *ZirCHeaderUse
    count: s32
}

ZirCModuleSyms :: struct {
    module_stem: [IR.ZIR_PATH_MAX]u8 #c "char"
    module_slash: [IR.ZIR_PATH_MAX]u8 #c "char"
    fns: *ZirCFunctionSym
    fn_count: s32
    module: *IR.ZirModule #c "const ZirModule *"
    header_uses: ZirCHeaderUses
}

