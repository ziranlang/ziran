// Shared native C/Go emitter core: symbol naming, type/field resolution,
// slot types, numeric/runtime helper injection, and module/entry queries.
using IR :: #import "compiler_ir"
using Native :: #import "compiler_native_names"
Scalar :: #import "compiler_scalar"

#scope_file

libc :: #system_library "libc";
compiler :: #system_library "ziran";

malloc :: (size: usize) -> *void #foreign libc "malloc";
calloc :: (count: usize, size: usize) -> *void #foreign libc "calloc";
realloc :: (memory: *void, size: usize) -> *void #foreign libc "realloc";
free :: (memory: *void) #foreign libc "free";
abort :: () #foreign libc "abort";
exit :: (status: s32) #foreign libc "exit";
memcpy :: (dst: *void, src: *void, count: usize) -> *void #foreign libc "memcpy";
memmove :: (dst: *void, src: *void, count: usize) -> *void #foreign libc "memmove";
memset :: (dst: *void, value: s32, count: usize) -> *void #foreign libc "memset";
memcmp :: (left: *void, right: *void, count: usize) -> s32 #foreign libc "memcmp";
strlen :: (s: *u8) -> usize #foreign libc "strlen";
strcmp :: (a: *u8, b: *u8) -> s32 #foreign libc "strcmp";
strncmp :: (a: *u8, b: *u8, n: usize) -> s32 #foreign libc "strncmp";
strchr :: (s: *u8, c: s32) -> *u8 #foreign libc "strchr";
strrchr :: (s: *u8, c: s32) -> *u8 #foreign libc "strrchr";
strstr :: (haystack: *u8, needle: *u8) -> *u8 #foreign libc "strstr";
strdup :: (s: *u8) -> *u8 #foreign libc "strdup";
atoi :: (s: *u8) -> s32 #foreign libc "atoi";
snprintf :: (out: *u8, size: usize, fmt: *u8, args: ..any) -> s32 #foreign libc "snprintf";
fprintf :: (stream: *void, fmt: *u8, args: ..any) -> s32 #foreign libc "fprintf";
fputs :: (s: *u8, stream: *void) -> s32 #foreign libc "fputs";
fwrite :: (ptr: *void, size: usize, nmemb: usize, stream: *void) -> usize #foreign libc "fwrite";
ferror :: (stream: *void) -> s32 #foreign libc "ferror";

#scope_export
ZirResolveTarget :: #type (context: *void, text: *u8, out: *u8, size: usize) #c_call;

#scope_file
DestroyFn :: #type (value: *void) #c_call;

COMPILER_NATIVE_IDENTITIES :: 9

CompilerCurrentStorage :: (key: s32, size: usize, destroy: DestroyFn) -> *void #foreign compiler "CompilerCurrentStorage";
AllocateOrExit :: (size: usize) -> *void #foreign compiler "AllocateOrExit";
Diagnostic :: (span: IR.ZirSourceSpan, code: *u8, fmt: *u8, args: ..any) #foreign compiler "Diagnostic";
DiagnosticTarget :: (span: IR.ZirSourceSpan, code: *u8, target: *u8, capability: *u8, fmt: *u8, args: ..any) #foreign compiler "DiagnosticTarget";
CSpan :: (path: *u8, line: s32, column: s32) -> IR.ZirSourceSpan #foreign compiler "Span";
CSpanPath :: (span: IR.ZirSourceSpan) -> *u8 #foreign compiler "SpanPath";
copy_text :: (dst: *u8, size: usize, src: *u8) #foreign compiler "copy_text";
is_ident_char :: (c: s32) -> s32 #foreign compiler "is_ident_char";
skip_ws :: (s: *u8) -> *u8 #foreign compiler "skip_ws";
camel_ident :: (s: *u8, dst: *u8, dst_size: usize) #foreign compiler "camel_ident";
go_field_ident :: (s: *u8, dst: *u8, dst_size: usize) #foreign compiler "go_field_ident";
split_top_level :: (s: *u8, parts: *u8, max: s32, part_size: usize) -> s32 #foreign compiler "split_top_level";

CParameter :: struct {
    text: *u8
    name: *u8
    type: *u8
    binding_name: *u8
    value_type: *u8
    default_value: *u8
    is_using: s32
}
CParameters :: struct {
    count: s32
    items: [1]CParameter
}
ParametersOf :: (text: *u8) -> *CParameters #foreign compiler "ParametersOf";

ArrayElementType :: (type: *u8, element: *u8, size: usize, capacity: *s32) -> s32 #foreign compiler "ArrayElementType";
SliceElementType :: (type: *u8, element: *u8, size: usize) -> s32 #foreign compiler "SliceElementType";
ArrayValueType :: (type: *u8) -> s32 #foreign compiler "ArrayValueType";
VecElementType :: (module: *IR.ZirModule, type: *u8, element: *u8, size: usize) -> s32 #foreign compiler "VecElementType";
ScalarType :: (type: *u8) -> *u8 #foreign compiler "ScalarType";
CFindType :: (module: *IR.ZirModule, name: *u8, owner: **IR.ZirModule) -> *IR.ZirType #foreign compiler "FindType";
BuiltinType :: (name: *u8) -> *IR.ZirType #foreign compiler "BuiltinType";
CTypeNextField :: (record: *IR.ZirType, offset: *usize, field: *IR.ZirTypeField) -> s32 #foreign compiler "TypeNextField";
TypeFindField :: (record: *IR.ZirType, name: *u8, field: *IR.ZirTypeField) -> s32 #foreign compiler "TypeFindField";
EvaluateCompileExpression :: (module: *IR.ZirModule, text: *u8, span: IR.ZirSourceSpan, executing: s32, value: *s64) -> s32 #foreign compiler "EvaluateCompileExpression";

// The host's VectorType writes the entire ZirVector record from zir.h.
ZirVector :: struct {
    name: *u8
    lane: *u8
    lanes: s32
    lane_bits: s32
    bytes: s32
    is_signed: s32
    is_float: s32
    is_native: s32
    block: *u8
}
VectorType :: (type: *u8, out: *ZirVector) -> s32 #foreign compiler "VectorType";
SimdUsesNote :: (uses: *void, word: *u8, length: usize) #foreign compiler "SimdUsesNote";

StaticText :: struct { data: *u8; length: usize }
CStr :: (s: string) -> *u8 { return (cast(*StaticText)(*s)).data }

PtrAdd :: (p: *u8, n: usize) -> *u8 { return cast(*u8)(cast(usize)p + n) }
PtrSub :: (p: *u8, n: usize) -> *u8 { return cast(*u8)(cast(usize)p - n) }

FunctionArgs :: (fn: *IR.ZirFunction) -> *u8 {
    if fn != null && fn.args_text != null { return fn.args_text }
    return CStr("")
}

IsAlnum :: (c: u8) -> bool {
    return (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z") || (c >= #char "0" && c <= #char "9")
}

IsDigit :: (c: u8) -> bool {
    return c >= #char "0" && c <= #char "9"
}

IsUpper :: (c: u8) -> bool {
    return c >= #char "A" && c <= #char "Z"
}

IsSpace :: (c: u8) -> bool {
    return c == #char " " || c == #char "\t" || c == #char "\n" || c == #char "\r" || c == 11 || c == 12
}

ToUpper :: (c: u8) -> u8 {
    if c >= #char "a" && c <= #char "z" { return c - 32 }
    return c
}

ToLower :: (c: u8) -> u8 {
    if c >= #char "A" && c <= #char "Z" { return c + 32 }
    return c
}

CheckFormat :: (n: s32, size: usize) -> s32 {
    if n < 0 || cast(usize)n >= size {
        zero_span: IR.ZirSourceSpan
        Diagnostic(zero_span, CStr("zir.output"), CStr("generated expression exceeds output limit"))
        exit(1)
    }
    return n
}

ModuleIdentity :: struct {
    module: *IR.ZirModule
    file_stem: [IR.ZIR_PATH_MAX]u8
    guard: [256]u8
}

ModuleIdentities :: struct {
    programs: usize
    count: s32
    slots: *ModuleIdentity
    capacity: usize
    used: usize
    // Cached globals read by the current function for TargetBindingName.
    globals_fn: *IR.ZirFunction
    globals_exprs: *IR.ZirExpr
    globals_expr_count: s32
    globals: **u8
    global_count: s32
    global_capacity: s32
}

FreeModuleIdentities :: (value: *void) {
    id := cast(*ModuleIdentities)value
    free(cast(*void)id.slots)
    free(cast(*void)id.globals)
}

ContextModuleIdentities :: () -> *ModuleIdentities {
    return cast(*ModuleIdentities)CompilerCurrentStorage(
        COMPILER_NATIVE_IDENTITIES, size_of(ModuleIdentities), FreeModuleIdentities)
}

#scope_export

#program_export
NativeNamesReset :: () {
    identities := ContextModuleIdentities()
    free(cast(*void)identities.slots)
    free(cast(*void)identities.globals)
    memset(cast(*void)identities, 0, size_of(ModuleIdentities))
}

#scope_file

TypeHasZeroArrayDepth :: (module: *IR.ZirModule, type: *u8, depth: s32) -> s32 {
    element: [IR.ZIR_NAME_MAX]u8
    capacity: s32 = 0
    if depth > 16 || module == null || type == null { return 0 }
    if ArrayElementType(type, *element[0], IR.ZIR_NAME_MAX, *capacity) != 0 {
        if capacity < 0 {
            close := strchr(type, #char "]")
            bound: [IR.ZIR_NAME_MAX]u8
            folded: s64 = 0
            length: usize = 0
            if close != null {
                length = cast(usize)close - cast(usize)type - 1
            }
            if length > 0 && length < IR.ZIR_NAME_MAX {
                memcpy(cast(*void)*bound[0], cast(*void)PtrAdd(type, 1), length)
                bound[length] = 0
                if EvaluateCompileExpression(module, *bound[0], CSpan(CStr(""), 0, 0), 0, *folded) != 0 && folded == 0 {
                    return 1
                }
            }
        }
        if capacity == 0 { return 1 }
        return TypeHasZeroArrayDepth(module, *element[0], depth + 1)
    }
    if type[0] == #char "*" { return 0 }
    owner: *IR.ZirModule = null
    record := CFindType(module, type, *owner)
    if record != null && record.is_enum == 0 && record.is_extern == 0 &&
       record.is_procedure_type == 0 && record.is_record_template == 0 {
        field: IR.ZirTypeField
        offset: usize = 0
        next_mod := ifx owner != null then owner else module
        while CTypeNextField(record, *offset, *field) == 1 {
            if TypeHasZeroArrayDepth(next_mod, *field.type[0], depth + 1) != 0 { return 1 }
        }
    }
    for i: cast(s32)0..module.define_count - 1 {
        if strcmp(*module.defines[i].name[0], type) == 0 {
            return TypeHasZeroArrayDepth(module, module.defines[i].value, depth + 1)
        }
    }
    return 0
}

#scope_export

#program_export
TypeHasZeroArray :: (module: *IR.ZirModule, type: *u8) -> s32 {
    return TypeHasZeroArrayDepth(module, type, 0)
}

#program_export
ModuleUsesSlices :: (module: *IR.ZirModule) -> s32 {
    for i: cast(s32)0..module.global_count - 1 {
        if SliceElementType(*module.globals[i].type[0], null, 0) != 0 { return 1 }
    }
    for i: cast(s32)0..module.type_count - 1 {
        record := *module.types[i]
        if record.is_enum != 0 { continue }
        if record.is_procedure_type != 0 {
            if SliceElementType(*record.procedure_return_type[0], null, 0) != 0 ||
               strstr(*record.body[0], CStr("[]")) != null {
                return 1
            }
            continue
        }
        offset: usize = 0
        field: IR.ZirTypeField
        while CTypeNextField(record, *offset, *field) > 0 {
            if SliceElementType(*field.type[0], null, 0) != 0 { return 1 }
        }
    }
    for i: cast(s32)0..module.import_count - 1 {
        imp := *module.imports[i]
        if imp.kind == .EXTERN &&
           (SliceElementType(*imp.return_type[0], null, 0) != 0 ||
            strstr(*imp.args[0], CStr("[]")) != null) {
            return 1
        }
    }
    for i: cast(s32)0..module.function_count - 1 {
        fn := *module.functions[i]
        if SliceElementType(*fn.return_type[0], null, 0) != 0 ||
           strstr(FunctionArgs(fn), CStr("[]")) != null {
            return 1
        }
        for j: cast(s32)0..fn.stmt_count - 1 {
            if SliceElementType(fn.stmts[j].type, null, 0) != 0 { return 1 }
        }
        for j: cast(s32)0..fn.expr_count - 1 {
            if SliceElementType(fn.exprs[j].type, null, 0) != 0 ||
               (fn.exprs[j].kind == .SIZE_OF && SliceElementType(fn.exprs[j].name, null, 0) != 0) {
                return 1
            }
        }
    }
    return 0
}

#scope_file

MentionsVector :: (text: *u8) -> s32 {
    if text == null { return 0 }
    p := text
    while p[0] != 0 {
        if !IsAlnum(p[0]) && p[0] != #char "_" {
            p = PtrAdd(p, 1)
            continue
        }
        start := p
        while IsAlnum(p[0]) || p[0] == #char "_" { p = PtrAdd(p, 1) }
        length := cast(usize)p - cast(usize)start
        if length >= 4 && length < 8 {
            name: [8]u8
            memcpy(cast(*void)*name[0], cast(*void)start, length)
            name[length] = 0
            if VectorType(*name[0], null) != 0 { return 1 }
        }
    }
    return 0
}

#scope_export

#program_export
ModuleHeaderUsesVectors :: (module: *IR.ZirModule) -> s32 {
    for i: cast(s32)0..module.global_count - 1 {
        if MentionsVector(*module.globals[i].type[0]) != 0 { return 1 }
    }
    for i: cast(s32)0..module.type_count - 1 {
        record := *module.types[i]
        if record.is_enum != 0 { continue }
        if record.is_procedure_type != 0 {
            if MentionsVector(*record.procedure_return_type[0]) != 0 ||
               MentionsVector(*record.body[0]) != 0 {
                return 1
            }
            continue
        }
        offset: usize = 0
        field: IR.ZirTypeField
        while CTypeNextField(record, *offset, *field) > 0 {
            if MentionsVector(*field.type[0]) != 0 { return 1 }
        }
    }
    for i: cast(s32)0..module.import_count - 1 {
        imp := *module.imports[i]
        if imp.kind == .EXTERN &&
           (MentionsVector(*imp.return_type[0]) != 0 || MentionsVector(*imp.args[0]) != 0) {
            return 1
        }
    }
    for i: cast(s32)0..module.function_count - 1 {
        fn := *module.functions[i]
        if MentionsVector(*fn.return_type[0]) != 0 || MentionsVector(FunctionArgs(fn)) != 0 {
            return 1
        }
    }
    return 0
}

#program_export
ModuleUsesVecOperations :: (module: *IR.ZirModule) -> s32 {
    for f: cast(s32)0..module.function_count - 1 {
        fn := *module.functions[f]
        for e: cast(s32)0..fn.expr_count - 1 {
            expr := *fn.exprs[e]
            if expr.kind == .CALL {
                n := IR.CText(expr.name)
                if n == "VecPush" || n == "VecReserve" || n == "VecResize" || n == "VecResizeBounded" ||
                   n == "VecClear" || n == "VecFree" || n == "VecSwap" || n == "VecPop" ||
                   n == "VecGet" || n == "VecClone" || n == "VecSlice" ||
                   n == "BuilderAppend" || n == "BuilderFinish" {
                    return 1
                }
            }
            if expr.kind == .INDEX && expr.left >= 0 &&
               VecElementType(module, fn.exprs[expr.left].type, null, 0) != 0 {
                return 1
            }
        }
    }
    return 0
}

#program_export "zir_emit_function_mentions"
FunctionMentions :: (fn: *IR.ZirFunction, name: *u8) -> s32 {
    if strstr(FunctionArgs(fn), name) != null { return 1 }
    for i: cast(s32)0..fn.stmt_count - 1 {
        if strcmp(fn.stmts[i].name, name) == 0 { return 1 }
    }
    for i: cast(s32)0..fn.expr_count - 1 {
        if strcmp(fn.exprs[i].name, name) == 0 { return 1 }
    }
    return 0
}

#scope_file

FunctionReadsGlobal :: (fn: *IR.ZirFunction, name: *u8) -> s32 {
    id := ContextModuleIdentities()
    if id.globals_fn != fn || id.globals_exprs != fn.exprs || id.globals_expr_count != fn.expr_count {
        id.globals_fn = fn
        id.globals_exprs = fn.exprs
        id.globals_expr_count = fn.expr_count
        id.global_count = 0
        for i: cast(s32)0..fn.expr_count - 1 {
            expr := *fn.exprs[i]
            if expr.is_global_value == 0 || expr.name == null { continue }
            if id.global_count == id.global_capacity {
                capacity := ifx id.global_capacity != 0 then id.global_capacity * 2 else 16
                grown := cast(**u8)AllocateOrExit(size_of(*u8) * cast(usize)capacity)
                if id.global_count != 0 {
                    memcpy(cast(*void)grown, cast(*void)id.globals, size_of(*u8) * cast(usize)id.global_count)
                }
                free(cast(*void)id.globals)
                id.globals = grown
                id.global_capacity = capacity
            }
            bare := strrchr(expr.name, #char ".")
            id.globals[id.global_count] = ifx bare != null then PtrAdd(bare, 1) else expr.name
            id.global_count += 1
        }
    }
    for i: cast(s32)0..id.global_count - 1 {
        if strcmp(id.globals[i], name) == 0 { return 1 }
    }
    return 0
}

IsCKeyword :: (name: string) -> bool {
    words: [44]string = .{
        "auto", "break", "case", "char", "const", "continue", "default",
        "do", "double", "else", "enum", "extern", "float", "for", "goto",
        "if", "inline", "int", "long", "register", "restrict", "return",
        "short", "signed", "sizeof", "static", "struct", "switch",
        "typedef", "union", "unsigned", "void", "volatile", "while",
        "_Alignas", "_Alignof", "_Atomic", "_Bool", "_Complex",
        "_Generic", "_Imaginary", "_Noreturn", "_Static_assert",
        "_Thread_local"
    }
    for w: words[:] { if name == w { return true } }
    return false
}

IsCppKeyword :: (name: string) -> bool {
    words: [51]string = .{
        "alignas", "alignof", "asm", "bool", "catch", "class", "constexpr",
        "delete", "explicit", "false", "friend", "mutable", "namespace",
        "new", "noexcept", "nullptr", "operator", "private", "protected",
        "public", "template", "this", "throw", "true", "try", "typename",
        "using", "virtual", "and", "and_eq", "bitand", "bitor",
        "char16_t", "char32_t", "compl", "const_cast", "decltype",
        "dynamic_cast", "export", "not", "not_eq", "or", "or_eq",
        "reinterpret_cast", "static_assert", "static_cast", "thread_local",
        "typeid", "wchar_t", "xor", "xor_eq"
    }
    for w: words[:] { if name == w { return true } }
    return false
}

IsGoKeyword :: (name: string) -> bool {
    words: [31]string = .{
        "break", "case", "chan", "const", "continue", "default", "defer",
        "else", "fallthrough", "for", "func", "go", "goto", "if", "import",
        "interface", "map", "package", "range", "return", "select",
        "struct", "switch", "type", "var", "fmt", "strconv", "math",
        "formatFloat", "unsafe", "zirGoAssemblyEnabled"
    }
    for w: words[:] { if name == w { return true } }
    return false
}

IsCRuntimeName :: (name: string) -> bool {
    words: [41]string = .{
        "abort", "calloc", "errno", "exit", "fflush", "fprintf", "fputs",
        "free", "fwrite", "malloc", "memcmp", "memcpy", "memmove", "memset",
        "print_float", "printf", "putchar", "puts", "qsort", "realloc",
        "snprintf", "stderr", "stdout", "strchr", "strcmp", "strlen", "strrchr",
        "bool", "true", "false", "size_t", "ptrdiff_t", "uintptr_t",
        "int8_t", "int16_t", "int32_t", "int64_t",
        "uint8_t", "uint16_t", "uint32_t", "uint64_t"
    }
    for w: words[:] { if name == w { return true } }
    return false
}

IsGoRuntimeName :: (name: string) -> bool {
    words: [41]string = .{
        "any", "append", "bool", "byte", "cap", "clear", "close", "complex",
        "copy", "delete", "error", "false", "float32", "float64", "imag",
        "int", "int8", "int16", "int32", "int64", "iota", "len", "make",
        "max", "min", "new", "nil", "panic", "print", "println", "real",
        "recover", "rune", "string", "true", "uint", "uint8", "uint16",
        "uint32", "uint64", "uintptr"
    }
    for w: words[:] { if name == w { return true } }
    return false
}

IsCReservedName :: (target: Native.ZirTarget, name: *u8) -> bool {
    return target == .ZIR_C && name[0] == #char "_" && name[1] == #char "_"
}

#scope_export

#program_export
NativeHeaderKeyword :: (name: *u8) -> s32 {
    s := IR.CText(name)
    return ifx IsCKeyword(s) || IsCppKeyword(s) then 1 else 0
}

#program_export
TargetBindingName :: (fn: *IR.ZirFunction, target: Native.ZirTarget, name: *u8, out: *u8, size: usize) {
    s := IR.CText(name)
    kw := ifx target == .ZIR_GO then IsGoKeyword(s) else IsCKeyword(s)
    rt := ifx fn != null then (ifx target == .ZIR_GO then IsGoRuntimeName(s) else IsCRuntimeName(s)) else false
    reserved := kw || IsCReservedName(target, name) || rt
    if !reserved && (fn == null || FunctionReadsGlobal(fn, name) == 0) {
        copy_text(out, size, name)
        return
    }
    serial: s32 = 0
    while true {
        fmt := ifx reserved then CStr("ziran_keyword_%s_%d") else CStr("ziran_local_%s_%d")
        CheckFormat(snprintf(out, size, fmt, name, serial), size)
        if fn == null || (FunctionMentions(fn, out) == 0 && FunctionReadsGlobal(fn, out) == 0) {
            return
        }
        serial += 1
    }
}

#program_export
TargetFieldName :: (record: *IR.ZirType, target: Native.ZirTarget, name: *u8, out: *u8, size: usize) {
    if IsCReservedName(target, name) {
        copy_text(out, size, name)
        return
    }
    TargetBindingName(null, target, name, out, size)
    if strcmp(out, name) == 0 || record == null { return }
    serial: s32 = 0
    while true {
        offset: usize = 0
        field: IR.ZirTypeField
        collision := false
        CheckFormat(snprintf(out, size, CStr("ziran_keyword_%s_%d"), name, serial), size)
        while CTypeNextField(record, *offset, *field) == 1 {
            if strcmp(*field.name[0], name) != 0 && strcmp(*field.name[0], out) == 0 {
                collision = true
                break
            }
        }
        if !collision { return }
        serial += 1
    }
}

#scope_file

TargetTopName :: (module: *IR.ZirModule, target: Native.ZirTarget, name: *u8, is_global: bool, out: *u8, size: usize) {
    TargetBindingName(null, target, name, out, size)
    if strcmp(out, name) == 0 || module == null { return }
    serial: s32 = 0
    while true {
        collision := false
        CheckFormat(snprintf(out, size, CStr("ziran_keyword_%s_%d"), name, serial), size)
        for i: cast(s32)0..module.global_count - 1 {
            if (!is_global || strcmp(*module.globals[i].name[0], name) != 0) &&
               strcmp(*module.globals[i].name[0], out) == 0 { collision = true }
        }
        for i: cast(s32)0..module.define_count - 1 {
            if (is_global || strcmp(*module.defines[i].name[0], name) != 0) &&
               strcmp(*module.defines[i].name[0], out) == 0 { collision = true }
        }
        for i: cast(s32)0..module.type_count - 1 {
            if strcmp(*module.types[i].name[0], out) == 0 { collision = true }
        }
        for i: cast(s32)0..module.function_count - 1 {
            if strcmp(*module.functions[i].name[0], out) == 0 { collision = true }
        }
        if !collision { return }
        serial += 1
    }
}

NativeValueName :: struct {
    name: *u8
    collision: *s32
    is_type: s32
    next: s32
}

NativeValueNames :: struct {
    items: *NativeValueName
    count: s32
    capacity: s32
    buckets: *s32
    bucket_count: s32
}

FnvOffset :: () -> u64 { return 0xcbf29ce484222325 }
FNV_PRIME :: 1099511628211

NativeNameHash :: (name: *u8) -> u64 {
    hash: u64 = FnvOffset()
    p := name
    while p[0] != 0 {
        hash = (hash ^ cast(u64)p[0]) * cast(u64)FNV_PRIME
        p = PtrAdd(p, 1)
    }
    return hash
}

NativeNamesAdd :: (names: *NativeValueNames, name: *u8, collision: *s32, is_type: s32) -> s32 {
    if names.count == names.capacity {
        capacity := ifx names.capacity != 0 then names.capacity * 2 else 256
        items := cast(*NativeValueName)realloc(cast(*void)names.items, cast(usize)capacity * size_of(NativeValueName))
        if items == null { return 0 }
        names.items = items
        names.capacity = capacity
    }
    copy := strdup(name)
    if copy == null { return 0 }
    bucket := cast(usize)(NativeNameHash(name) % cast(u64)names.bucket_count)
    names.items[names.count] = NativeValueName.{copy, collision, is_type, names.buckets[bucket]}
    names.buckets[bucket] = names.count
    names.count += 1
    return 1
}

NativeNamesMark :: (names: *NativeValueNames, name: *u8) {
    bucket := cast(usize)(NativeNameHash(name) % cast(u64)names.bucket_count)
    i := names.buckets[bucket]
    while i >= 0 {
        if strcmp(names.items[i].name, name) == 0 {
            <<names.items[i].collision = 1
        }
        i = names.items[i].next
    }
}

NativeNamesFree :: (names: *NativeValueNames) {
    for i: cast(s32)0..names.count - 1 {
        free(cast(*void)names.items[i].name)
    }
    free(cast(*void)names.items)
    free(cast(*void)names.buckets)
}

NativeNamesMarkShared :: (names: *NativeValueNames) {
    for bucket: cast(s32)0..names.bucket_count - 1 {
        i := names.buckets[bucket]
        while i >= 0 {
            j := names.items[i].next
            while j >= 0 {
                if names.items[i].collision != names.items[j].collision &&
                   strcmp(names.items[i].name, names.items[j].name) == 0 {
                    <<names.items[i].collision = 1
                    <<names.items[j].collision = 1
                }
                j = names.items[j].next
            }
            i = names.items[i].next
        }
    }
}

NativeNamesMarkTypeValues :: (names: *NativeValueNames) {
    for bucket: cast(s32)0..names.bucket_count - 1 {
        i := names.buckets[bucket]
        while i >= 0 {
            type := *names.items[i]
            if type.is_type != 0 && <<type.collision == 0 {
                j := names.buckets[bucket]
                while j >= 0 {
                    value := *names.items[j]
                    if value.is_type == 0 && <<value.collision == 0 &&
                       strcmp(type.name, value.name) == 0 {
                        <<type.collision = 1
                        break
                    }
                    j = names.items[j].next
                }
            }
            i = names.items[i].next
        }
    }
}

#scope_export

#program_export
MarkNativeNameCollisions :: (programs: **IR.ZirProgram, count: s32) -> s32 {
    names: [2]NativeValueNames
    values: s32 = 0
    ok: s32 = 1
    for p: cast(s32)0..count - 1 {
        for m: cast(s32)0..programs[p].module_count - 1 {
            mod := *programs[p].modules[m]
            values += mod.global_count + mod.define_count + mod.type_count
        }
    }
    for t: 0..1 {
        names[t].bucket_count = values * 2 + 1
        names[t].buckets = cast(*s32)malloc(cast(usize)names[t].bucket_count * size_of(s32))
        if names[t].buckets == null { ok = 0 }
        else { memset(cast(*void)names[t].buckets, 0xff, cast(usize)names[t].bucket_count * size_of(s32)) }
    }
    for p: cast(s32)0..count - 1 {
        if ok == 0 { break }
        for m: cast(s32)0..programs[p].module_count - 1 {
            if ok == 0 { break }
            module := *programs[p].modules[m]
            total := module.global_count + module.define_count
            for v: cast(s32)0..total - 1 {
                if ok == 0 { break }
                is_global := v < module.global_count
                name := ifx is_global then *module.globals[v].name[0] else *module.defines[v - module.global_count].name[0]
                collision := ifx is_global then *module.globals[v].native_name_collision else *module.defines[v - module.global_count].native_name_collision
                for t: 0..1 {
                    if ok == 0 { break }
                    native: [IR.ZIR_NAME_MAX * 2]u8
                    TargetTopName(module, ifx t == 0 then Native.ZirTarget.ZIR_C else Native.ZirTarget.ZIR_GO,
                                  name, is_global, *native[0], IR.ZIR_NAME_MAX * 2)
                    ok = NativeNamesAdd(*names[t], *native[0], collision, 0)
                }
            }
        }
    }
    if ok != 0 {
        NativeNamesMarkShared(*names[0])
        NativeNamesMarkShared(*names[1])
    }
    for p: cast(s32)0..count - 1 {
        if ok == 0 { break }
        for m: cast(s32)0..programs[p].module_count - 1 {
            if ok == 0 { break }
            module := *programs[p].modules[m]
            for t: cast(s32)0..module.type_count - 1 {
                if ok == 0 { break }
                type := *module.types[t]
                if type.is_record_template != 0 || (type.is_extern != 0 && type.foreign_target[0] == 0) { continue }
                native: [IR.ZIR_NAME_MAX * 2]u8
                NativeTypeName(module, type, *native[0], IR.ZIR_NAME_MAX * 2)
                ok = NativeNamesAdd(*names[0], *native[0], *type.native_name_mangled, 1)
            }
        }
    }
    if ok != 0 {
        for p: cast(s32)0..count - 1 {
            for m: cast(s32)0..programs[p].module_count - 1 {
                module := *programs[p].modules[m]
                for f: cast(s32)0..module.function_count - 1 {
                    function := *module.functions[f]
                    if function.is_template != 0 { continue }
                    native: [IR.ZIR_NAME_MAX * 2]u8
                    NativeCFunctionName(module, function, *native[0], IR.ZIR_NAME_MAX * 2)
                    NativeNamesMark(*names[0], *native[0])
                    if NativeProgramMain(module, function) != 0 {
                        NativeNamesMark(*names[0], CStr("main"))
                    }
                    NativeGoFunctionName(programs, count, module, function, *native[0], IR.ZIR_NAME_MAX * 2)
                    NativeNamesMark(*names[1], *native[0])
                    if function.export_symbol[0] != 0 {
                        NativeNamesMark(*names[1], *function.export_symbol[0])
                    }
                }
                for i: cast(s32)0..module.import_count - 1 {
                    foreign := *module.imports[i]
                    if foreign.kind != .EXTERN || strncmp(*foreign.target[0], CStr("c."), 2) != 0 { continue }
                    native: [IR.ZIR_NAME_MAX * 2]u8
                    NativeCForeignName(module, foreign, *native[0], IR.ZIR_NAME_MAX * 2)
                    NativeNamesMark(*names[0], *native[0])
                    NativeNamesMark(*names[0], *foreign.target[2])
                }
            }
        }
        NativeNamesMarkTypeValues(*names[0])
    }
    NativeNamesFree(*names[0])
    NativeNamesFree(*names[1])
    return ok
}

#scope_file

NativeTopHash :: (module: *IR.ZirModule, span: IR.ZirSourceSpan, name: *u8) -> u64 {
    hash: u64 = FnvOffset()
    parts: [3]*u8 = .{*module.source_path[0], CSpanPath(span), name}
    for part: 0..2 {
        p := parts[part]
        while p[0] != 0 {
            hash = (hash ^ cast(u64)p[0]) * cast(u64)FNV_PRIME
            p = PtrAdd(p, 1)
        }
        hash = (hash ^ cast(u64)0xff) * cast(u64)FNV_PRIME
    }
    coords: [2]u32 = .{cast(u32)span.line, cast(u32)span.column}
    for c: 0..1 {
        for b: 0..3 {
            hash = (hash ^ cast(u64)((coords[c] >> cast(u32)(b * 8)) & 0xff)) * cast(u64)FNV_PRIME
        }
    }
    return hash
}

#scope_export

#program_export
TargetGlobalName :: (module: *IR.ZirModule, target: Native.ZirTarget, name: *u8, out: *u8, size: usize) {
    if module != null {
        for i: cast(s32)0..module.global_count - 1 {
            global := *module.globals[i]
            if strcmp(*global.name[0], name) != 0 || global.native_name_collision == 0 { continue }
            hash := NativeTopHash(module, global.span, *global.name[0])
            CheckFormat(snprintf(out, size, CStr("zir_g_%016llx"), hash), size)
            return
        }
    }
    TargetTopName(module, target, name, true, out, size)
}

#program_export
TargetDefineName :: (module: *IR.ZirModule, target: Native.ZirTarget, name: *u8, out: *u8, size: usize) {
    if module != null {
        for i: cast(s32)0..module.define_count - 1 {
            define := *module.defines[i]
            if strcmp(*define.name[0], name) != 0 || define.native_name_collision == 0 { continue }
            hash := NativeTopHash(module, define.span, *define.name[0])
            CheckFormat(snprintf(out, size, CStr("zir_d_%016llx"), hash), size)
            return
        }
    }
    TargetTopName(module, target, name, false, out, size)
}

#program_export
ArrayAbiName :: (fn: *IR.ZirFunction, parameter: s32, out: *u8, size: usize) {
    serial: s32 = 0
    while true {
        kind := ifx parameter < 0 then CStr("result") else CStr("input")
        idx := ifx parameter < 0 then cast(s32)0 else parameter
        CheckFormat(snprintf(out, size, CStr("array_%s_%d_%d"), kind, idx, serial), size)
        serial += 1
        if FunctionMentions(fn, out) == 0 { return }
    }
}

#program_export
ArrayAbiArgs :: (fn: *IR.ZirFunction, out: *u8, size: usize) {
    args := FunctionArgs(fn)
    if fn.return_type[0] != #char "[" && strchr(args, #char "[") == null {
        copy_text(out, size, args)
        return
    }
    parameters := ParametersOf(args)
    items := cast(*CParameter)(*parameters.items[0])
    used: usize = 0
    out[0] = 0
    if ArrayElementType(*fn.return_type[0], null, 0, null) != 0 {
        name: [IR.ZIR_NAME_MAX]u8
        ArrayAbiName(fn, -1, *name[0], IR.ZIR_NAME_MAX)
        used += cast(usize)CheckFormat(snprintf(out, size, CStr("%s: %s"), *name[0], *fn.return_type[0]), size)
    }
    for i: cast(s32)0..parameters.count - 1 {
        parameter := *items[i]
        sep := ifx used != 0 then CStr(", ") else CStr("")
        if parameter.type != null && ArrayValueType(parameter.type) != 0 {
            name: [IR.ZIR_NAME_MAX]u8
            ArrayAbiName(fn, i, *name[0], IR.ZIR_NAME_MAX)
            used += cast(usize)CheckFormat(snprintf(PtrAdd(out, used), size - used, CStr("%s%s: %s"), sep, *name[0], parameter.type), size - used)
        } else {
            used += cast(usize)CheckFormat(snprintf(PtrAdd(out, used), size - used, CStr("%s%s"), sep, parameter.text), size - used)
        }
    }
}

#program_export "zir_emit_canonical"
Canonical :: (type: *u8) -> *u8 {
    result := ScalarType(type)
    if strcmp(type, CStr("integer")) == 0 { return CStr("s64") }
    if strcmp(type, CStr("real")) == 0 { return CStr("float64") }
    if result[0] != 0 { return result }
    return type
}

#program_export
NativeTypeName :: (owner: *IR.ZirModule, type: *IR.ZirType, out: *u8, size: usize) {
    if type.native_name_mangled == 0 {
        copy_text(out, size, *type.name[0])
        return
    }
    hash: u64 = FnvOffset()
    paths: [2]*u8 = .{*owner.source_path[0], CSpanPath(type.span)}
    for part: 0..1 {
        p := paths[part]
        while p[0] != 0 {
            hash = (hash ^ cast(u64)p[0]) * cast(u64)FNV_PRIME
            p = PtrAdd(p, 1)
        }
        hash = (hash ^ cast(u64)0xff) * cast(u64)FNV_PRIME
    }
    coords: [2]u32 = .{cast(u32)type.span.line, cast(u32)type.span.column}
    for i: 0..1 {
        for b: 0..3 {
            hash = (hash ^ cast(u64)((coords[i] >> cast(u32)(b * 8)) & 0xff)) * cast(u64)FNV_PRIME
        }
    }
    length := snprintf(out, size, CStr("zir_%016llx_"), hash)
    if length < 0 || cast(usize)length >= size {
        if size > 0 { out[0] = 0 }
        return
    }
    used := cast(usize)length
    p := *type.name[0]
    while p[0] != 0 && used + 1 < size {
        out[used] = ifx IsAlnum(p[0]) || p[0] == #char "_" then p[0] else #char "_"
        used += 1
        p = PtrAdd(p, 1)
    }
    out[used] = 0
}

#program_export
NativeTypeAtUse :: (module: *IR.ZirModule, type: *u8, out: *u8, size: usize) -> s32 {
    owner: *IR.ZirModule = null
    declared := CFindType(module, type, *owner)
    if declared == null || owner == null ||
       (declared.is_extern != 0 && declared.foreign_target[0] == 0) ||
       (declared.native_name_mangled == 0 && strchr(type, #char ".") == null) ||
       BuiltinType(*declared.name[0]) == declared {
        return 0
    }
    NativeTypeName(owner, declared, out, size)
    return ifx out[0] != 0 then 1 else 0
}

#program_export "zir_emit_resolve_type_at_use"
ResolveTypeAtUse :: (context: *void, source: *u8, out: *u8, size: usize) {
    if NativeTypeAtUse(cast(*IR.ZirModule)context, source, out, size) == 0 {
        copy_text(out, size, source)
    }
}

#program_export
NativeConstantOwner :: (module: *IR.ZirModule, name: *u8) -> *IR.ZirModule {
    for pass: 0..1 {
        count := ifx pass == 0 then cast(s32)1 else module.import_count
        for i: cast(s32)0..count - 1 {
            scope := ifx pass == 0 then module else module.imports[i].resolved_module
            if scope == null { continue }
            for j: cast(s32)0..scope.define_count - 1 {
                if (pass == 0 || scope.defines[j].is_public != 0) &&
                   strcmp(*scope.defines[j].name[0], name) == 0 {
                    return scope
                }
            }
        }
    }
    return null
}

#program_export
NativeGoType :: (module: *IR.ZirModule, type: *u8, dst: *u8, dst_size: usize) -> s32 {
    t: [IR.ZIR_NAME_MAX * 2]u8
    snprintf(*t[0], IR.ZIR_NAME_MAX * 2, CStr("%s"), type)
    n := strlen(*t[0])
    while n > 0 && IsSpace(t[n - 1]) {
        n -= 1
        t[n] = 0
    }
    p := *t[0]
    while p[0] != 0 && IsSpace(p[0]) { p = PtrAdd(p, 1) }
    if p != *t[0] {
        memmove(cast(*void)*t[0], cast(*void)p, strlen(p) + 1)
    }
    scalar := ScalarType(*t[0])
    target_go := cast(*u8)Native.TargetType(cast(*void)*t[0], .ZIR_GO)
    if (scalar[0] != 0 || VectorType(*t[0], null) != 0) && target_go != null {
        snprintf(dst, dst_size, CStr("%s"), target_go)
        return 1
    }
    if t[0] == #char "[" {
        close := strchr(*t[0], #char "]")
        if close != null {
            bound: [IR.ZIR_NAME_MAX * 2]u8
            bound_len := cast(s32)(cast(usize)close - cast(usize)*t[0] - 1)
            snprintf(*bound[0], IR.ZIR_NAME_MAX * 2, CStr("%.*s"), bound_len, *t[1])
            if module != null {
                owner := NativeConstantOwner(module, *bound[0])
                if owner != null {
                    mapped: [IR.ZIR_NAME_MAX * 2]u8
                    TargetDefineName(owner, .ZIR_GO, *bound[0], *mapped[0], IR.ZIR_NAME_MAX * 2)
                    snprintf(*bound[0], IR.ZIR_NAME_MAX * 2, CStr("%s"), *mapped[0])
                }
            }
            base := PtrAdd(close, 1)
            while base[0] == #char " " || base[0] == #char "\t" { base = PtrAdd(base, 1) }
            gt: [IR.ZIR_NAME_MAX * 2]u8
            if NativeGoType(module, base, *gt[0], IR.ZIR_NAME_MAX * 2) != 0 {
                close[0] = 0
                snprintf(dst, dst_size, CStr("[%s]%s"), *bound[0], *gt[0])
                return 1
            }
        }
        return 0
    }
    if t[0] == #char "*" && t[1] != 0 {
        if strcmp(*t[1], CStr("void")) == 0 {
            snprintf(dst, dst_size, CStr("*byte"))
            return 1
        }
        gt: [IR.ZIR_NAME_MAX * 2]u8
        if NativeGoType(module, *t[1], *gt[0], IR.ZIR_NAME_MAX * 2) != 0 {
            snprintf(dst, dst_size, CStr("*%s"), *gt[0])
            return 1
        }
        return 0
    }
    identish := t[0] != 0
    c := *t[0]
    while c[0] != 0 {
        if is_ident_char(cast(s32)c[0]) == 0 && c[0] != #char "." { identish = false }
        c = PtrAdd(c, 1)
    }
    owner: *IR.ZirModule = null
    declared := ifx identish && module != null then CFindType(module, *t[0], *owner) else null
    if declared != null {
        if owner != null { NativeTypeName(owner, declared, dst, dst_size) }
        else { snprintf(dst, dst_size, CStr("%s"), *declared.name[0]) }
        return 1
    }
    return 0
}

#program_export
NativeEnumMemberName :: (owner: *IR.ZirModule, type: *IR.ZirType, member: *u8, out: *u8, size: usize) -> s32 {
    if type.is_enum == 0 || type.native_name_mangled == 0 { return 0 }
    native: [IR.ZIR_NAME_MAX * 2]u8
    NativeTypeName(owner, type, *native[0], IR.ZIR_NAME_MAX * 2)
    CheckFormat(snprintf(out, size, CStr("%s_%s"), *native[0], member), size)
    return 1
}

#program_export
NativeExportName :: (module: *IR.ZirModule, fn: *IR.ZirFunction, out: *u8, size: usize) {
    symbol := ifx fn.export_symbol[0] != 0 then *fn.export_symbol[0] else *fn.name[0]
    if NativeHeaderKeyword(symbol) == 0 {
        copy_text(out, size, symbol)
        return
    }
    serial: s32 = 0
    while true {
        collision := false
        CheckFormat(snprintf(out, size, CStr("ziran_keyword_%s_%d"), symbol, serial), size)
        for i: cast(s32)0..module.global_count - 1 {
            if strcmp(out, *module.globals[i].name[0]) == 0 { collision = true }
        }
        for i: cast(s32)0..module.define_count - 1 {
            if strcmp(out, *module.defines[i].name[0]) == 0 { collision = true }
        }
        for i: cast(s32)0..module.type_count - 1 {
            if strcmp(out, *module.types[i].name[0]) == 0 { collision = true }
        }
        for i: cast(s32)0..module.function_count - 1 {
            if *module.functions[i] != fn {
                if strcmp(out, *module.functions[i].name[0]) == 0 ||
                   strcmp(out, *module.functions[i].export_symbol[0]) == 0 {
                    collision = true
                }
            }
        }
        if !collision { return }
        serial += 1
    }
}

#program_export
NativeCFunctionName :: (module: *IR.ZirModule, fn: *IR.ZirFunction, out: *u8, size: usize) {
    if NativeProgramMain(module, fn) != 0 {
        hash: u64 = FnvOffset()
        p := *module.name[0]
        while p[0] != 0 { hash = (hash ^ cast(u64)p[0]) * cast(u64)FNV_PRIME; p = PtrAdd(p, 1) }
        hash *= cast(u64)FNV_PRIME
        q := *fn.name[0]
        while q[0] != 0 { hash = (hash ^ cast(u64)q[0]) * cast(u64)FNV_PRIME; q = PtrAdd(q, 1) }
        CheckFormat(snprintf(out, size, CStr("zir_main_%016llx"), hash), size)
        return
    }
    if fn.exported != 0 {
        NativeExportName(module, fn, out, size)
        return
    }
    if module.name[0] != 0 && strcmp(*module.name[0], CStr("main")) != 0 {
        prefix: [256]u8
        used: usize = 0
        needs_encoding := IsDigit(module.name[0])
        p := *module.name[0]
        while p[0] != 0 {
            if !IsAlnum(p[0]) && p[0] != #char "_" { needs_encoding = true }
            p = PtrAdd(p, 1)
        }
        if needs_encoding {
            hash: u64 = FnvOffset()
            r := *module.name[0]
            while r[0] != 0 { hash = (hash ^ cast(u64)r[0]) * cast(u64)FNV_PRIME; r = PtrAdd(r, 1) }
            CheckFormat(snprintf(out, size, CStr("zir_m_%016llx_%s"), hash, *fn.name[0]), size)
            return
        }
        s := *module.name[0]
        while s[0] != 0 && used + 1 < 256 {
            prefix[used] = ifx s[0] == #char "." then #char "_" else s[0]
            used += 1
            s = PtrAdd(s, 1)
        }
        prefix[used] = 0
        CheckFormat(snprintf(out, size, CStr("%s_%s"), *prefix[0], *fn.name[0]), size)
    } else {
        copy_text(out, size, *fn.name[0])
    }
}

#program_export
NativeCForeignName :: (module: *IR.ZirModule, foreign: *IR.ZirImport, out: *u8, size: usize) {
    hash: u64 = FnvOffset()
    p := *module.name[0]
    while p[0] != 0 { hash = (hash ^ cast(u64)p[0]) * cast(u64)FNV_PRIME; p = PtrAdd(p, 1) }
    CheckFormat(snprintf(out, size, CStr("zir_f_%016llx_%s"), hash, *foreign.name[0]), size)
}

#scope_file

ReadableModuleName :: (name: *u8, out: *u8, size: usize, upper: bool) {
    used: usize = 0
    p := name
    while p[0] != 0 && used + 1 < size {
        if IsAlnum(p[0]) {
            out[used] = ifx upper then ToUpper(p[0]) else p[0]
        } else {
            out[used] = #char "_"
        }
        used += 1
        p = PtrAdd(p, 1)
    }
    out[used] = 0
}

#scope_export

#program_export
NativeCModuleInitName :: (module: *IR.ZirModule, out: *u8, size: usize) {
    name: [IR.ZIR_PATH_MAX]u8
    ReadableModuleName(*module.name[0], *name[0], IR.ZIR_PATH_MAX, false)
    CheckFormat(snprintf(out, size, CStr("ziran_init_%s"), *name[0]), size)
}

#scope_file

ModuleVisits :: struct {
    items: **IR.ZirModule
    count: usize
    capacity: usize
}

ModuleNeedsStartupWalk :: (module: *IR.ZirModule, visits: *ModuleVisits) -> s32 {
    if module == null { return 0 }
    i: usize = 0
    while i < visits.count {
        if visits.items[i] == module { return 0 }
        i += 1
    }
    if visits.count == visits.capacity {
        capacity := ifx visits.capacity != 0 then visits.capacity * 2 else cast(usize)64
        items := cast(**IR.ZirModule)realloc(cast(*void)visits.items, capacity * size_of(*IR.ZirModule))
        if items == null { abort() }
        visits.items = items
        visits.capacity = capacity
    }
    visits.items[visits.count] = module
    visits.count += 1
    for f: cast(s32)0..module.function_count - 1 {
        if module.functions[f].is_global_initializer != 0 { return 1 }
    }
    for i: cast(s32)0..module.import_count - 1 {
        if ModuleNeedsStartupWalk(module.imports[i].resolved_module, visits) != 0 { return 1 }
    }
    return 0
}

#scope_export

#program_export
ModuleNeedsStartup :: (module: *IR.ZirModule) -> s32 {
    visits: ModuleVisits
    result := ModuleNeedsStartupWalk(module, *visits)
    free(cast(*void)visits.items)
    return result
}

#scope_file

GoFileStem :: (source: *u8, out: *u8, size: usize) {
    slash := strrchr(source, #char "/")
    base := ifx slash != null then PtrAdd(slash, 1) else source
    length := strlen(base)
    if length > 3 && strcmp(PtrAdd(base, length - 3), CStr(".zi")) == 0 { length -= 3 }
    if length >= size { length = size - 1 }
    memcpy(cast(*void)out, cast(*void)base, length)
    out[length] = 0
}

SameFoldedName :: (left: *u8, right: *u8) -> bool {
    a := left
    b := right
    while a[0] != 0 && b[0] != 0 {
        if ToLower(a[0]) != ToLower(b[0]) { return false }
        a = PtrAdd(a, 1)
        b = PtrAdd(b, 1)
    }
    return a[0] == b[0]
}

ModuleIdentityUncached :: (programs: **IR.ZirProgram, count: s32, module: *IR.ZirModule,
                           file_stem: *u8, file_size: usize, guard: *u8, guard_size: usize) {
    GoFileStem(*module.source_path[0], file_stem, file_size)
    camel_ident(file_stem, guard, guard_size)
    for p: cast(s32)0..count - 1 {
        for m: cast(s32)0..programs[p].module_count - 1 {
            other := *programs[p].modules[m]
            if other == module { continue }
            other_stem: [IR.ZIR_PATH_MAX]u8
            other_guard: [256]u8
            GoFileStem(*other.source_path[0], *other_stem[0], IR.ZIR_PATH_MAX)
            camel_ident(*other_stem[0], *other_guard[0], 256)
            if !SameFoldedName(file_stem, *other_stem[0]) && strcmp(guard, *other_guard[0]) != 0 { continue }
            hash: u64 = FnvOffset()
            cursor := *module.source_path[0]
            while cursor[0] != 0 {
                hash = (hash ^ cast(u64)cursor[0]) * cast(u64)FNV_PRIME
                cursor = PtrAdd(cursor, 1)
            }
            CheckFormat(snprintf(file_stem, file_size, CStr("zir_%016llx"), hash), file_size)
            CheckFormat(snprintf(guard, guard_size, CStr("Zir_%016llx"), hash), guard_size)
            return
        }
    }
}

ModuleIdentitySlot :: (id: *ModuleIdentities, module: *IR.ZirModule, capacity: usize) -> usize {
    key := cast(usize)module
    slot := cast(usize)((cast(u64)(key >> 4) * cast(u64)11400714819323198485) & cast(u64)(capacity - 1))
    while id.slots[slot].module != null && id.slots[slot].module != module {
        slot = (slot + 1) & (capacity - 1)
    }
    return slot
}

ResetModuleIdentities :: (id: *ModuleIdentities, programs: **IR.ZirProgram, count: s32) {
    modules: usize = 0
    for p: cast(s32)0..count - 1 {
        modules += cast(usize)programs[p].module_count
    }
    capacity: usize = 64
    while capacity < modules * 2 { capacity *= 2 }
    free(cast(*void)id.slots)
    id.slots = cast(*ModuleIdentity)calloc(capacity, size_of(ModuleIdentity))
    if id.slots == null { abort() }
    id.capacity = capacity
    id.used = 0
    id.programs = cast(usize)programs
    id.count = count
}

#scope_export

#program_export
NativeGoModuleIdentity :: (programs: **IR.ZirProgram, count: s32, module: *IR.ZirModule,
                           file_stem: *u8, file_size: usize, guard: *u8, guard_size: usize) {
    id := ContextModuleIdentities()
    if id.slots == null || id.programs != cast(usize)programs || id.count != count ||
       (id.used + 1) * 2 > id.capacity {
        ResetModuleIdentities(id, programs, count)
    }
    slot := ModuleIdentitySlot(id, module, id.capacity)
    entry := *id.slots[slot]
    if entry.module == null {
        ModuleIdentityUncached(programs, count, module, *entry.file_stem[0], IR.ZIR_PATH_MAX, *entry.guard[0], 256)
        entry.module = module
        id.used += 1
    }
    copy_text(file_stem, file_size, *entry.file_stem[0])
    copy_text(guard, guard_size, *entry.guard[0])
}

#program_export
NativeGoFunctionName :: (programs: **IR.ZirProgram, count: s32, module: *IR.ZirModule,
                         fn: *IR.ZirFunction, out: *u8, size: usize) {
    stem: [IR.ZIR_PATH_MAX]u8
    guard: [256]u8
    name: [256]u8
    NativeGoModuleIdentity(programs, count, module, *stem[0], IR.ZIR_PATH_MAX, *guard[0], 256)
    camel_ident(*fn.name[0], *name[0], 256)
    CheckFormat(snprintf(out, size, CStr("%s_%s"), *guard[0], *name[0]), size)
}

#program_export
NativeHeaderGuard :: (stem: *u8, out: *u8, size: usize) {
    name: [IR.ZIR_PATH_MAX]u8
    used: usize = 0
    p := stem
    while p[0] != 0 && used + 2 < IR.ZIR_PATH_MAX {
        if IsUpper(p[0]) {
            name[used] = #char "_"
            used += 1
        }
        name[used] = ifx IsAlnum(p[0]) then ToUpper(p[0]) else #char "_"
        used += 1
        p = PtrAdd(p, 1)
    }
    name[used] = 0
    if cast(usize)CheckFormat(snprintf(out, size, CStr("ZIRAN_%s_H"), *name[0]), size) >= size {
        zero_span: IR.ZirSourceSpan
        Diagnostic(zero_span, CStr("zir.output"), CStr("generated header guard exceeds output limit"))
        exit(1)
    }
}

#program_export "zir_emit_slot_native_type"
SlotNativeType :: (source: *u8, target: Native.ZirTarget, out: *u8, size: usize) {
    if source[0] == #char "*" {
        array := source
        pointers: s32 = 0
        while array[0] == #char "*" {
            pointers += 1
            array = skip_ws(PtrAdd(array, 1))
        }
        if target == .ZIR_C && array[0] == #char "[" {
            dimensions: [IR.ZIR_NAME_MAX]u8
            element: [IR.ZIR_NAME_MAX]u8
            end := array
            while end[0] == #char "[" {
                close := strchr(end, #char "]")
                if close == null { break }
                end = skip_ws(PtrAdd(close, 1))
            }
            length := cast(usize)end - cast(usize)array
            if length >= IR.ZIR_NAME_MAX { length = IR.ZIR_NAME_MAX - 1 }
            memcpy(cast(*void)*dimensions[0], cast(*void)array, length)
            dimensions[length] = 0
            SlotNativeType(end, target, *element[0], IR.ZIR_NAME_MAX)
            stars := CStr("****************************************************************")
            CheckFormat(snprintf(out, size, CStr("%s (%.*s)%s"), *element[0], pointers, stars, *dimensions[0]), size)
            return
        }
        pointee: [IR.ZIR_NAME_MAX]u8
        SlotNativeType(skip_ws(PtrAdd(source, 1)), target, *pointee[0], IR.ZIR_NAME_MAX)
        CheckFormat(snprintf(out, size, CStr("%s*"), *pointee[0]), size)
        return
    }
    scalar := cast(*u8)Native.TargetType(cast(*void)source, target)
    copy_text(out, size, ifx scalar != null then scalar else source)
}

#program_export "zir_emit_slot_type_at_use"
SlotTypeAtUse :: (source: *u8, target: Native.ZirTarget, resolve_type: ZirResolveTarget,
                  context: *void, out: *u8, size: usize) {
    base := source
    while base[0] == #char "*" || base[0] == #char "[" {
        if base[0] == #char "*" {
            base = skip_ws(PtrAdd(base, 1))
        } else {
            close := strchr(base, #char "]")
            if close == null { break }
            base = skip_ws(PtrAdd(close, 1))
        }
    }
    if resolve_type != null {
        resolved: [IR.ZIR_NAME_MAX]u8
        canon: [IR.ZIR_NAME_MAX * 2]u8
        resolve_type(context, base, *resolved[0], IR.ZIR_NAME_MAX)
        prefix_len := cast(s32)(cast(usize)base - cast(usize)source)
        CheckFormat(snprintf(*canon[0], IR.ZIR_NAME_MAX * 2, CStr("%.*s%s"), prefix_len, source, *resolved[0]), IR.ZIR_NAME_MAX * 2)
        SlotNativeType(*canon[0], target, out, size)
    } else {
        SlotNativeType(source, target, out, size)
    }
}

#program_export
EmitSlotType :: (out: *void, slot: *IR.ZirType, target: Native.ZirTarget,
                 resolve_type: ZirResolveTarget, context: *void) {
    parameters := cast(*u8)AllocateOrExit(cast(usize)(64 * IR.ZIR_TEXT_MAX))
    defer { free(cast(*void)parameters) }
    name: [IR.ZIR_NAME_MAX * 2]u8
    copy_text(*name[0], IR.ZIR_NAME_MAX * 2, *slot.name[0])
    if resolve_type != null {
        resolve_type(context, *slot.name[0], *name[0], IR.ZIR_NAME_MAX * 2)
    }
    count := ifx skip_ws(*slot.body[0])[0] != 0 then split_top_level(*slot.body[0], parameters, 64, IR.ZIR_TEXT_MAX) else cast(s32)0
    if slot.is_c_call != 0 {
        result: [IR.ZIR_NAME_MAX]u8
        SlotTypeAtUse(*slot.procedure_return_type[0], target, resolve_type, context, *result[0], IR.ZIR_NAME_MAX)
        fprintf(out, CStr("typedef %s (*%s)("), *result[0], *name[0])
        for i: cast(s32)0..count - 1 {
            param := PtrAdd(parameters, cast(usize)i * IR.ZIR_TEXT_MAX)
            source := skip_ws(PtrAdd(strchr(param, #char ":"), 1))
            type: [IR.ZIR_NAME_MAX]u8
            SlotTypeAtUse(source, target, resolve_type, context, *type[0], IR.ZIR_NAME_MAX)
            fprintf(out, CStr("%s%s"), ifx i != 0 then CStr(", ") else CStr(""), *type[0])
        }
        fprintf(out, CStr("%s);\n"), ifx count != 0 then CStr("") else CStr("void"))
        return
    }
    result_source := *slot.procedure_return_type[0]
    result_type: [IR.ZIR_NAME_MAX]u8
    if target == .ZIR_GO {
        result_scalar := cast(*u8)Native.TargetType(cast(*void)result_source, target)
        copy_text(*result_type[0], IR.ZIR_NAME_MAX, ifx result_scalar != null then result_scalar else result_source)
    } else {
        SlotNativeType(result_source, target, *result_type[0], IR.ZIR_NAME_MAX)
    }
    if resolve_type != null && strcmp(result_source, CStr("void")) != 0 {
        resolve_type(context, result_source, *result_type[0], IR.ZIR_NAME_MAX)
    }
    if target == .ZIR_GO {
        fprintf(out, CStr("type %s func("), *name[0])
    } else {
        fprintf(out, CStr("typedef struct %s {\n    void *context;\n    %s (*call)(void *"), *name[0], *result_type[0])
    }
    for i: cast(s32)0..count - 1 {
        param := PtrAdd(parameters, cast(usize)i * IR.ZIR_TEXT_MAX)
        colon := strchr(param, #char ":")
        source := skip_ws(PtrAdd(colon, 1))
        type: [IR.ZIR_NAME_MAX]u8
        if target == .ZIR_GO {
            scalar := cast(*u8)Native.TargetType(cast(*void)source, target)
            copy_text(*type[0], IR.ZIR_NAME_MAX, ifx scalar != null then scalar else source)
        } else {
            SlotNativeType(source, target, *type[0], IR.ZIR_NAME_MAX)
        }
        if resolve_type != null {
            resolve_type(context, source, *type[0], IR.ZIR_NAME_MAX)
        }
        sep := ifx i != 0 || target != .ZIR_GO then CStr(", ") else CStr("")
        fprintf(out, CStr("%s%s"), sep, *type[0])
    }
    if target == .ZIR_GO {
        fprintf(out, CStr(")%s%s\n\n"), ifx result_type[0] != 0 then CStr(" ") else CStr(""), *result_type[0])
    } else {
        fprintf(out, CStr(");\n} %s;\n"), *name[0])
    }
}

#program_export "zir_emit_width"
Width :: (type: *u8) -> s32 {
    if type[0] == #char "s" || type[0] == #char "u" { return atoi(PtrAdd(type, 1)) }
    return 0
}

#program_export "zir_emit_signed_type"
SignedType :: (type: *u8) -> s32 {
    return ifx type[0] == #char "s" then 1 else 0
}

#program_export "zir_emit_enum_type"
EnumType :: (module: *IR.ZirModule, type: *u8) -> s32 {
    declared := CFindType(module, type, null)
    return ifx declared != null && declared.is_enum != 0 then 1 else 0
}

#program_export "zir_emit_enum_flags_type"
EnumFlagsType :: (module: *IR.ZirModule, type: *u8) -> s32 {
    declared := CFindType(module, type, null)
    return ifx declared != null && declared.is_enum_flags != 0 then 1 else 0
}

#program_export "zir_emit_record_type"
RecordType :: (module: *IR.ZirModule, type: *u8) -> s32 {
    declared := CFindType(module, type, null)
    return ifx declared != null && declared.is_enum == 0 && declared.is_procedure_type == 0 then 1 else 0
}

#program_export "zir_emit_field_record"
FieldRecord :: (module: *IR.ZirModule, type: *u8, owner: **IR.ZirModule) -> *IR.ZirType {
    base := skip_ws(type)
    while base[0] == #char "*" { base = skip_ws(PtrAdd(base, 1)) }
    return CFindType(module, base, owner)
}

#program_export "zir_emit_spelled_pointer_field"
SpelledPointerField :: (record: *IR.ZirType, name: *u8, field: *IR.ZirTypeField) -> s32 {
    return ifx record != null && TypeFindField(record, name, field) == 1 &&
               field.c_type[0] != 0 && field.type[0] == #char "*" then 1 else 0
}

#program_export "zir_emit_spelled_field_store"
SpelledFieldStore :: (target: Native.ZirTarget, record: *IR.ZirType, name: *u8, value: *u8, size: usize) {
    field: IR.ZirTypeField
    if target != .ZIR_C || SpelledPointerField(record, name, *field) == 0 { return }
    length := strlen(value)
    prefix := strlen(*field.c_type[0]) + 3
    if length + prefix + 2 > size {
        Diagnostic(record.span, CStr("emit.expression"), CStr("field value is too long"))
        exit(1)
    }
    memmove(cast(*void)PtrAdd(value, prefix), cast(*void)value, length)
    value[0] = #char "("
    memcpy(cast(*void)PtrAdd(value, 1), cast(*void)*field.c_type[0], prefix - 3)
    memcpy(cast(*void)PtrAdd(value, prefix - 2), cast(*void)CStr(")("), 2)
    memcpy(cast(*void)PtrAdd(value, prefix + length), cast(*void)CStr(")"), 2)
}

#program_export "zir_emit_emit_field_path"
EmitFieldPath :: (module: *IR.ZirModule, target: Native.ZirTarget, base_type: *u8, path: *u8,
                  read: s32, base_expression: *u8, out: *u8, size: usize) {
    result := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    next := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    defer { free(cast(*void)result); free(cast(*void)next) }
    current_type: [IR.ZIR_NAME_MAX]u8
    scope := module
    copy_text(result, IR.ZIR_TEXT_MAX, base_expression)
    copy_text(*current_type[0], IR.ZIR_NAME_MAX, base_type)
    part := path
    while part[0] != 0 {
        dot := strchr(part, #char ".")
        length := ifx dot == null then strlen(part) else cast(usize)dot - cast(usize)part
        name: [IR.ZIR_NAME_MAX]u8
        mapped: [IR.ZIR_NAME_MAX]u8
        if length == 0 || length >= IR.ZIR_NAME_MAX {
            Diagnostic(module.span, CStr("emit.expression"), CStr("invalid checked record field path"))
            exit(1)
        }
        memcpy(cast(*void)*name[0], cast(*void)part, length)
        name[length] = 0
        owner: *IR.ZirModule = null
        record := FieldRecord(scope, *current_type[0], *owner)
        if owner != null { scope = owner }
        if target == .ZIR_GO && record != null && record.is_union != 0 {
            field_type: *u8 = null
            find: usize = 0
            found_field: IR.ZirTypeField
            while CTypeNextField(record, *find, *found_field) == 1 {
                if strcmp(*found_field.name[0], *name[0]) == 0 {
                    field_type = *found_field.type[0]
                    break
                }
            }
            if field_type != null {
                enumeration := CFindType(scope, field_type, null)
                backing := ifx enumeration != null && enumeration.is_enum != 0 then *enumeration.enum_backing[0] else field_type
                go_type := cast(*u8)Native.TargetType(cast(*void)backing, .ZIR_GO)
                if go_type == null && enumeration != null && enumeration.is_enum != 0 {
                    go_type = field_type
                }
                if go_type != null {
                    CheckFormat(snprintf(next, IR.ZIR_TEXT_MAX, CStr("*(*%s)(unsafe.Pointer(&%s.data[0]))"), go_type, result), IR.ZIR_TEXT_MAX)
                    copy_text(result, IR.ZIR_TEXT_MAX, next)
                    if dot == null { break }
                    part = PtrAdd(dot, 1)
                    continue
                }
            }
        }
        if target == .ZIR_GO {
            go_field_ident(*name[0], *mapped[0], IR.ZIR_NAME_MAX)
        } else {
            TargetFieldName(record, target, *name[0], *mapped[0], IR.ZIR_NAME_MAX)
        }
        base := skip_ws(*current_type[0])
        chain := result[0] != 0 && !IsDigit(result[0])
        c := result
        while c[0] != 0 && chain {
            chain = is_ident_char(cast(s32)c[0]) != 0 || c[0] == #char "." ||
                    (c[0] == #char "-" && c[1] == #char ">") ||
                    (c[0] == #char ">" && cast(usize)c > cast(usize)result && PtrSub(c, 1)[0] == #char "-")
            c = PtrAdd(c, 1)
        }
        sep := ifx target != .ZIR_GO && base[0] == #char "*" then CStr("->") else CStr(".")
        fmt := ifx chain then CStr("%s%s%s") else CStr("(%s)%s%s")
        CheckFormat(snprintf(next, IR.ZIR_TEXT_MAX, fmt, result, sep, *mapped[0]), IR.ZIR_TEXT_MAX)
        copy_text(result, IR.ZIR_TEXT_MAX, next)
        spelled: IR.ZirTypeField
        if dot == null && read != 0 && target == .ZIR_C && SpelledPointerField(record, *name[0], *spelled) != 0 {
            native: [IR.ZIR_NAME_MAX]u8
            SlotTypeAtUse(*spelled.type[0], target, ResolveTypeAtUse, cast(*void)scope, *native[0], IR.ZIR_NAME_MAX)
            CheckFormat(snprintf(next, IR.ZIR_TEXT_MAX, CStr("((%s)%s)"), *native[0], result), IR.ZIR_TEXT_MAX)
            copy_text(result, IR.ZIR_TEXT_MAX, next)
        }
        if dot == null { break }
        offset: usize = 0
        field: IR.ZirTypeField
        found := false
        while record != null && CTypeNextField(record, *offset, *field) == 1 {
            if strcmp(*field.name[0], *name[0]) == 0 {
                copy_text(*current_type[0], IR.ZIR_NAME_MAX, *field.type[0])
                found = true
                break
            }
        }
        if !found {
            Diagnostic(module.span, CStr("emit.expression"), CStr("invalid checked record field path"))
            exit(1)
        }
        part = PtrAdd(dot, 1)
    }
    copy_text(out, size, result)
}

#program_export
EmitStringType :: (out: *void) {
    fputs(CStr("#include \"zir_string_types.h\"\n"), out)
}

#program_export "zir_emit_zero_value"
ZeroValue :: (type: *u8, target: Native.ZirTarget) -> *u8 {
    if SliceElementType(type, null, 0) != 0 {
        return ifx target == .ZIR_GO then CStr("nil") else CStr("{0}")
    }
    if type[0] == #char "[" { return CStr("") }
    vector: ZirVector
    if VectorType(Canonical(type), *vector) != 0 {
        if target != .ZIR_GO { return CStr("{0}") }
        go_zeros: [20]string = .{
            "[16]uint8{}", "[16]int8{}", "[8]uint16{}", "[8]int16{}", "[4]uint32{}",
            "[4]int32{}", "[2]uint64{}", "[2]int64{}", "[4]float32{}", "[2]float64{}",
            "[32]uint8{}", "[32]int8{}", "[16]uint16{}", "[16]int16{}", "[8]uint32{}",
            "[8]int32{}", "[4]uint64{}", "[4]int64{}", "[8]float32{}", "[4]float64{}"
        }
        native := cast(*u8)Native.TargetType(cast(*void)vector.name, .ZIR_GO)
        nlen := strlen(native)
        for i: 0..19 {
            z := CStr(go_zeros[i])
            if strncmp(z, native, nlen) == 0 && strcmp(PtrAdd(z, nlen), CStr("{}")) == 0 {
                return z
            }
        }
    }
    if type[0] != #char "[" && strchr(type, #char "*") != null {
        return ifx target == .ZIR_GO then CStr("nil") else CStr("((void *)0)")
    }
    canon := Canonical(type)
    if strcmp(canon, CStr("string")) == 0 {
        return ifx target == .ZIR_C then CStr("StringView(NULL, 0)") else CStr("\"\"")
    }
    if strcmp(canon, CStr("bool")) == 0 { return CStr("false") }
    return CStr("0")
}

#program_export "zir_emit_number_prefix"
NumberPrefix :: (module: *IR.ZirModule, out: *u8, size: usize) {
    name: [IR.ZIR_PATH_MAX]u8
    ReadableModuleName(*module.name[0], *name[0], IR.ZIR_PATH_MAX, false)
    CheckFormat(snprintf(out, size, CStr("number_%s"), *name[0]), size)
}

#program_export
EmitNumbers :: (out: *void, module: *IR.ZirModule, target: Native.ZirTarget) {
    if target == .ZIR_C {
        fputs(CStr("/* ziran numeric helpers */\n"), out)
    }
}

#program_export
EmitGoPrintSupport :: (out: *void) {
    fputs(CStr("func formatFloat(value float64, bits int) string {\n\tswitch {\n\tcase math.IsNaN(value):\n\t\treturn \"nan\"\n\tcase math.IsInf(value, 1):\n\t\treturn \"inf\"\n\tcase math.IsInf(value, -1):\n\t\treturn \"-inf\"\n\t}\n\treturn strconv.FormatFloat(value, 'f', -1, bits)\n}\n\n"), out)
}

#program_export
NativeProgramMain :: (module: *IR.ZirModule, fn: *IR.ZirFunction) -> s32 {
    if fn.exported != 0 {
        sym := ifx fn.export_symbol[0] != 0 then *fn.export_symbol[0] else *fn.name[0]
        return ifx strcmp(sym, CStr("main")) == 0 then 1 else 0
    }
    return ifx strcmp(*module.name[0], CStr("main")) == 0 && strcmp(*fn.name[0], CStr("main")) == 0 then 1 else 0
}

#scope_file

NativeEntryError :: (fn: *IR.ZirFunction, target: *u8, reason: *u8) {
    DiagnosticTarget(fn.span, CStr("zir_c.entry"), target, CStr("entry.signature"),
                     CStr("native entry %s %s"), *fn.name[0], reason)
}

#scope_export

#program_export
CheckNativeEntry :: (fn: *IR.ZirFunction, target: *u8) -> s32 {
    ret := IR.BufferText(fn.return_type[:])
    integer_result := Scalar.Width(ret) != 0 || ret == "isize" || ret == "usize"
    if fn.return_type[0] != 0 && ret != "void" && !integer_result {
        NativeEntryError(fn, target, CStr("must return nothing or an integer"))
        return 0
    }
    parameters := ParametersOf(FunctionArgs(fn))
    items := cast(*CParameter)(*parameters.items[0])
    count_type := ifx parameters.count != 0 && items[0].type != null then IR.CText(items[0].type) else ""
    integer_count := Scalar.Width(count_type) != 0 || count_type == "isize" || count_type == "usize"
    if parameters.count != 0 && (parameters.count != 2 || items[0].type == null ||
       !integer_count || items[1].type == null ||
       (strcmp(items[1].type, CStr("**u8")) != 0 && strcmp(items[1].type, CStr("**s8")) != 0)) {
        NativeEntryError(fn, target, CStr("takes nothing or (argc: integer, argv: **u8 or **s8)"))
        return 0
    }
    return 1
}

#program_export
EmitNativeMainDeclaration :: (out: *void) {
    fputs(CStr("#ifdef __cplusplus\n}\nextern \"C++\" {\n#endif\nint main(int argc, char **argv);\n#ifdef __cplusplus\n}\nextern \"C\" {\n#endif\n"), out)
}

#program_export
EmitSymbolDeclaration :: (out: *void, result: *u8, name: *u8, parameters: *u8, symbol: *u8) {
    fprintf(out, CStr("#ifdef __APPLE__\n%s %s(%s) __asm__(\"_%s\");\n#else\n"),
            result, name, parameters, symbol)
    fprintf(out, CStr("%s %s(%s) __asm__(\"%s\");\n#endif\n"),
            result, name, parameters, symbol)
}

#program_export
EmitNativeMain :: (out: *void, module: *IR.ZirModule, fn: *IR.ZirFunction, target: Native.ZirTarget) {
    body: [IR.ZIR_NAME_MAX * 2]u8
    NativeCFunctionName(module, fn, *body[0], IR.ZIR_NAME_MAX * 2)
    parameters := ParametersOf(FunctionArgs(fn))
    items := cast(*CParameter)(*parameters.items[0])
    fputs(CStr("\nint\nmain(int argc, char **argv)\n{\n    (void)argc;\n    (void)argv;\n"), out)
    returns_value := fn.return_type[0] != 0 && strcmp(*fn.return_type[0], CStr("void")) != 0
    fprintf(out, CStr("    %s%s("), ifx returns_value then CStr("return (int)") else CStr(""), *body[0])
    if parameters.count == 2 {
        arg0_t := cast(*u8)Native.TargetType(cast(*void)items[0].type, target)
        arg1_t := ifx strcmp(items[1].type, CStr("**s8")) == 0 then CStr("int8_t **") else CStr("uint8_t **")
        fprintf(out, CStr("(%s)argc, (%s)argv"), arg0_t, arg1_t)
    }
    fputs(CStr(");\n"), out)
    if !returns_value { fputs(CStr("    return 0;\n"), out) }
    fputs(CStr("}\n"), out)
}

#scope_file

HelperEntry :: struct {
    name: string
    definition: string
}

C_NUMBER_HELPER_COUNT :: 23
CNumberHelpers :: () -> [C_NUMBER_HELPER_COUNT]HelperEntry {
    helpers: [C_NUMBER_HELPER_COUNT]HelperEntry = .{
        .{"SignedBits",
         "/* SignedBits reads the low w bits of x as a signed number. */\nstatic inline int64_t SignedBits(uint64_t x, int w) {\n    uint64_t mask = w == 64 ? UINT64_MAX : (UINT64_C(1) << w) - 1;\n    x &= mask;\n    return x <= (mask >> 1) ? (int64_t)x : -1 - (int64_t)(mask - x);\n}\n"},
        .{"IntegerOp",
         "/* IntegerOp applies op to the low w bits of a and b: 0 convert, 1 add,\n * 2 subtract, 3 multiply, 4 divide, 5 remainder, 6 shift left,\n * 7 shift right, 8 and, 9 or, 10 xor. Division by zero and\n * out-of-range shifts abort. */\nstatic inline uint64_t IntegerOp(uint64_t a, uint64_t b, int w, int sign, int op) {\n    uint64_t mask = w == 64 ? UINT64_MAX : (UINT64_C(1) << w) - 1;\n    uint64_t shift = b;\n    a &= mask;\n    b &= mask;\n    switch(op) {\n    case 0: return a;\n    case 1: return (a + b) & mask;\n    case 2: return (a - b) & mask;\n    case 3: return (a * b) & mask;\n    case 4: case 5:\n        if(!b) abort();\n        if(sign) {\n            int64_t x = SignedBits(a, w), y = SignedBits(b, w);\n            if(x == INT64_MIN && y == -1) return op == 4 ? a : 0;\n            return (uint64_t)(op == 4 ? x / y : x % y) & mask;\n        }\n        return op == 4 ? a / b : a % b;\n    case 6: case 7:\n        if(shift >= (uint64_t)w) abort();\n        if(op == 6) return (a << shift) & mask;\n        if(!shift) return a;\n        return (a >> shift) |\n            ((sign && (a & (UINT64_C(1) << (w - 1)))) ? mask ^ (mask >> shift) : 0);\n    case 8: return a & b;\n    case 9: return a | b;\n    case 10: return a ^ b;\n    default: abort();\n    }\n    return 0;\n}\n"},
        .{"FloatToInt",
         "/* FloatToInt converts x to a w-bit integer, aborting when it does not fit. */\nstatic inline uint64_t FloatToInt(double x, int w, int sign) {\n    /* Powers of two are exact in double, including the unsigned 64-bit bound. */\n    double bound = w - sign == 64 ? 18446744073709551616.0 :\n        (double)(UINT64_C(1) << (w - sign));\n    if(!(x >= (sign ? -bound : 0) && x < bound)) abort();\n    return sign ? (uint64_t)(int64_t)x : (uint64_t)x;\n}\n"},
        .{"ZiClz",
         "static inline uint64_t ZiClz(uint64_t x, int w) {\n    if(!x) return (uint64_t)w;\n#if defined(__GNUC__) || defined(__clang__)\n    return (uint64_t)__builtin_clzll(x) - (uint64_t)(64 - w);\n#else\n    uint64_t n = 0;\n    while(!(x & (UINT64_C(1) << (w - 1)))) { x <<= 1; n++; }\n    return n;\n#endif\n}\n"},
        .{"ZiCtz",
         "static inline uint64_t ZiCtz(uint64_t x, int w) {\n    if(!x) return (uint64_t)w;\n#if defined(__GNUC__) || defined(__clang__)\n    return (uint64_t)__builtin_ctzll(x);\n#else\n    uint64_t n = 0;\n    while(!(x & 1)) { x >>= 1; n++; }\n    return n;\n#endif\n}\n"},
        .{"ZiPopcount",
         "static inline uint64_t ZiPopcount(uint64_t x, int w) {\n    (void)w;\n#if defined(__GNUC__) || defined(__clang__)\n    return (uint64_t)__builtin_popcountll(x);\n#else\n    uint64_t n = 0;\n    for(; x; x &= x - 1) n++;\n    return n;\n#endif\n}\n"},
        .{"ZiBswap16",
         "static inline uint16_t ZiBswap16(uint16_t x) {\n    return (uint16_t)((x >> 8) | (x << 8));\n}\n"},
        .{"ZiBswap32",
         "static inline uint32_t ZiBswap32(uint32_t x) {\n#if defined(__GNUC__) || defined(__clang__)\n    return __builtin_bswap32(x);\n#else\n    return (x >> 24) | ((x >> 8) & 0xff00u) | ((x << 8) & 0xff0000u) | (x << 24);\n#endif\n}\n"},
        .{"ZiBswap64",
         "static inline uint64_t ZiBswap64(uint64_t x) {\n#if defined(__GNUC__) || defined(__clang__)\n    return __builtin_bswap64(x);\n#else\n    return ((uint64_t)ZiBswap32((uint32_t)x) << 32) | ZiBswap32((uint32_t)(x >> 32));\n#endif\n}\n"},
        .{"ZiDivS32",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiDivS32(a, b, min) __extension__ ({ int32_t __zi_a = (a), __zi_b = (b); if(!__zi_b) abort(); __zi_b == -1 ? (__zi_a == (min) ? __zi_a : -__zi_a) : __zi_a / __zi_b; })\n#else\nstatic inline int32_t ZiDivS32(int32_t a, int32_t b, int32_t min) {\n    if(!b) abort();\n    if(b == -1) return a == min ? a : -a;\n    return a / b;\n}\n#endif\n"},
        .{"ZiRemS32",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiRemS32(a, b) __extension__ ({ int32_t __zi_a = (a), __zi_b = (b); if(!__zi_b) abort(); __zi_b == -1 ? 0 : __zi_a % __zi_b; })\n#else\nstatic inline int32_t ZiRemS32(int32_t a, int32_t b) {\n    if(!b) abort();\n    return b == -1 ? 0 : a % b;\n}\n#endif\n"},
        .{"ZiDivU32",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiDivU32(a, b) __extension__ ({ uint32_t __zi_a = (a), __zi_b = (b); if(!__zi_b) abort(); __zi_a / __zi_b; })\n#else\nstatic inline uint32_t ZiDivU32(uint32_t a, uint32_t b) {\n    if(!b) abort();\n    return a / b;\n}\n#endif\n"},
        .{"ZiRemU32",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiRemU32(a, b) __extension__ ({ uint32_t __zi_a = (a), __zi_b = (b); if(!__zi_b) abort(); __zi_a % __zi_b; })\n#else\nstatic inline uint32_t ZiRemU32(uint32_t a, uint32_t b) {\n    if(!b) abort();\n    return a % b;\n}\n#endif\n"},
        .{"ZiShl32",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiShl32(a, s, w) __extension__ ({ uint32_t __zi_a = (a); uint64_t __zi_s = (s); if(__zi_s >= (uint64_t)(w)) abort(); (uint32_t)(__zi_a << __zi_s); })\n#else\nstatic inline uint32_t ZiShl32(uint32_t a, uint64_t s, int w) {\n    if(s >= (uint64_t)w) abort();\n    return (uint32_t)(a << s);\n}\n#endif\n"},
        .{"ZiShrU32",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiShrU32(a, s, w) __extension__ ({ uint32_t __zi_a = (a); uint64_t __zi_s = (s); if(__zi_s >= (uint64_t)(w)) abort(); __zi_a >> __zi_s; })\n#else\nstatic inline uint32_t ZiShrU32(uint32_t a, uint64_t s, int w) {\n    if(s >= (uint64_t)w) abort();\n    return a >> s;\n}\n#endif\n"},
        .{"ZiShrS32",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiShrS32(a, s, w) __extension__ ({ int32_t __zi_a = (a); uint64_t __zi_s = (s); if(__zi_s >= (uint64_t)(w)) abort(); __zi_a < 0 ? ~(~__zi_a >> __zi_s) : __zi_a >> __zi_s; })\n#else\nstatic inline int32_t ZiShrS32(int32_t a, uint64_t s, int w) {\n    if(s >= (uint64_t)w) abort();\n    return a < 0 ? ~(~a >> s) : a >> s;\n}\n#endif\n"},
        .{"ZiDivS64",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiDivS64(a, b, min) __extension__ ({ int64_t __zi_a = (a), __zi_b = (b); if(!__zi_b) abort(); __zi_b == -1 ? (__zi_a == (min) ? __zi_a : -__zi_a) : __zi_a / __zi_b; })\n#else\nstatic inline int64_t ZiDivS64(int64_t a, int64_t b, int64_t min) {\n    if(!b) abort();\n    if(b == -1) return a == min ? a : -a;\n    return a / b;\n}\n#endif\n"},
        .{"ZiRemS64",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiRemS64(a, b) __extension__ ({ int64_t __zi_a = (a), __zi_b = (b); if(!__zi_b) abort(); __zi_b == -1 ? 0 : __zi_a % __zi_b; })\n#else\nstatic inline int64_t ZiRemS64(int64_t a, int64_t b) {\n    if(!b) abort();\n    return b == -1 ? 0 : a % b;\n}\n#endif\n"},
        .{"ZiDivU64",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiDivU64(a, b) __extension__ ({ uint64_t __zi_a = (a), __zi_b = (b); if(!__zi_b) abort(); __zi_a / __zi_b; })\n#else\nstatic inline uint64_t ZiDivU64(uint64_t a, uint64_t b) {\n    if(!b) abort();\n    return a / b;\n}\n#endif\n"},
        .{"ZiRemU64",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiRemU64(a, b) __extension__ ({ uint64_t __zi_a = (a), __zi_b = (b); if(!__zi_b) abort(); __zi_a % __zi_b; })\n#else\nstatic inline uint64_t ZiRemU64(uint64_t a, uint64_t b) {\n    if(!b) abort();\n    return a % b;\n}\n#endif\n"},
        .{"ZiShl64",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiShl64(a, s, w) __extension__ ({ uint64_t __zi_a = (a); uint64_t __zi_s = (s); if(__zi_s >= (uint64_t)(w)) abort(); (uint64_t)(__zi_a << __zi_s); })\n#else\nstatic inline uint64_t ZiShl64(uint64_t a, uint64_t s, int w) {\n    if(s >= (uint64_t)w) abort();\n    return (uint64_t)(a << s);\n}\n#endif\n"},
        .{"ZiShrU64",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiShrU64(a, s, w) __extension__ ({ uint64_t __zi_a = (a); uint64_t __zi_s = (s); if(__zi_s >= (uint64_t)(w)) abort(); __zi_a >> __zi_s; })\n#else\nstatic inline uint64_t ZiShrU64(uint64_t a, uint64_t s, int w) {\n    if(s >= (uint64_t)w) abort();\n    return a >> s;\n}\n#endif\n"},
        .{"ZiShrS64",
         "#if (defined(__GNUC__) || defined(__clang__)) && !defined(__OPTIMIZE__)\n#define ZiShrS64(a, s, w) __extension__ ({ int64_t __zi_a = (a); uint64_t __zi_s = (s); if(__zi_s >= (uint64_t)(w)) abort(); __zi_a < 0 ? ~(~__zi_a >> __zi_s) : __zi_a >> __zi_s; })\n#else\nstatic inline int64_t ZiShrS64(int64_t a, uint64_t s, int w) {\n    if(s >= (uint64_t)w) abort();\n    return a < 0 ? ~(~a >> s) : a >> s;\n}\n#endif\n"}
    }
    return helpers
}

GO_NUMBER_HELPER_COUNT :: 8
GoNumberHelpers :: () -> [GO_NUMBER_HELPER_COUNT]HelperEntry {
    helpers: [GO_NUMBER_HELPER_COUNT]HelperEntry = .{
        .{"signedBits", "func signedBits(x int64) uint64 { return uint64(x) }\n"},
        .{"negativeZero",
         "// negativeZero is -0.0, which Go constants cannot hold.\nfunc negativeZero() float64 {\n\tzero := 0.0\n\treturn -zero\n}\n"},
        .{"wrapAdd", "func wrapAdd(a, b uint64) uint64 { return a + b }\n"},
        .{"shiftCount",
         "// shiftCount returns s, panicking unless it is below the width w.\nfunc shiftCount(s, w uint64) uint64 {\n\tif s >= w {\n\t\tpanic(\"invalid shift count\")\n\t}\n\treturn s\n}\n"},
        .{"wrapSub", "func wrapSub(a, b uint64) uint64 { return a - b }\n"},
        .{"wrapMul", "func wrapMul(a, b uint64) uint64 { return a * b }\n"},
        .{"floatToInt",
         "// floatToInt converts x to a w-bit integer, panicking when it does not fit.\nfunc floatToInt(x float64, w uint, signed bool) uint64 {\n\tbits := w\n\tif signed {\n\t\tbits--\n\t}\n\tbound := float64(uint64(1) << (bits - 1)) * 2\n\tlower := float64(0)\n\tif signed {\n\t\tlower = -bound\n\t}\n\tif !(x >= lower && x < bound) {\n\t\tpanic(\"float conversion out of range\")\n\t}\n\tif signed {\n\t\treturn uint64(int64(x))\n\t}\n\treturn uint64(x)\n}\n"},
        .{"integerOp",
         "// integerOp applies op to the low w bits of a and b: 0 convert, 1 add,\n// 2 subtract, 3 multiply, 4 divide, 5 remainder, 6 shift left,\n// 7 shift right, 8 and, 9 or, 10 xor. Division by zero and\n// out-of-range shifts panic.\nfunc integerOp(a, b uint64, w uint, signed bool, op int) uint64 {\n\tmask := ^uint64(0)\n\tif w < 64 {\n\t\tmask = uint64(1)<<w - 1\n\t}\n\tshift := b\n\ta &= mask\n\tb &= mask\n\tswitch op {\n\tcase 0:\n\t\treturn a\n\tcase 1:\n\t\treturn (a + b) & mask\n\tcase 2:\n\t\treturn (a - b) & mask\n\tcase 3:\n\t\treturn (a * b) & mask\n\tcase 4, 5:\n\t\tif b == 0 {\n\t\t\tpanic(\"integer division by zero\")\n\t\t}\n\t\tif signed {\n\t\t\tx := int64(a<<(64-w)) >> (64 - w)\n\t\t\ty := int64(b<<(64-w)) >> (64 - w)\n\t\t\tif op == 4 {\n\t\t\t\treturn uint64(x/y) & mask\n\t\t\t}\n\t\t\treturn uint64(x%y) & mask\n\t\t}\n\t\tif op == 4 {\n\t\t\treturn a / b\n\t\t}\n\t\treturn a % b\n\tcase 6, 7:\n\t\tif shift >= uint64(w) {\n\t\t\tpanic(\"invalid shift count\")\n\t\t}\n\t\tif op == 6 {\n\t\t\treturn (a << shift) & mask\n\t\t}\n\t\tif shift == 0 {\n\t\t\treturn a\n\t\t}\n\t\tresult := a >> shift\n\t\tif signed && a&(uint64(1)<<(w-1)) != 0 {\n\t\t\tresult |= mask ^ (mask >> shift)\n\t\t}\n\t\treturn result\n\tcase 8:\n\t\treturn a & b\n\tcase 9:\n\t\treturn a | b\n\tcase 10:\n\t\treturn a ^ b\n\t}\n\tpanic(\"invalid numeric operation\")\n}\n"}
    }
    return helpers
}

NATIVE_BOUNDS :: 1
NATIVE_STRING :: 2
NATIVE_STDIO :: 4
NATIVE_STDLIB :: 8
NATIVE_MEMORY :: 16
NATIVE_SIMD :: 32
NATIVE_SIMD_TYPES :: 64
NATIVE_STRING_TYPES :: 128
NATIVE_STDINT :: 256
NATIVE_STDDEF :: 512
NATIVE_STDBOOL :: 1024

SimdIdentifier :: (start: *u8, length: usize) -> u32 {
    if length < 7 || memcmp(cast(*void)start, cast(*void)CStr("zi_"), 3) != 0 { return 0 }
    if (length == 10 && memcmp(cast(*void)start, cast(*void)CStr("zi_simd_at"), 10) == 0) ||
       (length == 20 && memcmp(cast(*void)start, cast(*void)CStr("zi_simd_gather_check"), 20) == 0) {
        return cast(u32)NATIVE_SIMD
    }
    last := PtrAdd(start, length)
    while cast(usize)last > cast(usize)PtrAdd(start, 3) && PtrSub(last, 1)[0] != #char "_" { last = PtrSub(last, 1) }
    name: [8]u8
    tail := cast(usize)PtrAdd(start, length) - cast(usize)last
    if tail == 0 || tail >= 8 { return 0 }
    memcpy(cast(*void)*name[0], cast(*void)last, tail)
    name[tail] = 0
    if VectorType(*name[0], null) == 0 { return 0 }
    return ifx last == PtrAdd(start, 3) then cast(u32)NATIVE_SIMD_TYPES else cast(u32)NATIVE_SIMD
}

WordByte :: (c: u8) -> bool {
    return (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z") ||
           (c >= #char "0" && c <= #char "9") || c == #char "_"
}

RuntimeUse :: struct {
    name: string
    include: u32
}

NativeRuntimeIncludes :: (text: *u8, calls: *s32, simd: *void) -> u32 {
    uses: [37]RuntimeUse = .{
        .{"BoundsCheck", NATIVE_BOUNDS}, .{"EmptyArrayIndex", NATIVE_BOUNDS},
        .{"ZIRAN_INDEX", NATIVE_BOUNDS}, .{"ZIRAN_EMPTY_INDEX", NATIVE_BOUNDS},
        .{"StringRange", NATIVE_STRING}, .{"StringRangeAt", NATIVE_STRING},
        .{"StringEqual", NATIVE_STRING}, .{"print_float", NATIVE_STRING},
        .{"printf", NATIVE_STDIO}, .{"fwrite", NATIVE_STDIO}, .{"stdout", NATIVE_STDIO},
        .{"calloc", NATIVE_STDLIB}, .{"free", NATIVE_STDLIB}, .{"abort", NATIVE_STDLIB},
        .{"memcpy", NATIVE_MEMORY}, .{"memmove", NATIVE_MEMORY},
        .{"ZI_NATIVE_BLOCKS", NATIVE_SIMD_TYPES},
        .{"String", NATIVE_STRING_TYPES}, .{"Source_Code_Location", NATIVE_STRING_TYPES},
        .{"StringView", NATIVE_STRING_TYPES}, .{"StringLiteral", NATIVE_STRING_TYPES},
        .{"int8_t", NATIVE_STDINT}, .{"uint8_t", NATIVE_STDINT},
        .{"int16_t", NATIVE_STDINT}, .{"uint16_t", NATIVE_STDINT},
        .{"int32_t", NATIVE_STDINT}, .{"uint32_t", NATIVE_STDINT},
        .{"int64_t", NATIVE_STDINT}, .{"uint64_t", NATIVE_STDINT},
        .{"intptr_t", NATIVE_STDINT}, .{"uintptr_t", NATIVE_STDINT},
        .{"size_t", NATIVE_STDDEF}, .{"ptrdiff_t", NATIVE_STDDEF},
        .{"NULL", NATIVE_STDDEF}, .{"bool", NATIVE_STDBOOL},
        .{"true", NATIVE_STDBOOL}, .{"false", NATIVE_STDBOOL}
    }
    helpers := CNumberHelpers()
    includes: u32 = 0
    p := text
    while p[0] != 0 {
        if p[0] == #char "/" && p[1] == #char "/" {
            while p[0] != 0 && p[0] != #char "\n" { p = PtrAdd(p, 1) }
            continue
        }
        if p[0] == #char "/" && p[1] == #char "*" {
            p = PtrAdd(p, 2)
            while p[0] != 0 && !(p[0] == #char "*" && p[1] == #char "/") { p = PtrAdd(p, 1) }
            if p[0] != 0 { p = PtrAdd(p, 2) }
            continue
        }
        if p[0] == #char "\"" || p[0] == #char "'" {
            quote := p[0]
            p = PtrAdd(p, 1)
            while p[0] != 0 && p[0] != quote {
                if p[0] == #char "\\" && p[1] != 0 { p = PtrAdd(p, 1) }
                p = PtrAdd(p, 1)
            }
            if p[0] != 0 { p = PtrAdd(p, 1) }
            continue
        }
        if !WordByte(p[0]) { p = PtrAdd(p, 1); continue }
        word := p
        while p[0] >= #char "0" && p[0] <= #char "9" { p = PtrAdd(p, 1) }
        start := p
        while WordByte(p[0]) { p = PtrAdd(p, 1) }
        length := cast(usize)p - cast(usize)start
        if length == 0 { continue }
        if start[0] == #char "z" {
            if (includes & cast(u32)NATIVE_SIMD) == 0 {
                includes |= SimdIdentifier(start, length)
            }
            if simd != null {
                SimdUsesNote(simd, start, length)
            }
        }
        for i: 0..36 {
            u := uses[i]
            if (includes & u.include) == 0 && cast(usize)u.name.count == length &&
               start[0] == u.name[0] && memcmp(cast(*void)start, cast(*void)CStr(u.name), length) == 0 {
                includes |= u.include
            }
        }
        if calls != null && word == start && p[0] == #char "(" {
            for i: 0..C_NUMBER_HELPER_COUNT - 1 {
                if cast(usize)helpers[i].name.count == length &&
                   memcmp(cast(*void)start, cast(*void)CStr(helpers[i].name), length) == 0 {
                    calls[i] = 1
                }
            }
        }
    }
    return includes
}

#scope_export

#program_export
CollectNativeSimdUses :: (text: *u8, simd: *void) {
    NativeRuntimeIncludes(text, null, simd)
}

#program_export
EmitNativeHelpers :: (file: *void, text: *u8, simd: *void) -> s32 {
    runtime_mark := CStr("/* ziran runtime includes */\n")
    numbers_mark := CStr("/* ziran numeric helpers */\n")
    needed: [C_NUMBER_HELPER_COUNT]s32
    mark := strstr(text, runtime_mark)
    numbers := strstr(text, numbers_mark)
    if mark == null || (numbers != null && cast(usize)numbers < cast(usize)mark) { return -1 }
    includes := NativeRuntimeIncludes(text, ifx numbers != null then *needed[0] else null, simd)
    needed[0] |= needed[1]
    needed[7] |= needed[8]
    any: s32 = 0
    for i: 0..C_NUMBER_HELPER_COUNT - 1 { any |= needed[i] }
    if any != 0 { includes |= cast(u32)(NATIVE_STDLIB | NATIVE_STDINT) }
    fwrite(cast(*void)text, 1, cast(usize)mark - cast(usize)text, file)
    if (includes & cast(u32)NATIVE_STDINT) != 0 && (includes & cast(u32)(NATIVE_STRING | NATIVE_STRING_TYPES)) == 0 {
        fputs(CStr("#include <stdint.h>\n"), file)
    }
    if (includes & cast(u32)NATIVE_STDDEF) != 0 && (includes & cast(u32)(NATIVE_STRING | NATIVE_STRING_TYPES)) == 0 {
        fputs(CStr("#include <stddef.h>\n"), file)
    }
    if (includes & cast(u32)NATIVE_STDBOOL) != 0 {
        fputs(CStr("#include <stdbool.h>\n"), file)
    }
    if (includes & cast(u32)NATIVE_STRING_TYPES) != 0 && (includes & cast(u32)NATIVE_STRING) == 0 {
        EmitStringType(file)
    }
    if (includes & cast(u32)NATIVE_BOUNDS) != 0 {
        fputs(CStr("#include \"zir_bounds.h\"\n"), file)
    }
    if (includes & cast(u32)NATIVE_SIMD) != 0 {
        fputs(CStr("#include \"ziran_simd.h\"\n"), file)
    } else if (includes & cast(u32)NATIVE_SIMD_TYPES) != 0 {
        fputs(CStr("#include \"ziran_simd_types.h\"\n"), file)
    }
    if (includes & cast(u32)NATIVE_STRING) != 0 {
        fputs(CStr("#include \"zir_string.h\"\n"), file)
    } else {
        if (includes & cast(u32)NATIVE_STDIO) != 0 && (includes & cast(u32)NATIVE_BOUNDS) == 0 {
            fputs(CStr("#include <stdio.h>\n"), file)
        }
        if (includes & cast(u32)NATIVE_STDLIB) != 0 && (includes & cast(u32)NATIVE_BOUNDS) == 0 {
            fputs(CStr("#include <stdlib.h>\n"), file)
        }
        if (includes & cast(u32)NATIVE_MEMORY) != 0 {
            fputs(CStr("#include <string.h>\n"), file)
        }
    }
    mark = PtrAdd(mark, strlen(runtime_mark))
    if numbers != null {
        fwrite(cast(*void)mark, 1, cast(usize)numbers - cast(usize)mark, file)
    }
    helpers := CNumberHelpers()
    written: s32 = 0
    for i: 0..C_NUMBER_HELPER_COUNT - 1 {
        if needed[i] != 0 {
            sep := ifx written != 0 then CStr("\n") else CStr("")
            written += 1
            hname := CStr(helpers[i].name)
            hdef := CStr(helpers[i].definition)
            fprintf(file, CStr("%s#ifndef ZIRAN_HELPER_%s\n#define ZIRAN_HELPER_%s\n%s#endif\n"),
                    sep, hname, hname, hdef)
        }
    }
    fputs(ifx numbers != null then PtrAdd(numbers, strlen(numbers_mark)) else mark, file)
    return ifx ferror(file) != 0 then -1 else 0
}

#program_export
EmitGoNumberHelpers :: (out: *void, text: *u8, written: *u32) {
    helpers := GoNumberHelpers()
    for i: 0..GO_NUMBER_HELPER_COUNT - 1 {
        bit := cast(u32)1 << cast(u32)i
        if (<<written & bit) != 0 { continue }
        call: [32]u8
        CheckFormat(snprintf(*call[0], 32, CStr("%s("), CStr(helpers[i].name)), 32)
        if strstr(text, *call[0]) == null { continue }
        fprintf(out, CStr("%s\n"), CStr(helpers[i].definition))
        <<written |= bit
    }
}

#program_export "zir_emit_emitter_type_contains_vec"
EmitterTypeContainsVec :: (module: *IR.ZirModule, type: *u8, depth: s32) -> s32 {
    element: [IR.ZIR_NAME_MAX]u8
    owner: *IR.ZirModule = null
    if depth > 32 || module == null || type == null || type[0] == 0 || type[0] == #char "*" {
        return 0
    }
    if VecElementType(module, type, null, 0) != 0 { return 1 }
    if ArrayElementType(type, *element[0], IR.ZIR_NAME_MAX, null) != 0 {
        return EmitterTypeContainsVec(module, *element[0], depth + 1)
    }
    record := CFindType(module, type, *owner)
    if record == null || record.is_enum != 0 || record.is_procedure_type != 0 ||
       record.is_record_template != 0 || record.is_extern != 0 {
        return 0
    }
    offset: usize = 0
    field: IR.ZirTypeField
    next_mod := ifx owner != null then owner else module
    while CTypeNextField(record, *offset, *field) == 1 {
        if EmitterTypeContainsVec(next_mod, *field.type[0], depth + 1) != 0 { return 1 }
    }
    return 0
}
