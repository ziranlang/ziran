// Native C/Go expression, compound literal, constant table, Map/Vec/Builder, and operator emitter.
using IR :: #import "compiler_ir"
using Native :: #import "compiler_native_names"
using Range :: #import "compiler_c_range"
CEmit :: #import "compiler_c_emit"
using Val :: #import "compiler_c_emit_value"

#scope_file

libc :: #system_library "libc";
compiler :: #system_library "ziran";

calloc :: (count: usize, size: usize) -> *void #foreign libc "calloc";
realloc :: (memory: *void, size: usize) -> *void #foreign libc "realloc";
free :: (memory: *void) #foreign libc "free";
exit :: (status: s32) #foreign libc "exit";
memcpy :: (dst: *void, src: *void, count: usize) -> *void #foreign libc "memcpy";
strlen :: (s: *u8) -> usize #foreign libc "strlen";
strcmp :: (a: *u8, b: *u8) -> s32 #foreign libc "strcmp";
strchr :: (s: *u8, c: s32) -> *u8 #foreign libc "strchr";
strtod :: (s: *u8, end: **u8) -> float64 #foreign libc "strtod";
snprintf :: (out: *u8, size: usize, fmt: *u8, args: ..any) -> s32 #foreign libc "snprintf";
fprintf :: (stream: *void, fmt: *u8, args: ..any) -> s32 #foreign libc "fprintf";
fputs :: (s: *u8, stream: *void) -> s32 #foreign libc "fputs";
fputc :: (c: s32, stream: *void) -> s32 #foreign libc "fputc";

AllocateOrExit :: (size: usize) -> *void #foreign compiler "AllocateOrExit";
Diagnostic :: (span: IR.ZirSourceSpan, code: *u8, fmt: *u8, args: ..any) #foreign compiler "Diagnostic";
copy_text :: (dst: *u8, size: usize, src: *u8) #foreign compiler "copy_text";
skip_ws :: (s: *u8) -> *u8 #foreign compiler "skip_ws";
go_field_ident :: (s: *u8, dst: *u8, dst_size: usize) #foreign compiler "go_field_ident";
ScalarType :: (type: *u8) -> *u8 #foreign compiler "ScalarType";
ScalarByteWidth :: (type: *u8) -> usize #foreign compiler "ScalarByteWidth";
BitBuiltin :: (name: *u8) -> s32 #foreign compiler "BitBuiltin";
ArrayElementType :: (type: *u8, element: *u8, size: usize, capacity: *s32) -> s32 #foreign compiler "ArrayElementType";
SliceElementType :: (type: *u8, element: *u8, size: usize) -> s32 #foreign compiler "SliceElementType";
VecElementType :: (module: *IR.ZirModule, type: *u8, element: *u8, size: usize) -> s32 #foreign compiler "VecElementType";
OwnedTextType :: (module: *IR.ZirModule, type: *u8) -> s32 #foreign compiler "OwnedTextType";
MapPrimitiveName :: (name: *u8) -> s32 #foreign compiler "MapPrimitiveName";
MapTypePartsAtUse :: (module: *IR.ZirModule, type: *u8, key: *u8, key_size: usize, value: *u8, value_size: usize) -> s32 #foreign compiler "MapTypePartsAtUse";
CFindType :: (module: *IR.ZirModule, name: *u8, owner: **IR.ZirModule) -> *IR.ZirType #foreign compiler "FindType";
CTypeNextField :: (record: *IR.ZirType, offset: *usize, field: *IR.ZirTypeField) -> s32 #foreign compiler "TypeNextField";
EnumMemberValue :: (enumeration: *IR.ZirType, member: *u8, out: *s64) -> s32 #foreign compiler "EnumMemberValue";
SimdOpChecked :: (name: *u8) -> *void #foreign compiler "SimdOpChecked";
emit_simd_call :: (e: *Emitter, expr: *IR.ZirExpr, out: *u8, size: usize) -> s32 #foreign compiler "zir_emit_emit_simd_call";

ZirConstantTablesSlot :: () -> **void #foreign compiler "ZirConstantTablesSlot";
ZirTextStreamOpen :: (stream: *TextStream, text: **u8, size: *usize) -> *void #foreign compiler "ZirTextStreamOpen";
ZirTextStreamClose :: (stream: *TextStream) -> s32 #foreign compiler "ZirTextStreamClose";
ZirEmitScratchOpen :: (text: **u8, size: *usize) -> *void #foreign compiler "ZirEmitScratchOpen";
ZirEmitScratchClose :: (file: *void, size: *usize) #foreign compiler "ZirEmitScratchClose";
ZirSignbit :: (value: float64) -> s32 #foreign compiler "ZirSignbit";
ZirParseInt64 :: (text: *u8, out: *s64) -> s32 #foreign compiler "ZirParseInt64";

// From compiler_c_emit.zi / compiler_c_emit_call.zi.
CTargetType :: (type: *u8, target: Native.ZirTarget) -> *u8 #foreign compiler "TargetTypeZiran";
CTargetFieldName :: (record: *IR.ZirType, target: Native.ZirTarget, name: *u8, out: *u8, size: usize) #foreign compiler "TargetFieldName";
CTypeHasZeroArray :: (module: *IR.ZirModule, type: *u8) -> s32 #foreign compiler "TypeHasZeroArray";
CCanonical :: (type: *u8) -> *u8 #foreign compiler "zir_emit_canonical";
CSlotNativeType :: (source: *u8, target: Native.ZirTarget, out: *u8, size: usize) #foreign compiler "zir_emit_slot_native_type";
CSlotTypeAtUse :: (source: *u8, target: Native.ZirTarget, resolve_type: CEmit.ZirResolveTarget,
                   context: *void, out: *u8, size: usize) #foreign compiler "zir_emit_slot_type_at_use";
CResolveTypeAtUse :: (context: *void, source: *u8, out: *u8, size: usize) #foreign compiler "zir_emit_resolve_type_at_use";
CWidth :: (type: *u8) -> s32 #foreign compiler "zir_emit_width";
CSignedType :: (type: *u8) -> s32 #foreign compiler "zir_emit_signed_type";
CEnumType :: (module: *IR.ZirModule, type: *u8) -> s32 #foreign compiler "zir_emit_enum_type";
CEnumFlagsType :: (module: *IR.ZirModule, type: *u8) -> s32 #foreign compiler "zir_emit_enum_flags_type";
CRecordType :: (module: *IR.ZirModule, type: *u8) -> s32 #foreign compiler "zir_emit_record_type";
CFieldRecord :: (module: *IR.ZirModule, type: *u8, owner: **IR.ZirModule) -> *IR.ZirType #foreign compiler "zir_emit_field_record";
CEmitFieldPath :: (module: *IR.ZirModule, target: Native.ZirTarget, base_type: *u8, path: *u8,
                   read: s32, base_expression: *u8, out: *u8, size: usize) #foreign compiler "zir_emit_emit_field_path";
CSpelledFieldStore :: (target: Native.ZirTarget, record: *IR.ZirType, name: *u8, value: *u8, size: usize) #foreign compiler "zir_emit_spelled_field_store";
CZeroValue :: (type: *u8, target: Native.ZirTarget) -> *u8 #foreign compiler "zir_emit_zero_value";
CEmitterTypeContainsVec :: (module: *IR.ZirModule, type: *u8, depth: s32) -> s32 #foreign compiler "zir_emit_emitter_type_contains_vec";
EmitStringLiteral :: (expr: *IR.ZirExpr, target: Native.ZirTarget, out: *u8, size: usize) #foreign compiler "EmitStringLiteral";

emit_call :: (e: *Emitter, expr: *IR.ZirExpr, array_result: *u8, out: *u8, size: usize) #foreign compiler "zir_emit_emit_call";
emit_function_value :: (e: *Emitter, index: s32, out: *u8, size: usize) #foreign compiler "zir_emit_emit_function_value";
emit_print :: (e: *Emitter, expr: *IR.ZirExpr) #foreign compiler "zir_emit_emit_print";
expression_calls :: (fn: *IR.ZirFunction, index: s32) -> s32 #foreign compiler "zir_emit_expression_calls";
emit_inline_call :: (e: *Emitter, call: *IR.ZirExpr, out: *u8, size: usize) -> s32 #foreign compiler "zir_emit_emit_inline_call";
call_can_change :: (e: *Emitter, index: s32) -> s32 #foreign compiler "zir_emit_call_can_change";
ZeroRecord :: (e: *Emitter, type: *u8, out: *u8, size: usize) #foreign compiler "zir_emit_zero_record";
MemberPath :: (fn: *IR.ZirFunction, index: s32) -> s32 #foreign compiler "zir_emit_member_path";

C_STRING_LITERAL_MAX :: 4095
ZIR_BIT_NONE :: 0
ZIR_BIT_BSWAP :: 4

TextStream :: struct {
    file: *void
    data: *u8
    length: usize
    text: **u8
    size: *usize
}

ConstantTables :: struct {
    prefix: [256]u8
    target: Native.ZirTarget
    stream: TextStream
    out: *void
    text: *u8
    length: usize
    keys: **u8
    count: s32
    capacity: s32
}

EmitMapCallBuffers :: struct {
    map: [IR.ZIR_TEXT_MAX]u8
    argument: [IR.ZIR_TEXT_MAX]u8
    initializer: [IR.ZIR_TEXT_MAX]u8
}

EmitVecCallBuffers :: struct {
    vector: [IR.ZIR_TEXT_MAX]u8
    value: [IR.ZIR_TEXT_MAX]u8
    other: [IR.ZIR_TEXT_MAX]u8
    index: [IR.ZIR_TEXT_MAX]u8
    field: [IR.ZIR_TEXT_MAX * 2]u8
    source: [IR.ZIR_TEXT_MAX]u8
    low: [IR.ZIR_TEXT_MAX]u8
    high: [IR.ZIR_TEXT_MAX]u8
    text: [IR.ZIR_TEXT_MAX]u8
}

EmitExprBuffers :: struct {
    a: [IR.ZIR_TEXT_MAX]u8
    b: [IR.ZIR_TEXT_MAX]u8
    result: [IR.ZIR_TEXT_MAX]u8
    source: [IR.ZIR_TEXT_MAX]u8
    low: [IR.ZIR_TEXT_MAX]u8
    high: [IR.ZIR_TEXT_MAX]u8
}

StaticText :: struct { data: *u8; length: usize }

CStr :: (s: string) -> *u8 {
    return (cast(*StaticText)(*s)).data
}

PtrAdd :: (base: *u8, offset: usize) -> *u8 {
    return cast(*u8)(cast(usize)base + offset)
}

CheckFormat :: (n: s32, size: usize) -> s32 {
    if n < 0 || cast(usize)n >= size {
        span: IR.ZirSourceSpan
        Diagnostic(span, CStr("zir.output"), CStr("generated expression exceeds output limit"))
        exit(1)
    }
    return n
}

EmitIndent :: (e: *Emitter) {
    unit := ifx e.target == .ZIR_GO then CStr("\t") else CStr("    ")
    for i: cast(s32)0..e.indent - 1 {
        fputs(unit, e.out)
    }
}

IsSpace :: (c: u8) -> bool {
    return c == #char " " || c == #char "\t" || c == #char "\n" || c == #char "\r" || c == 11 || c == 12
}

IsAlnum :: (c: u8) -> bool {
    return (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z") || (c >= #char "0" && c <= #char "9")
}

EmitChecksAt :: (e: *Emitter, expr: s32) -> bool {
    return Range.ChecksAt(e.module, e.fn, expr)
}

IndexInRange :: (e: *Emitter, index: s32, count: s32) -> bool {
    return Range.IndexInRange(e.ranges, e.fn, e.module, e.target == .ZIR_C, index, count)
}

IndexBelowCount :: (e: *Emitter, index: s32, base: s32) -> bool {
    return Range.IndexBelowCount(e.ranges, e.fn, e.module, e.target == .ZIR_C, index, base)
}

SliceRangeInRange :: (e: *Emitter, index: s32, capacity: s32) -> bool {
    return Range.SliceRangeInRange(e.ranges, e.fn, e.module, e.target == .ZIR_C, index, capacity)
}

PlainWideOperand :: (fn: *IR.ZirFunction, index: s32, depth: s32) -> bool {
    if index < 0 || index >= fn.expr_count || depth >= 64 { return false }
    expr := *fn.exprs[index]
    if expr.kind == .INT || expr.kind == .IDENT || expr.kind == .SIZE_OF || expr.kind == .COMPILE_TIME {
        return true
    }
    if expr.kind == .MEMBER {
        return expr.left >= 0 && expr.left < fn.expr_count &&
               fn.exprs[expr.left].type[0] != #char "*" &&
               PlainWideOperand(fn, expr.left, depth + 1)
    }
    if expr.kind == .UNARY {
        return (strcmp(*expr.op[0], CStr("+")) == 0 || strcmp(*expr.op[0], CStr("-")) == 0 ||
                strcmp(*expr.op[0], CStr("~")) == 0) &&
               PlainWideOperand(fn, expr.right, depth + 1)
    }
    if expr.kind == .BINARY {
        return (strcmp(*expr.op[0], CStr("+")) == 0 || strcmp(*expr.op[0], CStr("-")) == 0 ||
                strcmp(*expr.op[0], CStr("*")) == 0 || strcmp(*expr.op[0], CStr("&")) == 0 ||
                strcmp(*expr.op[0], CStr("|")) == 0 || strcmp(*expr.op[0], CStr("^")) == 0) &&
               PlainWideOperand(fn, expr.left, depth + 1) &&
               PlainWideOperand(fn, expr.right, depth + 1)
    }
    if expr.kind == .CAST {
        return expr.right >= 0 && expr.right < fn.expr_count &&
               CWidth(CCanonical(expr.name)) != 0 &&
               CWidth(CCanonical(fn.exprs[expr.right].type)) != 0 &&
               PlainWideOperand(fn, expr.right, depth + 1)
    }
    return false
}

ConditionalBranch :: (e: *Emitter, branch: s32, type: *u8, out: *u8, size: usize, scratch: *u8, scratch_size: usize) {
    EmitExpr(e, branch, type, out, size)
    if e.target != .ZIR_GO || branch < 0 || branch >= e.fn.expr_count { return }
    from := CCanonical(e.fn.exprs[branch].type)
    have := CTargetType(from, e.target)
    want := CTargetType(CCanonical(type), e.target)
    if have == null || want == null || strcmp(have, want) == 0 ||
       strcmp(from, CStr("integer")) == 0 || strcmp(from, CStr("real")) == 0 {
        return
    }
    copy_text(scratch, scratch_size, out)
    CheckFormat(snprintf(out, size, CStr("%s(%s)"), want, scratch), size)
}

EmitMapCall :: (e: *Emitter, expr: *IR.ZirExpr, out: *u8, size: usize) {
    if e.target != .ZIR_GO { Val.Fatal(expr, CStr("map operations require the Go target")) }
    buffers := cast(*EmitMapCallBuffers)AllocateOrExit(size_of(EmitMapCallBuffers))
    first := expr.first_child
    second := e.fn.exprs[first].next_sibling
    third := ifx second >= 0 then e.fn.exprs[second].next_sibling else cast(s32)-1
    map_type := e.fn.exprs[first].type
    key_type: [IR.ZIR_NAME_MAX]u8
    value_type: [IR.ZIR_NAME_MAX]u8
    map_name: [IR.ZIR_NAME_MAX]u8
    key_name: [IR.ZIR_NAME_MAX]u8
    value_name: [IR.ZIR_NAME_MAX]u8
    result: [IR.ZIR_NAME_MAX]u8
    mapped: [IR.ZIR_NAME_MAX * 2]u8
    if MapTypePartsAtUse(e.module, map_type, *key_type[0], IR.ZIR_NAME_MAX, *value_type[0], IR.ZIR_NAME_MAX) == 0 {
        Val.Fatal(expr, CStr("invalid Map operation"))
    }
    init := strcmp(expr.name, CStr("MapInit")) == 0
    set := strcmp(expr.name, CStr("MapSet")) == 0
    Fresh(e, *map_name[0])
    if init || set {
        EmitDestination(e, first, *buffers.map[0], IR.ZIR_TEXT_MAX)
        pointer_type: [IR.ZIR_NAME_MAX * 2]u8
        CheckFormat(snprintf(*pointer_type[0], IR.ZIR_NAME_MAX * 2, CStr("*%s"), map_type), IR.ZIR_NAME_MAX * 2)
        CheckFormat(snprintf(*buffers.initializer[0], IR.ZIR_TEXT_MAX, CStr("&(%s)"), *buffers.map[0]), IR.ZIR_TEXT_MAX)
        Declare(e, *map_name[0], *pointer_type[0], *buffers.initializer[0])
        CheckFormat(snprintf(*buffers.map[0], IR.ZIR_TEXT_MAX, CStr("(*%s)"), *map_name[0]), IR.ZIR_TEXT_MAX)
    } else {
        EmitExpr(e, first, map_type, *buffers.argument[0], IR.ZIR_TEXT_MAX)
        Declare(e, *map_name[0], map_type, *buffers.argument[0])
        copy_text(*buffers.map[0], IR.ZIR_TEXT_MAX, *map_name[0])
    }
    if second >= 0 {
        Fresh(e, *key_name[0])
        EmitExpr(e, second, *key_type[0], *buffers.argument[0], IR.ZIR_TEXT_MAX)
        Declare(e, *key_name[0], *key_type[0], *buffers.argument[0])
    }
    if third >= 0 {
        Fresh(e, *value_name[0])
        EmitExpr(e, third, *value_type[0], *buffers.argument[0], IR.ZIR_TEXT_MAX)
        Declare(e, *value_name[0], *value_type[0], *buffers.argument[0])
    }
    if init || set {
        e.resolve(e.context, map_type, *mapped[0], IR.ZIR_NAME_MAX * 2)
        EmitIndent(e); fprintf(e.out, CStr("if %s == nil {\n"), *buffers.map[0])
        e.indent += 1
        EmitIndent(e); fprintf(e.out, CStr("%s = make(%s)\n"), *buffers.map[0], *mapped[0])
        e.indent -= 1
        EmitIndent(e); fputs(CStr("}\n"), e.out)
        if set {
            EmitIndent(e); fprintf(e.out, CStr("%s[%s] = %s\n"), *buffers.map[0], *key_name[0], *value_name[0])
        }
    } else if strcmp(expr.name, CStr("MapDelete")) == 0 {
        EmitIndent(e); fprintf(e.out, CStr("delete(%s, %s)\n"), *buffers.map[0], *key_name[0])
    } else if strcmp(expr.name, CStr("MapClear")) == 0 {
        EmitIndent(e); fprintf(e.out, CStr("clear(%s)\n"), *buffers.map[0])
    } else {
        Fresh(e, *result[0])
        if strcmp(expr.name, CStr("MapContains")) == 0 {
            Declare(e, *result[0], CStr("bool"), CStr("false"))
            EmitIndent(e); fprintf(e.out, CStr("_, %s = %s[%s]\n"), *result[0], *buffers.map[0], *key_name[0])
        } else if strcmp(expr.name, CStr("MapLookup")) == 0 {
            ZeroRecord(e, expr.type, *buffers.initializer[0], IR.ZIR_TEXT_MAX)
            Declare(e, *result[0], expr.type, *buffers.initializer[0])
            EmitIndent(e); fprintf(e.out, CStr("%s.Value, %s.HasValue = %s[%s]\n"), *result[0], *result[0], *buffers.map[0], *key_name[0])
        } else if strcmp(expr.name, CStr("MapGet")) == 0 {
            CheckFormat(snprintf(*buffers.initializer[0], IR.ZIR_TEXT_MAX, CStr("%s[%s]"), *buffers.map[0], *key_name[0]), IR.ZIR_TEXT_MAX)
            Declare(e, *result[0], expr.type, *buffers.initializer[0])
        } else if strcmp(expr.name, CStr("MapCount")) == 0 {
            CheckFormat(snprintf(*buffers.initializer[0], IR.ZIR_TEXT_MAX, CStr("int64(len(%s))"), *buffers.map[0]), IR.ZIR_TEXT_MAX)
            Declare(e, *result[0], CStr("s64"), *buffers.initializer[0])
        } else if strcmp(expr.name, CStr("MapKeys")) == 0 {
            e.resolve(e.context, *key_type[0], *mapped[0], IR.ZIR_NAME_MAX * 2)
            CheckFormat(snprintf(*buffers.initializer[0], IR.ZIR_TEXT_MAX, CStr("make([]%s, 0, len(%s))"), *mapped[0], *buffers.map[0]), IR.ZIR_TEXT_MAX)
            Declare(e, *result[0], expr.type, *buffers.initializer[0])
            Fresh(e, *key_name[0])
            EmitIndent(e); fprintf(e.out, CStr("for %s := range %s {\n"), *key_name[0], *buffers.map[0])
            e.indent += 1
            EmitIndent(e); fprintf(e.out, CStr("%s = append(%s, %s)\n"), *result[0], *result[0], *key_name[0])
            e.indent -= 1
            EmitIndent(e); fputs(CStr("}\n"), e.out)
        } else {
            Val.Fatal(expr, CStr("unknown Map operation"))
        }
        copy_text(out, size, *result[0])
        e.pure = 1
        free(cast(*void)buffers)
        return
    }
    out[0] = 0
    e.pure = 0
    free(cast(*void)buffers)
}

EmitVecCallWithBuffers :: (e: *Emitter, expr: *IR.ZirExpr, out: *u8, size: usize, buffers: *EmitVecCallBuffers) {
    first := expr.first_child
    push := strcmp(expr.name, CStr("VecPush")) == 0
    item_name: [IR.ZIR_NAME_MAX]u8
    result_name: [IR.ZIR_NAME_MAX]u8
    element: [IR.ZIR_NAME_MAX]u8
    mapped: [IR.ZIR_NAME_MAX * 2]u8
    if first < 0 || VecElementType(e.module, e.fn.exprs[first].type, *element[0], IR.ZIR_NAME_MAX) == 0 {
        Val.Fatal(expr, CStr("invalid Vec operation"))
    }
    EmitDestination(e, first, *buffers.vector[0], IR.ZIR_TEXT_MAX)
    if strcmp(expr.name, CStr("VecSwap")) == 0 {
        second := e.fn.exprs[first].next_sibling
        tmp: [IR.ZIR_NAME_MAX]u8
        EmitDestination(e, second, *buffers.other[0], IR.ZIR_TEXT_MAX)
        Fresh(e, *tmp[0])
        Declare(e, *tmp[0], e.fn.exprs[first].type, *buffers.vector[0])
        semi := ifx e.target == .ZIR_GO then CStr("") else CStr(";")
        EmitIndent(e); fprintf(e.out, CStr("%s = %s%s\n"), *buffers.vector[0], *buffers.other[0], semi)
        EmitIndent(e); fprintf(e.out, CStr("%s = %s%s\n"), *buffers.other[0], *tmp[0], semi)
        out[0] = 0
        e.pure = 0
        return
    }
    if strcmp(expr.name, CStr("VecReserve")) == 0 || strcmp(expr.name, CStr("VecResize")) == 0 || strcmp(expr.name, CStr("VecResizeBounded")) == 0 {
        bounded := strcmp(expr.name, CStr("VecResizeBounded")) == 0
        resize := strcmp(expr.name, CStr("VecResize")) == 0 || bounded
        second := e.fn.exprs[first].next_sibling
        requested: [IR.ZIR_NAME_MAX]u8
        grown: [IR.ZIR_NAME_MAX]u8
        index: [IR.ZIR_NAME_MAX]u8
        maximum: [IR.ZIR_NAME_MAX]u8
        EmitExpr(e, second, CStr("s64"), *buffers.value[0], IR.ZIR_TEXT_MAX)
        Fresh(e, *item_name[0])
        Fresh(e, *requested[0])
        Declare(e, *requested[0], CStr("s64"), *buffers.value[0])
        if bounded {
            third := e.fn.exprs[second].next_sibling
            EmitExpr(e, third, CStr("s64"), *buffers.value[0], IR.ZIR_TEXT_MAX)
            Fresh(e, *maximum[0])
            Declare(e, *maximum[0], CStr("s64"), *buffers.value[0])
        }
        Fresh(e, *result_name[0])
        Declare(e, *result_name[0], CStr("bool"), CStr("false"))
        Fresh(e, *grown[0])
        Fresh(e, *index[0])
        if e.target == .ZIR_GO {
            EmitIndent(e); fprintf(e.out, CStr("%s = func() (ok bool) {\n"), *result_name[0])
            e.indent += 1
            EmitIndent(e); fputs(CStr("defer func() { if recover() != nil { ok = false } }()\n"), e.out)
            EmitIndent(e); fprintf(e.out, CStr("if %s < 0 { return false }\n"), *requested[0])
            if bounded {
                EmitIndent(e); fprintf(e.out, CStr("if %s < 0 || %s > %s || %s.Capacity > %s { return false }\n"),
                                       *maximum[0], *requested[0], *maximum[0], *buffers.vector[0], *maximum[0])
            }
            EmitIndent(e); fprintf(e.out, CStr("if %s > %s.Capacity {\n"), *requested[0], *buffers.vector[0])
            e.indent += 1
            scalar := CTargetType(*element[0], .ZIR_GO)
            if scalar != null { copy_text(*mapped[0], IR.ZIR_NAME_MAX * 2, scalar) }
            else { e.resolve(e.context, *element[0], *mapped[0], IR.ZIR_NAME_MAX * 2) }
            EmitIndent(e); fprintf(e.out, CStr("var %s %s\n"), *item_name[0], *mapped[0])
            EmitIndent(e); fprintf(e.out, CStr("if uint64(%s) > uint64(^uint(0) >> 1) { return false }\n"), *requested[0])
            EmitIndent(e); fprintf(e.out, CStr("if unsafe.Sizeof(%s) != 0 && uint64(%s) > uint64(^uint(0) >> 1)/uint64(unsafe.Sizeof(%s)) { return false }\n"),
                                   *item_name[0], *requested[0], *item_name[0])
