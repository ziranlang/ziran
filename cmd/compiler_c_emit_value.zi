// Native C/Go value, declaration, ownership-drop, numeric, destination, and literal emitter.
using IR :: #import "compiler_ir"
using Native :: #import "compiler_native_names"
using Range :: #import "compiler_c_range"
using RangeFactsMod :: #import "compiler_c_range_facts"
CEmit :: #import "compiler_c_emit"

#scope_export

ZIR_INLINE_MAX :: 96

ZirAssemblyBlockEmitter :: #type (out: *void, module: *IR.ZirModule, function: *IR.ZirFunction,
                                  statement: s32, context: *void) -> s32 #c_call;

Local :: struct {
    name: [IR.ZIR_NAME_MAX]u8
    type: [IR.ZIR_NAME_MAX]u8
    drop_alias: [IR.ZIR_NAME_MAX]u8
    alias: [IR.ZIR_NAME_MAX * 2]u8
    depth: s32
    shadow_depth: s32
}

Emitter :: struct {
    out: *void
    module: *IR.ZirModule
    fn: *IR.ZirFunction
    target: Native.ZirTarget
    resolve: CEmit.ZirResolveTarget
    context: *void
    assembly: ZirAssemblyBlockEmitter
    assembly_context: *void
    indent: s32
    serial: s32
    depth: s32
    local_count: s32
    locals: *Local
    loop_count: s32
    loop_start: [128]s32
    loop_id: [128]s32
    loop_native: [128]s32
    loop_header: [IR.ZIR_TEXT_MAX]u8
    loop_header_binds: s32
    sequence_terminated: s32
    pure: s32
    minify: s32
    call_in_place: s32
    array_destination: *u8
    array_destination_used: s32
    array_operand: s32
    ranges: *RangeFactsMod.RangeFacts
    short_declaration: s32
    braced_initializer: s32
    simd_tier: *u8
    inline_result: *u8
    inline_label: *u8
    inline_tail: s32
    inline_jumps: s32
    inline_depth: s32
}

zir_minify_output: s32 = 0;

#scope_file

libc :: #system_library "libc";
compiler :: #system_library "ziran";

free :: (memory: *void) #foreign libc "free";
exit :: (status: s32) #foreign libc "exit";
memmove :: (dst: *void, src: *void, count: usize) -> *void #foreign libc "memmove";
memset :: (dst: *void, value: s32, count: usize) -> *void #foreign libc "memset";
strlen :: (s: *u8) -> usize #foreign libc "strlen";
strcmp :: (a: *u8, b: *u8) -> s32 #foreign libc "strcmp";
strncmp :: (a: *u8, b: *u8, n: usize) -> s32 #foreign libc "strncmp";
strchr :: (s: *u8, c: s32) -> *u8 #foreign libc "strchr";
strstr :: (haystack: *u8, needle: *u8) -> *u8 #foreign libc "strstr";
strcat :: (dst: *u8, src: *u8) -> *u8 #foreign libc "strcat";
strspn :: (s: *u8, accept: *u8) -> usize #foreign libc "strspn";
snprintf :: (out: *u8, size: usize, fmt: *u8, args: ..any) -> s32 #foreign libc "snprintf";
fprintf :: (stream: *void, fmt: *u8, args: ..any) -> s32 #foreign libc "fprintf";
fputs :: (s: *u8, stream: *void) -> s32 #foreign libc "fputs";
fputc :: (c: s32, stream: *void) -> s32 #foreign libc "fputc";

AllocateOrExit :: (size: usize) -> *void #foreign compiler "AllocateOrExit";
Diagnostic :: (span: IR.ZirSourceSpan, code: *u8, fmt: *u8, args: ..any) #foreign compiler "Diagnostic";
copy_text :: (dst: *u8, size: usize, src: *u8) #foreign compiler "copy_text";
go_field_ident :: (s: *u8, dst: *u8, dst_size: usize) #foreign compiler "go_field_ident";
ArrayElementType :: (type: *u8, element: *u8, size: usize, capacity: *s32) -> s32 #foreign compiler "ArrayElementType";
SliceElementType :: (type: *u8, element: *u8, size: usize) -> s32 #foreign compiler "SliceElementType";
VecElementType :: (module: *IR.ZirModule, type: *u8, element: *u8, size: usize) -> s32 #foreign compiler "VecElementType";
CFindType :: (module: *IR.ZirModule, name: *u8, owner: **IR.ZirModule) -> *IR.ZirType #foreign compiler "FindType";
CTypeNextField :: (record: *IR.ZirType, offset: *usize, field: *IR.ZirTypeField) -> s32 #foreign compiler "TypeNextField";
ZirIntegerLiteral :: (text: *u8, value: *u64) -> s32 #foreign compiler "ZirIntegerLiteral";
DecodeStringLiteral :: (source: *u8, out: *u8, capacity: usize, length: *usize) -> s32 #foreign compiler "DecodeStringLiteral";
ParseExpr :: (fn: *IR.ZirFunction, module: *IR.ZirModule, text: *u8, span: IR.ZirSourceSpan) -> s32 #foreign compiler "CompilerParseExpr";

// Emitter procedures linked from the expression and call modules.
emit_expr :: (e: *Emitter, index: s32, expected: *u8, out: *u8, size: usize) #foreign compiler "zir_emit_emit_expr";
member_path :: (fn: *IR.ZirFunction, index: s32) -> s32 #foreign compiler "zir_emit_member_path";

// From compiler_c_emit.zi (C-exported names).
CFunctionMentions :: (fn: *IR.ZirFunction, name: *u8) -> s32 #foreign compiler "zir_emit_function_mentions";
CCanonical :: (type: *u8) -> *u8 #foreign compiler "zir_emit_canonical";
CSlotTypeAtUse :: (source: *u8, target: Native.ZirTarget, resolve_type: CEmit.ZirResolveTarget,
                   context: *void, out: *u8, size: usize) #foreign compiler "zir_emit_slot_type_at_use";
CWidth :: (type: *u8) -> s32 #foreign compiler "zir_emit_width";
CSignedType :: (type: *u8) -> s32 #foreign compiler "zir_emit_signed_type";
CEnumType :: (module: *IR.ZirModule, type: *u8) -> s32 #foreign compiler "zir_emit_enum_type";
CFieldRecord :: (module: *IR.ZirModule, type: *u8, owner: **IR.ZirModule) -> *IR.ZirType #foreign compiler "zir_emit_field_record";
CSpelledPointerField :: (record: *IR.ZirType, name: *u8, field: *IR.ZirTypeField) -> s32 #foreign compiler "zir_emit_spelled_pointer_field";
CEmitFieldPath :: (module: *IR.ZirModule, target: Native.ZirTarget, base_type: *u8, path: *u8,
                   read: s32, base_expression: *u8, out: *u8, size: usize) #foreign compiler "zir_emit_emit_field_path";
CEmitterTypeContainsVec :: (module: *IR.ZirModule, type: *u8, depth: s32) -> s32 #foreign compiler "zir_emit_emitter_type_contains_vec";
CTargetBindingName :: (fn: *IR.ZirFunction, target: Native.ZirTarget, name: *u8, out: *u8, size: usize) #foreign compiler "TargetBindingName";
CTargetFieldName :: (record: *IR.ZirType, target: Native.ZirTarget, name: *u8, out: *u8, size: usize) #foreign compiler "TargetFieldName";
CTypeHasZeroArray :: (module: *IR.ZirModule, type: *u8) -> s32 #foreign compiler "TypeHasZeroArray";
CNativeGoType :: (module: *IR.ZirModule, type: *u8, dst: *u8, dst_size: usize) -> s32 #foreign compiler "NativeGoType";

StaticText :: struct { data: *u8; length: usize }
CStr :: (s: string) -> *u8 { return (cast(*StaticText)(*s)).data }
PtrAdd :: (p: *u8, n: usize) -> *u8 { return cast(*u8)(cast(usize)p + n) }
PtrSub :: (p: *u8, n: usize) -> *u8 { return cast(*u8)(cast(usize)p - n) }

FunctionArgs :: (fn: *IR.ZirFunction) -> *u8 {
    if fn != null && fn.args_text != null { return fn.args_text }
    return CStr("")
}

IsDigit :: (c: u8) -> bool { return c >= #char "0" && c <= #char "9" }

CheckFormat :: (n: s32, size: usize) -> s32 {
    if n < 0 || cast(usize)n >= size {
        zero_span: IR.ZirSourceSpan
        Diagnostic(zero_span, CStr("zir.output"), CStr("generated expression exceeds output limit"))
        exit(1)
    }
    return n
}

EmitIndent :: (e: *Emitter) {
    unit := ifx e.target == .ZIR_GO then CStr("\t") else CStr("    ")
    for i: cast(s32)0..e.indent - 1 { fputs(unit, e.out) }
}

EmitLineText :: (e: *Emitter, text: *u8) {
    EmitIndent(e)
    fputs(text, e.out)
    fputc(#char "\n", e.out)
}

UINT64_MAX_VAL :: () -> u64 { return 0xffffffffffffffff }
INT64_MIN_VAL :: () -> s64 { return -9223372036854775807 - 1 }
INT64_MAX_VAL :: () -> u64 { return 9223372036854775807 }

// Parse an unsigned base-0 integer (decimal, 0x hex, 0 octal) with overflow check.
ParseU64Base0 :: (s: *u8, end_out: **u8, value_out: *u64) -> bool {
    p := s
    base: u64 = 10
    if p[0] == #char "0" {
        if p[1] == #char "x" || p[1] == #char "X" {
            base = 16
            p = PtrAdd(p, 2)
        } else {
            base = 8
        }
    }
    val: u64 = 0
    digits: s32 = 0
    max_u64 := UINT64_MAX_VAL()
    while p[0] != 0 {
        d: u64 = 0
        c := p[0]
        if c >= #char "0" && c <= #char "9" { d = cast(u64)(c - #char "0") }
        else if c >= #char "a" && c <= #char "f" { d = cast(u64)(c - #char "a" + 10) }
        else if c >= #char "A" && c <= #char "F" { d = cast(u64)(c - #char "A" + 10) }
        else { break }
        if d >= base { break }
        if val > (max_u64 - d) / base { return false }
        val = val * base + d
        digits += 1
        p = PtrAdd(p, 1)
    }
    if digits == 0 {
        if base == 16 { return false }
    }
    <<end_out = p
    <<value_out = val
    return true
}

// Parse a signed negative base-0 integer (starting with '-').
ParseNegS64Base0 :: (s: *u8, end_out: **u8, value_out: *s64) -> bool {
    if s[0] != #char "-" { return false }
    mag: u64 = 0
    end: *u8 = null
    if !ParseU64Base0(PtrAdd(s, 1), *end, *mag) { return false }
    limit: u64 = cast(u64)1 << 63
    if mag > limit { return false }
    <<end_out = end
    if mag == limit {
        <<value_out = INT64_MIN_VAL()
    } else {
        <<value_out = -cast(s64)mag
    }
    return true
}

#scope_export

#program_export
EmitUseMinifiedOutput :: (enabled: s32) {
    zir_minify_output = ifx enabled != 0 then cast(s32)1 else cast(s32)0
}

#program_export "zir_emit_plain_identifier"
PlainIdentifier :: (text: *u8) -> s32 {
    c := text[0]
    if !(c == #char "_" || (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z")) {
        return 0
    }
    p := PtrAdd(text, 1)
    while p[0] != 0 {
        b := p[0]
        if !(b == #char "_" || (b >= #char "a" && b <= #char "z") ||
             (b >= #char "A" && b <= #char "Z") || (b >= #char "0" && b <= #char "9")) {
            return 0
        }
        p = PtrAdd(p, 1)
    }
    return 1
}

#program_export "zir_emit_folds_text"
FoldsText :: (e: *Emitter, text: *u8, type: *u8) -> s32 {
    if e.target != .ZIR_GO && ArrayElementType(type, null, 0, null) != 0 { return 0 }
    if PlainIdentifier(text) != 0 { return 1 }
    return ifx e.pure != 0 && (e.minify != 0 || strlen(text) <= ZIR_INLINE_MAX) then 1 else 0
}

#program_export "zir_emit_fatal"
Fatal :: (expr: *IR.ZirExpr, message: *u8) {
    Diagnostic(expr.span, CStr("emit.expression"), CStr("%s: %s"), message, expr.text)
    exit(1)
}

#scope_file

MentionsValueNames :: (fn: *IR.ZirFunction, module: *IR.ZirModule) -> bool {
    if strstr(FunctionArgs(fn), CStr("value_")) != null { return true }
    for i: cast(s32)0..fn.stmt_count - 1 {
        if fn.stmts[i].name != null && strncmp(fn.stmts[i].name, CStr("value_"), 6) == 0 { return true }
    }
    for i: cast(s32)0..fn.expr_count - 1 {
        if fn.exprs[i].name != null && strncmp(fn.exprs[i].name, CStr("value_"), 6) == 0 { return true }
    }
    for i: cast(s32)0..module.global_count - 1 {
        if strncmp(*module.globals[i].name[0], CStr("value_"), 6) == 0 { return true }
    }
    for i: cast(s32)0..module.define_count - 1 {
        if strncmp(*module.defines[i].name[0], CStr("value_"), 6) == 0 { return true }
    }
    for i: cast(s32)0..module.function_count - 1 {
        if strncmp(*module.functions[i].name[0], CStr("value_"), 6) == 0 { return true }
    }
    return false
}

#scope_export

#program_export "zir_emit_fresh"
Fresh :: (e: *Emitter, name: *u8) {
    if !MentionsValueNames(e.fn, e.module) {
        CheckFormat(snprintf(name, IR.ZIR_NAME_MAX, CStr("value_%d"), e.serial), IR.ZIR_NAME_MAX)
        e.serial += 1
        return
    }
    while true {
        CheckFormat(snprintf(name, IR.ZIR_NAME_MAX, CStr("value_%d"), e.serial), IR.ZIR_NAME_MAX)
        e.serial += 1
        collision := CFunctionMentions(e.fn, name) != 0
        for i: cast(s32)0..e.module.global_count - 1 {
            if strcmp(*e.module.globals[i].name[0], name) == 0 { collision = true }
        }
        for i: cast(s32)0..e.module.define_count - 1 {
            if strcmp(*e.module.defines[i].name[0], name) == 0 { collision = true }
        }
        for i: cast(s32)0..e.module.function_count - 1 {
            if strcmp(*e.module.functions[i].name[0], name) == 0 { collision = true }
        }
        if !collision { return }
    }
}

#program_export "zir_emit_assign_value"
AssignValue :: (e: *Emitter, destination: *u8, type: *u8, source: *u8) {
    plain := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    defer { free(cast(*void)plain) }
    src := Bare(source, plain, IR.ZIR_TEXT_MAX)
    EmitIndent(e)
    if ArrayElementType(type, null, 0, null) != 0 && e.target == .ZIR_C {
        fprintf(e.out, CStr("memmove(%s, %s, sizeof(%s));\n"), destination, src, destination)
    } else {
        semi := ifx e.target == .ZIR_GO then CStr("") else CStr(";")
        fprintf(e.out, CStr("%s = %s%s\n"), destination, src, semi)
    }
}

#program_export "zir_emit_array_target_type"
ArrayTargetType :: (e: *Emitter, type: *u8, target_element: *u8, element_size: usize,
                    bounds: *u8, bounds_size: usize) {
    element: [IR.ZIR_NAME_MAX]u8
    bounds[0] = 0
    working: [IR.ZIR_NAME_MAX * 2]u8
    capacity: s32 = 0
    copy_text(*working[0], IR.ZIR_NAME_MAX * 2, type)
    while true {
        inner: [IR.ZIR_NAME_MAX]u8
        bound: [IR.ZIR_NAME_MAX]u8
        if ArrayElementType(*working[0], *inner[0], IR.ZIR_NAME_MAX, *capacity) == 0 { break }
        if capacity >= 0 {
            CheckFormat(snprintf(*bound[0], IR.ZIR_NAME_MAX, CStr("[%d]"), capacity), IR.ZIR_NAME_MAX)
        } else {
            symbol: [IR.ZIR_NAME_MAX]u8
            close := strchr(*working[0], #char "]")
            sym_len := cast(s32)(cast(usize)close - cast(usize)*working[0] - 1)
            CheckFormat(snprintf(*symbol[0], IR.ZIR_NAME_MAX, CStr("%.*s"), sym_len, *working[1]), IR.ZIR_NAME_MAX)
            e.resolve(e.context, *symbol[0], *bound[0], IR.ZIR_NAME_MAX)
            wrapped: [IR.ZIR_NAME_MAX]u8
            CheckFormat(snprintf(*wrapped[0], IR.ZIR_NAME_MAX, CStr("[%s]"), *bound[0]), IR.ZIR_NAME_MAX)
            copy_text(*bound[0], IR.ZIR_NAME_MAX, *wrapped[0])
        }
        copy_text(*working[0], IR.ZIR_NAME_MAX * 2, *inner[0])
        if bounds[0] == 0 {
            copy_text(bounds, bounds_size, *bound[0])
        } else if strlen(bounds) + strlen(*bound[0]) < bounds_size {
            strcat(bounds, *bound[0])
        }
    }
    copy_text(*element[0], IR.ZIR_NAME_MAX, *working[0])
    scalar := cast(*u8)Native.TargetType(cast(*void)*element[0], e.target)
    if scalar != null {
        copy_text(target_element, element_size, scalar)
    } else if element[0] == #char "*" {
        native: [IR.ZIR_NAME_MAX * 2]u8
        if e.target == .ZIR_GO {
            if CNativeGoType(e.module, *element[0], *native[0], IR.ZIR_NAME_MAX * 2) == 0 {
                Diagnostic(e.fn.span, CStr("emit.array_element"), CStr("unsupported Go array element type: %s"), *element[0])
                exit(1)
            }
        } else {
            if e.target == .ZIR_C {
                CSlotTypeAtUse(*element[0], e.target, CEmit.ResolveTypeAtUse, cast(*void)e.module, *native[0], IR.ZIR_NAME_MAX * 2)
            } else {
                CEmit.SlotNativeType(*element[0], e.target, *native[0], IR.ZIR_NAME_MAX * 2)
            }
        }
        copy_text(target_element, element_size, *native[0])
    } else {
        e.resolve(e.context, *element[0], target_element, element_size)
    }
}

#program_export "zir_emit_declare_array"
DeclareArray :: (e: *Emitter, name: *u8, type: *u8, value: *u8) {
    target_element: [IR.ZIR_NAME_MAX * 2]u8
    bounds: [IR.ZIR_NAME_MAX * 2]u8
    ArrayTargetType(e, type, *target_element[0], IR.ZIR_NAME_MAX * 2, *bounds[0], IR.ZIR_NAME_MAX * 2)
    if e.target == .ZIR_GO {
        short_form := e.short_declaration
        e.short_declaration = 0
        EmitIndent(e)
        if value != null && value[0] != 0 && short_form != 0 {
            fprintf(e.out, CStr("%s := %s\n"), name, value)
        } else if value != null && value[0] != 0 {
            fprintf(e.out, CStr("var %s %s%s = %s\n"), name, *bounds[0], *target_element[0], value)
        } else {
            fprintf(e.out, CStr("var %s %s%s\n"), name, *bounds[0], *target_element[0])
        }
    } else if e.target == .ZIR_C {
        zero := CTypeHasZeroArray(e.module, type)
        listed := value != null && value[0] == #char "{"
        ext := ifx zero != 0 then CStr("__extension__ ") else CStr("")
        init := ifx listed then value else (ifx zero != 0 then CStr("{}") else CStr("{0}"))
        EmitIndent(e)
        fprintf(e.out, CStr("%s%s %s%s = %s;\n"), ext, *target_element[0], name, *bounds[0], init)
        if value != null && value[0] != 0 && !listed {
            AssignValue(e, name, type, value)
        }
    } else {
        Diagnostic(e.fn.span, CStr("emit.array_target"), CStr("array values are supported only by native targets"))
        exit(1)
    }
}

#scope_file

NumericLiteral :: (text: *u8) -> bool {
    p := text
    while p[0] == #char "-" || p[0] == #char "+" || p[0] == #char "(" { p = PtrAdd(p, 1) }
    return IsDigit(p[0]) || p[0] == #char "." || p[0] == #char "'"
}

#scope_export

#program_export "zir_emit_declare"
Declare :: (e: *Emitter, name: *u8, type: *u8, value: *u8) {
    binding: [IR.ZIR_NAME_MAX]u8
    plain := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    defer { free(cast(*void)plain) }
    short_form := e.short_declaration
    val := value
    if val != null { val = Bare(val, plain, IR.ZIR_TEXT_MAX) }
    if val == null || val[0] == 0 || NumericLiteral(val) { short_form = 0 }
    if ArrayElementType(type, null, 0, null) != 0 {
        e.short_declaration = short_form
    } else {
        e.short_declaration = 0
    }
    CTargetBindingName(e.fn, e.target, name, *binding[0], IR.ZIR_NAME_MAX)
    bname := *binding[0]
    if ArrayElementType(type, null, 0, null) != 0 {
        DeclareArray(e, bname, type, val)
        return
    }
    target_type := cast(*u8)Native.TargetType(cast(*void)type, e.target)
    resolved_type: [IR.ZIR_NAME_MAX * 2]u8
    if type[0] == #char "*" {
        pointee := type
        base_type: [IR.ZIR_NAME_MAX]u8
        pointer_depth: usize = 0
        while pointee[pointer_depth] == #char "*" { pointer_depth += 1 }
        pointee = PtrAdd(pointee, pointer_depth)
        scalar := cast(*u8)Native.TargetType(cast(*void)pointee, e.target)
        if e.target == .ZIR_GO && strcmp(pointee, CStr("void")) == 0 {
            copy_text(*base_type[0], IR.ZIR_NAME_MAX, CStr("byte"))
        } else if scalar != null {
            copy_text(*base_type[0], IR.ZIR_NAME_MAX, scalar)
        } else {
            e.resolve(e.context, pointee, *base_type[0], IR.ZIR_NAME_MAX)
        }
        if e.target == .ZIR_GO {
            used: usize = 0
            d: usize = 0
            while d < pointer_depth && used + 1 < IR.ZIR_NAME_MAX * 2 {
                resolved_type[used] = #char "*"
                used += 1
                d += 1
            }
            resolved_type[used] = 0
            copy_text(*resolved_type[used], IR.ZIR_NAME_MAX * 2 - used, *base_type[0])
        } else {
            CheckFormat(snprintf(*resolved_type[0], IR.ZIR_NAME_MAX * 2, CStr("%s"), *base_type[0]), IR.ZIR_NAME_MAX * 2)
            used := strlen(*resolved_type[0])
            d: usize = 0
            while d < pointer_depth && used + 1 < IR.ZIR_NAME_MAX * 2 {
                resolved_type[used] = #char "*"
                used += 1
                d += 1
            }
            resolved_type[used] = 0
        }
        target_type = *resolved_type[0]
    } else if target_type == null {
        e.resolve(e.context, type, *resolved_type[0], IR.ZIR_NAME_MAX * 2)
        target_type = *resolved_type[0]
    }
    EmitIndent(e)
    if CEnumType(e.module, type) != 0 {
        if short_form != 0 && e.target == .ZIR_GO {
            fprintf(e.out, CStr("%s := %s\n"), bname, val)
        } else if short_form != 0 {
            fprintf(e.out, CStr("%s %s = %s;\n"), target_type, bname, val)
        } else if e.target == .ZIR_GO {
            fprintf(e.out, CStr("var %s %s = %s(%s)\n"), bname, target_type, target_type, val)
        } else {
            fprintf(e.out, CStr("%s %s = (%s)(%s);\n"), target_type, bname, target_type, val)
        }
        return
    }
    if e.target == .ZIR_GO && short_form != 0 {
        fprintf(e.out, CStr("%s := %s\n"), bname, val)
    } else if e.target == .ZIR_GO {
        fprintf(e.out, CStr("var %s %s = %s\n"), bname, target_type, val)
    } else {
        ext := ifx CTypeHasZeroArray(e.module, type) != 0 then CStr("__extension__ ") else CStr("")
        fprintf(e.out, CStr("%s%s %s = %s;\n"), ext, target_type, bname, val)
    }
}

#program_export "zir_emit_resolve"
Resolve :: (e: *Emitter, name: *u8, out: *u8, size: usize) {
    i := e.local_count - 1
    while i >= 0 {
        if strcmp(*e.locals[i].name[0], name) == 0 {
            if e.locals[i].alias[0] != 0 {
                copy_text(out, size, *e.locals[i].alias[0])
            } else {
                CTargetBindingName(e.fn, e.target, name, out, size)
            }
            return
        }
        i -= 1
    }
    e.resolve(e.context, name, out, size)
}

#scope_file

// Read the target spellings of an owned callable's three private fields.
// state/release/invoke names are compiler-owned, so an unknown spelling is
// reported through an empty output rather than a fatal.
OwnedCallableField :: (e: *Emitter, record: *IR.ZirType, wanted: *u8, out: *u8, size: usize) {
    out[0] = 0
    offset: usize = 0
    field: IR.ZirTypeField
    while CTypeNextField(record, *offset, *field) == 1 {
        if strcmp(*field.name[0], wanted) != 0 { continue }
        CTargetFieldName(record, e.target, *field.name[0], out, size)
        if e.target == .ZIR_GO { go_field_ident(out, out, size) }
        return
    }
}

// Release one owned callable: run its generated cleanup slot while the
// state is live, then clear the record so a later drop releases nothing.
DropOwnedCallable :: (e: *Emitter, value: *u8, record: *IR.ZirType) {
    state: [IR.ZIR_NAME_MAX]u8
    invoke: [IR.ZIR_NAME_MAX]u8
    release: [IR.ZIR_NAME_MAX]u8
    text := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    defer { free(cast(*void)text) }
    OwnedCallableField(e, record, CStr("state"), *state[0], IR.ZIR_NAME_MAX)
    OwnedCallableField(e, record, CStr("invoke"), *invoke[0], IR.ZIR_NAME_MAX)
    OwnedCallableField(e, record, CStr("release"), *release[0], IR.ZIR_NAME_MAX)
    if state[0] == 0 || release[0] == 0 { return }
    if e.target == .ZIR_GO {
        CheckFormat(snprintf(text, IR.ZIR_TEXT_MAX, CStr("(%s).%s != nil && (%s).%s != nil"),
                             value, *state[0], value, *release[0]), IR.ZIR_TEXT_MAX)
        EmitIndent(e); fprintf(e.out, CStr("if %s {\n"), text)
        e.indent += 1
        CheckFormat(snprintf(text, IR.ZIR_TEXT_MAX, CStr("(%s).%s((%s).%s)"),
                             value, *release[0], value, *state[0]), IR.ZIR_TEXT_MAX)
        EmitIndent(e); fprintf(e.out, CStr("%s\n"), text)
        e.indent -= 1
        EmitIndent(e); fputs(CStr("}\n"), e.out)
        EmitIndent(e); fprintf(e.out, CStr("(%s).%s = nil\n"), value, *state[0])
        if invoke[0] != 0 {
            EmitIndent(e); fprintf(e.out, CStr("(%s).%s = nil\n"), value, *invoke[0])
        }
        EmitIndent(e); fprintf(e.out, CStr("(%s).%s = nil\n"), value, *release[0])
        return
    }
    // Owned invoke and release slots are always portable fat pointers; the
    // instantiation rejects c_call signatures outright.
    CheckFormat(snprintf(text, IR.ZIR_TEXT_MAX,
                         CStr("((%s).%s != NULL) && ((%s).%s.call != NULL)"),
                         value, *state[0], value, *release[0]), IR.ZIR_TEXT_MAX)
    EmitIndent(e); fprintf(e.out, CStr("if (%s) {\n"), text)
    e.indent += 1
    CheckFormat(snprintf(text, IR.ZIR_TEXT_MAX,
                         CStr("(%s).%s.call((%s).%s.context, (%s).%s)"),
                         value, *release[0], value, *release[0], value, *state[0]), IR.ZIR_TEXT_MAX)
    EmitIndent(e); fprintf(e.out, CStr("%s;\n"), text)
    e.indent -= 1
    EmitIndent(e); fputs(CStr("}\n"), e.out)
    EmitIndent(e); fprintf(e.out, CStr("(%s).%s = NULL;\n"), value, *state[0])
    if invoke[0] != 0 {
        EmitIndent(e); fprintf(e.out, CStr("(%s).%s.context = NULL;\n"), value, *invoke[0])
        EmitIndent(e); fprintf(e.out, CStr("(%s).%s.call = NULL;\n"), value, *invoke[0])
    }
    EmitIndent(e); fprintf(e.out, CStr("(%s).%s.context = NULL;\n"), value, *release[0])
    EmitIndent(e); fprintf(e.out, CStr("(%s).%s.call = NULL;\n"), value, *release[0])
}

// Empty one owned callable record: state, invoke and release all cleared.
ClearOwnedCallable :: (e: *Emitter, value: *u8, record: *IR.ZirType) {
    state: [IR.ZIR_NAME_MAX]u8
    invoke: [IR.ZIR_NAME_MAX]u8
    release: [IR.ZIR_NAME_MAX]u8
    OwnedCallableField(e, record, CStr("state"), *state[0], IR.ZIR_NAME_MAX)
    OwnedCallableField(e, record, CStr("invoke"), *invoke[0], IR.ZIR_NAME_MAX)
    OwnedCallableField(e, record, CStr("release"), *release[0], IR.ZIR_NAME_MAX)
    if state[0] == 0 || release[0] == 0 { return }
    if e.target == .ZIR_GO {
        EmitIndent(e); fprintf(e.out, CStr("(%s).%s = nil\n"), value, *state[0])
        if invoke[0] != 0 {
            EmitIndent(e); fprintf(e.out, CStr("(%s).%s = nil\n"), value, *invoke[0])
        }
        EmitIndent(e); fprintf(e.out, CStr("(%s).%s = nil\n"), value, *release[0])
        return
    }
    EmitIndent(e); fprintf(e.out, CStr("(%s).%s = NULL;\n"), value, *state[0])
    if invoke[0] != 0 {
        EmitIndent(e); fprintf(e.out, CStr("(%s).%s.context = NULL;\n"), value, *invoke[0])
        EmitIndent(e); fprintf(e.out, CStr("(%s).%s.call = NULL;\n"), value, *invoke[0])
    }
    EmitIndent(e); fprintf(e.out, CStr("(%s).%s.context = NULL;\n"), value, *release[0])
    EmitIndent(e); fprintf(e.out, CStr("(%s).%s.call = NULL;\n"), value, *release[0])
}

#scope_export

#program_export "zir_emit_drop_owned_value"
DropOwnedValue :: (e: *Emitter, value: *u8, type: *u8, module: *IR.ZirModule, depth: s32) {
    element: [IR.ZIR_NAME_MAX]u8
    if depth > 32 || value == null || type == null { return }
    if VecElementType(module, type, *element[0], IR.ZIR_NAME_MAX) != 0 {
        if CEmitterTypeContainsVec(module, *element[0], 0) != 0 {
            index: [IR.ZIR_NAME_MAX]u8
            item := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
            defer { free(cast(*void)item) }
            Fresh(e, *index[0])
            EmitIndent(e)
            if e.target == .ZIR_GO {
                fprintf(e.out, CStr("for %s := int64(0); %s < (%s).Count; %s++ {\n"), *index[0], *index[0], value, *index[0])
            } else {
                fprintf(e.out, CStr("for (int64_t %s = 0; %s < (%s).count; ++%s) {\n"), *index[0], *index[0], value, *index[0])
            }
            e.indent += 1
            data_field := ifx e.target == .ZIR_GO then CStr("Data") else CStr("data")
            CheckFormat(snprintf(item, IR.ZIR_TEXT_MAX, CStr("(%s).%s[%s]"), value, data_field, *index[0]), IR.ZIR_TEXT_MAX)
            DropOwnedValue(e, item, *element[0], module, depth + 1)
            e.indent -= 1
            EmitLineText(e, CStr("}"))
        }
        if e.target == .ZIR_GO {
            EmitIndent(e); fprintf(e.out, CStr("%s.Data = nil\n"), value)
            EmitIndent(e); fprintf(e.out, CStr("%s.Capacity = 0\n"), value)
            EmitIndent(e); fprintf(e.out, CStr("%s.Count = 0\n"), value)
        } else {
            EmitIndent(e); fprintf(e.out, CStr("free(%s.data);\n"), value)
            EmitIndent(e); fprintf(e.out, CStr("%s.data = NULL;\n"), value)
            EmitIndent(e); fprintf(e.out, CStr("%s.capacity = 0;\n"), value)
            EmitIndent(e); fprintf(e.out, CStr("%s.count = 0;\n"), value)
        }
        return
    }
    capacity: s32 = -1
    if ArrayElementType(type, *element[0], IR.ZIR_NAME_MAX, *capacity) != 0 && capacity != 0 {
        index: [IR.ZIR_NAME_MAX]u8
        item := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
        defer { free(cast(*void)item) }
        Fresh(e, *index[0])
        EmitIndent(e)
        if e.target == .ZIR_GO {
            fprintf(e.out, CStr("for %s := 0; %s < len(%s); %s++ {\n"), *index[0], *index[0], value, *index[0])
        } else {
            fprintf(e.out, CStr("for (size_t %s = 0; %s < sizeof(%s) / sizeof((%s)[0]); ++%s) {\n"),
                    *index[0], *index[0], value, value, *index[0])
        }
        e.indent += 1
        CheckFormat(snprintf(item, IR.ZIR_TEXT_MAX, CStr("(%s)[%s]"), value, *index[0]), IR.ZIR_TEXT_MAX)
        DropOwnedValue(e, item, *element[0], module, depth + 1)
        e.indent -= 1
        EmitLineText(e, CStr("}"))
        return
    }
    owner: *IR.ZirModule = null
    record := CFindType(module, type, *owner)
    if record != null && record.is_owned_callable != 0 {
        DropOwnedCallable(e, value, record)
        return
    }
    if record == null || record.is_enum != 0 || record.is_procedure_type != 0 ||
       record.is_record_template != 0 || record.is_extern != 0 {
        return
    }
    member := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    defer { free(cast(*void)member) }
    offset: usize = 0
    field: IR.ZirTypeField
    next_mod := ifx owner != null then owner else module
    while CTypeNextField(record, *offset, *field) == 1 {
        native: [IR.ZIR_NAME_MAX]u8
        CTargetFieldName(record, e.target, *field.name[0], *native[0], IR.ZIR_NAME_MAX)
        if e.target == .ZIR_GO { go_field_ident(*native[0], *native[0], IR.ZIR_NAME_MAX) }
        CheckFormat(snprintf(member, IR.ZIR_TEXT_MAX, CStr("(%s).%s"), value, *native[0]), IR.ZIR_TEXT_MAX)
        DropOwnedValue(e, member, *field.type[0], next_mod, depth + 1)
    }
}

#program_export "zir_emit_clear_owned_value"
ClearOwnedValue :: (e: *Emitter, value: *u8, type: *u8, module: *IR.ZirModule, depth: s32) {
    element: [IR.ZIR_NAME_MAX]u8
    if depth > 32 || value == null || type == null { return }
    if VecElementType(module, type, null, 0) != 0 {
        if e.target == .ZIR_GO {
            EmitIndent(e); fprintf(e.out, CStr("%s.Data = nil\n"), value)
            EmitIndent(e); fprintf(e.out, CStr("%s.Capacity = 0\n"), value)
            EmitIndent(e); fprintf(e.out, CStr("%s.Count = 0\n"), value)
        } else {
            EmitIndent(e); fprintf(e.out, CStr("%s.data = NULL;\n"), value)
            EmitIndent(e); fprintf(e.out, CStr("%s.capacity = 0;\n"), value)
            EmitIndent(e); fprintf(e.out, CStr("%s.count = 0;\n"), value)
        }
        return
    }
    capacity: s32 = -1
    if ArrayElementType(type, *element[0], IR.ZIR_NAME_MAX, *capacity) != 0 && capacity != 0 {
        index: [IR.ZIR_NAME_MAX]u8
        item := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
        defer { free(cast(*void)item) }
        Fresh(e, *index[0])
        EmitIndent(e)
        if e.target == .ZIR_GO {
            fprintf(e.out, CStr("for %s := 0; %s < len(%s); %s++ {\n"), *index[0], *index[0], value, *index[0])
        } else {
            fprintf(e.out, CStr("for (size_t %s = 0; %s < sizeof(%s) / sizeof((%s)[0]); ++%s) {\n"),
                    *index[0], *index[0], value, value, *index[0])
        }
        e.indent += 1
        CheckFormat(snprintf(item, IR.ZIR_TEXT_MAX, CStr("(%s)[%s]"), value, *index[0]), IR.ZIR_TEXT_MAX)
        ClearOwnedValue(e, item, *element[0], module, depth + 1)
        e.indent -= 1
        EmitLineText(e, CStr("}"))
        return
    }
    owner: *IR.ZirModule = null
    record := CFindType(module, type, *owner)
    if record != null && record.is_owned_callable != 0 {
        ClearOwnedCallable(e, value, record)
        return
    }
    if record == null || record.is_enum != 0 || record.is_procedure_type != 0 ||
       record.is_record_template != 0 || record.is_extern != 0 {
        return
    }
    member := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    defer { free(cast(*void)member) }
    offset: usize = 0
    field: IR.ZirTypeField
    next_mod := ifx owner != null then owner else module
    while CTypeNextField(record, *offset, *field) == 1 {
        native: [IR.ZIR_NAME_MAX]u8
        CTargetFieldName(record, e.target, *field.name[0], *native[0], IR.ZIR_NAME_MAX)
        if e.target == .ZIR_GO { go_field_ident(*native[0], *native[0], IR.ZIR_NAME_MAX) }
        CheckFormat(snprintf(member, IR.ZIR_TEXT_MAX, CStr("(%s).%s"), value, *native[0]), IR.ZIR_TEXT_MAX)
        ClearOwnedValue(e, member, *field.type[0], next_mod, depth + 1)
    }
}

#program_export "zir_emit_track_local"
TrackLocal :: (e: *Emitter, name: *u8, type: *u8) {
    local := *e.locals[e.local_count]
    e.local_count += 1
    memset(cast(*void)local, 0, size_of(Local))
    copy_text(*local.name[0], IR.ZIR_NAME_MAX, name)
    copy_text(*local.type[0], IR.ZIR_NAME_MAX, type)
    local.depth = e.depth
    if VecElementType(e.module, type, null, 0) != 0 {
        pointer_type: [IR.ZIR_NAME_MAX * 2]u8
        binding: [IR.ZIR_NAME_MAX]u8
        address: [IR.ZIR_NAME_MAX + 2]u8
        CTargetBindingName(e.fn, e.target, name, *binding[0], IR.ZIR_NAME_MAX)
        Fresh(e, *local.drop_alias[0])
        CheckFormat(snprintf(*pointer_type[0], IR.ZIR_NAME_MAX * 2, CStr("*%s"), type), IR.ZIR_NAME_MAX * 2)
        CheckFormat(snprintf(*address[0], IR.ZIR_NAME_MAX + 2, CStr("&%s"), *binding[0]), IR.ZIR_NAME_MAX + 2)
        Declare(e, *local.drop_alias[0], *pointer_type[0], *address[0])
    }
}

#program_export "zir_emit_alias_shadowed_local"
AliasShadowedLocal :: (e: *Emitter, name: *u8) {
    i := e.local_count - 1
    while i >= 0 {
        local := *e.locals[i]
        if strcmp(*local.name[0], name) != 0 { i -= 1; continue }
        if local.drop_alias[0] != 0 || local.alias[0] != 0 ||
           CEmitterTypeContainsVec(e.module, *local.type[0], 0) == 0 {
            return
        }
        pointer_type: [IR.ZIR_NAME_MAX * 2]u8
        binding: [IR.ZIR_NAME_MAX]u8
        address: [IR.ZIR_NAME_MAX + 2]u8
        CTargetBindingName(e.fn, e.target, name, *binding[0], IR.ZIR_NAME_MAX)
        Fresh(e, *local.drop_alias[0])
        local.shadow_depth = e.depth
        CheckFormat(snprintf(*pointer_type[0], IR.ZIR_NAME_MAX * 2, CStr("*%s"), *local.type[0]), IR.ZIR_NAME_MAX * 2)
        CheckFormat(snprintf(*address[0], IR.ZIR_NAME_MAX + 2, CStr("&%s"), *binding[0]), IR.ZIR_NAME_MAX + 2)
        Declare(e, *local.drop_alias[0], *pointer_type[0], *address[0])
        return
    }
}

#program_export "zir_emit_leave_block_locals"
LeaveBlockLocals :: (e: *Emitter, saved: s32) {
    i: s32 = 0
    while i < saved && i < e.local_count {
        if e.locals[i].shadow_depth == e.depth {
            e.locals[i].drop_alias[0] = 0
            e.locals[i].shadow_depth = 0
        }
        i += 1
    }
    e.local_count = saved
    e.depth -= 1
}

#program_export "zir_emit_drop_locals"
DropLocals :: (e: *Emitter, first: s32) {
    i := e.local_count - 1
    while i >= first {
        local := *e.locals[i]
        alias := *local.drop_alias[0]
        if alias[0] == 0 {
            if CEmitterTypeContainsVec(e.module, *local.type[0], 0) != 0 {
                binding: [IR.ZIR_NAME_MAX]u8
                CTargetBindingName(e.fn, e.target, *local.name[0], *binding[0], IR.ZIR_NAME_MAX)
                DropOwnedValue(e, *binding[0], *local.type[0], e.module, 0)
            }
        } else {
            value: [IR.ZIR_NAME_MAX + 4]u8
            CheckFormat(snprintf(*value[0], IR.ZIR_NAME_MAX + 4, CStr("(*%s)"), alias), IR.ZIR_NAME_MAX + 4)
            DropOwnedValue(e, *value[0], *local.type[0], e.module, 0)
        }
        i -= 1
    }
}

#program_export "zir_emit_drop_temporary_vec"
DropTemporaryVec :: (e: *Emitter, name: *u8, type: *u8) {
    DropOwnedValue(e, name, type, e.module, 0)
}

#program_export "zir_emit_has_owned_locals"
HasOwnedLocals :: (e: *Emitter) -> s32 {
    for i: cast(s32)0..e.local_count - 1 {
        if e.locals[i].drop_alias[0] != 0 || CEmitterTypeContainsVec(e.module, *e.locals[i].type[0], 0) != 0 {
            return 1
        }
    }
    return 0
}

#program_export "zir_emit_operation"
Operation :: (op: *u8) -> s32 {
    s := IR.CText(op)
    if s == "+" { return 1 }
    if s == "-" { return 2 }
    if s == "*" { return 3 }
    if s == "/" { return 4 }
    if s == "%" { return 5 }
    if s == "<<" { return 6 }
    if s == ">>" { return 7 }
    if s == "&" { return 8 }
    if s == "|" { return 9 }
    if s == "^" { return 10 }
    return 0
}

#scope_file

GoBitsOperand :: (value: *u8, sign: s32, out: *u8, size: usize) {
    if strcmp(value, CStr("^uint64(0)")) == 0 {
        copy_text(out, size, value)
        return
    }
    if value[0] == #char "-" && IsDigit(value[1]) {
        end: *u8 = null
        signed_value: s64 = 0
        if ParseNegS64Base0(value, *end, *signed_value) && end[0] == 0 {
            CheckFormat(snprintf(out, size, CStr("uint64(%llu)"), cast(u64)signed_value), size)
            return
        }
    }
    if sign != 0 {
        CheckFormat(snprintf(out, size, CStr("signedBits(int64(%s))"), value), size)
    } else {
        CheckFormat(snprintf(out, size, CStr("uint64(%s)"), value), size)
    }
}

#scope_export

#program_export "zir_emit_integer_literal_bits"
IntegerLiteralBits :: (text: *u8, bits: *u64) -> s32 {
    p := text
    negative := false
    while p[0] == #char "(" { p = PtrAdd(p, 1) }
    if p[0] == #char "-" { negative = true; p = PtrAdd(p, 1) }
    if !IsDigit(p[0]) { return 0 }
    end: *u8 = null
    value: u64 = 0
    if !ParseU64Base0(p, *end, *value) { return 0 }
    while end[0] == #char "u" || end[0] == #char "U" || end[0] == #char "l" || end[0] == #char "L" {
        end = PtrAdd(end, 1)
    }
    while end[0] == #char ")" { end = PtrAdd(end, 1) }
    if end[0] != 0 { return 0 }
    <<bits = ifx negative then cast(u64)0 - value else value
    return 1
}

#scope_file

FoldNumber :: (a_in: u64, b_in: u64, w: s32, sign: s32, op: s32, result: *u64) -> bool {
    mask := ifx w == 64 then UINT64_MAX_VAL() else (cast(u64)1 << cast(u64)w) - 1
    a := a_in & mask
    b := b_in & mask
    sa := ifx sign != 0 && w < 64 && (a >> cast(u64)(w - 1)) != 0 then cast(s64)(a | ~mask) else cast(s64)a
    sb := ifx sign != 0 && w < 64 && (b >> cast(u64)(w - 1)) != 0 then cast(s64)(b | ~mask) else cast(s64)b
    if op == 1 { <<result = (a + b) & mask; return true }
    if op == 2 { <<result = (a - b) & mask; return true }
    if op == 3 { <<result = (a * b) & mask; return true }
    if op == 4 || op == 5 {
        if b == 0 { return false }
        if sign != 0 {
            if sa == INT64_MIN_VAL() && sb == -1 {
                <<result = ifx op == 4 then a else cast(u64)0
                return true
            }
            if w < 64 && sa == -cast(s64)(mask >> 1) - 1 && sb == -1 {
                <<result = ifx op == 4 then a else cast(u64)0
                return true
            }
            q := ifx op == 4 then sa / sb else sa % sb
            <<result = cast(u64)q & mask
        } else {
            <<result = ifx op == 4 then a / b else a % b
        }
        return true
    }
    if op == 6 || op == 7 {
        if b >= cast(u64)w { return false }
        if op == 6 {
            <<result = (a << b) & mask
        } else if sign != 0 && (a >> cast(u64)(w - 1)) != 0 {
            <<result = ((a >> b) | (mask ^ (mask >> b))) & mask
        } else {
            <<result = a >> b
        }
        return true
    }
    if op == 8 { <<result = a & b; return true }
    if op == 9 { <<result = a | b; return true }
    if op == 10 { <<result = a ^ b; return true }
    return false
}

NumberLiteral :: (e: *Emitter, type: *u8, bits_in: u64, out: *u8, size: usize) {
    w := CWidth(type)
    sign := CSignedType(type)
    mask := ifx w == 64 then UINT64_MAX_VAL() else (cast(u64)1 << cast(u64)w) - 1
    bits := bits_in & mask
    if sign != 0 && (bits >> cast(u64)(w - 1)) != 0 {
        value := ifx w == 64 then cast(s64)bits else cast(s64)(bits | ~mask)
        if value == INT64_MIN_VAL() {
            fmt := ifx e.target == .ZIR_GO then CStr("(-9223372036854775807 - 1)") else CStr("(-9223372036854775807LL - 1)")
            CheckFormat(snprintf(out, size, CStr("%s"), fmt), size)
        } else {
            fmt := ifx e.target == .ZIR_GO || w < 64 then CStr("(%lld)") else CStr("(%lldLL)")
            CheckFormat(snprintf(out, size, fmt, value), size)
        }
    } else if sign != 0 {
        fmt := ifx e.target == .ZIR_GO || w < 64 then CStr("%llu") else CStr("%lluLL")
        CheckFormat(snprintf(out, size, fmt, bits), size)
    } else {
        fmt := ifx e.target == .ZIR_GO || w < 64 then CStr("%llu") else CStr("%lluULL")
        CheckFormat(snprintf(out, size, fmt, bits), size)
    }
}

AllOnesOperand :: (text: *u8) -> bool {
    return strcmp(text, CStr("^uint64(0)")) == 0 || strcmp(text, CStr("UINT64_MAX")) == 0
}

#scope_export

#program_export "zir_emit_enclosed"
Enclosed :: (text: *u8) -> s32 {
    depth: s32 = 0
    length := strlen(text)
    if length < 2 || text[0] != #char "(" || text[length - 1] != #char ")" { return 0 }
    i: usize = 0
    while i < length {
        if text[i] == #char "(" { depth += 1 }
        else if text[i] == #char ")" {
            depth -= 1
            if depth == 0 && i + 1 < length { return 0 }
        }
        i += 1
    }
    return ifx depth == 0 then 1 else 0
}

#program_export "zir_emit_bare"
Bare :: (text: *u8, out: *u8, size: usize) -> *u8 {
    copy_text(out, size, text)
    if Enclosed(out) != 0 {
        memmove(cast(*void)out, cast(*void)PtrAdd(out, 1), strlen(out))
        out[strlen(out) - 1] = 0
    }
    return out
}

#scope_file

SameNumberType :: (operand: *u8, type: *u8) -> bool {
    return operand == null || strcmp(operand, CStr("integer")) == 0 || strcmp(CCanonical(operand), type) == 0
}

CWideOperand :: (text: *u8, optype: *u8, type: *u8, native: *u8, wide: *u8, out: *u8, size: usize) {
    bits: u64 = 0
    w := CWidth(type)
    if IntegerLiteralBits(text, *bits) != 0 && text[0] != #char "-" && text[1] != #char "-" {
        if w == 64 { CheckFormat(snprintf(out, size, CStr("UINT64_C(%llu)"), bits), size) }
        else { CheckFormat(snprintf(out, size, CStr("%lluu"), bits & 0xffffffff), size) }
        return
    }
    inner := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    defer { free(cast(*void)inner) }
    copy_text(inner, IR.ZIR_TEXT_MAX, text)
    while Enclosed(inner) != 0 {
        memmove(cast(*void)inner, cast(*void)PtrAdd(inner, 1), strlen(inner))
        inner[strlen(inner) - 1] = 0
    }
    nlen := strlen(native)
    prefix := nlen + 2
    if inner[0] == #char "(" && strncmp(PtrAdd(inner, 1), native, nlen) == 0 &&
       inner[prefix - 1] == #char ")" && Enclosed(PtrAdd(inner, prefix)) != 0 {
        group := PtrAdd(inner, prefix)
        wide_length := strlen(wide)
        if group[1] == #char "(" && strncmp(PtrAdd(group, 2), wide, wide_length) == 0 &&
           group[2 + wide_length] == #char ")" {
            copy_text(out, size, group)
        } else {
            CheckFormat(snprintf(out, size, CStr("(%s)%s"), wide, group), size)
        }
        return
    }
    if PlainIdentifier(text) != 0 {
        CheckFormat(snprintf(out, size, CStr("(%s)%s"), wide, text), size)
    } else {
        CheckFormat(snprintf(out, size, CStr("(%s)(%s)"), wide, text), size)
    }
}

#scope_export

#program_export "zir_emit_number"
Number :: (e: *Emitter, type: *u8, a: *u8, a_type: *u8, b: *u8, b_type: *u8, op: s32, out: *u8, size: usize) {
    bits_buf := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    left_buf := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    right_buf := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    defer { free(cast(*void)bits_buf); free(cast(*void)left_buf); free(cast(*void)right_buf) }
    w := CWidth(type)
    sign := CSignedType(type)
    left_bits: u64 = 0
    right_bits: u64 = 0
    folded: u64 = 0
    left_literal := IntegerLiteralBits(a, *left_bits) != 0
    right_literal := false
    if AllOnesOperand(b) {
        right_bits = UINT64_MAX_VAL()
        right_literal = true
    } else {
        right_literal = IntegerLiteralBits(b, *right_bits) != 0
    }
    native := cast(*u8)Native.TargetType(cast(*void)type, e.target)
    float_helper := ifx e.target == .ZIR_GO then CStr("floatToInt(") else CStr("FloatToInt(")
    if op == 0 && native != null && strncmp(a, float_helper, strlen(float_helper)) != 0 {
        if left_literal { NumberLiteral(e, type, left_bits, out, size) }
        else if a_type != null && strcmp(CCanonical(a_type), type) == 0 { copy_text(out, size, a) }
        else if e.target == .ZIR_GO { CheckFormat(snprintf(out, size, CStr("%s(%s)"), native, a), size) }
        else { CheckFormat(snprintf(out, size, CStr("(%s)(%s)"), native, a), size) }
        return
    }
    if op >= 1 && left_literal && right_literal && FoldNumber(left_bits, right_bits, w, sign, op, *folded) {
        NumberLiteral(e, type, folded, out, size)
        return
    }
    if native != null && ((op >= 1 && op <= 3) || (op >= 8 && op <= 10)) {
        sym := CStr("")
        if op == 1 { sym = CStr("+") }
        else if op == 2 { sym = CStr("-") }
        else if op == 3 { sym = CStr("*") }
        else if op == 8 { sym = CStr("&") }
        else if op == 9 { sym = CStr("|") }
        else if op == 10 { sym = CStr("^") }
        if e.target == .ZIR_GO {
            if op == 10 && AllOnesOperand(b) {
                if SameNumberType(a_type, type) && !left_literal {
                    CheckFormat(snprintf(out, size, CStr("^%s"), a), size)
                } else {
                    CheckFormat(snprintf(out, size, CStr("^%s(%s)"), native, a), size)
                }
                return
            }
            if left_literal { NumberLiteral(e, type, left_bits, left_buf, IR.ZIR_TEXT_MAX) }
            else if SameNumberType(a_type, type) { copy_text(left_buf, IR.ZIR_TEXT_MAX, a) }
            else { CheckFormat(snprintf(left_buf, IR.ZIR_TEXT_MAX, CStr("%s(%s)"), native, a), IR.ZIR_TEXT_MAX) }
            if right_literal { NumberLiteral(e, type, right_bits, right_buf, IR.ZIR_TEXT_MAX) }
            else if SameNumberType(b_type, type) { copy_text(right_buf, IR.ZIR_TEXT_MAX, b) }
            else { CheckFormat(snprintf(right_buf, IR.ZIR_TEXT_MAX, CStr("%s(%s)"), native, b), IR.ZIR_TEXT_MAX) }
            if left_literal && right_literal {
                CheckFormat(snprintf(left_buf, IR.ZIR_TEXT_MAX, CStr("%s(%s)"), native, a), IR.ZIR_TEXT_MAX)
            }
            CheckFormat(snprintf(out, size, CStr("%s %s %s"), left_buf, sym, right_buf), size)
            return
        }
        wide := ifx w == 64 then CStr("uint64_t") else CStr("uint32_t")
        CWideOperand(a, a_type, type, native, wide, left_buf, IR.ZIR_TEXT_MAX)
        if op == 10 && AllOnesOperand(b) {
            CheckFormat(snprintf(out, size, CStr("(%s)~%s"), native, left_buf), size)
            return
        }
        CWideOperand(b, b_type, type, native, wide, right_buf, IR.ZIR_TEXT_MAX)
        CheckFormat(snprintf(out, size, CStr("(%s)(%s %s %s)"), native, left_buf, sym, right_buf), size)
        return
    }
    if native != null && op >= 4 && op <= 7 {
        mask := ifx w == 64 then UINT64_MAX_VAL() else (cast(u64)1 << cast(u64)w) - 1
        divisor := right_bits & mask
        plain := false
        if op <= 5 {
            plain = e.target == .ZIR_GO || (right_literal && divisor != 0 && !(sign != 0 && divisor == mask))
        } else {
            plain = right_literal && right_bits < cast(u64)w && (e.target == .ZIR_GO || op == 6 || sign == 0)
        }
        if plain {
            sym := ifx op == 4 then CStr("/") else (ifx op == 5 then CStr("%") else (ifx op == 6 then CStr("<<") else CStr(">>")))
            if op >= 6 {
                CheckFormat(snprintf(right_buf, IR.ZIR_TEXT_MAX, CStr("%llu"), right_bits), IR.ZIR_TEXT_MAX)
            } else if right_literal {
                NumberLiteral(e, type, right_bits, right_buf, IR.ZIR_TEXT_MAX)
            } else if SameNumberType(b_type, type) {
                copy_text(right_buf, IR.ZIR_TEXT_MAX, b)
            } else {
                CheckFormat(snprintf(right_buf, IR.ZIR_TEXT_MAX, CStr("%s(%s)"), native, b), IR.ZIR_TEXT_MAX)
            }
            if e.target == .ZIR_GO {
                if left_literal { CheckFormat(snprintf(left_buf, IR.ZIR_TEXT_MAX, CStr("%s(%s)"), native, a), IR.ZIR_TEXT_MAX) }
                else if SameNumberType(a_type, type) { copy_text(left_buf, IR.ZIR_TEXT_MAX, a) }
                else { CheckFormat(snprintf(left_buf, IR.ZIR_TEXT_MAX, CStr("%s(%s)"), native, a), IR.ZIR_TEXT_MAX) }
                CheckFormat(snprintf(out, size, CStr("%s %s %s"), left_buf, sym, right_buf), size)
            } else if op == 6 {
                CWideOperand(a, a_type, type, native, ifx w == 64 then CStr("uint64_t") else CStr("uint32_t"), left_buf, IR.ZIR_TEXT_MAX)
                CheckFormat(snprintf(out, size, CStr("(%s)(%s << %s)"), native, left_buf, right_buf), size)
            } else {
                if left_literal { NumberLiteral(e, type, left_bits, left_buf, IR.ZIR_TEXT_MAX) }
                else if SameNumberType(a_type, type) { copy_text(left_buf, IR.ZIR_TEXT_MAX, a) }
                else { CheckFormat(snprintf(left_buf, IR.ZIR_TEXT_MAX, CStr("(%s)(%s)"), native, a), IR.ZIR_TEXT_MAX) }
                if w >= 32 && (left_literal || SameNumberType(a_type, type)) &&
                   (right_literal || SameNumberType(b_type, type)) {
                    CheckFormat(snprintf(out, size, CStr("%s %s %s"), left_buf, sym, right_buf), size)
                } else {
                    CheckFormat(snprintf(out, size, CStr("(%s)(%s %s %s)"), native, left_buf, sym, right_buf), size)
                }
            }
            return
        }
        if e.target == .ZIR_GO && op >= 6 && !right_literal {
            if left_literal || !SameNumberType(a_type, type) {
                CheckFormat(snprintf(left_buf, IR.ZIR_TEXT_MAX, CStr("%s(%s)"), native, a), IR.ZIR_TEXT_MAX)
            } else {
                copy_text(left_buf, IR.ZIR_TEXT_MAX, a)
            }
            CheckFormat(snprintf(out, size, CStr("%s %s shiftCount(uint64(%s), %d)"),
                                 left_buf, ifx op == 6 then CStr("<<") else CStr(">>"), b, w), size)
            return
        }
    }
    if e.target == .ZIR_C && native != null && op >= 4 && op <= 7 {
        bits_str := ifx w == 64 then CStr("64") else CStr("32")
        if left_literal { NumberLiteral(e, type, left_bits, left_buf, IR.ZIR_TEXT_MAX) }
        else if SameNumberType(a_type, type) { copy_text(left_buf, IR.ZIR_TEXT_MAX, a) }
        else { CheckFormat(snprintf(left_buf, IR.ZIR_TEXT_MAX, CStr("(%s)(%s)"), native, a), IR.ZIR_TEXT_MAX) }
        if op >= 6 {
            CheckFormat(snprintf(right_buf, IR.ZIR_TEXT_MAX, CStr("(uint64_t)(%s)"), b), IR.ZIR_TEXT_MAX)
        } else if right_literal {
            NumberLiteral(e, type, right_bits, right_buf, IR.ZIR_TEXT_MAX)
        } else if SameNumberType(b_type, type) {
            copy_text(right_buf, IR.ZIR_TEXT_MAX, b)
        } else {
            CheckFormat(snprintf(right_buf, IR.ZIR_TEXT_MAX, CStr("(%s)(%s)"), native, b), IR.ZIR_TEXT_MAX)
        }
        if op == 4 && sign != 0 {
            CheckFormat(snprintf(bits_buf, IR.ZIR_TEXT_MAX, CStr("ZiDivS%s(%s, %s, INT%d_MIN)"),
                                 bits_str, left_buf, right_buf, w), IR.ZIR_TEXT_MAX)
        } else if op <= 5 {
            CheckFormat(snprintf(bits_buf, IR.ZIR_TEXT_MAX, CStr("Zi%s%s%s(%s, %s)"),
                                 ifx op == 4 then CStr("Div") else CStr("Rem"),
                                 ifx sign != 0 then CStr("S") else CStr("U"),
                                 bits_str, left_buf, right_buf), IR.ZIR_TEXT_MAX)
        } else {
            CheckFormat(snprintf(bits_buf, IR.ZIR_TEXT_MAX, CStr("Zi%s%s(%s, %s, %d)"),
                                 ifx op == 6 then CStr("Shl") else (ifx sign != 0 then CStr("ShrS") else CStr("ShrU")),
                                 bits_str, left_buf, right_buf, w), IR.ZIR_TEXT_MAX)
        }
        if w >= 32 && !(op == 6 && sign != 0) {
            CheckFormat(snprintf(out, size, CStr("%s"), bits_buf), size)
        } else {
            CheckFormat(snprintf(out, size, CStr("(%s)%s"), native, bits_buf), size)
        }
        return
    }
    if e.target == .ZIR_GO {
        GoBitsOperand(a, sign, left_buf, IR.ZIR_TEXT_MAX)
        GoBitsOperand(b, sign, right_buf, IR.ZIR_TEXT_MAX)
        if op >= 1 && op <= 3 {
            name := ifx op == 1 then CStr("wrapAdd") else (ifx op == 2 then CStr("wrapSub") else CStr("wrapMul"))
            CheckFormat(snprintf(bits_buf, IR.ZIR_TEXT_MAX, CStr("%s(%s, %s)"), name, left_buf, right_buf), IR.ZIR_TEXT_MAX)
        } else {
            CheckFormat(snprintf(bits_buf, IR.ZIR_TEXT_MAX, CStr("integerOp(%s, %s, %d, %s, %d)"),
                                 left_buf, right_buf, w, ifx sign != 0 then CStr("true") else CStr("false"), op), IR.ZIR_TEXT_MAX)
        }
        CheckFormat(snprintf(out, size, CStr("%s(%s)"), cast(*u8)Native.TargetType(cast(*void)type, e.target), bits_buf), size)
    } else {
        CheckFormat(snprintf(bits_buf, IR.ZIR_TEXT_MAX, CStr("IntegerOp((uint64_t)(%s), (uint64_t)(%s), %d, %d, %d)"),
                             a, b, w, sign, op), IR.ZIR_TEXT_MAX)
        tname := cast(*u8)Native.TargetType(cast(*void)type, e.target)
        if sign != 0 { CheckFormat(snprintf(out, size, CStr("(%s)SignedBits(%s, %d)"), tname, bits_buf, w), size) }
        else { CheckFormat(snprintf(out, size, CStr("(%s)(%s)"), tname, bits_buf), size) }
    }
}

#program_export "zir_emit_postfix_base"
PostfixBase :: (text: *u8, out: *u8, size: usize) {
    c := text[0]
    prefix := c == #char "*" || c == #char "&" || c == #char "-" ||
              c == #char "!" || c == #char "~" || (c == #char "(" && Enclosed(text) == 0)
    if prefix {
        CheckFormat(snprintf(out, size, CStr("(%s)"), text), size)
    } else {
        copy_text(out, size, text)
    }
}

#program_export "zir_emit_slice_index"
SliceIndex :: (e: *Emitter, type: *u8, base: *u8, index: *u8, checked: s32, out: *u8, size: usize) {
    if e.target == .ZIR_GO {
        CheckFormat(snprintf(out, size, CStr("%s[%s]"), base, index), size)
        return
    }
    element: [IR.ZIR_NAME_MAX]u8
    mapped: [IR.ZIR_NAME_MAX]u8
    SliceElementType(type, *element[0], IR.ZIR_NAME_MAX)
    pointee := *element[0]
    depth: usize = 0
    while pointee[depth] == #char "*" { depth += 1 }
    pointee = PtrAdd(pointee, depth)
    scalar := cast(*u8)Native.TargetType(cast(*void)pointee, e.target)
    if scalar != null { copy_text(*mapped[0], IR.ZIR_NAME_MAX, scalar) }
    else { e.resolve(e.context, pointee, *mapped[0], IR.ZIR_NAME_MAX) }
    used := strlen(*mapped[0])
    while depth > 0 && used + 1 < IR.ZIR_NAME_MAX {
        mapped[used] = #char "*"
        used += 1
        depth -= 1
    }
    mapped[used] = 0
    if checked != 0 {
        CheckFormat(snprintf(out, size, CStr("((%s *)%s.data)[SliceIndex(%s, (int64_t)%s)]"), *mapped[0], base, base, index), size)
    } else {
        CheckFormat(snprintf(out, size, CStr("((%s *)%s.data)[%s]"), *mapped[0], base, index), size)
    }
}

#program_export "zir_emit_go_pointer_index"
GoPointerIndex :: (e: *Emitter, base: *u8, index: *u8, out: *u8, size: usize) {
    temporary: [IR.ZIR_NAME_MAX]u8
    Fresh(e, *temporary[0])
    EmitIndent(e)
    fprintf(e.out, CStr("%s := %s\n"), *temporary[0], index)
    CheckFormat(snprintf(out, size, CStr("unsafe.Slice(%s, int(%s)+1)[%s]"), base, *temporary[0], *temporary[0]), size)
    e.pure = 0
}

#program_export "zir_emit_emit_destination"
EmitDestination :: (e: *Emitter, index: s32, out: *u8, size: usize) {
    pointer := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    base_buf := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    wrapped := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX + 2)
    idx_buf := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    defer {
        free(cast(*void)pointer)
        free(cast(*void)base_buf)
        free(cast(*void)wrapped)
        free(cast(*void)idx_buf)
    }
    expr := *e.fn.exprs[index]
    if expr.kind == .UNARY && strcmp(*expr.op[0], CStr("*")) == 0 {
        emit_expr(e, expr.right, e.fn.exprs[expr.right].type, pointer, IR.ZIR_TEXT_MAX)
        CheckFormat(snprintf(out, size, CStr("(*(%s))"), pointer), size)
        return
    }
    if expr.kind == .IDENT {
        Resolve(e, expr.name, out, size)
        e.pure = 1
        return
    }
    if expr.kind == .MEMBER || expr.kind == .POINTER_MEMBER {
        if expr.kind == .POINTER_MEMBER && member_path(e.fn, expr.left) == 0 {
            emit_expr(e, expr.left, e.fn.exprs[expr.left].type, base_buf, IR.ZIR_TEXT_MAX)
        } else {
            EmitDestination(e, expr.left, base_buf, IR.ZIR_TEXT_MAX)
        }
        CEmitFieldPath(e.module, e.target, e.fn.exprs[expr.left].type, expr.name, 0, base_buf, out, size)
        e.pure = 1
        return
    }
    if expr.kind == .INDEX {
        left_type := e.fn.exprs[expr.left].type
        vector := VecElementType(e.module, left_type, null, 0)
        if strcmp(left_type, CStr("string")) == 0 { Fatal(expr, CStr("string bytes are read-only")) }
        if SliceElementType(left_type, null, 0) != 0 {
            emit_expr(e, expr.left, left_type, base_buf, IR.ZIR_TEXT_MAX)
        } else {
            EmitDestination(e, expr.left, base_buf, IR.ZIR_TEXT_MAX)
        }
        base_pure := e.pure
        emit_expr(e, expr.right, CStr("s32"), idx_buf, IR.ZIR_TEXT_MAX)
        e.pure = ifx base_pure != 0 && e.pure != 0 then 1 else 0
        if SliceElementType(left_type, null, 0) != 0 {
            below := Range.IndexBelowCount(e.ranges, e.fn, e.module, e.target == .ZIR_C, expr.right, expr.left)
            SliceIndex(e, left_type, base_buf, idx_buf, ifx !below then 1 else 0, out, size)
        } else if e.target == .ZIR_GO && left_type[0] == #char "*" {
            GoPointerIndex(e, base_buf, idx_buf, out, size)
        } else if vector != 0 && e.target == .ZIR_C {
            CheckFormat(snprintf(out, size, CStr("ZIRAN_VEC_INDEX((%s).data, (%s).count, %s)"), base_buf, base_buf, idx_buf), size)
        } else if vector != 0 {
            CheckFormat(snprintf(out, size, CStr("(%s).Data[%s]"), base_buf, idx_buf), size)
        } else {
            PostfixBase(base_buf, wrapped, IR.ZIR_TEXT_MAX + 2)
            capacity: s32 = 0
            if e.target == .ZIR_C &&
               ArrayElementType(left_type, null, 0, *capacity) != 0 &&
               capacity > 0 &&
               Range.IndexInRange(e.ranges, e.fn, e.module, true, expr.right, cast(s64)capacity) {
                CheckFormat(snprintf(out, size, CStr("%s[%s]"), wrapped, idx_buf), size)
            } else if e.target == .ZIR_C && Range.ChecksAt(e.module, e.fn, expr.right) &&
                      ArrayElementType(left_type, null, 0, null) != 0 {
                CheckFormat(snprintf(out, size, CStr("ZIRAN_INDEX(%s, sizeof(%s) / sizeof(%s[0]), %s)"),
                                     wrapped, wrapped, wrapped, idx_buf), size)
            } else {
                CheckFormat(snprintf(out, size, CStr("%s[%s]"), wrapped, idx_buf), size)
            }
        }
        return
    }
    Fatal(expr, CStr("unsupported assignment destination"))
}

#program_export "zir_emit_capture_destination"
CaptureDestination :: (e: *Emitter, index: s32, out: *u8, size: usize) {
    place := *e.fn.exprs[index]
    temporary: [IR.ZIR_NAME_MAX]u8
    native: [IR.ZIR_NAME_MAX * 2]u8
    EmitDestination(e, index, out, size)
    if place.kind == .IDENT { return }
    Fresh(e, *temporary[0])
    EmitIndent(e)
    if e.target == .ZIR_GO {
        fprintf(e.out, CStr("%s := &(%s)\n"), *temporary[0], out)
    } else if ArrayElementType(place.type, null, 0, null) != 0 {
        element: [IR.ZIR_NAME_MAX * 2]u8
        bounds: [IR.ZIR_NAME_MAX * 2]u8
        ArrayTargetType(e, place.type, *element[0], IR.ZIR_NAME_MAX * 2, *bounds[0], IR.ZIR_NAME_MAX * 2)
        ext := ifx CTypeHasZeroArray(e.module, place.type) != 0 then CStr("__extension__ ") else CStr("")
        fprintf(e.out, CStr("%s%s (*%s)%s = &(%s);\n"), ext, *element[0], *temporary[0], *bounds[0], out)
    } else {
        field: IR.ZirTypeField
        spelled := (place.kind == .MEMBER || place.kind == .POINTER_MEMBER) &&
                   CSpelledPointerField(CFieldRecord(e.module, e.fn.exprs[place.left].type, null), place.name, *field) != 0
        target := cast(*u8)Native.TargetType(cast(*void)place.type, .ZIR_C)
        if spelled { copy_text(*native[0], IR.ZIR_NAME_MAX * 2, *field.c_type[0]) }
        else if target != null { copy_text(*native[0], IR.ZIR_NAME_MAX * 2, target) }
        else { CSlotTypeAtUse(place.type, .ZIR_C, CEmit.ResolveTypeAtUse, cast(*void)e.module, *native[0], IR.ZIR_NAME_MAX * 2) }
        fprintf(e.out, CStr("%s* %s = &(%s);\n"), *native[0], *temporary[0], out)
    }
    CheckFormat(snprintf(out, size, CStr("(*%s)"), *temporary[0]), size)
    e.pure = 0
}

#program_export "zir_emit_literal"
Literal :: (e: *Emitter, expr: *IR.ZirExpr, type: *u8, neg_in: s32, out: *u8, size: usize) {
    raw := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    defer { free(cast(*void)raw) }
    length: usize = 0
    value: u64 = 0
    negative := neg_in != 0
    p := expr.text
    while p[0] != 0 {
        if p[0] != #char "_" { raw[length] = p[0]; length += 1 }
        p = PtrAdd(p, 1)
    }
    raw[length] = 0
    if raw[0] == #char "-" {
        negative = !negative
        memmove(cast(*void)raw, cast(*void)PtrAdd(raw, 1), length)
    }
    end := PtrAdd(raw, strlen(raw))
    while cast(usize)end > cast(usize)raw && strchr(CStr("uUlL"), cast(s32)PtrSub(end, 1)[0]) != null {
        end = PtrSub(end, 1)
    }
    if end[0] != 0 && strcmp(end, CStr("u")) != 0 && strcmp(end, CStr("U")) != 0 &&
       strcmp(end, CStr("l")) != 0 && strcmp(end, CStr("L")) != 0 &&
       strcmp(end, CStr("ll")) != 0 && strcmp(end, CStr("LL")) != 0 &&
       strcmp(end, CStr("ull")) != 0 && strcmp(end, CStr("ULL")) != 0 {
        Fatal(expr, CStr("invalid integer literal"))
    }
    suffix := end[0]
    end[0] = 0
    if ZirIntegerLiteral(raw, *value) == 0 { Fatal(expr, CStr("integer literal is out of range")) }
    end[0] = suffix
    w := CWidth(type)
    if w != 0 {
        max := ifx w == 64 then UINT64_MAX_VAL() else (cast(u64)1 << cast(u64)w) - 1
        if CSignedType(type) != 0 { max = (max >> 1) + (ifx negative then cast(u64)1 else cast(u64)0) }
        if value > max || (negative && CSignedType(type) == 0 && value != 0) {
            Fatal(expr, CStr("integer literal does not fit its type"))
        }
    }
    neg_str := ifx negative then CStr("-") else CStr("")
    if e.target == .ZIR_GO {
        CheckFormat(snprintf(out, size, CStr("%s%llu"), neg_str, value), size)
    } else if negative && value == (cast(u64)1 << 63) {
        CheckFormat(snprintf(out, size, CStr("(-INT64_C(9223372036854775807)-1)")), size)
    } else {
        suf := ifx w > 32 then (ifx CSignedType(type) != 0 then CStr("LL") else CStr("ULL")) else CStr("")
        CheckFormat(snprintf(out, size, CStr("%s%llu%s"), neg_str, value, suf), size)
    }
}

#program_export
EmitStringLiteral :: (expr: *IR.ZirExpr, target: Native.ZirTarget, out: *u8, size: usize) {
    used: usize = 0
    remaining: s32 = 0
    scalar: u32 = 0
    minimum: u32 = 0
    out[used] = #char "\""; used += 1
    cursor := PtrAdd(expr.text, 1)
    escapes := CStr("0abfnrtv\\\"")
    escape_vals: [10]u8 = .{0, 7, 8, 12, 10, 13, 9, 11, #char "\\", #char "\""}
    while cursor[0] != 0 && cursor[0] != #char "\"" {
        value: u32 = cast(u32)cursor[0]
        cursor = PtrAdd(cursor, 1)
        unicode_escape := false
        if value == #char "\\" {
            value = cast(u32)cursor[0]
            cursor = PtrAdd(cursor, 1)
            found := ifx value != 0 then strchr(escapes, cast(s32)value) else null
            if found != null {
                value = cast(u32)escape_vals[cast(usize)found - cast(usize)escapes]
            } else if value == #char "x" || value == #char "u" || value == #char "U" {
                unicode_escape = value != #char "x"
                digits := ifx value == #char "x" then cast(s32)2 else (ifx value == #char "u" then cast(s32)4 else cast(s32)8)
                value = 0
                for idx: cast(s32)0..digits - 1 {
                    digit := cast(s32)cursor[0]
                    cursor = PtrAdd(cursor, 1)
                    if digit >= #char "0" && digit <= #char "9" { digit -= #char "0" }
                    else if digit >= #char "a" && digit <= #char "f" { digit -= #char "a" - 10 }
                    else if digit >= #char "A" && digit <= #char "F" { digit -= #char "A" - 10 }
                    else { Fatal(expr, CStr("invalid string escape")) }
                    value = value * 16 + cast(u32)digit
                }
                if value > 0x10ffff || (value >= 0xd800 && value <= 0xdfff) {
                    Fatal(expr, CStr("string escape is not a Unicode scalar value"))
                }
            } else {
                Fatal(expr, CStr("unknown string escape"))
            }
        }
        bytes: [4]u8
        count: s32 = 1
        bytes[0] = cast(u8)(value & 0xff)
        if unicode_escape && value >= 128 {
            if value < 0x800 {
                bytes[0] = cast(u8)(0xc0 | (value >> 6))
                bytes[1] = cast(u8)(0x80 | (value & 63))
                count = 2
            } else if value < 0x10000 {
                bytes[0] = cast(u8)(0xe0 | (value >> 12))
                bytes[1] = cast(u8)(0x80 | ((value >> 6) & 63))
                bytes[2] = cast(u8)(0x80 | (value & 63))
                count = 3
            } else {
                bytes[0] = cast(u8)(0xf0 | (value >> 18))
                bytes[1] = cast(u8)(0x80 | ((value >> 12) & 63))
                bytes[2] = cast(u8)(0x80 | ((value >> 6) & 63))
                bytes[3] = cast(u8)(0x80 | (value & 63))
                count = 4
            }
        }
        for idx: cast(s32)0..count - 1 {
            byte := bytes[idx]
            if remaining != 0 {
                if (byte & 0xc0) != 0x80 { Fatal(expr, CStr("string is not valid UTF-8")) }
                scalar = (scalar << 6) | cast(u32)(byte & 63)
                remaining -= 1
                if remaining == 0 && (scalar < minimum || scalar > 0x10ffff || (scalar >= 0xd800 && scalar <= 0xdfff)) {
                    Fatal(expr, CStr("string is not valid UTF-8"))
                }
            } else if byte >= 128 {
                if byte >= 0xc2 && byte <= 0xdf {
                    remaining = 1; scalar = cast(u32)(byte & 31); minimum = 0x80
                } else if byte >= 0xe0 && byte <= 0xef {
                    remaining = 2; scalar = cast(u32)(byte & 15); minimum = 0x800
                } else if byte >= 0xf0 && byte <= 0xf4 {
                    remaining = 3; scalar = cast(u32)(byte & 7); minimum = 0x10000
                } else {
                    Fatal(expr, CStr("string is not valid UTF-8"))
                }
            }
            if used + 8 >= size { Fatal(expr, CStr("string literal exceeds output limit")) }
            named: *u8 = null
            if byte == #char "\n" { named = CStr("\\n") }
            else if byte == #char "\t" { named = CStr("\\t") }
            else if byte == #char "\r" { named = CStr("\\r") }
            else if byte == #char "\"" { named = CStr("\\\"") }
            else if byte == #char "\\" { named = CStr("\\\\") }
            if named != null {
                used += cast(usize)CheckFormat(snprintf(PtrAdd(out, used), size - used, CStr("%s"), named), size - used)
            } else if target == .ZIR_C && byte == #char "?" {
                used += cast(usize)CheckFormat(snprintf(PtrAdd(out, used), size - used, CStr("\\?")), size - used)
            } else if target == .ZIR_C && (byte < 32 || byte >= 127) {
                used += cast(usize)CheckFormat(snprintf(PtrAdd(out, used), size - used, CStr("\\%03o"), cast(u32)byte), size - used)
            } else if byte < 32 || byte == 127 {
                used += cast(usize)CheckFormat(snprintf(PtrAdd(out, used), size - used, CStr("\\x%02x"), cast(u32)byte), size - used)
            } else {
                out[used] = byte; used += 1
            }
        }
    }
    if cursor[0] != #char "\"" { Fatal(expr, CStr("unterminated string literal")) }
    if remaining != 0 { Fatal(expr, CStr("string is not valid UTF-8")) }
    out[used] = #char "\""; used += 1
    out[used] = 0
}

#program_export
ScalarLiteral :: (type_in: *u8, text: *u8, target: Native.ZirTarget, span: IR.ZirSourceSpan,
                  out: *u8, size: usize) -> s32 {
    fn := cast(*IR.ZirFunction)AllocateOrExit(size_of(IR.ZirFunction))
    val_buf := cast(*u8)AllocateOrExit(IR.ZIR_TEXT_MAX)
    e := cast(*Emitter)AllocateOrExit(size_of(Emitter))
    defer { free(cast(*void)fn); free(cast(*void)val_buf); free(cast(*void)e) }
    memset(cast(*void)fn, 0, size_of(IR.ZirFunction))
    memset(cast(*void)e, 0, size_of(Emitter))
    ok: s32 = 0
    type := CCanonical(type_in)
    e.target = target
    if type[0] == 0 { return 0 }
    if strcmp(type, CStr("bool")) == 0 {
        if strcmp(text, CStr("true")) == 0 || strcmp(text, CStr("false")) == 0 {
            copy_text(out, size, text)
            return 1
        }
        return 0
    }
    if strcmp(type, CStr("string")) != 0 && CWidth(type) == 0 && type[0] != #char "f" { return 0 }
    if CWidth(type) != 0 {
        digits := ifx text[0] == #char "-" then PtrAdd(text, 1) else text
        count := strspn(digits, CStr("0123456789"))
        if count != 0 && digits[count] == 0 && (digits[0] != #char "0" || count == 1) {
            value: IR.ZirExpr
            value.kind = .INT
            value.text = digits
            value.span = span
            Literal(e, *value, type, ifx digits != text then 1 else 0, out, size)
            return 1
        }
    }
    index := ParseExpr(fn, null, text, span)
    if index >= 0 {
        expr := *fn.exprs[index]
        if expr.kind == .STRING && strcmp(type, CStr("string")) == 0 {
            tlen := strlen(expr.text)
            if tlen >= IR.ZIR_TEXT_MAX / 4 {
                capacity := tlen * 4 + 16
                lit := cast(*u8)AllocateOrExit(capacity)
                bytes := cast(*u8)AllocateOrExit(tlen + 1)
                decoded: usize = 0
                EmitStringLiteral(expr, target, lit, capacity)
                DecodeStringLiteral(expr.text, bytes, tlen + 1, *decoded)
                if strlen(lit) + 32 < size {
                    if target == .ZIR_C { CheckFormat(snprintf(out, size, CStr("{%s, %zu}"), lit, decoded), size) }
                    else { copy_text(out, size, lit) }
                    ok = 1
                }
                free(cast(*void)bytes)
                free(cast(*void)lit)
            } else {
                EmitStringLiteral(expr, target, val_buf, IR.ZIR_TEXT_MAX)
                if target == .ZIR_C {
                    CheckFormat(snprintf(out, size, CStr("{%s, sizeof(%s) - 1}"), val_buf, val_buf), size)
                } else {
                    copy_text(out, size, val_buf)
                }
                ok = 1
            }
        } else if expr.kind == .INT && CWidth(type) != 0 {
            Literal(e, expr, type, 0, out, size)
            ok = 1
        } else if expr.kind == .UNARY && strcmp(*expr.op[0], CStr("-")) == 0 &&
                  fn.exprs[expr.right].kind == .INT && CWidth(type) != 0 {
            Literal(e, *fn.exprs[expr.right], type, 1, out, size)
            ok = 1
        } else if (expr.kind == .FLOAT || expr.kind == .INT) && type[0] == #char "f" {
            copy_text(out, size, text)
            n := strlen(out)
            if n != 0 && (out[n - 1] == #char "f" || out[n - 1] == #char "F") { out[n - 1] = 0 }
            ok = 1
        }
    }
    free(cast(*void)fn.exprs)
    return ok
}
