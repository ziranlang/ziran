// Keeps only the C interface an entry-linked program uses. Such a program
// has its own C main, so every file that includes one of its module headers
// is another of its generated files. The C lowering writes each header
// declaration as a marked chunk: one line holding PRUNE_MARK, the chunk
// kind, then the C names the chunk declares, separated by spaces.
//
// A declaration stays in its header when another module's source or another
// kept header chunk names it, and the module's own source takes the rest. An
// inline copy stays only for a procedure another module calls, and a header
// that keeps nothing is not written. The lowering keeps C names unique across
// a program, so matching words over-approximates safely: a false match keeps
// a declaration, and no use is ever missed.
using Vectors :: #import "vec"
using Maps :: #import "hash_map"
using Texts :: #import "text_tools"

PRUNE_MARK :: 1
PRUNE_FRAME :: 70       // F: linkage text every written header keeps
PRUNE_MODULES :: 85     // U: where the header's module includes go
PRUNE_DECLARATION :: 68 // D: kept when named elsewhere, else moved
PRUNE_ROOT :: 82        // R: named by code outside the program
PRUNE_HELPER :: 72      // H: a runtime include or macro the text uses
PRUNE_INLINE :: 73      // I: an inline copy's declaration
PRUNE_INLINE_BODY :: 74 // J: an inline copy's body
PRUNE_NAME :: 78        // N: one more name of the current chunk
PRUNE_END :: 69         // E: the header's closing text
// Where a module source takes its inline-source define, and where its
// includes and the declarations moved out of its header go.
PRUNE_SOURCE_MARK :: "\x01S\n"
PRUNE_INCLUDES_MARK :: "\x01U\n"

// One module of a closed program. The C lowering fills it, and
// PruneModuleFree releases every text it owns.
ZirCPruneModule :: struct {
    stem: *u8 #c "char *"
    guard: *u8 #c "char *"
    vector_operations: s32 // the inline section includes zir_vec.h
    header: *u8 #c "char *" // marked header text
    source: *u8 #c "char *" // marked source text; null without one
    // The modules, by index, whose headers this module's header and source
    // could see before pruning, in include order.
    header_scope: *s32 #c "int *"
    header_scope_count: s32
    source_scope: *s32 #c "int *"
    source_scope_count: s32
    // Results: the header is null when nothing in it is kept.
    final_header: *u8 #c "char *"
    final_source: *u8 #c "char *"
}

// Fills each module's final header and source. Returns false on failure.
PruneProgram :: (modules: *ZirCPruneModule, count: s32, simd: *void) -> bool {
    prune: Prune
    prune.simd = simd
    n := cast(s64)count
    all: Vec(Chunks)
    headers: Vec(string)
    sources: Vec(string)
    for m: 0..n - 1 {
        chunks: Chunks
        header := CText(modules[m].header)
        if modules[m].header != null { ParseChunks(*prune, header, *chunks) }
        if !VecPush(all, chunks) || !VecPush(headers, header) || !VecPush(sources, CText(modules[m].source)) {
            return false
        }
    }
    // A source also needs whatever the declarations its header could move
    // into it name.
    for m: 0..n - 1 {
        if modules[m].source == null { continue }
        NoteWords(*prune, sources[m], .Source, m, null)
        for i: 0..all[m].items.count - 1 {
            chunk := all[m].items[i]
            if chunk.kind == PRUNE_DECLARATION { NoteWords(*prune, headers[m][chunk.begin:chunk.end], .Source, m, null) }
        }
    }
    for m: 0..n - 1 {
        for i: 0..all[m].items.count - 1 {
            if all[m].items[i].kind == PRUNE_ROOT { KeepChunk(*prune, headers[m], *all[m].items[i]) }
        }
    }
    // Keeping a chunk can make others wanted; repeat until nothing changes.
    changed := true
    while changed {
        changed = false
        for m: 0..n - 1 {
            for i: 0..all[m].items.count - 1 {
                chunk := *all[m].items[i]
                if chunk.kept || !Declares(chunk.kind) || chunk.kind == PRUNE_ROOT || !ChunkWanted(*prune, chunk, m) {
                    continue
                }
                KeepChunk(*prune, headers[m], chunk)
                changed = true
            }
        }
    }
    for m: 0..n - 1 {
        for i: 0..all[m].items.count - 1 {
            chunk := all[m].items[i]
            if chunk.kept && Declares(chunk.kind) { all[m].written = true }
            if chunk.kept && (chunk.kind == PRUNE_INLINE || chunk.kind == PRUNE_INLINE_BODY) { all[m].inlines = true }
        }
    }
    ok := !prune.failed
    for m: 0..n - 1 {
        if !ok { break }
        if all[m].written {
            StampHeader(*prune, headers[m], *all[m])
            modules[m].final_header = ComposeHeader(*prune, modules, all[:], m, headers[m])
            ok = modules[m].final_header != null
        }
        if ok && modules[m].source != null {
            modules[m].final_source = ComposeSource(*prune, modules, all[:], m, headers[m], sources[m])
            ok = modules[m].final_source != null
        }
    }
    return ok && !prune.failed
}

PruneModuleFree :: (module: *ZirCPruneModule) {
    texts: [6]*u8 = .[module.stem, module.guard, module.header, module.source, module.final_header,
        module.final_source]
    for text: texts { Free(cast(*void)text) }
    Free(cast(*void)module.header_scope)
    Free(cast(*void)module.source_scope)
    <<module = .{}
}

// Adds each identifier TEXT names to NAMES, a C SimdNames table that keeps
// pointers into TEXT: the names a closed program's runtime headers keep
// helpers for.
PruneNoteNames :: (text: *u8, names: *void) {
    view := CText(text)
    at: s64 = 0
    while true {
        word := NextIdentifier(view, *at)
        if word.count == 0 { break }
        unused SimdNamesFind(names, CPointer(word), cast(usize)word.count, 1)
    }
}

#scope_file

// One marked chunk of a header.
Chunk :: struct {
    kind: s64
    first_name: s64 // its declared C names, in Prune.names
    name_count: s64
    named: bool     // its mark carried text after the kind
    begin: s64      // its text in the header, after its mark
    end: s64
    kept: bool      // it stays in the header
    moved: bool     // it goes to the module's source
}

Chunks :: struct {
    items: Vec(Chunk)
    top: s64      // the header text before the first mark
    written: bool // the header keeps a declaration
    inlines: bool // the header keeps an inline copy
}

// An identifier that the program's generated text names.
Word :: struct {
    source_owner: s64   // the first module whose source names it, or -1
    source_shared: bool // another module's source names it too
    header_use: bool    // a kept header chunk names it
    stamp: s64          // the text being composed names it
}

Prune :: struct {
    names: Vec(string)          // every chunk's names, views of its header
    index: HashMap(string, s64) // a word's place in words
    words: Vec(Word)
    stamp: s64
    simd: *void
    failed: bool
}

NoteKind :: enum { Source; Header; Stamp }

Declares :: (kind: s64) -> bool {
    return kind == PRUNE_DECLARATION || kind == PRUNE_ROOT || kind == PRUNE_INLINE || kind == PRUNE_INLINE_BODY
}

WordByte :: (c: u8) -> bool {
    return c >= #char "a" && c <= #char "z" || c >= #char "A" && c <= #char "Z" ||
        c >= #char "0" && c <= #char "9" || c == #char "_"
}

// The next identifier at or after AT outside comments, literals and marks,
// or empty after the last one; AT moves past it.
NextIdentifier :: (text: string, at: *s64) -> string {
    p := <<at
    end := text.count
    while p < end {
        c := text[p]
        if c == PRUNE_MARK || c == #char "/" && p + 1 < end && text[p + 1] == #char "/" {
            while p < end && text[p] != #char "\n" { p += 1 }
        } else if c == #char "/" && p + 1 < end && text[p + 1] == #char "*" {
            p += 2
            while p < end && !(text[p] == #char "*" && p + 1 < end && text[p + 1] == #char "/") { p += 1 }
            p = ifx p < end then p + 2 else end
        } else if c == #char "\"" || c == #char "'" {
            p += 1
            while p < end && text[p] != c {
                if text[p] == #char "\\" && p + 1 < end { p += 1 }
                p += 1
            }
            if p < end { p += 1 }
        } else if WordByte(c) {
            start := p
            while p < end && WordByte(text[p]) { p += 1 }
            if c >= #char "0" && c <= #char "9" { continue }
            <<at = p
            return text[start:p]
        } else {
            p += 1
        }
    }
    <<at = p
    return ""
}

// WORD's place in words, adding it when ADD is set; -1 when it is missing.
WordAt :: (prune: *Prune, word: string, add: bool) -> s64 {
    index: s64 = -1
    if HashMapGet(*prune.index, word, *index) || !add { return index }
    if !VecPush(prune.words, Word.{.source_owner = -1}) { prune.failed = true; return -1 }
    index = prune.words.count - 1
    HashMapSet(*prune.index, word, index)
    return index
}

// Whether OWN, a chunk, declares WORD.
Declared :: (prune: *Prune, own: *Chunk, word: string) -> bool {
    if own == null { return false }
    for i: own.first_name..own.first_name + own.name_count - 1 {
        if prune.names[i] == word { return true }
    }
    return false
}

// Notes each identifier TEXT names. A header chunk does not count its own
// names as a use of them.
NoteWords :: (prune: *Prune, text: string, how: NoteKind, module: s64, own: *Chunk) {
    at: s64 = 0
    while true {
        word := NextIdentifier(text, *at)
        if word.count == 0 { break }
        if Declared(prune, own, word) { continue }
        index := WordAt(prune, word, true)
        if index < 0 { return }
        entry := *prune.words[index]
        if how == .Header { entry.header_use = true }
        else if how == .Stamp { entry.stamp = prune.stamp }
        else if entry.source_owner < 0 { entry.source_owner = module }
        else if entry.source_owner != module { entry.source_shared = true }
    }
}

// Adds the space-separated names in TEXT to the chunk whose names end the list.
AddNames :: (prune: *Prune, chunk: *Chunk, text: string) {
    at: s64 = 0
    while at < text.count {
        if text[at] == #char " " { at += 1; continue }
        start := at
        while at < text.count && text[at] != #char " " { at += 1 }
        if !VecPush(prune.names, text[start:at]) { prune.failed = true; return }
        chunk.name_count += 1
    }
}

// Splits a marked header into its leading text and its chunks.
ParseChunks :: (prune: *Prune, text: string, chunks: *Chunks) {
    chunks.top = text.count
    line: s64 = 0
    while line < text.count {
        next := line
        while next < text.count && text[next] != #char "\n" { next += 1 }
        length := next - line
        if next < text.count { next += 1 }
        if text[line] == PRUNE_MARK && length >= 2 {
            kind := cast(s64)text[line + 1]
            names := text[line + 2:line + length]
            if chunks.items.count == 0 { chunks.top = line }
            if kind == PRUNE_NAME && chunks.items.count > 0 {
                last := *chunks.items[chunks.items.count - 1]
                last.named = true
                AddNames(prune, last, names)
            } else {
                if chunks.items.count > 0 { chunks.items[chunks.items.count - 1].end = line }
                chunk := Chunk.{.kind = kind, .first_name = prune.names.count, .named = names.count > 0,
                    .begin = next, .end = next}
                AddNames(prune, *chunk, names)
                if !VecPush(chunks.items, chunk) { prune.failed = true; return }
            }
        }
        line = next
    }
    if chunks.items.count > 0 { chunks.items[chunks.items.count - 1].end = text.count }
}

// Whether another module's source, or a kept header chunk, names one of
// CHUNK's declarations.
ChunkWanted :: (prune: *Prune, chunk: *Chunk, module: s64) -> bool {
    for i: chunk.first_name..chunk.first_name + chunk.name_count - 1 {
        index := WordAt(prune, prune.names[i], false)
        if index < 0 { continue }
        word := prune.words[index]
        if word.header_use || word.source_owner >= 0 && (word.source_shared || word.source_owner != module) {
            return true
        }
    }
    return false
}

// Whether the text stamped last names one of CHUNK's declarations.
ChunkStamped :: (prune: *Prune, chunk: Chunk) -> bool {
    for i: chunk.first_name..chunk.first_name + chunk.name_count - 1 {
        index := WordAt(prune, prune.names[i], false)
        if index >= 0 && prune.words[index].stamp == prune.stamp { return true }
    }
    return false
}

KeepChunk :: (prune: *Prune, header: string, chunk: *Chunk) {
    chunk.kept = true
    NoteWords(prune, header[chunk.begin:chunk.end], .Header, -1, chunk)
}

// Stamps the words the kept declarations of a header name, and keeps each
// helper those declarations use.
StampHeader :: (prune: *Prune, header: string, chunks: *Chunks) {
    prune.stamp += 1
    for i: 0..chunks.items.count - 1 {
        chunk := *chunks.items[i]
        if chunk.kept && Declares(chunk.kind) { NoteWords(prune, header[chunk.begin:chunk.end], .Stamp, -1, chunk) }
    }
    for i: 0..chunks.items.count - 1 {
        chunk := *chunks.items[i]
        if chunk.kind == PRUNE_HELPER { chunk.kept = !chunk.named || ChunkStamped(prune, <<chunk) }
    }
}

// Whether module B's written header declares a name the stamped text uses.
HeaderNeeded :: (prune: *Prune, all: []Chunks, b: s64) -> bool {
    if !all[b].written { return false }
    for i: 0..all[b].items.count - 1 {
        chunk := all[b].items[i]
        if chunk.kept && Declares(chunk.kind) && ChunkStamped(prune, chunk) { return true }
    }
    return false
}

WriteIncludes :: (out: *Vec(u8), prune: *Prune, modules: *ZirCPruneModule, all: []Chunks, self: s64,
                  scope: *s32, count: s32) -> bool {
    ok := true
    for i: 0..count - 1 {
        b := cast(s64)scope[i]
        if b != self && HeaderNeeded(prune, all, b) {
            ok = ok && BuilderAppend(<<out, "#include \"") && BuilderAppend(<<out, CText(modules[b].stem)) &&
                BuilderAppend(<<out, ".h\"\n")
        }
    }
    return ok
}

// Appends TEXT[BEGIN:END] without its mark lines.
WriteText :: (out: *Vec(u8), text: string, begin: s64, end: s64) -> bool {
    at := begin
    while at < end {
        next := at
        while next < end && text[next] != #char "\n" { next += 1 }
        if next < end { next += 1 }
        if text[at] != PRUNE_MARK && !BuilderAppend(<<out, text[at:next]) { return false }
        at = next
    }
    return true
}

// The header's kept inline copies inside its inline section.
InlineSection :: (out: *Vec(u8), prune: *Prune, module: *ZirCPruneModule, header: string, chunks: *Chunks) -> bool {
    declarations: Vec(u8)
    bodies: Vec(u8)
    for i: 0..chunks.items.count - 1 {
        copy := chunks.items[i]
        if copy.kept && copy.kind == PRUNE_INLINE && !WriteText(*declarations, header, copy.begin, copy.end) { return false }
        if copy.kept && copy.kind == PRUNE_INLINE_BODY && !WriteText(*bodies, header, copy.begin, copy.end) { return false }
    }
    if !VecPush(declarations, cast(u8)0) || !VecPush(bodies, cast(u8)0) { return false }
    section := PruneInlineText(module.stem, module.guard, module.vector_operations, *declarations[0], *bodies[0],
        prune.simd)
    if section == null { return false }
    ok := BuilderAppend(<<out, CText(section))
    Free(cast(*void)section)
    return ok
}

// OUT with a closing zero as an owned C string, or null.
Finish :: (out: Vec(u8), ok: bool) -> *u8 {
    if !ok || !VecPush(out, cast(u8)0) { return null }
    return CPointer(BuilderFinish(out))
}

ComposeHeader :: (prune: *Prune, modules: *ZirCPruneModule, all: []Chunks, self: s64, header: string) -> *u8 {
    module := *modules[self]
    chunks := *all[self]
    out: Vec(u8)
    ok := BuilderAppend(out, header[0:chunks.top])
    for i: 0..chunks.items.count - 1 {
        chunk := chunks.items[i]
        if !ok { break }
        if chunk.kind == PRUNE_MODULES {
            ok = WriteIncludes(*out, prune, modules, all, self, module.header_scope, module.header_scope_count)
        } else if chunk.kind == PRUNE_END && chunks.inlines {
            ok = InlineSection(*out, prune, module, header, chunks)
        }
        if ok && (chunk.kind == PRUNE_FRAME || chunk.kind == PRUNE_END ||
                  chunk.kept && chunk.kind != PRUNE_INLINE && chunk.kind != PRUNE_INLINE_BODY) {
            ok = WriteText(*out, header, chunk.begin, chunk.end)
        }
    }
    return Finish(out, ok)
}

// The source with its marks replaced: the inline-source define when the
// header keeps inline copies, then the headers it reads and the declarations
// its header moved into it.
ComposeSource :: (prune: *Prune, modules: *ZirCPruneModule, all: []Chunks, self: s64, header: string,
                  source: string) -> *u8 {
    module := *modules[self]
    chunks := *all[self]
    define := TextFind(source, PRUNE_SOURCE_MARK)
    includes := TextFind(source, PRUNE_INCLUDES_MARK)
    if includes < 0 || define > includes { return null }
    prune.stamp += 1
    NoteWords(prune, source, .Stamp, -1, null)
    for i: 0..chunks.items.count - 1 {
        chunk := *chunks.items[i]
        chunk.moved = !chunk.kept && chunk.kind == PRUNE_DECLARATION
        if chunk.moved { NoteWords(prune, header[chunk.begin:chunk.end], .Stamp, -1, null) }
    }
    for i: 0..chunks.items.count - 1 {
        chunk := *chunks.items[i]
        if chunk.kind == PRUNE_HELPER && !(chunk.kept && chunks.written) {
            chunk.moved = !chunk.named || ChunkStamped(prune, <<chunk)
        }
    }
    out: Vec(u8)
    rest: s64 = 0
    ok := true
    if define >= 0 {
        ok = BuilderAppend(out, source[0:define])
        if ok && chunks.inlines {
            ok = BuilderAppend(out, "#define ") && BuilderAppend(out, CText(module.guard)) &&
                BuilderAppend(out, "_SOURCE 1\n")
        }
        rest = define + PRUNE_SOURCE_MARK.count
    }
    ok = ok && BuilderAppend(out, source[rest:includes])
    if ok && chunks.written {
        ok = BuilderAppend(out, "#include \"") && BuilderAppend(out, CText(module.stem)) && BuilderAppend(out, ".h\"\n")
    }
    ok = ok && WriteIncludes(*out, prune, modules, all, self, module.source_scope, module.source_scope_count)
    for i: 0..chunks.items.count - 1 {
        chunk := chunks.items[i]
        if ok && chunk.moved { ok = WriteText(*out, header, chunk.begin, chunk.end) }
    }
    ok = ok && BuilderAppend(out, source[includes + PRUNE_INCLUDES_MARK.count:source.count])
    return Finish(out, ok)
}

TextDescriptor :: struct { data: *u8; length: usize }

CText :: (value: *u8) -> string {
    result := ""
    if value == null { return result }
    length: usize = 0
    while value[length] != 0 { length += 1 }
    descriptor := cast(*TextDescriptor)(*result)
    descriptor.data = value
    descriptor.length = length
    return result
}

CPointer :: (value: string) -> *u8 {
    if value.count == 0 { return null }
    return (cast(*TextDescriptor)(*value)).data
}

libc :: #system_library "libc";
compiler :: #system_library "ziran";
Free :: (memory: *void) #foreign libc "free";
SimdNamesFind :: (names: *void, name: *u8, length: usize, add: s32) -> s64 #foreign compiler "SimdNamesFind";
// HeaderInlineSection's text around DECLARATIONS and BODIES as a malloc'ed C
// string, or null; zir_c_lower.c defines it.
PruneInlineText :: (stem: *u8, guard: *u8, vector_operations: s32, declarations: *u8, bodies: *u8,
                    simd: *void) -> *u8 #foreign compiler "PruneInlineText";
