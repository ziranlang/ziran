opened_file_enum :: (module: *IR.ZirModule, name: *u8, span: IR.ZirSourceSpan, value: *s64) -> s32 {
    found: *IR.ZirType = null
    found_member_storage_0 := cast(*CheckArray128_u8)AllocateOrExit(size_of(CheckArray128_u8))
    defer CompilerFree(cast(*void)found_member_storage_0)
