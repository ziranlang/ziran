            if (strcmp(cast(*u8)(*((other).name)), name) != 0) {
                CheckPost0(*(i))
                continue check_loop_72
            }
            if ((((other).is_specialization != 0) && !(strcmp(cast(*u8)(*((other).specialization_type)), type) != 0)) && !(strcmp(cast(*u8)(*((other).template_param)), cast(*u8)(*((fn).template_param))) != 0)) {
                return 1
            }
            error(c, span, CheckCString("specialization name collision"), name)
            return 0
            CheckPost0(*(i))
        }
    }
    {
        i: s32 = 0
        while check_loop_73 := (i < (c).specialization_count) {
            request: *SpecializationRequest = cast(*SpecializationRequest)(cast(usize)((c).specializations) + cast(usize)(i) * size_of(SpecializationRequest))
            if (((request).instance_owner != instance_owner) || (strcmp(cast(*u8)(*(((request).name).items)), name) != 0)) {
                CheckPost0(*(i))
                continue check_loop_73
            }
            if ((((request).template_owner == owner) && ((request).template_index == index)) && !(strcmp(cast(*u8)(*(((request).type).items)), type) != 0)) {
                return 1
            }
            error(c, span, CheckCString("specialization name collision"), name)
            return 0
            CheckPost0(*(i))
        }
    }
    if ((c).specialization_count == (c).specialization_capacity) {
        capacity: s32 = (ifx ((c).specialization_capacity != 0) then ((c).specialization_capacity * 2) else 8)
        next: *SpecializationRequest = cast(*SpecializationRequest)(CompilerRealloc(cast(*void)((c).specializations), cast(usize)((cast(u64)(cast(usize)(capacity)) * cast(u64)size_of(SpecializationRequest)))))
        if (next == cast(*SpecializationRequest)((null))) {
            (c).failed = 1
            return 0
        }
        (c).specializations = next
        (c).specialization_capacity = capacity
    }
    request: *SpecializationRequest = cast(*SpecializationRequest)(cast(usize)((c).specializations) + cast(usize)(CheckPost0(*((c).specialization_count))) * size_of(SpecializationRequest))
    (request).template_owner = cast(*IR.ZirModule)(owner)
    (request).instance_owner = cast(*IR.ZirModule)(instance_owner)
    (request).template_index = index
    (request).call_span = (ifx (((c).fn != null) && (((c).fn).is_specialization != 0)) then ((c).fn).span else span)
    copy_text(cast(*u8)(*(((request).name).items)), cast(usize)(cast(u64)size_of(CheckArray128_u8)), name)
    copy_text(cast(*u8)(*(((request).type).items)), cast(usize)(cast(u64)size_of(CheckArray128_u8)), type)
    return 1
}

#scope_file
LexerInit :: (lexer: *IR.ZirLexer, source: *u8, path: *u8) {
    CompilerLexerInit(lexer, cast(*void)(source), cast(*void)(path))
}

#scope_file
ParseExpr :: (fn: *IR.ZirFunction, module: *IR.ZirModule, text: *u8, span: IR.ZirSourceSpan) -> s32 {
    return CompilerParseExpr(fn, cast(*IR.ZirModule)(module), cast(*void)(text), span)
}
