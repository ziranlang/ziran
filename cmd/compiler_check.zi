        while check_loop_19 := (i < (module).using_count) {
            using_local: *IR.ZirUsing = cast(*IR.ZirUsing)(cast(usize)((module).usings) + cast(usize)(i) * size_of(IR.ZirUsing))
            if !(in_lookup_file(module, (using_local).is_file_private, (using_local).span) != 0) {
                CheckPost0(*(i))
                continue check_loop_19
            }
            candidate: *IR.ZirType = FindType(module, cast(*u8)(*((using_local).path)), null)
            candidate_value: s64
