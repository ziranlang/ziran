#scope_file
check_file_private_expression_with_buffers :: (module: *IR.ZirModule, source: *u8, span: IR.ZirSourceSpan, buffers: *CheckFilePrivateExpressionBuffers) -> s32 {
    lexer: IR.ZirLexer
    memset(cast(*void)(*((buffers).previous)), 0, cast(usize)(cast(u64)size_of(IR.ZirToken)))
    LexerInit(*(lexer), source, SpanPath(span))
    (buffers).current = LexerNext(*(lexer))
    (buffers).next = LexerNext(*(lexer))
    while check_loop_11 := (((buffers).current).kind != 0) {
        if ((((((buffers).current).kind == 1) && (strcmp(cast(*u8)(*(((buffers).previous).text)), CheckCString(".")) != 0)) && (strcmp(cast(*u8)(*(((buffers).next).text)), CheckCString(":")) != 0)) && (file_private_name(module, cast(*u8)(*(((buffers).current).text)), SpanPath(span)) != 0)) {
            Diagnostic(span, CheckCString("check.file_scope"), CheckCString("file-private declaration is not visible: %s"), cast(*u8)(*(((buffers).current).text)))
            return 0
        }
        (buffers).previous = (buffers).current
        (buffers).current = (buffers).next
        (buffers).next = LexerNext(*(lexer))
    }
    return 1
}

#scope_export
#program_export "private_check_check_file_private_expression"
check_file_private_expression :: (module: *IR.ZirModule, source: *u8, span: IR.ZirSourceSpan) -> s32 {
    buffers := cast(*CheckFilePrivateExpressionBuffers)CheckScratchTake(*ScratchKey_check_file_private_expression, size_of(CheckFilePrivateExpressionBuffers))
    defer CheckScratchRelease(*ScratchKey_check_file_private_expression, cast(*void)buffers)
    return check_file_private_expression_with_buffers(module, source, span, buffers)
}

#scope_file
file_scope_symbol_visible :: (module: *IR.ZirModule, name: *u8) -> s32 {
    {
        pass: s32 = 0
        while check_loop_12 := (pass < 2) {
            count: s32 = (ifx (pass == 0) then 1 else (module).import_count)
            {
                i: s32 = 0
                while check_loop_13 := (i < count) {
                    scope: *IR.ZirModule = module
                    if (pass != 0) {
                        import_local: *IR.ZirImport = cast(*IR.ZirImport)(cast(usize)((module).imports) + cast(usize)(i) * size_of(IR.ZirImport))
                        if ((cast(s32)((import_local).kind) != 1) || !(in_lookup_file(module, (import_local).is_file_private, (import_local).span) != 0)) {
                            CheckPost0(*(i))
                            continue check_loop_13
                        }
                        scope = (import_local).resolved_module
                    }
                    if (scope == cast(*IR.ZirModule)((null))) {
                        CheckPost0(*(i))
                        continue check_loop_13
                    }
                    {
                        g: s32 = 0
                        while check_loop_14 := (g < (scope).global_count) {
                            if ((((pass == 0) || (!((((scope).globals)[g]).is_static != 0) && !((((scope).globals)[g]).is_file_private != 0))) && ((pass != 0) || (in_lookup_file(module, (((scope).globals)[g]).is_file_private, (((scope).globals)[g]).span) != 0))) && (strcmp(cast(*u8)(*((((scope).globals)[g]).name)), name) == 0)) {
                                return 1
                            }
                            CheckPost0(*(g))
                        }
                    }
                    {
                        d: s32 = 0
                        while check_loop_15 := (d < (scope).define_count) {
                            if ((((pass == 0) || ((((scope).defines)[d]).is_public != 0)) && ((pass != 0) || (in_lookup_file(module, (((scope).defines)[d]).is_file_private, (((scope).defines)[d]).span) != 0))) && (strcmp(cast(*u8)(*((((scope).defines)[d]).name)), name) == 0)) {
                                return 1
                            }
                            CheckPost0(*(d))
                        }
                    }
                    {
                        f: s32 = 0
                        while check_loop_16 := (f < (scope).function_count) {
                            if ((((pass == 0) || ((((scope).functions)[f]).is_public != 0)) && ((pass != 0) || (in_lookup_file(module, (((scope).functions)[f]).is_file_private, (((scope).functions)[f]).span) != 0))) && (strcmp(cast(*u8)(*((((scope).functions)[f]).name)), name) == 0)) {
                                return 1
                            }
                            CheckPost0(*(f))
                        }
                    }
                    {
                        t: s32 = 0
                        while check_loop_17 := (t < (scope).type_count) {
                            if ((((pass == 0) || ((((scope).types)[t]).is_public != 0)) && ((pass != 0) || (in_lookup_file(module, (((scope).types)[t]).is_file_private, (((scope).types)[t]).span) != 0))) && (strcmp(cast(*u8)(*((((scope).types)[t]).name)), name) == 0)) {
                                return 1
                            }
                            CheckPost0(*(t))
                        }
                    }
                    CheckPost0(*(i))
                }
            }
            CheckPost0(*(pass))
        }
    }
    {
        i: s32 = 0
        while check_loop_18 := (i < (module).import_count) {
            if (((cast(s32)((((module).imports)[i]).kind) == 2) && (in_lookup_file(module, (((module).imports)[i]).is_file_private, (((module).imports)[i]).span) != 0)) && (strcmp(cast(*u8)(*((((module).imports)[i]).name)), name) == 0)) {
                return 1
            }
            CheckPost0(*(i))
        }
    }
    return 0
}

