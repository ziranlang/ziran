            if ((((candidate == cast(*IR.ZirType)((null))) || !((candidate).is_enum != 0)) || (member == cast(*u8)((null)))) || !(EnumMemberValue(candidate, member, *(candidate_value)) != 0)) {
                CheckPost0(*(i))
                continue check_loop_19
            }
            if ((found != cast(*IR.ZirType)((null))) && ((found != candidate) || (strcmp(cast(*u8)(*((found_member_storage_0[0]).items)), member) != 0))) {
                Diagnostic(span, CheckCString("check.enum_scope"), CheckCString("ambiguous using enum member: %s"), name)
                return (-1)
            }
            found = candidate
            copy_text(cast(*u8)(*((found_member_storage_0[0]).items)), cast(usize)(cast(u64)size_of(CheckArray128_u8)), member)
            CheckSet1(value, candidate_value)
            CheckPost0(*(i))
        }
    }
    return cast(s32)(found != cast(*IR.ZirType)((null)))
}

