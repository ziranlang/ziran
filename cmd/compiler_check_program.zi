generated_helper_name :: (name: *u8) -> s32 {
    // The compiler spells these itself: nested local procedures, enum member
    // adapters and the C backend's own names.
    generated: [3]string = .["zi_local_", "zi_enum_name_", "zi_print_"]
    prefix_storage_0 := cast(*S12Array12_u8)AllocateOrExit(size_of(S12Array12_u8))
    defer CompilerFree(cast(*void)prefix_storage_0)
    name_length: usize = cast(usize)(cast(u64)(strlen(name)))
    for prefix: generated {
        memset(cast(*void)prefix_storage_0, 0, size_of(S12Array12_u8))
        copy_text(cast(*u8)prefix_storage_0, size_of(S12Array12_u8), CheckCString(prefix))
        width: usize = cast(usize)(cast(u64)prefix.count)
        if name_length >= width && strncmp(name, cast(*u8)(*((prefix_storage_0[0]).items)), width) == 0 { return 1 }
    }
    memset(cast(*void)prefix_storage_0, 0, size_of(S12Array12_u8))
    copy_text(cast(*u8)prefix_storage_0, size_of(S12Array12_u8), CheckCString("zi_default_"))
    at: usize = cast(usize)((cast(u64)size_of(S12Array12_u8) - cast(u64)(1)))
    length: usize = cast(usize)(cast(u64)(strlen(name)))
    if ((length < (at + cast(usize)(16))) || (strncmp(name, cast(*u8)(*((prefix_storage_0[0]).items)), at) != 0)) {
        return 0
    }
    {
        i: usize = at
        while check_loop_37 := (i < (at + cast(usize)(16))) {
            if !(isxdigit(cast(s32)(cast(u8)((name)[i]))) != 0) {
                return 0
            }
            S12Post5(*(i))
        }
    }
    if (length == (at + cast(usize)(16))) {
        return 1
    }
    if (strncmp(cast(*u8)(cast(usize)(cast(*u8)(cast(usize)(name) + cast(usize)(at) * size_of(u8))) + cast(usize)(16) * size_of(u8)), CheckCString("_field_"), cast(usize)(cast(u64)(7))) != 0) {
        return 0
    }
    {
        i: usize = ((at + cast(usize)(16)) + cast(usize)(7))
        while check_loop_38 := (i < length) {
            if !(isdigit(cast(s32)(cast(u8)((name)[i]))) != 0) {
                return 0
            }
            S12Post5(*(i))
        }
    }
    return cast(s32)(length > ((at + cast(usize)(16)) + cast(usize)(7)))
}

