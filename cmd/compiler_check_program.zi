#scope_file
native_type :: (type: *u8) -> s32 {
    vector: State.ZirVector
    return cast(s32)((HoldsNativeVector(type) != 0) || ((VectorType(type, *(vector)) != 0) && ((vector).is_native != 0)))
}

#scope_file
check_native_storage :: (module: *IR.ZirModule) -> s32 {
    message_storage_0 := cast(*S12Array91_u8)AllocateOrExit(size_of(S12Array91_u8))
    defer CompilerFree(cast(*void)message_storage_0)
    memset(cast(*void)message_storage_0, 0, size_of(S12Array91_u8))
    copy_text(cast(*u8)message_storage_0, size_of(S12Array91_u8), CheckCString("a native vector, such as s16xN, is a plain value: a global or record field cannot hold one"))
    {
        g: s32 = 0
        while check_loop_32 := (g < (module).global_count) {
            global: *IR.ZirGlobal = cast(*IR.ZirGlobal)(cast(usize)((module).globals) + cast(usize)(g) * size_of(IR.ZirGlobal))
            if (native_type(cast(*u8)(*((global).type))) != 0) {
                Diagnostic((global).span, CheckCString("check.storage"), CheckCString("%s: %s"), cast(*u8)(*((message_storage_0[0]).items)), cast(*u8)(*((global).name)))
                return 0
            }
            S12Post2(*(g))
        }
    }
    {
        t: s32 = 0
        while check_loop_33 := (t < (module).type_count) {
            record: *IR.ZirType = cast(*IR.ZirType)(cast(usize)((module).types) + cast(usize)(t) * size_of(IR.ZirType))
            if (((((record).is_enum != 0) || ((record).is_procedure_type != 0)) || ((record).is_record_template != 0)) || ((record).is_extern != 0)) {
                S12Post2(*(t))
                continue check_loop_33
            }
            offset: usize = cast(usize)(0)
            field: *IR.ZirTypeField
            while check_loop_34 := (TypeNextFieldShared(record, *(offset), *(field)) == 1) {
                if (native_type(cast(*u8)(*((field).type))) != 0) {
                    Diagnostic((record).span, CheckCString("check.storage"), CheckCString("%s: %s.%s"), cast(*u8)(*((message_storage_0[0]).items)), cast(*u8)(*((record).name)), cast(*u8)(*((field).name)))
                    return 0
                }
            }
            S12Post2(*(t))
        }
    }
    {
        i: s32 = 0
        while check_loop_35 := (i < (module).import_count) {
            import_local: *IR.ZirImport = cast(*IR.ZirImport)(cast(usize)((module).imports) + cast(usize)(i) * size_of(IR.ZirImport))
            if (cast(s32)((import_local).kind) != 3) {
                S12Post2(*(i))
                continue check_loop_35
            }
            crosses: s32 = native_type(cast(*u8)(*((import_local).return_type)))
            parameters: *State.ZirParameters = ParametersOf(cast(*u8)(*((import_local).args)))
            {
                a: s32 = 0
                while check_loop_36 := ((a < (parameters).count) && !(crosses != 0)) {
                    crosses = native_type((((parameters).items).items[a]).type)
                    S12Post2(*(a))
                }
            }
            if (crosses != 0) {
                Diagnostic((import_local).span, CheckCString("check.foreign"), CheckCString("a #foreign procedure cannot take or return a native vector, such as s16xN: %s"), cast(*u8)(*((import_local).name)))
                return 0
            }
            S12Post2(*(i))
        }
    }
    return 1
}

