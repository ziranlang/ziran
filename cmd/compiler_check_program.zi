                                ((buffers).scope).module = module
                                activate_using_filtered(*((buffers).scope), cast(*u8)(*((using_local).path)), cast(*u8)(*((using_local).filter)), (using_local).span)
                                CompilerFree(cast(*void)(((buffers).scope).bindings))
