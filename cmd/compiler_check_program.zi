                                    if ((((((((((cast(s32)((call).kind) != 5) || !(((call).name)[0] != 0)) || (strstr((call).name, CheckCString("__overload_")) != null)) || (strstr((call).name, CheckCString("__zi_spec")) != null)) || !(strncmp((call).name, CheckCString("zi_"), cast(usize)(cast(u64)(3))) != 0)) || !(strcmp((call).name, CheckCString("print")) != 0)) || !(strncmp((call).name, CheckCString("Vec"), cast(usize)(cast(u64)(3))) != 0)) || !(strncmp((call).name, CheckCString("Builder"), cast(usize)(cast(u64)(7))) != 0)) || (MapPrimitiveName((call).name) != 0)) || (variadic_callee(module, (call).name) != 0)) {
