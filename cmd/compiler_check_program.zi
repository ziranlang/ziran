}

#scope_file
ParseExprNoDefaults :: (fn: *IR.ZirFunction, module: *IR.ZirModule, text: *u8, span: IR.ZirSourceSpan) -> s32 {
    return CompilerParseExprNoDefaults(fn, cast(*IR.ZirModule)(module), cast(*void)(text), span)
}

#scope_file
FunctionArgs :: (fn: *IR.ZirFunction) -> *u8 {
    return (ifx ((fn).args_text != null) then (fn).args_text else CheckCString(""))
}
