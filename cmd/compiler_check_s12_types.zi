}

NormalizeFunctionArraysBuffers :: struct {
    parts: S12Array64_S12Array4096_u8
    arguments: S12Array4096_u8
    original_type: S12Array4096_u8
    normalized: S12Array4096_u8
}

NormalizeTypeApplicationsBuffers :: struct {
    expanded: S12Array8192_u8
    arguments: S12Array4096_u8
    canonical: S12Array4096_u8
    body: S12Array8192_u8
}

OrderLocalTypesBuffers :: struct {
    needed: IR.ZirType
}

PointerSlot :: struct {
    key: *void
    second: *void
    value: s32
}

RewriteFunctionTypeApplicationsBuffers :: struct {
    expanded: S12Array8192_u8
}

RewriteTypeApplicationsBuffers :: struct {
    arguments: S12Array4096_u8
    expanded: S12Array4096_u8
    canonical: S12Array4096_u8
}

SimdOp :: struct {
    id: s32
    name: *u8
    snake: *u8
    checked: *u8
    shape: s32
    lanes: u32
    type_argument: s32
}

