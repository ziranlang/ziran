S12Post0 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] - 1; return old }
S12Post1 :: (p: **u8) -> *u8 { old := p[0]; p[0] = cast(*u8)(cast(usize)p[0] + size_of(u8)); return old }
S12Post2 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] + 1; return old }
S12Pre3 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] - 1; return p[0] }
S12Set4 :: (p: *u8, value: u8) -> u8 { p[0] = value; return value }
S12Post5 :: (p: *usize) -> usize { old := p[0]; p[0] = p[0] + 1; return old }
S12Pre6 :: (p: **u8) -> *u8 { old := p[0]; p[0] = cast(*u8)(cast(usize)p[0] + size_of(u8)); return p[0] }
S12Post7 :: (p: **u8) -> *u8 { old := p[0]; p[0] = cast(*u8)(cast(usize)p[0] - size_of(u8)); return old }
S12Post8 :: (p: *usize) -> usize { old := p[0]; p[0] = p[0] - 1; return old }
S12Set9 :: (p: *s32, value: s32) -> s32 { p[0] = value; return value }
S12Set10 :: (p: **u8, value: *u8) -> *u8 { p[0] = value; return value }
S12Set11 :: (p: *IR.ZirFunction, value: IR.ZirFunction) -> IR.ZirFunction { p[0] = value; return value }
S12Set12 :: (p: **SimdOp, value: *SimdOp) -> *SimdOp { p[0] = value; return value }
S12Pre13 :: (p: *u64) -> u64 { old := p[0]; p[0] = p[0] + 1; return p[0] }
S12Set14 :: (p: *Origin, value: Origin) -> Origin { p[0] = value; return value }
S12Set15 :: (p: *MutationRoot, value: MutationRoot) -> MutationRoot { p[0] = value; return value }
S12Set16 :: (p: *BorrowMutation, value: BorrowMutation) -> BorrowMutation { p[0] = value; return value }
S12Post17 :: (p: *u64) -> u64 { old := p[0]; p[0] = p[0] + 1; return old }
