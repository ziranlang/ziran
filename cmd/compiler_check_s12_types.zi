// Checker S12 state and C ABI records.
using IR :: #import "compiler_ir"
using State :: #import "compiler_check_types"

S12Callback0 :: #type (a0: *void, a1: *u8) -> *u8 #c_call;
BorrowPlace :: struct {
    root: *BorrowBinding
    path: *BorrowPath
}

ActiveTextBorrow :: struct {
    backing: BorrowPlace
    depth: s32
    vec: s32
    branch: s32
}

BorrowBranch :: struct {
    parent: s32
    group: s32
}

S12Array128_u8 :: struct {
    items: [128]u8
}

Origin :: struct {
    parameters: u64
    depth: s32
    invalid: s32
    unknown: s32
    globals: *u64
    pointees: u64
    lent: u64
    lent_vec: u64
    global_vec: s32
    borrowed_pointers: u64
    readonly_bytes: s32
}

BorrowBinding :: struct {
    module: *IR.ZirModule
    global: *IR.ZirGlobal
    name: S12Array128_u8
    type: S12Array128_u8
    origin: Origin
    local: s32
    depth: s32
    captured: s32
    global_index: s32
    global_backing_state: s32
    text_backing: BorrowPlace
    text_backings: *BorrowSource
    address_backing: BorrowPlace
    address_known: s32
    parameter: s32
    view_listed: s32
    changed_at: u64
    listed_by: u64
}

PointerIndex :: struct {
    slots: *PointerSlot
    capacity: usize
    count: usize
}

BorrowCheck :: struct {
    text_types: *TextTypeAnswer
    text_type_capacity: usize
    text_type_count: usize
    foreign_answers: *ForeignAnswer
    foreign_capacity: usize
    foreign_count: usize
    function_index: PointerIndex
    global_index: PointerIndex
    view_globals: *s32
    view_global_count: s32
    view_global_capacity: s32
    functions: *BorrowFunction
    count: s32
    current: *BorrowFunction
    bindings: *BorrowBinding
    binding_count: s32
    globals: *BorrowBinding
    global_count: s32
    global_words: usize
    global_origins: *Origin
    global_bits: *GlobalBits
    active: *ActiveTextBorrow
    active_count: s32
    active_capacity: s32
    branches: *BorrowBranch
    branch: s32
    paths: *BorrowPath
    sources: *BorrowSource
    depth: s32
    changed: s32
    failed: s32
    clock: u64
    views_changed_at: u64
    checks: u64
}

IndexList :: struct {
    items: *s32
    count: s32
    capacity: s32
}

BorrowFunction :: struct {
    module: *IR.ZirModule
    fn: *IR.ZirFunction
    returned: Origin
    locals: *Origin
    mutations: *BorrowMutation
    mutation_roots: *MutationRoot
    mutation_root_capacity: usize
    mutation_root_count: usize
    checked_at: u64
    callees: IndexList
    globals_read: IndexList
    scanned_views: s32
    stale: s32
    summary_changed_at: u64
    listed_by: u64
}

BorrowMutation :: struct {
    parameter: s32
    global: s32
    path: *BorrowPath
    next: *BorrowMutation
    next_same_root: *BorrowMutation
    owned_transfer: s32
}

BorrowPath :: struct {
    parent: *BorrowPath
    next_allocation: *BorrowPath
    field: *u8
    depth: s32
    index: s32
}

BorrowSource :: struct {
    place: BorrowPlace
    next: *BorrowSource
    next_allocation: *BorrowSource
}

S12Array4096_u8 :: struct {
    items: [4096]u8
}

S12Array64_S12Array4096_u8 :: struct {
    items: [64]S12Array4096_u8
}

CheckFunctionBuffers :: struct {
    params: S12Array64_S12Array4096_u8
    parameters: S12Array64_S12Array4096_u8
}

S12Array1024_u8 :: struct {
    items: [1024]u8
}

S12Array8192_u8 :: struct {
    items: [8192]u8
}

CheckProgramsBuffers :: struct {
    c: State.Checker
    saved_path: S12Array1024_u8
    scope: State.Checker
    token: IR.ZirToken
    raw: IR.ZirFunction
    expression: IR.ZirFunction
    initializer: State.Checker
    assignment: S12Array4096_u8
    body: S12Array8192_u8
    expanded: S12Array8192_u8
}

ForeignAnswer :: struct {
    module: *IR.ZirModule
    name: S12Array128_u8
    found: s32
}

GlobalBits :: struct {
    next: *GlobalBits
    // The first word sets the tail alignment on hosts with narrower pointers.
    first_word: u64
}

InstantiateSpecializationsBuffers :: struct {
    original: IR.ZirFunction
}

JaiParameterTypesBuffers :: struct {
    parameters: S12Array64_S12Array4096_u8
}

MutationRoot :: struct {
