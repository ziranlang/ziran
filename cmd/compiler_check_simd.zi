            error(c, (fn).span, (ifx ((fn).simd_target != 0) then CheckCString("a #target procedure cannot return a native vector") else CheckCString("a #foreign or #program_export procedure cannot return a native vector")), cast(*u8)(*((fn).name)))
        }
    }
    {
        i: s32 = 0
        while check_loop_192 := (i < (fn).stmt_count) {
            if (HoldsNativeVector((((fn).stmts)[i]).type) != 0) {
                error(c, (((fn).stmts)[i]).span, cast(*u8)(*((inside_storage_0[0]).items)), (((fn).stmts)[i]).type)
                return
            }
            S12Post2(*(i))
        }
    }
    {
        x: s32 = 0
        while check_loop_193 := (x < (fn).expr_count) {
            if (HoldsNativeVector((((fn).exprs)[x]).type) != 0) {
                error(c, (((fn).exprs)[x]).span, cast(*u8)(*((inside_storage_0[0]).items)), (((fn).exprs)[x]).type)
                return
            }
            S12Post2(*(x))
        }
    }
}

#scope_export
#program_export "private_check_check_simd_procedure"
check_simd_procedure :: (c: *State.Checker, fn: *IR.ZirFunction) {
    check_native_vectors(c, fn)
    if !((fn).simd_target != 0) {
        return
    }
    if ((fn).inlining == 1) {
        error(c, (fn).span, CheckCString("a #target procedure cannot be #inline"), cast(*u8)(*((fn).name)))
    }
    if (((fn).assembly_text != null) && (((fn).assembly_text)[0] != 0)) {
        error(c, (fn).span, CheckCString("a #target procedure cannot hold #asm variants"), cast(*u8)(*((fn).name)))
    }
    parameters: *State.ZirParameters = ParametersOf(FunctionArgs(fn))
    {
        i: s32 = 0
        while check_loop_194 := (i < (parameters).count) {
            type: *u8 = (((parameters).items).items[i]).type
            if (((type != cast(*u8)((null))) && (cast(s32)(cast(s8)((type)[0])) == 46)) && (cast(s32)(cast(s8)((type)[1])) == 46)) {
                error(c, (fn).span, CheckCString("a #target procedure cannot take variadic arguments"), cast(*u8)(*((fn).name)))
            } else {
                if (holds_wide_vector((c).module, type, 0) != 0) {
                    error(c, (fn).span, CheckCString("a #target procedure cannot take a 256-bit vector by value; pass it in an array or through a pointer"), (((parameters).items).items[i]).name)
                }
            }
            S12Post2(*(i))
        }
    }
    if (holds_wide_vector((c).module, cast(*u8)(*((fn).return_type)), 0) != 0) {
        error(c, (fn).span, CheckCString("a #target procedure cannot return a 256-bit vector by value; store it through a pointer"), cast(*u8)(*((fn).name)))
    }
    {
        x: s32 = 0
        while check_loop_195 := (x < (fn).expr_count) {
            call: *IR.ZirExpr = cast(*IR.ZirExpr)(cast(usize)((fn).exprs) + cast(usize)(x) * size_of(IR.ZirExpr))
            if (((cast(s32)((call).kind) != 5) || ((call).name == cast(*u8)((null)))) || (SimdOpChecked(cast(*u8)(((call).name))) != cast(*SimdOp)((null)))) {
                S12Post2(*(x))
                continue check_loop_195
            }
            wide: s32 = holds_wide_vector((c).module, (call).type, 0)
            native: s32 = native_vector((call).type)
            {
                child: s32 = (call).first_child
                while check_loop_196 := (((child >= 0) && !(wide != 0)) && !(native != 0)) {
                    wide = holds_wide_vector((c).module, (((fn).exprs)[child]).type, 0)
                    native = native_vector((((fn).exprs)[child]).type)
                    child = (((fn).exprs)[child]).next_sibling
                }
            }
            if (wide != 0) {
                error(c, (call).span, CheckCString("a #target procedure cannot pass a 256-bit vector by value to another procedure"), (call).name)
            } else {
                if (native != 0) {
                    error(c, (call).span, CheckCString("a #target procedure cannot pass a native vector to another procedure, which holds fewer blocks than its AVX2 clone"), (call).name)
                }
            }
            S12Post2(*(x))
        }
    }
}

#scope_file
SimdCheckedSignature :: (op: *SimdOp, result: *u8, operands: *SimdOperand, count: s32, message: **u8) -> *u8 {
    detail: *u8 = null
    type: *u8 = SimdSignature(cast(*SimdOp)(op), cast(*u8)(result), operands, count, *(detail))
    S12Set10(message, cast(*u8)(detail))
    return cast(*u8)(type)
}

#scope_file
FunctionArgs :: (fn: *IR.ZirFunction) -> *u8 {
    return (ifx ((fn).args_text != null) then (fn).args_text else CheckCString(""))
}
