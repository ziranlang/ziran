        while check_loop_275 := (i < (scope).field_count) {
            if ((((((scope).fields)[i]).fn == fn) && ((((scope).fields)[i]).parameter == parameter)) && !(strcmp((((scope).fields)[i]).field, field) != 0)) {
                return cast(*FieldAnswer)(cast(usize)((scope).fields) + cast(usize)(i) * size_of(FieldAnswer))
            }
            CheckPost5(*(i))
        }
    }
    if ((scope).field_count == (scope).field_capacity) {
        capacity: usize = (ifx ((scope).field_capacity != 0) then ((scope).field_capacity * cast(usize)(2)) else cast(usize)(64))
        grown: *FieldAnswer = cast(*FieldAnswer)(CompilerRealloc(cast(*void)((scope).fields), cast(usize)((cast(u64)(capacity) * cast(u64)size_of(FieldAnswer)))))
        if (grown == cast(*FieldAnswer)((null))) {
