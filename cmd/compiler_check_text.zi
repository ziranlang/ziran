parents_build :: (fn: *IR.ZirFunction, parents: *Parents) -> s32 {
    (parents).count = (fn).expr_count
    (parents).of = cast(*s32)(CompilerMalloc(cast(usize)((cast(u64)(((cast(usize)((fn).expr_count) + cast(usize)(1)))) * cast(u64)size_of(s32)))))
    pending: *s32 = cast(*s32)(CompilerMalloc(cast(usize)((cast(u64)(((cast(usize)((fn).expr_count) + cast(usize)(1)))) * cast(u64)size_of(s32)))))
    if (((parents).of == cast(*s32)((null))) || (pending == cast(*s32)((null)))) {
        CompilerFree(cast(*void)((parents).of))
        CompilerFree(cast(*void)(pending))
        (parents).of = null
        return 0
    }
    {
        i: s32 = 0
        while check_loop_263 := (i < (fn).expr_count) {
            ((parents).of)[i] = (-1)
            CheckPost0(*(i))
        }
    }
    count: s32 = 0
    {
        s: s32 = 0
        while check_loop_264 := (s < (fn).stmt_count) {
            roots_storage_0 := cast(*CheckArray2_s32)AllocateOrExit(size_of(CheckArray2_s32))
            defer CompilerFree(cast(*void)roots_storage_0)
            memset(cast(*void)roots_storage_0, 0, size_of(CheckArray2_s32))
            roots_storage_0[0] = .{items = .{(((fn).stmts)[s]).expr_root, (((fn).stmts)[s]).lhs_root}}
            {
                r: s32 = 0
                while check_loop_265 := (r < 2) {
                    if ((((roots_storage_0[0]).items[r] >= 0) && ((roots_storage_0[0]).items[r] < (fn).expr_count)) && (((parents).of)[(roots_storage_0[0]).items[r]] == (-1))) {
                        ((parents).of)[(roots_storage_0[0]).items[r]] = ((-2) - s)
                        (pending)[CheckPost0(*(count))] = (roots_storage_0[0]).items[r]
                    }
                    CheckPost0(*(r))
                }
            }
            CheckPost0(*(s))
        }
    }
    while check_loop_266 := (count > 0) {
        index: s32 = (pending)[CheckPre4(*(count))]
        e: *IR.ZirExpr = cast(*IR.ZirExpr)(cast(usize)((fn).exprs) + cast(usize)(index) * size_of(IR.ZirExpr))
        children_storage_1 := cast(*CheckArray3_s32)AllocateOrExit(size_of(CheckArray3_s32))
        defer CompilerFree(cast(*void)children_storage_1)
        memset(cast(*void)children_storage_1, 0, size_of(CheckArray3_s32))
        children_storage_1[0] = .{items = .{(e).left, (e).right, (e).third}}
        {
            c: s32 = 0
            while check_loop_267 := (c < 3) {
                if (((((children_storage_1[0]).items[c] >= 0) && ((children_storage_1[0]).items[c] < (fn).expr_count)) && (((parents).of)[(children_storage_1[0]).items[c]] == (-1))) && (count < (fn).expr_count)) {
                    ((parents).of)[(children_storage_1[0]).items[c]] = index
                    (pending)[CheckPost0(*(count))] = (children_storage_1[0]).items[c]
                }
                CheckPost0(*(c))
            }
        }
        {
            child: s32 = (e).first_child
            while check_loop_268 := ((child >= 0) && (child < (fn).expr_count)) {
                if ((((parents).of)[child] == (-1)) && (count < (fn).expr_count)) {
                    ((parents).of)[child] = index
                    (pending)[CheckPost0(*(count))] = child
                }
                child = (((fn).exprs)[child]).next_sibling
            }
        }
    }
    CompilerFree(cast(*void)(pending))
    return 1
}

#scope_file
comparison :: (op: *u8) -> s32 {
    return cast(s32)(((((!(strcmp(op, CheckCString("==")) != 0) || !(strcmp(op, CheckCString("!=")) != 0)) || !(strcmp(op, CheckCString("<")) != 0)) || !(strcmp(op, CheckCString("<=")) != 0)) || !(strcmp(op, CheckCString(">")) != 0)) || !(strcmp(op, CheckCString(">=")) != 0))
}

#scope_file
combine :: (a: s32, b: s32) -> s32 {
    if ((a == 0) || (b == 0)) {
        return 0
    }
    return (ifx ((a == 2) || (b == 2)) then 2 else 1)
}

#scope_file
reading_foreign :: (module: *IR.ZirModule, name: *u8) -> s32 {
    {
        i: s32 = 0
        while check_loop_269 := (i < (module).import_count) {
            if (((cast(s32)((((module).imports)[i]).kind) == 3) && ((((module).imports)[i]).reads_arguments != 0)) && !(strcmp(cast(*u8)(*((((module).imports)[i]).name)), name) != 0)) {
                return 1
            }
            CheckPost0(*(i))
        }
    }
    return 0
}

#scope_file
reads_slot :: (module: *IR.ZirModule, type: *u8) -> *IR.ZirType {
    slot: *IR.ZirType = (ifx ((type != cast(*u8)((null))) && ((type)[0] != 0)) then FindType(module, type, null) else null)
    return (ifx (((slot != cast(*IR.ZirType)((null))) && ((slot).is_procedure_type != 0)) && ((slot).reads_arguments != 0)) then slot else null)
}

#scope_file
byte_view_type :: (type: *u8) -> bool {
    if type == null { return false }
    type = skip_ws(type)
    return IR.CText(type) == "*u8" || IR.CText(type) == "*s8" ||
        IR.CText(type) == "[]u8" || IR.CText(type) == "[]s8"
}

#scope_file
reads_byte_slot_argument :: (slot: *IR.ZirType, fn: *IR.ZirFunction, argument: s32) -> bool {
    parameters := ParametersOf(*slot.body[0])
    index := fn.exprs[argument].argument_index
    if index < 0 || index >= parameters.count { return false }
    parameter := (cast(*ZirParameter)(*parameters.items.items[0]))[index]
    type := ifx parameter.value_type != null then parameter.value_type else parameter.type
    return byte_view_type(type)
}

// A byte load consumes the value, while an address of that element lends the
// original storage. Assignments through either form violate the read contract.
#scope_file
byte_element_flow :: (scope: *TextScope, module: *IR.ZirModule, fn: *IR.ZirFunction,
    parents: *Parents, value: s32) -> s32 {
    parent := parents.of[value]
    if parent < -1 {
        statement := fn.stmts[-2 - parent]
        return ifx statement.kind == .ASSIGN && statement.lhs_root == value then 0 else 1
    }
    if parent >= 0 && fn.exprs[parent].kind == .UNARY {
        operation := IR.CText(*fn.exprs[parent].op[0])
        if operation == "&" { return value_flow(scope, module, fn, parents, parent) }
        if operation == "++" || operation == "--" { return 0 }
    }
    return 1
}

#scope_file
byte_value_flow :: (scope: *TextScope, module: *IR.ZirModule, fn: *IR.ZirFunction,
    parents: *Parents, value: s32) -> s32 {
    parent := parents.of[value]
    if parent < -1 {
        statement := fn.stmts[-2 - parent]
        if statement.expr_root != value { return 0 }
        if statement.kind == .RETURN { return 2 }
        if statement.kind == .EXPR || statement.kind == .UNUSED { return 1 }
        if statement.kind == .DECL && statement.lhs_root < 0 &&
            statement.is_using == 0 && byte_view_type(statement.type) {
            return local_flow(scope, module, fn, parents, -2 - parent)
        }
        return 0
    }
    if parent < 0 { return 0 }
    expression := fn.exprs[parent]
    if expression.kind == .CALL {
        if IR.CText(expression.name) == "TextView" {
            return value_flow(scope, module, fn, parents, parent)
        }
        return argument_flow(scope, module, fn, parents, parent, value, null)
    }
    if expression.kind == .INDEX && expression.left == value {
        return byte_element_flow(scope, module, fn, parents, parent)
    }
    if expression.kind == .UNARY && IR.CText(*expression.op[0]) == "*" {
        return byte_element_flow(scope, module, fn, parents, parent)
    }
    if expression.kind == .MEMBER && expression.left == value &&
        IR.CText(expression.name) == "count" { return 1 }
    if expression.kind == .SLICE && expression.left == value {
        return value_flow(scope, module, fn, parents, parent)
    }
    if expression.kind == .CAST && byte_view_type(expression.type) {
        return value_flow(scope, module, fn, parents, parent)
    }
    if expression.kind == .BINARY && comparison(*expression.op[0]) != 0 { return 1 }
    if expression.kind == .CONDITIONAL && (expression.right == value || expression.third == value) {
        return value_flow(scope, module, fn, parents, parent)
    }
    return 0
}

#scope_file
argument_flow :: (scope: *TextScope, module: *IR.ZirModule, fn: *IR.ZirFunction, parents: *Parents, call: s32, argument: s32, field: *u8) -> s32 {
    e: *IR.ZirExpr = cast(*IR.ZirExpr)(cast(usize)((fn).exprs) + cast(usize)(call) * size_of(IR.ZirExpr))
    slot := reads_slot(module, e.slot_type)
    if slot != null {
        if byte_view_type(fn.exprs[argument].type) && !reads_byte_slot_argument(slot, fn, argument) {
            return 0
        }
        return (ifx (argument != (e).left) then 1 else 0)
    }
    if (((((e).left >= 0) || ((e).is_function_value != 0)) || !((e).name != null)) || !(((e).name)[0] != 0)) {
        return 0
    }
    if ((field == cast(*u8)((null))) && (!(strcmp((e).name, CheckCString("print")) != 0) || !(strcmp((e).name, CheckCString("TextCopy")) != 0))) {
        return 1
    }
    if ((field == cast(*u8)((null))) && !(strcmp((e).name, CheckCString("BuilderAppend")) != 0)) {
        return (ifx ((e).first_child != argument) then 1 else 0)
    }
    owner: *IR.ZirModule = null
    callee: *IR.ZirFunction = null
    found: s32 = ResolveFunction(module, (e).name, *(owner), *(callee))
    if ((((found != 1) || (callee == cast(*IR.ZirFunction)((null)))) || (owner == cast(*IR.ZirModule)((null)))) || ((callee).is_extern != 0)) {
        qualified_host: *IR.ZirImport = null
        if (((((field == cast(*u8)((null))) && (found == 0)) && (!((e).slot_type != null) || !(((e).slot_type)[0] != 0))) && (ResolveForeignImportAt(module, (e).name, SpanPath((e).span), *(owner), *(qualified_host)) == 1)) && ((qualified_host).reads_arguments != 0)) {
            return 1
        }
        if (((field == cast(*u8)((null))) && (found != (-1))) && (reading_foreign((ifx ((found == 1) && (owner != null)) then owner else module), (ifx ((found == 1) && (callee != null)) then cast(*u8)(*((callee).name)) else (e).name)) != 0)) {
            return 1
        }
        return 0
    }
    if (((callee).is_template != 0) || ((callee).stmt_count == 0)) {
        return 0
    }
    index: s32 = (((fn).exprs)[argument]).argument_index
    if ((index < 0) || (index >= 64)) {
        return 0
    }
    flow: s32 = parameter_flow(scope, owner, callee, index, field)
    return (ifx (flow == 2) then value_flow(scope, module, fn, parents, call) else flow)
}

#scope_file
value_flow :: (scope: *TextScope, module: *IR.ZirModule, fn: *IR.ZirFunction, parents: *Parents, value: s32) -> s32 {
    if byte_view_type(fn.exprs[value].type) {
        return byte_value_flow(scope, module, fn, parents, value)
    }
    parent: s32 = ((parents).of)[value]
    if (parent < (-1)) {
        s: s32 = ((-2) - parent)
        st: *IR.ZirStmt = cast(*IR.ZirStmt)(cast(usize)((fn).stmts) + cast(usize)(s) * size_of(IR.ZirStmt))
        if ((st).expr_root != value) {
            return 0
        }
        if ((cast(s32)((st).kind) == 5) || (cast(s32)((st).kind) == 14)) {
            return 1
        }
        if (cast(s32)((st).kind) == 10) {
            return 2
        }
        if (((((((cast(s32)((st).kind) == 3) && !((st).is_using != 0)) && ((st).lhs_root < 0)) && (((st).names).name != cast(*u8)((null)))) && ((((st).names).name)[0] != 0)) && ((st).type != cast(*u8)((null)))) && !(strcmp((st).type, CheckCString("string")) != 0)) {
            return local_flow(scope, module, fn, parents, s)
        }
        if ((((scope).borrowed != 0) && (cast(s32)((st).kind) == 4)) && !(strcmp(cast(*u8)(*((st).assignment_op)), CheckCString("=")) != 0)) {
            local: s32 = string_local(fn, (st).lhs_root)
            if (local < 0) {
                return 0
            }
            {
                i: s32 = 0
                while check_loop_270 := (i < (scope).walking_count) {
                    if ((((((scope).walking).items[i]).fn == fn) && ((((scope).walking).items[i]).s == local)) && ((((scope).walking).items[i]).path == cast(*u8)((null)))) {
                        return 1
                    }
                    CheckPost0(*(i))
                }
            }
            return local_flow(scope, module, fn, parents, local)
        }
        return 0
    }
    if (parent < 0) {
        return 0
    }
    e: *IR.ZirExpr = cast(*IR.ZirExpr)(cast(usize)((fn).exprs) + cast(usize)(parent) * size_of(IR.ZirExpr))
    check_choice_271 := (e).kind
    while check_switch_271 := true {
        if check_choice_271 == cast(IR.ZirExprKind)((8)) {
            return (ifx (((e).left == value) && !(strcmp((e).name, CheckCString("count")) != 0)) then 1 else 0)
        }
        else if check_choice_271 == cast(IR.ZirExprKind)((10)) {
            return (ifx ((e).left == value) then byte_element_flow(scope, module, fn, parents, parent) else 0)
        }
        else if check_choice_271 == cast(IR.ZirExprKind)((16)) {
            return (ifx ((e).left == value) then value_flow(scope, module, fn, parents, parent) else 0)
        }
        else if check_choice_271 == cast(IR.ZirExprKind)((6)) {
            return (ifx (comparison(cast(*u8)(*((e).op))) != 0) then 1 else 0)
        }
        else if check_choice_271 == cast(IR.ZirExprKind)((14)) {
            return (ifx (((e).right == value) || ((e).third == value)) then value_flow(scope, module, fn, parents, parent) else 0)
        }
        else if check_choice_271 == cast(IR.ZirExprKind)((5)) {
            return argument_flow(scope, module, fn, parents, parent, value, null)
        }
        else if check_choice_271 == cast(IR.ZirExprKind)((15)) {
            record: s32 = ((parents).of)[parent]
            if ((((e).right != value) || (record < 0)) || (cast(s32)((((fn).exprs)[record]).kind) != 12)) {
                return 0
            }
            up: s32 = ((parents).of)[record]
            if ((up < (-1)) && (!((e).name != null) || !(((e).name)[0] != 0))) {
                s: s32 = ((-2) - up)
                st: *IR.ZirStmt = cast(*IR.ZirStmt)(cast(usize)((fn).stmts) + cast(usize)(s) * size_of(IR.ZirStmt))
                if (((((((cast(s32)((st).kind) != 3) || ((st).expr_root != record)) || ((st).is_using != 0)) || ((st).lhs_root >= 0)) || (((st).names).name == cast(*u8)((null)))) || !((((st).names).name)[0] != 0)) || !(string_array_type((st).type) != 0)) {
                    return 0
                }
                return local_flow(scope, module, fn, parents, s)
            }
            if (!((e).name != null) || !(((e).name)[0] != 0)) {
                return 0
            }
            return record_flow(scope, module, fn, parents, record, (e).name)
        }
        else {
            return 0
        }
        break
    }
    unreachable
}

#scope_file
value_read_only :: (scope: *TextScope, module: *IR.ZirModule, fn: *IR.ZirFunction, parents: *Parents, value: s32) -> s32 {
    return cast(s32)(value_flow(scope, module, fn, parents, value) == 1)
}

#scope_file
answer_for :: (scope: *TextScope, fn: *IR.ZirFunction) -> *ScopeAnswer {
    if (((((scope).count + cast(usize)(1))) * cast(usize)(2)) > (scope).capacity) {
        capacity: usize = (ifx ((scope).capacity != 0) then ((scope).capacity * cast(usize)(2)) else cast(usize)(256))
        grown: *ScopeAnswer = cast(*ScopeAnswer)(CompilerCalloc(capacity, cast(usize)(cast(u64)size_of(ScopeAnswer))))
        if (grown == cast(*ScopeAnswer)((null))) {
            (scope).failed = 1
            return null
        }
        {
            i: usize = cast(usize)(0)
            while check_loop_272 := (i < (scope).capacity) {
                if ((((scope).answers)[i]).fn == cast(*IR.ZirFunction)((null))) {
                    CheckPost5(*(i))
                    continue check_loop_272
                }
                slot: usize = cast(usize)((cast(u64)(((cast(usize)((((scope).answers)[i]).fn) >> cast(usize)(4)))) & cast(u64)(((capacity - cast(usize)(1))))))
                while check_loop_273 := (((grown)[slot]).fn != cast(*IR.ZirFunction)((null))) {
                    slot = (((slot + cast(usize)(1))) & ((capacity - cast(usize)(1))))
                }
                (grown)[slot] = ((scope).answers)[i]
                CheckPost5(*(i))
            }
        }
        CompilerFree(cast(*void)((scope).answers))
        (scope).answers = grown
        (scope).capacity = capacity
    }
    mask: usize = ((scope).capacity - cast(usize)(1))
    slot: usize = cast(usize)((cast(u64)(((cast(usize)(fn) >> cast(usize)(4)))) & cast(u64)(mask)))
    while check_loop_274 := (((((scope).answers)[slot]).fn != cast(*IR.ZirFunction)((null))) && ((((scope).answers)[slot]).fn != fn)) {
        slot = (((slot + cast(usize)(1))) & mask)
    }
    if ((((scope).answers)[slot]).fn == cast(*IR.ZirFunction)((null))) {
        (((scope).answers)[slot]).fn = fn
        CheckPost5(*((scope).count))
    }
    return cast(*ScopeAnswer)(cast(usize)((scope).answers) + cast(usize)(slot) * size_of(ScopeAnswer))
}

