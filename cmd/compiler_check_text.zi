        (scope).fields = grown
        (scope).field_capacity = capacity
    }
    answer: *FieldAnswer = cast(*FieldAnswer)(cast(usize)((scope).fields) + cast(usize)(CheckPost5(*((scope).field_count))) * size_of(FieldAnswer))
    CheckSet18(answer, FieldAnswer.{fn, parameter, field, cast(u8)(0)})
    return answer
}

#scope_file
flow_state :: (scope: *TextScope, fn: *IR.ZirFunction, parameter: s32, field: *u8) -> *u8 {
    if (field != cast(*u8)((null))) {
        answer: *FieldAnswer = field_answer(scope, fn, parameter, field)
        return (ifx (answer != null) then *((answer).state) else null)
    }
    answer: *ScopeAnswer = answer_for(scope, fn)
    return (ifx (answer != null) then cast(*u8)(cast(usize)(cast(*u8)(*(((answer).state).items))) + cast(usize)(parameter) * size_of(u8)) else null)
}

#scope_file
parameter_flow :: (scope: *TextScope, module: *IR.ZirModule, fn: *IR.ZirFunction, parameter: s32, field: *u8) -> s32 {
    state: *u8 = flow_state(scope, fn, parameter, field)
    if (state == cast(*u8)((null))) {
        return 0
    }
    check_choice_276 := cast(s32)((state)[0])
    while check_switch_276 := true {
        if check_choice_276 == (2) {
            return 1
        }
        else if check_choice_276 == (4) {
            return 2
        }
        else if check_choice_276 == (0) {
            break check_switch_276
        }
        else {
            return 0
        }
