CheckPost0 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] + 1; return old }
CheckSet1 :: (p: *s64, value: s64) -> s64 { p[0] = value; return value }
CheckPost2 :: (p: ***u8) -> **u8 { old := p[0]; p[0] = cast(**u8)(cast(usize)p[0] + size_of(*u8)); return old }
CheckSet3 :: (p: *usize, value: usize) -> usize { p[0] = value; return value }
CheckPre4 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] - 1; return p[0] }
CheckPost5 :: (p: *usize) -> usize { old := p[0]; p[0] = p[0] + 1; return old }
CheckPost6 :: (p: **u8) -> *u8 { old := p[0]; p[0] = cast(*u8)(cast(usize)p[0] + size_of(u8)); return old }
CheckSet7 :: (p: *s32, value: s32) -> s32 { p[0] = value; return value }
CheckPost8 :: (p: **u8) -> *u8 { old := p[0]; p[0] = cast(*u8)(cast(usize)p[0] - size_of(u8)); return old }
CheckPost9 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] - 1; return old }
CheckSet10 :: (p: **IR.ZirModule, value: *IR.ZirModule) -> *IR.ZirModule { p[0] = value; return value }
CheckSet11 :: (p: **IR.ZirType, value: *IR.ZirType) -> *IR.ZirType { p[0] = value; return value }
CheckSet12 :: (p: **u8, value: *u8) -> *u8 { p[0] = value; return value }
CheckSet13 :: (p: *u8, value: u8) -> u8 { p[0] = value; return value }
CheckPre14 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] + 1; return p[0] }
CheckPost15 :: (p: *usize) -> usize { old := p[0]; p[0] = p[0] - 1; return old }
CheckSet16 :: (p: *IR.ZirExpr, value: IR.ZirExpr) -> IR.ZirExpr { p[0] = value; return value }
CheckSet17 :: (p: *IR.ZirSourceSpan, value: IR.ZirSourceSpan) -> IR.ZirSourceSpan { p[0] = value; return value }
CheckSet18 :: (p: *FieldAnswer, value: FieldAnswer) -> FieldAnswer { p[0] = value; return value }
CheckSet19 :: (p: *u64, value: u64) -> u64 { p[0] = value; return value }
CheckSet20 :: (p: *IR.ZirStmt, value: IR.ZirStmt) -> IR.ZirStmt { p[0] = value; return value }

__builtin_add_overflow :: (left: s64, right: s64, out: *s64) -> bool {
    result := cast(s64)(cast(u64)left + cast(u64)right)
    out[0] = result
    return ((left ^ result) & (right ^ result)) < 0
}
__builtin_sub_overflow :: (left: s64, right: s64, out: *s64) -> bool {
    result := cast(s64)(cast(u64)left - cast(u64)right)
    out[0] = result
    return ((left ^ right) & (left ^ result)) < 0
}
__builtin_mul_overflow :: (left: s64, right: s64, out: *s64) -> bool {
    a := ifx left < 0 then cast(u64)0 - cast(u64)left else cast(u64)left
    b := ifx right < 0 then cast(u64)0 - cast(u64)right else cast(u64)right
    limit := ifx (left < 0) != (right < 0) then cast(u64)9223372036854775808 else cast(u64)9223372036854775807
    out[0] = cast(s64)(cast(u64)left * cast(u64)right)
    return b != 0 && a > limit / b
}
CheckTextDescriptor :: struct { data: *u8; count: usize }
CheckCString :: (text: string) -> *u8 { return (cast(*CheckTextDescriptor)(*text)).data }
CheckCStringLength :: (text: *u8) -> u64 { return cast(u64)LibcStringLength(text) }
#scope_file
compiler :: #system_library "ziran";
libc :: #system_library "libc";
LibcStringLength :: (text: *u8) -> usize #foreign libc "strlen";
Destroy :: #type (memory: *void) #c_call;
CompilerContextScratch :: (key: *void, destroy: Destroy) -> *void #foreign compiler "CompilerContextScratch";
CompilerScratchTake :: (pool: *void) -> *void #foreign compiler "CompilerScratchTake";
CompilerScratchPut :: (pool: *void, memory: *void) -> s32 #foreign compiler "CompilerScratchPut";
CompilerMemoryRecovering :: () -> s32 #foreign compiler "CompilerMemoryRecovering";
CompilerFree :: (memory: *void) #foreign compiler "CompilerFree";
AllocateOrExit :: (size: usize) -> *void #foreign compiler "AllocateOrExit";
CheckDestroy :: (memory: *void) { CompilerFree(memory) }
#scope_export
CheckScratchTake :: (key: *u8, size: usize) -> *void {
    memory: *void
    if CompilerMemoryRecovering() == 0 {
        pool := CompilerContextScratch(cast(*void)key, CheckDestroy)
        memory = CompilerScratchTake(pool)
    }
    if memory == null { memory = AllocateOrExit(size) }
    return memory
}
CheckScratchRelease :: (key: *u8, memory: *void) {
    if CompilerMemoryRecovering() == 0 {
        pool := CompilerContextScratch(cast(*void)key, CheckDestroy)
        if CompilerScratchPut(pool, memory) != 0 { return }
    }
    CompilerFree(memory)
}
