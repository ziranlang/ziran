    c.fn.exprs[index].kind = .OWNED_CLOSURE
    c.fn.exprs[index].name = Services.KeepName(env_name)
    c.fn.exprs[index].type = expected
    c.fn.exprs[index].left = environment
    c.fn.exprs[index].right = function_value
    c.fn.exprs[index].third = release_value
    c.fn.exprs[index].first_child = -1
    c.aggregate_rewritten = 1
}

