        if IR.CText(*field.name[0]) == "invoke" { unused IR.CopyText(invoke_type[:], IR.CText(*field.type[0])) }
    }
    if record_field_type_at_use(c.module, owner, written, *invoke_type[0], size_of(type_of(invoke_type))) == 0 {
        error(c, call.span, CheckCString("owned invoke signature is inaccessible"), written)
