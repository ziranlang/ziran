// Owned closure construction shares the checked record/move graph. This is
// type erasure inside the compiler, with a concrete type at both trampolines.
#scope_file
closure_join :: (a: string, b: string, tail: string = "") -> string {
    bytes: Vec(u8)
    for byte: a { VecPush(bytes, byte) }
    for byte: b { VecPush(bytes, byte) }
    for byte: tail { VecPush(bytes, byte) }
    text: Text = .{bytes = bytes}
    return IR.CText(Services.Keep(TextView(text)))
}

#scope_export
#program_export "private_check_capture_safe"
capture_safe :: (module: *IR.ZirModule, type: *u8, depth: s32) -> bool {
    if depth > 32 || type == null || type[0] == 0 || type[0] == #char "*" { return false }
    scalar := IR.CText(ScalarType(type))
    if scalar.count > 0 { return scalar != "string" && scalar != "void" }
    if SliceElementType(type, null, 0) != 0 || IR.CText(type) == "string" { return false }
    element: [128]u8
    if VecElementType(module, type, *element[0], size_of(type_of(element))) != 0 ||
       ArrayElementType(type, *element[0], size_of(type_of(element)), null) != 0 {
        return capture_safe(module, *element[0], depth + 1)
    }
    owner: *IR.ZirModule = null
    record := FindType(module, type, *owner)
    if record == null { return false }
    if record.is_scoped_callable != 0 { return false }
    if record.is_enum != 0 || record.is_owned_callable != 0 { return true }
    if record.is_extern != 0 || record.is_union != 0 || record.is_procedure_type != 0 ||
       record.is_record_template != 0 || record.is_map != 0 { return false }
    offset: usize = 0
    field: IR.ZirTypeField
    while TypeNextField(record, *offset, *field) == 1 {
        if !capture_safe(ifx owner != null then owner else module, *field.type[0], depth + 1) { return false }
    }
    return true
}

#scope_file
closure_node :: (fn: *IR.ZirFunction, kind: IR.ZirExprKind, text: string,
                 span: IR.ZirSourceSpan, name: string = "", left: s32 = -1, right: s32 = -1) -> s32 {
    node := Services.AddExpr(fn, kind, text, span)
    if node == null { return -1 }
    node.name = Services.KeepName(name)
    node.left = left
    node.right = right
    return fn.expr_count - 1
}

contextual_owned_closure :: (c: *Checker, index: s32, expected: *u8, owned: *IR.ZirType,
                             owned_owner: *IR.ZirModule) {
    value := c.fn.exprs[index]
    scoped := owned.is_scoped_callable != 0
