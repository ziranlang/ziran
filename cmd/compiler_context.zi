#scope_export
#program_export "CompilerContextCurrent"
CompilerContextCurrent :: () -> *CompilerContext {
    return (CompilerThreadStateAddress()).context_local
    unreachable
}

#scope_export
#program_export "CompilerContextSelect"
CompilerContextSelect :: (context_local: *CompilerContext) -> *CompilerContext {
    thread: *CompilerThread = CompilerThreadStateAddress()
    previous: *CompilerContext = (thread).context_local
    (thread).context_local = context_local
    return previous
    unreachable
}

#scope_export
#program_export "CompilerThreadIdentity"
CompilerThreadIdentity :: (thread: *CompilerThread) -> u64 {
    return (ifx ((thread).context_local != null) then ((thread).context_local).identity else cast(u64)(1))
    unreachable
}

#scope_export
#program_export "CompilerContextIdentity"
CompilerContextIdentity :: () -> u64 {
    return CompilerThreadIdentity(CompilerThreadStateAddress())
    unreachable
}

#scope_export
#program_export "CompilerContextOpen"
CompilerContextOpen :: () -> *CompilerContext {
    context_local: *CompilerContext = cast(*CompilerContext)(calloc(cast(usize)(1), cast(usize)size_of(CompilerContext)))
    if (context_local != null) {
        S15FlagClear(cast(*void)(*((context_local).lock)))
        S15SupportSet0((*((context_local).references)), cast(usize)(1))
        while S15FlagTake(cast(*void)*context_identity_lock) != 0 {}
        (context_local).identity = context_next_identity
        context_next_identity += cast(u64)1
        S15FlagClear(cast(*void)*context_identity_lock)
    }
    return context_local
    unreachable
}

#scope_export
#program_export "CompilerContextRetain"
CompilerContextRetain :: (context_local: *CompilerContext) {
