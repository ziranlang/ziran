}

#scope_file
storage_in :: (thread: *CompilerThread, context_local: *CompilerContext, key: s32, size: usize, destroy: S15Callback0) -> *void {
    if !(context_local != null) {
        context_local = *(context_shared)
    }
    if ((thread).storage_identity != (context_local).identity) {
        {
            i: s32 = 0
            while check_loop_1 := (i < 12) {
                ((thread).storage_hints).items[i] = (null)
                S15SupportPost1(*(i))
            }
        }
        (thread).storage_identity = (context_local).identity
    }
    if (((thread).storage_hints).items[key] != null) {
        return ((thread).storage_hints).items[key]
    }
    while check_loop_2 := (S15FlagTake(cast(*void)(*((context_local).lock))) != 0) {
    }
    slot: *Storage = cast(*Storage)(cast(usize)(cast(*Storage)(*(((context_local).storage).items))) + cast(usize)(key) * size_of(Storage))
    if !((slot).value != null) {
        (slot).value = calloc(cast(usize)(1), size)
        (slot).destroy = destroy
    }
    value: *void = (slot).value
    S15FlagClear(cast(*void)(*((context_local).lock)))
    if !(value != null) {
        abort()
    }
    ((thread).storage_hints).items[key] = value
    return value
    unreachable
}

#scope_export
#program_export "CompilerContextStorage"
CompilerContextStorage :: (context_local: *CompilerContext, key: s32, size: usize, destroy: S15Callback0) -> *void {
    return storage_in(CompilerThreadStateAddress(), context_local, key, size, destroy)
    unreachable
}

#scope_export
#program_export "CompilerThreadStorage"
CompilerThreadStorage :: (thread: *CompilerThread, key: s32, size: usize, destroy: S15Callback0) -> *void {
    return storage_in(thread, (thread).context_local, key, size, destroy)
    unreachable
}

#scope_export
#program_export "CompilerCurrentStorage"
CompilerCurrentStorage :: (key: s32, size: usize, destroy: S15Callback0) -> *void {
    return CompilerThreadStorage(CompilerThreadStateAddress(), key, size, destroy)
    unreachable
}

#scope_file
destroy_context :: (context_local: *CompilerContext) {
    if ((CompilerThreadStateAddress()).context_local == context_local) {
        (CompilerThreadStateAddress()).context_local = null
    }
    {
        i: s32 = (12 - 1)
        while check_loop_3 := (i >= 0) {
            slot: *Storage = cast(*Storage)(cast(usize)(cast(*Storage)(*(((context_local).storage).items))) + cast(usize)(i) * size_of(Storage))
            if ((slot).value != null) {
                if (slot).destroy != cast(S15Callback0)null {
                    (slot).destroy((slot).value)
                }
                free((slot).value)
            }
            S15SupportPost2(*(i))
        }
    }
    free(cast(*void)(context_local))
}

#scope_export
#program_export "CompilerContextClose"
CompilerContextClose :: (context_local: *CompilerContext) -> s32 {
    if ((!(context_local != null) || (context_local == (CompilerThreadStateAddress()).context_local)) || (S15SizeLoad(cast(*void)(*((context_local).references))) != cast(usize)(1))) {
        return 0
    }
    CompilerContextRelease(context_local)
    return 1
    unreachable
}

#scope_file
free_scratch_pools :: (value: *void) {
    pools: *ScratchPools = cast(*ScratchPools)(value)
    {
        b: s32 = 0
        while check_loop_4 := (b < 256) {
            while check_loop_5 := (((pools).buckets).items[b] != null) {
                pool: *CompilerScratch = ((pools).buckets).items[b]
                ((pools).buckets).items[b] = (pool).next
                while check_loop_6 := ((pool).count != 0) {
                    (pool).destroy(((pool).items).items[S15SupportPre3(*((pool).count))])
                }
                free(cast(*void)(pool))
            }
            S15SupportPost1(*(b))
        }
    }
}

#scope_export
#program_export "CompilerContextScratch"
CompilerContextScratch :: (key: *void, destroy: S15Callback0) -> *CompilerScratch {
    pools: *ScratchPools = cast(*ScratchPools)(CompilerCurrentStorage(11, cast(usize)size_of(ScratchPools), free_scratch_pools))
    while check_loop_7 := (S15FlagTake(cast(*void)(*((pools).lock))) != 0) {
    }
    hash: usize = (((cast(usize)(key) >> cast(usize)(3))) & cast(usize)(255))
    pool: *CompilerScratch = ((pools).buckets).items[hash]
    while check_loop_8 := ((pool != null) && ((pool).key != key)) {
        pool = (pool).next
    }
    if !(pool != null) {
        pool = cast(*CompilerScratch)(calloc(cast(usize)(1), cast(usize)size_of(CompilerScratch)))
        if !(pool != null) {
            abort()
        }
        (pool).key = key
        (pool).destroy = destroy
        S15FlagClear(cast(*void)(*((pool).lock)))
        (pool).next = ((pools).buckets).items[hash]
        ((pools).buckets).items[hash] = pool
    }
    S15FlagClear(cast(*void)(*((pools).lock)))
    return pool
    unreachable
}

#scope_export
#program_export "CompilerScratchCached"
CompilerScratchCached :: (cache: *CompilerScratchCache, key: *void, destroy: S15Callback0) -> *CompilerScratch {
    identity: u64 = CompilerContextIdentity()
    if ((cache).identity != identity) {
        (cache).pool = CompilerContextScratch(key, destroy)
        (cache).identity = identity
    }
    return (cache).pool
    unreachable
}

#scope_export
#program_export "CompilerScratchTake"
CompilerScratchTake :: (scratch: *CompilerScratch) -> *void {
    while check_loop_9 := (S15FlagTake(cast(*void)(*((scratch).lock))) != 0) {
    }
    value: *void = (ifx ((scratch).count != 0) then ((scratch).items).items[S15SupportPre3(*((scratch).count))] else (null))
