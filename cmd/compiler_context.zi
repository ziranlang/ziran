#scope_export
#program_export "CompilerScratchPut"
CompilerScratchPut :: (scratch: *CompilerScratch, value: *void) -> s32 {
    while check_loop_10 := (S15FlagTake(cast(*void)(*((scratch).lock))) != 0) {
