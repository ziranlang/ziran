S15SupportSet0 :: (p: *usize, value: usize) -> usize { p[0] = value; return value }
S15SupportPost1 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] + 1; return old }
S15SupportPost2 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] - 1; return old }
S15SupportPre3 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] - 1; return p[0] }
S15SupportPost4 :: (p: *usize) -> usize { old := p[0]; p[0] = p[0] + 1; return old }
S15SupportSet5 :: (p: *s32, value: s32) -> s32 { p[0] = value; return value }
S15SupportSet6 :: (p: **u8, value: *u8) -> *u8 { p[0] = value; return value }
S15SupportPost7 :: (p: **u8) -> *u8 { old := p[0]; p[0] = cast(*u8)(cast(usize)p[0] + size_of(u8)); return old }
S15SupportSet8 :: (p: *CompilerKeptText, value: CompilerKeptText) -> CompilerKeptText { p[0] = value; return value }
S15SupportSet9 :: (p: *u8, value: u8) -> u8 { p[0] = value; return value }
S15SupportSet10 :: (p: *u64, value: u64) -> u64 { p[0] = value; return value }
S15SupportSet11 :: (p: *u32, value: u32) -> u32 { p[0] = value; return value }
S15SupportPost12 :: (p: *usize) -> usize { old := p[0]; p[0] = p[0] - 1; return old }

S15ParametersHeaderSize :: () -> usize {
    alignment := size_of(*u8)
    return cast(usize)((size_of(s32) + alignment - 1) / alignment * alignment)
}
S15Bytes :: (descriptor: S14.ParserSlice) -> []u8 {
    result: []u8
    S15Copy(cast(*void)*result, cast(*void)*descriptor, size_of([]u8))
    return result
}
