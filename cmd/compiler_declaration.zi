// Declaration syntax. Returned text borrows source and output storage belongs
// to the caller; IR construction and source diagnostics stay at the boundary.
Text :: #import "compiler_text";
Source :: #import "compiler_source";
Scan :: #import "compiler_scan";

DeclarationError :: enum s32 {
    None; ExportQuote; ExportName; Parameters; DefaultValue;
    UsingModifier; UsingType; UsingName; ImportQuote; ImportCharacter;
    ImportMode; ImportDirSyntax; ImportDirPath; ImportDirName;
    ImportFileSyntax; ImportFilePath; ImportFileName; ImportAlias;
    ImportTarget; ImportPackage; ImportUsing;
    LibraryQuote; LibraryEnd; LibraryCharacter;
    UsingKind; UsingList; UsingEntry; UsingMap;
    ForeignResults; ForeignField; ForeignDefer; ForeignVariadic; ForeignPythonAttributes;
    ForeignType; ForeignBody; ForeignLibrary; ForeignSymbol; ForeignEnd;
    ForeignPythonSymbol; ForeignHostRename; ForeignGoResults; ForeignGoField;
    ForeignGoDefer; ForeignGoVariadic; ForeignPythonResults; ForeignPythonField;
}
ExportDirective :: struct { error: DeclarationError; kind: s32; symbol: string; body: string }
ParameterRewrite :: struct {
    error: DeclarationError
    count: s64
    parameters: s32
    has_defaults: bool
    using_parameters: u64
}
ImportMode :: enum s32 { Module; File; Directory }
ModuleImport :: struct {
    error: DeclarationError
    present: bool
    named: bool
    using_import: bool
    mode: ImportMode
    name: string
    target: string
    path: string
    detail: string
}
LibraryDeclaration :: struct { error: DeclarationError; present: bool; name: string; target: string }
MethodSymbol :: struct { valid: bool; receiver: string; method: string }
UsingFilter :: struct { error: DeclarationError; present: bool; count: s64; next: s64 }
ForeignDeclaration :: struct {
    error: DeclarationError
    present: bool
    name: string
    library: string
    symbol: string
    is_type: bool
    go_results: bool
    go_field: bool
    go_defer: bool
    go_variadic: bool
    py_results: bool
    py_field: bool
}
ForeignTarget :: struct { error: DeclarationError; count: s64 }

#scope_file
Find :: (source: string, needle: string) -> s64 {
    for at: 0..source.count {
        if needle.count <= source.count - at && source[at:at + needle.count] == needle { return at }
    }
    return -1
}
Trim :: (source: string) -> string {
    range := Text.TrimRange(source)
    return source[range.begin:range.end]
}
Put :: (output: []u8, used: *s64, source: string) {
    for byte: source {
        if <<used < output.count { output[<<used] = byte }
        <<used += 1
    }
}
QuotedText :: struct { valid: bool; value: string; end: s64 }
Quoted :: (source: string, limit: s64) -> QuotedText {
    begin := Find(source, "\"")
    if begin < 0 { return .{} }
    end := Find(source[begin + 1:], "\"")
    if end < 0 || end >= limit { return .{} }
    end += begin + 1
    return .{true, source[begin + 1:end], end + 1}
}
SymbolBeforeColons :: (source: string, limit: s64) -> string {
    colons := Find(source, "::")
    if colons < 0 { return "" }
    begin := Text.SkipSpace(source, 0, true)
    end := begin
    while end < colons && Text.IdentifierByte(source[end]) { end += 1 }
    if end == begin || end - begin >= limit || Text.SkipSpace(source, end, true) != colons { return "" }
    return source[begin:end]
}
Basename :: (source: string) -> string {
    begin: s64 = 0
    for at: 0..source.count - 1 { if source[at] == #char "/" { begin = at + 1 } }
    return source[begin:]
}

#scope_export
ErrorText :: (error: DeclarationError) -> string {
    if error == .ExportQuote { return "#program_export requires a valid quoted symbol" }
    if error == .ExportName { return "#program_export symbol must be an identifier" }
    if error == .Parameters { return "too many procedure parameters" }
    if error == .DefaultValue { return "default parameter needs a value" }
    if error == .UsingModifier { return "using parameter modifiers are not supported" }
    if error == .UsingType { return "using parameter needs name: Type" }
    if error == .UsingName { return "using parameter needs a plain name" }
    if error == .ImportQuote { return "Jai #import requires a quoted module or file name" }
    if error == .ImportCharacter { return "#import target contains a character that cannot appear in an include path" }
    if error == .ImportMode { return "unsupported #import mode" }
    if error == .ImportDirSyntax { return "#import, dir requires a quoted path and ';'" }
    if error == .ImportDirPath { return "#import, dir requires a relative directory path" }
    if error == .ImportDirName { return "#import, dir path needs an identifier directory name" }
    if error == .ImportFileSyntax { return "#import, file requires a quoted path and ';'" }
    if error == .ImportFilePath { return "#import, file requires a relative .zi path" }
    if error == .ImportFileName { return "#import, file path needs an identifier filename" }
    if error == .ImportAlias { return "import alias must start with a letter or underscore" }
    if error == .ImportTarget { return "Jai #import requires a module identifier or PACKAGE/Module; use #import, file for paths" }
    if error == .ImportPackage { return "a package import has one '/', as in #import \"PACKAGE/Module\"" }
    if error == .ImportUsing { return "using #import requires a named module alias" }
    if error == .LibraryQuote { return "#system_library requires a quoted library name" }
    if error == .LibraryEnd { return "#system_library declaration must end with ';'" }
    if error == .LibraryCharacter { return "#system_library name contains an invalid character" }
    if error == .UsingKind { return "using modifier must be only, except, or map" }
    if error == .UsingList { return "using modifier requires a parenthesized name list" }
    if error == .UsingEntry { return "using modifier entries must be quoted names" }
    if error == .UsingMap { return "using map entries need \"new\" = \"old\"" }
    if error == .ForeignResults { return "#go_results requires one foreign procedure result record" }
    if error == .ForeignField { return "#go_field requires one foreign field accessor without #go_results" }
    if error == .ForeignDefer { return "#go_defer requires one foreign procedure without result or field attributes" }
    if error == .ForeignVariadic { return "#go_variadic requires one foreign procedure with a final slice parameter" }
    if error == .ForeignPythonAttributes { return "#py_results and #py_field each apply once to a foreign procedure, not together" }
    if error == .ForeignType { return "foreign type requires Name :: #type #foreign library;" }
    if error == .ForeignBody { return "#foreign procedure declarations cannot have a body" }
    if error == .ForeignLibrary { return "#foreign requires a named #system_library" }
    if error == .ForeignSymbol { return "#foreign alternate symbol must be an identifier or a Go method expression" }
    if error == .ForeignEnd { return "#foreign declaration must end with ';'" }
    if error == .ForeignPythonSymbol { return "#foreign Python symbol must be a name, a dotted attribute path, or a method (Type).name" }
    if error == .ForeignHostRename { return "host capability cannot rename a #foreign symbol" }
    if error == .ForeignGoResults { return "#go_results requires an explicit Go foreign target" }
    if error == .ForeignGoField { return "#go_field requires an explicit Go foreign target" }
    if error == .ForeignGoDefer { return "#go_defer requires an explicit Go foreign target" }
    if error == .ForeignGoVariadic { return "#go_variadic requires an explicit Go foreign target" }
    if error == .ForeignPythonResults { return "#py_results requires a py: foreign target" }
    if error == .ForeignPythonField { return "#py_field requires a py: foreign target" }
    return ""
}

// A short output receives its prefix; count measures the complete filter.
// next advances past the clause and following whitespace, leaving the binding.
UsingModifierClause :: (source: string, output: []u8, name_limit: s64) -> UsingFilter {
    result: UsingFilter
    if source.count == 0 || source[0] != #char "," { return result }
    result.present = true
    at := Text.SkipSpace(source, 1, false)
    mode := source[at:]
    prefix := ""
    if Source.StartsWord(mode, "only") { prefix = "O:"; at += 4 }
    else if Source.StartsWord(mode, "except") { prefix = "E:"; at += 6 }
    else if Source.StartsWord(mode, "map") { prefix = "M:"; at += 3 }
    else { result.error = .UsingKind; return result }
    at = Text.SkipSpace(source, at, false)
    if at >= source.count || source[at] != #char "(" { result.error = .UsingList; return result }
    at = Text.SkipSpace(source, at + 1, false)
    Put(output, *result.count, prefix)
    entries: s64 = 0
    while at < source.count && source[at] != #char ")" {
        quoted := UsingQuoted(source[at:], name_limit)
        if !quoted.valid { result.error = .UsingEntry; return result }
        name := quoted.value
        at = Text.SkipSpace(source, at + quoted.end, false)
        mapped := ""
        if prefix == "M:" {
            if at >= source.count || source[at] != #char "=" { result.error = .UsingMap; return result }
            at = Text.SkipSpace(source, at + 1, false)
            quoted = UsingQuoted(source[at:], name_limit)
            if !quoted.valid { result.error = .UsingMap; return result }
            mapped = quoted.value
            at = Text.SkipSpace(source, at + quoted.end, false)
        }
        if entries > 0 { Put(output, *result.count, ",") }
        Put(output, *result.count, name)
        if prefix == "M:" { Put(output, *result.count, "="); Put(output, *result.count, mapped) }
        entries += 1
        if at >= source.count || source[at] != #char "," { break }
        at = Text.SkipSpace(source, at + 1, false)
    }
    if entries == 0 || at >= source.count || source[at] != #char ")" {
        result.error = .UsingList
        return result
    }
    result.next = Text.SkipSpace(source, at + 1, false)
    return result
}

#scope_file
UsingQuoted :: (source: string, limit: s64) -> QuotedText {
    if source.count == 0 || source[0] != #char "\"" { return .{} }
    at: s64 = 1
    while at < source.count && source[at] != #char "\"" && source[at] != 0 { at += 1 }
    if at == source.count || source[at] != #char "\"" || at == 1 || at - 1 >= limit { return .{} }
    return .{true, source[1:at], at + 1}
}
#scope_export

ProgramExport :: (source: string, symbol_limit: s64) -> ExportDirective {
    result: ExportDirective
    if !Source.StartsWord(source, "#program_export") { return result }
    at := Text.SkipSpace(source, 15, true)
    if at < source.count && source[at] == #char "\"" {
        quoted := Quoted(source[at:], symbol_limit)
        if !quoted.valid { result.error = .ExportQuote; return result }
        result.symbol = quoted.value
        if !Source.IdentifierText(result.symbol, false) { result.error = .ExportName; return result }
        at = Text.SkipSpace(source, at + quoted.end, true)
    }
    result.kind = 1
    if at < source.count { result.kind = 2 }
    result.body = source[at:]
    return result
}

// A short output receives its prefix, while count measures the complete
// normalized text. Source and output must not overlap: comma spacing can grow.
RewriteParameters :: (source: string, output: []u8, strip_defaults: bool,
    strip_using: bool, name_limit: s64) -> ParameterRewrite {
    result: ParameterRewrite
    if Text.SkipSpace(source, 0, true) == source.count { return result }
    at: s64 = 0
    while at >= 0 {
        if result.parameters == 64 { result.error = .Parameters; return result }
        range := Text.NextSourcePart(source, at)
        part := Trim(source[range.begin:range.end])
        if strip_defaults {
            assignment := Text.TopLevelAssignment(part)
            if assignment >= 0 {
                if Text.SkipSpace(part, assignment + 1, true) == part.count {
                    result.error = .DefaultValue
                    return result
                }
                part = Trim(part[0:assignment])
                result.has_defaults = true
            }
        }
        if strip_using && Source.StartsWord(part, "using") {
            if part.count <= 5 || !Text.SpaceByte(part[5]) { result.error = .UsingModifier; return result }
            part = Trim(part[5:])
            colon := Find(part, ":")
            if colon <= 0 || colon >= name_limit { result.error = .UsingType; return result }
            if !Source.IdentifierText(Trim(part[0:colon]), false) { result.error = .UsingName; return result }
            result.using_parameters |= cast(u64)1 << cast(u64)result.parameters
        }
        if result.parameters > 0 { Put(output, *result.count, ", ") }
        Put(output, *result.count, part)
        result.parameters += 1
        at = range.next
    }
    return result
}

ImportDeclaration :: (source: string, name_limit: s64, path_limit: s64) -> ModuleImport {
    result: ModuleImport
    directive := Find(source, "#import")
    if directive < 0 { return result }
    body := source
    result.using_import = Source.StartsWord(source, "using")
    if result.using_import {
        body = source[Text.SkipSpace(source, 5, true):]
        if body.count == 0 || !Source.IdentifierText(body[0:1], false) { return result }
    }
    result.present = true
    quoted := Quoted(source[directive:], path_limit)
    if !quoted.valid { result.error = .ImportQuote; return result }
    result.target = quoted.value
    for byte: result.target {
        if byte == #char "\"" || byte == #char ">" || byte < 0x20 {
            result.error = .ImportCharacter
            return result
        }
    }
    mode := source[Text.SkipSpace(source, directive + 7, true):]
    if mode.count > 0 && mode[0] == #char "," {
        mode = mode[Text.SkipSpace(mode, 1, true):]
        keyword: s64 = 0
        if mode.count > 3 && mode[0:3] == "dir" && Text.SpaceByte(mode[3]) {
            result.mode = .Directory
            keyword = 3
        } else if mode.count > 4 && mode[0:4] == "file" && Text.SpaceByte(mode[4]) {
            result.mode = .File
            keyword = 4
        } else { result.error = .ImportMode; result.detail = mode; return result }
        argument := mode[Text.SkipSpace(mode, keyword, true):]
        path := Quoted(argument, path_limit)
        if argument.count == 0 || argument[0] != #char "\"" || !path.valid ||
        argument[Text.SkipSpace(argument, path.end, true):] != ";" {
            result.error = .ImportFileSyntax
            if result.mode == .Directory { result.error = .ImportDirSyntax }
            return result
        }
        result.name = SymbolBeforeColons(source, name_limit)
        result.named = result.name.count > 0
        result.path = result.target
        valid := result.path.count > 0 && result.path[0] != #char "/"
        if result.mode == .Directory {
            valid = valid && Find(result.path, "\\") < 0 && result.path[result.path.count - 1] != #char "/"
        } else { valid = valid && result.path.count >= 4 && result.path[result.path.count - 3:] == ".zi" }
        if !valid {
            result.error = .ImportFilePath
            if result.mode == .Directory { result.error = .ImportDirPath }
            return result
        }
        stem := Basename(result.path)
        if result.mode == .File { stem = stem[0:stem.count - 3] }
        if stem.count >= name_limit || !Source.IdentifierText(stem, false) {
            result.error = .ImportFileName
            if result.mode == .Directory { result.error = .ImportDirName }
            return result
        }
        if !result.named { result.name = stem }
        result.target = stem
    } else {
        result.name = SymbolBeforeColons(body, name_limit)
        result.named = result.name.count > 0
        if !result.named {
            slash := Find(result.target, "/")
            if slash < 0 { result.name = result.target }
            else { result.name = result.target[slash + 1:] }
            if result.name.count >= name_limit { result.name = result.name[0:name_limit - 1] }
        }
    }
    if result.named && !Source.IdentifierText(result.name[0:1], false) { result.error = .ImportAlias; return result }
    slash := Find(result.target, "/")
    if slash < 0 {
        if !Source.IdentifierText(result.target, false) { result.error = .ImportTarget; return result }
    } else {
        package := result.target[0:slash]
        module := result.target[slash + 1:]
        next := Find(module, "/")
        first := module
        if next >= 0 { first = module[0:next] }
        if !Source.IdentifierText(package, false) || !Source.IdentifierText(first, false) {
            result.error = .ImportTarget
            return result
        }
        if next >= 0 { result.error = .ImportPackage; return result }
    }
    if result.using_import && !result.named { result.error = .ImportUsing }
    return result
}

SystemLibrary :: (source: string, name_limit: s64, path_limit: s64) -> LibraryDeclaration {
    result: LibraryDeclaration
    result.name = SymbolBeforeColons(source, name_limit)
    if result.name.count == 0 { return result }
    declaration := source[Text.SkipSpace(source, Find(source, "::") + 2, true):]
    if !Source.StartsWord(declaration, "#system_library") { return result }
    result.present = true
    argument := declaration[Text.SkipSpace(declaration, 15, true):]
    quoted := Quoted(argument, path_limit)
    if argument.count == 0 || argument[0] != #char "\"" || !quoted.valid || quoted.value.count == 0 {
        result.error = .LibraryQuote
        return result
    }
    result.target = quoted.value
    if argument[Text.SkipSpace(argument, quoted.end, true):] != ";" { result.error = .LibraryEnd; return result }
    for byte: result.target {
        if byte < 0x20 || byte == #char "\"" || byte == #char "\\" { result.error = .LibraryCharacter; return result }
    }
    return result
}

ForeignMethod :: (source: string, receiver_limit: s64, method_limit: s64, python: bool) -> MethodSymbol {
    result: MethodSymbol
    dot := Find(source, ".")
    if dot <= 0 { return result }
    result.receiver = source[0:dot]
    result.method = source[dot + 1:]
    if source[0] == #char "(" {
        if result.receiver.count < 3 || result.receiver[result.receiver.count - 1] != #char ")" { return result }
        result.receiver = result.receiver[1:result.receiver.count - 1]
    } else if python { return result }
    if result.receiver.count >= receiver_limit || result.method.count >= method_limit { return result }
    name := result.receiver
    if name.count > 0 && name[0] == #char "*" {
        if python { return result }
        name = name[1:]
    }
    result.valid = Source.IdentifierText(name, false) && Source.IdentifierText(result.method, false)
    return result
}

PythonAttribute :: (source: string, name_limit: s64) -> bool {
    at: s64 = 0
    while at <= source.count {
        end := Find(source[at:], ".")
        if end < 0 { end = source.count - at }
        part := source[at:at + end]
        if part.count >= name_limit || !Source.IdentifierText(part, false) { return false }
        at += end
        if at == source.count { return true }
        at += 1
    }
    return false
}

// Directives are tokens, so quoted defaults and alternate symbols cannot
// masquerade as modifiers. Every returned spelling borrows the bounded input.
ParseForeign :: (source: string, name_limit: s64 = 128) -> ForeignDeclaration {
    result: ForeignDeclaration
    result.name = SymbolBeforeColons(source, name_limit)
    if result.name.count == 0 { return result }
    declaration := source[Text.SkipSpace(source, Find(source, "::") + 2, true):]
    attributes: [6]s32
    after_foreign: [6]bool
    directive: s64 = -1
    body := false
    at: s64 = 0
    while at < declaration.count {
        token := Scan.NextToken(declaration, at, 1, 1)
        if token.kind == Scan.TokenKind.Eof { break }
        spelling := declaration[token.begin:token.end]
        if spelling == "/" && token.end < declaration.count && declaration[token.end] == #char "/" { break }
        if spelling == "{" { body = true }
        if token.kind == Scan.TokenKind.Directive {
            if spelling == "#foreign" && directive < 0 { directive = token.begin }
            attribute: s64 = -1
            if spelling == "#go_results" { attribute = 0 }
            if spelling == "#go_field" { attribute = 1 }
            if spelling == "#go_defer" { attribute = 2 }
            if spelling == "#go_variadic" { attribute = 3 }
            if spelling == "#py_results" { attribute = 4 }
            if spelling == "#py_field" { attribute = 5 }
            if attribute >= 0 {
                attributes[attribute] += 1
                if directive >= 0 { after_foreign[attribute] = true }
            }
        }
        at = token.end
    }
    if directive < 0 { return result }
    result.present = true
    result.is_type = Source.StartsWord(declaration, "#type")
    result.go_results = attributes[0] > 0
    result.go_field = attributes[1] > 0
    result.go_defer = attributes[2] > 0
    result.go_variadic = attributes[3] > 0
    result.py_results = attributes[4] > 0
    result.py_field = attributes[5] > 0
    if result.go_results && (result.is_type || attributes[0] > 1 || after_foreign[0]) {
        result.error = .ForeignResults
        return result
    }
    if result.go_field && (result.is_type || result.go_results || attributes[1] > 1 || after_foreign[1]) {
        result.error = .ForeignField
        return result
    }
    if result.go_defer && (result.is_type || result.go_results || result.go_field || attributes[2] > 1 || after_foreign[2]) {
        result.error = .ForeignDefer
        return result
    }
    if result.go_variadic && (result.is_type || result.go_field || attributes[3] > 1 || after_foreign[3]) {
        result.error = .ForeignVariadic
        return result
    }
    if (result.py_results || result.py_field) &&
    (result.is_type || result.go_results || result.go_field || result.go_defer || result.go_variadic ||
    (result.py_results && result.py_field) || attributes[4] > 1 || attributes[5] > 1 || after_foreign[4] || after_foreign[5]) {
        result.error = .ForeignPythonAttributes
        return result
    }
    if result.is_type && Text.SkipSpace(declaration, 5, true) != directive {
        result.error = .ForeignType
        return result
    }
    if !result.is_type && (declaration.count == 0 || declaration[0] != #char "(") {
        result.present = false
        return result
    }
    if body { result.error = .ForeignBody; return result }
    at = Text.SkipSpace(declaration, directive + 8, true)
    begin := at
    while at < declaration.count && Text.IdentifierByte(declaration[at]) { at += 1 }
    result.library = declaration[begin:at]
    if result.library.count >= name_limit || !Source.IdentifierText(result.library, false) {
        result.error = .ForeignLibrary
        return result
    }
    at = Text.SkipSpace(declaration, at, true)
    result.symbol = result.name
    if at < declaration.count && declaration[at] == #char "\"" {
        quoted := UsingQuoted(declaration[at:], name_limit)
        if !quoted.valid { result.error = .ForeignSymbol; return result }
        result.symbol = quoted.value
        at = Text.SkipSpace(declaration, at + quoted.end, true)
    }
    if Trim(declaration[at:]) != ";" { result.error = .ForeignEnd }
    return result
}

// As with other compiler rewrites, an empty output measures storage and a
// shorter one receives only its prefix. The C boundary owns termination.
ResolveForeignTarget :: (declaration: ForeignDeclaration, library: string,
    output: []u8, name_limit: s64 = 128) -> ForeignTarget {
    result: ForeignTarget
    result.error = declaration.error
    if result.error != .None || !declaration.present { return result }
    python := library.count >= 3 && library[0:3] == "py:"
    go := library.count >= 3 && library[0:3] == "go:"
    method: MethodSymbol
    if !declaration.is_type && (go || python) {
        method = ForeignMethod(declaration.symbol, name_limit, name_limit, python)
    }
    if !Source.IdentifierText(declaration.symbol, false) && !method.valid &&
    !(python && PythonAttribute(declaration.symbol, name_limit)) {
        result.error = .ForeignSymbol
        if python { result.error = .ForeignPythonSymbol }
        return result
    }
    if library == "host_api" {
        if declaration.symbol != declaration.name { result.error = .ForeignHostRename }
    } else if method.valid {
        Put(output, *result.count, library)
        if python { Put(output, *result.count, "/(") }
        else { Put(output, *result.count, ".(") }
        Put(output, *result.count, method.receiver)
        Put(output, *result.count, ").")
        Put(output, *result.count, method.method)
    } else if python {
        Put(output, *result.count, library)
        Put(output, *result.count, "/")
        Put(output, *result.count, declaration.symbol)
    } else if go || Find(library, "/") >= 0 {
        Put(output, *result.count, library)
        Put(output, *result.count, ".")
        Put(output, *result.count, declaration.symbol)
    } else {
        Put(output, *result.count, "c.")
        Put(output, *result.count, declaration.symbol)
    }
    if result.error != .None { return result }
    if declaration.go_results && !go { result.error = .ForeignGoResults }
    else if declaration.go_field && !go { result.error = .ForeignGoField }
    else if declaration.go_defer && !go { result.error = .ForeignGoDefer }
    else if declaration.go_variadic && !go { result.error = .ForeignGoVariadic }
    else if declaration.py_results && !python { result.error = .ForeignPythonResults }
    else if declaration.py_field && !python { result.error = .ForeignPythonField }
    return result
}

ForeignVarargs :: (parameters: string) -> bool {
    if Trim(parameters).count == 0 { return false }
    at: s64 = 0
    last := ""
    while at >= 0 {
        range := Text.NextSourcePart(parameters, at)
        last = Trim(parameters[range.begin:range.end])
        at = range.next
    }
    colon := Find(last, ":")
    if colon >= 0 { last = Trim(last[colon + 1:]) }
    return last == "..any"
}
