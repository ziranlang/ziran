        tail: ParserArray100_u8
        count: s32 = snprintf(cast(*u8)(*((tail).items)), cast(usize)size_of(ParserArray100_u8), ParserCString(",\"truncation\":{\"message\":%s,\"metadata\":%s}}\n"), (ifx (clipped != 0) then ParserCString("true") else ParserCString("false")), (ifx (omitted != 0) then ParserCString("true") else ParserCString("false")))
        memcpy(cast(*void)(cast(*u8)(cast(usize)(cast(*u8)(*(((out).bytes).items))) + cast(usize)((out).count) * size_of(u8))), cast(*void)(cast(*u8)(*((tail).items))), cast(usize)(count))
        (out).count += cast(usize)(count)
        if (json != 0) {
            fwrite(cast(*void)(cast(*u8)(*(((out).bytes).items))), cast(usize)(1), (out).count, CompilerStandardError())
        }
        if ((diagnostic_collecting != 0) && (collector_room(((out).count + cast(usize)(((ifx (diagnostic_collector_entries != 0) then 1 else 0))))) != 0)) {
            if (diagnostic_collector_entries != 0) {
                (diagnostic_collector)[S15SupportPost4(*(diagnostic_collector_count))] = cast(u8)(44)
            }
            memcpy(cast(*void)(cast(*u8)(cast(usize)(diagnostic_collector) + cast(usize)(diagnostic_collector_count) * size_of(u8))), cast(*void)(cast(*u8)(*(((out).bytes).items))), (out).count)
            diagnostic_collector_count += (out).count
            S15SupportPost1(*(diagnostic_collector_entries))
        }
    }
    if (!(json != 0) && (cast(s32)(cast(s8)((SpanPath(span))[0])) != 0)) {
        fprintf(CompilerStandardError(), ParserCString("%s:%d:%d: %s%s\n"), SpanPath(span), (span).line, (span).column, (ifx (warning != 0) then ParserCString("warning: ") else ParserCString("")), cast(*u8)(*(((buffers).message).items)))
    } else {
        if !(json != 0) {
            fprintf(CompilerStandardError(), ParserCString("ziran: %s%s\n"), (ifx (warning != 0) then ParserCString("warning: ") else ParserCString("")), cast(*u8)(*(((buffers).message).items)))
        }
    }
    if !(json != 0) { source_excerpt(span, details, cast(*u8)(*(((buffers).message).items))) }
    if (((!(json != 0) && (details != null)) && ((details).related_message != null)) && (((details).related_span).line > 0)) {
        fprintf(CompilerStandardError(), ParserCString("%s:%d:%d: note: %s\n"), SpanPath((details).related_span), ((details).related_span).line, ((details).related_span).column, (details).related_message)
    }
    S15FlagClear(cast(*void)(*(diagnostic_diagnostic_lock)))
}

#scope_export
#program_export "S15DiagnosticMessage"
S15DiagnosticMessage :: (span: IR.ZirSourceSpan, severity: *u8, code: *u8, details: *Check.DiagnosticDetails, message: *u8, length: s32) {
    buffers: *DiagnosticVBuffers = alloc_buffers()
    report(span, severity, code, details, message, length, buffers)
    free(cast(*void)(buffers))
}

#scope_export
#program_export "DiagnosticErrorCount"
DiagnosticErrorCount :: () -> s32 {
    return S15IntLoad(cast(*void)(*(diagnostic_diagnostic_errors)))
    unreachable
}

#scope_export
#program_export "DiagnosticCountReportedError"
DiagnosticCountReportedError :: () {
    S15IntAdd(cast(*void)(*(diagnostic_diagnostic_errors)), 1)
}

#scope_export
#program_export "DiagnosticEnsureFailureReported"
DiagnosticEnsureFailureReported :: (status: s32, command: *u8) -> s32 {
    if ((status != 0) && (DiagnosticErrorCount() == 0)) {
        Diagnostic(IR.ZirSourceSpan.{cast(*u8)(null), 0, 0, 0, 0, 0}, ParserCString("compiler.internal"), ParserCString("%s failed without reporting a cause; this is a compiler bug"), command)
    }
    return status
    unreachable
}

#scope_file
S15PlatformDiagnosticLog :: (warning: s32, path: *u8, line: s32, column: s32, message: *u8, code: *u8) #foreign compiler "S15PlatformDiagnosticLog";
