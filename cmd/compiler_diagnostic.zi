    // Keep tabs so the caret lines up under tab-indented code.
    for i: 0..span.column - 2 { caret[at] = ifx text[i] == 9 then cast(u8)9 else cast(u8)32; at += 1 }
    width: s32 = ifx span.end_line == span.line && span.end_column > span.column then span.end_column - span.column else 1
    if span.column - 1 + width > length { width = length - (span.column - 1) }
    if width < 1 { width = 1 }
    for 1..width { caret[at] = 94; at += 1 }
    caret[at] = 0
    fprintf(stream, ParserCString("    %s\n    %s\n"), text, caret)
}

