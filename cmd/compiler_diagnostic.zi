SourceLine :: struct { text: [1024]u8; caret: [1100]u8; }

// Text mode, under the message: the source line with a caret under the
// span, the expected and actual types when the message does not already
// name them, and the suggested fix. JSON carries the same facts as fields.
source_excerpt :: (span: IR.ZirSourceSpan, details: *Check.DiagnosticDetails, message: *u8) {
    stream := CompilerStandardError()
    path := SpanPath(span)
    document: *Check.ZirDocument = ifx details != null then (details).document else null
    if document == null { document = DocumentWithSuffix(path) }
    if document != null && (document).rewritten == 0 {
        // Documents are keyed by the root-joined path, which opens from any directory.
        whole := IR.ZirSourceSpan.{cast(*u8)(document).context, (document).file, 0, 0, 0, 0}
        if SpanPath(whole)[0] != 0 { path = SpanPath(whole) }
    }
    if (document == null || (document).rewritten == 0) && span.line > 0 && span.column > 0 && path[0] != 0 {
        line := cast(*SourceLine)malloc(size_of(SourceLine))
        if line != null {
            if read_source_line(path, span.line, cast(*u8)*(line).text, 1024) {
                print_caret(stream, span, line)
            }
            free(cast(*void)line)
        }
    }
    if details == null { return }
    if (details).expected_type != null && (details).actual_type != null && strstr(message, ParserCString("expected ")) == null {
        fprintf(stream, ParserCString("  expected %s, found %s\n"), (details).expected_type, (details).actual_type)
    }
    if (details).replacement != null && (details).original != null {
        fprintf(stream, ParserCString("  fix: replace %s with %s\n"), (details).original, (details).replacement)
    }
}

// Line NUMBER of the file at PATH into TEXT without its newline; false when
// the file cannot be read or the line is longer than TEXT holds.
read_source_line :: (path: *u8, number: s32, text: *u8, size: s32) -> bool {
    file := fopen(path, ParserCString("rb"))
    if file == null { return false }
    current: s32 = 0
    found := false
    while fgets(text, size, file) != null {
        length := strlen(text)
        whole := length > 0 && text[length - 1] == 10
        if !whole && length + 1 >= cast(usize)size {
            // Longer than TEXT holds: skip the rest of the line.
            while !whole && fgets(text, size, file) != null {
                length = strlen(text)
                whole = length > 0 && text[length - 1] == 10
            }
            current += 1
            if current == number || !whole { break }
            continue
        }
        current += 1
        if current == number {
            if whole { text[length - 1] = 0 }
            if whole && length > 1 && text[length - 2] == 13 { text[length - 2] = 0 }
            found = true
            break
        }
    }
    fclose(file)
    return found
}

print_caret :: (stream: *void, span: IR.ZirSourceSpan, line: *SourceLine) {
    text := cast(*u8)*(line).text
    length := cast(s32)strlen(text)
