        while check_loop_12 := (i < cast(usize)size_of(S14.ParserArray32_u8)) {
            (hex)[(i * cast(usize)(2))] = (document_DocumentDigest_digits).items[(cast(s32)((digest).items[i]) >> 4)]
            (hex)[((i * cast(usize)(2)) + cast(usize)(1))] = (document_DocumentDigest_digits).items[(cast(s32)((digest).items[i]) & 15)]
            S15SupportPost4(*(i))
        }
    }
    (hex)[64] = cast(u8)(0)
}

#scope_file
find_document :: (path: *u8) -> *Check.ZirDocument {
    if ((path == cast(*u8)((null))) || !((path)[0] != 0)) {
        return null
    }
    {
        item: *Check.ZirDocument = (documents()).head
        while check_loop_13 := (item != null) {
            source: IR.ZirSourceSpan = .{cast(*u8)(cast(*CompilerContext)((item).context)), (item).file, 0, 0, 0, 0}
            if !(strcmp(SpanPath(source), path) != 0) {
                return item
            }
            item = (item).next
        }
    }
    return null
    unreachable
}

#scope_export
#program_export "DocumentFind"
DocumentFind :: (path: *u8) -> *Check.ZirDocument {
    return find_document(path)
    unreachable
}

#scope_export
#program_export "DocumentForSpan"
DocumentForSpan :: (module: *IR.ZirModule, span: IR.ZirSourceSpan) -> *Check.ZirDocument {
    if (!(module != null) || !(cast(*Check.ZirDocument)((module).document) != null)) {
        return null
    }
    if !(strcmp(SpanPath(span), cast(*u8)(*((module).source_path))) != 0) {
        return cast(*Check.ZirDocument)((module).document)
    }
    path: Parser.ParserArray1024_u8
    source: *u8 = SpanPath(span)
    if (snprintf(cast(*u8)(*((path).items)), cast(usize)size_of(Parser.ParserArray1024_u8), ParserCString("%s%s%s"), (ifx (cast(s32)(cast(s8)((source)[0])) == 47) then ParserCString("") else cast(*u8)(*((module).source_root))), (ifx ((cast(s32)(cast(s8)((source)[0])) == 47) || !(((module).source_root)[0] != 0)) then ParserCString("") else ParserCString("/")), source) >= cast(s32)(cast(usize)size_of(Parser.ParserArray1024_u8))) {
        return null
    }
    previous: *CompilerContext = CompilerContextSelect(cast(*CompilerContext)((module).context))
    document: *Check.ZirDocument = DocumentFind(cast(*u8)(*((path).items)))
    CompilerContextSelect(previous)
    return document
    unreachable
}

#scope_export
#program_export "DocumentMarkRewritten"
DocumentMarkRewritten :: (path: *u8) {
    document: *Check.ZirDocument = find_document(path)
    if (document != null) {
        (document).rewritten = 1
    }
}

#scope_export
#program_export "DocumentRecord"
DocumentRecord :: (path: *u8, bytes: *u8, count: usize) -> *Check.ZirDocument {
    memory: *void = CompilerMemoryPause()
    hash: Check.CheckArray65_u8
    DocumentDigest(cast(*void)(bytes), count, cast(*u8)(*((hash).items)))
    previous: *Check.ZirDocument = DocumentFind(path)
    if (((previous != null) && ((previous).bytes == count)) && !(strcmp(cast(*u8)(*(((previous).sha256).items)), cast(*u8)(*((hash).items))) != 0)) {
        CompilerMemoryResume(memory)
        return previous
    }
    store: *DocumentStore = documents()
    if ((store).count >= cast(usize)(4096)) {
        CompilerMemoryResume(memory)
        return null
    }
    lines: usize = cast(usize)(1)
    {
        i: usize = cast(usize)(0)
        while check_loop_14 := (i < count) {
            if (cast(s32)(cast(s8)((bytes)[i])) == 10) {
                S15SupportPost4(*(lines))
            }
            S15SupportPost4(*(i))
        }
    }
    item: *Check.ZirDocument = cast(*Check.ZirDocument)(CompilerCalloc(cast(usize)(1), cast(usize)size_of(Check.ZirDocument)))
    if (item == cast(*Check.ZirDocument)((null))) {
        DiagnosticOutOfMemory()
        exit(1)
    }
    offset_bytes: usize = (ifx (lines <= ((cast(usize)(cast(u64)18446744073709551615)) / cast(usize)size_of(usize))) then (lines * cast(usize)size_of(usize)) else (cast(usize)(cast(u64)18446744073709551615)))
    if ((offset_bytes <= cast(usize)((1024 * 1024))) && (offset_bytes <= (cast(usize)(((8 * 1024) * 1024)) - (store).bytes))) {
        (item).line_offsets = cast(*usize)(CompilerMalloc(offset_bytes))
        if ((item).line_offsets == cast(*usize)((null))) {
            CompilerFree(cast(*void)(item))
            DiagnosticOutOfMemory()
            exit(1)
        }
        ((item).line_offsets)[0] = cast(usize)(0)
        line: usize = cast(usize)(1)
        {
            i: usize = cast(usize)(0)
            while check_loop_15 := (i < count) {
                if (cast(s32)(cast(s8)((bytes)[i])) == 10) {
                    ((item).line_offsets)[S15SupportPost4(*(line))] = (i + cast(usize)(1))
                }
                S15SupportPost4(*(i))
            }
        }
        (store).bytes += offset_bytes
    }
    S15SupportPost4(*((store).count))
    (item).context = cast(*void)(CompilerContextCurrent())
    (item).file = SourceFile(path)
    memcpy(cast(*void)(cast(*u8)(*(((item).sha256).items))), cast(*void)(cast(*u8)(*((hash).items))), cast(usize)size_of(Check.CheckArray65_u8))
    (item).bytes = count
    (item).line_count = lines
    (item).next = (documents()).head
    (documents()).head = item
    CompilerMemoryResume(memory)
    return item
    unreachable
}

#scope_export
#program_export "DocumentOffset"
DocumentOffset :: (document: *Check.ZirDocument, line: s32, column: s32, offset: *usize) -> s32 {
    if ((((((document == cast(*Check.ZirDocument)((null))) || ((document).rewritten != 0)) || ((document).line_offsets == cast(*usize)((null)))) || (line < 1)) || (column < 1)) || (cast(usize)(line) > (document).line_count)) {
        return 0
    }
    begin: usize = ((document).line_offsets)[(line - 1)]
    end: usize = (ifx (cast(usize)(line) < (document).line_count) then (((document).line_offsets)[line] - cast(usize)(1)) else (document).bytes)
    if ((cast(usize)(column) - cast(usize)(1)) > (end - begin)) {
        return 0
    }
    S15SupportSet0(offset, ((begin + cast(usize)(column)) - cast(usize)(1)))
    return 1
    unreachable
}
