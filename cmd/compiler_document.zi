#scope_file
free_documents :: (value: *void) {
    item: *Check.ZirDocument = ((cast(*DocumentStore)(value))).head
    while check_loop_11 := (item != null) {
        next: *Check.ZirDocument = (item).next
        CompilerFree(cast(*void)((item).line_offsets))
        CompilerFree(cast(*void)(item))
        item = next
    }
}

#scope_file
documents :: () -> *DocumentStore {
    return cast(*DocumentStore)(CompilerCurrentStorage(1, cast(usize)size_of(DocumentStore), free_documents))
    unreachable
}

