// The pieces every direct native encoder shares: the measuring and writing
// passes' bookkeeping (Fail, Spend, Count, Emit, Probe), operand and type
// lookups, block and function targets, relocation records, the layout arrays
// and the global image writer. Procedures over the encoder state take it as
// *$S, so each target keeps its own State record and gets its own copy.
using Bytes :: #import "compiler_arm_bytes"
using Image :: #import "compiler_machine_image"
using Machine :: #import "compiler_machine_ir"
using Vectors :: #import "std/vec"

CodeLimit :: 2147483647

Layout :: struct {
    function_begin: Vec(s64)
    function_body: Vec(s64)
    function_end: Vec(s64)
    block_begin: Vec(s64)
    instruction_begin: Vec(s64)
    instruction_end: Vec(s64)
    relocation_of: Vec(s32)
}

NoDiagnostic :: () -> MachineDiagnostic {
    return .{problem = .None, function = MachineNoId, block = MachineNoId,
        instruction = MachineNoId, operand = MachineNoId, virtual = MachineNoId}
}

// A polymorphic default cannot name an import yet: -1 is MachineNoId.
Fail :: (state: *$S, problem: MachineProblem, operand: s32 = -1) -> bool {
    if state.diagnostic.problem == .None {
        value: s32 = MachineNoId
        if operand >= 0 && operand < state.program.operands.count { value = state.program.operands[operand].value }
        state.diagnostic = .{problem = problem, function = state.function, block = state.block,
            instruction = state.instruction, operand = operand, virtual = value}
    }
    return false
}

Spend :: (state: *$S, count: s64) -> bool {
    if count < 0 || count > state.remaining { return Fail(state, .Limit) }
    state.remaining -= count
    state.used += count
    return true
}

LayoutFree :: (layout: *Layout) {
    VecFree(layout.function_begin)
    VecFree(layout.function_body)
    VecFree(layout.function_end)
    VecFree(layout.block_begin)
    VecFree(layout.instruction_begin)
    VecFree(layout.instruction_end)
    VecFree(layout.relocation_of)
}

Filled :: (values: *Vec(s64), count: s64) -> bool {
    if !VecResizeBounded(<<values, count, count) { return false }
    for index: cast(s64)0..count - 1 { (<<values)[index] = -1 }
    return true
}

Current :: (state: *$S) -> MachineInstruction {
    return state.program.instructions[state.instruction]
}

OperandId :: (state: *$S, local: s32) -> s32 {
    return Current(state).operand_begin + local
}

OperandAt :: (state: *$S, local: s32) -> MachineOperand {
    return state.program.operands[OperandId(state, local)]
}

TypeOf :: (state: *$S, operand: MachineOperand) -> MachineType {
    return state.program.types[state.program.virtuals[operand.value].type]
}

TypeIdOf :: (state: *$S, operand: MachineOperand) -> s32 {
    if operand.value >= 0 { return state.program.virtuals[operand.value].type }
    if operand.type >= 0 { return operand.type }
    if operand.kind == .StackObject { return state.program.stack_objects[operand.id].type }
    return MachineNoId
}

// One 32-bit encoding word in measure or write mode.
Emit :: (state: *$S, word: u32) {
    if state.diagnostic.problem != .None { return }
    Bytes.ArmWord(*state.writer, word)
}

// Adds a byte offset to a frame-relative memory operand.
AtOffset :: (memory: $M, offset: s64) -> M {
    memory.displacement += offset
    return memory
}

StackArgumentSize :: (value: s64) -> s64 {
    if value < 0 || value > 9223372036854775799 { return -1 }
    return (value + 7) & ~cast(s64)7
}

Count :: (state: *$S, count: s32) -> bool {
    if Current(state).operand_count != count { return Fail(state, .Unsupported) }
    return true
}

NextBlock :: (state: *$S) -> s32 {
    function := state.program.functions[state.function]
    if state.block + 1 < function.block_begin + function.block_count { return state.block + 1 }
    return MachineNoId
}

BlockTarget :: (state: *$S, block: s32) -> s64 {
    return state.block_begin[block]
}

FunctionTarget :: (state: *$S, function: s32) -> s64 {
    return state.function_begin[function]
}

ProbeSaved :: struct { writer: Bytes.ArmWriter; relocations: s64 }

// Measures a sequence without writing it or recording its relocations, so a
// branch can skip it.
Probe :: (state: *$S) -> ProbeSaved {
    saved := ProbeSaved.{writer = state.writer, relocations = state.relocation_count}
    empty: []u8
    state.writer = .{output = empty, at = saved.writer.at, limit = saved.writer.limit}
    return saved
}

Unprobe :: (state: *$S, saved: ProbeSaved) -> s64 {
    length := state.writer.at - saved.writer.at
    failed := state.writer.failed
    state.writer = saved.writer
    state.relocation_count = saved.relocations
    if failed { state.writer.failed = true }
    return length
}

Copy :: (destination: *Vec(s64), source: []s64) -> bool {
    if !VecResizeBounded(<<destination, source.count, source.count) { return false }
    for index: cast(s64)0..source.count - 1 { (<<destination)[index] = source[index] }
    return true
}

AlignValue :: (value: s64, alignment: s32) -> s64 {
    return (value + alignment - 1) & ~cast(s64)(alignment - 1)
}

PutSectionLittle :: (bytes: []u8, at: s64, value: u64, count: s64) {
    for index: cast(s64)0..count - 1 {
        bytes[at + index] = cast(u8)((value >> cast(u64)(index * 8)) & 255)
    }
}

// Writes one global's initializer bytes into its image section.
WriteGlobalImage :: (program: MachineProgram, global_id: s32, bytes: []u8, at: s64) -> bool {
    global := program.globals[global_id]
    if global.constant < 0 { return global.writable }
    constant := program.constants[global.constant]
    size := program.types[global.type].size
    if constant.bytes_count == 0 {
        if size > 8 { return false }
        PutSectionLittle(bytes, at, constant.bits, size)
        return true
    }
    if constant.bytes_count != size { return false }
    for index: cast(s64)0..size - 1 {
        bytes[at + index] = program.data[constant.bytes_begin + index]
    }
    return true
}

// The codes a native encoder materializes before it calls the trap handler.
NativeTrapReserved :: 0xffff0000
NativeTrapUnreachable :: 0xffff0001
NativeTrapDivideByZero :: 0xffff0002
NativeTrapShift :: 0xffff0003
NativeTrapFuel :: 0xffff0004
NativeTrapConversion :: 0xffff0005
NativeTrapStack :: 0xffff0006
NativeTrapStorage :: 0xffff0007
NativeTrapPointer :: 0xfffeffff

// Relocations, numbered alike on every target; the image builder maps each
// to its machine-image kind and field width.
NativeRelocationKind :: enum s32 {
    Invalid; GlobalAddress; ConstantAddress; FuelCounter; TrapHandler; PlatformService; HostCapability; RuntimeResize; FunctionAddress
    StackLimit; PointerRuntime; RuntimeHelper
}

NativeRelocation :: struct {
    offset: s64
    kind: NativeRelocationKind
    symbol: s32
    addend: s64
    instruction: s32
}

Relocate :: (state: *$S, kind: NativeRelocationKind, symbol: s32, addend: s64, field: s64) {
    if state.emit && state.relocation_count < state.relocations.count {
        state.relocations[state.relocation_count] = .{offset = field, kind = kind, symbol = symbol,
            addend = addend, instruction = state.instruction}
    }
    state.relocation_count += 1
}

// Maps encoder relocations onto image relocations.
ImageRelocationKind :: (kind: NativeRelocationKind) -> Image.MachineRelocationKind {
    if kind == .FunctionAddress { return .FunctionAddress }
    if kind == .GlobalAddress { return .GlobalAddress }
    if kind == .ConstantAddress { return .ConstantAddress }
    if kind == .FuelCounter { return .FuelCounter }
    if kind == .TrapHandler { return .RuntimeTrap }
    if kind == .PlatformService { return .PlatformService }
    if kind == .HostCapability { return .HostCapability }
    if kind == .RuntimeResize { return .RuntimeResize }
    if kind == .StackLimit { return .StackLimit }
    if kind == .PointerRuntime { return .PointerRuntime }
    if kind == .RuntimeHelper { return .RuntimeHelper }
    return .Invalid
}

// Symbolic addresses materialize as halfword fields; direct calls, trap
// dispatch and the runtime resize call patch whole words.
ImageRelocationWidth :: (kind: NativeRelocationKind) -> s32 {
    if kind == .GlobalAddress || kind == .ConstantAddress ||
        kind == .FunctionAddress || kind == .FuelCounter ||
        kind == .StackLimit || kind == .PointerRuntime { return 2 }
    return 4
}

// Finds the machine operand of the source relocation matching the image
// relocation's kind, or any relocation for the runtime trap handler.
ImageOperand :: (program: MachineProgram, relocation: NativeRelocation,
    kind: Image.MachineRelocationKind) -> s32 {
    for source: program.relocations {
        if source.instruction != relocation.instruction || source.symbol != relocation.symbol { continue }
        if cast(s32)source.kind == cast(s32)kind ||
            kind == .RuntimeTrap && source.kind != .Invalid { return source.operand }
    }
    return MachineNoId
}

// Builds the runtime image: code, aligned constant and data sections with
// the fuel counter at the end of data, initializers, and relocations.
BuildMachineImage :: (program: MachineProgram, output: *$O,
    limits: MachineLimits) -> bool {
    owner := *output.machine_image
    code_count := output.code.count
    globals := program.globals.count
    functions := program.functions.count
    if !VecResizeBounded(owner.code, code_count, limits.bytes) ||
        !VecResizeBounded(owner.function_offsets, functions, limits.bytes) ||
        !VecResizeBounded(owner.global_offsets, globals, limits.bytes) ||
        !VecResizeBounded(owner.constant_offsets, globals, limits.bytes) ||
        !VecResizeBounded(owner.initializers, program.initializers.count, limits.bytes) ||
        !VecResizeBounded(owner.relocations, output.relocations.count, limits.bytes) {
        return false
    }
    for index: cast(s64)0..code_count - 1 { owner.code[index] = output.code[index] }
    for index: cast(s64)0..functions - 1 {
        owner.function_offsets[index] = -1
        if program.functions[index].calling == .Internal {
            owner.function_offsets[index] = output.functions[index].begin
        }
    }
    constants_size: s64 = 0
    data_size: s64 = 0
    for index: cast(s64)0..globals - 1 {
        global := program.globals[index]
        type := program.types[global.type]
        if type.size <= 0 || type.alignment <= 0 { return false }
        owner.global_offsets[index] = -1
        owner.constant_offsets[index] = -1
        if global.writable {
            data_size = AlignValue(data_size, type.alignment)
            owner.global_offsets[index] = data_size
            data_size += type.size
        } else {
            constants_size = AlignValue(constants_size, type.alignment)
            owner.constant_offsets[index] = constants_size
            constants_size += type.size
        }
        if data_size < 0 || constants_size < 0 || data_size > limits.bytes || constants_size > limits.bytes {
            return false
        }
    }
    // Fuel, the last trap code, the stack limit word, then the pointer
    // runtime header, as on x86-64.
    fuel := AlignValue(data_size, 8)
    if fuel > limits.bytes - 24 - MachinePointerHeaderBytes { return false }
    stack_limit := fuel + 16
    pointer_header := stack_limit + 8
    data_size = pointer_header + MachinePointerHeaderBytes
    if !VecResizeBounded(owner.constants, constants_size, limits.bytes) ||
        !VecResizeBounded(owner.data, data_size, limits.bytes) { return false }
    for index: cast(s64)0..globals - 1 {
        global := program.globals[index]
        at := ifx global.writable then owner.global_offsets[index] else owner.constant_offsets[index]
        destination := ifx global.writable then owner.data[:] else owner.constants[:]
        if !WriteGlobalImage(program, cast(s32)index, destination, at) { return false }
    }
    for index: cast(s64)0..program.initializers.count - 1 {
        owner.initializers[index] = program.initializers[index]
    }
    for index: cast(s64)0..output.relocations.count - 1 {
        relocation := output.relocations[index]
        kind := ImageRelocationKind(relocation.kind)
        if kind == .Invalid { return false }
        owner.relocations[index] = .{section = .Code, offset = relocation.offset,
            width = ImageRelocationWidth(relocation.kind),
            instruction = relocation.instruction,
            operand = ImageOperand(program, relocation, kind), kind = kind,
            symbol = relocation.symbol, addend = relocation.addend}
    }
    stack_bytes: s64 = 16
    for frame: program.frames { if frame.size > stack_bytes { stack_bytes = frame.size } }
    stack_bytes = AlignValue(stack_bytes, 16)
    owner.image = .{version = MachineImageVersion, target = program.target,
        runtime_abi = .Revision1,
        code = .{bytes = owner.code[:], alignment = 16},
        constants = .{bytes = owner.constants[:], alignment = 16},
        data = .{bytes = owner.data[:], alignment = 8},
        function_offsets = owner.function_offsets[:], global_offsets = owner.global_offsets[:],
        constant_offsets = owner.constant_offsets[:], initializers = owner.initializers[:],
        relocations = owner.relocations[:], entry = program.entry,
        stack_alignment = 16, stack_bytes = stack_bytes, fuel_offset = fuel,
        stack_limit_offset = stack_limit, pointer_offset = pointer_header,
        host_symbols = cast(s32)functions, platform_symbols = cast(s32)functions,
        trap_symbols = 1}
    if MachineImageValidate(owner.image).problem != .None { return false }
    owner.valid = true
    return true
}
