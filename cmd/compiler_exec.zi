using IR :: #import "compiler_lowered_ir"
using Verify :: #import "compiler_lowered_verify"
using Binary :: #import "std/binary"
using Math :: #import "std/math"
using Vectors :: #import "std/vec"
#import "std/option"

LirExecProblem :: enum s32 {
    None; InvalidProgram; NotReady; Busy; Allocation
    WorkLimit; FuelLimit; FrameLimit; ValueLimit; AddressLimit; ValueBytes
    Type; Pointer; Calling; DivideByZero; InvalidShift; InvalidConversion
    Trap; Unreachable; Unsupported; Host
}

LirExecLimits :: struct {
    work: s64
    fuel: s64
    frames: s64
    values: s64
    addresses: s64
    value_bytes: s64
}

LirExecValue :: struct { type: s32; bits: u64; bytes: s64 }
// Arguments and the result use the canonical bits of their LIR scalar types:
// zero-extended integers, 0/1 bools and IEEE float32/float64 patterns.
LirExecHostCall :: #type (context: *void, function: s32, arguments: []u64, result: *u64) -> bool;
// A host may change the elements of an argument bound as a mutable view
// (LirExecHostMutableView): it sets `changed` and puts the argument's new
// image in `bytes`, with the same element count. After the call the engine
// copies those elements back into the view's storage.
LirExecArgument :: struct { type: s32; bits: u64; bytes: []u8; changed: bool }
LirExecTypedHostCall :: #type (context: *void, function: s32,
    arguments: []LirExecArgument, result: *LirExecArgument) -> bool;
// The platform byte-output service `(descriptor: u64, data: *u8, count: u64)`,
// such as ziran.platform.write_all. The engine resolves the checked data
// pointer and its extent itself; the embedder sees only the borrowed bytes,
// which stay valid for the duration of the call.
LirExecPlatformWrite :: #type (context: *void, descriptor: u64, bytes: []u8) -> bool;
LirExecHostBinding :: struct {
    function: s32
    call: LirExecHostCall
    typed: LirExecTypedHostCall
    write: LirExecPlatformWrite
    context: *void
    // Bit p: parameter p is a mutable view.
    views: u64
}

LirExecResult :: struct {
    problem: LirExecProblem
    verification: LirDiagnostic
    function: s32
    block: s32
    instruction: s32
    origin: s32
    trap: u64
    value: LirExecValue
    work_remaining: s64
    fuel_remaining: s64
}

LirExecFunctionPlan :: struct {
    value_base: s64
    block_base: s64
    frame_bytes: s64
    word_count: s64
    scratch_offset: s64
    scratch_bytes: s64
}

LirExecPlan :: struct {
    program: LirProgram
    type_sizes: Vec(s64)
    value_offsets: Vec(s64)
    value_words: Vec(s64)
    value_sizes: Vec(s64)
    value_types: Vec(s32)
    value_canonical: Vec(u8)
    value_masks: Vec(u64)
    // One byte per type, as LirHostShapes gives it.
    host_shapes: Vec(u8)
    functions: Vec(LirExecFunctionPlan)
    block_edge_bases: Vec(s64)
    block_instruction_bases: Vec(s64)
    edge_direct: Vec(u8)
    instructions: Vec(LirInstruction)
    global_offsets: Vec(s64)
    global_bytes: s64
    ready: bool
}

LirExecAddress :: struct {
    token: u64
    global: s32
    frame: s64
    generation: u64
    offset: s64
    extent: s64
    type: s32
    owned: bool
    writable: bool
    // One more than the heap block this address lies in; 0 for none.
    heap: s64
    // How many times this table slot has been given back and reused. It is
    // part of the token, so no older pointer to the slot is valid again.
    version: u64
    // One more than the next entry made for the same frame or heap block.
    next: s64
}

// A heap block is a range of the owned bytes. Resizing or freeing it ends
// its generation, so addresses derived from it stop being valid.
LirExecHeapBlock :: struct {
    offset: s64
    size: s64
    count: u64
    generation: u64
    live: bool
    // One more than the block that ended the owned bytes when this one was
    // put after it; 0 for none. Freed storage is given back down this chain.
    below: s64
    // One more than the newest address entry made for this block.
    addresses: s64
}

LirExecFrame :: struct {
    function: s32
    block: s32
    instruction: s32
    return_value: s32
    base: s64
    word_base: s64
    value_base: s64
    valid_base: s64
    instruction_base: s64
    generation: u64
    // One more than the newest address entry made for this frame's storage.
    addresses: s64
}

LirExecInstance :: struct {
    plan: *LirExecPlan
    limits: LirExecLimits
    identity: u32
    globals: Vec(u8)
    addresses: Vec(LirExecAddress)
    // Open-addressed index of `addresses` by the fields that make two
    // addresses the same one: each slot is zero, -1 for a removed entry, or
    // one more than an entry. `address_used` counts the nonzero slots.
    address_slots: Vec(s32)
    address_used: s64
    // Table slots given back by frames that returned and heap blocks that died.
    address_free: Vec(s64)
    storage: Vec(u8)
    words: Vec(u64)
    validity: Vec(u8)
    frames: Vec(LirExecFrame)
    result_bytes: Vec(u8)
    result_value: LirExecValue
    hosts: Vec(LirExecHostBinding)
    host_arguments: Vec(u64)
    typed_arguments: Vec(LirExecArgument)
    host_bytes: Vec(u8)
    owned: Vec(u8)
    heap_blocks: Vec(LirExecHeapBlock)
    // One more than the block that ends the owned bytes; 0 when host bytes do.
    heap_tail: s64
    // Records of freed blocks whose bytes were given back, for reuse.
    heap_free: Vec(s64)
    heap_epoch: u64
    live_values: s64
    frame_epoch: u64
    current_value_base: s64
    current_word_base: s64
    current_valid_base: s64
    work_remaining: s64
    fuel_remaining: s64
    failure: LirExecResult
    initializer_failure: LirExecResult
    initialized: bool
    initializer_failed: bool
    ready: bool
    running: bool
}

#scope_file

ExecNoDiagnostic :: () -> LirDiagnostic {
    return .{.problem = .None, .function = LirNoId, .block = LirNoId,
        .instruction = LirNoId, .value = LirNoId, .origin = LirNoId}
}

ExecResult :: (problem: LirExecProblem) -> LirExecResult {
    return .{.problem = problem, .verification = ExecNoDiagnostic(),
        .function = LirNoId, .block = LirNoId, .instruction = LirNoId,
        .origin = LirNoId}
}

ExecMask :: (bits: s32) -> u64 {
    if bits == 64 { return ~cast(u64)0 }
    return (cast(u64)1 << cast(u64)bits) - cast(u64)1
}

ExecSigned :: (value: u64, bits: s32) -> s64 {
    value &= ExecMask(bits)
    if bits < 64 && (value & (cast(u64)1 << cast(u64)(bits - 1))) != 0 {
        value |= ~ExecMask(bits)
    }
    return cast(s64)value
}

ExecReadBits :: (bytes: []u8, at: s64, count: s64) -> u64 {
    result: u64
    for index: cast(s64)0..count - 1 {
        result |= cast(u64)bytes[at + index] << cast(u64)(index * 8)
    }
    return result
}

ExecWriteBits :: (bytes: []u8, at: s64, count: s64, value: u64) {
    for index: cast(s64)0..count - 1 {
        bytes[at + index] = cast(u8)(value >> cast(u64)(index * 8))
    }
}

ExecFloat64Bits :: (input: float64) -> u64 {
    negative := input < 0.0 || input == 0.0 && 1.0 / input < 0.0
    value := ifx negative then 0.0 - input else input
    sign := ifx negative then cast(u64)1 << cast(u64)63 else cast(u64)0
    if value != value { return sign | cast(u64)0x7ff8000000000000 }
    if value == 0.0 { return sign }
    if !Finite64(value) { return sign | cast(u64)0x7ff0000000000000 }
    exponent: s32
    step: float64 = 18446744073709551616.0
    back: float64 = 5.42101086242752217003726400434970855712890625e-20
    while value >= step { value *= back; exponent += 64 }
    while value < 1.0 { value *= step; exponent -= 64 }
    if value >= 4294967296.0 { value *= 2.3283064365386962890625e-10; exponent += 32 }
    if value >= 65536.0 { value *= 0.0000152587890625; exponent += 16 }
    if value >= 256.0 { value *= 0.00390625; exponent += 8 }
    if value >= 16.0 { value *= 0.0625; exponent += 4 }
    if value >= 4.0 { value *= 0.25; exponent += 2 }
    if value >= 2.0 { value *= 0.5; exponent += 1 }
    if exponent >= -1022 {
        fraction := cast(u64)((value - 1.0) * 4503599627370496.0)
        return sign | (cast(u64)(exponent + 1023) << cast(u64)52) | fraction
    }
    fraction := cast(u64)ScaleByPowerOfTwo(value, exponent + 1074)
    return sign | fraction
}

ExecFloat32Bits :: (input: float32) -> u64 {
    original := cast(float64)input
    negative := original < 0.0 || original == 0.0 && 1.0 / original < 0.0
    value := ifx negative then 0.0 - original else original
    sign := ifx negative then cast(u64)1 << cast(u64)31 else cast(u64)0
    if value != value { return sign | cast(u64)0x7fc00000 }
    if value == 0.0 { return sign }
    if !Finite64(value) { return sign | cast(u64)0x7f800000 }
    exponent: s32
    while value >= 2.0 { value *= 0.5; exponent += 1 }
    while value < 1.0 { value *= 2.0; exponent -= 1 }
    if exponent >= -126 {
        fraction := cast(u64)((value - 1.0) * 8388608.0)
        return sign | (cast(u64)(exponent + 127) << cast(u64)23) | fraction
    }
    fraction := cast(u64)ScaleByPowerOfTwo(value, exponent + 149)
    return sign | fraction
}

ExecFloat :: (type: LirType, bits: u64) -> float64 {
    if type.bits == 32 { return Float32FromBits(cast(u32)bits) }
    return Float64FromBits(bits)
}

ExecTypeChildren :: (type: LirType) -> s64 {
    if type.kind == .Record { return type.fields.count }
    if type.kind == .Array { return 1 }
    return 0
}

ExecTypeChild :: (type: LirType, index: s64) -> s32 {
    if type.kind == .Record { return type.fields[index] }
    return type.element
}

ExecPlanLayouts :: (program: LirProgram, plan: *LirExecPlan, maximum: s64) -> LirExecProblem {
    colors: Vec(u8)
    stack: Vec(s32)
    next: Vec(s64)
    count := program.types.count
    if !VecResizeBounded(plan.type_sizes, count, count) ||
        !VecResizeBounded(colors, count, count) || !VecResizeBounded(stack, count, count) ||
        !VecResizeBounded(next, count, count) { return .Allocation }
    if count == 0 { return .None }
    for index: cast(s64)0..count - 1 { plan.type_sizes[index] = -1 }
    for root: cast(s32)0..cast(s32)count - 1 {
        if colors[root] == 2 { continue }
        depth: s64
        stack[0] = root
        while depth >= 0 {
            id := stack[depth]
            type := program.types[id]
            colors[id] = 1
            children := ExecTypeChildren(type)
            if next[id] < children {
                child := ExecTypeChild(type, next[id])
                next[id] += 1
                if colors[child] == 1 { return .InvalidProgram }
                if colors[child] == 0 { depth += 1; stack[depth] = child }
                continue
            }
            size: s64
            if type.kind == .Bool { size = 1 }
            else if type.kind == .Integer || type.kind == .Float { size = type.bits / 8 }
            else if type.kind == .Pointer || type.kind == .Function { size = 8 }
            else if type.kind == .Array {
                child := plan.type_sizes[type.element]
                if type.count != 0 && child > maximum / type.count { return .ValueBytes }
                size = child * type.count
            } else if type.kind == .Record {
                for field: type.fields {
                    field_size := plan.type_sizes[field]
                    if field_size > maximum - size { return .ValueBytes }
                    size += field_size
                }
            }
            if size < 0 || size > maximum { return .ValueBytes }
            plan.type_sizes[id] = size
            colors[id] = 2
            depth -= 1
        }
    }
    return .None
}

ExecPlanValuesOverlap :: (plan: *LirExecPlan, base: s64, left: s32, right: s32) -> bool {
    left_word := plan.value_words[base + left]
    right_word := plan.value_words[base + right]
    if (left_word >= 0) != (right_word >= 0) { return false }
    if left_word >= 0 { return left_word == right_word }
    left_at := plan.value_offsets[base + left]
    right_at := plan.value_offsets[base + right]
    left_size := plan.value_sizes[base + left]
    right_size := plan.value_sizes[base + right]
    return left_at < right_at + right_size && right_at < left_at + left_size
}

ExecPlanValuesSameLocation :: (plan: *LirExecPlan, base: s64,
    left: s32, right: s32) -> bool {
    left_word := plan.value_words[base + left]
    right_word := plan.value_words[base + right]
    if (left_word >= 0) != (right_word >= 0) { return false }
    if left_word >= 0 { return left_word == right_word }
    return plan.value_offsets[base + left] == plan.value_offsets[base + right] &&
        plan.value_sizes[base + left] == plan.value_sizes[base + right]
}

// Edge locations are immutable after plan construction. Prove direct-copy
// safety once instead of repeating this quadratic overlap check on every loop
// back-edge. Cycles and destructive aliases retain the scratch path.
ExecPlanEdgeDirectSafe :: (plan: *LirExecPlan, base: s64,
    edge: LirEdge, target: LirBlock) -> bool {
    if edge.arguments.count != target.parameters.count { return false }
    for destination_index: cast(s64)0..target.parameters.count - 1 {
        destination := target.parameters[destination_index]
        for source_index: cast(s64)0..edge.arguments.count - 1 {
            source := edge.arguments[source_index]
            if !ExecPlanValuesOverlap(plan, base, destination, source) { continue }
            if destination_index == source_index &&
                ExecPlanValuesSameLocation(plan, base, destination, source) { continue }
            return false
        }
    }
    return true
}

ExecPlanFunctions :: (program: LirProgram, plan: *LirExecPlan, maximum: s64) -> LirExecProblem {
    values: s64
    blocks: s64
    edges: s64
    instructions: s64
    for function: program.functions {
        if function.values.count > 9223372036854775807 - values { return .ValueLimit }
        values += function.values.count
        if function.blocks.count > 9223372036854775807 - blocks { return .ValueLimit }
        blocks += function.blocks.count
        for block: function.blocks {
            if block.instructions.count > 9223372036854775807 - instructions {
                return .ValueLimit
            }
            instructions += block.instructions.count
            for instruction: block.instructions {
                if instruction.edges.count > 9223372036854775807 - edges { return .ValueLimit }
                edges += instruction.edges.count
            }
        }
    }
    if !VecResizeBounded(plan.value_offsets, values, values) ||
        !VecResizeBounded(plan.value_words, values, values) ||
        !VecResizeBounded(plan.value_sizes, values, values) ||
        !VecResizeBounded(plan.value_types, values, values) ||
        !VecResizeBounded(plan.value_canonical, values, values) ||
        !VecResizeBounded(plan.value_masks, values, values) ||
        !VecResizeBounded(plan.functions, program.functions.count, program.functions.count) ||
        !VecResizeBounded(plan.block_edge_bases, blocks, blocks) ||
        !VecResizeBounded(plan.block_instruction_bases, blocks, blocks) ||
        !VecResizeBounded(plan.edge_direct, edges, edges) ||
        !VecResizeBounded(plan.instructions, instructions, instructions) ||
        !VecResizeBounded(plan.global_offsets, program.globals.count, program.globals.count) { return .Allocation }
    value_at: s64
    block_at: s64
    edge_at: s64
    instruction_at: s64
    for function_index: cast(s64)0..program.functions.count - 1 {
        function := program.functions[function_index]
        uses: Vec(s64)
        aliases: Vec(s32)
        predecessors: Vec(s64)
        defer VecFree(uses)
        defer VecFree(aliases)
        defer VecFree(predecessors)
        if !VecResizeBounded(uses, function.values.count, function.values.count) ||
            !VecResizeBounded(aliases, function.values.count, function.values.count) ||
            !VecResizeBounded(predecessors, function.blocks.count, function.blocks.count) {
            return .Allocation
        }
        for value_index: cast(s64)0..function.values.count - 1 { aliases[value_index] = LirNoId }
        for block: function.blocks {
            for instruction: block.instructions {
                for operand: instruction.operands { uses[operand] += 1 }
                for edge: instruction.edges {
                    predecessors[edge.block] += 1
                    for argument: edge.arguments { uses[argument] += 1 }
                }
            }
        }
        // A dead Extract still executes (and therefore retains its trap
        // behavior), but the bytes it reads cannot keep a prior aggregate
        // version live. Discount only that content use for slot coalescing.
        for block: function.blocks {
            for instruction: block.instructions {
                if instruction.op == .Extract && instruction.result != LirNoId &&
                    uses[instruction.result] == 0 && instruction.operands.count != 0 {
                    uses[instruction.operands[0]] -= 1
                }
            }
        }
        // A parameter of a single-predecessor block may share its incoming
        // value's slot. The edge is the incoming value's last dynamic use;
        // require a unique occurrence on that edge so two live parameters can
        // never observe an Insert updating their shared aggregate bytes.
        for block: function.blocks {
            for instruction: block.instructions {
                for edge: instruction.edges {
                    if predecessors[edge.block] != 1 { continue }
                    target := function.blocks[edge.block]
                    for index: cast(s64)0..target.parameters.count - 1 {
                        source := edge.arguments[index]
                        destination := target.parameters[index]
                        if source >= destination ||
                            function.values[source] != function.values[destination] { continue }
                        source_root := source
                        while aliases[source_root] != LirNoId { source_root = aliases[source_root] }
                        unique := true
                        for other: cast(s64)0..edge.arguments.count - 1 {
                            other_root := edge.arguments[other]
                            while aliases[other_root] != LirNoId { other_root = aliases[other_root] }
                            if other != index && other_root == source_root { unique = false; break }
                        }
                        if unique { aliases[destination] = source_root }
                    }
                }
            }
        }
        // Join parameters may coalesce too when every predecessor already
        // carries the same proven location (for example, both arms of a branch
        // forwarding an unchanged array). Different incoming roots stay apart.
        for target_index: cast(s64)0..function.blocks.count - 1 {
            if predecessors[target_index] <= 1 { continue }
            target := function.blocks[target_index]
            for parameter_index: cast(s64)0..target.parameters.count - 1 {
                candidate: s32 = LirNoId
                consistent := true
                for source_block: function.blocks {
                    for instruction: source_block.instructions {
                        for edge: instruction.edges {
                            if edge.block != target_index { continue }
                            source := edge.arguments[parameter_index]
                            root := source
                            while aliases[root] != LirNoId { root = aliases[root] }
                            for other: cast(s64)0..edge.arguments.count - 1 {
                                other_root := edge.arguments[other]
                                while aliases[other_root] != LirNoId { other_root = aliases[other_root] }
                                if other != parameter_index && other_root == root {
                                    consistent = false; break
                                }
                            }
                            if !consistent { break }
                            if candidate == LirNoId { candidate = root }
                            else if candidate != root { consistent = false; break }
                        }
                        if !consistent { break }
                    }
                    if !consistent { break }
                }
                destination := target.parameters[parameter_index]
                if consistent && candidate != LirNoId && candidate < destination &&
                    function.values[candidate] == function.values[destination] {
                    aliases[destination] = candidate
                }
            }
        }
        for block: function.blocks {
            for instruction: block.instructions {
                if instruction.op != .Insert || instruction.result == LirNoId ||
                    instruction.operands.count < 2 { continue }
                source := instruction.operands[0]
                if source < instruction.result && uses[source] == 1 &&
                    function.values[source] == function.values[instruction.result] {
                    aliases[instruction.result] = source
                }
            }
        }
        base := value_at
        offset: s64
        words: s64
        for value_index: cast(s64)0..function.values.count - 1 {
            value := function.values[value_index]
            type := program.types[value]
            plan.value_sizes[value_at] = plan.type_sizes[value]
            plan.value_types[value_at] = value
            if type.kind == .Bool { plan.value_canonical[value_at] = 1; plan.value_masks[value_at] = 1 }
            else if type.kind == .Integer {
                plan.value_canonical[value_at] = 2
                plan.value_masks[value_at] = ExecMask(type.bits)
            }
            scalar := type.kind == .Bool || type.kind == .Integer || type.kind == .Float ||
                type.kind == .Pointer || type.kind == .Function
            alias := aliases[value_index]
            if alias != LirNoId {
                plan.value_offsets[value_at] = plan.value_offsets[base + alias]
                plan.value_words[value_at] = plan.value_words[base + alias]
            } else if scalar {
                plan.value_offsets[value_at] = -1
                plan.value_words[value_at] = words
                words += 1
            } else {
                plan.value_words[value_at] = -1
                plan.value_offsets[value_at] = offset
                size := plan.type_sizes[value]
                if size > maximum - offset { return .ValueBytes }
                offset += size
            }
            value_at += 1
        }
        scratch: s64
        for block: function.blocks {
            size: s64
            for parameter: block.parameters {
                part := plan.type_sizes[function.values[parameter]]
                if part > maximum - size { return .ValueBytes }
                size += part
            }
            if size > scratch { scratch = size }
        }
        if scratch > maximum - offset { return .ValueBytes }
        if words > (maximum - offset - scratch) / 8 { return .ValueBytes }
        function_base := value_at - function.values.count
        plan.functions[function_index] = .{.value_base = function_base, .block_base = block_at,
            .frame_bytes = offset + scratch, .word_count = words,
            .scratch_offset = offset, .scratch_bytes = scratch}
        for block: function.blocks {
            plan.block_edge_bases[block_at] = edge_at
            plan.block_instruction_bases[block_at] = instruction_at
            for instruction: block.instructions {
                plan.instructions[instruction_at] = instruction
                instruction_at += 1
                for edge: instruction.edges {
                    target := function.blocks[edge.block]
                    plan.edge_direct[edge_at] = cast(u8)ExecPlanEdgeDirectSafe(
                        plan, function_base, edge, target)
                    edge_at += 1
                }
            }
            block_at += 1
        }
    }
    offset: s64
    for global_index: cast(s64)0..program.globals.count - 1 {
        plan.global_offsets[global_index] = offset
        size := plan.type_sizes[program.globals[global_index].type]
        if size > maximum - offset { return .ValueBytes }
        offset += size
    }
    plan.global_bytes = offset
    return .None
}

ExecInstructionOrigin :: (instance: *LirExecInstance, frame: LirExecFrame) -> s32 {
    function := instance.plan.program.functions[frame.function]
    if frame.block < 0 || frame.block >= function.blocks.count { return function.origin }
    block := function.blocks[frame.block]
    if frame.instruction < 0 || frame.instruction >= block.instructions.count { return function.origin }
    origin := block.instructions[frame.instruction].origin
    return ifx origin != LirNoId then origin else function.origin
}

ExecFail :: (instance: *LirExecInstance, problem: LirExecProblem, trap: u64 = 0) -> bool #cold {
    if instance.failure.problem != .None { return false }
    result := ExecResult(problem)
    result.trap = trap
    result.work_remaining = instance.work_remaining
    result.fuel_remaining = instance.fuel_remaining
    if instance.frames.count != 0 {
        frame := instance.frames[instance.frames.count - 1]
        result.function = frame.function
        result.block = frame.block
        result.instruction = frame.instruction
        result.origin = ExecInstructionOrigin(instance, frame)
    }
    instance.failure = result
    return false
}

ExecInitialLocation :: (instance: *LirExecInstance, function_id: s32) {
    if instance.failure.problem == .None || instance.failure.function != LirNoId ||
        function_id < 0 || function_id >= instance.plan.program.functions.count { return }
    function := instance.plan.program.functions[function_id]
    instance.failure.function = function_id
    instance.failure.block = function.entry
    instance.failure.instruction = 0
    instruction := function.blocks[function.entry].instructions[0]
    instance.failure.origin = ifx instruction.origin != LirNoId then instruction.origin else function.origin
}

ExecSpend :: (instance: *LirExecInstance, count: s64) -> bool #inline {
    if count < 0 || count > instance.work_remaining { return ExecFail(instance, .WorkLimit) }
    instance.work_remaining -= count
    return true
}

ExecCopyCost :: (count: s64) -> s64 { return 1 + (count + 7) / 8 }

ExecFrameValueOffset :: (instance: *LirExecInstance, frame_index: s64, value: s32) -> s64 {
    frame := instance.frames[frame_index]
    return frame.base + instance.plan.value_offsets[frame.value_base + value]
}

ExecFrameValueWord :: (instance: *LirExecInstance, frame_index: s64, value: s32) -> s64 {
    frame := instance.frames[frame_index]
    return frame.word_base + instance.plan.value_words[frame.value_base + value]
}

ExecValueIsWord :: (instance: *LirExecInstance, frame_index: s64, value: s32) -> bool {
    frame := instance.frames[frame_index]
    return instance.plan.value_words[frame.value_base + value] >= 0
}

ExecValueSize :: (instance: *LirExecInstance, frame_index: s64, value: s32) -> s64 {
    frame := instance.frames[frame_index]
    return instance.plan.value_sizes[frame.value_base + value]
}

ExecValueType :: (instance: *LirExecInstance, value: s32) -> LirType #inline {
    return instance.plan.program.types[
        instance.plan.value_types[instance.current_value_base + value]]
}

ExecValueValid :: (instance: *LirExecInstance, frame_index: s64, value: s32) -> bool {
    frame := instance.frames[frame_index]
    if instance.validity[frame.valid_base + value] == 0 { return ExecFail(instance, .Type) }
    return true
}

ExecMarkValue :: (instance: *LirExecInstance, frame_index: s64, value: s32) {
    frame := instance.frames[frame_index]
    instance.validity[frame.valid_base + value] = 1
}

ExecSlotBits :: (instance: *LirExecInstance, value: s32) -> u64 #inline {
    if instance.validity[instance.current_valid_base + value] == 0 {
        unused ExecFail(instance, .Type)
        return 0
    }
    word := instance.plan.value_words[instance.current_value_base + value]
    if word < 0 {
        unused ExecFail(instance, .Type)
        return 0
    }
    return instance.words[instance.current_word_base + word]
}

ExecIndexBits :: (instance: *LirExecInstance, value: s32) -> u64 {
    bits := ExecSlotBits(instance, value)
    type := ExecValueType(instance, value)
    if type.is_signed && ExecSigned(bits, type.bits) < 0 { unused ExecFail(instance, .Type) }
    return bits
}

ExecWriteSlotBits :: (instance: *LirExecInstance, value: s32, bits: u64) #inline {
    at := instance.current_value_base + value
    word := instance.plan.value_words[at]
    if word < 0 {
        unused ExecFail(instance, .Type)
        return
    }
    canonical := instance.plan.value_canonical[at]
    if canonical == 1 { bits = cast(u64)(bits != 0) }
    else if canonical == 2 { bits &= instance.plan.value_masks[at] }
    instance.words[instance.current_word_base + word] = bits
    instance.validity[instance.current_valid_base + value] = 1
}

ExecCopyStorage :: (instance: *LirExecInstance, source: s64, destination: s64, count: s64) -> bool {
    if !ExecSpend(instance, ExecCopyCost(count)) { return false }
    if source == destination { return true }
    for index: cast(s64)0..count - 1 { instance.storage[destination + index] = instance.storage[source + index] }
    return true
}

ExecCopyValueToStorage :: (instance: *LirExecInstance, frame_index: s64,
    source: s32, destination: s64) -> bool {
    if !ExecValueValid(instance, frame_index, source) { return false }
    size := ExecValueSize(instance, frame_index, source)
    if ExecValueIsWord(instance, frame_index, source) {
        if !ExecSpend(instance, ExecCopyCost(size)) { return false }
        ExecWriteBits(instance.storage[:], destination, size,
            instance.words[ExecFrameValueWord(instance, frame_index, source)])
        return true
    }
    return ExecCopyStorage(instance, ExecFrameValueOffset(instance, frame_index, source),
        destination, size)
}

ExecCopyStorageToValue :: (instance: *LirExecInstance, source: s64,
    frame_index: s64, destination: s32) -> bool {
    size := ExecValueSize(instance, frame_index, destination)
    if ExecValueIsWord(instance, frame_index, destination) {
        if !ExecSpend(instance, ExecCopyCost(size)) { return false }
        ExecWriteSlotBits(instance, destination,
            ExecReadBits(instance.storage[:], source, size))
        return instance.failure.problem == .None
    }
    if !ExecCopyStorage(instance, source,
        ExecFrameValueOffset(instance, frame_index, destination), size) { return false }
    ExecMarkValue(instance, frame_index, destination)
    return true
}

ExecCopyValue :: (instance: *LirExecInstance, source_frame: s64, source: s32,
    destination_frame: s64, destination: s32) -> bool {
    if !ExecValueValid(instance, source_frame, source) { return false }
    size := ExecValueSize(instance, source_frame, source)
    source_word := ExecValueIsWord(instance, source_frame, source)
    if source_word != ExecValueIsWord(instance, destination_frame, destination) {
        return ExecFail(instance, .Type)
    }
    if source_word {
        if !ExecSpend(instance, ExecCopyCost(size)) { return false }
        instance.words[ExecFrameValueWord(instance, destination_frame, destination)] =
            instance.words[ExecFrameValueWord(instance, source_frame, source)]
    } else if !ExecCopyStorage(instance, ExecFrameValueOffset(instance, source_frame, source),
        ExecFrameValueOffset(instance, destination_frame, destination), size) { return false }
    ExecMarkValue(instance, destination_frame, destination)
    return true
}

ExecCopySlot :: (instance: *LirExecInstance, frame_index: s64, source: s32, destination: s32) -> bool {
    return ExecCopyValue(instance, frame_index, source, frame_index, destination)
}

ExecMember :: (instance: *LirExecInstance, type_id: s32, member: u64, offset: *s64, member_type: *s32) -> bool {
    type := instance.plan.program.types[type_id]
    if type.kind == .Array {
        if member >= cast(u64)type.count { return ExecFail(instance, .Type) }
        <<member_type = type.element
        <<offset = cast(s64)member * instance.plan.type_sizes[type.element]
        return true
    }
    if type.kind != .Record || member >= cast(u64)type.fields.count { return ExecFail(instance, .Type) }
    result: s64
    for index: cast(s64)0..cast(s64)member - 1 {
        if !ExecSpend(instance, 1) { return false }
        result += instance.plan.type_sizes[type.fields[index]]
    }
    <<member_type = type.fields[cast(s64)member]
    <<offset = result
    return true
}

// A table holds at most this many entries, and a slot is reused at most
// ExecAddressVersions times before it is retired.
ExecAddressSlots :: 1048575
ExecAddressVersions :: 268435455

// A pointer's bits: the instance's identity (its low 16 bits), the slot's
// version, and one more than the slot. Zero is the null pointer.
ExecAddressToken :: (identity: u32, index: s64, version: u64 = 0) -> u64 {
    return (cast(u64)(identity & 65535) << cast(u64)48) | (version << cast(u64)20) | cast(u64)(index + 1)
}

ExecFindAddress :: (instance: *LirExecInstance, token: u64) -> s32 {
    if token == 0 { return -1 }
    low := token & cast(u64)1048575
    if low == 0 { return -1 }
    index := cast(s64)(low - cast(u64)1)
    if index >= instance.addresses.count || instance.addresses[index].token != token { return -1 }
    return cast(s32)index
}

ExecAddressHash :: (address: LirExecAddress) -> u64 {
    hash := cast(u64)address.offset * cast(u64)0x9E3779B97F4A7C15
    hash = (hash ^ cast(u64)address.extent) * cast(u64)0xC2B2AE3D27D4EB4F
    hash = (hash ^ cast(u64)(address.frame + 1)) * cast(u64)0x9E3779B97F4A7C15
    hash = (hash ^ address.generation) * cast(u64)0xC2B2AE3D27D4EB4F
    hash = (hash ^ cast(u64)(address.global + 1)) * cast(u64)0x9E3779B97F4A7C15
    hash = (hash ^ cast(u64)address.type) * cast(u64)0xC2B2AE3D27D4EB4F
    if address.owned { hash = ~hash }
    return hash ^ (hash >> cast(u64)29)
}

// Two addresses are one when they name the same bytes as the same type.
ExecAddressSame :: (left: LirExecAddress, right: LirExecAddress) -> bool {
    return left.frame == right.frame && left.generation == right.generation &&
        left.global == right.global && left.offset == right.offset && left.extent == right.extent &&
        left.type == right.type && left.owned == right.owned
}

// The table entry equal to `address`, or -1.
ExecAddressLookup :: (instance: *LirExecInstance, address: LirExecAddress) -> s64 {
    if instance.address_slots.count == 0 { return -1 }
    mask := instance.address_slots.count - 1
    slot := cast(s64)(ExecAddressHash(address) & cast(u64)mask)
    entry := instance.address_slots[slot]
    while entry != 0 {
        if entry > 0 && ExecAddressSame(instance.addresses[entry - 1], address) { return cast(s64)entry - 1 }
        slot = (slot + 1) & mask
        entry = instance.address_slots[slot]
    }
    return -1
}

// Rebuilds the index from the live entries, at most a quarter full.
ExecAddressReindex :: (instance: *LirExecInstance) -> bool {
    live: s64
    for address: instance.addresses { if address.token != 0 { live += 1 } }
    // The table never shrinks: a rebuild in place only drops removed entries.
    capacity: s64 = 64
    while capacity < (live + 1) * 4 { capacity *= 2 }
    if capacity < instance.address_slots.count { capacity = instance.address_slots.count }
    if !VecResizeBounded(instance.address_slots, capacity, capacity) { return false }
    for index: cast(s64)0..capacity - 1 { instance.address_slots[index] = 0 }
    mask := capacity - 1
    for index: cast(s64)0..instance.addresses.count - 1 {
        if instance.addresses[index].token == 0 { continue }
        slot := cast(s64)(ExecAddressHash(instance.addresses[index]) & cast(u64)mask)
        while instance.address_slots[slot] != 0 { slot = (slot + 1) & mask }
        instance.address_slots[slot] = cast(s32)(index + 1)
    }
    instance.address_used = live
    return true
}

ExecAddressIndexAdd :: (instance: *LirExecInstance, index: s64) -> bool {
    // Removed entries count as used until a rebuild drops them.
    if (instance.address_used + 1) * 2 > instance.address_slots.count { return ExecAddressReindex(instance) }
    mask := instance.address_slots.count - 1
    slot := cast(s64)(ExecAddressHash(instance.addresses[index]) & cast(u64)mask)
    while instance.address_slots[slot] > 0 { slot = (slot + 1) & mask }
    if instance.address_slots[slot] == 0 { instance.address_used += 1 }
    instance.address_slots[slot] = cast(s32)(index + 1)
    return true
}

ExecAddressIndexRemove :: (instance: *LirExecInstance, index: s64) {
    if instance.address_slots.count == 0 { return }
    mask := instance.address_slots.count - 1
    slot := cast(s64)(ExecAddressHash(instance.addresses[index]) & cast(u64)mask)
    entry := instance.address_slots[slot]
    while entry != 0 {
        if cast(s64)entry == index + 1 { instance.address_slots[slot] = -1; return }
        slot = (slot + 1) & mask
        entry = instance.address_slots[slot]
    }
}

// Makes a table entry for `address`: a slot that was given back, under its
// next version, or a new slot. An address into a frame or a heap block joins
// that frame's or block's chain and is given back when the frame returns or
// the block dies. Returns the entry's index, or -1 with the failure recorded.
ExecNewAddress :: (instance: *LirExecInstance, address: LirExecAddress) -> s64 {
    index: s64
    version: u64
    if instance.address_free.count > 0 {
        index = instance.address_free[instance.address_free.count - 1]
        unused VecResize(instance.address_free, instance.address_free.count - 1)
        version = instance.addresses[index].version + 1
    } else {
        index = instance.addresses.count
        if index >= instance.limits.addresses || index >= ExecAddressSlots {
            unused ExecFail(instance, .AddressLimit)
            return -1
        }
        if !VecPush(instance.addresses, LirExecAddress.{}) { unused ExecFail(instance, .Allocation); return -1 }
    }
    added := address
    added.version = version
    added.token = ExecAddressToken(instance.identity, index, version)
    added.next = 0
    if added.frame >= 0 {
        added.next = instance.frames[added.frame].addresses
        instance.frames[added.frame].addresses = index + 1
    } else if added.heap != 0 {
        added.next = instance.heap_blocks[added.heap - 1].addresses
        instance.heap_blocks[added.heap - 1].addresses = index + 1
    }
    instance.addresses[index] = added
    if !ExecAddressIndexAdd(instance, index) { unused ExecFail(instance, .Allocation); return -1 }
    return index
}

// Gives back every entry of a chain. Its frame returned or its heap block
// died, so no valid pointer names these entries any more.
ExecReleaseAddresses :: (instance: *LirExecInstance, head: s64) {
    at := head
    while at != 0 {
        index := at - 1
        at = instance.addresses[index].next
        ExecAddressIndexRemove(instance, index)
        instance.addresses[index].token = 0
        instance.addresses[index].next = 0
        if instance.addresses[index].version < ExecAddressVersions { unused VecPush(instance.address_free, index) }
    }
}

// The token of the table entry equal to `address`, made when it is new.
// Deriving the same address again gives the same token, so pointers compare
// equal exactly when they name the same bytes as the same type.
ExecInternAddress :: (instance: *LirExecInstance, address: LirExecAddress) -> u64 {
    if !ExecSpend(instance, 1) { return 0 }
    index := ExecAddressLookup(instance, address)
    if index < 0 { index = ExecNewAddress(instance, address) }
    if index < 0 { return 0 }
    return instance.addresses[index].token
}

ExecFieldAddress :: (instance: *LirExecInstance, parent: s32, member: u64, target_type: s32) -> u64 {
    base := instance.addresses[parent]
    member_offset: s64
    member_type: s32
    if !ExecMember(instance, base.type, member, *member_offset, *member_type) ||
        member_type != target_type { unused ExecFail(instance, .Type); return 0 }
    offset := base.offset + member_offset
    parent_type := instance.plan.program.types[base.type]
    extent := ifx parent_type.kind == .Array then base.extent - member_offset else instance.plan.type_sizes[target_type]
    if extent < instance.plan.type_sizes[target_type] { unused ExecFail(instance, .Pointer); return 0 }
    child_frame := cast(s64)-1
    child_generation: u64
    child_global := base.global
    if base.frame >= 0 {
        if base.frame >= instance.frames.count ||
            instance.frames[base.frame].generation != base.generation {
            unused ExecFail(instance, .Pointer); return 0
        }
        child_frame = base.frame
        child_generation = base.generation
        child_global = -1
    } else if base.heap != 0 {
        child_generation = base.generation
    }
    return ExecInternAddress(instance, .{.global = child_global, .frame = child_frame,
        .generation = child_generation, .offset = offset, .extent = extent, .type = target_type,
        .owned = base.owned, .writable = base.writable, .heap = base.heap})
}

ExecElementAddress :: (instance: *LirExecInstance, parent: s32, index: u64,
    count: u64, target_type: s32) -> u64 {
    base := instance.addresses[parent]
    size := instance.plan.type_sizes[target_type]
    if base.type != target_type || index >= count ||
        count > cast(u64)9223372036854775807 || size < 0 ||
        size != 0 && count > cast(u64)(base.extent / size) {
        unused ExecFail(instance, .Pointer)
        return 0
    }
    member_offset := cast(s64)index * size
    offset := base.offset + member_offset
    extent := base.extent - member_offset
    return ExecInternAddress(instance, .{.global = base.global, .frame = base.frame,
        .generation = base.generation, .offset = offset, .extent = extent, .type = target_type,
        .owned = base.owned, .writable = base.writable, .heap = base.heap})
}

ExecSliceAddress :: (instance: *LirExecInstance, parent: s32, low: u64,
    high: u64, count: u64, target_type: s32) -> u64 {
    base := instance.addresses[parent]
    size := instance.plan.type_sizes[target_type]
    if base.type != target_type || low > high || high > count ||
        count > cast(u64)9223372036854775807 || size <= 0 ||
        count > cast(u64)(base.extent / size) {
        unused ExecFail(instance, .Pointer)
        return 0
    }
    if low == high { return base.token }
    return ExecElementAddress(instance, parent, low, count, target_type)
}

ExecResizeStorage :: (instance: *LirExecInstance, count: s64) -> bool {
    word_bytes := instance.words.count * 8
    available := instance.limits.value_bytes - instance.globals.count -
        instance.result_bytes.count - instance.owned.count - word_bytes
    if count < 0 || available < 0 || count > available { return ExecFail(instance, .ValueBytes) }
    if !VecResizeBounded(instance.storage, count, available) { return ExecFail(instance, .Allocation) }
    return true
}

ExecResizeWords :: (instance: *LirExecInstance, count: s64) -> bool {
    available := instance.limits.value_bytes - instance.globals.count -
        instance.result_bytes.count - instance.storage.count - instance.owned.count
    if count < 0 || available < 0 || count > available / 8 {
        return ExecFail(instance, .ValueBytes)
    }
    if !VecResizeBounded(instance.words, count, available / 8) {
        return ExecFail(instance, .Allocation)
    }
    return true
}

ExecPushFrame :: (instance: *LirExecInstance, function_id: s32, caller: s64,
    operands: []s32, return_value: s32, arguments: []LirExecArgument) -> bool {
    if function_id < 0 || function_id >= instance.plan.program.functions.count { return ExecFail(instance, .Calling) }
    function := instance.plan.program.functions[function_id]
    if operands.count != 0 && arguments.count != 0 ||
        operands.count == 0 && arguments.count != function.parameters.count ||
        operands.count != 0 && operands.count != function.parameters.count { return ExecFail(instance, .Calling) }
    if instance.frames.count >= instance.limits.frames {
        unused ExecFail(instance, .FrameLimit)
        if caller < 0 { ExecInitialLocation(instance, function_id) }
        return false
    }
    if function.values.count > instance.limits.values - instance.live_values {
        unused ExecFail(instance, .ValueLimit)
        if caller < 0 { ExecInitialLocation(instance, function_id) }
        return false
    }
    plan := instance.plan.functions[function_id]
    base := instance.storage.count
    word_base := instance.words.count
    valid_base := instance.validity.count
    if !ExecResizeStorage(instance, base + plan.frame_bytes) {
        if caller < 0 { ExecInitialLocation(instance, function_id) }
        return false
    }
    if !ExecResizeWords(instance, word_base + plan.word_count) {
        if caller < 0 { ExecInitialLocation(instance, function_id) }
        return false
    }
    if !VecResizeBounded(instance.validity, valid_base + function.values.count, instance.limits.values) {
        unused ExecFail(instance, .Allocation)
        if caller < 0 { ExecInitialLocation(instance, function_id) }
        return false
    }
    instance.frame_epoch += 1
    frame := LirExecFrame.{.function = function_id, .block = function.entry,
        .return_value = return_value, .base = base, .word_base = word_base,
        .value_base = plan.value_base, .valid_base = valid_base,
        .instruction_base = instance.plan.block_instruction_bases[plan.block_base + function.entry],
        .generation = instance.frame_epoch}
    if !VecPush(instance.frames, frame) {
        unused ExecFail(instance, .Allocation)
        if caller < 0 { ExecInitialLocation(instance, function_id) }
        return false
    }
    instance.current_value_base = frame.value_base
    instance.current_word_base = frame.word_base
    instance.current_valid_base = frame.valid_base
    instance.live_values += function.values.count
    frame_index := instance.frames.count - 1
    entry := function.blocks[function.entry]
    for index: cast(s64)0..function.parameters.count - 1 {
        destination := entry.parameters[index]
        type_id := function.parameters[index]
        size := instance.plan.type_sizes[type_id]
        if operands.count != 0 {
            source := operands[index]
            if !ExecCopyValue(instance, caller, source, frame_index, destination) { return false }
        } else {
            argument := arguments[index]
            if argument.type != type_id { return ExecFail(instance, .Type) }
            type := instance.plan.program.types[type_id]
            composite := type.kind == .Record || type.kind == .Array
            if composite {
                destination_at := ExecFrameValueOffset(instance, frame_index, destination)
                if argument.bytes.count != size || !ExecSpend(instance, ExecCopyCost(size)) { return false }
                for byte: cast(s64)0..size - 1 { instance.storage[destination_at + byte] = argument.bytes[byte] }
                ExecMarkValue(instance, frame_index, destination)
            } else {
                if argument.bytes.count != 0 { return ExecFail(instance, .Type) }
                ExecWriteSlotBits(instance, destination, argument.bits)
                if instance.failure.problem != .None { return false }
            }
        }
    }
    return true
}

ExecPopFrame :: (instance: *LirExecInstance) {
    frame := instance.frames[instance.frames.count - 1]
    ExecReleaseAddresses(instance, frame.addresses)
    function := instance.plan.program.functions[frame.function]
    instance.live_values -= function.values.count
    unused VecResize(instance.storage, frame.base)
    unused VecResize(instance.words, frame.word_base)
    unused VecResize(instance.validity, frame.valid_base)
    unused VecPop(instance.frames)
    if instance.frames.count == 0 {
        instance.current_value_base = 0
        instance.current_word_base = 0
        instance.current_valid_base = 0
    } else {
        current := instance.frames[instance.frames.count - 1]
        instance.current_value_base = current.value_base
        instance.current_word_base = current.word_base
        instance.current_valid_base = current.valid_base
    }
}

ExecValuesSameLocation :: (instance: *LirExecInstance, frame_index: s64,
    left: s32, right: s32) -> bool {
    left_word := ExecValueIsWord(instance, frame_index, left)
    if left_word != ExecValueIsWord(instance, frame_index, right) { return false }
    if left_word {
        return ExecFrameValueWord(instance, frame_index, left) ==
            ExecFrameValueWord(instance, frame_index, right)
    }
    return ExecFrameValueOffset(instance, frame_index, left) ==
        ExecFrameValueOffset(instance, frame_index, right) &&
        ExecValueSize(instance, frame_index, left) == ExecValueSize(instance, frame_index, right)
}

ExecEdge :: (instance: *LirExecInstance, frame_index: s64,
    edge: *LirEdge, direct_safe: bool) -> bool {
    frame := instance.frames[frame_index]
    function := instance.plan.program.functions[frame.function]
    plan := instance.plan.functions[frame.function]
    target := function.blocks[edge.block]
    if direct_safe {
        for index: cast(s64)0..target.parameters.count - 1 {
            source := edge.arguments[index]
            destination := target.parameters[index]
            size := ExecValueSize(instance, frame_index, source)
            // Preserve the canonical two-copy work charge even though the
            // proven-safe implementation moves the value only once.
            if ExecValuesSameLocation(instance, frame_index, source, destination) {
                if !ExecValueValid(instance, frame_index, source) ||
                    !ExecSpend(instance, ExecCopyCost(size)) ||
                    !ExecSpend(instance, ExecCopyCost(size)) { return false }
                ExecMarkValue(instance, frame_index, destination)
            } else if !ExecSpend(instance, ExecCopyCost(size)) ||
                !ExecCopyValue(instance, frame_index, source, frame_index, destination) { return false }
        }
        instance.frames[frame_index].block = edge.block
        instance.frames[frame_index].instruction = 0
        instance.frames[frame_index].instruction_base =
            instance.plan.block_instruction_bases[plan.block_base + edge.block]
        return true
    }
    scratch := frame.base + plan.scratch_offset
    at: s64
    for index: cast(s64)0..edge.arguments.count - 1 {
        source := edge.arguments[index]
        size := ExecValueSize(instance, frame_index, source)
        if !ExecCopyValueToStorage(instance, frame_index, source, scratch + at) { return false }
        at += size
    }
    at = 0
    for index: cast(s64)0..target.parameters.count - 1 {
        destination := target.parameters[index]
        size := ExecValueSize(instance, frame_index, destination)
        if !ExecCopyStorageToValue(instance, scratch + at, frame_index, destination) { return false }
        at += size
    }
    instance.frames[frame_index].block = edge.block
    instance.frames[frame_index].instruction = 0
    instance.frames[frame_index].instruction_base =
        instance.plan.block_instruction_bases[plan.block_base + edge.block]
    return true
}

ExecIntegerBinary :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction, type: LirType) -> bool {
    left := ExecSlotBits(instance, instruction.operands[0]) & ExecMask(type.bits)
    right := ExecSlotBits(instance, instruction.operands[1])
    if instance.failure.problem != .None { return false }
    if instruction.op == .ShiftLeft || instruction.op == .ShiftRight {
        count_type := ExecValueType(instance, instruction.operands[1])
        right &= ExecMask(count_type.bits)
    } else { right &= ExecMask(type.bits) }
    result: u64
    if instruction.op == .Add { result = left + right }
    else if instruction.op == .Subtract { result = left - right }
    else if instruction.op == .Multiply { result = left * right }
    else if instruction.op == .BitAnd { result = left & right }
    else if instruction.op == .BitOr { result = left | right }
    else if instruction.op == .BitXor { result = left ^ right }
    else if instruction.op == .Divide || instruction.op == .Remainder {
        if right == 0 { return ExecFail(instance, .DivideByZero) }
        if type.is_signed {
            signed_left := ExecSigned(left, type.bits)
            signed_right := ExecSigned(right, type.bits)
            minimum := cast(u64)1 << cast(u64)(type.bits - 1)
            if left == minimum && signed_right == -1 {
                result = ifx instruction.op == .Divide then minimum else 0
            } else if instruction.op == .Divide { result = cast(u64)(signed_left / signed_right) }
            else { result = cast(u64)(signed_left % signed_right) }
        } else if instruction.op == .Divide { result = left / right }
        else { result = left % right }
    } else if instruction.op == .ShiftLeft || instruction.op == .ShiftRight {
        count := right
        if count >= cast(u64)type.bits { return ExecFail(instance, .InvalidShift) }
        if instruction.op == .ShiftLeft { result = left << count }
        else {
            result = left >> count
            if type.is_signed && count != 0 && (left & (cast(u64)1 << cast(u64)(type.bits - 1))) != 0 {
                result |= ExecMask(type.bits) ^ (ExecMask(type.bits) >> count)
            }
        }
    } else { return ExecFail(instance, .Unsupported) }
    ExecWriteSlotBits(instance, instruction.result, result)
    return true
}

ExecFloatBinary :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction, type: LirType) -> bool {
    left := ExecFloat(type, ExecSlotBits(instance, instruction.operands[0]))
    right := ExecFloat(type, ExecSlotBits(instance, instruction.operands[1]))
    if instance.failure.problem != .None { return false }
    bits: u64
    if type.bits == 32 {
        a := cast(float32)left
        b := cast(float32)right
        value: float32
        if instruction.op == .Add { value = a + b }
        else if instruction.op == .Subtract { value = a - b }
        else if instruction.op == .Multiply { value = a * b }
        else if instruction.op == .Divide { value = a / b }
        else { return ExecFail(instance, .Unsupported) }
        bits = ExecFloat32Bits(value)
    } else {
        value: float64
        if instruction.op == .Add { value = left + right }
        else if instruction.op == .Subtract { value = left - right }
        else if instruction.op == .Multiply { value = left * right }
        else if instruction.op == .Divide { value = left / right }
        else { return ExecFail(instance, .Unsupported) }
        bits = ExecFloat64Bits(value)
    }
    ExecWriteSlotBits(instance, instruction.result, bits)
    return true
}

ExecCompare :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction, type: LirType) -> bool {
    left := ExecSlotBits(instance, instruction.operands[0])
    right := ExecSlotBits(instance, instruction.operands[1])
    if instance.failure.problem != .None { return false }
    answer: bool
    if type.kind == .Float {
        a := ExecFloat(type, left)
        b := ExecFloat(type, right)
        if instruction.op == .Equal { answer = a == b }
        if instruction.op == .NotEqual { answer = a != b }
        if instruction.op == .Less { answer = a < b }
        if instruction.op == .LessEqual { answer = a <= b }
        if instruction.op == .Greater { answer = a > b }
        if instruction.op == .GreaterEqual { answer = a >= b }
    } else if type.kind == .Integer && type.is_signed {
        a := ExecSigned(left, type.bits)
        b := ExecSigned(right, type.bits)
        if instruction.op == .Equal { answer = a == b }
        if instruction.op == .NotEqual { answer = a != b }
        if instruction.op == .Less { answer = a < b }
        if instruction.op == .LessEqual { answer = a <= b }
        if instruction.op == .Greater { answer = a > b }
        if instruction.op == .GreaterEqual { answer = a >= b }
    } else {
        if type.kind == .Integer { left &= ExecMask(type.bits); right &= ExecMask(type.bits) }
        if instruction.op == .Equal { answer = left == right }
        if instruction.op == .NotEqual { answer = left != right }
        if instruction.op == .Less { answer = left < right }
        if instruction.op == .LessEqual { answer = left <= right }
        if instruction.op == .Greater { answer = left > right }
        if instruction.op == .GreaterEqual { answer = left >= right }
    }
    ExecWriteSlotBits(instance, instruction.result, cast(u64)answer)
    return true
}

ExecConvert :: (instance: *LirExecInstance, frame_index: s64, instruction: *LirInstruction,
    source: LirType, destination: LirType) -> bool {
    bits := ExecSlotBits(instance, instruction.operands[0])
    if instance.failure.problem != .None { return false }
    if instruction.op == .Bitcast {
        ExecWriteSlotBits(instance, instruction.result, bits)
        return true
    }
    result: u64
    if source.kind == .Bool && destination.kind == .Integer { result = cast(u64)(bits != 0) }
    else if source.kind == .Integer && destination.kind == .Bool { result = cast(u64)((bits & ExecMask(source.bits)) != 0) }
    else if source.kind == .Integer && destination.kind == .Integer {
        result = bits & ExecMask(source.bits)
        if source.is_signed && source.bits < 64 && (result & (cast(u64)1 << cast(u64)(source.bits - 1))) != 0 {
            result |= ~ExecMask(source.bits)
        }
    } else if source.kind == .Integer && destination.kind == .Float {
        if destination.bits == 32 {
            value := ifx source.is_signed then cast(float32)ExecSigned(bits, source.bits) else cast(float32)(bits & ExecMask(source.bits))
            result = ExecFloat32Bits(value)
        } else {
            value := ifx source.is_signed then cast(float64)ExecSigned(bits, source.bits) else cast(float64)(bits & ExecMask(source.bits))
            result = ExecFloat64Bits(value)
        }
    } else if source.kind == .Float && destination.kind == .Float {
        value := ExecFloat(source, bits)
        result = ifx destination.bits == 32 then ExecFloat32Bits(cast(float32)value) else ExecFloat64Bits(value)
    } else if source.kind == .Float && destination.kind == .Integer {
        value := ExecFloat(source, bits)
        if !Finite64(value) { return ExecFail(instance, .InvalidConversion) }
        if destination.is_signed {
            bound := ScaleByPowerOfTwo(1.0, destination.bits - 1)
            if value < 0.0 - bound || value >= bound { return ExecFail(instance, .InvalidConversion) }
            result = cast(u64)cast(s64)value
        } else {
            bound := ScaleByPowerOfTwo(1.0, destination.bits)
            if value < 0.0 || value >= bound { return ExecFail(instance, .InvalidConversion) }
            result = cast(u64)value
        }
    } else { return ExecFail(instance, .Unsupported) }
    ExecWriteSlotBits(instance, instruction.result, result)
    return true
}

ExecAggregate :: (instance: *LirExecInstance, frame_index: s64, instruction: *LirInstruction) -> bool {
    destination := ExecFrameValueOffset(instance, frame_index, instruction.result)
    at: s64
    for operand: instruction.operands {
        size := ExecValueSize(instance, frame_index, operand)
        if !ExecCopyValueToStorage(instance, frame_index, operand, destination + at) { return false }
        at += size
    }
    ExecMarkValue(instance, frame_index, instruction.result)
    return true
}

ExecExtractInsert :: (instance: *LirExecInstance, frame_index: s64, instruction: *LirInstruction) -> bool {
    frame := instance.frames[frame_index]
    function := instance.plan.program.functions[frame.function]
    aggregate := instruction.operands[0]
    if !ExecValueValid(instance, frame_index, aggregate) { return false }
    aggregate_type := function.values[aggregate]
    offset: s64
    member_type: s32
    member := instruction.immediate
    expected := ifx instruction.op == .Extract then 1 else 2
    if instruction.operands.count == expected + 1 {
        member = ExecIndexBits(instance, instruction.operands[expected])
        if instance.failure.problem != .None { return false }
    }
    if !ExecMember(instance, aggregate_type, member, *offset, *member_type) { return false }
    if instruction.op == .Extract {
        if !ExecCopyStorageToValue(instance,
            ExecFrameValueOffset(instance, frame_index, aggregate) + offset,
            frame_index, instruction.result) { return false }
    } else {
        if !ExecCopySlot(instance, frame_index, aggregate, instruction.result) { return false }
        replacement := instruction.operands[1]
        if !ExecCopyValueToStorage(instance, frame_index, replacement,
            ExecFrameValueOffset(instance, frame_index, instruction.result) + offset) { return false }
    }
    ExecMarkValue(instance, frame_index, instruction.result)
    return true
}

ExecFinishFrame :: (instance: *LirExecInstance, frame_index: s64, instruction: *LirInstruction) -> bool {
    frame := instance.frames[frame_index]
    function := instance.plan.program.functions[frame.function]
    result_type := function.result
    result_size := instance.plan.type_sizes[result_type]
    if frame_index == 0 {
        available := instance.limits.value_bytes - instance.globals.count -
            instance.storage.count - instance.words.count * 8 - instance.owned.count
        if result_size > available { return ExecFail(instance, .ValueBytes) }
        if !VecResizeBounded(instance.result_bytes, result_size,
            instance.limits.value_bytes - instance.globals.count) { return ExecFail(instance, .Allocation) }
        bits: u64
        if result_size != 0 {
            source := instruction.operands[0]
            if !ExecValueValid(instance, frame_index, source) || !ExecSpend(instance, ExecCopyCost(result_size)) { return false }
            type := instance.plan.program.types[result_type]
            if type.kind == .Record || type.kind == .Array {
                source_at := ExecFrameValueOffset(instance, frame_index, source)
                for index: cast(s64)0..result_size - 1 {
                    instance.result_bytes[index] = instance.storage[source_at + index]
                }
            } else {
                bits = instance.words[ExecFrameValueWord(instance, frame_index, source)]
                ExecWriteBits(instance.result_bytes[:], 0, result_size, bits)
            }
        }
        instance.result_value = .{.type = result_type, .bits = bits, .bytes = result_size}
        ExecPopFrame(instance)
        return true
    }
    caller := frame_index - 1
    if result_size != 0 {
        if frame.return_value == LirNoId || !ExecValueValid(instance, frame_index, instruction.operands[0]) {
            return ExecFail(instance, .Calling)
        }
        if !ExecCopyValue(instance, frame_index, instruction.operands[0],
            caller, frame.return_value) { return false }
    } else if frame.return_value != LirNoId { return ExecFail(instance, .Calling) }
    ExecPopFrame(instance)
    return true
}

ExecCallInstruction :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction) -> bool {
    target := instruction.symbol
    skip: s64
    if instruction.op == .CallIndirect {
        bits := ExecSlotBits(instance, instruction.operands[0])
        if instance.failure.problem != .None || bits == 0 ||
            bits > cast(u64)instance.plan.program.functions.count { return ExecFail(instance, .Calling) }
        target = cast(s32)(bits - 1)
        skip = 1
        signature := instance.plan.program.types[
            instance.plan.value_types[instance.current_value_base + instruction.operands[0]]]
        actual := instance.plan.program.functions[target]
        if signature.result != actual.result || signature.parameters.count != actual.parameters.count {
            return ExecFail(instance, .Calling)
        }
        for index: cast(s64)0..signature.parameters.count - 1 {
            if signature.parameters[index] != actual.parameters[index] { return ExecFail(instance, .Calling) }
        }
    }
    arguments := instruction.operands[skip:]
    no_arguments: [0]LirExecArgument
    if !ExecPushFrame(instance, target, frame_index, arguments, instruction.result, no_arguments[:]) { return false }
    instance.frames[frame_index].instruction += 1
    return true
}

ExecAddressValid :: (instance: *LirExecInstance, address_index: s64) -> bool {
    address := instance.addresses[address_index]
    if address.owned {
        if address.heap != 0 {
            block := instance.heap_blocks[address.heap - 1]
            if !block.live || block.generation != address.generation { return false }
        }
        return address.offset >= 0 && address.extent >= 0 &&
            address.offset <= instance.owned.count && address.extent <= instance.owned.count - address.offset
    }
    if address.frame < 0 { return true }
    return address.frame < instance.frames.count &&
        instance.frames[address.frame].generation == address.generation
}

ExecAddressOffset :: (instance: *LirExecInstance, address_index: s64) -> s64 {
    if !ExecAddressValid(instance, address_index) { unused ExecFail(instance, .Pointer); return -1 }
    address := instance.addresses[address_index]
    if address.owned { return address.offset }
    if address.frame < 0 { return address.offset }
    return instance.frames[address.frame].base + address.offset
}

ExecCopyAddressToValue :: (instance: *LirExecInstance, address_index: s64,
    frame_index: s64, destination: s32) -> bool {
    source := ExecAddressOffset(instance, address_index)
    if instance.failure.problem != .None || source < 0 { return false }
    address := instance.addresses[address_index]
    size := ExecValueSize(instance, frame_index, destination)
    if size < 0 || size > instance.addresses[address_index].extent { return ExecFail(instance, .Pointer) }
    if !ExecSpend(instance, ExecCopyCost(size)) { return false }
    if ExecValueIsWord(instance, frame_index, destination) {
        bits: u64
        if address.owned { bits = ExecReadBits(instance.owned[:], source, size) }
        else if address.frame < 0 { bits = ExecReadBits(instance.globals[:], source, size) }
        else { bits = ExecReadBits(instance.storage[:], source, size) }
        ExecWriteSlotBits(instance, destination, bits)
        return instance.failure.problem == .None
    }
    destination_at := ExecFrameValueOffset(instance, frame_index, destination)
    if address.owned {
        for index: cast(s64)0..size - 1 {
            instance.storage[destination_at + index] = instance.owned[source + index]
        }
    } else if address.frame < 0 {
        for index: cast(s64)0..size - 1 {
            instance.storage[destination_at + index] = instance.globals[source + index]
        }
    } else {
        for index: cast(s64)0..size - 1 {
            instance.storage[destination_at + index] = instance.storage[source + index]
        }
    }
    ExecMarkValue(instance, frame_index, destination)
    return true
}

ExecCopyValueToAddress :: (instance: *LirExecInstance, frame_index: s64,
    source: s32, address_index: s64) -> bool {
    if !ExecValueValid(instance, frame_index, source) { return false }
    destination := ExecAddressOffset(instance, address_index)
    if instance.failure.problem != .None || destination < 0 { return false }
    address := instance.addresses[address_index]
    if !address.writable { return ExecFail(instance, .Pointer) }
    size := ExecValueSize(instance, frame_index, source)
    if size < 0 || size > instance.addresses[address_index].extent { return ExecFail(instance, .Pointer) }
    if !ExecSpend(instance, ExecCopyCost(size)) { return false }
    if ExecValueIsWord(instance, frame_index, source) {
        bits := instance.words[ExecFrameValueWord(instance, frame_index, source)]
        if address.owned { ExecWriteBits(instance.owned[:], destination, size, bits) }
        else if address.frame < 0 { ExecWriteBits(instance.globals[:], destination, size, bits) }
        else { ExecWriteBits(instance.storage[:], destination, size, bits) }
        return true
    }
    source_at := ExecFrameValueOffset(instance, frame_index, source)
    if address.owned {
        for index: cast(s64)0..size - 1 {
            instance.owned[destination + index] = instance.storage[source_at + index]
        }
    } else if address.frame < 0 {
        for index: cast(s64)0..size - 1 {
            instance.globals[destination + index] = instance.storage[source_at + index]
        }
    } else {
        for index: cast(s64)0..size - 1 {
            instance.storage[destination + index] = instance.storage[source_at + index]
        }
    }
    return true
}

ExecAllocate :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction, result_type: s32) -> bool {
    pointee := instance.plan.program.types[result_type].element
    size := instance.plan.type_sizes[pointee]
    base := instance.storage.count
    if !ExecResizeStorage(instance, base + size) { return false }
    index := ExecNewAddress(instance, .{.global = -1, .frame = frame_index,
        .generation = instance.frames[frame_index].generation,
        .offset = base - instance.frames[frame_index].base, .extent = size, .type = pointee,
        .writable = true})
    if index < 0 { return false }
    address := instance.addresses[index]
    if instruction.operands.count != 0 {
        value := instruction.operands[0]
        if !ExecValueValid(instance, frame_index, value) ||
            instance.plan.value_types[instance.current_value_base + value] != pointee {
            return ExecFail(instance, .Type)
        }
        if !ExecCopyValueToStorage(instance, frame_index, value, base) { return false }
    }
    ExecWriteSlotBits(instance, instruction.result, address.token)
    return true
}

// Give back the owned bytes of dead heap blocks that end the owned region.
ExecHeapTrim :: (instance: *LirExecInstance) -> bool {
    while instance.heap_tail != 0 {
        if !ExecSpend(instance, 1) { return false }
        index := instance.heap_tail - 1
        block := instance.heap_blocks[index]
        if block.live { return true }
        if block.offset + block.size != instance.owned.count { instance.heap_tail = 0; return true }
        unused VecResize(instance.owned, block.offset)
        instance.heap_blocks[index].size = 0
        instance.heap_tail = block.below
        if !VecPush(instance.heap_free, index) { return ExecFail(instance, .Allocation) }
    }
    return true
}

// resize(pointer: *T, old_count, new_count) -> *T. A null pointer with
// old_count 0 allocates; new_count 0 frees and gives null. The new block
// keeps the first min(old_count, new_count) elements and zero-fills the
// rest. When the value-byte budget cannot hold the request the result is
// null and the old block stays valid. Only a block's own base pointer,
// with its exact element count, may be resized or freed.
ExecResize :: (instance: *LirExecInstance, instruction: *LirInstruction, result_type: s32) -> bool {
    token := ExecSlotBits(instance, instruction.operands[0])
    old_count := ExecIndexBits(instance, instruction.operands[1])
    new_count := ExecIndexBits(instance, instruction.operands[2])
    if instance.failure.problem != .None { return false }
    element := instance.plan.program.types[result_type].element
    size := instance.plan.type_sizes[element]
    if size < 0 { return ExecFail(instance, .Type) }
    previous: s64 = -1
    if token == 0 {
        if old_count != 0 { return ExecFail(instance, .Pointer) }
    } else {
        found := ExecFindAddress(instance, token)
        if found < 0 || !ExecAddressValid(instance, found) { return ExecFail(instance, .Pointer) }
        address := instance.addresses[found]
        if address.heap == 0 || address.type != element { return ExecFail(instance, .Pointer) }
        previous = address.heap - 1
        if address.offset != instance.heap_blocks[previous].offset ||
            old_count != instance.heap_blocks[previous].count { return ExecFail(instance, .Pointer) }
    }
    if new_count == 0 {
        if previous >= 0 {
            instance.heap_blocks[previous].live = false
            ExecReleaseAddresses(instance, instance.heap_blocks[previous].addresses)
            instance.heap_blocks[previous].addresses = 0
            if !ExecHeapTrim(instance) { return false }
        }
        ExecWriteSlotBits(instance, instruction.result, 0)
        return true
    }
    available := instance.limits.value_bytes - instance.globals.count - instance.storage.count -
        instance.words.count * 8 - instance.result_bytes.count
    if available < 0 || new_count > cast(u64)9223372036854775807 ||
        size != 0 && new_count > cast(u64)(available / size) {
        ExecWriteSlotBits(instance, instruction.result, 0)
        return true
    }
    bytes := cast(s64)new_count * size
    if !ExecSpend(instance, ExecCopyCost(bytes)) { return false }
    base := instance.owned.count
    kept: s64
    if previous >= 0 {
        kept = instance.heap_blocks[previous].size
        if kept > bytes { kept = bytes }
        // The last block of the owned bytes grows or shrinks in place.
        if instance.heap_blocks[previous].offset + instance.heap_blocks[previous].size == instance.owned.count {
            base = instance.heap_blocks[previous].offset
        }
    }
    if base + bytes > available || !VecResizeBounded(instance.owned, base + bytes, available) {
        ExecWriteSlotBits(instance, instruction.result, 0)
        return true
    }
    if previous >= 0 && base != instance.heap_blocks[previous].offset {
        source := instance.heap_blocks[previous].offset
        for index: cast(s64)0..kept - 1 { instance.owned[base + index] = instance.owned[source + index] }
    }
    for index: kept..bytes - 1 { instance.owned[base + index] = 0 }
    // The block keeps its record when it grows or shrinks where it is;
    // otherwise it takes a freed record or a new one, above the old tail.
    record := previous
    below := instance.heap_tail
    // The old block's generation ends here, and its addresses with it.
    if previous >= 0 {
        ExecReleaseAddresses(instance, instance.heap_blocks[previous].addresses)
        instance.heap_blocks[previous].addresses = 0
    }
    if previous >= 0 && base == instance.heap_blocks[previous].offset {
        below = instance.heap_blocks[previous].below
    } else {
        if previous >= 0 { instance.heap_blocks[previous].live = false }
        if instance.heap_free.count > 0 {
            record = instance.heap_free[instance.heap_free.count - 1]
            unused VecResize(instance.heap_free, instance.heap_free.count - 1)
        } else {
            record = instance.heap_blocks.count
            if !VecPush(instance.heap_blocks, LirExecHeapBlock.{}) { return ExecFail(instance, .Allocation) }
        }
    }
    instance.heap_epoch += 1
    block := LirExecHeapBlock.{.offset = base, .size = bytes, .count = new_count,
        .generation = instance.heap_epoch, .live = true, .below = below}
    instance.heap_blocks[record] = block
    instance.heap_tail = record + 1
    index := ExecNewAddress(instance, .{.global = -1, .frame = -1, .generation = block.generation,
        .offset = base, .extent = bytes, .type = element, .owned = true, .writable = true,
        .heap = record + 1})
    if index < 0 { return false }
    address := instance.addresses[index]
    ExecWriteSlotBits(instance, instruction.result, address.token)
    return true
}

ExecMemoryInstruction :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction, result_type: s32) -> bool {
    if instruction.op == .FieldAddress || instruction.op == .ElementAddress {
        token := ExecSlotBits(instance, instruction.operands[0])
        low: u64
        high: u64
        count: u64
        if instruction.op == .ElementAddress && instruction.operands.count == 4 {
            low = ExecIndexBits(instance, instruction.operands[1])
            high = ExecIndexBits(instance, instruction.operands[2])
            count = ExecIndexBits(instance, instruction.operands[3])
            if instance.failure.problem != .None { return false }
            if token == 0 {
                if low != 0 || high != 0 || count != 0 { return ExecFail(instance, .Pointer) }
                ExecWriteSlotBits(instance, instruction.result, 0)
                return true
            }
        }
        address := ExecFindAddress(instance, token)
        if address < 0 { return ExecFail(instance, .Pointer) }
        expected := instance.plan.program.types[instance.plan.value_types[
            instance.current_value_base + instruction.operands[0]]].element
        if instance.addresses[address].type != expected { return ExecFail(instance, .Type) }
        target := instance.plan.program.types[result_type].element
        member := instruction.immediate
        child: u64
        if instruction.op == .ElementAddress && instruction.operands.count == 4 {
            child = ExecSliceAddress(instance, address, low, high, count, target)
        } else if instruction.op == .ElementAddress && instruction.operands.count == 3 {
            index := ExecIndexBits(instance, instruction.operands[1])
            count := ExecIndexBits(instance, instruction.operands[2])
            if instance.failure.problem != .None { return false }
            child = ExecElementAddress(instance, address, index, count, target)
        } else {
            if instruction.op == .ElementAddress {
                member = ExecIndexBits(instance, instruction.operands[1])
                if instance.failure.problem != .None { return false }
            }
            child = ExecFieldAddress(instance, address, member, target)
        }
        if instance.failure.problem != .None { return false }
        ExecWriteSlotBits(instance, instruction.result, child)
        return true
    }
    token := ExecSlotBits(instance, instruction.operands[0])
    address_index := ExecFindAddress(instance, token)
    if address_index < 0 { return ExecFail(instance, .Pointer) }
    if instruction.op == .Load {
        if instance.addresses[address_index].type != result_type { return ExecFail(instance, .Type) }
        return ExecCopyAddressToValue(instance, address_index, frame_index, instruction.result)
    }
    value := instruction.operands[1]
    if !ExecValueValid(instance, frame_index, value) ||
        instance.plan.value_types[instance.current_value_base + value] !=
            instance.addresses[address_index].type {
        return ExecFail(instance, .Type)
    }
    // Read-only globals hold string literal bytes; no address can write them.
    if !instance.addresses[address_index].writable { return ExecFail(instance, .Pointer) }
    return ExecCopyValueToAddress(instance, frame_index, value, address_index)
}

ExecBytesMatchSame :: (bytes: []u8, left: s64, right: s64, count: s64) -> bool {
    for index: cast(s64)0..count - 1 {
        if bytes[left + index] != bytes[right + index] { return false }
    }
    return true
}

ExecBytesMatchAcross :: (left: []u8, left_at: s64, right: []u8,
    right_at: s64, count: s64) -> bool {
    for index: cast(s64)0..count - 1 {
        if left[left_at + index] != right[right_at + index] { return false }
    }
    return true
}

ExecBytesEqual :: (instance: *LirExecInstance, instruction: *LirInstruction) -> bool {
    left_token := ExecSlotBits(instance, instruction.operands[0])
    left_count := ExecIndexBits(instance, instruction.operands[1])
    right_token := ExecSlotBits(instance, instruction.operands[2])
    right_count := ExecIndexBits(instance, instruction.operands[3])
    if instance.failure.problem != .None || left_count > cast(u64)9223372036854775807 ||
        right_count > cast(u64)9223372036854775807 { return ExecFail(instance, .Pointer) }
    left_address: s64 = -1
    right_address: s64 = -1
    if left_token != 0 { left_address = ExecFindAddress(instance, left_token) }
    if right_token != 0 { right_address = ExecFindAddress(instance, right_token) }
    if (left_token != 0 && left_address < 0) || (right_token != 0 && right_address < 0) ||
        (left_token == 0 && left_count != 0) || (right_token == 0 && right_count != 0) {
        return ExecFail(instance, .Pointer)
    }
    left_pointer := instance.plan.program.types[instance.plan.value_types[
        instance.current_value_base + instruction.operands[0]]]
    right_pointer := instance.plan.program.types[instance.plan.value_types[
        instance.current_value_base + instruction.operands[2]]]
    if (left_address >= 0 && instance.addresses[left_address].type != left_pointer.element) ||
        (right_address >= 0 && instance.addresses[right_address].type != right_pointer.element) {
        return ExecFail(instance, .Type)
    }
    if (left_address >= 0 && instance.addresses[left_address].extent < cast(s64)left_count) ||
        (right_address >= 0 && instance.addresses[right_address].extent < cast(s64)right_count) {
        return ExecFail(instance, .Pointer)
    }
    if left_count != right_count {
        ExecWriteSlotBits(instance, instruction.result, 0)
        return true
    }
    if left_count == 0 {
        ExecWriteSlotBits(instance, instruction.result, 1)
        return true
    }
    left_at := ExecAddressOffset(instance, left_address)
    right_at := ExecAddressOffset(instance, right_address)
    if instance.failure.problem != .None { return false }
    left := instance.addresses[left_address]
    right := instance.addresses[right_address]
    if !ExecSpend(instance, ExecCopyCost(cast(s64)left_count)) { return false }
    count := cast(s64)left_count
    equal: bool
    if left.owned {
        if right.owned {
            equal = ExecBytesMatchSame(instance.owned[:], left_at, right_at, count)
        } else if right.frame < 0 {
            equal = ExecBytesMatchAcross(instance.owned[:], left_at,
                instance.globals[:], right_at, count)
        } else {
            equal = ExecBytesMatchAcross(instance.owned[:], left_at,
                instance.storage[:], right_at, count)
        }
    } else if left.frame < 0 {
        if right.owned {
            equal = ExecBytesMatchAcross(instance.globals[:], left_at,
                instance.owned[:], right_at, count)
        } else if right.frame < 0 {
            equal = ExecBytesMatchSame(instance.globals[:], left_at, right_at, count)
        } else {
            equal = ExecBytesMatchAcross(instance.globals[:], left_at,
                instance.storage[:], right_at, count)
        }
    } else if right.owned {
        equal = ExecBytesMatchAcross(instance.storage[:], left_at,
            instance.owned[:], right_at, count)
    } else if right.frame < 0 {
        equal = ExecBytesMatchAcross(instance.storage[:], left_at,
            instance.globals[:], right_at, count)
    } else {
        equal = ExecBytesMatchSame(instance.storage[:], left_at, right_at, count)
    }
    if !equal {
        ExecWriteSlotBits(instance, instruction.result, 0)
        return true
    }
    ExecWriteSlotBits(instance, instruction.result, 1)
    return true
}

ExecUnaryInstruction :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction) -> bool {
    source_type := ExecValueType(instance, instruction.operands[0])
    bits := ExecSlotBits(instance, instruction.operands[0])
    if instance.failure.problem != .None { return false }
    if source_type.kind == .Integer {
        ExecWriteSlotBits(instance, instruction.result,
            ifx instruction.op == .Negate then cast(u64)0 - bits else ~bits)
    } else {
        sign := ifx source_type.bits == 32 then cast(u64)0x80000000 else cast(u64)0x8000000000000000
        ExecWriteSlotBits(instance, instruction.result, bits ^ sign)
    }
    return true
}

ExecNumericInstruction :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction, result_type: s32) -> bool {
    op := instruction.op
    opcode := cast(s32)op
    if opcode >= cast(s32)LirOp.Add && opcode <= cast(s32)LirOp.Remainder ||
        opcode >= cast(s32)LirOp.BitAnd && opcode <= cast(s32)LirOp.ShiftRight {
        type := ExecValueType(instance, instruction.operands[0])
        if type.kind == .Integer { return ExecIntegerBinary(instance, frame_index, instruction, type) }
        return ExecFloatBinary(instance, frame_index, instruction, type)
    }
    if opcode >= cast(s32)LirOp.Equal && opcode <= cast(s32)LirOp.GreaterEqual {
        type := ExecValueType(instance, instruction.operands[0])
        return ExecCompare(instance, frame_index, instruction, type)
    }
    if op == .Convert || op == .Bitcast {
        source := ExecValueType(instance, instruction.operands[0])
        destination := instance.plan.program.types[result_type]
        return ExecConvert(instance, frame_index, instruction, source, destination)
    }
    return ExecFail(instance, .Unsupported)
}

ExecValueInstruction :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction) -> bool {
    op := instruction.op
    result_type: s32 = LirNoId
    if instruction.result != LirNoId {
        result_type = instance.plan.value_types[instance.current_value_base + instruction.result]
    }
    if op == .Constant {
        constant := instance.plan.program.constants[instruction.symbol]
        ExecWriteSlotBits(instance, instruction.result, constant.bits)
    } else if op == .Null { ExecWriteSlotBits(instance, instruction.result, 0) }
    else if op == .GlobalAddress {
        ExecWriteSlotBits(instance, instruction.result, instance.addresses[instruction.symbol].token)
    } else if op == .FunctionAddress {
        ExecWriteSlotBits(instance, instruction.result, cast(u64)(instruction.symbol + 1))
    } else if op == .Aggregate {
        if !ExecAggregate(instance, frame_index, instruction) { return false }
    } else if op == .Extract || op == .Insert {
        if !ExecExtractInsert(instance, frame_index, instruction) { return false }
    } else if op == .FieldAddress || op == .ElementAddress || op == .Load || op == .Store {
        if !ExecMemoryInstruction(instance, frame_index, instruction, result_type) { return false }
    } else if op == .BytesEqual {
        if !ExecBytesEqual(instance, instruction) { return false }
    } else if op == .Allocate {
        if !ExecAllocate(instance, frame_index, instruction, result_type) { return false }
    } else if op == .Resize {
        if !ExecResize(instance, instruction, result_type) { return false }
    } else if op == .Negate || op == .BitNot {
        if !ExecUnaryInstruction(instance, frame_index, instruction) { return false }
    } else if !ExecNumericInstruction(instance, frame_index, instruction, result_type) { return false }
    instance.frames[frame_index].instruction += 1
    return true
}

ExecHostCanonical :: (type: LirType, bits: u64) -> bool {
    if type.kind == .Bool { return bits <= cast(u64)1 }
    if type.kind == .Integer { return (bits & ~ExecMask(type.bits)) == cast(u64)0 }
    if type.kind == .Float && type.bits == 32 { return bits <= cast(u64)4294967295 }
    return type.kind == .Float && type.bits == 64
}

ExecHostScalarType :: (type: LirType) -> bool {
    return type.kind == .Bool || type.kind == .Integer || type.kind == .Float
}

ExecHostHandleType :: (program: LirProgram, type: s32) -> bool {
    return program.types[type].kind == .Pointer
}

// Scalars and opaque handles cross a typed host boundary in `bits`; every
// other host shape crosses as an image in `bytes`.
ExecHostBitsType :: (program: LirProgram, type: s32) -> bool {
    return ExecHostScalarType(program.types[type]) || ExecHostHandleType(program, type)
}

ExecHostSignature :: (plan: *LirExecPlan, function: s32, typed: bool) -> bool {
    program := plan.program
    fn := program.functions[function]
    for parameter: fn.parameters {
        if typed {
            if plan.host_shapes[parameter] == 0 { return false }
        } else if !ExecHostScalarType(program.types[parameter]) { return false }
    }
    if program.types[fn.result].kind == .Void { return true }
    if typed { return plan.host_shapes[fn.result] != 0 }
    return ExecHostScalarType(program.types[fn.result])
}

// Where decoded host bytes go: a frame's storage, the instance-owned bytes
// or the globals.
ExecStore :: enum u8 { Frame; Owned; Globals }

ExecStoreBits :: (instance: *LirExecInstance, store: ExecStore, at: s64, count: s64, bits: u64) {
    if store == .Owned { ExecWriteBits(instance.owned[:], at, count, bits) }
    else if store == .Globals { ExecWriteBits(instance.globals[:], at, count, bits) }
    else { ExecWriteBits(instance.storage[:], at, count, bits) }
}

ExecHostAvailable :: (instance: *LirExecInstance) -> s64 {
    return instance.limits.value_bytes - instance.globals.count - instance.storage.count -
        instance.words.count * 8 - instance.result_bytes.count - instance.owned.count
}

// A host image is the value's own bytes followed by the elements of every
// view inside it. In the image a view's two words are the byte offset of its
// first element from the start of the image and its element count; an empty
// view is two zero words. Elements are images themselves, so views nest.
// Handles keep their bits.
//
// Writes the image of the `type` value at `source[from]` to the host bytes at
// `to` and appends its view elements. `base` is where the whole image starts
// and `limit` bounds the host bytes.
ExecHostEncode :: (instance: *LirExecInstance, type: s32, source: []u8, from: s64,
    base: s64, to: s64, limit: s64) -> bool {
    plan := instance.plan
    program := plan.program
    size := plan.type_sizes[type]
    if plan.host_shapes[type] < LirHostShapeViews {
        if !ExecSpend(instance, ExecCopyCost(size)) { return false }
        for byte: cast(s64)0..size - 1 { instance.host_bytes[to + byte] = source[from + byte] }
        return true
    }
    value := program.types[type]
    if LirHostView(program, type) {
        token := ExecReadBits(source, from, 8)
        count := ExecReadBits(source, from + 8, 8)
        if !ExecSpend(instance, 1) { return false }
        if count == 0 {
            ExecWriteBits(instance.host_bytes[:], to, 8, 0)
            ExecWriteBits(instance.host_bytes[:], to + 8, 8, 0)
            return true
        }
        element := program.types[value.fields[0]].element
        width := plan.type_sizes[element]
        found := ExecFindAddress(instance, token)
        if found < 0 || width <= 0 || count > cast(u64)9223372036854775807 ||
            instance.addresses[found].type != element || !ExecAddressValid(instance, found) ||
            count > cast(u64)(instance.addresses[found].extent / width) { return ExecFail(instance, .Host) }
        bytes := cast(s64)count * width
        at := instance.host_bytes.count
        if bytes > limit - at { return ExecFail(instance, .ValueBytes) }
        if !VecResizeBounded(instance.host_bytes, at + bytes, limit) { return ExecFail(instance, .Allocation) }
        ExecWriteBits(instance.host_bytes[:], to, 8, cast(u64)(at - base))
        ExecWriteBits(instance.host_bytes[:], to + 8, 8, count)
        // The elements live wherever the address was made: owned bytes,
        // globals or a frame.
        entry := instance.addresses[found]
        elements := instance.storage[:]
        if entry.owned { elements = instance.owned[:] }
        else if entry.frame < 0 { elements = instance.globals[:] }
        offset := ExecAddressOffset(instance, found)
        if instance.failure.problem != .None { return false }
        if plan.host_shapes[element] < LirHostShapeViews {
            if !ExecSpend(instance, ExecCopyCost(bytes)) { return false }
            for byte: cast(s64)0..bytes - 1 { instance.host_bytes[at + byte] = elements[offset + byte] }
            return true
        }
        for index: cast(s64)0..cast(s64)count - 1 {
            if !ExecHostEncode(instance, element, elements, offset + index * width,
                base, at + index * width, limit) { return false }
        }
        return true
    }
    if value.kind == .Array {
        width := plan.type_sizes[value.element]
        for index: cast(s64)0..value.count - 1 {
            if !ExecHostEncode(instance, value.element, source, from + index * width,
                base, to + index * width, limit) { return false }
        }
        return true
    }
    offset: s64
    for field: value.fields {
        if !ExecHostEncode(instance, field, source, from + offset, base, to + offset, limit) { return false }
        offset += plan.type_sizes[field]
    }
    return true
}

ExecTypedHostArguments :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction) -> bool {
    program := instance.plan.program
    count := instruction.operands.count
    available := ExecHostAvailable(instance)
    if available < 0 { return ExecFail(instance, .ValueBytes) }
    unused VecResize(instance.host_bytes, 0)
    // Earlier calls may have left more room than this one needs.
    if !VecResize(instance.typed_arguments, count) ||
        !VecResize(instance.host_arguments, count) { return ExecFail(instance, .Allocation) }
    for index: cast(s64)0..count - 1 {
        operand := instruction.operands[index]
        type := instance.plan.value_types[instance.current_value_base + operand]
        value := LirExecArgument.{.type = type}
        if ExecHostBitsType(program, type) {
            value.bits = ExecSlotBits(instance, operand)
            if instance.failure.problem != .None { return false }
        } else {
            if !ExecValueValid(instance, frame_index, operand) { return false }
            size := instance.plan.type_sizes[type]
            at := instance.host_bytes.count
            if size > available - at { return ExecFail(instance, .ValueBytes) }
            if !VecResizeBounded(instance.host_bytes, at + size, available) { return ExecFail(instance, .Allocation) }
            source := ExecFrameValueOffset(instance, frame_index, operand)
            if !ExecHostEncode(instance, type, instance.storage[:], source, at, at, available) { return false }
            // The image is sliced below, once the host bytes have stopped growing.
            instance.host_arguments[index] = cast(u64)at
            value.bits = cast(u64)(instance.host_bytes.count - at)
        }
        instance.typed_arguments[index] = value
    }
    for index: cast(s64)0..count - 1 {
        if ExecHostBitsType(program, instance.typed_arguments[index].type) { continue }
        start := cast(s64)instance.host_arguments[index]
        end := start + cast(s64)instance.typed_arguments[index].bits
        instance.typed_arguments[index].bits = 0
        instance.typed_arguments[index].bytes = VecSlice(instance.host_bytes, start, end)
    }
    return true
}

// Reads the `type` value at `image[from]` of a host image into `store` at
// `to`. Each view's elements become read-only instance-owned storage that
// stays valid for globals and later calls.
ExecHostDecode :: (instance: *LirExecInstance, type: s32, image: []u8, from: s64,
    store: ExecStore, to: s64) -> bool {
    plan := instance.plan
    program := plan.program
    value := program.types[type]
    size := plan.type_sizes[type]
    if from < 0 || size > image.count - from { return ExecFail(instance, .Host) }
    if !ExecSpend(instance, 1) { return false }
    if value.kind == .Array {
        width := plan.type_sizes[value.element]
        for index: cast(s64)0..value.count - 1 {
            if !ExecHostDecode(instance, value.element, image, from + index * width,
                store, to + index * width) { return false }
        }
        return true
    }
    if value.kind == .Record && !LirHostView(program, type) {
        offset: s64
        for field: value.fields {
            if !ExecHostDecode(instance, field, image, from + offset, store, to + offset) { return false }
            offset += plan.type_sizes[field]
        }
        return true
    }
    if value.kind != .Record {
        bits := ExecReadBits(image, from, size)
        if value.kind == .Bool && bits > cast(u64)1 { return ExecFail(instance, .Host) }
        ExecStoreBits(instance, store, to, size, bits)
        return true
    }
    start := ExecReadBits(image, from, 8)
    count := ExecReadBits(image, from + 8, 8)
    token: u64
    if count == 0 {
        if start != 0 { return ExecFail(instance, .Host) }
    } else {
        element := program.types[value.fields[0]].element
        width := plan.type_sizes[element]
        if width <= 0 || start > cast(u64)image.count ||
            count > cast(u64)((image.count - cast(s64)start) / width) { return ExecFail(instance, .Host) }
        bytes := cast(s64)count * width
        if bytes > ExecHostAvailable(instance) { return ExecFail(instance, .ValueBytes) }
        base := instance.owned.count
        if !VecResizeBounded(instance.owned, base + bytes, base + bytes) { return ExecFail(instance, .Allocation) }
        instance.heap_tail = 0
        index := ExecNewAddress(instance, .{.global = -1, .frame = -1, .offset = base, .extent = bytes,
            .type = element, .owned = true, .writable = false})
        if index < 0 { return false }
        token = instance.addresses[index].token
        kind := program.types[element].kind
        if kind == .Integer || kind == .Float {
            if !ExecSpend(instance, ExecCopyCost(bytes)) { return false }
            for byte: cast(s64)0..bytes - 1 { instance.owned[base + byte] = image[cast(s64)start + byte] }
        } else {
            for index: cast(s64)0..cast(s64)count - 1 {
                if !ExecHostDecode(instance, element, image, cast(s64)start + index * width,
                    .Owned, base + index * width) { return false }
            }
        }
    }
    ExecStoreBits(instance, store, to, 8, token)
    ExecStoreBits(instance, store, to + 8, 8, count)
    return true
}

ExecTypedHostResult :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction, result: LirExecArgument) -> bool {
    program := instance.plan.program
    expected := program.functions[instruction.symbol].result
    if result.type != expected { return ExecFail(instance, .Host) }
    type := program.types[expected]
    if type.kind == .Void { return result.bytes.count == 0 || ExecFail(instance, .Host) }
    if instruction.result == LirNoId { return ExecFail(instance, .Host) }
    if ExecHostBitsType(program, expected) {
        if result.bytes.count != 0 ||
            ExecHostScalarType(type) && !ExecHostCanonical(type, result.bits) { return ExecFail(instance, .Host) }
        ExecWriteSlotBits(instance, instruction.result, result.bits)
        return instance.failure.problem == .None
    }
    // A value without views is exactly its own bytes.
    if instance.plan.host_shapes[expected] < LirHostShapeViews &&
        result.bytes.count != instance.plan.type_sizes[expected] { return ExecFail(instance, .Host) }
    destination := ExecFrameValueOffset(instance, frame_index, instruction.result)
    owned_count := instance.owned.count
    heap_tail := instance.heap_tail
    if !ExecHostDecode(instance, expected, result.bytes, 0, .Frame, destination) {
        // A rejected image leaves no storage behind; the addresses made for
        // it name bytes that are gone, so they are never valid.
        instance.heap_tail = heap_tail
        unused VecResize(instance.owned, owned_count)
        return false
    }
    ExecMarkValue(instance, frame_index, instruction.result)
    return true
}

ExecHostViewParameter :: (host: LirExecHostBinding, index: s64) -> bool {
    return index < 64 && ((host.views >> cast(u64)index) & cast(u64)1) != cast(u64)0
}

// Where the elements of the view argument `index` lie: their store and byte
// range. Returns the view's address, or -1 when it is empty. Encoding the
// argument checked the address.
ExecViewSpan :: (instance: *LirExecInstance, frame_index: s64, instruction: *LirInstruction,
    index: s64, store: *ExecStore, start: *s64, end: *s64) -> s32 {
    program := instance.plan.program
    source := ExecFrameValueOffset(instance, frame_index, instruction.operands[index])
    count := cast(s64)ExecReadBits(instance.storage[:], source + 8, 8)
    found := ExecFindAddress(instance, ExecReadBits(instance.storage[:], source, 8))
    if count == 0 || found < 0 { return -1 }
    view := program.types[instance.typed_arguments[index].type]
    width := instance.plan.type_sizes[program.types[view.fields[0]].element]
    entry := instance.addresses[found]
    <<store = .Frame
    if entry.owned { <<store = .Owned } else if entry.frame < 0 { <<store = .Globals }
    <<start = ExecAddressOffset(instance, found)
    <<end = <<start + count * width
    return found
}

// Two mutable view arguments of one call may not share elements: the host
// would see one change through the other and one copy-back would be lost.
ExecHostViewsApart :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction, host: LirExecHostBinding) -> bool {
    count := instruction.operands.count
    if host.views == cast(u64)0 { return true }
    for left: cast(s64)0..count - 1 {
        left_store: ExecStore
        left_start: s64
        left_end: s64
        if !ExecHostViewParameter(host, left) ||
            ExecViewSpan(instance, frame_index, instruction, left, *left_store, *left_start, *left_end) < 0 { continue }
        for right: left + 1..count - 1 {
            right_store: ExecStore
            right_start: s64
            right_end: s64
            if !ExecHostViewParameter(host, right) ||
                ExecViewSpan(instance, frame_index, instruction, right, *right_store, *right_start, *right_end) < 0 { continue }
            if left_store == right_store && left_start < right_end && right_start < left_end {
                return ExecFail(instance, .Host)
            }
        }
    }
    return instance.failure.problem == .None
}

// Copies the elements of each mutable view argument the host changed back
// into the view's storage. An element whose own image bytes are the ones
// the host was given is left as it is, so an unchanged string in it takes
// no new bytes and read-only storage passes when nothing in it changed.
ExecTypedHostCopyBack :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction, host: LirExecHostBinding) -> bool {
    plan := instance.plan
    program := plan.program
    for index: cast(s64)0..instruction.operands.count - 1 {
        argument := instance.typed_arguments[index]
        if !argument.changed { continue }
        if !ExecHostViewParameter(host, index) { return ExecFail(instance, .Host) }
        source := ExecFrameValueOffset(instance, frame_index, instruction.operands[index])
        count := ExecReadBits(instance.storage[:], source + 8, 8)
        image := argument.bytes
        if image.count < 16 || ExecReadBits(image, 8, 8) != count { return ExecFail(instance, .Host) }
        if count == 0 { continue }
        store: ExecStore
        at: s64
        end: s64
        found := ExecViewSpan(instance, frame_index, instruction, index, *store, *at, *end)
        if found < 0 { return ExecFail(instance, .Host) }
        writable := instance.addresses[found].writable
        element := program.types[program.types[argument.type].fields[0]].element
        width := plan.type_sizes[element]
        start := ExecReadBits(image, 0, 8)
        if start > cast(u64)image.count ||
            count > cast(u64)((image.count - cast(s64)start) / width) { return ExecFail(instance, .Host) }
        // The elements of the image the host was given.
        given := cast(s64)instance.host_arguments[index]
        given += cast(s64)ExecReadBits(instance.host_bytes[:], given, 8)
        kind := program.types[element].kind
        if kind == .Integer || kind == .Float {
            bytes := cast(s64)count * width
            if ExecBytesMatchAcross(image, cast(s64)start, instance.host_bytes[:], given, bytes) { continue }
            if !writable { return ExecFail(instance, .Pointer) }
            if !ExecSpend(instance, ExecCopyCost(bytes)) { return false }
            for byte: cast(s64)0..bytes - 1 {
                ExecStoreBits(instance, store, at + byte, 1, cast(u64)image[cast(s64)start + byte])
            }
            continue
        }
        for item: cast(s64)0..cast(s64)count - 1 {
            from := cast(s64)start + item * width
            if ExecBytesMatchAcross(image, from, instance.host_bytes[:], given + item * width, width) { continue }
            if !writable { return ExecFail(instance, .Pointer) }
            if !ExecHostDecode(instance, element, image, from, store, at + item * width) { return false }
        }
    }
    return true
}

ExecHostBinding :: (instance: *LirExecInstance, function: s32) -> s64 {
    for index: cast(s64)0..instance.hosts.count - 1 {
        if instance.hosts[index].function == function { return index }
    }
    return -1
}

ExecPlatformWriteSignature :: (program: LirProgram, function: s32) -> bool {
    fn := program.functions[function]
    if fn.parameters.count != 3 || program.types[fn.result].kind != .Void { return false }
    descriptor := program.types[fn.parameters[0]]
    pointer := program.types[fn.parameters[1]]
    count := program.types[fn.parameters[2]]
    if descriptor.kind != .Integer || descriptor.bits != 64 || descriptor.is_signed ||
        pointer.kind != .Pointer || count.kind != .Integer || count.bits != 64 || count.is_signed { return false }
    element := program.types[pointer.element]
    return element.kind == .Integer && element.bits == 8 && !element.is_signed
}

ExecPlatformWriteCall :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *LirInstruction, host: LirExecHostBinding) -> bool {
    descriptor := ExecSlotBits(instance, instruction.operands[0])
    token := ExecSlotBits(instance, instruction.operands[1])
    count := ExecSlotBits(instance, instruction.operands[2])
    if instance.failure.problem != .None { return false }
    if count > cast(u64)9223372036854775807 { return ExecFail(instance, .Pointer) }
    size := cast(s64)count
    empty: [0]u8
    bytes: []u8 = empty[:]
    if size != 0 {
        found := ExecFindAddress(instance, token)
        if found < 0 || instance.addresses[found].extent < size || !ExecAddressValid(instance, found) {
            return ExecFail(instance, .Pointer)
        }
        entry := instance.addresses[found]
        pointee := instance.plan.program.types[entry.type]
        if pointee.kind != .Integer || pointee.bits != 8 || pointee.is_signed { return ExecFail(instance, .Pointer) }
        at := ExecAddressOffset(instance, found)
        if instance.failure.problem != .None { return false }
        if !ExecSpend(instance, ExecCopyCost(size)) { return false }
        if entry.owned { bytes = instance.owned[at:at + size] }
        else if entry.frame < 0 { bytes = instance.globals[at:at + size] }
        else { bytes = instance.storage[at:at + size] }
    }
    if !host.write(host.context, descriptor, bytes) { return ExecFail(instance, .Host) }
    instance.frames[frame_index].instruction += 1
    return true
}

ExecHostCall :: (instance: *LirExecInstance, frame_index: s64, instruction: *LirInstruction) -> bool {
    program := instance.plan.program
    binding := ExecHostBinding(instance, instruction.symbol)
    if binding < 0 { return ExecFail(instance, .Host) }
    count := instruction.operands.count
    if !ExecSpend(instance, count) { return false }
    host := instance.hosts[binding]
    if host.write != null { return ExecPlatformWriteCall(instance, frame_index, instruction, host) }
    if host.typed != null {
        if !ExecTypedHostArguments(instance, frame_index, instruction) ||
            !ExecHostViewsApart(instance, frame_index, instruction, host) { return false }
        result := LirExecArgument.{.type = LirNoId}
        if !host.typed(host.context, instruction.symbol,
            VecSlice(instance.typed_arguments, 0, count), *result) ||
            !ExecTypedHostCopyBack(instance, frame_index, instruction, host) ||
            !ExecTypedHostResult(instance, frame_index, instruction, result) {
            if instance.failure.problem == .None { return ExecFail(instance, .Host) }
            return false
        }
        instance.frames[frame_index].instruction += 1
        return true
    }
    if !VecResize(instance.host_arguments, count) { return ExecFail(instance, .Allocation) }
    for at: cast(s64)0..count - 1 {
        instance.host_arguments[at] = ExecSlotBits(instance, instruction.operands[at])
        if instance.failure.problem != .None { return false }
    }
    result: u64
    if !host.call(host.context, instruction.symbol, VecSlice(instance.host_arguments, 0, count), *result) {
        return ExecFail(instance, .Host)
    }
    if instruction.result != LirNoId {
        if !ExecHostCanonical(program.types[program.functions[instruction.symbol].result], result) {
            return ExecFail(instance, .Host)
        }
        ExecWriteSlotBits(instance, instruction.result, result)
    }
    instance.frames[frame_index].instruction += 1
    return true
}

ExecStep :: (instance: *LirExecInstance) -> bool {
    frame_index := instance.frames.count - 1
    frame := instance.frames[frame_index]
    instruction := *instance.plan.instructions[frame.instruction_base + frame.instruction]
    if !ExecSpend(instance, 1) { return false }
    op := instruction.op
    if op == .Fuel {
        amount := cast(s64)instruction.immediate
        if amount > instance.fuel_remaining { return ExecFail(instance, .FuelLimit) }
        instance.fuel_remaining -= amount
        instance.frames[frame_index].instruction += 1
        return true
    }
    if op == .Trap { return ExecFail(instance, .Trap, instruction.immediate) }
    if op == .Unreachable { return ExecFail(instance, .Unreachable) }
    function_plan := instance.plan.functions[frame.function]
    edge_base := instance.plan.block_edge_bases[function_plan.block_base + frame.block]
    if op == .Jump {
        return ExecEdge(instance, frame_index, *instruction.edges[0],
            instance.plan.edge_direct[edge_base] != 0)
    }
    if op == .Branch {
        condition := ExecSlotBits(instance, instruction.operands[0]) != 0
        if instance.failure.problem != .None { return false }
        edge_index: s64 = ifx condition then 0 else 1
        return ExecEdge(instance, frame_index, *instruction.edges[edge_index],
            instance.plan.edge_direct[edge_base + edge_index] != 0)
    }
    if op == .Return { return ExecFinishFrame(instance, frame_index, instruction) }
    if op == .HostCall { return ExecHostCall(instance, frame_index, instruction) }
    if op == .Call || op == .CallIndirect {
        return ExecCallInstruction(instance, frame_index, instruction)
    }
    return ExecValueInstruction(instance, frame_index, instruction)
}

ExecResetRun :: (instance: *LirExecInstance) -> bool {
    // Frames a failed run left behind give their addresses back too.
    for frame: instance.frames { ExecReleaseAddresses(instance, frame.addresses) }
    if !VecResize(instance.frames, 0) || !VecResize(instance.storage, 0) ||
        !VecResize(instance.words, 0) ||
        !VecResize(instance.validity, 0) || !VecResize(instance.result_bytes, 0) { return false }
    instance.live_values = 0
    instance.current_value_base = 0
    instance.current_word_base = 0
    instance.current_valid_base = 0
    instance.result_value = .{.type = LirNoId}
    instance.failure = ExecResult(.None)
    instance.work_remaining = instance.limits.work
    instance.fuel_remaining = instance.limits.fuel
    return true
}

ExecRunRoot :: (instance: *LirExecInstance, function: s32, arguments: []LirExecArgument) -> bool {
    no_operands: [0]s32
    if !ExecPushFrame(instance, function, -1, no_operands[:], LirNoId, arguments) { return false }
    while instance.frames.count != 0 && instance.failure.problem == .None {
        if !ExecStep(instance) { break }
    }
    return instance.failure.problem == .None
}

ExecRunFunction :: (instance: *LirExecInstance, function: s32, arguments: []LirExecArgument) -> LirExecResult {
    if instance == null || !instance.ready || instance.plan == null || !instance.plan.ready {
        return ExecResult(.NotReady)
    }
    if instance.running { return ExecResult(.Busy) }
    if instance.initializer_failed { return instance.initializer_failure }
    program := instance.plan.program
    // LirNoId runs only the initializers that have not run yet.
    if function != LirNoId && (function < 0 || function >= program.functions.count ||
        program.functions[function].external) {
        return ExecResult(.Calling)
    }
    for index: cast(s32)0..cast(s32)program.functions.count - 1 {
        if program.functions[index].external && ExecHostBinding(instance, index) < 0 {
            missing := ExecResult(.Host)
            missing.function = index
            return missing
        }
    }
    if !ExecResetRun(instance) { return ExecResult(.Allocation) }
    instance.running = true
    no_arguments: [0]LirExecArgument
    if !instance.initialized {
        for initializer: program.initializers {
            if !ExecRunRoot(instance, initializer, no_arguments[:]) { break }
        }
        if instance.failure.problem == .None {
            instance.initialized = true
            instance.result_value = .{.type = LirNoId}
            unused VecResize(instance.result_bytes, 0)
        } else {
            instance.initializer_failed = true
            instance.initializer_failure = instance.failure
        }
    }
    if instance.failure.problem == .None && function != LirNoId && !ExecRunRoot(instance, function, arguments) {
        // ExecRunRoot records the stable failure location in the instance.
    }
    if instance.failure.problem != .None {
        instance.running = false
        result := instance.failure
        unused VecResize(instance.frames, 0)
        unused VecResize(instance.storage, 0)
        unused VecResize(instance.words, 0)
        unused VecResize(instance.validity, 0)
        instance.live_values = 0
        return result
    }
    instance.running = false
    result := ExecResult(.None)
    result.value = instance.result_value
    result.work_remaining = instance.work_remaining
    result.fuel_remaining = instance.fuel_remaining
    return result
}

ExecGlobalAccess :: (instance: *LirExecInstance, global: s32) -> LirExecProblem {
    if instance == null || !instance.ready || instance.plan == null || !instance.initialized { return .NotReady }
    if instance.running { return .Busy }
    program := instance.plan.program
    if global < 0 || global >= program.globals.count { return .Calling }
    if instance.plan.host_shapes[program.globals[global].type] == 0 { return .Type }
    instance.failure = ExecResult(.None)
    instance.work_remaining = instance.limits.work
    return .None
}

#scope_export

LirExecDefaultLimits :: () -> LirExecLimits {
    return .{.work = 16000000, .fuel = 16000000, .frames = 128,
        .values = 1048576, .addresses = 1048576, .value_bytes = 268435456}
}

// Heap blocks an instance still holds. A program that frees or drops every
// owned value ends with none.
LirExecHeapLive :: (instance: *LirExecInstance) -> s64 {
    live: s64
    if instance == null { return 0 }
    for block: instance.heap_blocks { if block.live { live += 1 } }
    return live
}

LirExecPlanFree :: (plan: *LirExecPlan) {
    if plan == null { return }
    VecFree(plan.type_sizes)
    VecFree(plan.value_offsets)
    VecFree(plan.value_words)
    VecFree(plan.value_sizes)
    VecFree(plan.value_types)
    VecFree(plan.value_canonical)
    VecFree(plan.value_masks)
    VecFree(plan.host_shapes)
    VecFree(plan.functions)
    VecFree(plan.block_edge_bases)
    VecFree(plan.block_instruction_bases)
    VecFree(plan.edge_direct)
    VecFree(plan.instructions)
    VecFree(plan.global_offsets)
    plan.program = .{}
    plan.global_bytes = 0
    plan.ready = false
}

LirExecInstanceClose :: (instance: *LirExecInstance) {
    if instance == null { return }
    VecFree(instance.globals)
    VecFree(instance.addresses)
    VecFree(instance.address_slots)
    VecFree(instance.address_free)
    instance.address_used = 0
    VecFree(instance.storage)
    VecFree(instance.words)
    VecFree(instance.validity)
    VecFree(instance.frames)
    VecFree(instance.result_bytes)
    VecFree(instance.hosts)
    VecFree(instance.host_arguments)
    VecFree(instance.typed_arguments)
    VecFree(instance.host_bytes)
    VecFree(instance.owned)
    VecFree(instance.heap_blocks)
    VecFree(instance.heap_free)
    instance.heap_tail = 0
    instance.heap_epoch = 0
    instance.plan = null
    instance.limits = .{}
    instance.identity = 0
    instance.result_value = .{.type = LirNoId}
    instance.live_values = 0
    instance.current_value_base = 0
    instance.current_word_base = 0
    instance.current_valid_base = 0
    instance.work_remaining = 0
    instance.fuel_remaining = 0
    instance.failure = ExecResult(.None)
    instance.initializer_failure = ExecResult(.None)
    instance.initialized = false
    instance.initializer_failed = false
    instance.ready = false
    instance.running = false
}

LirExecPlanBuild :: (program: LirProgram, verify_limits: LirLimits, output: *LirExecPlan) -> LirExecResult {
    if output == null { return ExecResult(.NotReady) }
    LirExecPlanFree(output)
    diagnostic := LirVerify(program, verify_limits)
    if diagnostic.problem != .None {
        result := ExecResult(.InvalidProgram)
        result.verification = diagnostic
        result.function = diagnostic.function
        result.block = diagnostic.block
        result.instruction = diagnostic.instruction
        result.origin = diagnostic.origin
        return result
    }
    output.program = program
    problem := ExecPlanLayouts(program, output, verify_limits.bytes)
    if problem == .None && !LirHostShapes(program, *output.host_shapes) { problem = .Allocation }
    if problem == .None { problem = ExecPlanFunctions(program, output, verify_limits.bytes) }
    if problem != .None {
        result := ExecResult(problem)
        LirExecPlanFree(output)
        return result
    }
    output.ready = true
    return ExecResult(.None)
}

LirExecInstanceOpen :: (plan: *LirExecPlan, limits: LirExecLimits, identity: u32,
    output: *LirExecInstance) -> LirExecResult {
    if output == null { return ExecResult(.NotReady) }
    LirExecInstanceClose(output)
    if plan == null || !plan.ready || identity == 0 ||
        limits.work < 0 || limits.fuel < 0 || limits.frames < 1 || limits.values < 0 ||
        limits.addresses < 0 || limits.value_bytes < 0 {
        return ExecResult(.NotReady)
    }
    if limits.addresses < plan.program.globals.count { return ExecResult(.AddressLimit) }
    if plan.global_bytes > limits.value_bytes { return ExecResult(.ValueBytes) }
    output.plan = plan
    output.limits = limits
    output.identity = identity
    output.frame_epoch = 1
    output.work_remaining = limits.work
    output.fuel_remaining = limits.fuel
    output.failure = ExecResult(.None)
    if !VecResizeBounded(output.globals, plan.global_bytes, limits.value_bytes) ||
        !VecResizeBounded(output.addresses, plan.program.globals.count, limits.addresses) {
        LirExecInstanceClose(output)
        return ExecResult(.Allocation)
    }
    for global_index: cast(s64)0..plan.program.globals.count - 1 {
        global := plan.program.globals[global_index]
        offset := plan.global_offsets[global_index]
        output.addresses[global_index] = .{.token = ExecAddressToken(identity, global_index),
            .global = cast(s32)global_index, .frame = -1, .offset = offset,
            .extent = plan.type_sizes[global.type], .type = global.type,
            .writable = global.writable}
        if global.constant != LirNoId {
            constant := plan.program.constants[global.constant]
            type := plan.program.types[global.type]
            if type.kind == .Array {
                for at: cast(s64)0..constant.bytes.count - 1 { output.globals[offset + at] = constant.bytes[at] }
            } else {
                bits := constant.bits
                if type.kind == .Bool { bits = cast(u64)(bits != 0) }
                if type.kind == .Integer { bits &= ExecMask(type.bits) }
                ExecWriteBits(output.globals[:], offset, plan.type_sizes[global.type], bits)
            }
        }
    }
    output.ready = true
    return ExecResult(.None)
}

LirExecRun :: (instance: *LirExecInstance) -> LirExecResult {
    if instance == null || !instance.ready || instance.plan.program.entry == LirNoId {
        return ExecResult(.NotReady)
    }
    no_arguments: [0]LirExecArgument
    return ExecRunFunction(instance, instance.plan.program.entry, no_arguments[:])
}

LirExecCall :: (instance: *LirExecInstance, function: s32, arguments: []LirExecArgument) -> LirExecResult {
    return ExecRunFunction(instance, function, arguments)
}

// Runs the global initializers now, as the first run would. Every later
// run returns their failure.
LirExecInitialize :: (instance: *LirExecInstance) -> LirExecResult {
    no_arguments: [0]LirExecArgument
    return ExecRunFunction(instance, LirNoId, no_arguments[:])
}

// Puts the host image of global `global` in the instance's host bytes
// between runs, as a host call would be given it. They hold it until the
// next call into the instance.
LirExecGlobalImage :: (instance: *LirExecInstance, global: s32) -> LirExecProblem {
    problem := ExecGlobalAccess(instance, global)
    if problem != .None { return problem }
    plan := instance.plan
    type := plan.program.globals[global].type
    size := plan.type_sizes[type]
    available := ExecHostAvailable(instance)
    unused VecResize(instance.host_bytes, 0)
    if size > available { return .ValueBytes }
    if !VecResizeBounded(instance.host_bytes, size, available) { return .Allocation }
    if !ExecHostEncode(instance, type, instance.globals[:], plan.global_offsets[global], 0, 0, available) {
        return instance.failure.problem
    }
    return .None
}

// Gives global `global` the value of a host image of its type between runs.
// View elements become read-only instance-owned storage; a rejected image
// leaves none behind.
LirExecGlobalStore :: (instance: *LirExecInstance, global: s32, image: []u8) -> LirExecProblem {
    problem := ExecGlobalAccess(instance, global)
    if problem != .None { return problem }
    plan := instance.plan
    type := plan.program.globals[global].type
    if !plan.program.globals[global].writable { return .Pointer }
    if plan.host_shapes[type] < LirHostShapeViews && image.count != plan.type_sizes[type] { return .Host }
    owned_count := instance.owned.count
    heap_tail := instance.heap_tail
    if !ExecHostDecode(instance, type, image, 0, .Globals, plan.global_offsets[global]) {
        instance.heap_tail = heap_tail
        unused VecResize(instance.owned, owned_count)
        return instance.failure.problem
    }
    return .None
}

LirExecResultCopy :: (instance: *LirExecInstance, output: []u8) -> bool {
    if instance == null || !instance.ready || instance.result_value.type == LirNoId ||
        output.count < instance.result_bytes.count { return false }
    for index: cast(s64)0..instance.result_bytes.count - 1 { output[index] = instance.result_bytes[index] }
    return true
}

LirExecBindHost :: (instance: *LirExecInstance, function: s32, call: LirExecHostCall, context: *void) -> LirExecProblem {
    if instance == null || !instance.ready || instance.plan == null { return .NotReady }
    if instance.running { return .Busy }
    program := instance.plan.program
    if call == null || function < 0 || function >= program.functions.count ||
        !program.functions[function].external || program.functions[function].calling != .Host ||
        ExecHostBinding(instance, function) >= 0 || !ExecHostSignature(instance.plan, function, false) { return .Calling }
    if !VecPush(instance.hosts, LirExecHostBinding.{function = function, call = call, context = context}) { return .Allocation }
    return .None
}

LirExecBindHostTyped :: (instance: *LirExecInstance, function: s32,
    call: LirExecTypedHostCall, context: *void) -> LirExecProblem {
    if instance == null || !instance.ready || instance.plan == null { return .NotReady }
    if instance.running { return .Busy }
    program := instance.plan.program
    if call == null || function < 0 || function >= program.functions.count ||
        !program.functions[function].external || program.functions[function].calling != .Host ||
        ExecHostBinding(instance, function) >= 0 || !ExecHostSignature(instance.plan, function, true) { return .Calling }
    if !VecPush(instance.hosts, LirExecHostBinding.{function = function, typed = call, context = context}) {
        return .Allocation
    }
    return .None
}

// Binds parameter `parameter` of typed host function `function` as a
// mutable view (see LirExecArgument). The first 64 parameters can be.
LirExecHostMutableView :: (instance: *LirExecInstance, function: s32, parameter: s32) -> LirExecProblem {
    if instance == null || !instance.ready || instance.plan == null { return .NotReady }
    if instance.running { return .Busy }
    binding := ExecHostBinding(instance, function)
    if binding < 0 || instance.hosts[binding].typed == null { return .Calling }
    program := instance.plan.program
    parameters := program.functions[function].parameters
    if parameter < 0 || parameter >= 64 || cast(s64)parameter >= parameters.count ||
        !LirHostView(program, parameters[parameter]) { return .Calling }
    instance.hosts[binding].views |= cast(u64)1 << cast(u64)parameter
    return .None
}

// Bind a bodiless `(u64, *u8, u64) -> void` host function as checked
// platform byte output. Each call borrows exactly `count` bytes from the
// checked data pointer; a null pointer is valid only with count zero.
LirExecBindPlatformWrite :: (instance: *LirExecInstance, function: s32,
    call: LirExecPlatformWrite, context: *void) -> LirExecProblem {
    if instance == null || !instance.ready || instance.plan == null { return .NotReady }
    if instance.running { return .Busy }
    program := instance.plan.program
    if call == null || function < 0 || function >= program.functions.count ||
        !program.functions[function].external || program.functions[function].calling != .Host ||
        ExecHostBinding(instance, function) >= 0 || !ExecPlatformWriteSignature(program, function) { return .Calling }
    if !VecPush(instance.hosts, LirExecHostBinding.{function = function, write = call, context = context}) {
        return .Allocation
    }
    return .None
}

LirExecProblemName :: (problem: LirExecProblem) -> string {
    if problem == .None { return "none" }
    if problem == .InvalidProgram { return "invalid-program" }
    if problem == .NotReady { return "not-ready" }
    if problem == .Busy { return "busy" }
    if problem == .Allocation { return "allocation" }
    if problem == .WorkLimit { return "work-limit" }
    if problem == .FuelLimit { return "fuel-limit" }
    if problem == .FrameLimit { return "frame-limit" }
    if problem == .ValueLimit { return "value-limit" }
    if problem == .AddressLimit { return "address-limit" }
    if problem == .ValueBytes { return "value-bytes" }
    if problem == .Type { return "type" }
    if problem == .Pointer { return "pointer" }
    if problem == .Calling { return "calling" }
    if problem == .DivideByZero { return "divide-by-zero" }
    if problem == .InvalidShift { return "invalid-shift" }
    if problem == .InvalidConversion { return "invalid-conversion" }
    if problem == .Trap { return "trap" }
    if problem == .Unreachable { return "unreachable" }
    if problem == .Host { return "host" }
    return "unsupported"
}
