using IR :: #import "compiler_lowered_ir"
using Verify :: #import "compiler_lowered_verify"
using Binary :: #import "std/binary"
using Math :: #import "std/math"
using Vectors :: #import "std/vec"
#import "std/option"

LirExecProblem :: enum s32 {
    None; InvalidProgram; NotReady; Busy; Allocation
    WorkLimit; FuelLimit; FrameLimit; ValueLimit; AddressLimit; ValueBytes
    Type; Pointer; Calling; DivideByZero; InvalidShift; InvalidConversion
    Trap; Unreachable; Unsupported; Host; Cancelled
}

LirExecLimits :: struct {
    work: s64
    fuel: s64
    frames: s64
    values: s64
    addresses: s64
    value_bytes: s64
}

LirExecValue :: struct { type: s32; bits: u64; bytes: s64 }
// Arguments and the result use the canonical bits of their LIR scalar types:
// zero-extended integers, 0/1 bools and IEEE float32/float64 patterns.
LirExecHostCall :: #type (context: *void, function: s32, arguments: []u64, result: *u64) -> bool;
// A host may change the elements of an argument bound as a mutable view
// (LirExecHostMutableView): it sets `changed` and puts the argument's new
// image in `bytes`, with the same element count. After the call the engine
// copies those elements back into the view's storage.
// Borrowed arguments carry raw read-only bytes for the synchronous callback.
LirExecArgument :: struct { type: s32; bits: u64; bytes: []u8; changed: bool; borrowed: bool }
LirExecTypedHostCall :: #type (context: *void, function: s32,
    arguments: []LirExecArgument, result: *LirExecArgument) -> bool;
// The platform byte-output service `(descriptor: u64, data: *u8, count: u64)`,
// such as ziran.platform.write_all. The engine resolves the checked data
// pointer and its extent itself; the embedder sees only the borrowed bytes,
// which stay valid for the duration of the call.
// A write callback reads bytes for the duration of the call.
LirExecPlatformWrite :: #type (context: *void, descriptor: u64, bytes: []u8) -> bool;
// Polled at execution checkpoints; true stops the run with .Cancelled.
LirExecCancelCheck :: #type (context: *void) -> bool;
LirExecHostBinding :: struct {
    function: s32
    call: LirExecHostCall
    typed: LirExecTypedHostCall
    write: LirExecPlatformWrite
    context: *void
    // Bit p: parameter p is a mutable view.
    views: u64
    // Bit p: parameter p borrows a top-level string or scalar slice.
    borrowed_views: u64
}

LirExecResult :: struct {
    problem: LirExecProblem
    verification: LirDiagnostic
    function: s32
    block: s32
    instruction: s32
    origin: s32
    trap: u64
    value: LirExecValue
    work_remaining: s64
    fuel_remaining: s64
}

LirExecFunctionPlan :: struct {
    value_base: s64
    block_base: s64
    frame_bytes: s64
    word_count: s64
    scratch_offset: s64
    scratch_bytes: s64
    // The constant words a new frame starts with (LirExecConstantWord).
    constants: s64
    constant_count: s64
}

// The run loop's compact code (ExecPlanCode). Each verified instruction the
// loop runs itself is translated once into one LirExecCode: a handler
// specialized by operation and width, with its operands' frame words and
// storage offsets resolved ahead. Constants, null, function addresses and
// fuel have no code: a new frame starts with their words written, and their
// work and fuel are charged with their segment's. A Slow instruction runs
// through ExecStep, the reference implementation.
LirExecHandler :: enum s32 {
    Slow; GlobalAddress
    Add; Subtract; Multiply; BitAnd; BitOr; BitXor
    DivideUnsigned; DivideSigned; RemainderUnsigned; RemainderSigned
    ShiftLeft; ShiftRightUnsigned; ShiftRightSigned
    Negate; BitNot; FloatNegate
    FloatAdd32; FloatSubtract32; FloatMultiply32; FloatDivide32
    FloatAdd64; FloatSubtract64; FloatMultiply64; FloatDivide64
    Equal; NotEqual; Less; LessEqual; Greater; GreaterEqual
    SignedLess; SignedLessEqual; SignedGreater; SignedGreaterEqual
    FloatCompare32; FloatCompare64
    ConvertInteger; ConvertBoolInteger; ConvertIntegerBool; ConvertIntegerFloat
    ConvertFloatFloat; ConvertFloatInteger; Bitcast
    ExtractWord; ExtractBytes; ExtractWordIndexed; ExtractBytesIndexed
    InsertWord; InsertBytes; InsertWordIndexed; InsertBytesIndexed
    Aggregate; Load; Store; FieldAddress; ElementIndex; ElementView
    Jump; Branch
    // A compare whose only use is the Branch right after it: one dispatch.
    BranchEqual; BranchNotEqual; BranchLess; BranchLessEqual; BranchGreater; BranchGreaterEqual
    BranchSignedLess; BranchSignedLessEqual; BranchSignedGreater; BranchSignedGreaterEqual
    // Calls and returns between frames of the program (ExecFastCall,
    // ExecFastReturn). Each ends its segment and charges its own work.
    Call; Return
    // An address derivation whose only use is the Load or Store right after
    // it: the two run as one, with no table entry for the address.
    LoadField; LoadIndex; LoadView; StoreField; StoreIndex; StoreView
    // Two Extracts of words in a row, and an Add before the block's Jump.
    ExtractWordPair; AddJump
    HostWrite
    // A generic host call whose arguments are frame words and whose result,
    // if any, is a scalar word: it runs in the fast loop like HostWrite.
    HostCall
    // A slice whose bounds hold: the ElementView of its element `low`, with
    // `b` low, `value` high and `c` the view's count; `sign_b`, `extra` and
    // `sign_c` are their sign bits.
    ElementSlice
    // Frame storage at the end of the frame's bytes, made by the run loop
    // (ExecFastAllocate) like a Call.
    Allocate
}

LirExecCode :: struct {
    handler: LirExecHandler
    // Load, Extract: 1 for a bool result. Address derivations: 1 for a
    // transient one. Integer conversions: 1 for a signed source or result.
    flag: s32
    // Frame words, relative to the frame's first word.
    result: s32
    a: s32
    b: s32
    c: s32
    // The type a pointer operand must name (Load, Store, derivations), or
    // a derivation's target type in `target`.
    type: s32
    target: s32
    // Where the instruction came from, for the reference path.
    block: s32
    index: s32
    // The edge plans of a terminator.
    edge: s32
    // A Call's result value, which the callee's frame fills.
    result_value: s32
    // A fused Store's value word, or -1 with the value's bytes at `w`.
    value: s32
    // 1 when a FieldAddress whose only use is this derivation's base runs
    // first, inside it: the type it checks, and the field's offset and size.
    prefix: s32
    prefix_type: s32
    // A derivation that makes a table entry: its slot in the instance's
    // derived_tokens, or -1.
    memo: s32
    prefix_offset: s64
    prefix_size: s64
    // Byte sizes, bit widths and frame storage offsets (relative to the
    // frame's storage), as each handler uses them.
    size: s64
    x: s64
    y: s64
    z: s64
    w: s64
    // The plan instruction that starts this instruction's block.
    base: s64
    // Result masks, sign bits of index operands and other constants.
    immediate: u64
    extra: u64
    sign_b: u64
    sign_c: u64
    // This instruction's own work, and the work and fuel from it to the end
    // of its segment, given back when the reference path takes over here.
    cost: s64
    rest_work: s64
    rest_fuel: s64
}

// One value an edge or an Aggregate copies: a frame word, or bytes of frame
// storage. `scratch` is where a two-phase edge parks it.
LirExecMove :: struct { word: bool; from: s64; to: s64; size: s64; scratch: s64 }

LirExecEdgePlan :: struct {
    moves: s64
    count: s64
    // The arguments cannot overwrite each other: copy them in order.
    direct: bool
    // Two copies of each argument, as ExecEdge charges them.
    work: s64
    target_block: s32
    target_base: s64
    // The code, work and fuel of the target block's first segment.
    target_code: s64
    target_work: s64
    target_fuel: s64
}

LirExecConstantWord :: struct { word: s64; bits: u64 }

ExecCodeChunkSize :: 512
LirExecCodeChunk :: struct { entries: Vec(LirExecCode) }

LirExecPlan :: struct {
    program: LirProgram
    #if #defined(ZIRAN_EXEC_PACKED_INSTRUCTIONS) {
        // If present, this borrows the hosted reader's packed allocation.
        packed_instructions: []LirExecPackedInstruction
    }
    type_sizes: Vec(s64)
    // Integer masks, zero for bool canonicalization, all ones otherwise.
    type_masks: Vec(u64)
    // A scalar's word index is nonnegative. An aggregate stores the bitwise
    // complement of its byte offset, so both location kinds can represent zero.
    value_locations: Vec(s64)
    narrow_value_locations: Vec(s32)
    // One byte per type, as LirHostShapes gives it.
    host_shapes: Vec(u8)
    functions: Vec(LirExecFunctionPlan)
    // Indexes into the allocated byte vectors edge_direct and transient.
    // The portable lowering uses fixed-width integers.
    #if #defined(ZIRAN_EXEC_NATIVE_PLAN_INDEXES) {
        block_edge_bases: Vec(usize)
        block_instruction_bases: Vec(usize)
    } else {
        block_edge_bases: Vec(s64)
        block_instruction_bases: Vec(s64)
    }
    edge_direct: Vec(u8)
    // Address lifetime chosen by ExecPlanTransients. Zero uses the canonical table.
    transient: Vec(u8)
    global_offsets: Vec(s64)
    global_bytes: s64
    code: Vec(LirExecCodeChunk)
    // How many codes have a `memo` slot.
    derived_count: s64
    moves: Vec(LirExecMove)
    edge_plans: Vec(LirExecEdgePlan)
    constant_words: Vec(LirExecConstantWord)
    // Per plan instruction: the code of the segment that starts there, or
    // -1 where none starts, and the work and fuel it charges on entry. A
    // segment is a block's run of instructions up to the next Slow one.
    segment_code: Vec(s64)
    segment_work: Vec(s64)
    segment_fuel: Vec(s64)
    // 2^k for k from -1074 to 1023, for float operands.
    powers: Vec(float64)
    compact: bool
    ready: bool
}

LirExecAddress :: struct {
    token: u64
    global: s32
    frame: s64
    generation: u64
    offset: s64
    extent: s64
    type: s32
    owned: bool
    writable: bool
    scoped: bool
    // One more than the heap block this address lies in; 0 for none.
    heap: s64
    // How many times this table slot has been given back and reused. It is
    // part of the token, so no older pointer to the slot is valid again.
    version: u64
    // One more than the next entry made for the same frame or heap block.
    next: s64
}

// A heap block is a range of the owned bytes. Resizing or freeing it ends
// its generation, so addresses derived from it stop being valid.
LirExecHeapBlock :: struct {
    offset: s64
    size: s64
    count: u64
    generation: u64
    live: bool
    // Adjacent ranges of owned bytes, numbered from 1. Empty allocations
    // have address identities but occupy no range in this chain.
    below: s64
    above: s64
    // Links for an interior hole. A record without storage uses next_free
    // for the separate list of reusable records.
    previous_free: s64
    next_free: s64
    // One more than the newest address entry made for this block.
    addresses: s64
    // Holds a value a host returned. The program never frees it; it lives
    // while something the program can reach names it (ExecHostCollect).
    host: bool
}

LirExecFrame :: struct {
    function: s32
    block: s32
    instruction: s32
    return_value: s32
    base: s64
    word_base: s64
    value_base: s64
    value_types: []s32
    instruction_base: s64
    generation: u64
    // One more than the newest address entry made for this frame's storage.
    addresses: s64
}

// The token a derivation code last made, and the operand words it made it
// from. The same words derive the same address, so while the token is
// still a live table entry it is the one the table lookup would find.
LirExecDerivedToken :: struct { base: u64; index: u64; count: u64; token: u64 }

LirExecGlobalData :: struct {
    bytes: Vec(u8)
    // A read-only byte-array initializer owned by the verified program.
    constant: []u8
}

LirExecInstance :: struct {
    plan: *LirExecPlan
    limits: LirExecLimits
    identity: u32
    globals: Vec(LirExecGlobalData)
    addresses: Vec(LirExecAddress)
    // Open-addressed index of `addresses` by the fields that make two
    // addresses the same one: each slot is zero, -1 for a removed entry, or
    // one more than an entry. `address_used` counts the nonzero slots.
    address_slots: Vec(s32)
    address_used: s64
    // Table slots given back by frames that returned and heap blocks that died.
    address_free: Vec(s64)
    // One per derivation code with a `memo` slot (ExecFastDerive).
    derived_tokens: Vec(LirExecDerivedToken)
    // The table entries transient derivations take in turn (ExecTransient):
    // ExecTransientSlots of them from transient_base, never indexed.
    transient_base: s64
    transient_count: s64
    transient_next: s64
    storage: Vec(u8)
    words: Vec(u64)
    frames: Vec(LirExecFrame)
    result_bytes: Vec(u8)
    result_value: LirExecValue
    hosts: Vec(LirExecHostBinding)
    // Per program function: one more than its binding's index, or 0 while
    // not yet looked up (ExecFastHostBinding). Bindings never change once made.
    host_lookup: Vec(s32)
    // Every external function has a binding. Bindings are only ever added,
    // so once a run has found them all they stay complete.
    hosts_bound: bool
    host_arguments: Vec(u64)
    typed_arguments: Vec(LirExecArgument)
    host_bytes: Vec(u8)
    owned: Vec(u8)
    heap_blocks: Vec(LirExecHeapBlock)
    // One more than the block that ends the owned bytes; 0 for none.
    heap_tail: s64
    // One more than the first interior hole, or 0.
    heap_free: s64
    // One more than the first reusable record without storage, or 0.
    heap_spare: s64
    heap_epoch: u64
    // Bytes of host blocks made since the last collection, and the bytes
    // that collection scanned: the next one waits until both are passed.
    host_since: s64
    host_scanned: s64
    live_values: s64
    frame_epoch: u64
    current_value_base: s64
    // Type IDs belong to the verified function and live as long as the plan.
    current_value_types: []s32
    current_word_base: s64
    work_remaining: s64
    fuel_remaining: s64
    failure: LirExecResult
    initializer_failure: LirExecResult
    initialized: bool
    initializer_failed: bool
    ready: bool
    running: bool
    cancel_check: LirExecCancelCheck
    cancel_context: *void
    // Run every instruction through ExecStep (LirExecRunReference).
    reference: bool
}

// Optional host-side execution within a verified packed block. The callback
// leaves the frame at its first unfinished instruction. It returns the next
// instruction to try in the block, or -1 to wait for a new block entry.
#if #defined(ZIRAN_EXEC_PACKED_INSTRUCTIONS) {
    LirExecPackedBlockRun :: #type (context: *void, instance: *LirExecInstance, frame: *LirExecFrame) -> s32 #c_call;
    LirExecPackedBlocks :: struct { run: LirExecPackedBlockRun; context: *void }
}

#scope_file

ExecNoDiagnostic :: () -> LirDiagnostic {
    return .{.problem = .None, .function = LirNoId, .block = LirNoId,
        .instruction = LirNoId, .value = LirNoId, .origin = LirNoId}
}

ExecResult :: (problem: LirExecProblem) -> LirExecResult {
    return .{.problem = problem, .verification = ExecNoDiagnostic(),
        .function = LirNoId, .block = LirNoId, .instruction = LirNoId,
        .origin = LirNoId}
}

ExecMask :: (bits: s32) -> u64 {
    if bits == 64 { return ~cast(u64)0 }
    return (cast(u64)1 << cast(u64)bits) - cast(u64)1
}

ExecSigned :: (value: u64, bits: s32) -> s64 {
    value &= ExecMask(bits)
    if bits < 64 && (value & (cast(u64)1 << cast(u64)(bits - 1))) != 0 {
        value |= ~ExecMask(bits)
    }
    return cast(s64)value
}

ExecReadBits :: (bytes: []u8, at: s64, count: s64) -> u64 {
    result: u64
    for index: cast(s64)0..count - 1 {
        result |= cast(u64)bytes[at + index] << cast(u64)(index * 8)
    }
    return result
}

ExecWriteBits :: (bytes: []u8, at: s64, count: s64, value: u64) {
    for index: cast(s64)0..count - 1 {
        bytes[at + index] = cast(u8)(value >> cast(u64)(index * 8))
    }
}

// A finite positive value as `value` in [1, 2) times 2^exponent, in exact
// steps by powers of two.
ExecNormalize :: (input: float64, exponent: *s32) -> float64 #inline {
    value := input
    power: s32
    step: float64 = 18446744073709551616.0
    back: float64 = 5.42101086242752217003726400434970855712890625e-20
    while value >= step { value *= back; power += 64 }
    while value < 1.0 { value *= step; power -= 64 }
    if value >= 4294967296.0 { value *= 2.3283064365386962890625e-10; power += 32 }
    if value >= 65536.0 { value *= 0.0000152587890625; power += 16 }
    if value >= 256.0 { value *= 0.00390625; power += 8 }
    if value >= 16.0 { value *= 0.0625; power += 4 }
    if value >= 4.0 { value *= 0.25; power += 2 }
    if value >= 2.0 { value *= 0.5; power += 1 }
    <<exponent = power
    return value
}

ExecFloat64Bits :: (input: float64) -> u64 {
    negative := input < 0.0 || input == 0.0 && 1.0 / input < 0.0
    value := ifx negative then 0.0 - input else input
    sign := ifx negative then cast(u64)1 << cast(u64)63 else cast(u64)0
    if value != value { return sign | cast(u64)0x7ff8000000000000 }
    if value == 0.0 { return sign }
    if !Finite64(value) { return sign | cast(u64)0x7ff0000000000000 }
    exponent: s32
    value = ExecNormalize(value, *exponent)
    if exponent >= -1022 {
        fraction := cast(u64)((value - 1.0) * 4503599627370496.0)
        return sign | (cast(u64)(exponent + 1023) << cast(u64)52) | fraction
    }
    fraction := cast(u64)ScaleByPowerOfTwo(value, exponent + 1074)
    return sign | fraction
}

ExecFloat32Bits :: (input: float32) -> u64 {
    original := cast(float64)input
    negative := original < 0.0 || original == 0.0 && 1.0 / original < 0.0
    value := ifx negative then 0.0 - original else original
    sign := ifx negative then cast(u64)1 << cast(u64)31 else cast(u64)0
    if value != value { return sign | cast(u64)0x7fc00000 }
    if value == 0.0 { return sign }
    if !Finite64(value) { return sign | cast(u64)0x7f800000 }
    exponent: s32
    value = ExecNormalize(value, *exponent)
    if exponent >= -126 {
        fraction := cast(u64)((value - 1.0) * 8388608.0)
        return sign | (cast(u64)(exponent + 127) << cast(u64)23) | fraction
    }
    fraction := cast(u64)ScaleByPowerOfTwo(value, exponent + 149)
    return sign | fraction
}

// The value of IEEE bits, exactly as Float32FromBits and Float64FromBits
// give it, scaled by the plan's table of powers of two instead of loops.
ExecBitsFloat :: (plan: *LirExecPlan, input: u64, single: bool) -> float64 #inline {
    exponent: s64
    mantissa: u64
    negative: bool
    value: float64
    if single {
        bits := input & cast(u64)4294967295
        exponent = cast(s64)((bits >> cast(u64)23) & cast(u64)255)
        mantissa = bits & cast(u64)8388607
        negative = (bits & cast(u64)2147483648) != cast(u64)0
        if exponent == 255 {
            value = ifx mantissa == 0 then Infinity() else NotANumber()
        } else if exponent == 0 {
            value = cast(float64)mantissa * plan.powers[925]
        } else {
            value = cast(float64)(mantissa + cast(u64)8388608) * plan.powers[exponent + 924]
        }
    } else {
        exponent = cast(s64)((input >> cast(u64)52) & cast(u64)2047)
        mantissa = input & cast(u64)4503599627370495
        negative = (input >> cast(u64)63) != cast(u64)0
        if exponent == 2047 {
            value = ifx mantissa == 0 then Infinity() else NotANumber()
        } else if exponent == 0 {
            value = cast(float64)mantissa * plan.powers[0]
        } else {
            value = cast(float64)(mantissa + cast(u64)4503599627370496) * plan.powers[exponent - 1]
        }
    }
    if negative { return -value }
    return value
}

ExecFloat :: (plan: *LirExecPlan, type: LirType, bits: u64) -> float64 #inline {
    return ExecBitsFloat(plan, bits, type.bits == 32)
}

ExecTypeChildren :: (type: LirType) -> s64 {
    if type.kind == .Record { return type.fields.count }
    if type.kind == .Array { return 1 }
    return 0
}

ExecTypeChild :: (type: LirType, index: s64) -> s32 {
    if type.kind == .Record { return type.fields[index] }
    return type.element
}

ExecPlanLayouts :: (program: LirProgram, plan: *LirExecPlan, maximum: s64) -> LirExecProblem {
    colors: Vec(u8)
    stack: Vec(s32)
    next: Vec(s64)
    count := program.types.count
    if !VecResizeBounded(plan.type_sizes, count, count) ||
        !VecResizeBounded(plan.type_masks, count, count) ||
        !VecResizeBounded(colors, count, count) || !VecResizeBounded(stack, count, count) ||
        !VecResizeBounded(next, count, count) { return .Allocation }
    if count == 0 { return .None }
    for index: cast(s64)0..count - 1 {
        type := program.types[index]
        plan.type_sizes[index] = -1
        if type.kind == .Integer { plan.type_masks[index] = ExecMask(type.bits) }
        else if type.kind != .Bool { plan.type_masks[index] = ~cast(u64)0 }
    }
    for root: cast(s32)0..cast(s32)count - 1 {
        if colors[root] == 2 { continue }
        depth: s64
        stack[0] = root
        while depth >= 0 {
            id := stack[depth]
            type := program.types[id]
            colors[id] = 1
            children := ExecTypeChildren(type)
            if next[id] < children {
                child := ExecTypeChild(type, next[id])
                next[id] += 1
                if colors[child] == 1 { return .InvalidProgram }
                if colors[child] == 0 { depth += 1; stack[depth] = child }
                continue
            }
            size: s64
            if type.kind == .Bool { size = 1 }
            else if type.kind == .Integer || type.kind == .Float { size = type.bits / 8 }
            else if type.kind == .Pointer || type.kind == .Function { size = 8 }
            else if type.kind == .Array {
                child := plan.type_sizes[type.element]
                if type.count != 0 && child > maximum / type.count { return .ValueBytes }
                size = child * type.count
            } else if type.kind == .Record {
                for field: type.fields {
                    field_size := plan.type_sizes[field]
                    if field_size > maximum - size { return .ValueBytes }
                    size += field_size
                }
            }
            if size < 0 || size > maximum { return .ValueBytes }
            plan.type_sizes[id] = size
            colors[id] = 2
            depth -= 1
        }
    }
    return .None
}

ExecValueLocation :: (plan: *LirExecPlan, index: s64) -> s64 #inline {
    if plan.narrow_value_locations.count != 0 { return cast(s64)plan.narrow_value_locations[index] }
    return plan.value_locations[index]
}

ExecLocationWord :: (location: s64) -> s64 #inline {
    return ifx location >= 0 then location else -1
}

ExecLocationOffset :: (location: s64) -> s64 #inline {
    return ifx location < 0 then ~location else -1
}

ExecPlanValuesOverlap :: (plan: *LirExecPlan, base: s64, types: []s32, left: s32, right: s32) -> bool {
    left_location := ExecValueLocation(plan, base + left)
    right_location := ExecValueLocation(plan, base + right)
    if (left_location >= 0) != (right_location >= 0) { return false }
    if left_location >= 0 { return left_location == right_location }
    left_at := ~left_location
    right_at := ~right_location
    left_size := plan.type_sizes[types[left]]
    right_size := plan.type_sizes[types[right]]
    return left_at < right_at + right_size && right_at < left_at + left_size
}

ExecPlanValuesSameLocation :: (plan: *LirExecPlan, base: s64, types: []s32,
    left: s32, right: s32) -> bool {
    left_location := ExecValueLocation(plan, base + left)
    if left_location != ExecValueLocation(plan, base + right) { return false }
    return left_location >= 0 || plan.type_sizes[types[left]] == plan.type_sizes[types[right]]
}

// Edge locations are immutable after plan construction. Prove direct-copy
// safety once instead of repeating this quadratic overlap check on every loop
// back-edge. Cycles and destructive aliases retain the scratch path.
ExecPlanEdgeDirectSafe :: (plan: *LirExecPlan, base: s64, types: []s32,
    edge: LirEdge, target: LirBlock) -> bool {
    if edge.arguments.count != target.parameters.count { return false }
    for destination_index: cast(s64)0..target.parameters.count - 1 {
        destination := target.parameters[destination_index]
        for source_index: cast(s64)0..edge.arguments.count - 1 {
            source := edge.arguments[source_index]
            if !ExecPlanValuesOverlap(plan, base, types, destination, source) { continue }
            if destination_index == source_index &&
                ExecPlanValuesSameLocation(plan, base, types, destination, source) { continue }
            return false
        }
    }
    return true
}

// Coalesce Inserts and edge arguments first to avoid copies. A large member
// can take over a dead aggregate's slot. Other large values of the same type
// reuse slots when their live ranges do not overlap. Work charges stay fixed.
// Liveness is exact over the function's blocks. A function with more
// composite values than ExecCoalesceLimit keeps the local rules alone.
ExecCoalesceLimit :: 4096
ExecLargeSlotBytes :: 4096

ExecPlanCoalesce :: (program: LirProgram, function: LirFunction, type_sizes: []s64,
    aliases: *Vec(s32), slot_sizes: *Vec(s64)) -> bool {
    count := function.values.count
    index: Vec(s64)
    values: Vec(s32)
    defer VecFree(index)
    defer VecFree(values)
    if !VecResize(index, count) { return false }
    for value: cast(s64)0..count - 1 {
        index[value] = -1
        kind := program.types[function.values[value]].kind
        if kind == .Record || kind == .Array {
            index[value] = values.count
            if !VecPush(values, cast(s32)value) { return false }
        }
    }
    total := values.count
    if total == 0 || total > ExecCoalesceLimit { return true }
    words := (total + 63) / 64
    blocks := function.blocks.count
    live_in: Vec(u64)
    live_out: Vec(u64)
    live: Vec(u64)
    conflicts: Vec(u64)
    members: Vec(u64)
    parent: Vec(s64)
    defer VecFree(live_in)
    defer VecFree(live_out)
    defer VecFree(live)
    defer VecFree(conflicts)
    defer VecFree(members)
    defer VecFree(parent)
    if !VecResize(live_in, blocks * words) || !VecResize(live_out, blocks * words) || !VecResize(live, words) ||
        !VecResize(conflicts, total * words) || !VecResize(members, total * words) || !VecResize(parent, total) {
        return false
    }
    // Live sets at block entry and exit, to a fixed point.
    changed := true
    while changed {
        changed = false
        block_at := blocks - 1
        while block_at >= 0 {
            block := function.blocks[block_at]
            out := block_at * words
            for instruction: block.instructions {
                for edge: instruction.edges {
                    successor := cast(s64)edge.block * words
                    for word: 0..words - 1 { live_out[out + word] |= live_in[successor + word] }
                }
            }
            for word: 0..words - 1 { live[word] = live_out[out + word] }
            ExecLiveBlock(block, index[:], live[:], conflicts[:], words, false)
            for word: 0..words - 1 {
                if live_in[out + word] != live[word] { live_in[out + word] = live[word]; changed = true }
            }
            block_at -= 1
        }
    }
    // Which composite values are live where each one is defined.
    for block_at: cast(s64)0..blocks - 1 {
        for word: 0..words - 1 { live[word] = live_out[block_at * words + word] }
        ExecLiveBlock(function.blocks[block_at], index[:], live[:], conflicts[:], words, true)
    }
    for at: cast(s64)0..total - 1 {
        parent[at] = at
        members[at * words + at / 64] |= cast(u64)1 << cast(u64)(at % 64)
    }
    // In-place Inserts first, then edges.
    for pass: 0..1 {
        for block: function.blocks {
            for instruction: block.instructions {
                if pass == 0 && instruction.op == .Insert && instruction.result != LirNoId &&
                    instruction.operands.count >= 2 {
                    ExecCoalescePair(function, index[:], parent[:], conflicts[:], members[:], words,
                        instruction.result, instruction.operands[0])
                }
                if pass == 1 {
                    for edge: instruction.edges {
                        target := function.blocks[edge.block]
                        for at: cast(s64)0..edge.arguments.count - 1 {
                            if at >= target.parameters.count { break }
                            ExecCoalescePair(function, index[:], parent[:], conflicts[:], members[:],
                                words, target.parameters[at], edge.arguments[at])
                        }
                    }
                }
            }
        }
    }
    shared_projection := false
    for block: function.blocks {
        for instruction: block.instructions {
            if instruction.op != .Extract || index[instruction.result] < 0 ||
                type_sizes[function.values[instruction.result]] < ExecLargeSlotBytes { continue }
            // Extract copies from a member at or above the slot base to the
            // base, so an overlapping copy is safe when the input is dead.
            source := index[instruction.operands[0]]
            destination := index[instruction.result]
            if ExecCoalesceGroups(parent[:], conflicts[:], members[:], words, source, destination) {
                shared_projection = true
            }
        }
    }
    for at: cast(s64)0..total - 1 {
        if parent[at] != at || type_sizes[function.values[values[at]]] < ExecLargeSlotBytes { continue }
        for slot: cast(s64)0..at - 1 {
            if parent[slot] != slot { continue }
            ExecCoalescePair(function, index[:], parent[:], conflicts[:], members[:], words,
                values[at], values[slot])
            if parent[at] != at { break }
        }
    }
    if shared_projection && !VecResizeBounded(<<slot_sizes, count, count) { return false }
    for at: cast(s64)0..total - 1 {
        root := ExecCoalesceRoot(parent[:], at)
        (<<aliases)[values[at]] = ifx root == at then LirNoId else values[root]
        if shared_projection {
            size := type_sizes[function.values[values[at]]]
            if size > (<<slot_sizes)[values[root]] { (<<slot_sizes)[values[root]] = size }
        }
    }
    return true
}

// Walks a block backward from the live set at its end to the one at its
// start. With `record`, every composite value a block defines conflicts
// with each composite value live just after its definition.
ExecLiveBlock :: (block: LirBlock, index: []s64, live: []u64, conflicts: []u64, words: s64, record: bool) {
    at := block.instructions.count - 1
    while at >= 0 {
        instruction := block.instructions[at]
        for edge: instruction.edges {
            for argument: edge.arguments { ExecLiveSet(live, index[argument], true) }
        }
        if instruction.result != LirNoId && index[instruction.result] >= 0 {
            defined := index[instruction.result]
            ExecLiveSet(live, defined, false)
            if record {
                ExecLiveConflicts(live, conflicts, words, defined)
                // An instruction may write its result before it has read all
                // operands. Insert and Extract support reusing their first one.
                for operand, position: instruction.operands {
                    source := index[operand]
                    if source >= 0 && !(position == 0 && (instruction.op == .Insert || instruction.op == .Extract)) {
                        ExecConflict(conflicts, words, defined, source)
                    }
                }
            }
        }
        for operand: instruction.operands { ExecLiveSet(live, index[operand], true) }
        at -= 1
    }
    for parameter: block.parameters {
        if index[parameter] < 0 { continue }
        ExecLiveSet(live, index[parameter], false)
        if record { ExecLiveConflicts(live, conflicts, words, index[parameter]) }
    }
    // Parameters are defined together: each conflicts with the others.
    if record {
        for left: block.parameters {
            if index[left] < 0 { continue }
            for right: block.parameters {
                if index[right] >= 0 && right != left { ExecConflict(conflicts, words, index[left], index[right]) }
            }
        }
    }
}

ExecLiveSet :: (live: []u64, value: s64, on: bool) #inline {
    if value < 0 { return }
    bit := cast(u64)1 << cast(u64)(value % 64)
    if on { live[value / 64] |= bit } else { live[value / 64] &= ~bit }
}

ExecConflict :: (conflicts: []u64, words: s64, left: s64, right: s64) #inline {
    conflicts[left * words + right / 64] |= cast(u64)1 << cast(u64)(right % 64)
    conflicts[right * words + left / 64] |= cast(u64)1 << cast(u64)(left % 64)
}

ExecLiveConflicts :: (live: []u64, conflicts: []u64, words: s64, defined: s64) {
    for word: cast(s64)0..words - 1 {
        bits := live[word]
        while bits != 0 {
            low := bits & (cast(u64)0 - bits)
            bit: s64
            probe := low
            while probe > 1 { probe >>= cast(u64)1; bit += 1 }
            other := word * 64 + bit
            if other != defined { ExecConflict(conflicts, words, defined, other) }
            bits ^= low
        }
    }
}

ExecCoalesceRoot :: (parent: []s64, at: s64) -> s64 {
    root := at
    while parent[root] != root { root = parent[root] }
    step := at
    while parent[step] != root {
        next := parent[step]
        parent[step] = root
        step = next
    }
    return root
}

// Puts two values of one type in one slot unless their groups conflict.
// A group's root is its lowest-numbered value, which is laid out first.
ExecCoalescePair :: (function: LirFunction, index: []s64, parent: []s64,
    conflicts: []u64, members: []u64, words: s64, left: s32, right: s32) {
    if left == LirNoId || right == LirNoId || index[left] < 0 || index[right] < 0 ||
        function.values[left] != function.values[right] { return }
    unused ExecCoalesceGroups(parent, conflicts, members, words, index[left], index[right])
}

ExecCoalesceGroups :: (parent: []s64, conflicts: []u64, members: []u64, words: s64, left: s64, right: s64) -> bool {
    a := ExecCoalesceRoot(parent, left)
    b := ExecCoalesceRoot(parent, right)
    if a == b { return false }
    for word: cast(s64)0..words - 1 {
        if (conflicts[a * words + word] & members[b * words + word]) != 0 { return false }
    }
    root := ifx a < b then a else b
    other := ifx root == a then b else a
    for word: cast(s64)0..words - 1 {
        conflicts[root * words + word] |= conflicts[other * words + word]
        members[root * words + word] |= members[other * words + word]
    }
    parent[other] = root
    return true
}

ExecPlanFunctions :: (program: LirProgram, plan: *LirExecPlan, maximum: s64,
    compact: bool, bodies: LirFunctionBodies) -> LirExecProblem {
    values: s64
    blocks: s64
    edges: s64
    instructions: s64
    for function_index: cast(s64)0..program.functions.count - 1 {
        function := program.functions[function_index]
        if !LirReadFunctionBody(bodies, cast(s32)function_index, *function) { return .Allocation }
        if function.values.count > 9223372036854775807 - values { return .ValueLimit }
        values += function.values.count
        if function.blocks.count > 9223372036854775807 - blocks { return .ValueLimit }
        blocks += function.blocks.count
        for block: function.blocks {
            if block.instructions.count > 9223372036854775807 - instructions {
                return .ValueLimit
            }
            instructions += block.instructions.count
            for instruction: block.instructions {
                if instruction.edges.count > 9223372036854775807 - edges { return .ValueLimit }
                edges += instruction.edges.count
            }
        }
    }
    // Each word index is below the value count. Each byte offset is bounded
    // by maximum, so its bitwise complement fits in the signed 32-bit range.
    narrow := compact && values <= 2147483647 && maximum <= 2147483647
    if narrow {
        if !VecResizeBounded(plan.narrow_value_locations, values, values) { return .Allocation }
    } else if !VecResizeBounded(plan.value_locations, values, values) { return .Allocation }
    if !VecResizeBounded(plan.functions, program.functions.count, program.functions.count) ||
        !VecResizeBounded(plan.block_edge_bases, blocks, blocks) ||
        !VecResizeBounded(plan.block_instruction_bases, blocks, blocks) ||
        !VecResizeBounded(plan.edge_direct, edges, edges) ||
        !VecResizeBounded(plan.transient, instructions, instructions) ||
        !VecResizeBounded(plan.global_offsets, program.globals.count, program.globals.count) { return .Allocation }
    // The successful byte-vector allocations above bound both sets of
    // offsets by the native allocation size, including on 32-bit hosts.
    value_at: s64
    block_at: s64
    edge_at: s64
    instruction_at: s64
    for function_index: cast(s64)0..program.functions.count - 1 {
        function := program.functions[function_index]
        if !LirReadFunctionBody(bodies, cast(s32)function_index, *function) { return .Allocation }
        uses: Vec(s64)
        aliases: Vec(s32)
        predecessors: Vec(s64)
        defer VecFree(uses)
        defer VecFree(aliases)
        defer VecFree(predecessors)
        if !VecResizeBounded(uses, function.values.count, function.values.count) ||
            !VecResizeBounded(aliases, function.values.count, function.values.count) ||
            !VecResizeBounded(predecessors, function.blocks.count, function.blocks.count) {
            return .Allocation
        }
        for value_index: cast(s64)0..function.values.count - 1 { aliases[value_index] = LirNoId }
        for block: function.blocks {
            for instruction: block.instructions {
                for operand: instruction.operands { uses[operand] += 1 }
                for edge: instruction.edges {
                    predecessors[edge.block] += 1
                    for argument: edge.arguments { uses[argument] += 1 }
                }
            }
        }
        // A dead Extract still executes (and therefore retains its trap
        // behavior), but the bytes it reads cannot keep a prior aggregate
        // version live. Discount only that content use for slot coalescing.
        for block: function.blocks {
            for instruction: block.instructions {
                if instruction.op == .Extract && instruction.result != LirNoId &&
                    uses[instruction.result] == 0 && instruction.operands.count != 0 {
                    uses[instruction.operands[0]] -= 1
                }
            }
        }
        // A parameter of a single-predecessor block may share its incoming
        // value's slot. The edge is the incoming value's last dynamic use;
        // require a unique occurrence on that edge so two live parameters can
        // never observe an Insert updating their shared aggregate bytes.
        for block: function.blocks {
            for instruction: block.instructions {
                for edge: instruction.edges {
                    if predecessors[edge.block] != 1 { continue }
                    target := function.blocks[edge.block]
                    for index: cast(s64)0..target.parameters.count - 1 {
                        source := edge.arguments[index]
                        destination := target.parameters[index]
                        if source >= destination ||
                            function.values[source] != function.values[destination] { continue }
                        source_root := source
                        while aliases[source_root] != LirNoId { source_root = aliases[source_root] }
                        unique := true
                        for other: cast(s64)0..edge.arguments.count - 1 {
                            other_root := edge.arguments[other]
                            while aliases[other_root] != LirNoId { other_root = aliases[other_root] }
                            if other != index && other_root == source_root { unique = false; break }
                        }
                        if unique { aliases[destination] = source_root }
                    }
                }
            }
        }
        // Join parameters may coalesce too when every predecessor already
        // carries the same proven location (for example, both arms of a branch
        // forwarding an unchanged array). Different incoming roots stay apart.
        for target_index: cast(s64)0..function.blocks.count - 1 {
            if predecessors[target_index] <= 1 { continue }
            target := function.blocks[target_index]
            for parameter_index: cast(s64)0..target.parameters.count - 1 {
                candidate: s32 = LirNoId
                consistent := true
                for source_block: function.blocks {
                    for instruction: source_block.instructions {
                        for edge: instruction.edges {
                            if edge.block != target_index { continue }
                            source := edge.arguments[parameter_index]
                            root := source
                            while aliases[root] != LirNoId { root = aliases[root] }
                            for other: cast(s64)0..edge.arguments.count - 1 {
                                other_root := edge.arguments[other]
                                while aliases[other_root] != LirNoId { other_root = aliases[other_root] }
                                if other != parameter_index && other_root == root {
                                    consistent = false; break
                                }
                            }
                            if !consistent { break }
                            if candidate == LirNoId { candidate = root }
                            else if candidate != root { consistent = false; break }
                        }
                        if !consistent { break }
                    }
                    if !consistent { break }
                }
                destination := target.parameters[parameter_index]
                if consistent && candidate != LirNoId && candidate < destination &&
                    function.values[candidate] == function.values[destination] {
                    aliases[destination] = candidate
                }
            }
        }
        for block: function.blocks {
            for instruction: block.instructions {
                if instruction.op != .Insert || instruction.result == LirNoId ||
                    instruction.operands.count < 2 { continue }
                source := instruction.operands[0]
                if source < instruction.result && uses[source] == 1 &&
                    function.values[source] == function.values[instruction.result] {
                    aliases[instruction.result] = source
                }
            }
        }
        slot_sizes: Vec(s64)
        defer VecFree(slot_sizes)
        if !ExecPlanCoalesce(program, function, plan.type_sizes[:], *aliases, *slot_sizes) { return .Allocation }
        base := value_at
        offset: s64
        words: s64
        for value_index: cast(s64)0..function.values.count - 1 {
            value := function.values[value_index]
            type := program.types[value]
            scalar := type.kind == .Bool || type.kind == .Integer || type.kind == .Float ||
                type.kind == .Pointer || type.kind == .Function
            alias := aliases[value_index]
            location: s64
            if alias != LirNoId {
                location = ExecValueLocation(plan, base + alias)
            } else if scalar {
                location = words
                words += 1
            } else {
                location = ~offset
                size := ifx slot_sizes.count == 0 then plan.type_sizes[value] else slot_sizes[value_index]
                if size > maximum - offset { return .ValueBytes }
                offset += size
            }
            if narrow { plan.narrow_value_locations[value_at] = cast(s32)location }
            else { plan.value_locations[value_at] = location }
            value_at += 1
        }
        scratch: s64
        for block: function.blocks {
            size: s64
            for parameter: block.parameters {
                part := plan.type_sizes[function.values[parameter]]
                if part > maximum - size { return .ValueBytes }
                size += part
            }
            if size > scratch { scratch = size }
        }
        if scratch > maximum - offset { return .ValueBytes }
        if words > (maximum - offset - scratch) / 8 { return .ValueBytes }
        function_base := value_at - function.values.count
        plan.functions[function_index] = .{.value_base = function_base, .block_base = block_at,
            .frame_bytes = offset + scratch, .word_count = words,
            .scratch_offset = offset, .scratch_bytes = scratch}
        function_block_base := block_at
        for block: function.blocks {
            #if #defined(ZIRAN_EXEC_NATIVE_PLAN_INDEXES) {
                plan.block_edge_bases[block_at] = cast(usize)edge_at
                plan.block_instruction_bases[block_at] = cast(usize)instruction_at
            } else {
                plan.block_edge_bases[block_at] = edge_at
                plan.block_instruction_bases[block_at] = instruction_at
            }
            for instruction: block.instructions {
                for edge: instruction.edges {
                    target := function.blocks[edge.block]
                    plan.edge_direct[edge_at] = cast(u8)ExecPlanEdgeDirectSafe(
                        plan, function_base, function.values, edge, target)
                    edge_at += 1
                }
            }
            instruction_at += block.instructions.count
            block_at += 1
        }
        if !ExecPlanTransients(plan, function, function_block_base) { return .Allocation }
    }
    offset: s64
    for global_index: cast(s64)0..program.globals.count - 1 {
        plan.global_offsets[global_index] = offset
        size := plan.type_sizes[program.globals[global_index].type]
        if size > maximum - offset { return .ValueBytes }
        offset += size
    }
    plan.global_bytes = offset
    return .None
}

// ---- Compact code --------------------------------------------------------

ExecPlanCodeKind :: enum s32 {
    // Runs through ExecStep; it ends the segment before it.
    Slow
    // Has a LirExecCode the run loop executes.
    Fast
    // A word that holds one value from the frame's start (constant words).
    Constant
    // Charged with its segment but runs no code: fuel, and a compare that
    // the Branch after it carries out.
    Folded
}

ExecPlanWord :: (plan: *LirExecPlan, base: s64, value: s32) -> s32 {
    return cast(s32)ExecLocationWord(ExecValueLocation(plan, base + value))
}

ExecPlanMask :: (plan: *LirExecPlan, type: s32) -> u64 #inline {
    mask := plan.type_masks[type]
    return ifx mask == 0 then ~cast(u64)0 else mask
}

ExecCanonicalWord :: (mask: u64, bits: u64) -> u64 #inline {
    return ifx mask == 0 then cast(u64)(bits != 0) else (bits & mask)
}

// The sign bit an index operand must not have (ExecIndexBits), or 0.
// k when `size` is 2^k, else -1.
ExecPlanShift :: (size: s64) -> s64 {
    if size <= 0 { return -1 }
    shift: u64 = 0
    while shift < 62 && (cast(u64)1 << shift) < cast(u64)size { shift += 1 }
    if (cast(u64)1 << shift) == cast(u64)size { return cast(s64)shift }
    return -1
}

ExecPlanSign :: (type: LirType) -> u64 {
    if type.kind != .Integer || !type.is_signed { return 0 }
    return cast(u64)1 << cast(u64)(type.bits - 1)
}

// ExecMember at plan time: the member's offset and the work ExecMember
// charges for it.
ExecPlanMember :: (program: LirProgram, plan: *LirExecPlan, type_id: s32, member: u64,
    offset: *s64, cost: *s64) -> bool {
    type := program.types[type_id]
    if type.kind == .Array {
        if member >= cast(u64)type.count { return false }
        <<offset = cast(s64)member * plan.type_sizes[type.element]
        <<cost = 0
        return true
    }
    if type.kind != .Record || member >= cast(u64)type.fields.count { return false }
    result: s64
    for index: cast(s64)0..cast(s64)member - 1 { result += plan.type_sizes[type.fields[index]] }
    <<offset = result
    <<cost = cast(s64)member
    return true
}

ExecPlanBinary :: (op: LirOp, type: LirType) -> LirExecHandler {
    if type.kind == .Float {
        if type.bits == 32 {
            if op == .Add { return .FloatAdd32 }
            if op == .Subtract { return .FloatSubtract32 }
            if op == .Multiply { return .FloatMultiply32 }
            if op == .Divide { return .FloatDivide32 }
        } else if type.bits == 64 {
            if op == .Add { return .FloatAdd64 }
            if op == .Subtract { return .FloatSubtract64 }
            if op == .Multiply { return .FloatMultiply64 }
            if op == .Divide { return .FloatDivide64 }
        }
        return .Slow
    }
    if type.kind != .Integer { return .Slow }
    if op == .Add { return .Add }
    if op == .Subtract { return .Subtract }
    if op == .Multiply { return .Multiply }
    if op == .BitAnd { return .BitAnd }
    if op == .BitOr { return .BitOr }
    if op == .BitXor { return .BitXor }
    if op == .Divide { return ifx type.is_signed then .DivideSigned else .DivideUnsigned }
    if op == .Remainder { return ifx type.is_signed then .RemainderSigned else .RemainderUnsigned }
    if op == .ShiftLeft { return .ShiftLeft }
    if op == .ShiftRight { return ifx type.is_signed then .ShiftRightSigned else .ShiftRightUnsigned }
    return .Slow
}

ExecPlanCompare :: (op: LirOp, type: LirType) -> LirExecHandler {
    if type.kind == .Float { return ifx type.bits == 32 then .FloatCompare32 else .FloatCompare64 }
    if op == .Equal { return .Equal }
    if op == .NotEqual { return .NotEqual }
    if type.kind == .Integer && type.is_signed {
        if op == .Less { return .SignedLess }
        if op == .LessEqual { return .SignedLessEqual }
        if op == .Greater { return .SignedGreater }
        return .SignedGreaterEqual
    }
    if op == .Less { return .Less }
    if op == .LessEqual { return .LessEqual }
    if op == .Greater { return .Greater }
    return .GreaterEqual
}

// A handler that derives an address from operand 0, alone or with its use.
ExecPlanDerivation :: (handler: LirExecHandler) -> bool {
    return handler == .FieldAddress || handler == .ElementIndex || handler == .ElementView ||
        handler == .LoadField || handler == .LoadIndex || handler == .LoadView ||
        handler == .StoreField || handler == .StoreIndex || handler == .StoreView
}

// The handler of a derivation and the Load or Store after it, or Slow.
ExecPlanFusedMemory :: (derivation: LirExecHandler, memory: LirExecHandler) -> LirExecHandler {
    if memory == .Load {
        if derivation == .FieldAddress { return .LoadField }
        if derivation == .ElementIndex { return .LoadIndex }
        if derivation == .ElementView { return .LoadView }
    } else if memory == .Store {
        if derivation == .FieldAddress { return .StoreField }
        if derivation == .ElementIndex { return .StoreIndex }
        if derivation == .ElementView { return .StoreView }
    }
    return .Slow
}

// The Branch handler that also does compare `handler`, or Slow.
ExecPlanFused :: (handler: LirExecHandler) -> LirExecHandler {
    if handler == .Equal { return .BranchEqual }
    if handler == .NotEqual { return .BranchNotEqual }
    if handler == .Less { return .BranchLess }
    if handler == .LessEqual { return .BranchLessEqual }
    if handler == .Greater { return .BranchGreater }
    if handler == .GreaterEqual { return .BranchGreaterEqual }
    if handler == .SignedLess { return .BranchSignedLess }
    if handler == .SignedLessEqual { return .BranchSignedLessEqual }
    if handler == .SignedGreater { return .BranchSignedGreater }
    if handler == .SignedGreaterEqual { return .BranchSignedGreaterEqual }
    return .Slow
}

// Translates one instruction. `work` and `fuel` are what ExecStep charges
// for it, apart from the copies of a terminator's edge (ExecPlanEdges).
ExecPlanInstruction :: (program: LirProgram, plan: *LirExecPlan, base: s64, types: []s32,
    instruction: LirInstruction, transient: u8, out: *LirExecCode, work: *s64,
    fuel: *s64, bits: *u64) -> ExecPlanCodeKind {
    op := instruction.op
    count := instruction.operands.count
    <<work = 1
    <<fuel = 0
    out.handler = .Slow
    out.result = -1
    out.a = -1
    out.b = -1
    out.c = -1
    out.flag = 0
    out.edge = -1
    out.result_value = instruction.result
    out.value = -1
    out.prefix = 0
    out.memo = -1
    if instruction.result != LirNoId { out.result = ExecPlanWord(plan, base, instruction.result) }
    if count > 0 { out.a = ExecPlanWord(plan, base, instruction.operands[0]) }
    if count > 1 { out.b = ExecPlanWord(plan, base, instruction.operands[1]) }
    if count > 2 { out.c = ExecPlanWord(plan, base, instruction.operands[2]) }
    if op == .Constant || op == .Null || op == .FunctionAddress {
        if out.result < 0 { return .Slow }
        value: u64
        if op == .Constant { value = program.constants[instruction.symbol].bits }
        if op == .FunctionAddress { value = cast(u64)(instruction.symbol + 1) }
        <<bits = ExecCanonicalWord(plan.type_masks[types[instruction.result]], value)
        return .Constant
    }
    if op == .Fuel {
        <<fuel = cast(s64)instruction.immediate
        return .Folded
    }
    if op == .GlobalAddress {
        if out.result < 0 { return .Slow }
        out.handler = .GlobalAddress
        out.x = instruction.symbol
        return .Fast
    }
    if op == .Jump {
        out.handler = .Jump
        return .Fast
    }
    if op == .Branch {
        if out.a < 0 { return .Slow }
        out.handler = .Branch
        return .Fast
    }
    code := cast(s32)op
    if op == .Negate || op == .BitNot {
        if out.result < 0 || out.a < 0 { return .Slow }
        type := program.types[types[instruction.operands[0]]]
        if type.kind == .Integer {
            out.handler = ifx op == .Negate then .Negate else .BitNot
            out.immediate = ExecPlanMask(plan, types[instruction.result])
        } else if type.kind == .Float && op == .Negate {
            out.handler = .FloatNegate
            out.immediate = ifx type.bits == 32 then cast(u64)0x80000000 else cast(u64)0x8000000000000000
        } else { return .Slow }
        return .Fast
    }
    if code >= cast(s32)LirOp.Add && code <= cast(s32)LirOp.Remainder ||
        code >= cast(s32)LirOp.BitAnd && code <= cast(s32)LirOp.ShiftRight {
        if count != 2 || out.result < 0 || out.a < 0 || out.b < 0 { return .Slow }
        type := program.types[types[instruction.operands[0]]]
        out.handler = ExecPlanBinary(op, type)
        if out.handler == .Slow { return .Slow }
        out.size = type.bits
        out.immediate = ExecPlanMask(plan, types[instruction.result])
        return .Fast
    }
    if code >= cast(s32)LirOp.Equal && code <= cast(s32)LirOp.GreaterEqual {
        if count != 2 || out.result < 0 || out.a < 0 || out.b < 0 { return .Slow }
        type := program.types[types[instruction.operands[0]]]
        out.handler = ExecPlanCompare(op, type)
        out.size = type.bits
        out.extra = cast(u64)code
        return .Fast
    }
    if op == .Convert || op == .Bitcast {
        if count != 1 || out.result < 0 || out.a < 0 { return .Slow }
        source := program.types[types[instruction.operands[0]]]
        destination := program.types[types[instruction.result]]
        out.size = source.bits
        out.y = destination.bits
        out.immediate = ExecPlanMask(plan, types[instruction.result])
        if op == .Bitcast {
            if destination.kind == .Bool { return .Slow }
            out.handler = .Bitcast
            return .Fast
        }
        if source.kind == .Bool && destination.kind == .Integer { out.handler = .ConvertBoolInteger }
        else if source.kind == .Integer && destination.kind == .Bool {
            out.handler = .ConvertIntegerBool
            out.extra = ExecMask(source.bits)
        } else if source.kind == .Integer && destination.kind == .Integer {
            out.handler = .ConvertInteger
            out.extra = ExecMask(source.bits)
            out.flag = cast(s32)source.is_signed
        } else if source.kind == .Integer && destination.kind == .Float {
            out.handler = .ConvertIntegerFloat
            out.extra = ExecMask(source.bits)
            out.flag = cast(s32)source.is_signed
        } else if source.kind == .Float && destination.kind == .Float {
            out.handler = .ConvertFloatFloat
        } else if source.kind == .Float && destination.kind == .Integer {
            out.handler = .ConvertFloatInteger
            out.flag = cast(s32)destination.is_signed
        } else { return .Slow }
        return .Fast
    }
    if op == .Extract || op == .Insert {
        expected := ifx op == .Extract then 1 else 2
        aggregate := instruction.operands[0]
        aggregate_type := types[aggregate]
        aggregate_at := ExecLocationOffset(ExecValueLocation(plan, base + aggregate))
        if aggregate_at < 0 { return .Slow }
        indexed := count == expected + 1
        member_offset: s64
        member_cost: s64
        if indexed {
            type := program.types[aggregate_type]
            if type.kind != .Array { return .Slow }
            index := instruction.operands[expected]
            if ExecValueLocation(plan, base + index) < 0 { return .Slow }
            out.extra = cast(u64)type.count
            out.sign_c = ExecPlanSign(program.types[types[index]])
            out.c = ExecPlanWord(plan, base, index)
        } else if count != expected ||
            !ExecPlanMember(program, plan, aggregate_type, instruction.immediate, *member_offset, *member_cost) {
            return .Slow
        }
        out.x = aggregate_at
        if op == .Extract {
            result := instruction.result
            size := plan.type_sizes[types[result]]
            out.size = size
            <<work = 1 + member_cost + ExecCopyCost(size)
            if out.result >= 0 {
                out.handler = ifx indexed then .ExtractWordIndexed else .ExtractWord
                out.flag = cast(s32)(plan.type_masks[types[result]] == 0)
                out.immediate = ExecPlanMask(plan, types[result])
            } else {
                out.handler = ifx indexed then .ExtractBytesIndexed else .ExtractBytes
                out.y = ExecLocationOffset(ExecValueLocation(plan, base + result))
            }
            if !indexed { out.x += member_offset }
            return .Fast
        }
        if out.result >= 0 { return .Slow }
        replacement := instruction.operands[1]
        out.y = ExecLocationOffset(ExecValueLocation(plan, base + instruction.result))
        out.size = plan.type_sizes[types[aggregate]]
        out.z = plan.type_sizes[types[replacement]]
        if !indexed { out.immediate = cast(u64)member_offset }
        <<work = 1 + member_cost + ExecCopyCost(out.size) + ExecCopyCost(out.z)
        if out.b >= 0 {
            out.handler = ifx indexed then .InsertWordIndexed else .InsertWord
        } else {
            out.handler = ifx indexed then .InsertBytesIndexed else .InsertBytes
            out.w = ExecLocationOffset(ExecValueLocation(plan, base + replacement))
        }
        return .Fast
    }
    if op == .Aggregate {
        if out.result >= 0 { return .Slow }
        destination := ExecLocationOffset(ExecValueLocation(plan, base + instruction.result))
        out.x = plan.moves.count
        out.y = count
        at: s64
        cost: s64 = 1
        for operand: instruction.operands {
            size := plan.type_sizes[types[operand]]
            location := ExecValueLocation(plan, base + operand)
            from := ifx location >= 0 then location else ~location
            if !VecPush(plan.moves, LirExecMove.{.word = location >= 0, .from = from,
                .to = destination + at, .size = size}) { return .Slow }
            cost += ExecCopyCost(size)
            at += size
        }
        <<work = cost
        out.handler = .Aggregate
        return .Fast
    }
    if op == .Load || op == .Store {
        if out.a < 0 { return .Slow }
        value := ifx op == .Load then instruction.result else instruction.operands[1]
        if value == LirNoId { return .Slow }
        size := plan.type_sizes[types[value]]
        out.size = size
        out.type = types[value]
        <<work = 1 + ExecCopyCost(size)
        location := ExecValueLocation(plan, base + value)
        if location < 0 { out.x = ~location }
        if op == .Load {
            out.handler = .Load
            out.flag = cast(s32)(plan.type_masks[types[value]] == 0)
            out.immediate = ExecPlanMask(plan, types[value])
        } else { out.handler = .Store }
        return .Fast
    }
    if op == .FieldAddress || op == .ElementAddress {
        if out.result < 0 || out.a < 0 || count > 4 { return .Slow }
        expected := program.types[types[instruction.operands[0]]].element
        target := program.types[types[instruction.result]].element
        out.type = expected
        out.target = target
        out.size = plan.type_sizes[target]
        out.flag = cast(s32)transient
        // Views check their count against the extent per element: by a
        // shift when the size is a power of two (ExecFastPerElement).
        out.z = ExecPlanShift(out.size)
        if count == 4 {
            // A slice of `low`, `high` and the view's count: the view of its
            // element `low` (ElementSlice).
            out.value = out.c
            out.c = ExecPlanWord(plan, base, instruction.operands[3])
            if expected != target || out.size <= 0 || out.b < 0 || out.c < 0 || out.value < 0 { return .Slow }
            out.sign_b = ExecPlanSign(program.types[types[instruction.operands[1]]])
            out.extra = ExecPlanSign(program.types[types[instruction.operands[2]]])
            out.sign_c = ExecPlanSign(program.types[types[instruction.operands[3]]])
            out.handler = .ElementSlice
            <<work = 2
            return .Fast
        }
        if op == .FieldAddress {
            member_offset: s64
            member_cost: s64
            if !ExecPlanMember(program, plan, expected, instruction.immediate, *member_offset, *member_cost) ||
                program.types[expected].kind != .Record { return .Slow }
            out.handler = .FieldAddress
            out.x = member_offset
            <<work = 2 + member_cost
            return .Fast
        }
        if out.b < 0 { return .Slow }
        out.sign_b = ExecPlanSign(program.types[types[instruction.operands[1]]])
        if count == 2 {
            parent := program.types[expected]
            if parent.kind != .Array { return .Slow }
            out.handler = .ElementIndex
            out.extra = cast(u64)parent.count
        } else {
            if out.c < 0 { return .Slow }
            out.sign_c = ExecPlanSign(program.types[types[instruction.operands[2]]])
            out.handler = .ElementView
        }
        <<work = 2
        return .Fast
    }
    if op == .Allocate {
        // Frame storage and its table entry, with the first value copied in
        // when there is one (ExecAllocate). `y` is that copy's work.
        if out.result < 0 || count > 1 { return .Slow }
        pointee := program.types[types[instruction.result]].element
        out.type = pointee
        out.size = plan.type_sizes[pointee]
        out.x = 0
        out.y = 0
        if count == 1 {
            value := instruction.operands[0]
            if types[value] != pointee || plan.type_sizes[types[value]] != out.size { return .Slow }
            if out.a < 0 { out.x = ExecLocationOffset(ExecValueLocation(plan, base + value)) }
            out.y = ExecCopyCost(out.size)
        }
        // It grows the frame's storage, so it ends its segment: the run loop
        // makes it (ExecFastAllocate) and charges its work.
        out.handler = .Allocate
        <<work = 1 + out.y
        return .Slow
    }
    if op == .Call {
        // The callee's entry parameters take the arguments in order.
        target := program.functions[instruction.symbol]
        if target.external || target.parameters.count != count { return .Slow }
        target_plan := plan.functions[instruction.symbol]
        entry := target.blocks[target.entry]
        out.x = plan.moves.count
        out.y = count
        cost: s64 = 1
        for index: cast(s64)0..count - 1 {
            source := instruction.operands[index]
            destination := entry.parameters[index]
            size := plan.type_sizes[types[source]]
            source_location := ExecValueLocation(plan, base + source)
            destination_location := ExecValueLocation(plan, target_plan.value_base + destination)
            word := source_location >= 0
            if word != (destination_location >= 0) { return .Slow }
            if !VecPush(plan.moves, LirExecMove.{.word = word, .size = size,
                .from = ifx word then source_location else ~source_location,
                .to = ifx word then destination_location else ~destination_location}) {
                return .Slow
            }
            cost += ExecCopyCost(size)
        }
        out.handler = .Call
        out.target = instruction.symbol
        <<work = cost
        return .Slow
    }
    if op == .Return {
        out.handler = .Return
        // The code record is reused from block to block: nothing returned
        // has no size.
        out.size = 0
        out.x = 0
        if count == 1 {
            value := instruction.operands[0]
            out.size = plan.type_sizes[types[value]]
            location := ExecValueLocation(plan, base + value)
            if location < 0 { out.x = ~location }
        }
        return .Slow
    }
    if op == .HostCall {
        if count != 3 || !ExecPlatformWriteSignature(program, instruction.symbol) {
            // A generic host call whose arguments all live in frame words and
            // whose result, if any, is a scalar word stays in the fast loop;
            // anything else runs on ExecStep.
            target := program.functions[instruction.symbol]
            if count > 3 { return .Slow }
            if count >= 1 && out.a < 0 { return .Slow }
            if count >= 2 && out.b < 0 { return .Slow }
            if count >= 3 && out.c < 0 { return .Slow }
            if out.result >= 0 && !ExecHostScalarType(program.types[target.result]) { return .Slow }
            out.handler = .HostCall
            out.target = instruction.symbol
            out.type = target.result
            out.x = count
            <<work = 1 + count
            return .Fast
        }
        if out.a < 0 || out.b < 0 || out.c < 0 { return .Slow }
        target := program.functions[instruction.symbol]
        out.handler = .HostWrite
        out.target = instruction.symbol
        out.type = program.types[target.parameters[1]].element
        <<work = 1 + count
        return .Fast
    }
    return .Slow
}

// The edge plans of one block's instructions, from plan edge `edge_at`.
ExecPlanEdges :: (plan: *LirExecPlan, function: LirFunction, function_plan: LirExecFunctionPlan,
    block: LirBlock, edge_at: s64) -> bool {
    base := function_plan.value_base
    types := function.values
    at := edge_at
    for instruction: block.instructions {
        for edge: instruction.edges {
            target := function.blocks[edge.block]
            target_base := cast(s64)plan.block_instruction_bases[function_plan.block_base + edge.block]
            direct := plan.edge_direct[at] != 0
            first := plan.moves.count
            work: s64
            scratch: s64
            if edge.arguments.count != target.parameters.count { return false }
            for index: cast(s64)0..target.parameters.count - 1 {
                source := edge.arguments[index]
                destination := target.parameters[index]
                size := plan.type_sizes[types[source]]
                work += 2 * ExecCopyCost(size)
                if direct && ExecPlanValuesSameLocation(plan, base, types, source, destination) { continue }
                source_location := ExecValueLocation(plan, base + source)
                destination_location := ExecValueLocation(plan, base + destination)
                word := source_location >= 0
                if word != (destination_location >= 0) { return false }
                move := LirExecMove.{.word = word, .size = size,
                    .from = ifx word then source_location else ~source_location,
                    .to = ifx word then destination_location else ~destination_location,
                    .scratch = function_plan.scratch_offset + scratch}
                scratch += size
                if !VecPush(plan.moves, move) { return false }
            }
            plan.edge_plans[at] = .{.moves = first, .count = plan.moves.count - first,
                .direct = direct, .work = work, .target_block = edge.block,
                .target_base = target_base, .target_code = plan.segment_code[target_base],
                .target_work = plan.segment_work[target_base], .target_fuel = plan.segment_fuel[target_base]}
            at += 1
        }
    }
    return true
}

// Translates every function into the plan's compact code (LirExecCode).
ExecPlanCode :: (program: LirProgram, plan: *LirExecPlan) -> LirExecProblem {
    total := plan.transient.count
    if !VecResizeBounded(plan.segment_code, total, total) ||
        !VecResizeBounded(plan.segment_work, total, total) ||
        !VecResizeBounded(plan.segment_fuel, total, total) ||
        !VecResizeBounded(plan.edge_plans, plan.edge_direct.count, plan.edge_direct.count) { return .Allocation }
    code_count: s64
    for index: cast(s64)0..total - 1 { plan.segment_code[index] = -1 }
    // Neither total may come near the limits of the work and fuel counters.
    ceiling: s64 = 4611686018427387904
    kinds: Vec(ExecPlanCodeKind)
    works: Vec(s64)
    fuels: Vec(s64)
    codes: Vec(LirExecCode)
    entries: Vec(s64)
    uses: Vec(s64)
    defer VecFree(uses)
    defer VecFree(kinds)
    defer VecFree(works)
    defer VecFree(fuels)
    defer VecFree(codes)
    defer VecFree(entries)
    for function_index: cast(s64)0..program.functions.count - 1 {
        function := program.functions[function_index]
        function_plan := plan.functions[function_index]
        base := function_plan.value_base
        plan.functions[function_index].constants = plan.constant_words.count
        if !VecResize(uses, function.values.count) { return .Allocation }
        for value: cast(s64)0..function.values.count - 1 { uses[value] = 0 }
        for block: function.blocks {
            for instruction: block.instructions {
                for operand: instruction.operands { uses[operand] += 1 }
                for edge: instruction.edges { for argument: edge.arguments { uses[argument] += 1 } }
            }
        }
        for block_index: cast(s32)0..cast(s32)function.blocks.count - 1 {
            block := function.blocks[block_index]
            first := cast(s64)plan.block_instruction_bases[function_plan.block_base + block_index]
            count := block.instructions.count
            if !VecResize(kinds, count) || !VecResize(works, count) || !VecResize(fuels, count) ||
                !VecResize(codes, count) || !VecResize(entries, count) { return .Allocation }
            edges := cast(s64)plan.block_edge_bases[function_plan.block_base + block_index]
            for index: cast(s64)0..count - 1 {
                bits: u64
                kind := ExecPlanInstruction(program, plan, base, function.values, block.instructions[index],
                    plan.transient[first + index], *codes[index], *works[index], *fuels[index], *bits)
                codes[index].block = block_index
                codes[index].index = cast(s32)index
                codes[index].base = first
                codes[index].cost = works[index]
                if block.instructions[index].edges.count != 0 { codes[index].edge = cast(s32)edges }
                edges += block.instructions[index].edges.count
                if kind == .Constant {
                    if !VecPush(plan.constant_words, LirExecConstantWord.{.word = cast(s64)codes[index].result,
                        .bits = bits}) { return .Allocation }
                }
                kinds[index] = kind
            }
            // A derivation used only by the Load or Store right after it runs
            // inside that instruction's code.
            for index: cast(s64)0..count - 2 {
                if kinds[index] != .Fast || kinds[index + 1] != .Fast { continue }
                fused := ExecPlanFusedMemory(codes[index].handler, codes[index + 1].handler)
                derived := block.instructions[index].result
                user := block.instructions[index + 1]
                if fused == .Slow || codes[index].flag != ExecTransientBlock || derived == LirNoId ||
                    user.operands[0] != derived || uses[derived] != 1 { continue }
                memory := codes[index + 1]
                codes[index].handler = fused
                codes[index].result = memory.result
                codes[index].value = memory.b
                codes[index].w = memory.x
                codes[index].immediate = memory.immediate
                codes[index].flag = memory.flag
                kinds[index + 1] = .Folded
            }
            // A FieldAddress used only as the base of the derivation right
            // after it runs inside that derivation's code.
            for index: cast(s64)0..count - 2 {
                if kinds[index] != .Fast || codes[index].handler != .FieldAddress || codes[index].flag != ExecTransientBlock ||
                    kinds[index + 1] != .Fast || codes[index + 1].prefix != 0 { continue }
                next := codes[index + 1].handler
                if !ExecPlanDerivation(next) { continue }
                derived := block.instructions[index].result
                if derived == LirNoId || block.instructions[index + 1].operands[0] != derived ||
                    uses[derived] != 1 { continue }
                field := codes[index]
                fused := codes[index + 1]
                fused.prefix = 1
                fused.prefix_type = field.type
                fused.prefix_offset = field.x
                fused.prefix_size = field.size
                fused.a = field.a
                fused.block = field.block
                fused.index = field.index
                fused.cost = field.cost + fused.cost
                codes[index] = fused
                kinds[index + 1] = .Folded
            }
            // Two word Extracts in a row run as one.
            index: s64
            while index + 1 < count {
                if kinds[index] == .Fast && kinds[index + 1] == .Fast &&
                    codes[index].handler == .ExtractWord && codes[index + 1].handler == .ExtractWord {
                    second := codes[index + 1]
                    codes[index].handler = .ExtractWordPair
                    codes[index].b = second.result
                    codes[index].y = second.x
                    codes[index].z = second.size
                    codes[index].c = second.flag
                    codes[index].extra = second.immediate
                    kinds[index + 1] = .Folded
                    index += 2
                } else { index += 1 }
            }
            // An Add right before the block's Jump runs inside it.
            if count >= 2 && codes[count - 1].handler == .Jump && kinds[count - 2] == .Fast &&
                codes[count - 2].handler == .Add {
                add := codes[count - 2]
                codes[count - 1].handler = .AddJump
                codes[count - 1].result = add.result
                codes[count - 1].a = add.a
                codes[count - 1].b = add.b
                codes[count - 1].immediate = add.immediate
                kinds[count - 2] = .Folded
            }
            // A compare right before the Branch on its result runs inside it.
            if count >= 2 && codes[count - 1].handler == .Branch && kinds[count - 2] == .Fast {
                compare := block.instructions[count - 2]
                fused := ExecPlanFused(codes[count - 2].handler)
                if fused != .Slow && compare.result != LirNoId &&
                    block.instructions[count - 1].operands[0] == compare.result {
                    codes[count - 1].handler = fused
                    codes[count - 1].result = codes[count - 2].result
                    codes[count - 1].a = codes[count - 2].a
                    codes[count - 1].b = codes[count - 2].b
                    codes[count - 1].size = codes[count - 2].size
                    kinds[count - 2] = .Folded
                }
            }
            // Keep each segment's totals far from overflow.
            running_work: s64
            running_fuel: s64
            for index: cast(s64)0..count - 1 {
                if kinds[index] != .Slow &&
                    (works[index] > ceiling - running_work || fuels[index] > ceiling - running_fuel) {
                    kinds[index] = .Slow
                    codes[index].handler = .Slow
                }
                if kinds[index] == .Slow { running_work = 0; running_fuel = 0 }
                else { running_work += works[index]; running_fuel += fuels[index] }
            }
            for index: cast(s64)0..count - 1 {
                entries[index] = -1
                if kinds[index] == .Fast || kinds[index] == .Slow {
                    entries[index] = code_count
                    handler := codes[index].handler
                    if kinds[index] == .Fast && codes[index].flag == 0 && (handler == .FieldAddress ||
                        handler == .ElementIndex || handler == .ElementView || handler == .ElementSlice) {
                        codes[index].memo = cast(s32)plan.derived_count
                        plan.derived_count += 1
                    }
                    chunk_index := code_count / ExecCodeChunkSize
                    slot := code_count % ExecCodeChunkSize
                    // Allocate only as code is emitted, without relocating
                    // previously compiled instructions when the plan grows.
                    if slot == 0 {
                        size := total - code_count
                        if size > ExecCodeChunkSize { size = ExecCodeChunkSize }
                        if !VecResize(plan.code, chunk_index + 1) ||
                            !VecResizeBounded(plan.code[chunk_index].entries, size, size) { return .Allocation }
                    }
                    plan.code[chunk_index].entries[slot] = codes[index]
                    code_count += 1
                }
            }
            at: s64
            while at < count {
                if kinds[at] == .Slow {
                    plan.segment_code[first + at] = entries[at]
                    plan.segment_work[first + at] = 0
                    plan.segment_fuel[first + at] = 0
                    at += 1
                    continue
                }
                end := at
                work: s64
                fuel: s64
                while end < count && kinds[end] != .Slow {
                    work += works[end]
                    fuel += fuels[end]
                    end += 1
                }
                next := at
                while next < count && entries[next] < 0 { next += 1 }
                if next >= count { return .InvalidProgram }
                plan.segment_code[first + at] = entries[next]
                plan.segment_work[first + at] = work
                plan.segment_fuel[first + at] = fuel
                for index: at..end - 1 {
                    if entries[index] >= 0 {
                        pc := entries[index]
                        code := *plan.code[pc / ExecCodeChunkSize].entries[pc % ExecCodeChunkSize]
                        code.rest_work = work
                        code.rest_fuel = fuel
                    }
                    work -= works[index]
                    fuel -= fuels[index]
                }
                at = end
            }
        }
        plan.functions[function_index].constant_count =
            plan.constant_words.count - plan.functions[function_index].constants
        for block_index: cast(s64)0..function.blocks.count - 1 {
            block_at := function_plan.block_base + block_index
            if !ExecPlanEdges(plan, function, plan.functions[function_index], function.blocks[block_index],
                cast(s64)plan.block_edge_bases[block_at]) { return .InvalidProgram }
        }
    }
    return .None
}

ExecInstructionOrigin :: (instance: *LirExecInstance, frame: LirExecFrame) -> s32 {
    function := instance.plan.program.functions[frame.function]
    #if #defined(ZIRAN_EXEC_PACKED_INSTRUCTIONS) {
        // Verified executable app images carry no debug origins.
        if instance.plan.packed_instructions.count != 0 { return function.origin }
    }
    if frame.block < 0 || frame.block >= function.blocks.count { return function.origin }
    if frame.instruction < 0 { return function.origin }
    block := function.blocks[frame.block]
    if frame.instruction >= block.instructions.count { return function.origin }
    origin := block.instructions[frame.instruction].origin
    return ifx origin != LirNoId then origin else function.origin
}

ExecFail :: (instance: *LirExecInstance, problem: LirExecProblem, trap: u64 = 0) -> bool #cold {
    if instance.failure.problem != .None { return false }
    result := ExecResult(problem)
    result.trap = trap
    result.work_remaining = instance.work_remaining
    result.fuel_remaining = instance.fuel_remaining
    if instance.frames.count != 0 {
        frame := instance.frames[instance.frames.count - 1]
        result.function = frame.function
        result.block = frame.block
        result.instruction = frame.instruction
        result.origin = ExecInstructionOrigin(instance, frame)
    }
    instance.failure = result
    return false
}

ExecInitialLocation :: (instance: *LirExecInstance, function_id: s32) {
    if instance.failure.problem == .None || instance.failure.function != LirNoId ||
        function_id < 0 || function_id >= instance.plan.program.functions.count { return }
    function := instance.plan.program.functions[function_id]
    instance.failure.function = function_id
    instance.failure.block = function.entry
    instance.failure.instruction = 0
    block_at := instance.plan.functions[function_id].block_base + function.entry
    instance.failure.origin = ExecInstructionOrigin(instance, .{function = function_id,
        block = function.entry, instruction_base = cast(s64)instance.plan.block_instruction_bases[block_at]})
}

ExecCanContinue :: (instance: *LirExecInstance) -> bool #inline {
    if instance.cancel_check != null && instance.cancel_check(instance.cancel_context) {
        return ExecFail(instance, .Cancelled)
    }
    return true
}

ExecSpend :: (instance: *LirExecInstance, count: s64) -> bool #inline {
    if count < 0 || count > instance.work_remaining { return ExecFail(instance, .WorkLimit) }
    instance.work_remaining -= count
    return true
}

ExecCopyCost :: (count: s64) -> s64 {
    // A shift rather than a checked division for the sizes copies have.
    if count >= 0 { return 1 + ((count + 7) >> 3) }
    return 1 + (count + 7) / 8
}

ExecFrameValueOffset :: (instance: *LirExecInstance, frame_index: s64, value: s32) -> s64 {
    frame := instance.frames[frame_index]
    return frame.base + ExecLocationOffset(ExecValueLocation(instance.plan, frame.value_base + value))
}

ExecFrameValueWord :: (instance: *LirExecInstance, frame_index: s64, value: s32) -> s64 {
    frame := instance.frames[frame_index]
    return frame.word_base + ExecLocationWord(ExecValueLocation(instance.plan, frame.value_base + value))
}

ExecValueIsWord :: (instance: *LirExecInstance, frame_index: s64, value: s32) -> bool {
    frame := instance.frames[frame_index]
    return ExecValueLocation(instance.plan, frame.value_base + value) >= 0
}

ExecValueSize :: (instance: *LirExecInstance, frame_index: s64, value: s32) -> s64 {
    frame := instance.frames[frame_index]
    return instance.plan.type_sizes[frame.value_types[value]]
}

ExecValueType :: (instance: *LirExecInstance, value: s32) -> LirType #inline {
    return instance.plan.program.types[instance.current_value_types[value]]
}

// Values are read without a definedness check: the verifier proves every
// use is dominated by its definition and has the operand type it needs.
// Values from outside the plan (arguments, host results, global images)
// are checked where they come in.
ExecSlotBits :: (instance: *LirExecInstance, value: s32) -> u64 #inline {
    word := ExecValueLocation(instance.plan, instance.current_value_base + value)
    if word < 0 {
        unused ExecFail(instance, .Type)
        return 0
    }
    return instance.words[instance.current_word_base + word]
}

ExecIndexBits :: (instance: *LirExecInstance, value: s32) -> u64 {
    bits := ExecSlotBits(instance, value)
    type := ExecValueType(instance, value)
    if type.is_signed && ExecSigned(bits, type.bits) < 0 { unused ExecFail(instance, .Type) }
    return bits
}

ExecWriteSlotBits :: (instance: *LirExecInstance, value: s32, bits: u64) #inline {
    word := ExecValueLocation(instance.plan, instance.current_value_base + value)
    if word < 0 {
        unused ExecFail(instance, .Type)
        return
    }
    mask := instance.plan.type_masks[instance.current_value_types[value]]
    instance.words[instance.current_word_base + word] = ExecCanonicalWord(mask, bits)
}

ExecCopyStorage :: (instance: *LirExecInstance, source: s64, destination: s64, count: s64) -> bool {
    if !ExecSpend(instance, ExecCopyCost(count)) { return false }
    if source == destination { return true }
    #if TARGET == .C {
        if count >= 32 {
            storage := instance.storage[:]
            last := storage.count - count
            // The forward loop below also handles overlapping frame slots.
            if source >= 0 && source <= last && destination >= 0 && destination <= last &&
                (source <= destination - count || destination <= source - count) {
                unused ExecCopyDisjointBytes(cast(*void)*storage[destination],
                    cast(*void)*storage[source], cast(usize)count)
                return true
            }
        }
    }
    for index: cast(s64)0..count - 1 { instance.storage[destination + index] = instance.storage[source + index] }
    return true
}

ExecCopyValueToStorage :: (instance: *LirExecInstance, frame_index: s64,
    source: s32, destination: s64) -> bool {
    size := ExecValueSize(instance, frame_index, source)
    if ExecValueIsWord(instance, frame_index, source) {
        if !ExecSpend(instance, ExecCopyCost(size)) { return false }
        ExecWriteBits(instance.storage[:], destination, size,
            instance.words[ExecFrameValueWord(instance, frame_index, source)])
        return true
    }
    return ExecCopyStorage(instance, ExecFrameValueOffset(instance, frame_index, source),
        destination, size)
}

ExecCopyStorageToValue :: (instance: *LirExecInstance, source: s64,
    frame_index: s64, destination: s32) -> bool {
    size := ExecValueSize(instance, frame_index, destination)
    if ExecValueIsWord(instance, frame_index, destination) {
        if !ExecSpend(instance, ExecCopyCost(size)) { return false }
        ExecWriteSlotBits(instance, destination,
            ExecReadBits(instance.storage[:], source, size))
        return instance.failure.problem == .None
    }
    if !ExecCopyStorage(instance, source,
        ExecFrameValueOffset(instance, frame_index, destination), size) { return false }
    return true
}

ExecCopyValue :: (instance: *LirExecInstance, source_frame: s64, source: s32,
    destination_frame: s64, destination: s32) -> bool {
    size := ExecValueSize(instance, source_frame, source)
    source_word := ExecValueIsWord(instance, source_frame, source)
    if source_word != ExecValueIsWord(instance, destination_frame, destination) {
        return ExecFail(instance, .Type)
    }
    if source_word {
        if !ExecSpend(instance, ExecCopyCost(size)) { return false }
        instance.words[ExecFrameValueWord(instance, destination_frame, destination)] =
            instance.words[ExecFrameValueWord(instance, source_frame, source)]
    } else if !ExecCopyStorage(instance, ExecFrameValueOffset(instance, source_frame, source),
        ExecFrameValueOffset(instance, destination_frame, destination), size) { return false }
    return true
}

ExecCopySlot :: (instance: *LirExecInstance, frame_index: s64, source: s32, destination: s32) -> bool {
    return ExecCopyValue(instance, frame_index, source, frame_index, destination)
}

ExecMember :: (instance: *LirExecInstance, type_id: s32, member: u64, offset: *s64, member_type: *s32) -> bool {
    type := instance.plan.program.types[type_id]
    if type.kind == .Array {
        if member >= cast(u64)type.count { return ExecFail(instance, .Type) }
        <<member_type = type.element
        <<offset = cast(s64)member * instance.plan.type_sizes[type.element]
        return true
    }
    if type.kind != .Record || member >= cast(u64)type.fields.count { return ExecFail(instance, .Type) }
    result: s64
    for index: cast(s64)0..cast(s64)member - 1 {
        if !ExecSpend(instance, 1) { return false }
        result += instance.plan.type_sizes[type.fields[index]]
    }
    <<member_type = type.fields[cast(s64)member]
    <<offset = result
    return true
}

// A table holds at most this many entries, and a slot is reused at most
// ExecAddressVersions times before it is retired.
ExecAddressSlots :: 2097151
ExecAddressVersions :: 268435455

// Large VM vectors can stay near their peak for the lifetime of a guest.
// Limit geometric growth to a fraction of the old capacity. The caller
// has already checked count against maximum.
ExecGrowthCeiling :: (count: s64, capacity: s64, maximum: s64, small: s64, growth_divisor: s64 = 8) -> s64 #inline {
    if count <= capacity || count <= small { return maximum }
    spare := capacity / growth_divisor
    return count + (ifx spare < maximum - count then spare else maximum - count)
}

ExecResizeAddresses :: (instance: *LirExecInstance, count: s64, maximum: s64) -> bool {
    // Address records are large and realloc may hold both tables at once.
    // Keep some geometric headroom without needing a much larger free block.
    ceiling := ExecGrowthCeiling(count, instance.addresses.capacity, maximum, 1024, 64)
    if VecResizeBounded(instance.addresses, count, ceiling) { return true }
    return count > instance.addresses.capacity && count < ceiling &&
        VecResizeBounded(instance.addresses, count, count)
}

// A pointer's bits: the instance's identity (its low 16 bits), the slot's
// version, and one more than the slot. Zero is the null pointer.
ExecAddressToken :: (identity: u32, index: s64, version: u64 = 0) -> u64 {
    return (cast(u64)(identity & 65535) << cast(u64)48) | (version << cast(u64)22) | cast(u64)(index + 1)
}

ExecFindAddress :: (instance: *LirExecInstance, token: u64) -> s32 {
    if token == 0 { return -1 }
    low := token & cast(u64)4194303
    if low == 0 { return -1 }
    index := cast(s64)(low - cast(u64)1)
    if index >= instance.addresses.count || instance.addresses[index].token != token { return -1 }
    return cast(s32)index
}

ExecAddressHash :: (address: LirExecAddress) -> u64 {
    hash := cast(u64)address.offset * cast(u64)0x9E3779B97F4A7C15
    hash = (hash ^ cast(u64)address.extent) * cast(u64)0xC2B2AE3D27D4EB4F
    hash = (hash ^ cast(u64)(address.frame + 1)) * cast(u64)0x9E3779B97F4A7C15
    hash = (hash ^ address.generation) * cast(u64)0xC2B2AE3D27D4EB4F
    hash = (hash ^ cast(u64)(address.global + 1)) * cast(u64)0x9E3779B97F4A7C15
    hash = (hash ^ cast(u64)address.type) * cast(u64)0xC2B2AE3D27D4EB4F
    if address.owned { hash = ~hash }
    return hash ^ (hash >> cast(u64)29)
}

// Two addresses are one when they name the same bytes as the same type.
ExecAddressSame :: (left: LirExecAddress, right: LirExecAddress) -> bool {
    return left.frame == right.frame && left.generation == right.generation &&
        left.global == right.global && left.offset == right.offset && left.extent == right.extent &&
        left.type == right.type && left.owned == right.owned
}

// The table entry equal to `address`, or -1.
ExecAddressLookup :: (instance: *LirExecInstance, address: LirExecAddress) -> s64 {
    if instance.address_slots.count == 0 { return -1 }
    mask := instance.address_slots.count - 1
    slot := cast(s64)(ExecAddressHash(address) & cast(u64)mask)
    entry := instance.address_slots[slot]
    while entry != 0 {
        if entry > 0 && ExecAddressSame(instance.addresses[entry - 1], address) { return cast(s64)entry - 1 }
        slot = (slot + 1) & mask
        entry = instance.address_slots[slot]
    }
    return -1
}

// Rebuilds the index from the live entries, at most a quarter full.
ExecAddressReindex :: (instance: *LirExecInstance) -> bool {
    live: s64
    for index: cast(s64)0..instance.addresses.count - 1 {
        if instance.addresses[index].token != 0 && !instance.addresses[index].scoped &&
            !ExecTransientIndex(instance, index) { live += 1 }
    }
    // The table never shrinks: a rebuild in place only drops removed entries.
    capacity: s64 = 64
    while capacity < (live + 1) * 4 { capacity *= 2 }
    if capacity < instance.address_slots.count { capacity = instance.address_slots.count }
    if !VecResizeBounded(instance.address_slots, capacity, capacity) { return false }
    for index: cast(s64)0..capacity - 1 { instance.address_slots[index] = 0 }
    mask := capacity - 1
    for index: cast(s64)0..instance.addresses.count - 1 {
        if instance.addresses[index].token == 0 || instance.addresses[index].scoped ||
            ExecTransientIndex(instance, index) { continue }
        slot := cast(s64)(ExecAddressHash(instance.addresses[index]) & cast(u64)mask)
        while instance.address_slots[slot] != 0 { slot = (slot + 1) & mask }
        instance.address_slots[slot] = cast(s32)(index + 1)
    }
    instance.address_used = live
    return true
}

ExecAddressIndexAdd :: (instance: *LirExecInstance, index: s64) -> bool {
    // Removed entries count as used until a rebuild drops them.
    if (instance.address_used + 1) * 2 > instance.address_slots.count { return ExecAddressReindex(instance) }
    mask := instance.address_slots.count - 1
    slot := cast(s64)(ExecAddressHash(instance.addresses[index]) & cast(u64)mask)
    while instance.address_slots[slot] > 0 { slot = (slot + 1) & mask }
    if instance.address_slots[slot] == 0 { instance.address_used += 1 }
    instance.address_slots[slot] = cast(s32)(index + 1)
    return true
}

ExecAddressIndexRemove :: (instance: *LirExecInstance, index: s64) {
    if instance.address_slots.count == 0 { return }
    mask := instance.address_slots.count - 1
    slot := cast(s64)(ExecAddressHash(instance.addresses[index]) & cast(u64)mask)
    entry := instance.address_slots[slot]
    while entry != 0 {
        if cast(s64)entry == index + 1 {
            instance.address_slots[slot] = -1
            // A removed slot right before an empty one ends no probe, so it
            // and the removed slots before it are empty again: frames that
            // come and go leave no trail for lookups to walk.
            while instance.address_slots[slot] == -1 && instance.address_slots[(slot + 1) & mask] == 0 {
                instance.address_slots[slot] = 0
                instance.address_used -= 1
                slot = (slot - 1) & mask
            }
            return
        }
        slot = (slot + 1) & mask
        entry = instance.address_slots[slot]
    }
}

// Makes a table entry for `address`: a slot that was given back, under its
// next version, or a new slot. An address into a frame or a heap block joins
// that frame's or block's chain and is given back when the frame returns or
// the block dies. Returns the entry's index, or -1 with the failure recorded.
ExecNewAddress :: (instance: *LirExecInstance, address: LirExecAddress, scope: s64 = -1) -> s64 {
    index: s64
    version: u64
    if instance.address_free.count > 0 {
        index = instance.address_free[instance.address_free.count - 1]
        unused VecResize(instance.address_free, instance.address_free.count - 1)
        version = instance.addresses[index].version + 1
    } else {
        index = instance.addresses.count
        maximum := ifx instance.limits.addresses < ExecAddressSlots then instance.limits.addresses else ExecAddressSlots
        if index >= maximum { unused ExecFail(instance, .AddressLimit); return -1 }
        if !ExecResizeAddresses(instance, index + 1, maximum) { unused ExecFail(instance, .Allocation); return -1 }
    }
    added := address
    added.version = version
    added.token = ExecAddressToken(instance.identity, index, version)
    added.next = 0
    if scope >= 0 {
        added.scoped = true
        added.next = instance.frames[scope].addresses
        instance.frames[scope].addresses = index + 1
    } else if added.frame >= 0 {
        added.next = instance.frames[added.frame].addresses
        instance.frames[added.frame].addresses = index + 1
    } else if added.heap != 0 {
        added.next = instance.heap_blocks[added.heap - 1].addresses
        instance.heap_blocks[added.heap - 1].addresses = index + 1
    }
    instance.addresses[index] = added
    if !added.scoped && !ExecAddressIndexAdd(instance, index) {
        unused ExecFail(instance, .Allocation); return -1
    }
    return index
}

// Gives back every entry of a chain. Its frame returned or its heap block
// died, so no valid pointer names these entries any more.
ExecReleaseAddresses :: (instance: *LirExecInstance, head: s64) {
    at := head
    while at != 0 {
        index := at - 1
        at = instance.addresses[index].next
        if !instance.addresses[index].scoped { ExecAddressIndexRemove(instance, index) }
        instance.addresses[index].token = 0
        instance.addresses[index].next = 0
        if instance.addresses[index].version < ExecAddressVersions { unused VecPush(instance.address_free, index) }
    }
}

// The token of the table entry equal to `address`, made when it is new.
// Deriving the same address again gives the same token, so pointers compare
// equal exactly when they name the same bytes as the same type.
ExecInternAddress :: (instance: *LirExecInstance, address: LirExecAddress) -> u64 {
    if !ExecSpend(instance, 1) { return 0 }
    index := ExecAddressLookup(instance, address)
    if index < 0 { index = ExecNewAddress(instance, address) }
    if index < 0 { return 0 }
    return instance.addresses[index].token
}

// Transient addresses. A derivation whose result is only the address of a
// Load or Store, or the base of another derivation, later in its own block,
// with no call or resize between, makes no lasting table entry: it takes the
// next of a few entries kept for this, in turn, with a new version, so its
// token lives until that entry is taken again. The plan proves the uses come
// first. Its checks and its work charge are an interned address's.
ExecTransientSlots :: 256;
ExecTransientBlock :: 1
ExecTransientFrame :: 2

ExecTransientIndex :: (instance: *LirExecInstance, index: s64) -> bool {
    return instance.transient_count != 0 && index >= instance.transient_base &&
        index < instance.transient_base + instance.transient_count
}

ExecTransient :: (instance: *LirExecInstance, address: LirExecAddress) -> u64 {
    if !ExecSpend(instance, 1) { return 0 }
    if instance.transient_count == 0 {
        base := instance.addresses.count
        maximum := ifx instance.limits.addresses < ExecAddressSlots then instance.limits.addresses else ExecAddressSlots
        if base + ExecTransientSlots > maximum { unused ExecFail(instance, .AddressLimit); return 0 }
        if !ExecResizeAddresses(instance, base + ExecTransientSlots, maximum) {
            unused ExecFail(instance, .Allocation)
            return 0
        }
        instance.transient_base = base
        instance.transient_count = ExecTransientSlots
    }
    index := instance.transient_base + instance.transient_next
    instance.transient_next += 1
    if instance.transient_next == ExecTransientSlots { instance.transient_next = 0 }
    entry := address
    entry.version = (instance.addresses[index].version + 1) & cast(u64)268435455
    entry.token = ExecAddressToken(instance.identity, index, entry.version)
    entry.next = 0
    instance.addresses[index] = entry
    return entry.token
}

LirExecAddressUse :: struct { lifetime: u8; frame: s64; previous: u64 }

// A nonescaping derivation owns the sole word containing this token. The
// next execution of that definition in this frame can replace the address.
// The address still carries the original storage's bounds and generation.
ExecReuseScopedAddress :: (instance: *LirExecInstance, previous: u64, address: LirExecAddress) -> u64 {
    index := ExecFindAddress(instance, previous)
    if index < 0 || !instance.addresses[index].scoped ||
        instance.addresses[index].version == ExecAddressVersions { return 0 }
    entry := *instance.addresses[index]
    updated := address
    updated.scoped = true
    updated.next = entry.next
    updated.version = entry.version + 1
    updated.token = ExecAddressToken(instance.identity, index, updated.version)
    <<entry = updated
    return updated.token
}

ExecDeriveToken :: (instance: *LirExecInstance, address: LirExecAddress, usage: LirExecAddressUse) -> u64 {
    if usage.lifetime == ExecTransientFrame {
        if !ExecSpend(instance, 1) { return 0 }
        token := ExecReuseScopedAddress(instance, usage.previous, address)
        if token != 0 { return token }
        index := ExecNewAddress(instance, address, usage.frame)
        if index < 0 { return 0 }
        return instance.addresses[index].token
    }
    if usage.lifetime == ExecTransientBlock { return ExecTransient(instance, address) }
    return ExecInternAddress(instance, address)
}

ExecTransientBarrier :: (op: LirOp) -> bool {
    return op == .Call || op == .CallIndirect || op == .HostCall || op == .Resize
}

// An address used only for memory access or an independent derivation
// cannot escape its SSA definition. The verifier proves dominance across
// blocks. Without edge forwarding the old token cannot survive another
// execution of the definition, and its word cannot be coalesced with a
// block parameter. The usual short-lived addresses share a block ring.
ExecPlanTransients :: (plan: *LirExecPlan, function: LirFunction, block_base: s64) -> bool {
    count := function.values.count
    defined_in: Vec(s32)
    defined_at: Vec(s64)
    last_use: Vec(s64)
    usable: Vec(u8)
    defer VecFree(defined_in)
    defer VecFree(defined_at)
    defer VecFree(last_use)
    defer VecFree(usable)
    if !VecResizeBounded(defined_in, count, count) || !VecResizeBounded(defined_at, count, count) ||
        !VecResizeBounded(last_use, count, count) || !VecResizeBounded(usable, count, count) { return false }
    for value: cast(s64)0..count - 1 { defined_in[value] = -1 }
    for block_index: cast(s32)0..cast(s32)function.blocks.count - 1 {
        block := function.blocks[block_index]
        for index: cast(s64)0..block.instructions.count - 1 {
            instruction := block.instructions[index]
            if (instruction.op == .FieldAddress || instruction.op == .ElementAddress) && instruction.result != LirNoId {
                defined_in[instruction.result] = block_index
                defined_at[instruction.result] = index
                last_use[instruction.result] = index
                usable[instruction.result] = ExecTransientBlock
            }
        }
    }
    for block_index: cast(s32)0..cast(s32)function.blocks.count - 1 {
        block := function.blocks[block_index]
        for index: cast(s64)0..block.instructions.count - 1 {
            instruction := block.instructions[index]
            for operand: cast(s64)0..instruction.operands.count - 1 {
                value := instruction.operands[operand]
                if defined_in[value] < 0 { continue }
                // An empty slice is its base's own token, so a slice may keep it.
                address_use := operand == 0 && (instruction.op == .Load || instruction.op == .Store ||
                    instruction.op == .FieldAddress ||
                    instruction.op == .ElementAddress && instruction.operands.count != 4)
                if !address_use || defined_in[value] == block_index && defined_at[value] >= index {
                    usable[value] = 0
                    continue
                }
                if defined_in[value] != block_index {
                    if usable[value] != 0 { usable[value] = ExecTransientFrame }
                } else if index > last_use[value] { last_use[value] = index }
            }
            for edge: instruction.edges {
                for value: edge.arguments { if defined_in[value] >= 0 { usable[value] = 0 } }
            }
        }
    }
    for value: cast(s64)0..count - 1 {
        if defined_in[value] < 0 || usable[value] == 0 { continue }
        from := defined_at[value]
        to := last_use[value]
        block_index := defined_in[value]
        block := function.blocks[block_index]
        lifetime := usable[value]
        if lifetime == ExecTransientBlock {
            // Each intervening derivation can take a slot from the ring.
            if to - from >= ExecTransientSlots { lifetime = ExecTransientFrame }
            else {
                for between: from + 1..to - 1 {
                    if ExecTransientBarrier(block.instructions[between].op) { lifetime = ExecTransientFrame; break }
                }
            }
        }
        // A slice may return its base token instead of using its own slot.
        if lifetime == ExecTransientFrame && block.instructions[from].operands.count == 4 { continue }
        plan.transient[cast(s64)plan.block_instruction_bases[block_base + block_index] + from] = lifetime
    }
    return true
}

ExecFieldAddress :: (instance: *LirExecInstance, parent: s32, member: u64, target_type: s32,
    usage: LirExecAddressUse) -> u64 {
    base := instance.addresses[parent]
    member_offset: s64
    member_type: s32
    if !ExecMember(instance, base.type, member, *member_offset, *member_type) ||
        member_type != target_type { unused ExecFail(instance, .Type); return 0 }
    offset := base.offset + member_offset
    parent_type := instance.plan.program.types[base.type]
    extent := ifx parent_type.kind == .Array then base.extent - member_offset else instance.plan.type_sizes[target_type]
    if extent < instance.plan.type_sizes[target_type] { unused ExecFail(instance, .Pointer); return 0 }
    child_frame := cast(s64)-1
    child_generation: u64
    child_global := base.global
    if base.frame >= 0 {
        if base.frame >= instance.frames.count ||
            instance.frames[base.frame].generation != base.generation {
            unused ExecFail(instance, .Pointer); return 0
        }
        child_frame = base.frame
        child_generation = base.generation
        child_global = -1
    } else if base.heap != 0 {
        child_generation = base.generation
    }
    return ExecDeriveToken(instance, .{.global = child_global, .frame = child_frame,
        .generation = child_generation, .offset = offset, .extent = extent, .type = target_type,
        .owned = base.owned, .writable = base.writable, .heap = base.heap}, usage)
}

ExecElementAddress :: (instance: *LirExecInstance, parent: s32, index: u64,
    count: u64, target_type: s32, usage: LirExecAddressUse) -> u64 {
    base := instance.addresses[parent]
    size := instance.plan.type_sizes[target_type]
    if base.type != target_type || index >= count ||
        count > cast(u64)9223372036854775807 || size < 0 ||
        size != 0 && count > cast(u64)(base.extent / size) {
        unused ExecFail(instance, .Pointer)
        return 0
    }
    member_offset := cast(s64)index * size
    offset := base.offset + member_offset
    extent := base.extent - member_offset
    return ExecDeriveToken(instance, .{.global = base.global, .frame = base.frame,
        .generation = base.generation, .offset = offset, .extent = extent, .type = target_type,
        .owned = base.owned, .writable = base.writable, .heap = base.heap}, usage)
}

ExecSliceAddress :: (instance: *LirExecInstance, parent: s32, low: u64,
    high: u64, count: u64, target_type: s32, usage: LirExecAddressUse) -> u64 {
    base := instance.addresses[parent]
    size := instance.plan.type_sizes[target_type]
    if base.type != target_type || low > high || high > count ||
        count > cast(u64)9223372036854775807 || size <= 0 ||
        count > cast(u64)(base.extent / size) {
        unused ExecFail(instance, .Pointer)
        return 0
    }
    if low == high { return base.token }
    return ExecElementAddress(instance, parent, low, count, target_type, usage)
}

ExecResizeFrameBytes :: (storage: *Vec(u8), count: s64, available: s64) -> bool #inline {
    if VecResizeBounded(<<storage, count, available) { return true }
    // The allocator may have room for the frame but not for spare capacity.
    return count > storage.capacity && count < available && VecResizeBounded(<<storage, count, count)
}

ExecResizeStorage :: (instance: *LirExecInstance, count: s64) -> bool {
    word_bytes := instance.words.count * 8
    available := instance.limits.value_bytes - instance.plan.global_bytes -
        instance.result_bytes.count - instance.owned.count - word_bytes
    if count < 0 || available < 0 || count > available { return ExecFail(instance, .ValueBytes) }
    if !ExecResizeFrameBytes(*instance.storage, count, available) { return ExecFail(instance, .Allocation) }
    return true
}

ExecResizeWords :: (instance: *LirExecInstance, count: s64) -> bool {
    available := instance.limits.value_bytes - instance.plan.global_bytes -
        instance.result_bytes.count - instance.storage.count - instance.owned.count
    if count < 0 || available < 0 || count > available / 8 {
        return ExecFail(instance, .ValueBytes)
    }
    if !VecResizeBounded(instance.words, count, available / 8) {
        return ExecFail(instance, .Allocation)
    }
    return true
}

ExecPushFrame :: (instance: *LirExecInstance, function_id: s32, caller: s64,
    operands: []s32, return_value: s32, arguments: []LirExecArgument) -> bool {
    if function_id < 0 || function_id >= instance.plan.program.functions.count { return ExecFail(instance, .Calling) }
    function := *instance.plan.program.functions[function_id]
    if operands.count != 0 && arguments.count != 0 ||
        operands.count == 0 && arguments.count != function.parameters.count ||
        operands.count != 0 && operands.count != function.parameters.count { return ExecFail(instance, .Calling) }
    if instance.frames.count >= instance.limits.frames {
        unused ExecFail(instance, .FrameLimit)
        if caller < 0 { ExecInitialLocation(instance, function_id) }
        return false
    }
    if function.values.count > instance.limits.values - instance.live_values {
        unused ExecFail(instance, .ValueLimit)
        if caller < 0 { ExecInitialLocation(instance, function_id) }
        return false
    }
    plan := *instance.plan.functions[function_id]
    base := instance.storage.count
    word_base := instance.words.count
    if !ExecResizeStorage(instance, base + plan.frame_bytes) {
        if caller < 0 { ExecInitialLocation(instance, function_id) }
        return false
    }
    if !ExecResizeWords(instance, word_base + plan.word_count) {
        if caller < 0 { ExecInitialLocation(instance, function_id) }
        return false
    }
    instance.frame_epoch += 1
    frame := LirExecFrame.{.function = function_id, .block = function.entry,
        .return_value = return_value, .base = base, .word_base = word_base,
        .value_base = plan.value_base, .value_types = function.values,
        .instruction_base = cast(s64)instance.plan.block_instruction_bases[plan.block_base + function.entry],
        .generation = instance.frame_epoch}
    if !VecPush(instance.frames, frame) {
        unused ExecFail(instance, .Allocation)
        if caller < 0 { ExecInitialLocation(instance, function_id) }
        return false
    }
    instance.current_value_base = frame.value_base
    instance.current_value_types = function.values
    instance.current_word_base = frame.word_base
    instance.live_values += function.values.count
    frame_index := instance.frames.count - 1
    // The words of constants, null and function addresses hold their values
    // from the start: those instructions have no code (ExecPlanCode).
    for at: plan.constants..plan.constants + plan.constant_count - 1 {
        constant := instance.plan.constant_words[at]
        instance.words[word_base + constant.word] = constant.bits
    }
    entry := *function.blocks[function.entry]
    for index: cast(s64)0..function.parameters.count - 1 {
        destination := entry.parameters[index]
        type_id := function.parameters[index]
        size := instance.plan.type_sizes[type_id]
        if operands.count != 0 {
            source := operands[index]
            if !ExecCopyValue(instance, caller, source, frame_index, destination) { return false }
        } else {
            argument := arguments[index]
            if argument.type != type_id { return ExecFail(instance, .Type) }
            type := instance.plan.program.types[type_id]
            composite := type.kind == .Record || type.kind == .Array
            if composite {
                destination_at := ExecFrameValueOffset(instance, frame_index, destination)
                if argument.bytes.count != size || !ExecSpend(instance, ExecCopyCost(size)) { return false }
                for byte: cast(s64)0..size - 1 { instance.storage[destination_at + byte] = argument.bytes[byte] }
            } else {
                if argument.bytes.count != 0 { return ExecFail(instance, .Type) }
                ExecWriteSlotBits(instance, destination, argument.bits)
                if instance.failure.problem != .None { return false }
            }
        }
    }
    return true
}

ExecPopFrame :: (instance: *LirExecInstance) {
    frame := *instance.frames[instance.frames.count - 1]
    ExecReleaseAddresses(instance, frame.addresses)
    instance.live_values -= instance.plan.program.functions[frame.function].values.count
    unused VecResize(instance.storage, frame.base)
    unused VecResize(instance.words, frame.word_base)
    unused VecPop(instance.frames)
    if instance.frames.count == 0 {
        instance.current_value_base = 0
        empty_types: []s32
        instance.current_value_types = empty_types
        instance.current_word_base = 0
    } else {
        current := instance.frames[instance.frames.count - 1]
        instance.current_value_base = current.value_base
        instance.current_value_types = current.value_types
        instance.current_word_base = current.word_base
    }
}

ExecEdge :: (instance: *LirExecInstance, frame_index: s64,
    edge: *LirEdge, direct_safe: bool) -> bool {
    frame := *instance.frames[frame_index]
    plan := *instance.plan.functions[frame.function]
    target := *instance.plan.program.functions[frame.function].blocks[edge.block]
    if direct_safe {
        for index: cast(s64)0..target.parameters.count - 1 {
            source := edge.arguments[index]
            from := ExecValueLocation(instance.plan, frame.value_base + source)
            to := ExecValueLocation(instance.plan, frame.value_base + target.parameters[index])
            size := instance.plan.type_sizes[frame.value_types[source]]
            cost := ExecCopyCost(size)
            // Spend for both copies in order. A limit can stop between them,
            // even when the argument already occupies the parameter's slot.
            if !ExecSpend(instance, cost) { return false }
            if (from >= 0) != (to >= 0) { return ExecFail(instance, .Type) }
            if from >= 0 {
                if !ExecSpend(instance, cost) { return false }
                if from != to {
                    instance.words[frame.word_base + to] = instance.words[frame.word_base + from]
                }
            } else if !ExecCopyStorage(instance, frame.base + ~from, frame.base + ~to, size) {
                return false
            }
        }
        ExecSetPosition(instance, frame_index, edge.block, 0,
            cast(s64)instance.plan.block_instruction_bases[plan.block_base + edge.block])
        return true
    }
    scratch := frame.base + plan.scratch_offset
    at: s64
    for index: cast(s64)0..edge.arguments.count - 1 {
        source := edge.arguments[index]
        size := ExecValueSize(instance, frame_index, source)
        if !ExecCopyValueToStorage(instance, frame_index, source, scratch + at) { return false }
        at += size
    }
    at = 0
    for index: cast(s64)0..target.parameters.count - 1 {
        destination := target.parameters[index]
        size := ExecValueSize(instance, frame_index, destination)
        if !ExecCopyStorageToValue(instance, scratch + at, frame_index, destination) { return false }
        at += size
    }
    ExecSetPosition(instance, frame_index, edge.block, 0,
        cast(s64)instance.plan.block_instruction_bases[plan.block_base + edge.block])
    return true
}

ExecOperandCount :: (instruction: *LirInstruction) -> s64 #inline { return instruction.operands.count }

ExecOperand :: (instruction: *LirInstruction, index: s64) -> s32 #inline {
    return instruction.operands[index]
}

ExecOperands :: (instruction: *LirInstruction) -> []s32 #inline { return instruction.operands }

ExecInstructionEdge :: (instruction: *LirInstruction, index: s64) -> *LirEdge #inline {
    return *instruction.edges[index]
}

#if #defined(ZIRAN_EXEC_PACKED_INSTRUCTIONS) {
ExecOperandCount :: (instruction: *LirExecPackedInstruction) -> s64 #inline {
    return cast(s64)instruction.operand_count
}

ExecOperand :: (instruction: *LirExecPackedInstruction, index: s64) -> s32 #inline {
    operand := cast(*s32)(cast(usize)instruction.operand_data + cast(usize)index * size_of(s32))
    return operand[0]
}

ExecOperandView :: struct { data: *s32; count: s64 }

ExecOperands :: (instruction: *LirExecPackedInstruction) -> []s32 #inline {
    result: []s32
    view := cast(*ExecOperandView)(*result)
    view.data = instruction.operand_data
    view.count = cast(s64)instruction.operand_count
    return result
}

ExecInstructionEdge :: (instruction: *LirExecPackedInstruction, index: s64) -> *LirEdge #inline {
    return cast(*LirEdge)(cast(usize)instruction.edge_data + cast(usize)index * size_of(LirEdge))
}
}

// Verified integer operands are already canonical frame words. Every entry
// to a word (constants, memory, host values and arithmetic) either checks
// or canonicalizes its bits before other instructions can read it.
ExecIntegerBinary :: (instance: *LirExecInstance, instruction: *$I,
    op: LirOp, left_id: s32, type: *LirType) -> bool {
    left := ExecSlotBits(instance, left_id)
    right := ExecSlotBits(instance, ExecOperand(instruction, 1))
    if instance.failure.problem != .None { return false }
    result: u64
    if op == .Add { result = left + right }
    else if op == .Subtract { result = left - right }
    else if op == .Multiply { result = left * right }
    else if op == .BitAnd { result = left & right }
    else if op == .BitOr { result = left | right }
    else if op == .BitXor { result = left ^ right }
    else if op == .Divide || op == .Remainder {
        if right == 0 { return ExecFail(instance, .DivideByZero) }
        if type.is_signed {
            signed_left := ExecSigned(left, type.bits)
            signed_right := ExecSigned(right, type.bits)
            minimum := cast(u64)1 << cast(u64)(type.bits - 1)
            if left == minimum && signed_right == -1 {
                result = ifx op == .Divide then minimum else 0
            } else if op == .Divide { result = cast(u64)(signed_left / signed_right) }
            else { result = cast(u64)(signed_left % signed_right) }
        } else if op == .Divide { result = left / right }
        else { result = left % right }
    } else if op == .ShiftLeft || op == .ShiftRight {
        count := right
        if count >= cast(u64)type.bits { return ExecFail(instance, .InvalidShift) }
        if op == .ShiftLeft { result = left << count }
        else {
            result = left >> count
            if type.is_signed && count != 0 && (left & (cast(u64)1 << cast(u64)(type.bits - 1))) != 0 {
                mask := instance.plan.type_masks[instance.current_value_types[left_id]]
                result |= mask ^ (mask >> count)
            }
        }
    } else { return ExecFail(instance, .Unsupported) }
    ExecWriteSlotBits(instance, instruction.result, result)
    return true
}

ExecFloatBinary :: (instance: *LirExecInstance, instruction: *$I, single: bool) -> bool {
    left := ExecBitsFloat(instance.plan, ExecSlotBits(instance, ExecOperand(instruction, 0)), single)
    right := ExecBitsFloat(instance.plan, ExecSlotBits(instance, ExecOperand(instruction, 1)), single)
    if instance.failure.problem != .None { return false }
    bits: u64
    if single {
        a := cast(float32)left
        b := cast(float32)right
        value: float32
        if instruction.op == .Add { value = a + b }
        else if instruction.op == .Subtract { value = a - b }
        else if instruction.op == .Multiply { value = a * b }
        else if instruction.op == .Divide { value = a / b }
        else { return ExecFail(instance, .Unsupported) }
        bits = ExecFloat32Bits(value)
    } else {
        value: float64
        if instruction.op == .Add { value = left + right }
        else if instruction.op == .Subtract { value = left - right }
        else if instruction.op == .Multiply { value = left * right }
        else if instruction.op == .Divide { value = left / right }
        else { return ExecFail(instance, .Unsupported) }
        bits = ExecFloat64Bits(value)
    }
    ExecWriteSlotBits(instance, instruction.result, bits)
    return true
}

ExecCompare :: (instance: *LirExecInstance, instruction: *$I, type: *LirType) -> bool {
    left := ExecSlotBits(instance, ExecOperand(instruction, 0))
    right := ExecSlotBits(instance, ExecOperand(instruction, 1))
    if instance.failure.problem != .None { return false }
    answer: bool
    if type.kind == .Float {
        single := type.bits == 32
        a := ExecBitsFloat(instance.plan, left, single)
        b := ExecBitsFloat(instance.plan, right, single)
        if instruction.op == .Equal { answer = a == b }
        if instruction.op == .NotEqual { answer = a != b }
        if instruction.op == .Less { answer = a < b }
        if instruction.op == .LessEqual { answer = a <= b }
        if instruction.op == .Greater { answer = a > b }
        if instruction.op == .GreaterEqual { answer = a >= b }
    } else if type.kind == .Integer && type.is_signed {
        a := ExecSigned(left, type.bits)
        b := ExecSigned(right, type.bits)
        if instruction.op == .Equal { answer = a == b }
        if instruction.op == .NotEqual { answer = a != b }
        if instruction.op == .Less { answer = a < b }
        if instruction.op == .LessEqual { answer = a <= b }
        if instruction.op == .Greater { answer = a > b }
        if instruction.op == .GreaterEqual { answer = a >= b }
    } else {
        if type.kind == .Integer { left &= ExecMask(type.bits); right &= ExecMask(type.bits) }
        if instruction.op == .Equal { answer = left == right }
        if instruction.op == .NotEqual { answer = left != right }
        if instruction.op == .Less { answer = left < right }
        if instruction.op == .LessEqual { answer = left <= right }
        if instruction.op == .Greater { answer = left > right }
        if instruction.op == .GreaterEqual { answer = left >= right }
    }
    ExecWriteSlotBits(instance, instruction.result, cast(u64)answer)
    return true
}

ExecConvert :: (instance: *LirExecInstance, instruction: *$I,
    source: *LirType, destination: *LirType) -> bool {
    bits := ExecSlotBits(instance, ExecOperand(instruction, 0))
    if instance.failure.problem != .None { return false }
    if instruction.op == .Bitcast {
        ExecWriteSlotBits(instance, instruction.result, bits)
        return true
    }
    result: u64
    if source.kind == .Bool && destination.kind == .Integer { result = cast(u64)(bits != 0) }
    else if source.kind == .Integer && destination.kind == .Bool { result = cast(u64)((bits & ExecMask(source.bits)) != 0) }
    else if source.kind == .Integer && destination.kind == .Integer {
        result = bits & ExecMask(source.bits)
        if source.is_signed && source.bits < 64 && (result & (cast(u64)1 << cast(u64)(source.bits - 1))) != 0 {
            result |= ~ExecMask(source.bits)
        }
    } else if source.kind == .Integer && destination.kind == .Float {
        if destination.bits == 32 {
            value := ifx source.is_signed then cast(float32)ExecSigned(bits, source.bits) else cast(float32)(bits & ExecMask(source.bits))
            result = ExecFloat32Bits(value)
        } else {
            value := ifx source.is_signed then cast(float64)ExecSigned(bits, source.bits) else cast(float64)(bits & ExecMask(source.bits))
            result = ExecFloat64Bits(value)
        }
    } else if source.kind == .Float && destination.kind == .Float {
        value := ExecBitsFloat(instance.plan, bits, source.bits == 32)
        result = ifx destination.bits == 32 then ExecFloat32Bits(cast(float32)value) else ExecFloat64Bits(value)
    } else if source.kind == .Float && destination.kind == .Integer {
        value := ExecBitsFloat(instance.plan, bits, source.bits == 32)
        if !Finite64(value) { return ExecFail(instance, .InvalidConversion) }
        if destination.is_signed {
            bound := ScaleByPowerOfTwo(1.0, destination.bits - 1)
            if value < 0.0 - bound || value >= bound { return ExecFail(instance, .InvalidConversion) }
            result = cast(u64)cast(s64)value
        } else {
            bound := ScaleByPowerOfTwo(1.0, destination.bits)
            if value < 0.0 || value >= bound { return ExecFail(instance, .InvalidConversion) }
            result = cast(u64)value
        }
    } else { return ExecFail(instance, .Unsupported) }
    ExecWriteSlotBits(instance, instruction.result, result)
    return true
}

ExecAggregate :: (instance: *LirExecInstance, frame_index: s64, instruction: *$I) -> bool {
    destination := ExecFrameValueOffset(instance, frame_index, instruction.result)
    at: s64
    for operand: ExecOperands(instruction) {
        size := ExecValueSize(instance, frame_index, operand)
        if !ExecCopyValueToStorage(instance, frame_index, operand, destination + at) { return false }
        at += size
    }
    return true
}

ExecExtractInsert :: (instance: *LirExecInstance, frame_index: s64, instruction: *$I) -> bool {
    frame := instance.frames[frame_index]
    function := instance.plan.program.functions[frame.function]
    aggregate := ExecOperand(instruction, 0)
    aggregate_type := function.values[aggregate]
    offset: s64
    member_type: s32
    member := instruction.immediate
    expected := ifx instruction.op == .Extract then 1 else 2
    if ExecOperandCount(instruction) == expected + 1 {
        member = ExecIndexBits(instance, ExecOperand(instruction, expected))
        if instance.failure.problem != .None { return false }
    }
    if !ExecMember(instance, aggregate_type, member, *offset, *member_type) { return false }
    if instruction.op == .Extract {
        if !ExecCopyStorageToValue(instance,
            ExecFrameValueOffset(instance, frame_index, aggregate) + offset,
            frame_index, instruction.result) { return false }
    } else {
        if !ExecCopySlot(instance, frame_index, aggregate, instruction.result) { return false }
        replacement := ExecOperand(instruction, 1)
        if !ExecCopyValueToStorage(instance, frame_index, replacement,
            ExecFrameValueOffset(instance, frame_index, instruction.result) + offset) { return false }
    }
    return true
}

ExecFinishFrame :: (instance: *LirExecInstance, frame_index: s64, instruction: *$I) -> bool {
    frame := instance.frames[frame_index]
    function := instance.plan.program.functions[frame.function]
    result_type := function.result
    result_size := instance.plan.type_sizes[result_type]
    if frame_index == 0 {
        available := instance.limits.value_bytes - instance.plan.global_bytes -
            instance.storage.count - instance.words.count * 8 - instance.owned.count
        if result_size > available { return ExecFail(instance, .ValueBytes) }
        if !VecResizeBounded(instance.result_bytes, result_size,
            instance.limits.value_bytes - instance.plan.global_bytes) { return ExecFail(instance, .Allocation) }
        bits: u64
        if result_size != 0 {
            source := ExecOperand(instruction, 0)
            if !ExecSpend(instance, ExecCopyCost(result_size)) { return false }
            type := instance.plan.program.types[result_type]
            if type.kind == .Record || type.kind == .Array {
                source_at := ExecFrameValueOffset(instance, frame_index, source)
                for index: cast(s64)0..result_size - 1 {
                    instance.result_bytes[index] = instance.storage[source_at + index]
                }
            } else {
                bits = instance.words[ExecFrameValueWord(instance, frame_index, source)]
                ExecWriteBits(instance.result_bytes[:], 0, result_size, bits)
            }
        }
        instance.result_value = .{.type = result_type, .bits = bits, .bytes = result_size}
        ExecPopFrame(instance)
        return true
    }
    caller := frame_index - 1
    if result_size != 0 {
        if frame.return_value == LirNoId { return ExecFail(instance, .Calling) }
        if !ExecCopyValue(instance, frame_index, ExecOperand(instruction, 0),
            caller, frame.return_value) { return false }
    } else if frame.return_value != LirNoId {
        // A zero-sized result, such as [0]s32, has no bytes to copy; only a
        // void procedure cannot fill the caller's result.
        if instance.plan.program.types[result_type].kind == .Void { return ExecFail(instance, .Calling) }
    }
    ExecPopFrame(instance)
    return true
}

ExecCallInstruction :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *$I) -> bool {
    target := instruction.symbol
    skip: s64
    if instruction.op == .CallIndirect {
        bits := ExecSlotBits(instance, ExecOperand(instruction, 0))
        if instance.failure.problem != .None || bits == 0 ||
            bits > cast(u64)instance.plan.program.functions.count { return ExecFail(instance, .Calling) }
        target = cast(s32)(bits - 1)
        skip = 1
        signature := ExecValueType(instance, ExecOperand(instruction, 0))
        actual := instance.plan.program.functions[target]
        if signature.result != actual.result || signature.parameters.count != actual.parameters.count {
            return ExecFail(instance, .Calling)
        }
        for index: cast(s64)0..signature.parameters.count - 1 {
            if signature.parameters[index] != actual.parameters[index] { return ExecFail(instance, .Calling) }
        }
    }
    arguments := ExecOperands(instruction)[skip:]
    no_arguments: [0]LirExecArgument
    if !ExecPushFrame(instance, target, frame_index, arguments, instruction.result, no_arguments[:]) { return false }
    instance.frames[frame_index].instruction += 1
    return true
}

ExecAddressValid :: (instance: *LirExecInstance, address_index: s64) -> bool {
    address := instance.addresses[address_index]
    if address.owned {
        if address.heap != 0 {
            block := instance.heap_blocks[address.heap - 1]
            if !block.live || block.generation != address.generation { return false }
        }
        return address.offset >= 0 && address.extent >= 0 &&
            address.offset <= instance.owned.count && address.extent <= instance.owned.count - address.offset
    }
    if address.frame < 0 { return true }
    return address.frame < instance.frames.count &&
        instance.frames[address.frame].generation == address.generation
}

ExecAddressOffset :: (instance: *LirExecInstance, address_index: s64) -> s64 {
    if !ExecAddressValid(instance, address_index) { unused ExecFail(instance, .Pointer); return -1 }
    address := instance.addresses[address_index]
    if address.owned { return address.offset }
    if address.frame < 0 { return address.offset }
    return instance.frames[address.frame].base + address.offset
}

// Global addresses retain their position in the packed logical layout for
// alias checks. Each global's backing bytes start at its own offset zero.
ExecGlobalOffset :: (instance: *LirExecInstance, global: s32, at: s64) -> s64 #inline {
    return at - instance.plan.global_offsets[global]
}

ExecGlobalBytes :: (data: *LirExecGlobalData) -> []u8 #inline {
    if data.constant.count != 0 { return data.constant }
    return data.bytes[:]
}

// Use after validating the address and the requested extent.
ExecAddressTail :: (instance: *LirExecInstance, address: LirExecAddress, at: s64) -> []u8 #inline {
    if address.owned { return instance.owned[at:] }
    if address.frame >= 0 { return instance.storage[at:] }
    local := ExecGlobalOffset(instance, address.global, at)
    bytes := ExecGlobalBytes(*instance.globals[address.global])
    return bytes[local:]
}

#if TARGET == .C {
    ExecLibC :: #system_library "libc";
    ExecCopyDisjointBytes :: (destination: *void, source: *void, count: usize) -> *void #foreign ExecLibC "memcpy";
}

ExecCopyAddressToValue :: (instance: *LirExecInstance, address_index: s64,
    frame_index: s64, destination: s32) -> bool {
    source := ExecAddressOffset(instance, address_index)
    if instance.failure.problem != .None || source < 0 { return false }
    address := instance.addresses[address_index]
    size := ExecValueSize(instance, frame_index, destination)
    if size < 0 || size > instance.addresses[address_index].extent { return ExecFail(instance, .Pointer) }
    if !ExecSpend(instance, ExecCopyCost(size)) { return false }
    if ExecValueIsWord(instance, frame_index, destination) {
        bits := ExecReadBits(ExecAddressTail(instance, address, source), 0, size)
        ExecWriteSlotBits(instance, destination, bits)
        return instance.failure.problem == .None
    }
    destination_at := ExecFrameValueOffset(instance, frame_index, destination)
    bytes := ExecAddressTail(instance, address, source)
    storage := instance.storage[:]
    #if TARGET == .C {
        // Owned and global bytes have separate backing storage. For a frame
        // address, the ranges must be disjoint before handing them to memcpy.
        if size >= 32 && size <= bytes.count && size <= storage.count - destination_at &&
            (address.owned || address.frame < 0 ||
                source <= destination_at - size || destination_at <= source - size) {
            unused ExecCopyDisjointBytes(cast(*void)*storage[destination_at],
                cast(*void)*bytes[0], cast(usize)size)
            return true
        }
    }
    for index: cast(s64)0..size - 1 { storage[destination_at + index] = bytes[index] }
    return true
}

ExecCopyValueToAddress :: (instance: *LirExecInstance, frame_index: s64,
    source: s32, address_index: s64) -> bool {
    destination := ExecAddressOffset(instance, address_index)
    if instance.failure.problem != .None || destination < 0 { return false }
    address := instance.addresses[address_index]
    if !address.writable { return ExecFail(instance, .Pointer) }
    size := ExecValueSize(instance, frame_index, source)
    if size < 0 || size > instance.addresses[address_index].extent { return ExecFail(instance, .Pointer) }
    if !ExecSpend(instance, ExecCopyCost(size)) { return false }
    bytes := ExecAddressTail(instance, address, destination)
    if ExecValueIsWord(instance, frame_index, source) {
        bits := instance.words[ExecFrameValueWord(instance, frame_index, source)]
        ExecWriteBits(bytes, 0, size, bits)
        return true
    }
    source_at := ExecFrameValueOffset(instance, frame_index, source)
    for index: cast(s64)0..size - 1 { bytes[index] = instance.storage[source_at + index] }
    return true
}

ExecAllocate :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *$I, result_type: s32) -> bool {
    pointee := instance.plan.program.types[result_type].element
    size := instance.plan.type_sizes[pointee]
    base := instance.storage.count
    if !ExecResizeStorage(instance, base + size) { return false }
    index := ExecNewAddress(instance, .{.global = -1, .frame = frame_index,
        .generation = instance.frames[frame_index].generation,
        .offset = base - instance.frames[frame_index].base, .extent = size, .type = pointee,
        .writable = true})
    if index < 0 { return false }
    address := instance.addresses[index]
    if ExecOperandCount(instruction) != 0 {
        value := ExecOperand(instruction, 0)
        if instance.current_value_types[value] != pointee {
            return ExecFail(instance, .Type)
        }
        if !ExecCopyValueToStorage(instance, frame_index, value, base) { return false }
    }
    ExecWriteSlotBits(instance, instruction.result, address.token)
    return true
}

// Acquire a record before growing or splitting storage.
ExecHeapRecord :: (instance: *LirExecInstance) -> s64 {
    if instance.heap_spare != 0 {
        index := instance.heap_spare - 1
        instance.heap_spare = instance.heap_blocks[index].next_free
        instance.heap_blocks[index] = .{}
        return index
    }
    index := instance.heap_blocks.count
    if !VecPush(instance.heap_blocks, LirExecHeapBlock.{}) { return -1 }
    return index
}

ExecHeapRecycle :: (instance: *LirExecInstance, index: s64) {
    instance.heap_blocks[index] = .{.next_free = instance.heap_spare}
    instance.heap_spare = index + 1
}

ExecHeapLink :: (instance: *LirExecInstance, index: s64, below: s64, above: s64) {
    instance.heap_blocks[index].below = below
    instance.heap_blocks[index].above = above
    if below != 0 { instance.heap_blocks[below - 1].above = index + 1 }
    if above != 0 { instance.heap_blocks[above - 1].below = index + 1 }
    else { instance.heap_tail = index + 1 }
}

ExecHeapUnlink :: (instance: *LirExecInstance, index: s64) {
    block := instance.heap_blocks[index]
    if block.below != 0 { instance.heap_blocks[block.below - 1].above = block.above }
    if block.above != 0 { instance.heap_blocks[block.above - 1].below = block.below }
    else { instance.heap_tail = block.below }
}

ExecHeapListHole :: (instance: *LirExecInstance, index: s64) {
    head := instance.heap_free
    instance.heap_blocks[index].previous_free = 0
    instance.heap_blocks[index].next_free = head
    if head != 0 { instance.heap_blocks[head - 1].previous_free = index + 1 }
    instance.heap_free = index + 1
}

ExecHeapUnlistHole :: (instance: *LirExecInstance, index: s64) {
    block := instance.heap_blocks[index]
    if block.previous_free != 0 { instance.heap_blocks[block.previous_free - 1].next_free = block.next_free }
    else { instance.heap_free = block.next_free }
    if block.next_free != 0 { instance.heap_blocks[block.next_free - 1].previous_free = block.previous_free }
    instance.heap_blocks[index].previous_free = 0
    instance.heap_blocks[index].next_free = 0
}

// Split a positive range, keeping its first BYTES bytes and giving the
// remainder a new record. The caller assigns the remainder's lifetime.
ExecHeapSplit :: (instance: *LirExecInstance, index: s64, bytes: s64) -> s64 {
    rest := ExecHeapRecord(instance)
    if rest < 0 { return -1 }
    block := instance.heap_blocks[index]
    instance.heap_blocks[rest] = .{.offset = block.offset + bytes, .size = block.size - bytes}
    instance.heap_blocks[index].size = bytes
    ExecHeapLink(instance, rest, index + 1, block.above)
    return rest
}

// End this block's generation and merge with both adjacent holes. No live
// range moves. A hole reaching the end of storage is immediately trimmed.
ExecHeapRelease :: (instance: *LirExecInstance, index: s64) {
    block := instance.heap_blocks[index]
    ExecReleaseAddresses(instance, block.addresses)
    if block.size == 0 { ExecHeapRecycle(instance, index); return }
    instance.heap_blocks[index].addresses = 0
    instance.heap_blocks[index].live = false
    instance.heap_blocks[index].host = false
    if block.below != 0 && !instance.heap_blocks[block.below - 1].live {
        below := block.below - 1
        ExecHeapUnlistHole(instance, below)
        instance.heap_blocks[index].offset = instance.heap_blocks[below].offset
        instance.heap_blocks[index].size += instance.heap_blocks[below].size
        ExecHeapUnlink(instance, below)
        ExecHeapRecycle(instance, below)
    }
    if block.above != 0 && !instance.heap_blocks[block.above - 1].live {
        above := block.above - 1
        ExecHeapUnlistHole(instance, above)
        instance.heap_blocks[index].size += instance.heap_blocks[above].size
        ExecHeapUnlink(instance, above)
        ExecHeapRecycle(instance, above)
    }
    if instance.heap_tail == index + 1 {
        unused VecResize(instance.owned, instance.heap_blocks[index].offset)
        ExecHeapUnlink(instance, index)
        ExecHeapRecycle(instance, index)
    } else {
        ExecHeapListHole(instance, index)
    }
}

ExecHeapNoRoom :: -2;

ExecResizeOwned :: (instance: *LirExecInstance, count: s64, available: s64) -> bool {
    ceiling := ExecGrowthCeiling(count, instance.owned.capacity, available, 65536)
    return ExecResizeFrameBytes(*instance.owned, count, ceiling)
}

// A range for a program or host allocation. Check the existing holes
// before growing the owned byte vector, and meter the free-list search.
ExecHeapTake :: (instance: *LirExecInstance, bytes: s64, available: s64) -> s64 {
    if available < bytes { return ExecHeapNoRoom }
    if bytes != 0 {
        at := instance.heap_free
        while at != 0 {
            if !ExecSpend(instance, 1) { return -1 }
            index := at - 1
            block := instance.heap_blocks[index]
            if block.size >= bytes {
                rest: s64 = -1
                if block.size > bytes {
                    rest = ExecHeapSplit(instance, index, bytes)
                    if rest < 0 { return -1 }
                }
                ExecHeapUnlistHole(instance, index)
                if rest >= 0 { ExecHeapListHole(instance, rest) }
                instance.heap_blocks[index].live = true
                return index
            }
            at = block.next_free
        }
    }
    base := instance.owned.count
    if bytes > available - base { return ExecHeapNoRoom }
    index := ExecHeapRecord(instance)
    if index < 0 { return -1 }
    if bytes != 0 {
        if !ExecResizeOwned(instance, base + bytes, available) {
            ExecHeapRecycle(instance, index)
            return -1
        }
        instance.heap_blocks[index].offset = base
        instance.heap_blocks[index].size = bytes
        ExecHeapLink(instance, index, instance.heap_tail, 0)
    }
    instance.heap_blocks[index].live = true
    return index
}

// A read-only block of BYTES owned bytes for a value a host gave, and the
// index of its address, or -1 after a failure.
ExecHostBlock :: (instance: *LirExecInstance, bytes: s64, element: s32) -> s64 {
    available := instance.limits.value_bytes - instance.plan.global_bytes - instance.storage.count -
        instance.words.count * 8 - instance.result_bytes.count
    record := ExecHeapTake(instance, bytes, available)
    if record < 0 {
        unused ExecFail(instance, ifx record == ExecHeapNoRoom then .ValueBytes else .Allocation)
        return -1
    }
    instance.host_since += bytes
    instance.heap_epoch += 1
    instance.heap_blocks[record].count = cast(u64)bytes
    instance.heap_blocks[record].generation = instance.heap_epoch
    instance.heap_blocks[record].live = true
    instance.heap_blocks[record].host = true
    return ExecNewAddress(instance, .{.global = -1, .frame = -1, .generation = instance.heap_epoch,
        .offset = instance.heap_blocks[record].offset, .extent = bytes, .type = element, .owned = true, .writable = false,
        .heap = record + 1})
}

// Ends every host block made after EPOCH: a rejected image leaves no
// storage behind.
ExecHostRollback :: (instance: *LirExecInstance, epoch: u64) {
    for index: cast(s64)0..instance.heap_blocks.count - 1 {
        block := instance.heap_blocks[index]
        if block.live && block.host && block.generation > epoch { ExecHeapRelease(instance, index) }
    }
}

// Marks the live host block that TOKEN names, if any, to be scanned.
ExecHostMarkToken :: (instance: *LirExecInstance, token: u64, marks: *Vec(u8), pending: *Vec(s64)) -> bool {
    found := ExecFindAddress(instance, token)
    if found < 0 || instance.addresses[found].heap == 0 { return true }
    block := instance.addresses[found].heap - 1
    if !instance.heap_blocks[block].live || !instance.heap_blocks[block].host || (<<marks)[block] != 0 { return true }
    (<<marks)[block] = 1
    return VecPush(<<pending, block) || ExecFail(instance, .Allocation)
}

// Every eight bytes that could be a token, at any offset since values are packed.
ExecHostMarkRange :: (instance: *LirExecInstance, bytes: []u8, from: s64, count: s64,
    marks: *Vec(u8), pending: *Vec(s64)) -> bool {
    low := cast(u8)(instance.identity & cast(u32)255)
    high := cast(u8)((instance.identity >> cast(u32)8) & cast(u32)255)
    for at: from..from + count - 8 {
        if bytes[at + 7] != high || bytes[at + 6] != low { continue }
        if !ExecHostMarkToken(instance, ExecReadBits(bytes, at, 8), marks, pending) { return false }
    }
    return true
}

ExecHostMarkBytes :: (instance: *LirExecInstance, bytes: []u8, from: s64, count: s64,
    marks: *Vec(u8), pending: *Vec(s64)) -> bool {
    if count < 8 { return true }
    return ExecSpend(instance, ExecCopyCost(count)) && ExecHostMarkRange(instance, bytes, from, count, marks, pending)
}

// Scan globals as one logical range, including token-shaped bytes that cross
// backing boundaries. Charge the same single scan as for a contiguous range.
ExecHostMarkGlobals :: (instance: *LirExecInstance, marks: *Vec(u8), pending: *Vec(s64)) -> bool {
    count := instance.plan.global_bytes
    if count < 8 { return true }
    if !ExecSpend(instance, ExecCopyCost(count)) { return false }
    boundary: [14]u8
    tail: s64
    for index: cast(s64)0..instance.globals.count - 1 {
        data := *instance.globals[index]
        size := instance.plan.type_sizes[instance.plan.program.globals[index].type]
        prefix := ifx size < 7 then size else 7
        if prefix != 0 {
            bytes := ExecGlobalBytes(data)
            for at: cast(s64)0..prefix - 1 { boundary[tail + at] = bytes[at] }
        }
        assembled := tail + prefix
        if !ExecHostMarkRange(instance, boundary[:], 0, assembled, marks, pending) ||
            !ExecHostMarkRange(instance, ExecGlobalBytes(data), 0, size, marks, pending) { return false }
        if size >= 7 {
            tail = 7
            bytes := ExecGlobalBytes(data)
            for at: cast(s64)0..6 { boundary[at] = bytes[size - 7 + at] }
        } else {
            tail = ifx assembled < 7 then assembled else 7
            for at: cast(s64)0..tail - 1 { boundary[at] = boundary[assembled - tail + at] }
        }
    }
    return true
}

// Gives back the host blocks the program can no longer reach. It reaches
// the globals, the frames' storage and words, the result bytes and its own
// heap blocks, and every host block those name. A name is any eight bytes
// equal to a valid token of a block's address, so a reachable block is
// never freed; bytes that only look like a token keep a block a little
// longer. The allocator reclaims dead host blocks just like program blocks.
ExecHostCollect :: (instance: *LirExecInstance) -> bool {
    count := instance.heap_blocks.count
    marks: Vec(u8)
    pending: Vec(s64)
    defer VecFree(marks)
    defer VecFree(pending)
    if !VecResize(marks, count) { return ExecFail(instance, .Allocation) }
    scanned := instance.plan.global_bytes + instance.storage.count + instance.result_bytes.count + instance.words.count * 8
    if !ExecHostMarkGlobals(instance, *marks, *pending) ||
        !ExecHostMarkBytes(instance, instance.storage[:], 0, instance.storage.count, *marks, *pending) ||
        !ExecHostMarkBytes(instance, instance.result_bytes[:], 0, instance.result_bytes.count, *marks, *pending) { return false }
    if !ExecSpend(instance, instance.words.count) { return false }
    for word: instance.words {
        if !ExecHostMarkToken(instance, word, *marks, *pending) { return false }
    }
    for index: cast(s64)0..count - 1 {
        block := instance.heap_blocks[index]
        if !block.live || block.host { continue }
        scanned += block.size
        if !ExecHostMarkBytes(instance, instance.owned[:], block.offset, block.size, *marks, *pending) { return false }
    }
    while pending.count > 0 {
        block := instance.heap_blocks[pending[pending.count - 1]]
        unused VecResize(pending, pending.count - 1)
        scanned += block.size
        if !ExecHostMarkBytes(instance, instance.owned[:], block.offset, block.size, *marks, *pending) { return false }
    }
    for index: cast(s64)0..count - 1 {
        block := instance.heap_blocks[index]
        if block.live && block.host && marks[index] == 0 { ExecHeapRelease(instance, index) }
    }
    instance.host_since = 0
    instance.host_scanned = scanned
    return true
}

// Use the previous hole when growing forward would require a new arena
// allocation. Only the block being resized moves, and its old aliases are
// retired by ExecResize before it returns.
ExecHeapGrowIntoPrevious :: (instance: *LirExecInstance, index: s64, bytes: s64, available: s64) -> bool {
    block := instance.heap_blocks[index]
    below := block.below - 1
    if below < 0 || instance.heap_blocks[below].live { return false }
    above := block.above - 1
    forward: s64
    if above < 0 {
        end := instance.owned.count
        capacity := instance.owned.capacity
        if capacity > available { capacity = available }
        if capacity > end { forward = capacity - end }
    } else if !instance.heap_blocks[above].live {
        forward = instance.heap_blocks[above].size
    }
    back := bytes - block.size - forward
    hole := *instance.heap_blocks[below]
    if back <= 0 || back > hole.size { return false }
    if above < 0 && forward != 0 &&
       !VecResize(instance.owned, instance.owned.count + forward) { return false }

    // Move downwards in increasing byte order, allowing overlap.
    base := block.offset - back
    for at: cast(s64)0..block.size - 1 { instance.owned[base + at] = instance.owned[block.offset + at] }
    if back == hole.size {
        ExecHeapUnlistHole(instance, below)
        ExecHeapUnlink(instance, below)
        ExecHeapRecycle(instance, below)
    } else { hole.size -= back }
    if above >= 0 && forward != 0 {
        ExecHeapUnlistHole(instance, above)
        ExecHeapUnlink(instance, above)
        ExecHeapRecycle(instance, above)
    }
    instance.heap_blocks[index].offset = base
    instance.heap_blocks[index].size = bytes
    return true
}

// Grow into the following hole or the end of the arena. Shrinking gives
// the excess bytes back even if another live block sits above this one.
ExecHeapResizeInPlace :: (instance: *LirExecInstance, index: s64, bytes: s64, available: s64) -> bool {
    block := instance.heap_blocks[index]
    if bytes == block.size { return true }
    if bytes > block.size && ExecHeapGrowIntoPrevious(instance, index, bytes, available) { return true }
    if instance.heap_tail == index + 1 {
        if bytes > available - block.offset ||
            !ExecResizeOwned(instance, block.offset + bytes, available) { return false }
        instance.heap_blocks[index].size = bytes
        return true
    }
    if bytes < block.size {
        rest := ExecHeapSplit(instance, index, bytes)
        if rest < 0 { return false }
        ExecHeapRelease(instance, rest)
        return true
    }
    above := block.above - 1
    if above < 0 || instance.heap_blocks[above].live { return false }
    extra := bytes - block.size
    hole := instance.heap_blocks[above]
    if hole.size < extra { return false }
    if hole.size == extra {
        ExecHeapUnlistHole(instance, above)
        ExecHeapUnlink(instance, above)
        ExecHeapRecycle(instance, above)
    } else {
        instance.heap_blocks[above].offset += extra
        instance.heap_blocks[above].size -= extra
    }
    instance.heap_blocks[index].size = bytes
    return true
}

// resize(pointer: *T, old_count, new_count) -> *T. A null pointer with
// old_count 0 allocates; new_count 0 frees and gives null. The new block
// keeps the first min(old_count, new_count) elements and zero-fills the
// rest. When the value-byte budget cannot hold the request the result is
// null and the old block stays valid. Only a block's own base pointer,
// with its exact element count, may be resized or freed.
ExecResize :: (instance: *LirExecInstance, instruction: *$I, result_type: s32) -> bool {
    token := ExecSlotBits(instance, ExecOperand(instruction, 0))
    old_count := ExecIndexBits(instance, ExecOperand(instruction, 1))
    new_count := ExecIndexBits(instance, ExecOperand(instruction, 2))
    if instance.failure.problem != .None { return false }
    element := instance.plan.program.types[result_type].element
    size := instance.plan.type_sizes[element]
    if size < 0 { return ExecFail(instance, .Type) }
    previous: s64 = -1
    if token == 0 {
        if old_count != 0 { return ExecFail(instance, .Pointer) }
    } else {
        found := ExecFindAddress(instance, token)
        if found < 0 || !ExecAddressValid(instance, found) { return ExecFail(instance, .Pointer) }
        address := instance.addresses[found]
        if address.heap == 0 || address.type != element || !address.writable { return ExecFail(instance, .Pointer) }
        previous = address.heap - 1
        block := instance.heap_blocks[previous]
        if block.host || address.offset != block.offset || address.extent != block.size ||
            old_count != block.count { return ExecFail(instance, .Pointer) }
    }
    if new_count == 0 {
        if previous >= 0 { ExecHeapRelease(instance, previous) }
        ExecWriteSlotBits(instance, instruction.result, 0)
        return true
    }
    available := instance.limits.value_bytes - instance.plan.global_bytes - instance.storage.count -
        instance.words.count * 8 - instance.result_bytes.count
    if available < 0 || new_count > cast(u64)9223372036854775807 ||
        size != 0 && new_count > cast(u64)(available / size) {
        ExecWriteSlotBits(instance, instruction.result, 0)
        return true
    }
    bytes := cast(s64)new_count * size
    if !ExecSpend(instance, ExecCopyCost(bytes)) { return false }
    record := previous
    kept: s64
    source: s64
    if previous >= 0 {
        block := instance.heap_blocks[previous]
        kept = ifx block.size < bytes then block.size else bytes
        source = block.offset
    }
    if previous < 0 || !ExecHeapResizeInPlace(instance, previous, bytes, available) {
        record = ExecHeapTake(instance, bytes, available)
        if record < 0 {
            if instance.failure.problem != .None { return false }
            ExecWriteSlotBits(instance, instruction.result, 0)
            return true
        }
    }
    base := instance.heap_blocks[record].offset
    if previous >= 0 && record != previous {
        for index: cast(s64)0..kept - 1 { instance.owned[base + index] = instance.owned[source + index] }
        ExecHeapRelease(instance, previous)
    } else if previous >= 0 {
        ExecReleaseAddresses(instance, instance.heap_blocks[previous].addresses)
        instance.heap_blocks[previous].addresses = 0
    }
    for index: kept..bytes - 1 { instance.owned[base + index] = 0 }
    instance.heap_epoch += 1
    instance.heap_blocks[record].count = new_count
    instance.heap_blocks[record].generation = instance.heap_epoch
    instance.heap_blocks[record].live = true
    index := ExecNewAddress(instance, .{.global = -1, .frame = -1, .generation = instance.heap_epoch,
        .offset = base, .extent = bytes, .type = element, .owned = true, .writable = true,
        .heap = record + 1})
    if index < 0 { ExecHeapRelease(instance, record); return false }
    address := instance.addresses[index]
    ExecWriteSlotBits(instance, instruction.result, address.token)
    return true
}

ExecMemoryInstruction :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *$I, result_type: s32) -> bool {
    if instruction.op == .FieldAddress || instruction.op == .ElementAddress {
        token := ExecSlotBits(instance, ExecOperand(instruction, 0))
        low: u64
        high: u64
        count: u64
        if instruction.op == .ElementAddress && ExecOperandCount(instruction) == 4 {
            low = ExecIndexBits(instance, ExecOperand(instruction, 1))
            high = ExecIndexBits(instance, ExecOperand(instruction, 2))
            count = ExecIndexBits(instance, ExecOperand(instruction, 3))
            if instance.failure.problem != .None { return false }
            if token == 0 {
                if low != 0 || high != 0 || count != 0 { return ExecFail(instance, .Pointer) }
                ExecWriteSlotBits(instance, instruction.result, 0)
                return true
            }
        }
        address := ExecFindAddress(instance, token)
        if address < 0 { return ExecFail(instance, .Pointer) }
        expected := ExecValueType(instance, ExecOperand(instruction, 0)).element
        if instance.addresses[address].type != expected { return ExecFail(instance, .Type) }
        target := instance.plan.program.types[result_type].element
        member := instruction.immediate
        lifetime := instance.plan.transient[instance.frames[frame_index].instruction_base +
            instance.frames[frame_index].instruction]
        usage := LirExecAddressUse.{.lifetime = lifetime, .frame = frame_index}
        if lifetime == ExecTransientFrame { usage.previous = ExecSlotBits(instance, instruction.result) }
        child: u64
        if instruction.op == .ElementAddress && ExecOperandCount(instruction) == 4 {
            child = ExecSliceAddress(instance, address, low, high, count, target, usage)
        } else if instruction.op == .ElementAddress && ExecOperandCount(instruction) == 3 {
            index := ExecIndexBits(instance, ExecOperand(instruction, 1))
            count := ExecIndexBits(instance, ExecOperand(instruction, 2))
            if instance.failure.problem != .None { return false }
            child = ExecElementAddress(instance, address, index, count, target, usage)
        } else {
            if instruction.op == .ElementAddress {
                member = ExecIndexBits(instance, ExecOperand(instruction, 1))
                if instance.failure.problem != .None { return false }
            }
            child = ExecFieldAddress(instance, address, member, target, usage)
        }
        if instance.failure.problem != .None { return false }
        ExecWriteSlotBits(instance, instruction.result, child)
        return true
    }
    token := ExecSlotBits(instance, ExecOperand(instruction, 0))
    address_index := ExecFindAddress(instance, token)
    if address_index < 0 { return ExecFail(instance, .Pointer) }
    if instruction.op == .Load {
        if instance.addresses[address_index].type != result_type { return ExecFail(instance, .Type) }
        return ExecCopyAddressToValue(instance, address_index, frame_index, instruction.result)
    }
    value := ExecOperand(instruction, 1)
    if instance.current_value_types[value] !=
        instance.addresses[address_index].type {
        return ExecFail(instance, .Type)
    }
    // Read-only globals hold string literal bytes; no address can write them.
    if !instance.addresses[address_index].writable { return ExecFail(instance, .Pointer) }
    return ExecCopyValueToAddress(instance, frame_index, value, address_index)
}

ExecBytesMatchAcross :: (left: []u8, left_at: s64, right: []u8,
    right_at: s64, count: s64) -> bool {
    for index: cast(s64)0..count - 1 {
        if left[left_at + index] != right[right_at + index] { return false }
    }
    return true
}

ExecBytesEqual :: (instance: *LirExecInstance, instruction: *$I) -> bool {
    left_token := ExecSlotBits(instance, ExecOperand(instruction, 0))
    left_count := ExecIndexBits(instance, ExecOperand(instruction, 1))
    right_token := ExecSlotBits(instance, ExecOperand(instruction, 2))
    right_count := ExecIndexBits(instance, ExecOperand(instruction, 3))
    if instance.failure.problem != .None || left_count > cast(u64)9223372036854775807 ||
        right_count > cast(u64)9223372036854775807 { return ExecFail(instance, .Pointer) }
    left_address: s64 = -1
    right_address: s64 = -1
    if left_token != 0 { left_address = ExecFindAddress(instance, left_token) }
    if right_token != 0 { right_address = ExecFindAddress(instance, right_token) }
    if (left_token != 0 && left_address < 0) || (right_token != 0 && right_address < 0) ||
        (left_token == 0 && left_count != 0) || (right_token == 0 && right_count != 0) {
        return ExecFail(instance, .Pointer)
    }
    left_pointer := ExecValueType(instance, ExecOperand(instruction, 0))
    right_pointer := ExecValueType(instance, ExecOperand(instruction, 2))
    if (left_address >= 0 && instance.addresses[left_address].type != left_pointer.element) ||
        (right_address >= 0 && instance.addresses[right_address].type != right_pointer.element) {
        return ExecFail(instance, .Type)
    }
    if (left_address >= 0 && instance.addresses[left_address].extent < cast(s64)left_count) ||
        (right_address >= 0 && instance.addresses[right_address].extent < cast(s64)right_count) {
        return ExecFail(instance, .Pointer)
    }
    if left_count != right_count {
        ExecWriteSlotBits(instance, instruction.result, 0)
        return true
    }
    if left_count == 0 {
        ExecWriteSlotBits(instance, instruction.result, 1)
        return true
    }
    left_at := ExecAddressOffset(instance, left_address)
    right_at := ExecAddressOffset(instance, right_address)
    if instance.failure.problem != .None { return false }
    if !ExecSpend(instance, ExecCopyCost(cast(s64)left_count)) { return false }
    equal := ExecBytesMatchAcross(ExecAddressTail(instance, instance.addresses[left_address], left_at), 0,
        ExecAddressTail(instance, instance.addresses[right_address], right_at), 0, cast(s64)left_count)
    ExecWriteSlotBits(instance, instruction.result, cast(u64)equal)
    return true
}

ExecUnaryInstruction :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *$I) -> bool {
    source_type := ExecValueType(instance, ExecOperand(instruction, 0))
    bits := ExecSlotBits(instance, ExecOperand(instruction, 0))
    if instance.failure.problem != .None { return false }
    if instruction.op == .SquareRoot {
        ExecWriteSlotBits(instance, instruction.result,
            ExecFloat64Bits(Math.Sqrt(ExecBitsFloat(instance.plan, bits, false))))
    } else if source_type.kind == .Integer {
        ExecWriteSlotBits(instance, instruction.result,
            ifx instruction.op == .Negate then cast(u64)0 - bits else ~bits)
    } else {
        sign := ifx source_type.bits == 32 then cast(u64)0x80000000 else cast(u64)0x8000000000000000
        ExecWriteSlotBits(instance, instruction.result, bits ^ sign)
    }
    return true
}

ExecNumericInstruction :: (instance: *LirExecInstance, instruction: *$I) -> bool {
    op := instruction.op
    opcode := cast(s32)op
    left := ExecOperand(instruction, 0)
    // The plan owns immutable type records. Scalar operations only read
    // their kind, width and signedness.
    types := instance.plan.program.types
    source := *types[instance.current_value_types[left]]
    if opcode >= cast(s32)LirOp.Add && opcode <= cast(s32)LirOp.Remainder ||
        opcode >= cast(s32)LirOp.BitAnd && opcode <= cast(s32)LirOp.ShiftRight {
        if source.kind == .Integer { return ExecIntegerBinary(instance, instruction, op, left, source) }
        return ExecFloatBinary(instance, instruction, source.bits == 32)
    }
    if opcode >= cast(s32)LirOp.Equal && opcode <= cast(s32)LirOp.GreaterEqual {
        return ExecCompare(instance, instruction, source)
    }
    if op == .Convert || op == .Bitcast {
        destination := *types[instance.current_value_types[instruction.result]]
        return ExecConvert(instance, instruction, source, destination)
    }
    return ExecFail(instance, .Unsupported)
}

ExecValueInstruction :: (instance: *LirExecInstance, frame_index: s64, frame: *LirExecFrame,
    instruction: *$I) -> bool {
    op := instruction.op
    // Numeric instructions are contiguous except for the two unary ops.
    // They do not need to pass through the aggregate and address dispatch.
    if cast(u32)op >= cast(u32)LirOp.Add && cast(u32)op <= cast(u32)LirOp.Bitcast &&
        op != .Negate && op != .BitNot {
        if !ExecNumericInstruction(instance, instruction) { return false }
        frame.instruction += 1
        return true
    }
    result_type: s32 = LirNoId
    if instruction.result != LirNoId {
        result_type = instance.current_value_types[instruction.result]
    }
    if op == .Constant {
        constant := instance.plan.program.constants[instruction.symbol]
        ExecWriteSlotBits(instance, instruction.result, constant.bits)
    } else if op == .Null { ExecWriteSlotBits(instance, instruction.result, 0) }
    else if op == .GlobalAddress {
        ExecWriteSlotBits(instance, instruction.result, instance.addresses[instruction.symbol].token)
    } else if op == .FunctionAddress {
        ExecWriteSlotBits(instance, instruction.result, cast(u64)(instruction.symbol + 1))
    } else if op == .Aggregate {
        if !ExecAggregate(instance, frame_index, instruction) { return false }
    } else if op == .Extract || op == .Insert {
        if !ExecExtractInsert(instance, frame_index, instruction) { return false }
    } else if op == .FieldAddress || op == .ElementAddress || op == .Load || op == .Store {
        if !ExecMemoryInstruction(instance, frame_index, instruction, result_type) { return false }
    } else if op == .BytesEqual {
        if !ExecBytesEqual(instance, instruction) { return false }
    } else if op == .Allocate {
        if !ExecAllocate(instance, frame_index, instruction, result_type) { return false }
    } else if op == .Resize {
        if !ExecResize(instance, instruction, result_type) { return false }
    } else if op == .Negate || op == .BitNot || op == .SquareRoot {
        if !ExecUnaryInstruction(instance, frame_index, instruction) { return false }
    } else { return ExecFail(instance, .Unsupported) }
    frame.instruction += 1
    return true
}

ExecHostCanonical :: (type: LirType, bits: u64) -> bool {
    if type.kind == .Bool { return bits <= cast(u64)1 }
    if type.kind == .Integer { return (bits & ~ExecMask(type.bits)) == cast(u64)0 }
    if type.kind == .Float && type.bits == 32 { return bits <= cast(u64)4294967295 }
    return type.kind == .Float && type.bits == 64
}

ExecHostScalarType :: (type: LirType) -> bool {
    return type.kind == .Bool || type.kind == .Integer || type.kind == .Float
}

ExecHostHandleType :: (program: LirProgram, type: s32) -> bool {
    return program.types[type].kind == .Pointer
}

// Scalars and opaque handles cross a typed host boundary in `bits`; every
// other host shape crosses as an image in `bytes`.
ExecHostBitsType :: (program: LirProgram, type: s32) -> bool {
    return ExecHostScalarType(program.types[type]) || ExecHostHandleType(program, type)
}

ExecHostSignature :: (plan: *LirExecPlan, function: s32, typed: bool) -> bool {
    program := plan.program
    fn := program.functions[function]
    for parameter: fn.parameters {
        if typed {
            if plan.host_shapes[parameter] == 0 { return false }
        } else if !ExecHostScalarType(program.types[parameter]) { return false }
    }
    if program.types[fn.result].kind == .Void { return true }
    if typed { return plan.host_shapes[fn.result] != 0 }
    return ExecHostScalarType(program.types[fn.result])
}

// Where decoded host bytes go: a frame's storage, the instance-owned bytes
// or the globals.
ExecStore :: enum u8 { Frame; Owned; Globals }

ExecStoreBits :: (instance: *LirExecInstance, store: ExecStore, at: s64, count: s64, bits: u64, global: s32) {
    if store == .Owned { ExecWriteBits(instance.owned[:], at, count, bits) }
    else if store == .Globals {
        data := *instance.globals[global]
        ExecWriteBits(data.bytes[:], ExecGlobalOffset(instance, global, at), count, bits)
    }
    else { ExecWriteBits(instance.storage[:], at, count, bits) }
}

ExecHostAvailable :: (instance: *LirExecInstance) -> s64 {
    return instance.limits.value_bytes - instance.plan.global_bytes - instance.storage.count -
        instance.words.count * 8 - instance.result_bytes.count - instance.owned.count
}

ExecHostViewAddress :: (instance: *LirExecInstance, token: u64, count: u64,
    element: s32, width: s64) -> s32 {
    found := ExecFindAddress(instance, token)
    if found < 0 || width <= 0 || count > cast(u64)9223372036854775807 ||
        instance.addresses[found].type != element || !ExecAddressValid(instance, found) ||
        count > cast(u64)(instance.addresses[found].extent / width) {
        unused ExecFail(instance, .Host)
        return -1
    }
    return found
}

// A host image is the value's own bytes followed by the elements of every
// view inside it. In the image a view's two words are the byte offset of its
// first element from the start of the image and its element count; an empty
// view is two zero words. Elements are images themselves, so views nest.
// Handles keep their bits.
//
// Writes the image of the `type` value at `source[from]` to the host bytes at
// `to` and appends its view elements. `base` is where the whole image starts
// and `limit` bounds the host bytes. A type may hold itself through a view, so
// `depth` counts the levels a value nests and stops past LirHostShapeDepth.
ExecHostEncode :: (instance: *LirExecInstance, type: s32, source: []u8, from: s64,
    base: s64, to: s64, limit: s64, depth: s64) -> bool {
    plan := instance.plan
    program := plan.program
    size := plan.type_sizes[type]
    if depth > LirHostShapeDepth { return ExecFail(instance, .Host) }
    if plan.host_shapes[type] < LirHostShapeViews {
        if !ExecSpend(instance, ExecCopyCost(size)) { return false }
        for byte: cast(s64)0..size - 1 { instance.host_bytes[to + byte] = source[from + byte] }
        return true
    }
    value := program.types[type]
    if LirHostView(program, type) {
        token := ExecReadBits(source, from, 8)
        count := ExecReadBits(source, from + 8, 8)
        if !ExecSpend(instance, 1) { return false }
        if count == 0 {
            ExecWriteBits(instance.host_bytes[:], to, 8, 0)
            ExecWriteBits(instance.host_bytes[:], to + 8, 8, 0)
            return true
        }
        element := program.types[value.fields[0]].element
        width := plan.type_sizes[element]
        found := ExecHostViewAddress(instance, token, count, element, width)
        if found < 0 { return false }
        bytes := cast(s64)count * width
        at := instance.host_bytes.count
        if bytes > limit - at { return ExecFail(instance, .ValueBytes) }
        if !VecResizeBounded(instance.host_bytes, at + bytes, limit) { return ExecFail(instance, .Allocation) }
        ExecWriteBits(instance.host_bytes[:], to, 8, cast(u64)(at - base))
        ExecWriteBits(instance.host_bytes[:], to + 8, 8, count)
        // The elements live wherever the address was made: owned bytes,
        // globals or a frame.
        entry := instance.addresses[found]
        offset := ExecAddressOffset(instance, found)
        if instance.failure.problem != .None { return false }
        elements := instance.storage[:]
        if entry.owned { elements = instance.owned[:] }
        else if entry.frame < 0 {
            data := *instance.globals[entry.global]
            elements = ExecGlobalBytes(data)
            offset = ExecGlobalOffset(instance, entry.global, offset)
        }
        if plan.host_shapes[element] < LirHostShapeViews {
            if !ExecSpend(instance, ExecCopyCost(bytes)) { return false }
            for byte: cast(s64)0..bytes - 1 { instance.host_bytes[at + byte] = elements[offset + byte] }
            return true
        }
        for index: cast(s64)0..cast(s64)count - 1 {
            if !ExecHostEncode(instance, element, elements, offset + index * width,
                base, at + index * width, limit, depth + 1) { return false }
        }
        return true
    }
    if value.kind == .Array {
        width := plan.type_sizes[value.element]
        for index: cast(s64)0..value.count - 1 {
            if !ExecHostEncode(instance, value.element, source, from + index * width,
                base, to + index * width, limit, depth + 1) { return false }
        }
        return true
    }
    offset: s64
    for field: value.fields {
        if !ExecHostEncode(instance, field, source, from + offset, base, to + offset, limit, depth + 1) { return false }
        offset += plan.type_sizes[field]
    }
    return true
}

ExecHostParameter :: (mask: u64, index: s64) -> bool {
    return index >= 0 && index < 64 && ((mask >> cast(u64)index) & cast(u64)1) != cast(u64)0
}

ExecBorrowHostView :: (instance: *LirExecInstance, source: s64, available: s64,
    argument: *LirExecArgument) -> bool {
    storage := instance.storage[:]
    count := ExecReadBits(storage, source + 8, 8)
    if !ExecSpend(instance, 1) { return false }
    argument.borrowed = true
    if count == 0 { return true }
    program := instance.plan.program
    view := program.types[argument.type]
    element := program.types[view.fields[0]].element
    width := instance.plan.type_sizes[element]
    found := ExecHostViewAddress(instance, ExecReadBits(storage, source, 8), count, element, width)
    if found < 0 { return false }
    size := cast(s64)count * width
    if size > available { return ExecFail(instance, .ValueBytes) }
    at := ExecAddressOffset(instance, found)
    if instance.failure.problem != .None || !ExecSpend(instance, ExecCopyCost(size)) { return false }
    entry := instance.addresses[found]
    local := at
    capacity := instance.storage.count
    if entry.owned { capacity = instance.owned.count }
    else if entry.frame < 0 {
        local = ExecGlobalOffset(instance, entry.global, at)
        capacity = ExecGlobalBytes(*instance.globals[entry.global]).count
    }
    if local < 0 || size > capacity - local { return ExecFail(instance, .Host) }
    tail := ExecAddressTail(instance, entry, at)
    argument.bytes = tail[:size]
    return true
}

ExecTypedHostArguments :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *$I, host: LirExecHostBinding) -> bool {
    program := instance.plan.program
    count := ExecOperandCount(instruction)
    available := ExecHostAvailable(instance)
    if available < 0 { return ExecFail(instance, .ValueBytes) }
    unused VecResize(instance.host_bytes, 0)
    // Earlier calls may have left more room than this one needs.
    if !VecResize(instance.typed_arguments, count) ||
        !VecResize(instance.host_arguments, count) { return ExecFail(instance, .Allocation) }
    for index: cast(s64)0..count - 1 {
        operand := ExecOperand(instruction, index)
        type := instance.current_value_types[operand]
        value := LirExecArgument.{.type = type}
        if ExecHostBitsType(program, type) {
            value.bits = ExecSlotBits(instance, operand)
            if instance.failure.problem != .None { return false }
        } else {
            size := instance.plan.type_sizes[type]
            at := instance.host_bytes.count
            if size > available - at { return ExecFail(instance, .ValueBytes) }
            source := ExecFrameValueOffset(instance, frame_index, operand)
            if ExecHostParameter(host.borrowed_views, index) {
                if !ExecBorrowHostView(instance, source, available - at - size, *value) { return false }
                // Charge the same logical image size. Borrowed data lives in
                // guest storage, which argument preparation does not resize.
                available -= size + value.bytes.count
            } else {
                if !VecResizeBounded(instance.host_bytes, at + size, available) { return ExecFail(instance, .Allocation) }
                if !ExecHostEncode(instance, type, instance.storage[:], source, at, at, available, 0) { return false }
                // Slice images after the host bytes have stopped growing.
                instance.host_arguments[index] = cast(u64)at
                value.bits = cast(u64)(instance.host_bytes.count - at)
            }
        }
        instance.typed_arguments[index] = value
    }
    for index: cast(s64)0..count - 1 {
        if instance.typed_arguments[index].borrowed ||
            ExecHostBitsType(program, instance.typed_arguments[index].type) { continue }
        start := cast(s64)instance.host_arguments[index]
        end := start + cast(s64)instance.typed_arguments[index].bits
        instance.typed_arguments[index].bits = 0
        instance.typed_arguments[index].bytes = VecSlice(instance.host_bytes, start, end)
    }
    return true
}

// Reads the `type` value at `image[from]` of a host image into `store` at
// `to`. Each view's elements become read-only instance-owned storage that
// stays valid for globals and later calls. `depth` is as for ExecHostEncode.
ExecHostDecode :: (instance: *LirExecInstance, type: s32, image: []u8, from: s64,
    store: ExecStore, to: s64, depth: s64, global: s32 = -1) -> bool {
    plan := instance.plan
    program := plan.program
    value := program.types[type]
    size := plan.type_sizes[type]
    if depth > LirHostShapeDepth || from < 0 || size > image.count - from { return ExecFail(instance, .Host) }
    if !ExecSpend(instance, 1) { return false }
    if value.kind == .Array {
        width := plan.type_sizes[value.element]
        for index: cast(s64)0..value.count - 1 {
            if !ExecHostDecode(instance, value.element, image, from + index * width,
                store, to + index * width, depth + 1, global) { return false }
        }
        return true
    }
    if value.kind == .Record && !LirHostView(program, type) {
        offset: s64
        for field: value.fields {
            if !ExecHostDecode(instance, field, image, from + offset, store, to + offset, depth + 1, global) { return false }
            offset += plan.type_sizes[field]
        }
        return true
    }
    if value.kind != .Record {
        bits := ExecReadBits(image, from, size)
        if value.kind == .Bool && bits > cast(u64)1 { return ExecFail(instance, .Host) }
        ExecStoreBits(instance, store, to, size, bits, global)
        return true
    }
    start := ExecReadBits(image, from, 8)
    count := ExecReadBits(image, from + 8, 8)
    token: u64
    if count == 0 {
        if start != 0 { return ExecFail(instance, .Host) }
    } else {
        element := program.types[value.fields[0]].element
        width := plan.type_sizes[element]
        if width <= 0 || start > cast(u64)image.count ||
            count > cast(u64)((image.count - cast(s64)start) / width) { return ExecFail(instance, .Host) }
        bytes := cast(s64)count * width
        index := ExecHostBlock(instance, bytes, element)
        if index < 0 { return false }
        base := instance.addresses[index].offset
        token = instance.addresses[index].token
        kind := program.types[element].kind
        if kind == .Integer || kind == .Float {
            if !ExecSpend(instance, ExecCopyCost(bytes)) { return false }
            for byte: cast(s64)0..bytes - 1 { instance.owned[base + byte] = image[cast(s64)start + byte] }
        } else {
            for index: cast(s64)0..cast(s64)count - 1 {
                if !ExecHostDecode(instance, element, image, cast(s64)start + index * width,
                    .Owned, base + index * width, depth + 1) { return false }
            }
        }
    }
    ExecStoreBits(instance, store, to, 8, token, global)
    ExecStoreBits(instance, store, to + 8, 8, count, global)
    return true
}

ExecTypedHostResult :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *$I, result: LirExecArgument) -> bool {
    program := instance.plan.program
    expected := program.functions[instruction.symbol].result
    if result.type != expected { return ExecFail(instance, .Host) }
    type := program.types[expected]
    if type.kind == .Void { return result.bytes.count == 0 || ExecFail(instance, .Host) }
    if instruction.result == LirNoId { return ExecFail(instance, .Host) }
    if ExecHostBitsType(program, expected) {
        if result.bytes.count != 0 ||
            ExecHostScalarType(type) && !ExecHostCanonical(type, result.bits) { return ExecFail(instance, .Host) }
        ExecWriteSlotBits(instance, instruction.result, result.bits)
        return instance.failure.problem == .None
    }
    // A value without views is exactly its own bytes.
    if instance.plan.host_shapes[expected] < LirHostShapeViews &&
        result.bytes.count != instance.plan.type_sizes[expected] { return ExecFail(instance, .Host) }
    destination := ExecFrameValueOffset(instance, frame_index, instruction.result)
    epoch := instance.heap_epoch
    if !ExecHostDecode(instance, expected, result.bytes, 0, .Frame, destination, 0) {
        ExecHostRollback(instance, epoch)
        return false
    }
    return true
}

// Where the elements of the view argument `index` lie: their store and byte
// range. Returns the view's address, or -1 when it is empty. Encoding the
// argument checked the address.
ExecViewSpan :: (instance: *LirExecInstance, frame_index: s64, instruction: *$I,
    index: s64, store: *ExecStore, start: *s64, end: *s64) -> s32 {
    program := instance.plan.program
    source := ExecFrameValueOffset(instance, frame_index, ExecOperand(instruction, index))
    count := cast(s64)ExecReadBits(instance.storage[:], source + 8, 8)
    found := ExecFindAddress(instance, ExecReadBits(instance.storage[:], source, 8))
    if count == 0 || found < 0 { return -1 }
    view := program.types[instance.typed_arguments[index].type]
    width := instance.plan.type_sizes[program.types[view.fields[0]].element]
    entry := instance.addresses[found]
    <<store = .Frame
    if entry.owned { <<store = .Owned } else if entry.frame < 0 { <<store = .Globals }
    <<start = ExecAddressOffset(instance, found)
    <<end = <<start + count * width
    return found
}

// Two mutable view arguments of one call may not share elements: the host
// would see one change through the other and one copy-back would be lost.
ExecHostViewsApart :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *$I, host: LirExecHostBinding) -> bool {
    count := ExecOperandCount(instruction)
    if host.views == cast(u64)0 { return true }
    for left: cast(s64)0..count - 1 {
        left_store: ExecStore
        left_start: s64
        left_end: s64
        if !ExecHostParameter(host.views, left) ||
            ExecViewSpan(instance, frame_index, instruction, left, *left_store, *left_start, *left_end) < 0 { continue }
        for right: left + 1..count - 1 {
            right_store: ExecStore
            right_start: s64
            right_end: s64
            if !ExecHostParameter(host.views, right) ||
                ExecViewSpan(instance, frame_index, instruction, right, *right_store, *right_start, *right_end) < 0 { continue }
            if left_store == right_store && left_start < right_end && right_start < left_end {
                return ExecFail(instance, .Host)
            }
        }
    }
    return instance.failure.problem == .None
}

// Copies the elements of each mutable view argument the host changed back
// into the view's storage. An element whose own image bytes are the ones
// the host was given is left as it is, so an unchanged string in it takes
// no new bytes and read-only storage passes when nothing in it changed.
ExecTypedHostCopyBack :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *$I, host: LirExecHostBinding) -> bool {
    plan := instance.plan
    program := plan.program
    for index: cast(s64)0..ExecOperandCount(instruction) - 1 {
        argument := instance.typed_arguments[index]
        if !argument.changed { continue }
        if !ExecHostParameter(host.views, index) { return ExecFail(instance, .Host) }
        source := ExecFrameValueOffset(instance, frame_index, ExecOperand(instruction, index))
        count := ExecReadBits(instance.storage[:], source + 8, 8)
        image := argument.bytes
        if image.count < 16 || ExecReadBits(image, 8, 8) != count { return ExecFail(instance, .Host) }
        if count == 0 { continue }
        store: ExecStore
        at: s64
        end: s64
        found := ExecViewSpan(instance, frame_index, instruction, index, *store, *at, *end)
        if found < 0 { return ExecFail(instance, .Host) }
        writable := instance.addresses[found].writable
        global := instance.addresses[found].global
        element := program.types[program.types[argument.type].fields[0]].element
        width := plan.type_sizes[element]
        start := ExecReadBits(image, 0, 8)
        if start > cast(u64)image.count ||
            count > cast(u64)((image.count - cast(s64)start) / width) { return ExecFail(instance, .Host) }
        // The elements of the image the host was given.
        given := cast(s64)instance.host_arguments[index]
        given += cast(s64)ExecReadBits(instance.host_bytes[:], given, 8)
        kind := program.types[element].kind
        if kind == .Integer || kind == .Float {
            bytes := cast(s64)count * width
            if ExecBytesMatchAcross(image, cast(s64)start, instance.host_bytes[:], given, bytes) { continue }
            if !writable { return ExecFail(instance, .Pointer) }
            if !ExecSpend(instance, ExecCopyCost(bytes)) { return false }
            for byte: cast(s64)0..bytes - 1 {
                ExecStoreBits(instance, store, at + byte, 1, cast(u64)image[cast(s64)start + byte], global)
            }
            continue
        }
        for item: cast(s64)0..cast(s64)count - 1 {
            from := cast(s64)start + item * width
            if ExecBytesMatchAcross(image, from, instance.host_bytes[:], given + item * width, width) { continue }
            if !writable { return ExecFail(instance, .Pointer) }
            if !ExecHostDecode(instance, element, image, from, store, at + item * width, 1, global) { return false }
        }
    }
    return true
}

ExecHostBinding :: (instance: *LirExecInstance, function: s32) -> s64 {
    for index: cast(s64)0..instance.hosts.count - 1 {
        if instance.hosts[index].function == function { return index }
    }
    return -1
}

// ExecHostBinding, remembered per function in host_lookup (one entry per
// program function, sized when the instance opens). A function with no
// binding yet is not remembered: one can still be bound before a run.
ExecFastHostBinding :: (instance: *LirExecInstance, function: s32) -> s64 #inline {
    known := instance.host_lookup[function]
    if known > 0 { return cast(s64)known - 1 }
    resolved := ExecHostBinding(instance, function)
    if resolved >= 0 { instance.host_lookup[function] = cast(s32)(resolved + 1) }
    return resolved
}

ExecPlatformWriteSignature :: (program: LirProgram, function: s32) -> bool {
    fn := program.functions[function]
    if fn.parameters.count != 3 || program.types[fn.result].kind != .Void { return false }
    descriptor := program.types[fn.parameters[0]]
    pointer := program.types[fn.parameters[1]]
    count := program.types[fn.parameters[2]]
    if descriptor.kind != .Integer || descriptor.bits != 64 || descriptor.is_signed ||
        pointer.kind != .Pointer || count.kind != .Integer || count.bits != 64 || count.is_signed { return false }
    element := program.types[pointer.element]
    return element.kind == .Integer && element.bits == 8 && !element.is_signed
}

ExecPlatformWriteCall :: (instance: *LirExecInstance, frame_index: s64,
    instruction: *$I, host: LirExecHostBinding) -> bool {
    descriptor := ExecSlotBits(instance, ExecOperand(instruction, 0))
    token := ExecSlotBits(instance, ExecOperand(instruction, 1))
    count := ExecSlotBits(instance, ExecOperand(instruction, 2))
    if instance.failure.problem != .None { return false }
    if count > cast(u64)9223372036854775807 { return ExecFail(instance, .Pointer) }
    size := cast(s64)count
    empty: [0]u8
    bytes: []u8 = empty[:]
    if size != 0 {
        found := ExecFindAddress(instance, token)
        if found < 0 || instance.addresses[found].extent < size || !ExecAddressValid(instance, found) {
            return ExecFail(instance, .Pointer)
        }
        entry := instance.addresses[found]
        pointee := instance.plan.program.types[entry.type]
        if pointee.kind != .Integer || pointee.bits != 8 || pointee.is_signed { return ExecFail(instance, .Pointer) }
        at := ExecAddressOffset(instance, found)
        if instance.failure.problem != .None { return false }
        if !ExecSpend(instance, ExecCopyCost(size)) { return false }
        tail := ExecAddressTail(instance, entry, at)
        bytes = tail[:size]
    }
    if !host.write(host.context, descriptor, bytes) { return ExecFail(instance, .Host) }
    instance.frames[frame_index].instruction += 1
    return true
}

ExecHostCall :: (instance: *LirExecInstance, frame_index: s64, instruction: *$I) -> bool {
    program := instance.plan.program
    binding := ExecHostBinding(instance, instruction.symbol)
    if binding < 0 { return ExecFail(instance, .Host) }
    count := ExecOperandCount(instruction)
    if !ExecSpend(instance, count) { return false }
    host := instance.hosts[binding]
    if host.write != null { return ExecPlatformWriteCall(instance, frame_index, instruction, host) }
    if host.typed != null {
        // Host values the program dropped give their storage back once a
        // collection's worth of new ones has come in.
        if instance.host_since >= 65536 && instance.host_since >= instance.host_scanned &&
            !ExecHostCollect(instance) { return false }
        if !ExecTypedHostArguments(instance, frame_index, instruction, host) ||
            !ExecHostViewsApart(instance, frame_index, instruction, host) { return false }
        result := LirExecArgument.{.type = LirNoId}
        called := host.typed(host.context, instruction.symbol,
            VecSlice(instance.typed_arguments, 0, count), *result)
        if host.borrowed_views != 0 {
            for index: cast(s64)0..count - 1 {
                if ExecHostParameter(host.borrowed_views, index) {
                    empty: []u8
                    instance.typed_arguments[index].bytes = empty
                }
            }
        }
        if !called || !ExecTypedHostCopyBack(instance, frame_index, instruction, host) ||
            !ExecTypedHostResult(instance, frame_index, instruction, result) {
            if instance.failure.problem == .None { return ExecFail(instance, .Host) }
            return false
        }
        instance.frames[frame_index].instruction += 1
        return true
    }
    if !VecResize(instance.host_arguments, count) { return ExecFail(instance, .Allocation) }
    for at: cast(s64)0..count - 1 {
        instance.host_arguments[at] = ExecSlotBits(instance, ExecOperand(instruction, at))
        if instance.failure.problem != .None { return false }
    }
    result: u64
    if !host.call(host.context, instruction.symbol, VecSlice(instance.host_arguments, 0, count), *result) {
        return ExecFail(instance, .Host)
    }
    if instruction.result != LirNoId {
        if !ExecHostCanonical(program.types[program.functions[instruction.symbol].result], result) {
            return ExecFail(instance, .Host)
        }
        ExecWriteSlotBits(instance, instruction.result, result)
    }
    instance.frames[frame_index].instruction += 1
    return true
}

ExecStep :: (instance: *LirExecInstance) -> bool {
    frame_index := instance.frames.count - 1
    // Read in place: the step runs for every instruction, and a copy of the
    // frame record cost more than the step's own work.
    frame := *instance.frames[frame_index]
    block := instance.plan.program.functions[frame.function].blocks[frame.block]
    return ExecStepInstruction(instance, frame_index, frame, *block.instructions[frame.instruction])
}

ExecStepInstruction :: (instance: *LirExecInstance, frame_index: s64, frame: *LirExecFrame,
    instruction: *$I) -> bool {
    if !ExecSpend(instance, 1) { return false }
    op := instruction.op
    if op == .Fuel {
        amount := cast(s64)instruction.immediate
        if !ExecCanContinue(instance) { return false }
        if amount > instance.fuel_remaining { return ExecFail(instance, .FuelLimit) }
        instance.fuel_remaining -= amount
        instance.frames[frame_index].instruction += 1
        return true
    }
    if op == .Trap { return ExecFail(instance, .Trap, instruction.immediate) }
    if op == .Unreachable { return ExecFail(instance, .Unreachable) }
    if op == .Jump || op == .Branch {
        if !ExecCanContinue(instance) { return false }
        edge_index: s64
        if op == .Branch {
            edge_index = cast(s64)(ExecSlotBits(instance, ExecOperand(instruction, 0)) == 0)
            if instance.failure.problem != .None { return false }
        }
        edge_base := cast(s64)instance.plan.block_edge_bases[instance.plan.functions[frame.function].block_base + frame.block]
        return ExecEdge(instance, frame_index, ExecInstructionEdge(instruction, edge_index),
            instance.plan.edge_direct[edge_base + edge_index] != 0)
    }
    if op == .Return { return ExecFinishFrame(instance, frame_index, instruction) }
    if op == .HostCall {
        return ExecCanContinue(instance) && ExecHostCall(instance, frame_index, instruction)
    }
    if op == .Call || op == .CallIndirect {
        if !ExecCanContinue(instance) { return false }
        return ExecCallInstruction(instance, frame_index, instruction)
    }
    return ExecValueInstruction(instance, frame_index, frame, instruction)
}

// ---- The run loop --------------------------------------------------------
//
// The loop runs a frame's compact code. A segment's work and fuel are
// charged when it is entered; when they do not fit, or anything unusual
// happens (a failure, a call, a host value, a new table entry it cannot
// make), the loop gives back the work and fuel of the instructions it has
// not run, puts the frame at the instruction it stopped on, and lets
// ExecStep run from there to the next segment. A run therefore charges
// and fails exactly where ExecStep alone would.

ExecSetPosition :: (instance: *LirExecInstance, frame_index: s64, block: s32, index: s32, base: s64) #inline {
    instance.frames[frame_index].block = block
    instance.frames[frame_index].instruction = index
    instance.frames[frame_index].instruction_base = base
}

// Runs instructions through ExecStep, at least one, until the top frame
// stands at the start of a segment.
ExecRunSlow :: (instance: *LirExecInstance) -> bool {
    while true {
        if !ExecStep(instance) || instance.failure.problem != .None { return false }
        if instance.frames.count == 0 { return true }
        frame := *instance.frames[instance.frames.count - 1]
        if instance.plan.segment_code[frame.instruction_base + frame.instruction] >= 0 { return true }
    }
    return true
}

// The table entry `token` names, or -1 (ExecFindAddress).
ExecFastFind :: (instance: *LirExecInstance, token: u64) -> s64 #inline {
    low := token & cast(u64)1048575
    if low == 0 { return -1 }
    index := cast(s64)low - 1
    if index >= instance.addresses.count || instance.addresses[index].token != token { return -1 }
    return index
}

// Where a valid address's bytes start in its store, or -1 (ExecAddressOffset).
ExecFastLocate :: (instance: *LirExecInstance, address: *LirExecAddress) -> s64 #inline {
    if address.owned {
        if address.heap != 0 {
            block := *instance.heap_blocks[address.heap - 1]
            if !block.live || block.generation != address.generation { return -1 }
        }
        if address.offset < 0 || address.extent < 0 || address.offset > instance.owned.count ||
            address.extent > instance.owned.count - address.offset { return -1 }
        return address.offset
    }
    if address.frame < 0 { return address.offset }
    if address.frame >= instance.frames.count ||
        instance.frames[address.frame].generation != address.generation { return -1 }
    return instance.frames[address.frame].base + address.offset
}

ExecGetBits :: (bytes: []u8, at: s64, size: s64) -> u64 #inline {
    if size == 8 {
        b := bytes[at:at + 8]
        return cast(u64)b[0] | (cast(u64)b[1] << cast(u64)8) | (cast(u64)b[2] << cast(u64)16) |
            (cast(u64)b[3] << cast(u64)24) | (cast(u64)b[4] << cast(u64)32) | (cast(u64)b[5] << cast(u64)40) |
            (cast(u64)b[6] << cast(u64)48) | (cast(u64)b[7] << cast(u64)56)
    }
    if size == 4 {
        b := bytes[at:at + 4]
        return cast(u64)b[0] | (cast(u64)b[1] << cast(u64)8) | (cast(u64)b[2] << cast(u64)16) |
            (cast(u64)b[3] << cast(u64)24)
    }
    if size == 1 { return cast(u64)bytes[at] }
    return ExecReadBits(bytes, at, size)
}

ExecPutBits :: (bytes: []u8, at: s64, size: s64, value: u64) #inline {
    if size == 8 {
        b := bytes[at:at + 8]
        b[0] = cast(u8)value
        b[1] = cast(u8)(value >> cast(u64)8)
        b[2] = cast(u8)(value >> cast(u64)16)
        b[3] = cast(u8)(value >> cast(u64)24)
        b[4] = cast(u8)(value >> cast(u64)32)
        b[5] = cast(u8)(value >> cast(u64)40)
        b[6] = cast(u8)(value >> cast(u64)48)
        b[7] = cast(u8)(value >> cast(u64)56)
        return
    }
    if size == 1 { bytes[at] = cast(u8)value; return }
    ExecWriteBits(bytes, at, size, value)
}

ExecCopyBytes :: (bytes: []u8, from: s64, to: s64, count: s64) #inline {
    if from == to { return }
    // Apart, eight bytes at a time give the same bytes as one at a time.
    if count >= 8 && (to + count <= from || from + count <= to) {
        source := bytes[from:from + count]
        target := bytes[to:to + count]
        at: s64
        while at + 8 <= count {
            ExecPutBits(target, at, 8, ExecGetBits(source, at, 8))
            at += 8
        }
        while at < count { target[at] = source[at]; at += 1 }
        return
    }
    for index: cast(s64)0..count - 1 { bytes[to + index] = bytes[from + index] }
}

// How many of a view code's elements `extent` bytes hold, as `extent /
// code.size` gives it: a shift by `code.z` when the size is a power of two.
ExecFastPerElement :: (extent: s64, code: *LirExecCode) -> u64 #inline {
    if code.z >= 0 && extent >= 0 { return cast(u64)extent >> cast(u64)code.z }
    return cast(u64)(extent / code.size)
}

// A derivation's token, made as ExecDeriveToken would without its work
// charge (the segment paid it): a transient one takes the next of its
// entries. 0 hands the instruction to ExecStep;
// ExecFailedToken: failed, with the failure recorded.
ExecFailedToken :: () -> u64 #inline { return ~cast(u64)0 }

ExecFastDerive :: (instance: *LirExecInstance, words: []u64, frame_index: s64, code: *LirExecCode,
    word_base: s64, view: bool, indexed: bool) -> u64 #inline {
    base_token := words[word_base + code.a]
    index_word: u64
    count_word: u64
    if view || indexed { index_word = words[word_base + code.b] }
    if view { count_word = words[word_base + code.c] }
    if code.memo >= 0 {
        memo := *instance.derived_tokens[code.memo]
        if memo.token != 0 && memo.base == base_token && memo.index == index_word &&
            memo.count == count_word && ExecFastFind(instance, memo.token) >= 0 { return memo.token }
    }
    derived: LirExecAddress
    if !ExecFastAddress(instance, words, code, word_base, view, indexed, *derived) { return 0 }
    if code.flag == ExecTransientFrame {
        // The reference path creates the slot and reports any allocation error.
        return ExecReuseScopedAddress(instance, words[word_base + code.result], derived)
    }
    if code.flag == ExecTransientBlock {
        if instance.transient_count == 0 { return 0 }
        index := instance.transient_base + instance.transient_next
        instance.transient_next += 1
        if instance.transient_next == ExecTransientSlots { instance.transient_next = 0 }
        entry := *instance.addresses[index]
        version := (entry.version + 1) & cast(u64)268435455
        <<entry = derived
        entry.version = version
        entry.token = ExecAddressToken(instance.identity, index, version)
        entry.next = 0
        return entry.token
    }
    token: u64
    made := ExecFastIntern(instance, frame_index, code, *derived, *token)
    if made < 0 { return ExecFailedToken() }
    if made == 0 { return 0 }
    if code.memo >= 0 {
        instance.derived_tokens[code.memo] = .{.base = base_token, .index = index_word,
            .count = count_word, .token = token}
    }
    return token
}

// Stands where ExecStep would once `code` has run and charged its own
// work: for a failure it reports after its host was called.
ExecFastStand :: (instance: *LirExecInstance, frame_index: s64, code: *LirExecCode) #cold {
    instance.work_remaining += code.rest_work - code.cost
    instance.fuel_remaining += code.rest_fuel
    ExecSetPosition(instance, frame_index, code.block, code.index, code.base)
}

// A HostWrite from the fast loop, as ExecPlatformWriteCall makes it:
// `count` bytes of `element` at `pointer` to `descriptor`. 1 when written;
// 0 hands the instruction to ExecStep with nothing done; -1 when the host
// failed, standing on the instruction.
ExecFastWrite :: (instance: *LirExecInstance, frame_index: s64, code: *LirExecCode,
    function: s32, element: s32, descriptor: u64, pointer: u64, count: u64) -> s32 #inline {
    binding := ExecFastHostBinding(instance, function)
    if binding < 0 || count > cast(u64)9223372036854775807 { return 0 }
    host := instance.hosts[binding]
    if host.write == null { return 0 }
    size := cast(s64)count
    no_bytes: [0]u8
    bytes: []u8 = no_bytes[:]
    copy: s64 = 0
    if size != 0 {
        index := ExecFastFind(instance, pointer)
        if index < 0 { return 0 }
        address := *instance.addresses[index]
        if address.type != element || address.extent < size { return 0 }
        at := ExecFastLocate(instance, address)
        if at < 0 { return 0 }
        tail := ExecAddressTail(instance, <<address, at)
        bytes = tail[:size]
        copy = ExecCopyCost(size)
        if copy > instance.work_remaining { return 0 }
    }
    instance.work_remaining -= copy
    if !host.write(host.context, descriptor, bytes) {
        ExecFastStand(instance, frame_index, code)
        unused ExecFail(instance, .Host)
        return -1
    }
    return 1
}

ExecFastIntern :: (instance: *LirExecInstance, frame_index: s64, code: *LirExecCode,
    pointer: *LirExecAddress, token: *u64) -> s32 {
    address := <<pointer
    found := ExecAddressLookup(instance, address)
    if found >= 0 {
        <<token = instance.addresses[found].token
        return 1
    }
    if instance.address_free.count == 0 && (instance.addresses.count >= instance.limits.addresses ||
        instance.addresses.count >= ExecAddressSlots) { return 0 }
    // ExecNewAddress records its own failures: stand where ExecStep would.
    rest_work := code.rest_work - code.cost
    instance.work_remaining += rest_work
    instance.fuel_remaining += code.rest_fuel
    ExecSetPosition(instance, frame_index, code.block, code.index, code.base)
    index := ExecNewAddress(instance, address)
    if index < 0 { return -1 }
    instance.work_remaining -= rest_work
    instance.fuel_remaining -= code.rest_fuel
    <<token = instance.addresses[index].token
    return 1
}

// Takes edge `edge`. The next code to run, ExecHandOver when the run goes
// on at a segment the outer loop enters, or ExecBail when the edge's
// copies do not fit and the terminator goes to ExecStep.
ExecFastEdge :: (instance: *LirExecInstance, words: []u64, storage: []u8, frame_index: s64,
    edge: s64, word_base: s64, storage_base: s64) -> s64 #inline {
    if !ExecCanContinue(instance) { return ExecFailed }
    plan := instance.plan
    target := *plan.edge_plans[edge]
    if target.work > instance.work_remaining { return ExecBail }
    instance.work_remaining -= target.work
    if target.direct {
        for at: target.moves..target.moves + target.count - 1 {
            move := *plan.moves[at]
            if move.word { words[word_base + move.to] = words[word_base + move.from] }
            else { ExecCopyBytes(storage, storage_base + move.from, storage_base + move.to, move.size) }
        }
    } else {
        for at: target.moves..target.moves + target.count - 1 {
            move := *plan.moves[at]
            if move.word {
                ExecWriteBits(storage, storage_base + move.scratch, move.size, words[word_base + move.from])
            } else { ExecCopyBytes(storage, storage_base + move.from, storage_base + move.scratch, move.size) }
        }
        for at: target.moves..target.moves + target.count - 1 {
            move := *plan.moves[at]
            if move.word {
                words[word_base + move.to] = ExecReadBits(storage, storage_base + move.scratch, move.size)
            } else { ExecCopyBytes(storage, storage_base + move.scratch, storage_base + move.to, move.size) }
        }
    }
    if target.target_work > instance.work_remaining || target.target_fuel > instance.fuel_remaining {
        ExecSetPosition(instance, frame_index, target.target_block, 0, target.target_base)
        return ExecHandOver
    }
    instance.work_remaining -= target.target_work
    instance.fuel_remaining -= target.target_fuel
    return target.target_code
}

// Statuses of the run loop, beside the index of code to hand to ExecStep.
ExecFailed :: -1
ExecHandOver :: -2
ExecBail :: -3

// The bits of a word a Load or Extract reads: bools as 0 or 1, integers masked.
ExecFastCanonical :: (code: *LirExecCode, bits: u64) -> u64 #inline {
    if code.flag != 0 { return cast(u64)(bits != 0) }
    return bits & code.immediate
}

// Load and Store through a pointer word; false hands the instruction over.
ExecFastMemory :: (instance: *LirExecInstance, words: []u64, storage: []u8, owned: []u8,
    code: *LirExecCode, word_base: s64, storage_base: s64, store: bool) -> bool #inline {
    index := ExecFastFind(instance, words[word_base + code.a])
    if index < 0 { return false }
    address := *instance.addresses[index]
    if address.type != code.type || code.size > address.extent || store && !address.writable { return false }
    at := ExecFastLocate(instance, address)
    if at < 0 { return false }
    globals := storage
    if !address.owned && address.frame < 0 {
        at = ExecGlobalOffset(instance, address.global, at)
        globals = ExecGlobalBytes(*instance.globals[address.global])
    }
    size := code.size
    if !store {
        if code.result >= 0 {
            bits: u64
            if address.owned { bits = ExecGetBits(owned, at, size) }
            else if address.frame < 0 { bits = ExecGetBits(globals, at, size) }
            else { bits = ExecGetBits(storage, at, size) }
            words[word_base + code.result] = ExecFastCanonical(code, bits)
            return true
        }
        to := storage_base + code.x
        if address.owned { for byte: cast(s64)0..size - 1 { storage[to + byte] = owned[at + byte] } }
        else if address.frame < 0 { for byte: cast(s64)0..size - 1 { storage[to + byte] = globals[at + byte] } }
        else { ExecCopyBytes(storage, at, to, size) }
        return true
    }
    if code.b >= 0 {
        bits := words[word_base + code.b]
        if address.owned { ExecPutBits(owned, at, size, bits) }
        else if address.frame < 0 { ExecPutBits(globals, at, size, bits) }
        else { ExecPutBits(storage, at, size, bits) }
        return true
    }
    from := storage_base + code.x
    if address.owned { for byte: cast(s64)0..size - 1 { owned[at + byte] = storage[from + byte] } }
    else if address.frame < 0 { for byte: cast(s64)0..size - 1 { globals[at + byte] = storage[from + byte] } }
    else { for byte: cast(s64)0..size - 1 { storage[at + byte] = storage[from + byte] } }
    return true
}

// The address a FieldAddress, ElementIndex or ElementView derives, as
// ExecFieldAddress and ExecElementAddress make it; false hands it over.
ExecFastAddress :: (instance: *LirExecInstance, words: []u64, code: *LirExecCode, word_base: s64,
    view: bool, indexed: bool, derived: *LirExecAddress) -> bool #inline {
    index := ExecFastFind(instance, words[word_base + code.a])
    if index < 0 { return false }
    base := *instance.addresses[index]
    // A FieldAddress first: its address, a transient one, is this one's base.
    field: LirExecAddress
    if code.prefix != 0 {
        if instance.transient_count == 0 || base.type != code.prefix_type { return false }
        frame: s64 = -1
        generation: u64
        global := base.global
        if base.frame >= 0 {
            if base.frame >= instance.frames.count ||
                instance.frames[base.frame].generation != base.generation { return false }
            frame = base.frame
            generation = base.generation
            global = -1
        } else if base.heap != 0 { generation = base.generation }
        field = .{.global = global, .frame = frame, .generation = generation,
            .offset = base.offset + code.prefix_offset, .extent = code.prefix_size, .type = code.type,
            .owned = base.owned, .writable = base.writable, .heap = base.heap}
        base = *field
    }
    if base.type != code.type { return false }
    if view {
        element := words[word_base + code.b]
        count := words[word_base + code.c]
        if (element & code.sign_b) != 0 || (count & code.sign_c) != 0 || element >= count ||
            count > cast(u64)9223372036854775807 ||
            code.size != 0 && count > ExecFastPerElement(base.extent, code) { return false }
        offset := cast(s64)element * code.size
        <<derived = .{.global = base.global, .frame = base.frame, .generation = base.generation,
            .offset = base.offset + offset, .extent = base.extent - offset, .type = code.target,
            .owned = base.owned, .writable = base.writable, .heap = base.heap}
        return true
    }
    offset := code.x
    extent := code.size
    if indexed {
        member := words[word_base + code.b]
        if (member & code.sign_b) != 0 || member >= code.extra { return false }
        offset = cast(s64)member * code.size
        extent = base.extent - offset
        if extent < code.size { return false }
    }
    frame: s64 = -1
    generation: u64
    global := base.global
    if base.frame >= 0 {
        if base.frame >= instance.frames.count ||
            instance.frames[base.frame].generation != base.generation { return false }
        frame = base.frame
        generation = base.generation
        global = -1
    } else if base.heap != 0 { generation = base.generation }
    <<derived = .{.global = global, .frame = frame, .generation = generation,
        .offset = base.offset + offset, .extent = extent, .type = code.target,
        .owned = base.owned, .writable = base.writable, .heap = base.heap}
    return true
}

// A derivation and the Load or Store that uses it, as one: the address is
// derived as ExecFastAddress derives it and used where it lies, with the
// checks ExecAddressValid and ExecCopyAddressToValue make. false hands the
// derivation, and so the pair, to ExecStep.
ExecFastFusedMemory :: (instance: *LirExecInstance, words: []u64, storage: []u8, owned: []u8,
    code: *LirExecCode, word_base: s64, storage_base: s64, view: bool, indexed: bool, store: bool) -> bool #inline {
    // The derivation is a transient one; its entries are made by ExecStep
    // the first time, and with them any address-limit failure.
    if instance.transient_count == 0 { return false }
    address: LirExecAddress
    if !ExecFastAddress(instance, words, code, word_base, view, indexed, *address) { return false }
    size := code.size
    if size > address.extent || store && !address.writable { return false }
    at := ExecFastLocate(instance, *address)
    if at < 0 { return false }
    globals := storage
    if !address.owned && address.frame < 0 {
        at = ExecGlobalOffset(instance, address.global, at)
        globals = ExecGlobalBytes(*instance.globals[address.global])
    }
    if !store {
        if code.result >= 0 {
            bits: u64
            if address.owned { bits = ExecGetBits(owned, at, size) }
            else if address.frame < 0 { bits = ExecGetBits(globals, at, size) }
            else { bits = ExecGetBits(storage, at, size) }
            words[word_base + code.result] = ExecFastCanonical(code, bits)
            return true
        }
        to := storage_base + code.w
        if address.owned { for byte: cast(s64)0..size - 1 { storage[to + byte] = owned[at + byte] } }
        else if address.frame < 0 { for byte: cast(s64)0..size - 1 { storage[to + byte] = globals[at + byte] } }
        else { ExecCopyBytes(storage, at, to, size) }
        return true
    }
    if code.value >= 0 {
        bits := words[word_base + code.value]
        if address.owned { ExecPutBits(owned, at, size, bits) }
        else if address.frame < 0 { ExecPutBits(globals, at, size, bits) }
        else { ExecPutBits(storage, at, size, bits) }
        return true
    }
    from := storage_base + code.w
    if address.owned { for byte: cast(s64)0..size - 1 { owned[at + byte] = storage[from + byte] } }
    else if address.frame < 0 { for byte: cast(s64)0..size - 1 { globals[at + byte] = storage[from + byte] } }
    else { for byte: cast(s64)0..size - 1 { storage[at + byte] = storage[from + byte] } }
    return true
}

// Insert into a copy of the aggregate; false hands the instruction over.
ExecFastInsert :: (words: []u64, storage: []u8, code: *LirExecCode, word_base: s64,
    storage_base: s64, indexed: bool, word: bool) -> bool #inline {
    offset := cast(s64)code.immediate
    if indexed {
        member := words[word_base + code.c]
        if (member & code.sign_c) != 0 || member >= code.extra { return false }
        offset = cast(s64)member * code.z
    }
    ExecCopyBytes(storage, storage_base + code.x, storage_base + code.y, code.size)
    if word { ExecPutBits(storage, storage_base + code.y + offset, code.z, words[word_base + code.b]) }
    else { ExecCopyBytes(storage, storage_base + code.w, storage_base + code.y + offset, code.z) }
    return true
}

ExecFastFloat64 :: (plan: *LirExecPlan, handler: LirExecHandler, left: u64, right: u64) -> u64 #inline {
    a := ExecBitsFloat(plan, left, false)
    b := ExecBitsFloat(plan, right, false)
    value: float64
    if handler == .FloatAdd64 { value = a + b }
    else if handler == .FloatSubtract64 { value = a - b }
    else if handler == .FloatMultiply64 { value = a * b }
    else { value = a / b }
    return ExecFloat64Bits(value)
}

ExecFastFloat32 :: (plan: *LirExecPlan, handler: LirExecHandler, left: u64, right: u64) -> u64 #inline {
    a := cast(float32)ExecBitsFloat(plan, left, true)
    b := cast(float32)ExecBitsFloat(plan, right, true)
    value: float32
    if handler == .FloatAdd32 { value = a + b }
    else if handler == .FloatSubtract32 { value = a - b }
    else if handler == .FloatMultiply32 { value = a * b }
    else { value = a / b }
    return ExecFloat32Bits(value)
}

ExecFastFloatCompare :: (plan: *LirExecPlan, code: *LirExecCode, left: u64, right: u64, single: bool) -> u64 #inline {
    a := ExecBitsFloat(plan, left, single)
    b := ExecBitsFloat(plan, right, single)
    op := cast(LirOp)cast(s32)code.extra
    answer: bool
    if op == .Equal { answer = a == b }
    else if op == .NotEqual { answer = a != b }
    else if op == .Less { answer = a < b }
    else if op == .LessEqual { answer = a <= b }
    else if op == .Greater { answer = a > b }
    else { answer = a >= b }
    return cast(u64)answer
}

// Divide and Remainder; false (a zero divisor) hands the instruction over.
ExecFastDivide :: (code: *LirExecCode, left: u64, right: u64, signed: bool, remainder: bool, result: *u64) -> bool #inline {
    if right == 0 { return false }
    if !signed {
        <<result = ifx remainder then left % right else left / right
        return true
    }
    bits := cast(s32)code.size
    signed_right := ExecSigned(right, bits)
    minimum := cast(u64)1 << cast(u64)(bits - 1)
    if left == minimum && signed_right == -1 { <<result = ifx remainder then cast(u64)0 else minimum }
    else if remainder { <<result = cast(u64)(ExecSigned(left, bits) % signed_right) & code.immediate }
    else { <<result = cast(u64)(ExecSigned(left, bits) / signed_right) & code.immediate }
    return true
}

// Shifts; false (a count of the width or more) hands the instruction over.
ExecFastShift :: (code: *LirExecCode, left: u64, count: u64, right: bool, signed: bool, result: *u64) -> bool #inline {
    if count >= cast(u64)code.size { return false }
    if !right { <<result = (left << count) & code.immediate; return true }
    value := left >> count
    if signed && count != 0 && (left & (cast(u64)1 << cast(u64)(code.size - 1))) != 0 {
        value |= code.immediate ^ (code.immediate >> count)
    }
    <<result = value
    return true
}

ExecFastFloatInteger :: (plan: *LirExecPlan, code: *LirExecCode, bits: u64, result: *u64) -> bool #inline {
    value := ExecBitsFloat(plan, bits, code.size == 32)
    if !Finite64(value) { return false }
    if code.flag != 0 {
        bound := plan.powers[1073 + code.y]
        if value < 0.0 - bound || value >= bound { return false }
        <<result = cast(u64)cast(s64)value & code.immediate
        return true
    }
    bound := plan.powers[1074 + code.y]
    if value < 0.0 || value >= bound { return false }
    <<result = cast(u64)value & code.immediate
    return true
}

ExecFastIntegerFloat :: (code: *LirExecCode, bits: u64) -> u64 #inline {
    source := cast(s32)code.size
    if code.y == 32 {
        value := ifx code.flag != 0 then cast(float32)ExecSigned(bits, source) else cast(float32)(bits & code.extra)
        return ExecFloat32Bits(value)
    }
    value := ifx code.flag != 0 then cast(float64)ExecSigned(bits, source) else cast(float64)(bits & code.extra)
    return ExecFloat64Bits(value)
}

ExecFastConvertInteger :: (code: *LirExecCode, bits: u64) -> u64 #inline {
    value := bits & code.extra
    if code.flag != 0 && code.size < 64 && (value & (cast(u64)1 << cast(u64)(code.size - 1))) != 0 { value |= ~code.extra }
    return value & code.immediate
}

// Runs the top frame's code from `start`. Returns the code to hand to
// ExecStep (a Slow instruction, or one this loop gives back), ExecHandOver
// when the frame stands at a segment the outer loop enters, or ExecFailed.
// It reaches the frame's words and storage through views: nothing it calls
// resizes them, and whatever would goes through ExecStep after it returns.
ExecRunCode :: (instance: *LirExecInstance, frame_index: s64, start: s64) -> s64 {
    plan := instance.plan
    wb := instance.frames[frame_index].word_base
    sb := instance.frames[frame_index].base
    words := instance.words[:]
    storage := instance.storage[:]
    owned := instance.owned[:]
    pc := start
    while true {
        c := *plan.code[pc / ExecCodeChunkSize].entries[pc % ExecCodeChunkSize]
        h := c.handler
        next := pc + 1
        if h == .Add {
            words[wb + c.result] = (words[wb + c.a] + words[wb + c.b]) & c.immediate
        } else if h == .Subtract {
            words[wb + c.result] = (words[wb + c.a] - words[wb + c.b]) & c.immediate
        } else if h == .Multiply {
            words[wb + c.result] = (words[wb + c.a] * words[wb + c.b]) & c.immediate
        } else if h == .BitAnd {
            words[wb + c.result] = words[wb + c.a] & words[wb + c.b]
        } else if h == .BitOr {
            words[wb + c.result] = words[wb + c.a] | words[wb + c.b]
        } else if h == .BitXor {
            words[wb + c.result] = words[wb + c.a] ^ words[wb + c.b]
        } else if h == .Equal {
            words[wb + c.result] = cast(u64)(words[wb + c.a] == words[wb + c.b])
        } else if h == .NotEqual {
            words[wb + c.result] = cast(u64)(words[wb + c.a] != words[wb + c.b])
        } else if h == .Less {
            words[wb + c.result] = cast(u64)(words[wb + c.a] < words[wb + c.b])
        } else if h == .LessEqual {
            words[wb + c.result] = cast(u64)(words[wb + c.a] <= words[wb + c.b])
        } else if h == .Greater {
            words[wb + c.result] = cast(u64)(words[wb + c.a] > words[wb + c.b])
        } else if h == .GreaterEqual {
            words[wb + c.result] = cast(u64)(words[wb + c.a] >= words[wb + c.b])
        } else if h == .SignedLess {
            words[wb + c.result] = cast(u64)(ExecSigned(words[wb + c.a], cast(s32)c.size) <
                ExecSigned(words[wb + c.b], cast(s32)c.size))
        } else if h == .SignedLessEqual {
            words[wb + c.result] = cast(u64)(ExecSigned(words[wb + c.a], cast(s32)c.size) <=
                ExecSigned(words[wb + c.b], cast(s32)c.size))
        } else if h == .SignedGreater {
            words[wb + c.result] = cast(u64)(ExecSigned(words[wb + c.a], cast(s32)c.size) >
                ExecSigned(words[wb + c.b], cast(s32)c.size))
        } else if h == .SignedGreaterEqual {
            words[wb + c.result] = cast(u64)(ExecSigned(words[wb + c.a], cast(s32)c.size) >=
                ExecSigned(words[wb + c.b], cast(s32)c.size))
        } else if h == .Jump {
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge, wb, sb)
        } else if h == .Branch {
            next = ExecFastEdge(instance, words, storage, frame_index,
                c.edge + cast(s64)(words[wb + c.a] == 0), wb, sb)
        } else if h == .BranchEqual {
            condition := words[wb + c.a] == words[wb + c.b]
            words[wb + c.result] = cast(u64)condition
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge + cast(s64)!condition, wb, sb)
        } else if h == .BranchNotEqual {
            condition := words[wb + c.a] != words[wb + c.b]
            words[wb + c.result] = cast(u64)condition
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge + cast(s64)!condition, wb, sb)
        } else if h == .BranchLess {
            condition := words[wb + c.a] < words[wb + c.b]
            words[wb + c.result] = cast(u64)condition
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge + cast(s64)!condition, wb, sb)
        } else if h == .BranchLessEqual {
            condition := words[wb + c.a] <= words[wb + c.b]
            words[wb + c.result] = cast(u64)condition
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge + cast(s64)!condition, wb, sb)
        } else if h == .BranchGreater {
            condition := words[wb + c.a] > words[wb + c.b]
            words[wb + c.result] = cast(u64)condition
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge + cast(s64)!condition, wb, sb)
        } else if h == .BranchGreaterEqual {
            condition := words[wb + c.a] >= words[wb + c.b]
            words[wb + c.result] = cast(u64)condition
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge + cast(s64)!condition, wb, sb)
        } else if h == .BranchSignedLess {
            condition := ExecSigned(words[wb + c.a], cast(s32)c.size) < ExecSigned(words[wb + c.b], cast(s32)c.size)
            words[wb + c.result] = cast(u64)condition
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge + cast(s64)!condition, wb, sb)
        } else if h == .BranchSignedLessEqual {
            condition := ExecSigned(words[wb + c.a], cast(s32)c.size) <= ExecSigned(words[wb + c.b], cast(s32)c.size)
            words[wb + c.result] = cast(u64)condition
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge + cast(s64)!condition, wb, sb)
        } else if h == .BranchSignedGreater {
            condition := ExecSigned(words[wb + c.a], cast(s32)c.size) > ExecSigned(words[wb + c.b], cast(s32)c.size)
            words[wb + c.result] = cast(u64)condition
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge + cast(s64)!condition, wb, sb)
        } else if h == .BranchSignedGreaterEqual {
            condition := ExecSigned(words[wb + c.a], cast(s32)c.size) >= ExecSigned(words[wb + c.b], cast(s32)c.size)
            words[wb + c.result] = cast(u64)condition
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge + cast(s64)!condition, wb, sb)
        } else if h == .ExtractWord {
            words[wb + c.result] = ExecFastCanonical(c, ExecGetBits(storage, sb + c.x, c.size))
        } else if h == .ExtractBytes {
            ExecCopyBytes(storage, sb + c.x, sb + c.y, c.size)
        } else if h == .ExtractWordPair {
            words[wb + c.result] = ExecFastCanonical(c, ExecGetBits(storage, sb + c.x, c.size))
            bits := ExecGetBits(storage, sb + c.y, c.z)
            if c.c != 0 { bits = cast(u64)(bits != 0) } else { bits &= c.extra }
            words[wb + c.b] = bits
        } else if h == .AddJump {
            words[wb + c.result] = (words[wb + c.a] + words[wb + c.b]) & c.immediate
            next = ExecFastEdge(instance, words, storage, frame_index, c.edge, wb, sb)
        } else if h == .ExtractWordIndexed {
            member := words[wb + c.c]
            if (member & c.sign_c) != 0 || member >= c.extra { return pc }
            words[wb + c.result] = ExecFastCanonical(c, ExecGetBits(storage, sb + c.x + cast(s64)member * c.size, c.size))
        } else if h == .ExtractBytesIndexed {
            member := words[wb + c.c]
            if (member & c.sign_c) != 0 || member >= c.extra { return pc }
            ExecCopyBytes(storage, sb + c.x + cast(s64)member * c.size, sb + c.y, c.size)
        } else if h == .InsertWord {
            if !ExecFastInsert(words, storage, c, wb, sb, false, true) { return pc }
        } else if h == .InsertBytes {
            if !ExecFastInsert(words, storage, c, wb, sb, false, false) { return pc }
        } else if h == .InsertWordIndexed {
            if !ExecFastInsert(words, storage, c, wb, sb, true, true) { return pc }
        } else if h == .InsertBytesIndexed {
            if !ExecFastInsert(words, storage, c, wb, sb, true, false) { return pc }
        } else if h == .Load {
            if !ExecFastMemory(instance, words, storage, owned, c, wb, sb, false) { return pc }
        } else if h == .Store {
            if !ExecFastMemory(instance, words, storage, owned, c, wb, sb, true) { return pc }
        } else if h == .LoadField {
            if !ExecFastFusedMemory(instance, words, storage, owned, c, wb, sb, false, false, false) { return pc }
        } else if h == .LoadIndex {
            if !ExecFastFusedMemory(instance, words, storage, owned, c, wb, sb, false, true, false) { return pc }
        } else if h == .LoadView {
            if !ExecFastFusedMemory(instance, words, storage, owned, c, wb, sb, true, false, false) { return pc }
        } else if h == .StoreField {
            if !ExecFastFusedMemory(instance, words, storage, owned, c, wb, sb, false, false, true) { return pc }
        } else if h == .StoreIndex {
            if !ExecFastFusedMemory(instance, words, storage, owned, c, wb, sb, false, true, true) { return pc }
        } else if h == .StoreView {
            if !ExecFastFusedMemory(instance, words, storage, owned, c, wb, sb, true, false, true) { return pc }
        } else if h == .FieldAddress {
            token := ExecFastDerive(instance, words, frame_index, c, wb, false, false)
            if token == 0 { return pc }
            if token == ExecFailedToken() { return ExecFailed }
            words[wb + c.result] = token
        } else if h == .ElementIndex {
            token := ExecFastDerive(instance, words, frame_index, c, wb, false, true)
            if token == 0 { return pc }
            if token == ExecFailedToken() { return ExecFailed }
            words[wb + c.result] = token
        } else if h == .ElementView {
            token := ExecFastDerive(instance, words, frame_index, c, wb, true, false)
            if token == 0 { return pc }
            if token == ExecFailedToken() { return ExecFailed }
            words[wb + c.result] = token
        } else if h == .ElementSlice {
            // Bounds that do not hold, and an empty slice (its base's own
            // token), run on ExecStep.
            high := words[wb + c.value]
            if (high & c.extra) != 0 || words[wb + c.b] >= high || high > words[wb + c.c] { return pc }
            token := ExecFastDerive(instance, words, frame_index, c, wb, true, false)
            if token == 0 { return pc }
            if token == ExecFailedToken() { return ExecFailed }
            words[wb + c.result] = token
        } else if h == .Negate {
            words[wb + c.result] = (cast(u64)0 - words[wb + c.a]) & c.immediate
        } else if h == .BitNot {
            words[wb + c.result] = ~words[wb + c.a] & c.immediate
        } else if h == .FloatNegate {
            words[wb + c.result] = words[wb + c.a] ^ c.immediate
        } else if h == .ConvertInteger {
            words[wb + c.result] = ExecFastConvertInteger(c, words[wb + c.a])
        } else if h == .ConvertBoolInteger {
            words[wb + c.result] = cast(u64)(words[wb + c.a] != 0) & c.immediate
        } else if h == .ConvertIntegerBool {
            words[wb + c.result] = cast(u64)((words[wb + c.a] & c.extra) != 0)
        } else if h == .Bitcast {
            words[wb + c.result] = words[wb + c.a] & c.immediate
        } else if h == .FloatAdd64 {
            words[wb + c.result] = ExecFastFloat64(plan, .FloatAdd64, words[wb + c.a], words[wb + c.b])
        } else if h == .FloatSubtract64 {
            words[wb + c.result] = ExecFastFloat64(plan, .FloatSubtract64, words[wb + c.a], words[wb + c.b])
        } else if h == .FloatMultiply64 {
            words[wb + c.result] = ExecFastFloat64(plan, .FloatMultiply64, words[wb + c.a], words[wb + c.b])
        } else if h == .FloatDivide64 {
            words[wb + c.result] = ExecFastFloat64(plan, .FloatDivide64, words[wb + c.a], words[wb + c.b])
        } else if h == .FloatAdd32 {
            words[wb + c.result] = ExecFastFloat32(plan, .FloatAdd32, words[wb + c.a], words[wb + c.b])
        } else if h == .FloatSubtract32 {
            words[wb + c.result] = ExecFastFloat32(plan, .FloatSubtract32, words[wb + c.a], words[wb + c.b])
        } else if h == .FloatMultiply32 {
            words[wb + c.result] = ExecFastFloat32(plan, .FloatMultiply32, words[wb + c.a], words[wb + c.b])
        } else if h == .FloatDivide32 {
            words[wb + c.result] = ExecFastFloat32(plan, .FloatDivide32, words[wb + c.a], words[wb + c.b])
        } else if h == .FloatCompare32 {
            words[wb + c.result] = ExecFastFloatCompare(plan, c, words[wb + c.a], words[wb + c.b], true)
        } else if h == .FloatCompare64 {
            words[wb + c.result] = ExecFastFloatCompare(plan, c, words[wb + c.a], words[wb + c.b], false)
        } else if h == .ConvertIntegerFloat {
            words[wb + c.result] = ExecFastIntegerFloat(c, words[wb + c.a])
        } else if h == .ConvertFloatFloat {
            value := ExecBitsFloat(plan, words[wb + c.a], c.size == 32)
            words[wb + c.result] = ifx c.y == 32 then ExecFloat32Bits(cast(float32)value) else ExecFloat64Bits(value)
        } else if h == .ConvertFloatInteger {
            result: u64
            if !ExecFastFloatInteger(plan, c, words[wb + c.a], *result) { return pc }
            words[wb + c.result] = result
        } else if h == .DivideUnsigned {
            result: u64
            if !ExecFastDivide(c, words[wb + c.a], words[wb + c.b], false, false, *result) { return pc }
            words[wb + c.result] = result
        } else if h == .RemainderUnsigned {
            result: u64
            if !ExecFastDivide(c, words[wb + c.a], words[wb + c.b], false, true, *result) { return pc }
            words[wb + c.result] = result
        } else if h == .DivideSigned {
            result: u64
            if !ExecFastDivide(c, words[wb + c.a], words[wb + c.b], true, false, *result) { return pc }
            words[wb + c.result] = result
        } else if h == .RemainderSigned {
            result: u64
            if !ExecFastDivide(c, words[wb + c.a], words[wb + c.b], true, true, *result) { return pc }
            words[wb + c.result] = result
        } else if h == .ShiftLeft {
            result: u64
            if !ExecFastShift(c, words[wb + c.a], words[wb + c.b], false, false, *result) { return pc }
            words[wb + c.result] = result
        } else if h == .ShiftRightUnsigned {
            result: u64
            if !ExecFastShift(c, words[wb + c.a], words[wb + c.b], true, false, *result) { return pc }
            words[wb + c.result] = result
        } else if h == .ShiftRightSigned {
            result: u64
            if !ExecFastShift(c, words[wb + c.a], words[wb + c.b], true, true, *result) { return pc }
            words[wb + c.result] = result
        } else if h == .Aggregate {
            for at: c.x..c.x + c.y - 1 {
                move := *plan.moves[at]
                if move.word { ExecPutBits(storage, sb + move.to, move.size, words[wb + move.from]) }
                else { ExecCopyBytes(storage, sb + move.from, sb + move.to, move.size) }
            }
        } else if h == .GlobalAddress {
            words[wb + c.result] = instance.addresses[c.x].token
        } else if h == .HostWrite {
            written := ExecFastWrite(instance, frame_index, c, c.target, c.type,
                words[wb + c.a], words[wb + c.b], words[wb + c.c])
            if written == 0 { return pc }
            if written < 0 { return ExecFailed }
        } else if h == .HostCall {
            // The planner only sends calls whose arguments are frame words;
            // anything the host binds as a write or a typed image still runs
            // on ExecStep.
            host_binding := ExecFastHostBinding(instance, c.target)
            if host_binding < 0 { return pc }
            host := instance.hosts[host_binding]
            if host.write != null || host.typed != null { return pc }
            host_arguments: [3]u64
            if c.x >= 1 { host_arguments[0] = words[wb + c.a] }
            if c.x >= 2 { host_arguments[1] = words[wb + c.b] }
            if c.x >= 3 { host_arguments[2] = words[wb + c.c] }
            host_result: u64
            if !host.call(host.context, c.target, host_arguments[:c.x], *host_result) {
                ExecFastStand(instance, frame_index, c)
                unused ExecFail(instance, .Host)
                return ExecFailed
            }
            if c.result >= 0 {
                if !ExecHostCanonical(plan.program.types[c.type], host_result) {
                    ExecFastStand(instance, frame_index, c)
                    unused ExecFail(instance, .Host)
                    return ExecFailed
                }
                words[wb + c.result] = host_result
            }
        } else { return pc }
        if next < 0 {
            if next == ExecBail { return pc }
            return next
        }
        pc = next
    }
    return ExecFailed
}

// A Call between program frames, as ExecCallInstruction and ExecPushFrame
// make it, when nothing about it can fail. false: ExecStep makes it.
ExecFastCall :: (instance: *LirExecInstance, frame_index: s64, code: *LirExecCode) -> bool {
    plan := instance.plan
    target := code.target
    function := *plan.program.functions[target]
    target_plan := *plan.functions[target]
    if code.cost > instance.work_remaining || instance.frames.count >= instance.limits.frames ||
        function.values.count > instance.limits.values - instance.live_values { return false }
    // The same bounded growth as ExecResizeStorage and ExecResizeWords; a
    // refusal leaves both as they were for ExecStep to report.
    base := instance.storage.count
    word_base := instance.words.count
    outside := instance.limits.value_bytes - instance.plan.global_bytes - instance.result_bytes.count -
        instance.owned.count
    storage_room := outside - word_base * 8
    if storage_room < 0 || target_plan.frame_bytes > storage_room - base ||
        !ExecResizeFrameBytes(*instance.storage, base + target_plan.frame_bytes, storage_room) { return false }
    word_room := outside - instance.storage.count
    if word_room < 0 || word_base + target_plan.word_count > word_room / 8 ||
        !VecResizeBounded(instance.words, word_base + target_plan.word_count, word_room / 8) {
        unused VecResize(instance.storage, base)
        return false
    }
    caller := *instance.frames[frame_index]
    caller_words := caller.word_base
    caller_storage := caller.base
    instance.frame_epoch += 1
    frame := LirExecFrame.{.function = target, .block = function.entry, .return_value = code.result_value,
        .base = base, .word_base = word_base, .value_base = target_plan.value_base, .value_types = function.values,
        .instruction_base = cast(s64)plan.block_instruction_bases[target_plan.block_base + function.entry],
        .generation = instance.frame_epoch}
    if !VecPush(instance.frames, frame) {
        unused VecResize(instance.words, word_base)
        unused VecResize(instance.storage, base)
        instance.frame_epoch -= 1
        return false
    }
    instance.work_remaining -= code.cost
    instance.current_value_base = frame.value_base
    instance.current_value_types = function.values
    instance.current_word_base = word_base
    instance.live_values += function.values.count
    for at: target_plan.constants..target_plan.constants + target_plan.constant_count - 1 {
        constant := *plan.constant_words[at]
        instance.words[word_base + constant.word] = constant.bits
    }
    for at: code.x..code.x + code.y - 1 {
        move := *plan.moves[at]
        if move.word { instance.words[word_base + move.to] = instance.words[caller_words + move.from] }
        // The callee's storage lies past the caller's: the two never overlap.
        else { ExecCopyBytes(instance.storage[:], caller_storage + move.from, base + move.to, move.size) }
    }
    ExecSetPosition(instance, frame_index, code.block, code.index + 1, code.base)
    return true
}

// A Return to a calling program frame, as ExecFinishFrame makes it, when it
// cannot fail. false: ExecStep makes it.
ExecFastReturn :: (instance: *LirExecInstance, frame_index: s64, code: *LirExecCode) -> bool {
    if frame_index == 0 { return ExecFastRootReturn(instance, code) }
    frame := *instance.frames[frame_index]
    caller := *instance.frames[frame_index - 1]
    cost: s64 = 1
    if code.size != 0 {
        if frame.return_value == LirNoId { return false }
        cost += ExecCopyCost(code.size)
    } else if frame.return_value != LirNoId { return false }
    if cost > instance.work_remaining { return false }
    plan := instance.plan
    if code.size != 0 {
        destination := caller.value_base + frame.return_value
        if code.a >= 0 {
            instance.words[caller.word_base + ExecLocationWord(ExecValueLocation(plan, destination))] = instance.words[frame.word_base + code.a]
        } else {
            to := caller.base + ExecLocationOffset(ExecValueLocation(plan, destination))
            from := frame.base + code.x
            for byte: cast(s64)0..code.size - 1 { instance.storage[to + byte] = instance.storage[from + byte] }
        }
    }
    instance.work_remaining -= cost
    ExecPopFrame(instance)
    return true
}

// An Allocate, as ExecStep and ExecAllocate make it, standing on the
// instruction. false, with nothing done, hands it to ExecStep when the work,
// the storage or a table entry might not be there; a table that cannot grow
// leaves its failure recorded, as ExecAllocate would.
ExecFastAllocate :: (instance: *LirExecInstance, frame_index: s64, code: *LirExecCode) -> bool {
    at := instance.storage.count
    available := instance.limits.value_bytes - instance.plan.global_bytes -
        instance.result_bytes.count - instance.owned.count - instance.words.count * 8
    if code.cost > instance.work_remaining || available < 0 || code.size > available - at ||
        instance.address_free.count == 0 && (instance.addresses.count >= instance.limits.addresses ||
            instance.addresses.count >= ExecAddressSlots) ||
        !ExecResizeFrameBytes(*instance.storage, at + code.size, available) { return false }
    frame_base := instance.frames[frame_index].base
    word_base := instance.frames[frame_index].word_base
    // ExecStep's own work comes first; the first value's copy after the entry.
    instance.work_remaining -= 1
    made := ExecNewAddress(instance, .{.global = -1, .frame = frame_index,
        .generation = instance.frames[frame_index].generation, .offset = at - frame_base,
        .extent = code.size, .type = code.type, .writable = true})
    if made < 0 { return false }
    if code.y != 0 {
        instance.work_remaining -= code.y
        if code.a >= 0 { ExecPutBits(instance.storage[:], at, code.size, instance.words[word_base + code.a]) }
        else { ExecCopyBytes(instance.storage[:], frame_base + code.x, at, code.size) }
    }
    instance.words[word_base + code.result] = instance.addresses[made].token
    ExecSetPosition(instance, frame_index, code.block, code.index + 1, code.base)
    return true
}

// The root call's Return of a word or of nothing, as ExecFinishFrame makes
// it; false hands anything else to ExecStep.
ExecFastRootReturn :: (instance: *LirExecInstance, code: *LirExecCode) -> bool {
    frame := *instance.frames[0]
    result_type := instance.plan.program.functions[frame.function].result
    result_size := instance.plan.type_sizes[result_type]
    if code.size != result_size || result_size != 0 && code.a < 0 { return false }
    cost: s64 = 1
    if result_size != 0 { cost += ExecCopyCost(result_size) }
    available := instance.limits.value_bytes - instance.plan.global_bytes -
        instance.storage.count - instance.words.count * 8 - instance.owned.count
    if cost > instance.work_remaining || result_size > available ||
        !VecResizeBounded(instance.result_bytes, result_size,
            instance.limits.value_bytes - instance.plan.global_bytes) { return false }
    bits: u64
    if result_size != 0 {
        bits = instance.words[frame.word_base + code.a]
        ExecPutBits(instance.result_bytes[:], 0, result_size, bits)
    }
    instance.result_value = .{.type = result_type, .bits = bits, .bytes = result_size}
    instance.work_remaining -= cost
    ExecPopFrame(instance)
    return true
}

// Runs the instance's frames to the end of the root call.
ExecRunFast :: (instance: *LirExecInstance) -> bool {
    plan := instance.plan
    while instance.frames.count != 0 {
        if !ExecCanContinue(instance) { return false }
        frame_index := instance.frames.count - 1
        position := instance.frames[frame_index].instruction_base + instance.frames[frame_index].instruction
        pc := plan.segment_code[position]
        work := plan.segment_work[position]
        fuel := plan.segment_fuel[position]
        if pc < 0 || work > instance.work_remaining || fuel > instance.fuel_remaining {
            if !ExecRunSlow(instance) { return false }
            continue
        }
        instance.work_remaining -= work
        instance.fuel_remaining -= fuel
        stopped := ExecRunCode(instance, frame_index, pc)
        if stopped == ExecFailed { return false }
        if stopped >= 0 {
            code := *plan.code[stopped / ExecCodeChunkSize].entries[stopped % ExecCodeChunkSize]
            if code.handler == .Call && ExecFastCall(instance, frame_index, code) ||
                code.handler == .Return && ExecFastReturn(instance, frame_index, code) { continue }
            if code.handler == .Allocate {
                allocated := ExecFastAllocate(instance, frame_index, code)
                if instance.failure.problem != .None { return false }
                if allocated { continue }
            }
            // The rest of the segment from here goes to ExecStep: give back
            // what it was charged and stand on the instruction.
            instance.work_remaining += code.rest_work
            instance.fuel_remaining += code.rest_fuel
            ExecSetPosition(instance, frame_index, code.block, code.index, code.base)
            if !ExecRunSlow(instance) { return false }
        }
    }
    return instance.failure.problem == .None
}

ExecResetRun :: (instance: *LirExecInstance) -> bool {
    // Frames a failed run left behind give their addresses back too.
    for frame: instance.frames { ExecReleaseAddresses(instance, frame.addresses) }
    if !VecResize(instance.frames, 0) || !VecResize(instance.storage, 0) ||
        !VecResize(instance.words, 0) ||
        !VecResize(instance.result_bytes, 0) { return false }
    instance.live_values = 0
    instance.current_value_base = 0
    empty_types: []s32
    instance.current_value_types = empty_types
    instance.current_word_base = 0
    instance.result_value = .{.type = LirNoId}
    // Only ExecFail sets a problem, so with none the record is already this.
    if instance.failure.problem != .None { instance.failure = ExecResult(.None) }
    instance.work_remaining = instance.limits.work
    instance.fuel_remaining = instance.limits.fuel
    return true
}

#if #defined(ZIRAN_EXEC_PACKED_INSTRUCTIONS) {
ExecRunPacked :: (instance: *LirExecInstance, blocks: *LirExecPackedBlocks) -> bool {
    instructions := instance.plan.packed_instructions
    native := blocks != null && blocks.run != null
    next: s32 = -1
    while instance.frames.count != 0 && instance.failure.problem == .None {
        frame_index := instance.frames.count - 1
        frame := *instance.frames[frame_index]
        if native && (frame.instruction == 0 || frame.instruction == next) {
            if !ExecCanContinue(instance) { return false }
            // The hook only changes this frame's instruction and scalar words.
            next = blocks.run(blocks.context, instance, frame)
        }
        while true {
            instruction := *instructions[frame.instruction_base + frame.instruction]
            op := cast(u32)instruction.op
            // Value instructions leave the current frame and block in place.
            if op >= cast(u32)LirOp.Call && op <= cast(u32)LirOp.Unreachable {
                if !ExecStepInstruction(instance, frame_index, frame, instruction) {
                    return instance.failure.problem == .None
                }
                break
            }
            if !ExecSpend(instance, 1) || !ExecValueInstruction(instance, frame_index, frame, instruction) ||
                instance.failure.problem != .None { return instance.failure.problem == .None }
            if frame.instruction == next { break }
        }
    }
    return instance.failure.problem == .None
}
}

ExecRunRoot :: (instance: *LirExecInstance, function: s32, arguments: []LirExecArgument,
    packed_blocks: *void = null) -> bool {
    no_operands: [0]s32
    if !ExecPushFrame(instance, function, -1, no_operands[:], LirNoId, arguments) { return false }
    #if #defined(ZIRAN_EXEC_PACKED_INSTRUCTIONS) {
        if instance.plan.packed_instructions.count != 0 {
            return ExecRunPacked(instance, cast(*LirExecPackedBlocks)packed_blocks)
        }
    }
    if !instance.reference && !instance.plan.compact { return ExecRunFast(instance) }
    while instance.frames.count != 0 && instance.failure.problem == .None {
        if !ExecStep(instance) { break }
    }
    return instance.failure.problem == .None
}

ExecRunFunction :: (instance: *LirExecInstance, function: s32, arguments: []LirExecArgument) -> LirExecResult {
    if instance == null || !instance.ready || instance.plan == null || !instance.plan.ready {
        return ExecResult(.NotReady)
    }
    if instance.running { return ExecResult(.Busy) }
    if instance.initializer_failed { return instance.initializer_failure }
    program := *instance.plan.program
    // LirNoId runs only the initializers that have not run yet.
    if function != LirNoId && (function < 0 || function >= program.functions.count ||
        program.functions[function].external) {
        return ExecResult(.Calling)
    }
    if !instance.hosts_bound {
        for index: cast(s32)0..cast(s32)program.functions.count - 1 {
            if program.functions[index].external && ExecHostBinding(instance, index) < 0 {
                missing := ExecResult(.Host)
                missing.function = index
                return missing
            }
        }
        instance.hosts_bound = true
    }
    if !ExecResetRun(instance) { return ExecResult(.Allocation) }
    instance.running = true
    no_arguments: [0]LirExecArgument
    if !instance.initialized {
        for initializer: program.initializers {
            if !ExecRunRoot(instance, initializer, no_arguments[:]) { break }
        }
        if instance.failure.problem == .None {
            instance.initialized = true
            instance.result_value = .{.type = LirNoId}
            unused VecResize(instance.result_bytes, 0)
        } else {
            instance.initializer_failed = true
            instance.initializer_failure = instance.failure
        }
    }
    if instance.failure.problem == .None && function != LirNoId && !ExecRunRoot(instance, function, arguments) {
        // ExecRunRoot records the stable failure location in the instance.
    }
    if !ExecEndRun(instance) { return instance.failure }
    result := ExecResult(.None)
    result.value = instance.result_value
    result.work_remaining = instance.work_remaining
    result.fuel_remaining = instance.fuel_remaining
    return result
}

// Ends a run: false when it failed, with the frames it left given up and
// the failure in instance.failure.
ExecEndRun :: (instance: *LirExecInstance) -> bool {
    instance.running = false
    if instance.failure.problem == .None { return true }
    unused VecResize(instance.frames, 0)
    unused VecResize(instance.storage, 0)
    unused VecResize(instance.words, 0)
    instance.live_values = 0
    return false
}

ExecGlobalAccess :: (instance: *LirExecInstance, global: s32) -> LirExecProblem {
    if instance == null || !instance.ready || instance.plan == null || !instance.initialized { return .NotReady }
    if instance.running { return .Busy }
    program := instance.plan.program
    if global < 0 || global >= program.globals.count { return .Calling }
    if instance.plan.host_shapes[program.globals[global].type] == 0 { return .Type }
    instance.failure = ExecResult(.None)
    instance.work_remaining = instance.limits.work
    return .None
}

#scope_export

LirExecDefaultLimits :: () -> LirExecLimits {
    return .{.work = 16000000, .fuel = 16000000, .frames = 128,
        .values = 1048576, .addresses = ExecAddressSlots, .value_bytes = 268435456}
}

// Heap blocks the program allocated and still holds. A program that frees
// or drops every owned value ends with none.
LirExecHeapLive :: (instance: *LirExecInstance) -> s64 {
    live: s64
    if instance == null { return 0 }
    for block: instance.heap_blocks { if block.live && !block.host { live += 1 } }
    return live
}

LirExecPlanFree :: (plan: *LirExecPlan) {
    if plan == null { return }
    VecFree(plan.type_sizes)
    VecFree(plan.type_masks)
    VecFree(plan.value_locations)
    VecFree(plan.narrow_value_locations)
    VecFree(plan.host_shapes)
    VecFree(plan.functions)
    VecFree(plan.block_edge_bases)
    VecFree(plan.block_instruction_bases)
    VecFree(plan.edge_direct)
    VecFree(plan.transient)
    VecFree(plan.global_offsets)
    VecFree(plan.code)
    VecFree(plan.moves)
    VecFree(plan.edge_plans)
    VecFree(plan.constant_words)
    VecFree(plan.segment_code)
    VecFree(plan.segment_work)
    VecFree(plan.segment_fuel)
    VecFree(plan.powers)
    plan.program = .{}
    #if #defined(ZIRAN_EXEC_PACKED_INSTRUCTIONS) {
        no_instructions: []LirExecPackedInstruction
        plan.packed_instructions = no_instructions
    }
    plan.global_bytes = 0
    plan.derived_count = 0
    plan.compact = false
    plan.ready = false
}

LirExecInstanceClose :: (instance: *LirExecInstance) {
    if instance == null { return }
    VecFree(instance.globals)
    VecFree(instance.addresses)
    VecFree(instance.address_slots)
    VecFree(instance.address_free)
    VecFree(instance.derived_tokens)
    instance.address_used = 0
    VecFree(instance.storage)
    VecFree(instance.words)
    VecFree(instance.frames)
    VecFree(instance.result_bytes)
    VecFree(instance.hosts)
    VecFree(instance.host_lookup)
    VecFree(instance.host_arguments)
    VecFree(instance.typed_arguments)
    VecFree(instance.host_bytes)
    VecFree(instance.owned)
    VecFree(instance.heap_blocks)
    instance.heap_free = 0
    instance.heap_spare = 0
    instance.heap_tail = 0
    instance.heap_epoch = 0
    instance.host_since = 0
    instance.host_scanned = 0
    instance.plan = null
    instance.limits = .{}
    instance.identity = 0
    instance.result_value = .{.type = LirNoId}
    instance.live_values = 0
    instance.current_value_base = 0
    empty_types: []s32
    instance.current_value_types = empty_types
    instance.current_word_base = 0
    instance.work_remaining = 0
    instance.fuel_remaining = 0
    instance.failure = ExecResult(.None)
    instance.initializer_failure = ExecResult(.None)
    instance.initialized = false
    instance.initializer_failed = false
    instance.hosts_bound = false
    instance.ready = false
    instance.running = false
}

ExecBuildPlan :: (program: LirProgram, verify_limits: LirLimits, output: *LirExecPlan,
    compact: bool) -> LirExecResult {
    return ExecBuildPlanWithBodies(program, verify_limits, output, compact, .{})
}

ExecBuildPlanWithBodies :: (program: LirProgram, verify_limits: LirLimits, output: *LirExecPlan,
    compact: bool, bodies: LirFunctionBodies) -> LirExecResult {
    if output == null { return ExecResult(.NotReady) }
    LirExecPlanFree(output)
    diagnostic := LirVerifyWithBodies(program, verify_limits, bodies)
    if diagnostic.problem != .None {
        result := ExecResult(.InvalidProgram)
        result.verification = diagnostic
        result.function = diagnostic.function
        result.block = diagnostic.block
        result.instruction = diagnostic.instruction
        result.origin = diagnostic.origin
        return result
    }
    output.program = program
    problem := ExecPlanLayouts(program, output, verify_limits.bytes)
    if problem == .None && !LirHostShapes(program, *output.host_shapes) { problem = .Allocation }
    if problem == .None { problem = ExecPlanFunctions(program, output, verify_limits.bytes, compact, bodies) }
    if problem == .None {
        if !VecResizeBounded(output.powers, 2098, 2098) { problem = .Allocation }
        else {
            output.powers[0] = ScaleByPowerOfTwo(1.0, -1074)
            for index: cast(s64)1..2097 { output.powers[index] = output.powers[index - 1] * 2.0 }
            if !compact { problem = ExecPlanCode(program, output) }
        }
    }
    if problem != .None {
        result := ExecResult(problem)
        LirExecPlanFree(output)
        return result
    }
    output.compact = compact
    output.ready = true
    return ExecResult(.None)
}

LirExecPlanBuild :: (program: LirProgram, verify_limits: LirLimits, output: *LirExecPlan) -> LirExecResult {
    return ExecBuildPlan(program, verify_limits, output, false)
}

// Memory-constrained hosts can execute verified instructions directly. This
// builds only the shared layouts and never allocates the fast-code tables.
LirExecPlanBuildCompact :: (program: LirProgram, verify_limits: LirLimits, output: *LirExecPlan) -> LirExecResult {
    return ExecBuildPlan(program, verify_limits, output, true)
}

#if #defined(ZIRAN_EXEC_PACKED_INSTRUCTIONS) {
LirExecPlanBuildCompactBodies :: (program: LirProgram, verify_limits: LirLimits, output: *LirExecPlan,
    bodies: LirFunctionBodies) -> LirExecResult {
    return ExecBuildPlanWithBodies(program, verify_limits, output, true, bodies)
}
}

LirExecInstanceOpen :: (plan: *LirExecPlan, limits: LirExecLimits, identity: u32,
    output: *LirExecInstance) -> LirExecResult {
    if output == null { return ExecResult(.NotReady) }
    LirExecInstanceClose(output)
    if plan == null || !plan.ready || identity == 0 ||
        limits.work < 0 || limits.fuel < 0 || limits.frames < 1 || limits.values < 0 ||
        limits.addresses < 0 || limits.value_bytes < 0 {
        return ExecResult(.NotReady)
    }
    if limits.addresses < plan.program.globals.count { return ExecResult(.AddressLimit) }
    if plan.global_bytes > limits.value_bytes { return ExecResult(.ValueBytes) }
    output.plan = plan
    output.limits = limits
    output.identity = identity
    output.frame_epoch = 1
    output.work_remaining = limits.work
    output.fuel_remaining = limits.fuel
    output.failure = ExecResult(.None)
    global_count := plan.program.globals.count
    if !VecResizeBounded(output.globals, global_count, global_count) ||
        !VecResizeBounded(output.addresses, global_count, limits.addresses) ||
        !VecResize(output.derived_tokens, plan.derived_count) ||
        !VecResize(output.host_lookup, plan.program.functions.count) {
        LirExecInstanceClose(output)
        return ExecResult(.Allocation)
    }
    for global_index: cast(s64)0..global_count - 1 {
        global := plan.program.globals[global_index]
        offset := plan.global_offsets[global_index]
        size := plan.type_sizes[global.type]
        output.addresses[global_index] = .{.token = ExecAddressToken(identity, global_index),
            .global = cast(s32)global_index, .frame = -1, .offset = offset,
            .extent = size, .type = global.type,
            .writable = global.writable}
        data := *output.globals[global_index]
        if !global.writable {
            data.constant = plan.program.constants[global.constant].bytes
            continue
        }
        if !VecResizeBounded(data.bytes, size, size) {
            LirExecInstanceClose(output)
            return ExecResult(.Allocation)
        }
        if global.constant != LirNoId {
            constant := plan.program.constants[global.constant]
            type := plan.program.types[global.type]
            bytes := data.bytes[:]
            if type.kind == .Array {
                for at: cast(s64)0..constant.bytes.count - 1 { bytes[at] = constant.bytes[at] }
            } else {
                bits := constant.bits
                if type.kind == .Bool { bits = cast(u64)(bits != 0) }
                if type.kind == .Integer { bits &= ExecMask(type.bits) }
                ExecWriteBits(bytes, 0, size, bits)
            }
        }
    }
    output.ready = true
    return ExecResult(.None)
}

LirExecRun :: (instance: *LirExecInstance) -> LirExecResult {
    if instance == null || !instance.ready || instance.plan.program.entry == LirNoId {
        return ExecResult(.NotReady)
    }
    no_arguments: [0]LirExecArgument
    return ExecRunFunction(instance, instance.plan.program.entry, no_arguments[:])
}

// LirExecRun for a host that runs the entry again and again, without
// building a result: true when the run succeeded, with the result in
// instance.result_value and what is left in instance.work_remaining and
// instance.fuel_remaining; false with the result LirExecRun gives in
// `failed`. The first run takes LirExecRun's own path.
LirExecRunEntry :: (instance: *LirExecInstance, failed: *LirExecResult) -> bool {
    return LirExecRunEntryWithPackedBlocks(instance, failed, null)
}

LirExecRunEntryWithPackedBlocks :: (instance: *LirExecInstance, failed: *LirExecResult,
    blocks: *void) -> bool {
    if instance != null && instance.ready && instance.initialized && instance.hosts_bound &&
        !instance.running && instance.plan != null && instance.plan.ready {
        entry := instance.plan.program.entry
        if entry != LirNoId && !instance.plan.program.functions[entry].external {
            if !ExecResetRun(instance) {
                <<failed = ExecResult(.Allocation)
                return false
            }
            instance.running = true
            no_arguments: [0]LirExecArgument
            unused ExecRunRoot(instance, entry, no_arguments[:], blocks)
            if ExecEndRun(instance) { return true }
            <<failed = instance.failure
            return false
        }
    }
    <<failed = LirExecRun(instance)
    return failed.problem == .None
}

// LirExecRun with every instruction run by the reference implementation,
// one at a time, instead of the compact code. Both give the same result,
// failure location and remaining work and fuel; tests compare them.
LirExecRunReference :: (instance: *LirExecInstance) -> LirExecResult {
    if instance == null || !instance.ready || instance.plan.program.entry == LirNoId {
        return ExecResult(.NotReady)
    }
    no_arguments: [0]LirExecArgument
    instance.reference = true
    result := ExecRunFunction(instance, instance.plan.program.entry, no_arguments[:])
    instance.reference = false
    return result
}

LirExecCall :: (instance: *LirExecInstance, function: s32, arguments: []LirExecArgument) -> LirExecResult {
    return ExecRunFunction(instance, function, arguments)
}

// Runs the global initializers now, as the first run would. Every later
// run returns their failure.
LirExecInitialize :: (instance: *LirExecInstance) -> LirExecResult {
    no_arguments: [0]LirExecArgument
    return ExecRunFunction(instance, LirNoId, no_arguments[:])
}

// Puts the host image of global `global` in the instance's host bytes
// between runs, as a host call would be given it. They hold it until the
// next call into the instance.
LirExecGlobalImage :: (instance: *LirExecInstance, global: s32) -> LirExecProblem {
    problem := ExecGlobalAccess(instance, global)
    if problem != .None { return problem }
    plan := instance.plan
    type := plan.program.globals[global].type
    size := plan.type_sizes[type]
    available := ExecHostAvailable(instance)
    unused VecResize(instance.host_bytes, 0)
    if size > available { return .ValueBytes }
    if !VecResizeBounded(instance.host_bytes, size, available) { return .Allocation }
    if !ExecHostEncode(instance, type, ExecGlobalBytes(*instance.globals[global]), 0, 0, 0, available, 0) {
        return instance.failure.problem
    }
    return .None
}

// Gives global `global` the value of a host image of its type between runs.
// View elements become read-only instance-owned storage; a rejected image
// leaves none behind.
LirExecGlobalStore :: (instance: *LirExecInstance, global: s32, image: []u8) -> LirExecProblem {
    problem := ExecGlobalAccess(instance, global)
    if problem != .None { return problem }
    plan := instance.plan
    type := plan.program.globals[global].type
    if !plan.program.globals[global].writable { return .Pointer }
    if plan.host_shapes[type] < LirHostShapeViews && image.count != plan.type_sizes[type] { return .Host }
    epoch := instance.heap_epoch
    if !ExecHostDecode(instance, type, image, 0, .Globals, plan.global_offsets[global], 0, global) {
        ExecHostRollback(instance, epoch)
        return instance.failure.problem
    }
    return .None
}

LirExecResultCopy :: (instance: *LirExecInstance, output: []u8) -> bool {
    if instance == null || !instance.ready || instance.result_value.type == LirNoId ||
        output.count < instance.result_bytes.count { return false }
    for index: cast(s64)0..instance.result_bytes.count - 1 { output[index] = instance.result_bytes[index] }
    return true
}

LirExecBindHost :: (instance: *LirExecInstance, function: s32, call: LirExecHostCall, context: *void) -> LirExecProblem {
    if instance == null || !instance.ready || instance.plan == null { return .NotReady }
    if instance.running { return .Busy }
    program := instance.plan.program
    if call == null || function < 0 || function >= program.functions.count ||
        !program.functions[function].external || program.functions[function].calling != .Host ||
        ExecHostBinding(instance, function) >= 0 || !ExecHostSignature(instance.plan, function, false) { return .Calling }
    if !VecPush(instance.hosts, LirExecHostBinding.{function = function, call = call, context = context}) { return .Allocation }
    return .None
}

LirExecBindHostTyped :: (instance: *LirExecInstance, function: s32,
    call: LirExecTypedHostCall, context: *void) -> LirExecProblem {
    if instance == null || !instance.ready || instance.plan == null { return .NotReady }
    if instance.running { return .Busy }
    program := instance.plan.program
    if call == null || function < 0 || function >= program.functions.count ||
        !program.functions[function].external || program.functions[function].calling != .Host ||
        ExecHostBinding(instance, function) >= 0 || !ExecHostSignature(instance.plan, function, true) { return .Calling }
    if !VecPush(instance.hosts, LirExecHostBinding.{function = function, typed = call, context = context}) {
        return .Allocation
    }
    return .None
}

// Binds parameter `parameter` of typed host function `function` as a
// mutable view (see LirExecArgument). The first 64 parameters can be.
LirExecHostMutableView :: (instance: *LirExecInstance, function: s32, parameter: s32) -> LirExecProblem {
    if instance == null || !instance.ready || instance.plan == null { return .NotReady }
    if instance.running { return .Busy }
    binding := ExecHostBinding(instance, function)
    if binding < 0 || instance.hosts[binding].typed == null { return .Calling }
    program := instance.plan.program
    parameters := program.functions[function].parameters
    if parameter < 0 || parameter >= 64 || cast(s64)parameter >= parameters.count ||
        ExecHostParameter(instance.hosts[binding].borrowed_views, parameter) ||
        !LirHostView(program, parameters[parameter]) { return .Calling }
    instance.hosts[binding].views |= cast(u64)1 << cast(u64)parameter
    return .None
}

// Borrow one verified top-level string or scalar slice parameter of a typed
// host call. For a read-only slice, replace the host adapter's mutable view.
LirExecHostBorrowView :: (instance: *LirExecInstance, function: s32, parameter: s32,
    string_view: bool) -> LirExecProblem {
    if instance == null || !instance.ready || instance.plan == null { return .NotReady }
    if instance.running { return .Busy }
    binding := ExecHostBinding(instance, function)
    if binding < 0 || instance.hosts[binding].typed == null { return .Calling }
    program := instance.plan.program
    parameters := program.functions[function].parameters
    if parameter < 0 || parameter >= 64 || cast(s64)parameter >= parameters.count ||
        !LirHostView(program, parameters[parameter]) { return .Calling }
    view := program.types[parameters[parameter]]
    element := program.types[program.types[view.fields[0]].element]
    if string_view {
        if element.kind != .Integer || element.bits != 8 || element.is_signed ||
            ExecHostParameter(instance.hosts[binding].views, parameter) { return .Calling }
    } else if !(element.kind == .Integer &&
        (element.bits == 8 || element.bits == 16 || element.bits == 32 || element.bits == 64) ||
        element.kind == .Float && (element.bits == 32 || element.bits == 64)) { return .Calling }
    mask := cast(u64)1 << cast(u64)parameter
    instance.hosts[binding].views &= ~mask
    instance.hosts[binding].borrowed_views |= mask
    return .None
}

// Bind a bodiless `(u64, *u8, u64) -> void` host function as checked
// platform byte output. Each call borrows exactly `count` bytes from the
// checked data pointer; a null pointer is valid only with count zero.
LirExecBindPlatformWrite :: (instance: *LirExecInstance, function: s32,
    call: LirExecPlatformWrite, context: *void) -> LirExecProblem {
    if instance == null || !instance.ready || instance.plan == null { return .NotReady }
    if instance.running { return .Busy }
    program := instance.plan.program
    if call == null || function < 0 || function >= program.functions.count ||
        !program.functions[function].external || program.functions[function].calling != .Host ||
        ExecHostBinding(instance, function) >= 0 || !ExecPlatformWriteSignature(program, function) { return .Calling }
    if !VecPush(instance.hosts, LirExecHostBinding.{function = function, write = call, context = context}) {
        return .Allocation
    }
    return .None
}

LirExecProblemName :: (problem: LirExecProblem) -> string {
    if problem == .None { return "none" }
    if problem == .InvalidProgram { return "invalid-program" }
    if problem == .NotReady { return "not-ready" }
    if problem == .Busy { return "busy" }
    if problem == .Allocation { return "allocation" }
    if problem == .WorkLimit { return "work-limit" }
    if problem == .FuelLimit { return "fuel-limit" }
    if problem == .FrameLimit { return "frame-limit" }
    if problem == .ValueLimit { return "value-limit" }
    if problem == .AddressLimit { return "address-limit" }
    if problem == .ValueBytes { return "value-bytes" }
    if problem == .Type { return "type" }
    if problem == .Pointer { return "pointer" }
    if problem == .Calling { return "calling" }
    if problem == .DivideByZero { return "divide-by-zero" }
    if problem == .InvalidShift { return "invalid-shift" }
    if problem == .InvalidConversion { return "invalid-conversion" }
    if problem == .Trap { return "trap" }
    if problem == .Unreachable { return "unreachable" }
    if problem == .Host { return "host" }
    if problem == .Cancelled { return "cancelled" }
    return "unsupported"
}
