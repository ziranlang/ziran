// Expression grammar. The frontend owns IR and diagnostics; callbacks let
// this parser control expression grammar without depending on C IR layouts.
Scan :: #import "compiler_scan";
Source :: #import "compiler_source";
Text :: #import "compiler_text";

ExpressionBegin :: #type () -> s64;
ExpressionToken :: #type () -> string;
ExpressionPrefix :: #type () -> s32;
ExpressionAdvance :: #type () -> void;
ExpressionBinary :: #type (start: s64, operator: string, left: s32, right: s32) -> s32;
ExpressionConditionalError :: #type () -> void;
ExpressionHooks :: struct {
    depth: *s32
    failed: *s32
    begin: ExpressionBegin
    token: ExpressionToken
    prefix: ExpressionPrefix
    advance: ExpressionAdvance
    binary: ExpressionBinary
    conditional_error: ExpressionConditionalError
}

BinaryPrecedence :: (operator: string) -> s32 {
    if operator == "||" { return 2 }
    if operator == "&&" { return 3 }
    if operator == "|" { return 4 }
    if operator == "^" { return 5 }
    if operator == "&" { return 6 }
    if operator == "==" || operator == "!=" { return 7 }
    if operator == "<" || operator == "<=" || operator == ">" || operator == ">=" { return 8 }
    if operator == "<<" || operator == ">>" { return 9 }
    if operator == "+" || operator == "-" { return 10 }
    if operator == "*" || operator == "/" || operator == "%" { return 11 }
    return 0
}

// The token callback can borrow a reused frontend buffer. Keep a canonical
// operator spelling before advancing or recursively parsing the right side.
BinarySpelling :: (operator: string) -> string {
    operators: [18]string = .{"||", "&&", "|", "^", "&", "==", "!=", "<", "<=",
        ">", ">=", "<<", ">>", "+", "-", "*", "/", "%"}
    for spelling: operators { if operator == spelling { return spelling } }
    return ""
}

ParseBinary :: (hooks: *ExpressionHooks, minimum: s32) -> s32 {
    begin := hooks.begin
    token := hooks.token
    prefix := hooks.prefix
    advance := hooks.advance
    binary := hooks.binary
    conditional_error := hooks.conditional_error
    start := begin()
    left := prefix()
    <<hooks.depth += 1
    if <<hooks.depth > 128 {
        <<hooks.failed = 1
        <<hooks.depth -= 1
        return -1
    }
    while <<hooks.failed == 0 {
        operator := BinarySpelling(token())
        precedence := BinaryPrecedence(operator)
        if precedence == 0 || precedence < minimum { break }
        advance()
        right := ParseBinary(hooks, precedence + 1)
        left = binary(start, operator, left, right)
    }
    if token() == "?" { conditional_error() }
    <<hooks.depth -= 1
    return left
}

ExpressionKind :: #type () -> Scan.TokenKind;
ExpressionParse :: #type (minimum: s32) -> s32;
ExpressionLink :: #type (previous: s32, next: s32) -> void;
SyntaxCursor :: struct {
    depth: *s32
    failed: *s32
    source: string
    begin: ExpressionBegin
    token: ExpressionToken
    kind: ExpressionKind
    advance: ExpressionAdvance
    parse: ExpressionParse
    link: ExpressionLink
}

PostfixKind :: enum s32 { Index; Slice; Member; Dereference; Call }
PostfixError :: enum s32 { PointerMember; Increment; Question }
PostfixNode :: #type (start: s64, kind: PostfixKind, name: string, left: s32,
    right: s32, third: s32, first: s32) -> s32;
ExpressionArgument :: #type (child: s32, name: string) -> void;
ExpressionChildren :: struct { first: s32; last: s32 }
ExpressionDefaults :: #type (callee: s32, first: s32, last: s32) -> ExpressionChildren;
ExpressionName :: #type (callee: s32) -> string;
PostfixDiagnostic :: #type (error: PostfixError) -> void;
PostfixHooks :: struct {
    cursor: *SyntaxCursor
    node: PostfixNode
    argument: ExpressionArgument
    defaults: ExpressionDefaults
    name: ExpressionName
    error: PostfixDiagnostic
}

ParsePostfix :: (hooks: *PostfixHooks, start: s64, initial: s32) -> s32 {
    cursor := hooks.cursor
    token := cursor.token
    kind := cursor.kind
    begin := cursor.begin
    advance := cursor.advance
    parse := cursor.parse
    link := cursor.link
    node := hooks.node
    argument := hooks.argument
    defaults := hooks.defaults
    callee_name := hooks.name
    error := hooks.error
    result := initial
    while <<cursor.failed == 0 {
        if Take(cursor, "[") {
            low: s32 = -1
            if token() != ":" { low = parse(1) }
            if Take(cursor, ":") {
                high: s32 = -1
                if token() != "]" { high = parse(1) }
                Expect(cursor, "]")
                result = node(start, .Slice, "", result, low, high, -1)
            } else {
                Expect(cursor, "]")
                result = node(start, .Index, "", result, low, -1, -1)
            }
        } else if token() == "->" { error(.PointerMember); break }
        else if Take(cursor, ".") {
            if Take(cursor, "*") {
                result = node(start, .Dereference, "", result, -1, -1, -1)
            } else {
                if kind() != Scan.TokenKind.Ident { <<cursor.failed = 1 }
                name := BorrowToken(cursor.source, cursor)
                advance()
                result = node(start, .Member, name, result, -1, -1, -1)
            }
        } else if Take(cursor, "(") {
            first: s32 = -1
            last: s32 = -1
            callee := result
            name := callee_name(callee)
            if token() != ")" {
                while true {
                    argument_name := ""
                    if kind() == Scan.TokenKind.Ident && Following(cursor.source, cursor, 1) == "=" {
                        argument_name = BorrowToken(cursor.source, cursor)
                        advance()
                        Expect(cursor, "=")
                    }
                    child := parse(1)
                    if child < 0 { <<cursor.failed = 1; break }
                    argument(child, argument_name)
                    if last >= 0 { link(last, child) } else { first = child }
                    last = child
                    if !Take(cursor, ",") { break }
                }
            }
            Expect(cursor, ")")
            if <<cursor.failed == 0 {
                children := defaults(callee, first, last)
                first = children.first
                last = children.last
            }
            result = node(start, .Call, name, callee, -1, -1, first)
        } else if token() == "++" || token() == "--" { error(.Increment); break }
        else if token() == "?" && begin() > 0 && begin() <= cursor.source.count &&
        !Text.SpaceByte(cursor.source[begin() - 1]) { error(.Question); break }
        else { break }
    }
    return result
}

InitializerFieldType :: #type (type: string, name: string, ordinal: s32) -> string;
InitializerField :: #type (start: s64, name: string, named: bool, value: s32) -> s32;
InitializerNode :: #type (start: s64, type: string, first: s32) -> s32;
InitializerHooks :: struct {
    cursor: *SyntaxCursor
    field_type: InitializerFieldType
    field: InitializerField
    node: InitializerNode
}

ParseInitializer :: (hooks: *InitializerHooks, start: s64, type: string,
    open: string, close: string) -> s32 {
    cursor := hooks.cursor
    token := cursor.token
    kind := cursor.kind
    begin := cursor.begin
    advance := cursor.advance
    parse := cursor.parse
    link := cursor.link
    field_type := hooks.field_type
    field := hooks.field
    node := hooks.node
    first: s32 = -1
    last: s32 = -1
    ordinal: s32 = 0
    Expect(cursor, open)
    while <<cursor.failed == 0 && token() != close && kind() != Scan.TokenKind.Eof {
        field_start := begin()
        name := ""
        named := false
        if token() == "." && Following(cursor.source, cursor, 2) == "=" {
            next := Scan.NextToken(cursor.source, begin() + token().count, 1, 1)
            if next.kind == Scan.TokenKind.Ident { advance(); named = true }
        }
        if !named && kind() == Scan.TokenKind.Ident { named = Following(cursor.source, cursor, 1) == "=" }
        if named {
            if kind() != Scan.TokenKind.Ident { <<cursor.failed = 1; break }
            name = BorrowToken(cursor.source, cursor)
            advance()
            Expect(cursor, "=")
        }
        value: s32 = -1
        if token() == "{" {
            nested_type := field_type(type, name, ordinal)
            <<cursor.depth += 1
            if <<cursor.depth > 128 {
                <<cursor.failed = 1
                <<cursor.depth -= 1
                return -1
            }
            value = ParseInitializer(hooks, begin(), nested_type, "{", "}")
            <<cursor.depth -= 1
        } else { value = parse(1) }
        ordinal += 1
        if value < 0 { <<cursor.failed = 1; break }
        child := field(field_start, name, named, value)
        if child < 0 { break }
        if last >= 0 { link(last, child) } else { first = child }
        last = child
        if !Take(cursor, ",") { break }
    }
    Expect(cursor, close)
    return node(start, type, first)
}

PrefixKind :: enum s32 {
    Identifier; Integer; Float; String; This; CompileTime; ProcedureName;
    Character; Conditional; SizeOf; Cast; Unary;
}
PrefixError :: enum s32 {
    ThisScope; CallerLocation; ProcedureScope; Character; Sizeof; Primitive;
    Increment; AddressOf; Cast; Literal; SingleQuote;
}
TypeQuery :: #type (name: string) -> bool;
PrefixArray :: #type (start: s64, element: string) -> s32;
PrefixNode :: #type (start: s64, kind: PrefixKind, name: string, op: string,
    left: s32, right: s32, third: s32, byte: s32) -> s32;
PrefixDiagnostic :: #type (error: PrefixError) -> void;
PrefixHooks :: struct {
    cursor: *SyntaxCursor
    initializers: *InitializerHooks
    postfix: *PostfixHooks
    is_type: TypeQuery
    is_record: TypeQuery
    is_array: TypeQuery
    array: PrefixArray
    node: PrefixNode
    error: PrefixDiagnostic
    scope: string
    expected_type: string
    name_limit: s64
}

// Storage callbacks copy names before returning: qualified names can borrow
// this parser's local buffer, while token names borrow the original source.
ParsePrefix :: (hooks: *PrefixHooks) -> s32 {
    cursor := hooks.cursor
    token := cursor.token
    kind := cursor.kind
    begin := cursor.begin
    advance := cursor.advance
    parse := cursor.parse
    is_type := hooks.is_type
    is_record := hooks.is_record
    is_array := hooks.is_array
    array := hooks.array
    node := hooks.node
    error := hooks.error
    start := begin()
    original := BorrowToken(cursor.source, cursor)
    original_kind := kind()
    result: s32 = -1
    <<cursor.depth += 1
    if <<cursor.depth > 128 {
        <<cursor.failed = 1
        <<cursor.depth -= 1
        return -1
    }
    if Take(cursor, "#this") {
        if hooks.scope.count == 0 { error(.ThisScope) }
        result = node(start, .This, hooks.scope, "", -1, -1, -1, 0)
    } else if token() == "#caller_location" { error(.CallerLocation) }
    else if Take(cursor, "#compile_time") {
        result = node(start, .CompileTime, "", "", -1, -1, -1, 0)
    } else if Take(cursor, "#procedure_name") {
        if hooks.scope.count == 0 { error(.ProcedureScope) }
        Expect(cursor, "(")
        Expect(cursor, ")")
        result = node(start, .ProcedureName, hooks.scope, "", -1, -1, -1, 0)
    } else if Take(cursor, "#char") {
        byte := CharacterByte(token())
        if kind() != Scan.TokenKind.String || byte < 0 { error(.Character) }
        advance()
        result = node(start, .Character, "", "", -1, -1, -1, byte)
    } else if token() == "ifx" || token() == "#ifx" {
        op := "ifx"
        if token() == "#ifx" { op = "#ifx" }
        advance()
        condition := parse(2)
        unused Take(cursor, "then")
        selected := parse(1)
        unused Take(cursor, ";")
        Expect(cursor, "else")
        alternative := parse(1)
        result = node(start, .Conditional, "", op, condition, selected, alternative, 0)
    } else if token() == "sizeof" { error(.Sizeof) }
    else if Take(cursor, "size_of") {
        Expect(cursor, "(")
        type_start := begin()
        nested: s32 = 0
        while kind() != Scan.TokenKind.Eof {
            if token() == ")" && nested == 0 { break }
            if token() == "(" { nested += 1 }
            if token() == ")" { nested -= 1 }
            advance()
        }
        type := TypeRange(cursor.source, cursor, type_start, hooks.name_limit)
        Expect(cursor, ")")
        result = node(start, .SizeOf, type, "", -1, -1, -1, 0)
    } else if Take(cursor, "cast") {
        Expect(cursor, "(")
        type_start := begin()
        if token() == "char" { error(.Primitive) }
        while kind() != Scan.TokenKind.Eof && token() != ")" { advance() }
        type := TypeRange(cursor.source, cursor, type_start, hooks.name_limit)
        if !is_type(type) && (type.count == 0 || (type[0] != 91 && type[0] != 42)) {
            <<cursor.failed = 1
        }
        Expect(cursor, ")")
        right := ParsePrefix(hooks)
        result = node(start, .Cast, type, "", -1, right, -1, 0)
    } else if token() == "++" || token() == "--" { error(.Increment) }
    else if Take(cursor, "<<") {
        right := ParsePrefix(hooks)
        result = node(start, .Unary, "", "*", -1, right, -1, 0)
    } else if token() == "+" || token() == "-" || token() == "!" || token() == "~" || token() == "*" {
        op := UnarySpelling(token())
        advance()
        right := ParsePrefix(hooks)
        result = node(start, .Unary, "", op, -1, right, -1, 0)
    } else if token() == "&" { error(.AddressOf) }
    else if Take(cursor, "(") {
        typed := is_type(token()) || token() == "["
        if typed && token() != "." && Following(cursor.source, cursor, 1) != "." { error(.Cast) }
        result = parse(1)
        Expect(cursor, ")")
        if !typed && token() == "{" { error(.Literal) }
    } else if Take(cursor, ".") {
        if token() == "{" {
            result = ParseInitializer(hooks.initializers, start, "", "{", "}")
        } else if token() == "[" && is_array(hooks.expected_type) {
            result = ParseInitializer(hooks.initializers, start, hooks.expected_type, "[", "]")
        } else if kind() != Scan.TokenKind.Ident { <<cursor.failed = 1 }
        else {
            buffer: [256]u8
            name := QualifiedName(buffer[:], "", BorrowToken(cursor.source, cursor), hooks.name_limit)
            if name.count == 0 { <<cursor.failed = 1 }
            advance()
            if <<cursor.failed == 0 { result = node(start, .Identifier, name, "", -1, -1, -1, 0) }
        }
    } else {
        primary := PrefixKind.Identifier
        if original_kind == Scan.TokenKind.Int { primary = .Integer }
        else if original_kind == Scan.TokenKind.Float { primary = .Float }
        else if original_kind == Scan.TokenKind.String { primary = .String }
        else if original_kind == Scan.TokenKind.Char { error(.SingleQuote) }
        else if original_kind != Scan.TokenKind.Ident {
            <<cursor.failed = 1
            <<cursor.depth -= 1
            return -1
        }
        advance()
        if primary == .Identifier && token() == "." {
            following := Following(cursor.source, cursor, 1)
            if following == "{" {
                if !is_record(original) { <<cursor.failed = 1 }
                advance()
                result = ParseInitializer(hooks.initializers, start, original, "{", "}")
            } else if following == "[" && is_type(original) {
                advance()
                result = array(start, original)
            } else {
                next := Scan.NextToken(cursor.source, begin() + token().count, 1, 1)
                if next.kind == Scan.TokenKind.Ident && Following(cursor.source, cursor, 2) == "." {
                    buffer: [256]u8
                    qualified := QualifiedName(buffer[:], original, following, hooks.name_limit)
                    opener := Following(cursor.source, cursor, 3)
                    if qualified.count > 0 && is_type(qualified) && (opener == "[" || opener == "{") {
                        advance()
                        advance()
                        advance()
                        if opener == "[" { result = array(start, qualified) }
                        else if !is_record(qualified) { <<cursor.failed = 1 }
                        else { result = ParseInitializer(hooks.initializers, start, qualified, "{", "}") }
                    }
                }
            }
        }
        if result < 0 && <<cursor.failed == 0 {
            name := ""
            if primary == .Identifier { name = original }
            result = node(start, primary, name, "", -1, -1, -1, 0)
        }
    }
    result = ParsePostfix(hooks.postfix, start, result)
    <<cursor.depth -= 1
    return result
}

CharacterByte :: (literal: string) -> s32 {
    if literal.count == 3 && literal[0] == 34 && literal[2] == 34 && literal[1] < 128 {
        return cast(s32)literal[1]
    }
    if literal.count == 4 && literal[0] == 34 && literal[1] == 92 && literal[3] == 34 {
        escape := literal[2]
        if escape == 48 { return 0 }
        if escape == 110 { return 10 }
        if escape == 114 { return 13 }
        if escape == 116 { return 9 }
        if escape == 34 { return 34 }
        if escape == 92 { return 92 }
        return -1
    }
    if literal.count == 6 && literal[0] == 34 && literal[1] == 92 &&
    literal[2] == 120 && literal[5] == 34 {
        high := Hex(literal[3])
        low := Hex(literal[4])
        if high >= 0 && low >= 0 { return high * 16 + low }
    }
    return -1
}

StatementExpressionError :: enum s32 { None; Modifier; ArrayLiteral }
StatementExpression :: struct {
    name: string
    type: string
    value: string
    lhs: string
    assignment: string
    modifier: string
    has_declaration: bool
    has_value: bool
    is_else: bool
    error: StatementExpressionError
}

StatementParts :: (source: string, kind: Source.StatementKind) -> StatementExpression {
    result: StatementExpression
    result.is_else = kind == Source.StatementKind.If && WordAt(source, 0, "else")
    if kind == Source.StatementKind.Declaration {
        colon := FindByte(source, 58)
        if colon >= 0 {
            result.has_declaration = true
            result.name = Trim(source[0:colon])
            type := source[colon + 1:]
            equals := FindByte(type, 61)
            if equals >= 0 {
                result.has_value = true
                result.value = type[equals + 1:]
                type = type[0:equals]
            }
            type = Trim(type)
            if type.count > 0 && type[type.count - 1] == 59 { type = Trim(type[0:type.count - 1]) }
            result.type = type
            modifier := FindByte(type, 35)
            if modifier >= 0 {
                result.error = .Modifier
                result.modifier = type[modifier:]
                return result
            }
        }
    } else if kind == Source.StatementKind.Assignment {
        at: s64 = 0
        while at < source.count {
            token := Scan.NextToken(source, at, 1, 1)
            if token.kind == Scan.TokenKind.Eof { break }
            operator := source[token.begin:token.end]
            if AssignmentOperator(operator) {
                result.assignment = operator
                result.lhs = source[0:token.begin]
                result.value = source[token.end:]
                result.has_value = true
                break
            }
            at = token.end
        }
    } else if kind == Source.StatementKind.Return || kind == Source.StatementKind.Unused {
        if source.count >= 6 { result.value = source[6:]; result.has_value = true }
    } else if kind == Source.StatementKind.Expression {
        result.value = source
        result.has_value = true
    } else if kind == Source.StatementKind.IfCase {
        if source.count >= 2 {
            condition := SkipSpace(source[2:])
            if condition.count > 9 && condition[0:9] == "#complete" && Text.SpaceByte(condition[9]) {
                condition = SkipSpace(condition[9:])
            }
            equals := FindPair(condition, "==")
            if equals >= 0 { condition = Trim(condition[0:equals]) }
            result.value = condition
            result.has_value = true
        }
    } else if kind == Source.StatementKind.While || kind == Source.StatementKind.If {
        condition := source[0:Text.BlockHeaderEnd(source)]
        if condition.count >= 4 && condition[0:4] == "else" { condition = SkipSpace(condition[4:]) }
        at: s64 = 0
        while at < condition.count && !Text.SpaceByte(condition[at]) && condition[at] != 40 { at += 1 }
        result.value = condition[at:]
        result.has_value = true
    }
    if result.has_value && SkipSpace(result.value) == ";" { result.has_value = false }
    if result.has_value && kind == Source.StatementKind.Declaration && result.type.count > 0 && result.type[0] == 91 {
        value := SkipSpace(result.value)
        if value.count > 0 && value[0] == 123 { result.error = .ArrayLiteral }
    }
    return result
}

#scope_file
UnarySpelling :: (operator: string) -> string {
    if operator == "*" { return "&" }
    if operator == "+" { return "+" }
    if operator == "-" { return "-" }
    if operator == "!" { return "!" }
    return "~"
}
TypeRange :: (source: string, cursor: *SyntaxCursor, start: s64, limit: s64) -> string {
    begin := cursor.begin
    end := begin()
    if start < 0 || end < start || end > source.count || end - start >= limit {
        <<cursor.failed = 1
        return ""
    }
    return Trim(source[start:end])
}
QualifiedName :: (output: []u8, first: string, second: string, limit: s64) -> string {
    count := first.count + 1 + second.count
    if count >= limit || count > output.count { return "" }
    for index: 0..first.count - 1 { output[index] = first[index] }
    output[first.count] = 46
    for index: 0..second.count - 1 { output[first.count + 1 + index] = second[index] }
    return TextView(output[0:count])
}
Take :: (cursor: *SyntaxCursor, wanted: string) -> bool {
    token := cursor.token
    advance := cursor.advance
    if token() != wanted { return false }
    advance()
    return true
}
Expect :: (cursor: *SyntaxCursor, wanted: string) {
    if !Take(cursor, wanted) { <<cursor.failed = 1 }
}
BorrowToken :: (source: string, cursor: *SyntaxCursor) -> string {
    begin := cursor.begin
    token := cursor.token
    at := begin()
    count := token().count
    if at < 0 || at > cursor.source.count || count > cursor.source.count - at {
        <<cursor.failed = 1
        return ""
    }
    return source[at:at + count]
}
Following :: (source: string, cursor: *SyntaxCursor, distance: s32) -> string {
    begin := cursor.begin
    token := cursor.token
    at := begin() + token().count
    following: Scan.Scan
    for index: 1..distance {
        following = Scan.NextToken(cursor.source, at, 1, 1)
        at = following.end
    }
    return source[following.begin:following.end]
}
Hex :: (byte: u8) -> s32 {
    if byte >= 48 && byte <= 57 { return cast(s32)(byte - 48) }
    if byte >= 65 && byte <= 70 { return cast(s32)(byte - 65) + 10 }
    if byte >= 97 && byte <= 102 { return cast(s32)(byte - 97) + 10 }
    return -1
}
Trim :: (source: string) -> string {
    range := Text.TrimRange(source)
    return source[range.begin:range.end]
}
SkipSpace :: (source: string) -> string { return source[Text.TrimRange(source).begin:] }
FindByte :: (source: string, wanted: u8) -> s64 {
    for at: 0..source.count - 1 { if source[at] == wanted { return at } }
    return -1
}
FindPair :: (source: string, wanted: string) -> s64 {
    for at: 0..source.count - 2 { if source[at:at + 2] == wanted { return at } }
    return -1
}
WordAt :: (source: string, at: s64, word: string) -> bool {
    return at >= 0 && word.count <= source.count - at && source[at:at + word.count] == word &&
        (at + word.count == source.count || Text.SpaceByte(source[at + word.count]))
}
AssignmentOperator :: (operator: string) -> bool {
    return operator == "=" || operator == "+=" || operator == "-=" || operator == "*=" ||
        operator == "/=" || operator == "%=" || operator == "&=" || operator == "|=" ||
        operator == "^=" || operator == "<<=" || operator == ">>="
}
