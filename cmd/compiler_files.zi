#scope_export
#program_export "PathIsAbsolute"
PathIsAbsolute :: (path: *u8) -> s32 {
    if path == null || path[0] == 0 { return 0 }
    if path[0] == 47 { return 1 }
    if S15HostOS() != 1 { return 0 }
    if path[0] == 92 && path[1] == 92 { return 1 }
    return cast(s32)(isalpha(cast(s32)path[0]) != 0 && path[1] == 58 && (path[2] == 47 || path[2] == 92))
}

#scope_export
#program_export "CanonicalPath"
CanonicalPath :: (path: *u8) -> *u8 {
    if S15HostOS() != 1 { return cast(*u8)CompilerOwn(cast(*void)S15RealPath(path, null)) }
    file := S15WindowsPathOpen(path)
    if file == null { return null }
    capacity: u32 = 261
    result := cast(*u8)CompilerMalloc(cast(usize)capacity)
    length: u32
    if result != null { length = S15WindowsFinalPath(file, result, capacity) }
    if length >= capacity && length < cast(u32)4294967295 {
        capacity = length + 1
        grown := cast(*u8)CompilerRealloc(cast(*void)result, cast(usize)capacity)
        if grown != null {
            result = grown
            length = S15WindowsFinalPath(file, result, capacity)
        } else { length = 0 }
    }
    S15WindowsPathClose(file)
    if length == 0 || length >= capacity { CompilerFree(cast(*void)result); return null }
    if strncmp(result, WindowsPrefix(true), 8) == 0 {
        memmove(cast(*void)(cast(usize)result + 2), cast(*void)(cast(usize)result + 8), cast(usize)length - 7)
        result[0] = 47; result[1] = 47
    } else if strncmp(result, WindowsPrefix(false), 4) == 0 {
        memmove(cast(*void)result, cast(*void)(cast(usize)result + 4), cast(usize)length - 3)
    }
    at: usize
    while result[at] != 0 { if result[at] == 92 { result[at] = 47 }; at += 1 }
    return result
}

#scope_export
#program_export "ExecutablePath"
ExecutablePath :: (output: *u8, capacity: usize) -> s32 {
    if output == null || capacity < 2 || capacity > cast(usize)2147483647 { return 0 }
    length: usize
    os := S15HostOS()
    if os == 1 {
        length = cast(usize)S15WindowsExecutablePath(output, cast(u32)capacity)
        if length == 0 || length >= capacity { output[0] = 0; return 0 }
        at: usize
        while at < length { if output[at] == 92 { output[at] = 47 }; at += 1 }
    } else if os == 2 {
        maximum := S15PathMax()
        unresolved := cast(*u8)CompilerMalloc(maximum)
        if unresolved == null { output[0] = 0; return 0 }
        defer CompilerFree(cast(*void)unresolved)
        resolved := cast(*u8)CompilerMalloc(maximum)
        if resolved == null { output[0] = 0; return 0 }
        defer CompilerFree(cast(*void)resolved)
        size := cast(u32)maximum
        if S15DarwinExecutablePath(unresolved, *size) == 0 && S15RealPath(unresolved, resolved) != null { length = strlen(resolved) }
        if length == 0 || length >= capacity - 1 { output[0] = 0; return 0 }
        memcpy(cast(*void)output, cast(*void)resolved, length)
    } else {
        size := S15ReadLink(ParserCString("/proc/self/exe"), output, capacity - 1)
        if size <= 0 || cast(usize)size >= capacity - 1 { output[0] = 0; return 0 }
        length = cast(usize)size
    }
    output[length] = 0
    return cast(s32)length
}

#scope_export
#program_export "DuplicatePrefix"
DuplicatePrefix :: (text: *u8, limit: usize) -> *u8 {
    length: usize = cast(usize)(0)
    while check_loop_24 := ((length < limit) && (cast(s32)(cast(s8)((text)[length])) != 0)) {
        S15SupportPost4(*(length))
    }
    if (length == (cast(usize)(cast(u64)18446744073709551615))) {
        return null
    }
    result: *u8 = cast(*u8)(CompilerMalloc((length + cast(usize)(1))))
    if (result != cast(*u8)((null))) {
        memcpy(cast(*void)(result), cast(*void)(text), length)
        (result)[length] = cast(u8)(0)
    }
    return result
    unreachable
}

#scope_export
#program_export "ReadFileLine"
ReadFileLine :: (file: *void, line: **u8, capacity: *usize) -> s32 {
    length: usize = cast(usize)(0)
    value: s32
    while check_loop_25 := ((S15SupportSet5(*(value), fgetc(file))) != ((-1))) {
        if ((length + cast(usize)(1)) >= (capacity)[0]) {
            next: usize = (ifx ((capacity)[0] < cast(usize)(128)) then cast(usize)(128) else ((capacity)[0] * cast(usize)(2)))
            if (next <= (capacity)[0]) {
                return (-1)
            }
            grown: *u8 = cast(*u8)(CompilerRealloc(cast(*void)((line)[0]), next))
            if (grown == cast(*u8)((null))) {
                return (-1)
            }
            S15SupportSet6(line, grown)
            S15SupportSet0(capacity, next)
        }
        (((line)[0]))[S15SupportPost4(*(length))] = cast(u8)(value)
        if (value == 10) {
            break check_loop_25
        }
    }
    if (ferror(file) != 0) {
        return (-1)
    }
    if (length == cast(usize)(0)) {
        return 0
    }
    (((line)[0]))[length] = cast(u8)(0)
    return 1
    unreachable
}

#scope_export
#program_export "FileStatusNoLinks"
FileStatusNoLinks :: (path: *u8, info: *void) -> s32 {
    if S15HostOS() == 1 {
        attributes := S15WindowsAttributes(path)
        if attributes == cast(u32)4294967295 || (attributes & 1024) != 0 { return -1 }
        return S15FileStat(path, info, 1)
    }
    if S15FileStat(path, info, 0) != 0 || S15StatIsLink(info) != 0 { return -1 }
    return 0
}

#scope_file
unc_prefix: [9]u8 = .{92,92,63,92,85,78,67,92,0};
path_prefix: [5]u8 = .{92,92,63,92,0};
WindowsPrefix :: (unc: bool) -> *u8 {
