CoreSlice :: (data: *$T, count: s64) -> []T {
    result: []T
    raw := cast(*CoreSliceStorage)(*result)
    raw.data = cast(*void)data
    raw.count = count
    return result
}
CoreSliceStorage :: struct { data: *void; count: s64 }

type_text :: (source: *u8) -> string { return IR.CText(source) }

CompilerThreadEnter :: (thread: *Support.CompilerThread, context_local: *u8) -> CompilerScope {
    scope := CompilerScope.{context_local = cast(*u8)thread.context_local, memory = thread.memory}
    thread.memory = null
    thread.context_local = cast(*Support.CompilerContext)context_local
    return scope
}
CompilerThreadLeave :: (thread: *Support.CompilerThread, scope: CompilerScope) {
    thread.memory = scope.memory
    thread.context_local = cast(*Support.CompilerContext)scope.context_local
}

lookup_kind_names: [3]string = .{"type", "procedure", "constant"};
bit_builtins: [5]string = .{"", "zi_clz", "zi_ctz", "zi_popcount", "zi_bswap"};

builtin_types: [4]IR.ZirType;
builtin_types_lock: u8;
builtin_names: [4]string = .{"Source_Code_Location", "OS", "CPU", "TARGET"};
builtin_bodies: [4]string = .{
    "fully_pathed_filename: string;\nline_number: s64;\ncolumn_number: s64;\n",
    "NONE,\nLINUX,\nWINDOWS,\nMACOS,\nANDROID,\nWEB\n",
    "NONE,\nX64,\nARM64,\nWASM32\n",
    "C,\nGO,\nWASM,\nZX\n"
};

#scope_export
#program_export "BuiltinType"
BuiltinType :: (name: *u8) -> *IR.ZirType {
    source := IR.CText(name)
    for i: 0..3 {
        if source != builtin_names[i] { continue }
        while CompilerAtomicFlagTestAndSet(*builtin_types_lock) {}
        record := *builtin_types[i]
        if record.is_public == 0 {
            IR.CopyText(record.name[:], builtin_names[i])
            IR.CopyText(record.body[:], builtin_bodies[i])
            if i != 0 {
                record.is_enum = 1
                IR.CopyText(record.enum_backing[:], "s32")
            }
            record.is_public = 1
        }
        CompilerAtomicFlagClear(*builtin_types_lock)
        return record
    }
    return null
}

#scope_file
SameGeneratedPath :: (left: *u8, right: *u8) -> bool {
    a := left
    b := right
    while a[0] != 0 && b[0] != 0 {
        if a[0] != b[0] { return false }
        c := a[0]
        a = cast(*u8)(cast(usize)a + 1)
        b = cast(*u8)(cast(usize)b + 1)
        if c == #char "/" {
            while a[0] == #char "/" { a = cast(*u8)(cast(usize)a + 1) }
            while b[0] == #char "/" { b = cast(*u8)(cast(usize)b + 1) }
        }
    }
    return a[0] == b[0]
}

#scope_file
same_file_bytes :: (left: *u8, right: *u8) -> s32 {
    buffers := cast(*SameFileBytesBuffers)ParserScratchTake(*same_file_scratch, size_of(SameFileBytesBuffers))
    defer ParserScratchRelease(*same_file_scratch, cast(*void)buffers)
    return same_file_bytes_with_buffers(left, right, buffers)
}

CompilerDirectoryOpen :: (path: *u8) -> *void #foreign compiler "CompilerDirectoryOpen";
CompilerDirectoryNext :: (directory: *void) -> *u8 #foreign compiler "CompilerDirectoryNext";
CompilerDirectoryClose :: (directory: *void) #foreign compiler "CompilerDirectoryClose";
CompilerPathEntryKind :: (path: *u8) -> s32 #foreign compiler "CompilerPathEntryKind";

// Only regular files can carry a marker. Hidden entries and directories
// reached through links are skipped by the target's directory policy.
prune_generated :: (directory_path: *u8, marker: *u8, depth: s32) -> s32 {
    directory := CompilerDirectoryOpen(directory_path)
    if directory == null { return 0 }
    defer CompilerDirectoryClose(directory)
    failed := false
    while true {
        name := CompilerDirectoryNext(directory)
        if name == null { break }
        if name[0] == #char "." { continue }
        path: [4096]u8
        size := snprintf(*path[0], size_of(type_of(path)), ParserCString("%s/%s"), directory_path, name)
        if size < 0 || size >= 4096 { continue }
        kind := CompilerPathEntryKind(*path[0])
        if kind == 2 {
            if depth < 32 && prune_generated(*path[0], marker, depth+1) != 0 { failed = true }
            continue
        }
        if kind != 1 { continue }
        outputs := context_outputs()
        written := false
        for i: 0..outputs.count-1 {
            if SameGeneratedPath(outputs.paths[i], *path[0]) { written = true; break }
        }
        if !written && starts_with_marker(*path[0], marker) != 0 && remove(*path[0]) != 0 { failed = true }
    }
    return ifx failed then -1 else 0
}


#scope_export
#program_export "MapTypeParts"
MapTypeParts :: (module: *IR.ZirModule, name: *u8, key: *u8, key_size: usize, value: *u8, value_size: usize) -> s32 {
    type: *IR.ZirType = (ifx (module != null) then FindType(module, name, null) else null)
    if (((((((type == cast(*IR.ZirType)((null))) || !((type).is_map != 0)) || ((type).is_record_template != 0)) || ((type).is_extern != 0)) || ((type).is_enum != 0)) || ((type).is_procedure_type != 0)) || ((type).is_union != 0)) {
        return 0
    }
    k: IR.ZirTypeField
    v: IR.ZirTypeField
    end: IR.ZirTypeField
    offset: usize = cast(usize)(0)
    if (((((((((((TypeNextField(type, *(offset), *(k)) != 1) || (strcmp(cast(*u8)(*((k).name)), ParserCString("key")) != 0)) || (TypeNextField(type, *(offset), *(v)) != 1)) || (strcmp(cast(*u8)(*((v).name)), ParserCString("value")) != 0)) || (TypeNextField(type, *(offset), *(end)) != 0)) || ((k).is_using != 0)) || ((v).is_using != 0)) || (((k).go_tag)[0] != 0)) || (((v).go_tag)[0] != 0)) || !(((k).type)[0] != 0)) || !(((v).type)[0] != 0)) {
        return 0
    }
    if (key != cast(*u8)((null))) {
        if (strlen(cast(*u8)(*((k).type))) >= key_size) {
            return 0
        }
        strcpy(key, cast(*u8)(*((k).type)))
    }
    if (value != cast(*u8)((null))) {
        if (strlen(cast(*u8)(*((v).type))) >= value_size) {
            return 0
        }
        strcpy(value, cast(*u8)(*((v).type)))
    }
    return 1
}


#scope_export
#program_export "MapKeyComparable"
MapKeyComparable :: (module: *IR.ZirModule, type: *u8, depth: s32) -> s32 {
    if ((depth > 32) || !(strcmp(type, ParserCString("void")) != 0)) {
        return 0
    }
    if (cast(s32)(cast(s8)((type)[0])) == 42) {
        return 1
    }
    if ((ScalarType(type))[0] != 0) {
        return cast(s32)(strcmp(type, ParserCString("void")) != 0)
    }
    element: CoreArray128_u8
    if (ArrayElementType(type, cast(*u8)(*((element).items)), cast(usize)size_of(CoreArray128_u8), null) != 0) {
        return MapKeyComparable(module, cast(*u8)(*((element).items)), (depth + 1))
    }
    owner: *IR.ZirModule = null
    record: *IR.ZirType = FindType(module, type, *(owner))
    if (((((((record == cast(*IR.ZirType)((null))) || ((record).is_map != 0)) || ((record).is_owned_vec != 0)) || ((record).is_extern != 0)) || ((record).is_procedure_type != 0)) || ((record).is_record_template != 0)) || ((record).is_union != 0)) {
        return 0
    }
    if ((record).is_enum != 0) {
        return 1
    }
    offset: usize = cast(usize)(0)
    field: IR.ZirTypeField
    status: s32
    while check_loop_1 := ((ParserSet0(*(status), TypeNextField(record, *(offset), *(field)))) == 1) {
        if !(MapKeyComparable((ifx (owner != null) then owner else module), cast(*u8)(*((field).type)), (depth + 1)) != 0) {
            return 0
        }
    }
    return cast(s32)(status == 0)
}


#scope_file
same_map_argument :: (a_owner: *IR.ZirModule, a_name: *u8, b_owner: *IR.ZirModule, b_name: *u8, depth: s32) -> s32 {
    if (depth > 32) {
        return 0
    }
    a_scalar: *u8 = ScalarType(a_name)
    b_scalar: *u8 = ScalarType(b_name)
    if (((a_scalar)[0] != 0) || ((b_scalar)[0] != 0)) {
        return cast(s32)(!(strcmp(a_scalar, b_scalar) != 0))
    }
    a_element: CoreArray128_u8
    b_element: CoreArray128_u8
    a_count: s32
    b_count: s32
    if ((SliceElementType(a_name, cast(*u8)(*((a_element).items)), cast(usize)size_of(CoreArray128_u8)) != 0) && (SliceElementType(b_name, cast(*u8)(*((b_element).items)), cast(usize)size_of(CoreArray128_u8)) != 0)) {
        return same_map_argument(a_owner, cast(*u8)(*((a_element).items)), b_owner, cast(*u8)(*((b_element).items)), (depth + 1))
    }
    if ((ArrayElementType(a_name, cast(*u8)(*((a_element).items)), cast(usize)size_of(CoreArray128_u8), *(a_count)) != 0) && (ArrayElementType(b_name, cast(*u8)(*((b_element).items)), cast(usize)size_of(CoreArray128_u8), *(b_count)) != 0)) {
        return cast(s32)(((a_count >= 0) && (a_count == b_count)) && (same_map_argument(a_owner, cast(*u8)(*((a_element).items)), b_owner, cast(*u8)(*((b_element).items)), (depth + 1)) != 0))
    }
    if ((cast(s32)(cast(s8)((a_name)[0])) == 42) && (cast(s32)(cast(s8)((b_name)[0])) == 42)) {
        return same_map_argument(a_owner, cast(*u8)(cast(usize)(a_name) + cast(usize)(1) * size_of(u8)), b_owner, cast(*u8)(cast(usize)(b_name) + cast(usize)(1) * size_of(u8)), (depth + 1))
    }
    a_scope: *IR.ZirModule = null
    b_scope: *IR.ZirModule = null
    a: *IR.ZirType = FindType(a_owner, a_name, *(a_scope))
    b: *IR.ZirType = FindType(b_owner, b_name, *(b_scope))
    if ((a == cast(*IR.ZirType)((null))) || (b == cast(*IR.ZirType)((null)))) {
        return 0
    }
    if (a == b) {
        return 1
    }
    if ((((a).foreign_target)[0] != 0) && !(strcmp(cast(*u8)(*((a).foreign_target)), cast(*u8)(*((b).foreign_target))) != 0)) {
        return 1
    }
    if (((a).is_map != 0) && ((b).is_map != 0)) {
        ak: CoreArray128_u8
        av: CoreArray128_u8
        bk: CoreArray128_u8
        bv: CoreArray128_u8
        return cast(s32)((((MapTypeParts(a_owner, a_name, cast(*u8)(*((ak).items)), cast(usize)size_of(CoreArray128_u8), cast(*u8)(*((av).items)), cast(usize)size_of(CoreArray128_u8)) != 0) && (MapTypeParts(b_owner, b_name, cast(*u8)(*((bk).items)), cast(usize)size_of(CoreArray128_u8), cast(*u8)(*((bv).items)), cast(usize)size_of(CoreArray128_u8)) != 0)) && (same_map_argument((ifx (a_scope != null) then a_scope else a_owner), cast(*u8)(*((ak).items)), (ifx (b_scope != null) then b_scope else b_owner), cast(*u8)(*((bk).items)), (depth + 1)) != 0)) && (same_map_argument((ifx (a_scope != null) then a_scope else a_owner), cast(*u8)(*((av).items)), (ifx (b_scope != null) then b_scope else b_owner), cast(*u8)(*((bv).items)), (depth + 1)) != 0))
    }
    return same_type_application(a_scope, a, b_scope, b)
}


#scope_export
#program_export "SameMapType"
SameMapType :: (a_owner: *IR.ZirModule, a: *IR.ZirType, b_owner: *IR.ZirModule, b: *IR.ZirType) -> s32 {
    return cast(s32)(((((a != cast(*IR.ZirType)((null))) && (b != cast(*IR.ZirType)((null)))) && ((a).is_map != 0)) && ((b).is_map != 0)) && (same_map_argument(a_owner, cast(*u8)(*((a).name)), b_owner, cast(*u8)(*((b).name)), 0) != 0))
}


