ForeignVisit :: struct {
    module: *IR.ZirModule
    name: *u8
    next: *ForeignVisit
}

ResolveForeignDepth :: (module: *IR.ZirModule, name: *u8, source_path: *u8,
                        exported_only: bool, visits: *ForeignVisit,
                        owner: **IR.ZirModule, declaration: **IR.ZirImport) -> s32 {
    owner[0] = null; declaration[0] = null
