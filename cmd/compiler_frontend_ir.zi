    while previous != null {
        if previous.module == module && strcmp(previous.name, name) == 0 { return 0 }
        previous = previous.next
    }
    visit := ForeignVisit.{module = module, name = name, next = visits}
    dot := strchr(name, 46)
    if dot == name || (dot != null && dot[1] == 0) { return 0 }
    if dot == null {
        for index: cast(s32)0..module.import_count - 1 {
            candidate := *module.imports[index]
            if candidate.kind != .EXTERN || strcmp(*candidate.name[0], name) != 0 ||
               file_scope_visible_at(source_path, candidate.is_file_private, candidate.span) == 0 ||
               (exported_only && (candidate.is_public == 0 || candidate.is_file_private != 0)) { continue }
            if declaration[0] != null && declaration[0] != candidate { return -1 }
            owner[0] = module; declaration[0] = candidate
        }
        if declaration[0] != null { return 1 }
    }
    for index: cast(s32)0..module.import_count - 1 {
        binding := *module.imports[index]
        if binding.resolved_module == null ||
           file_scope_visible_at(source_path, binding.is_file_private, binding.span) == 0 ||
           (exported_only && binding.is_file_private != 0) { continue }
        wanted := name
        if dot != null {
            length := cast(usize)dot - cast(usize)name
            if binding.kind != .MODULE || strlen(*binding.name[0]) != length ||
               strncmp(*binding.name[0], name, length) != 0 { continue }
            wanted = cast(*u8)(cast(usize)dot + 1)
        } else if !((binding.kind == .OPEN && !exported_only) ||
                    (binding.kind == .MODULE && binding.is_using != 0)) { continue }
        nested_owner: *IR.ZirModule = null
        nested: *IR.ZirImport = null
        status := ResolveForeignDepth(binding.resolved_module, wanted, null, true, *visit,
                                      *nested_owner, *nested)
        if status < 0 || (status > 0 && declaration[0] != null && declaration[0] != nested) { return -1 }
        if status > 0 { owner[0] = nested_owner; declaration[0] = nested }
    }
    return cast(s32)(declaration[0] != null)
}

