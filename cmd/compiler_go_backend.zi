StaticText :: struct { data: *u8; length: usize }
CStr :: (s: string) -> *u8 { return (cast(*StaticText)(*s)).data }
FunctionArgs :: (fn: *IR.ZirFunction) -> *u8 { return ifx fn.args_text != null then fn.args_text else CStr("") }
StatementHasAssembly :: (st: *IR.ZirStmt) -> s32 { return cast(s32)(st.kind == .BLOCK_OPEN && st.assembly_text != null && st.assembly_text[0] != 0) }
GoLowerState :: struct {
    conv_arg_buffer: [8192]u8
    g_enum_count: s32
    g_enums: *ZirGoEnum
    g_extern_count: s32
    g_externs: [64]ZirGoExtern
    g_function_count: s32
    g_functions: [4096]ZirGoGlobalFunction
    g_guard: [256]u8
    g_union_unsafe: s32
    type_scope: *IR.ZirModule
    zir_go_local_count: s32
    zir_go_locals: [256]ZirGoLocalName
}
parse_extern_import_scratch_key: u8 = 0;
parse_enum_scratch_key: u8 = 0;
tx_group_scratch_key: u8 = 0;
tx_expr_scratch_key: u8 = 0;
lower_function_scratch_key: u8 = 0;
go_lower_in_context_scratch_key: u8 = 0;


enum_storage_type :: (ctx: *GoLowerState, backing: *u8) -> *u8 {
    types: [8]GoEnumStorage = .{.{name = CStr("s8"), go_type = CStr("int8")}, .{name = CStr("u8"), go_type = CStr("uint8")}, .{name = CStr("s16"), go_type = CStr("int16")}, .{name = CStr("u16"), go_type = CStr("uint16")}, .{name = CStr("s32"), go_type = CStr("int32")}, .{name = CStr("u32"), go_type = CStr("uint32")}, .{name = CStr("s64"), go_type = CStr("int64")}, .{name = CStr("u64"), go_type = CStr("uint64")}}
    {
        i: usize = cast(usize)(0)
        while true {
            if !((i < (size_of([8]GoEnumStorage) / size_of(GoEnumStorage)))) { break }
            if (strcmp(backing, ((types)[i]).name) == 0) {
                return ((types)[i]).go_type
            }
            i += 1
        }
    }
    return cast(*u8)(null)
}

mkdir_parent :: (ctx: *GoLowerState, path: *u8) {
    tmp: [1024]u8
    i: usize
    snprintf(*(tmp)[0], size_of([1024]u8), CStr("%s"), path)
    {
        i = cast(usize)(1)
        while true {
            if !((i < strlen(*(tmp)[0]))) { break }
            if ((tmp)[i] == #char "/") {
                (tmp)[i] = 0
                mkdir(*(tmp)[0], cast(u32)(493))
                (tmp)[i] = #char "/"
            }
            i += 1
        }
    }
}

go_local_name_for :: (ctx: *GoLowerState, name: *u8) -> *u8 {
    {
        i: s32 = (ctx.zir_go_local_count - 1)
        while true {
            if !((i >= 0)) { break }
            if (strcmp(*(((ctx.zir_go_locals)[i]).source)[0], name) == 0) {
                return *(((ctx.zir_go_locals)[i]).go)[0]
            }
            i -= 1
        }
    }
    return cast(*u8)(null)
}

go_register_local_name :: (ctx: *GoLowerState, fn: *IR.ZirFunction, name: *u8) {
    mapped: [256]u8
    if ((name == cast(*u8)(null)) || ((name)[0] == 0)) {
        return
    }
    {
        i: s32 = 0
        while true {
            if !((i < ctx.zir_go_local_count)) { break }
            if (strcmp(*(((ctx.zir_go_locals)[i]).source)[0], name) == 0) {
                return
            }
            i += 1
        }
    }
    TargetBindingName(fn, cast(s32)(Native.ZirTarget.ZIR_GO), name, *(mapped)[0], size_of([256]u8))
    if ((strcmp(*(mapped)[0], name) == 0) || (ctx.zir_go_local_count >= 256)) {
        return
    }
    snprintf(*(((ctx.zir_go_locals)[ctx.zir_go_local_count]).source)[0], size_of([256]u8), CStr("%s"), name)
    snprintf(*(((ctx.zir_go_locals)[ctx.zir_go_local_count]).go)[0], size_of([256]u8), CStr("%s"), *(mapped)[0])
    ctx.zir_go_local_count += 1
}

scalar_byte_width :: (ctx: *GoLowerState, type: *u8) -> usize {
    return ScalarByteWidth(type)
}

go_type :: (ctx: *GoLowerState, type: *u8, dst: *u8, dst_size: usize) -> s32 {
    return NativeGoType(ctx.type_scope, type, dst, dst_size)
}

require_go_type :: (ctx: *GoLowerState, type: *u8, dst: *u8, size: usize, span: IR.ZirSourceSpan) {
    if (go_type(ctx, type, dst, size) != 0) {
        return
    }
    Diagnostic(span, CStr("zir_go.type"), CStr("unsupported or unresolved Go type: %s"), type)
    exit(1)
}

module_fn_index :: (ctx: *GoLowerState, m: *IR.ZirModule, name: *u8, len: usize) -> s32 {
    {
        i: s32 = 0
        while true {
            if !((i < (m).function_count)) { break }
            if ((strlen(*((((m).functions)[i]).name)[0]) == len) && (strncmp(*((((m).functions)[i]).name)[0], name, len) == 0)) {
                return i
            }
            i += 1
        }
    }
    return -(1)
}

go_global_function_index :: (ctx: *GoLowerState, module: *IR.ZirModule, name: *u8, len: usize) -> s32 {
    ident: [128]u8
    owner: *IR.ZirModule = cast(*IR.ZirModule)(null)
    function: *IR.ZirFunction = cast(*IR.ZirFunction)(null)
    if (len >= size_of([128]u8)) {
        return -(1)
    }
    memcpy(cast(*void)(*(ident)[0]), cast(*void)(name), len)
    (ident)[len] = 0
    if (CResolveFunction(module, *(ident)[0], *(owner), *(function)) != 1) {
        return -(1)
    }
    {
        i: s32 = 0
        while true {
            if !((i < ctx.g_function_count)) { break }
            if ((((ctx.g_functions)[i]).module == owner) && (strcmp(*(((ctx.g_functions)[i]).source)[0], *((function).name)[0]) == 0)) {
                return i
            }
            i += 1
        }
    }
    return -(1)
}

go_bound_provider :: (ctx: *GoLowerState, module: *u8, function: *u8) -> *u8 {
    {
        i: s32 = 0
        while true {
            if !((i < ctx.g_function_count)) { break }
            if ((strcmp(*((((ctx.g_functions)[i]).module).name)[0], module) == 0) && (strcmp(*(((ctx.g_functions)[i]).source)[0], function) == 0)) {
                return *(((ctx.g_functions)[i]).go)[0]
            }
            i += 1
        }
    }
    return cast(*u8)(null)
}

go_build_global_functions :: (ctx: *GoLowerState, progs: **IR.ZirProgram, prog_count: s32) {
    ctx.g_function_count = 0
    {
        pi: s32 = 0
        while true {
            if !((pi < prog_count)) { break }
            prog: *IR.ZirProgram = (progs)[pi]
            {
                mi: s32 = 0
                while true {
                    if !((mi < (prog).module_count)) { break }
                    m: *IR.ZirModule = *(((prog).modules)[mi])
                    stem: [1024]u8
                    guard: [256]u8
                    NativeGoModuleIdentity(progs, prog_count, m, *(stem)[0], size_of([1024]u8), *(guard)[0], size_of([256]u8))
                    {
                        fi: s32 = 0
                        while true {
                            if !((fi < (m).function_count)) { break }
                            fn: *IR.ZirFunction = *(((m).functions)[fi])
                            fname: [256]u8
                            if ((((fn).is_extern != 0) || ((fn).is_template != 0)) || (ctx.g_function_count >= 4096)) {
                                fi += 1
                                continue
                            }
                            camel_ident(*((fn).name)[0], *(fname)[0], size_of([256]u8))
                            snprintf(*(((ctx.g_functions)[ctx.g_function_count]).source)[0], size_of([256]u8), CStr("%s"), *((fn).name)[0])
                            snprintf(*(((ctx.g_functions)[ctx.g_function_count]).guard)[0], size_of([256]u8), CStr("%s"), *(guard)[0])
                            snprintf(*(((ctx.g_functions)[ctx.g_function_count]).go)[0], size_of([512]u8), CStr("%s_%s"), *(guard)[0], *(fname)[0])
                            ((ctx.g_functions)[ctx.g_function_count]).module = m
                            ((ctx.g_functions)[ctx.g_function_count]).declaration = fn
                            ctx.g_function_count += 1
                            fi += 1
                        }
                    }
                    mi += 1
                }
            }
            pi += 1
        }
    }
}

go_validate_exports :: (ctx: *GoLowerState, programs: **IR.ZirProgram, count: s32) -> s32 {
    reserved: [58]*u8 = .{CStr("_"), CStr("init"), CStr("main"), CStr("any"), CStr("bool"), CStr("byte"), CStr("comparable"), CStr("complex64"), CStr("complex128"), CStr("error"), CStr("float32"), CStr("float64"), CStr("int"), CStr("int8"), CStr("int16"), CStr("int32"), CStr("int64"), CStr("rune"), CStr("string"), CStr("uint"), CStr("uint8"), CStr("uint16"), CStr("uint32"), CStr("uint64"), CStr("uintptr"), CStr("true"), CStr("false"), CStr("iota"), CStr("nil"), CStr("append"), CStr("cap"), CStr("clear"), CStr("close"), CStr("complex"), CStr("copy"), CStr("delete"), CStr("imag"), CStr("len"), CStr("make"), CStr("max"), CStr("min"), CStr("new"), CStr("panic"), CStr("print"), CStr("println"), CStr("real"), CStr("recover"), CStr("unsafe"), CStr("signedBits"), CStr("wrapAdd"), CStr("wrapSub"), CStr("wrapMul"), CStr("floatToInt"), CStr("integerOp"), CStr("shiftCount"), CStr("zirGoCgoEnabled"), CStr("zirGoAssemblyEnabled"), cast(*u8)(null)}
    {
        i: s32 = 0
        while true {
            if !((i < ctx.g_function_count)) { break }
            function: *IR.ZirFunction = ((ctx.g_functions)[i]).declaration
            symbol: *u8 = *((function).export_symbol)[0]
            if !(((symbol)[0] != 0)) {
                i += 1
                continue
            }
            mapped: [256]u8
            TargetBindingName(cast(*IR.ZirFunction)(null), cast(s32)(Native.ZirTarget.ZIR_GO), symbol, *(mapped)[0], size_of([256]u8))
            invalid: s32 = cast(s32)((strcmp(symbol, *(mapped)[0]) != 0))
            {
                name: s32 = 0
                while true {
                    if !(((reserved)[name] != null)) { break }
                    invalid = (invalid | cast(s32)(!((strcmp(symbol, (reserved)[name]) != 0))))
                    name += 1
                }
            }
            if (invalid != 0) {
                Diagnostic((function).span, CStr("zir_go.export"), CStr("reserved native Go export name: %s"), symbol)
                return 0
            }
            {
                other: s32 = 0
                while true {
                    if !((other < ctx.g_function_count)) { break }
                    if (!((strcmp(symbol, *(((ctx.g_functions)[other]).go)[0]) != 0)) || ((other != i) && !((strcmp(symbol, *((((ctx.g_functions)[other]).declaration).export_symbol)[0]) != 0)))) {
                        Diagnostic((function).span, CStr("zir_go.export"), CStr("duplicate native Go export name: %s"), symbol)
                        return 0
                    }
                    other += 1
                }
            }
            {
                p: s32 = 0
                while true {
                    if !((p < count)) { break }
                    {
                        m: s32 = 0
                        while true {
                            if !((m < ((programs)[p]).module_count)) { break }
                            module: *IR.ZirModule = *((((programs)[p]).modules)[m])
                            stem: [1024]u8
                            guard: [256]u8
                            generated: [512]u8
                            NativeGoModuleIdentity(programs, count, module, *(stem)[0], size_of([1024]u8), *(guard)[0], size_of([256]u8))
                            if (ModuleNeedsStartup(module) != 0) {
                                snprintf(*(generated)[0], size_of([512]u8), CStr("%s_ziranInit"), *(guard)[0])
                                collision: s32 = cast(s32)(!((strcmp(symbol, *(generated)[0]) != 0)))
                                snprintf(*(generated)[0], size_of([512]u8), CStr("%s_ziranInitState"), *(guard)[0])
                                if ((collision != 0) || !((strcmp(symbol, *(generated)[0]) != 0))) {
                                    Diagnostic((function).span, CStr("zir_go.export"), CStr("native Go export collides with module startup: %s"), symbol)
                                    return 0
                                }
                            }
                            {
                                t: s32 = 0
                                while true {
                                    if !((t < (module).type_count)) { break }
                                    NativeTypeName(module, *(((module).types)[t]), *(mapped)[0], size_of([256]u8))
                                    if (!((strcmp(symbol, *(mapped)[0]) != 0)) || !((strcmp(symbol, *((((module).types)[t]).name)[0]) != 0))) {
                                        Diagnostic((function).span, CStr("zir_go.export"), CStr("native Go export collides with type: %s"), symbol)
                                        return 0
                                    }
                                    t += 1
                                }
                            }
                            m += 1
                        }
                    }
                    p += 1
                }
            }
            i += 1
        }
    }
    return 1
}

go_validate_export_import :: (ctx: *GoLowerState, declaration: *u8) -> s32 {
    alias: [256]u8
    if (((sscanf(declaration, CStr("%255s"), *(alias)[0]) != 1) || ((alias)[0] == #char "\"")) || !((strcmp(*(alias)[0], CStr("_")) != 0))) {
        return 1
    }
    {
        i: s32 = 0
        while true {
            if !((i < ctx.g_function_count)) { break }
            function: *IR.ZirFunction = ((ctx.g_functions)[i]).declaration
            if !((strcmp(*((function).export_symbol)[0], *(alias)[0]) != 0)) {
                Diagnostic((function).span, CStr("zir_go.export"), CStr("native Go export collides with import: %s"), *(alias)[0])
                return 0
            }
            i += 1
        }
    }
    return 1
}

go_module_uses_testing :: (ctx: *GoLowerState, module: *IR.ZirModule, visited: *GoTestModules) -> s32 {
    if (module == cast(*IR.ZirModule)(null)) {
        return 0
    }
    {
        i: usize = cast(usize)(0)
        while true {
            if !((i < (visited).count)) { break }
            if (((visited).modules)[i] == module) {
                return 0
            }
            i += 1
        }
    }
    if ((visited).count == (visited).capacity) {
        capacity: usize = (ifx ((visited).capacity != 0) then ((visited).capacity * cast(usize)(2)) else cast(usize)(16))
        modules: **IR.ZirModule = cast(**IR.ZirModule)(realloc(cast(*void)((visited).modules), (capacity * size_of(*IR.ZirModule))))
        if (modules == cast(**IR.ZirModule)(null)) {
            Diagnostic((module).span, CStr("zir_go.tests"), CStr("out of memory classifying Go tests"))
            exit(1)
        }
        (visited).modules = modules
        (visited).capacity = capacity
    }
    post1: usize = (visited).count
    (visited).count += 1
    ((visited).modules)[post1] = module
    {
        t: s32 = 0
        while true {
            if !((t < (module).type_count)) { break }
            if !((strncmp(*((((module).types)[t]).foreign_target)[0], CStr("go:testing."), cast(usize)(11)) != 0)) {
                return 1
            }
            t += 1
        }
    }
    {
        i: s32 = 0
        while true {
            if !((i < (module).import_count)) { break }
            if !((strncmp(*((((module).imports)[i]).target)[0], CStr("go:testing."), cast(usize)(11)) != 0)) {
                return 1
            }
            i += 1
        }
    }
    {
        f: s32 = 0
        while true {
            if !((f < (module).function_count)) { break }
            name: *u8 = *((((module).functions)[f]).export_symbol)[0]
            if ((!((strncmp(name, CStr("Test"), cast(usize)(4)) != 0)) || !((strncmp(name, CStr("Fuzz"), cast(usize)(4)) != 0))) || !((strncmp(name, CStr("Benchmark"), cast(usize)(9)) != 0))) {
                return 1
            }
            f += 1
        }
    }
    {
        i: s32 = 0
        while true {
            if !((i < (module).import_count)) { break }
            if (go_module_uses_testing(ctx, (((module).imports)[i]).resolved_module, visited) != 0) {
                return 1
            }
            i += 1
        }
    }
    return 0
}

go_module_is_native_test :: (ctx: *GoLowerState, module: *IR.ZirModule) -> s32 {
    length: usize = strlen(*((module).source_path)[0])
    if ((length < cast(usize)(8)) || (strcmp(cast(*u8)(cast(usize)(cast(*u8)(cast(usize)(*((module).source_path)[0]) + cast(usize)(length) * size_of(u8))) - cast(usize)(8) * size_of(u8)), CStr("_test.zi")) != 0)) {
        return 0
    }
    visited: GoTestModules = .{}
    result: s32 = go_module_uses_testing(ctx, module, *(visited))
    free(cast(*void)((visited).modules))
    return result
}

go_export_testing_type :: (ctx: *GoLowerState, module: *IR.ZirModule, source: *u8, out: *u8, size: usize) -> s32 {
    source = skip_ws(source)
    if ((source)[0] != #char "*") {
        return 0
    }
    type: *IR.ZirType = CFindType(module, skip_ws(cast(*u8)(cast(usize)(source) + cast(usize)(1) * size_of(u8))), cast(**IR.ZirModule)(null))
    if ((type == cast(*IR.ZirType)(null)) || (strncmp(*((type).foreign_target)[0], CStr("go:testing."), cast(usize)(11)) != 0)) {
        return 0
    }
    name: *u8 = cast(*u8)(cast(usize)(*((type).foreign_target)[0]) + cast(usize)(11) * size_of(u8))
    if (((name)[1] != 0) || (((((name)[0] != #char "T") && ((name)[0] != #char "F")) && ((name)[0] != #char "B")) && ((name)[0] != #char "M"))) {
        return 0
    }
    snprintf(out, size, CStr("*testing.%s"), name)
    return 1
}

go_exports_use_testing :: (ctx: *GoLowerState, module: *IR.ZirModule) -> s32 {
    {
        f: s32 = 0
        while true {
            if !((f < (module).function_count)) { break }
            function: *IR.ZirFunction = *(((module).functions)[f])
            if !((((function).export_symbol)[0] != 0)) {
                f += 1
                continue
            }
            parameters: *ZirParameters = ParametersOf(FunctionArgs(function))
            {
                p: s32 = 0
                while true {
                    if !((p < (parameters).count)) { break }
                    type: [256]u8
                    if (go_export_testing_type(ctx, module, (((parameters).items)[p]).type, *(type)[0], size_of([256]u8)) != 0) {
                        return 1
                    }
                    p += 1
                }
            }
            f += 1
        }
    }
    return 0
}

