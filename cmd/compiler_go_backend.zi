                                    exit(1)
                                }
                                fprintf(f, CStr("type %s %s\n\n"), *((e).go_type)[0], backing)
                                fprintf(f, CStr("const (\n"))
                                {
                                    mI: s32 = 0
                                    while true {
                                        if !((mI < (e).count)) { break }
                                        mem: *ZirGoEnumMember = *(((e).members)[mI])
                                        if (((mem).val)[0] != 0) {
                                            tx_expr(ctx, m, *((mem).val)[0], *((buffers).val)[0], size_of([8192]u8))
                                        } else {
                                            if (mI == 0) {
                                                snprintf(*((buffers).val)[0], size_of([8192]u8), CStr("0"))
                                            } else {
                                                snprintf(*((buffers).val)[0], size_of([8192]u8), CStr("%s + 1"), *((((e).members)[(mI - 1)]).go)[0])
                                            }
                                        }
                                        fprintf(f, CStr("\t%s = %s\n"), *((mem).go)[0], *((buffers).val)[0])
                                        mI += 1
                                    }
                                }
                                fprintf(f, CStr(")\n\n"))
                            } else {
                                fprintf(f, CStr("type %s %sstruct {\n"), *(native)[0], (ifx ((t).is_go_anonymous != 0) then CStr("= ") else CStr("")))
                                {
                                    offset: usize = cast(usize)(0)
                                    field: IR.ZirTypeField
                                    status: s32
                                    while true {
                                        status = TypeNextField(t, *(offset), *(field))
                                        if !((status == 1)) { break }
                                        fname: [256]u8
                                        gt: [256]u8
                                        go_field_ident(*((field).name)[0], *(fname)[0], size_of([256]u8))
                                        require_go_field_type(ctx, t, *(field), *(gt)[0], size_of([256]u8))
                                        fprintf(f, CStr("\t%s %s"), *(fname)[0], *(gt)[0])
                                        emit_field_tag(ctx, f, *(field), (t).span)
                                        fputc(cast(s32)(#char "\n"), f)
                                    }
                                    if (status < 0) {
                                        Diagnostic((t).span, CStr("zir_go.type"), CStr("malformed field in %s"), *((t).name)[0])
                                        exit(1)
                                    }
                                }
                                fprintf(f, CStr("}\n\n"))
                            }
                            i += 1
                        }
                    }
                    emit_go_foreign_adapters(ctx, f, m)
                    if !((header_module != 0)) {
                        emit_go_c_adapters(ctx, f, m)
                    }
                    {
                        i: s32 = 0
                        while true {
                            if !((i < (m).define_count)) { break }
                            cname: [256]u8
                            value: *u8 = skip_ws((((m).defines)[i]).value)
                            TargetDefineName(m, cast(s32)(Native.ZirTarget.ZIR_GO), *((((m).defines)[i]).name)[0], *(cname)[0], size_of([256]u8))
                            if (ArrayTypeAlias(value) != 0) {
                                aliased: [256]u8
                                require_go_type(ctx, value, *(aliased)[0], size_of([256]u8), (((m).defines)[i]).span)
                                fprintf(f, CStr("type %s %s\n"), *(cname)[0], *(aliased)[0])
                                i += 1
                                continue
                            }
                            if (DefineIsAggregate(m, *(((m).defines)[i])) != 0) {
                                i += 1
                                continue
                            }
                            // A string constant still has its checked Zi value, but
                            // Go needs a counted view over zero-terminated storage.
                            // Evaluate aliases in their source scope as well.
                            checked_literal: *u8 = null
                            if EvaluateCompileLiteral(m, value, m.defines[i].span, 0, *checked_literal, null) != 0 &&
                               checked_literal != null {
                                value = checked_literal
                            }
                            if (strlen(value) >= cast(usize)((8192 / 4))) {
                                capacity: usize = ((strlen(value) * cast(usize)(4)) + cast(usize)(64))
                                literal: *u8 = cast(*u8)(malloc(capacity))
                                if (literal == cast(*u8)(null)) {
                                    exit(1)
                                }
                                if !((ScalarLiteral(CStr("string"), value, cast(s32)(Native.ZirTarget.ZIR_GO), (((m).defines)[i]).span, literal, capacity) != 0)) {
                                    Diagnostic((((m).defines)[i]).span, CStr("zir_go.global"), CStr("cannot lower long constant %s"), *((((m).defines)[i]).name)[0])
                                    exit(1)
                                }
                                fprintf(f, CStr("var %s = %s\n"), *(cname)[0], literal)
                                free(cast(*void)(literal))
                                i += 1
                                continue
                            }
                            if value[0] == #char "\"" &&
                               ScalarLiteral(CStr("string"), value, cast(s32)Native.ZirTarget.ZIR_GO,
                                             m.defines[i].span, *buffers.cval[0], 8192) != 0 {
                                fprintf(f, CStr("var %s = %s\n"), *cname[0], *buffers.cval[0])
                                i += 1
                                continue
                            }
                            tx_expr(ctx, m, value, *((buffers).cval)[0], size_of([8192]u8))
                            fprintf(f, CStr("const %s = %s\n"), *(cname)[0], *((buffers).cval)[0])
                            i += 1
                        }
                    }
                    {
                        i: s32 = 0
                        while true {
                            if !((i < (m).global_count)) { break }
                            g: *IR.ZirGlobal = *(((m).globals)[i])
                            gname: [256]u8
                            gt: [256]u8
                            TargetGlobalName(m, cast(s32)(Native.ZirTarget.ZIR_GO), *((g).name)[0], *(gname)[0], size_of([256]u8))
                            require_go_type(ctx, *((g).type)[0], *(gt)[0], size_of([256]u8), (g).span)
                            if ((strlen((g).init) >= cast(usize)((8192 / 4))) && !((strcmp(*((g).type)[0], CStr("string")) != 0))) {
                                capacity: usize = ((strlen((g).init) * cast(usize)(4)) + cast(usize)(64))
                                literal: *u8 = cast(*u8)(malloc(capacity))
                                if (literal == cast(*u8)(null)) {
                                    exit(1)
                                }
                                if !((ScalarLiteral(*((g).type)[0], (g).init, cast(s32)(Native.ZirTarget.ZIR_GO), (g).span, literal, capacity) != 0)) {
                                    Diagnostic((g).span, CStr("zir_go.global"), CStr("cannot lower long global %s"), *((g).name)[0])
                                    exit(1)
                                }
                                fprintf(f, CStr("var %s %s = %s\n"), *(gname)[0], *(gt)[0], literal)
                                free(cast(*void)(literal))
                                i += 1
                                continue
                            }
                            compound_text: *u8 = cast(*u8)(null)
                            if !((ScalarLiteral(*((g).type)[0], (g).init, cast(s32)(Native.ZirTarget.ZIR_GO), (g).span, *((buffers).ginit)[0], size_of([8192]u8)) != 0)) {
                                compound: s32 = 0
                                rewrite: GlobalRewrite = .{state = ctx, global = g}
                                compound_text = EmitGlobalInitializerText(m, g, cast(s32)(Native.ZirTarget.ZIR_GO), rewrite_global_scalar, rewrite_global_type, rewrite_global_field, cast(*void)(*rewrite), *(compound))
                                if (compound < 0) {
                                    Diagnostic((g).span, CStr("zir_go.global"), CStr("cannot lower compound global initializer: %s"), *((g).name)[0])
                                    exit(1)
                                }
                                if (compound == 0) {
                                    tx_expr(ctx, m, (g).init, *((buffers).ginit)[0], size_of([8192]u8))
                                }
                            }
                            ginit: *u8 = (ifx (compound_text != cast(*u8)(null)) then compound_text else *((buffers).ginit)[0])
                            if ((ginit)[0] != 0) {
                                if ((ginit)[0] == #char "{") {
                                    fprintf(f, CStr("var %s = %s%s\n"), *(gname)[0], *(gt)[0], ginit)
                                } else {
                                    fprintf(f, CStr("var %s %s = %s\n"), *(gname)[0], *(gt)[0], ginit)
                                }
                            } else {
                                fprintf(f, CStr("var %s %s\n"), *(gname)[0], *(gt)[0])
                            }
                            free(cast(*void)(compound_text))
                            i += 1
                        }
                    }
                    assembly: *Asm.GoAssembly = GoAssemblyOpen(progs, prog_count, m)
                    {
                        i: s32 = 0
                        while true {
                            if !((i < (m).function_count)) { break }
                            if (((((m).functions)[i]).is_extern != 0) || ((((m).functions)[i]).is_template != 0)) {
                                i += 1
                                continue
                            }
                            lower_function(ctx, f, m, *(((m).functions)[i]), *(guard)[0], assembly)
                            emit_go_method(ctx, f, m, *(((m).functions)[i]), *(guard)[0])
                            i += 1
                        }
                    }
                    startup_count: s32 = 0
                    {
                        i: s32 = 0
                        while true {
                            if !((i < (m).function_count)) { break }
                            startup_count = (startup_count + (((m).functions)[i]).is_global_initializer)
                            i += 1
                        }
                    }
                    if (ModuleNeedsStartup(m) != 0) {
                        dependency_count: s32 = 0
                        dependencies := ModuleStartupDependencies(m, *dependency_count)
                        fprintf(f, CStr("var %s_ziranInitState uint8\nfunc %s_ziranInit() {\n\tif %s_ziranInitState == 2 { return }\n\tif %s_ziranInitState == 1 { panic(\"cyclic module startup\") }\n\t%s_ziranInitState = 1\n"), *(guard)[0], *(guard)[0], *(guard)[0], *(guard)[0], *(guard)[0])
                        {
                            i: s32 = 0
                            while true {
                                if !((i < dependency_count)) { break }
                                dep_guard: [256]u8
                                NativeGoModuleIdentity(progs, prog_count, dependencies[i], *((buffers).stem_2)[0], size_of([1024]u8), *(dep_guard)[0], size_of([256]u8))
                                fprintf(f, CStr("\t%s_ziranInit()\n"), *(dep_guard)[0])
                                i += 1
                            }
                        }
                        free(cast(*void)dependencies)
                        {
                            i: s32 = 0
                            while true {
                                if !((i < (m).function_count)) { break }
                                if ((((m).functions)[i]).is_global_initializer != 0) {
                                    name: [256]u8
                                    camel_ident(*((((m).functions)[i]).name)[0], *(name)[0], size_of([256]u8))
                                    fprintf(f, CStr("\t%s_%s()\n"), *(guard)[0], *(name)[0])
                                }
                                i += 1
                            }
                        }
                        fprintf(f, CStr("\t%s_ziranInitState = 2\n}\n\n"), *(guard)[0])
                        if (startup_count != 0) {
                            fprintf(f, CStr("func init() { %s_ziranInit() }\n\n"), *(guard)[0])
                        }
                    }
                    {
                        tables: *u8 = EmitConstantTablesEnd()
                        if ((tables != cast(*u8)(null)) && ((tables)[0] != 0)) {
                            fputs(tables, f)
                        }
                        free(cast(*void)(tables))
                    }
                    if (TextStreamClose(*(stream)) != 0) {
                        Diagnostic((m).span, CStr("zir_go.global"), CStr("cannot finish Go output: %s"), *((buffers).path)[0])
                        GoAssemblyClose(assembly)
                        return 1
                    }
                    helper_stream: TextStream
                    helpers: *u8 = cast(*u8)(null)
                    helper_length: usize = cast(usize)(0)
                    f = TextStreamOpen(*(helper_stream), *(helpers), *(helper_length))
                    if (f == null) {
                        free(cast(*void)(text))
                        Diagnostic((m).span, CStr("zir_go.global"), CStr("cannot create Go output: %s"), *((buffers).path)[0])
                        GoAssemblyClose(assembly)
                        return 1
                    }
                    EmitGoNumberHelpers(f, text, *(number_helpers))
                    GoSimdCollect(text)
                    if (TextStreamClose(*(helper_stream)) != 0) {
                        free(cast(*void)(text))
                        Diagnostic((m).span, CStr("zir_go.global"), CStr("cannot finish Go output: %s"), *((buffers).path)[0])
                        GoAssemblyClose(assembly)
                        return 1
                    }
                    tail: *u8 = (ifx (helper_length != 0) then helpers else text)
                    remaining: *usize = (ifx (helper_length != 0) then *(helper_length) else *(length))
                    while true {
                        if !(((((remaining)[0] > cast(usize)(1)) && ((tail)[((remaining)[0] - cast(usize)(2))] == #char "\n")) && ((tail)[((remaining)[0] - cast(usize)(1))] == #char "\n"))) { break }
                        (remaining)[0] -= 1
                    }
                    GeneratedOutputRecord(*((buffers).path)[0])
                    output: *void = fopen(*((buffers).path)[0], CStr("wb"))
                    if (output == null) {
                        Diagnostic((m).span, CStr("zir_go.global"), CStr("cannot create Go output: %s"), *((buffers).path)[0])
                        free(cast(*void)(text))
                        free(cast(*void)(helpers))
                        GoAssemblyClose(assembly)
                        return 1
                    }
                    failed: s32 = cast(s32)((fwrite(cast(*void)(text), cast(usize)(1), length, output) != length))
                    if (!((failed != 0)) && (helper_length != 0)) {
                        failed = cast(s32)((fwrite(cast(*void)(helpers), cast(usize)(1), helper_length, output) != helper_length))
                    }
                    failed = (failed | cast(s32)((fclose(output) != 0)))
                    free(cast(*void)(text))
                    free(cast(*void)(helpers))
                    if (failed != 0) {
                        Diagnostic((m).span, CStr("zir_go.global"), CStr("cannot finish Go output: %s"), *((buffers).path)[0])
                        GoAssemblyClose(assembly)
                        return 1
                    }
                    if (emit_go_c_header_stub(ctx, progs, pi, mi, m, *((buffers).path)[0], pkg) != 0) {
                        GoAssemblyClose(assembly)
                        return 1
                    }
                    if (emit_go_c_header_implementation(ctx, progs, pi, mi, m, *((buffers).path)[0], pkg) != 0) {
                        GoAssemblyClose(assembly)
                        return 1
                    }
                    assembly_failed: s32 = GoAssemblyWrite(assembly, *((buffers).path)[0], pkg)
                    GoAssemblyClose(assembly)
                    if (assembly_failed != 0) {
                        return 1
                    }
                    mi += 1
                }
            }
            pi += 1
        }
    }
    if (GoSimdWrite(out_dir, pkg) != 0) {
        return 1
    }
    if ((((assembly_present != 0) && (prog_count != 0)) && (((progs)[0]).module_count != 0)) && (GoAssemblyAvailability(out_dir, pkg, ((((progs)[0]).modules)[0]).span) != 0)) {
        return 1
    }
    {
        pi: s32 = 0
        while true {
            if !((pi < prog_count)) { break }
            {
                mi: s32 = 0
                while true {
                    if !((mi < ((progs)[pi]).module_count)) { break }
                    module: *IR.ZirModule = *((((progs)[pi]).modules)[mi])
                    {
                        i: s32 = 0
                        while true {
                            if !((i < (module).import_count)) { break }
                            if (((((module).imports)[i]).kind == IR.ZirImportKind.EXTERN) && !((strcmp(*((((module).imports)[i]).target)[0], CStr("go:builtin.cgo_enabled")) != 0))) {
                                return emit_go_cgo_availability(ctx, module, out_dir, pkg)
                            }
                            i += 1
                        }
                    }
                    mi += 1
                }
            }
            pi += 1
        }
    }
    return 0
}

LowerInState :: (ctx: *GoLowerState, progs: **IR.ZirProgram, prog_count: s32, root: *u8, out_dir: *u8, pkg: *u8, no_main: s32) -> s32 {
    scratch_hint: *void = CompilerContextScratch(cast(*void)(*go_lower_in_context_scratch_key), FreeBuffer)
    buffers: *GoLowerBuffers = cast(*GoLowerBuffers)(CompilerScratchTake(scratch_hint))
    if !((buffers != null)) {
        buffers = cast(*GoLowerBuffers)(AllocateOrExit(size_of(GoLowerBuffers)))
    }
    profile_started: u64 = ProfileStart()
    returned: s32 = go_lower_with_buffers(ctx, progs, prog_count, root, out_dir, pkg, no_main, buffers)
    clear_enum_context(ctx)
    ProfileEnd(CStr("emit.go"), profile_started)
    if !((CompilerScratchPut(scratch_hint, cast(*void)(buffers)) != 0)) {
        free(cast(*void)(buffers))
    }
    return returned
}

LowerSelected :: (ctx: *GoLowerState, progs: **IR.ZirProgram, prog_count: s32, root: *u8, out_dir: *u8, pkg: *u8, no_main: s32) -> s32 {
    previous: *void = CompilerContextSelect((ifx (((prog_count > 0) && (progs != null)) && ((progs)[0] != null)) then cast(*void)((progs)[0]).context else null))
    result: s32 = LowerInState(ctx, progs, prog_count, root, out_dir, pkg, no_main)
    CompilerContextSelect(previous)
    return result
}

GoAssemblyBlock :: (out: *void, module: *IR.ZirModule, function: *IR.ZirFunction, statement: s32, context: *void) -> s32 #foreign compiler "GoAssemblyBlock";
// Shared callback payload while lowering one global initializer.
GlobalRewrite :: struct { state: *GoLowerState; global: *IR.ZirGlobal }
FreeBuffer :: (memory: *void) { free(memory) }

#scope_export
#program_export "go_lower_in_context"
GoLowerInContext :: (programs: **IR.ZirProgram, count: s32, root: *u8, output: *u8, package: *u8, no_main: s32) -> s32 {
    ctx := cast(*GoLowerState)AllocateOrExit(size_of(GoLowerState))
    memset(cast(*void)ctx, 0, size_of(GoLowerState))
    result := LowerInState(ctx, programs, count, root, output, package, no_main)
    free(cast(*void)ctx)
    return result
}

#program_export "go_lower"
GoLower :: (programs: **IR.ZirProgram, count: s32, root: *u8, output: *u8, package: *u8, no_main: s32) -> s32 {
    ctx := cast(*GoLowerState)AllocateOrExit(size_of(GoLowerState))
    memset(cast(*void)ctx, 0, size_of(GoLowerState))
    result := LowerSelected(ctx, programs, count, root, output, package, no_main)
    free(cast(*void)ctx)
    return result
}

#scope_file
EmitGoAssemblyBlock :: (out: *void, module: *IR.ZirModule, function: *IR.ZirFunction, statement: s32, context: *void) -> s32 {
    return GoAssemblyBlock(out, module, function, statement, context)
}
