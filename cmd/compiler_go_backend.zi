                procedure: *IR.ZirType = CFindType(module, *((binding).ret)[0], *(owner))
                arguments: *ZirParameters = ParametersOf(*((procedure).body)[0])
                saved_scope: *IR.ZirModule = ctx.type_scope
                ctx.type_scope = (ifx (owner != null) then owner else module)
                fputs(CStr("\treturn func("), out)
                {
                    p: s32 = 0
                    while true {
                        if !((p < (arguments).count)) { break }
                        native_type: [256]u8
                        require_go_type(ctx, (((arguments).items)[p]).type, *(native_type)[0], size_of([256]u8), (module).span)
                        fprintf(out, CStr("%sargument%d %s"), (ifx (p != 0) then CStr(", ") else CStr("")), p, *(native_type)[0])
                        p += 1
                    }
                }
                native_result: [256]u8
                require_go_type(ctx, *((procedure).procedure_return_type)[0], *(native_result)[0], size_of([256]u8), (module).span)
                ctx.type_scope = saved_scope
                fprintf(out, CStr(") %s {\n\t\t%s"), *(native_result)[0], (ifx ((native_result)[0] != 0) then CStr("return ") else CStr("")))
                parameter: [256]u8
                camel_ident(((((binding).parameters).items)[0]).name, *(parameter)[0], size_of([256]u8))
                fprintf(out, CStr("%s("), *(parameter)[0])
                {
                    p: s32 = 1
                    while true {
                        if !((p < (binding).pcount)) { break }
                        camel_ident(((((binding).parameters).items)[p]).name, *(parameter)[0], size_of([256]u8))
                        fprintf(out, CStr("%s%s"), (ifx (p > 1) then CStr(", ") else CStr("")), *(parameter)[0])
                        p += 1
                    }
                }
                {
                    p: s32 = 0
                    while true {
                        if !((p < (arguments).count)) { break }
                        fprintf(out, CStr(", argument%d"), p)
                        p += 1
                    }
