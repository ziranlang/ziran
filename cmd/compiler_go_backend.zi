TxExprBuffers :: struct {
    out: [8192]u8
    mapped: [512]u8
    raw: [8192]u8
    arg: [8192]u8
    fname: [512]u8
}

GoBodySymbols :: struct {
    module: *IR.ZirModule
    source_path: *u8
    state: *GoLowerState
}

LowerFunctionBuffers :: struct {
    fname: [512]u8
}

GoCScalar :: struct {
    source: *u8
    c: *u8
}

GoCHeaders :: struct {
    paths: [64][1024]u8
    count: s32
}

GoLowerBuffers :: struct {
    path: [1024]u8
    stem: [512]u8
    imports: [64][1288]u8
    val: [8192]u8
    cval: [8192]u8
    ginit: [8192]u8
