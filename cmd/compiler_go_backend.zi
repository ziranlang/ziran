        fputs(CStr(" ("), out)
        while true {
            if !((TypeNextField(result_record, *(offset), *(field)) == 1)) { break }
            native_type: [256]u8
            require_go_type(ctx, *((field).type)[0], *(native_type)[0], size_of([256]u8), (fn).span)
            post59: s32 = fields
            fields += 1
            fprintf(out, CStr("%s%s"), (ifx (post59 != 0) then CStr(", ") else CStr("")), *(native_type)[0])
        }
        fputs(CStr(")"), out)
        ctx.type_scope = saved_scope
    } else {
        native_type: [256]u8
        require_go_type(ctx, *((fn).return_type)[0], *(native_type)[0], size_of([256]u8), (fn).span)
        if ((native_type)[0] != 0) {
            fprintf(out, CStr(" %s"), *(native_type)[0])
        }
    }
    fputs(CStr(" {\n\t"), out)
    if (result_record != cast(*IR.ZirType)(null)) {
        fputs(CStr("result := "), out)
    } else {
        if (strcmp(*((fn).return_type)[0], CStr("void")) != 0) {
            fputs(CStr("return "), out)
        }
    }
    fprintf(out, CStr("%s_%s(receiver"), guard, *(function_name)[0])
    {
        i: s32 = 1
        while true {
            if !((i < (parameters).count)) { break }
            fprintf(out, CStr(", argument%d"), i)
            i += 1
        }
    }
    fputs(CStr(")\n"), out)
    if (result_record != cast(*IR.ZirType)(null)) {
        offset: usize = cast(usize)(0)
        field: IR.ZirTypeField
        fields: s32 = 0
        fputs(CStr("\treturn "), out)
        while true {
            if !((TypeNextField(result_record, *(offset), *(field)) == 1)) { break }
            native_name: [256]u8
            go_field_ident(*((field).name)[0], *(native_name)[0], size_of([256]u8))
            post60: s32 = fields
            fields += 1
            fprintf(out, CStr("%sresult.%s"), (ifx (post60 != 0) then CStr(", ") else CStr("")), *(native_name)[0])
        }
        fputc(cast(s32)(#char "\n"), out)
    }
    fputs(CStr("}\n\n"), out)
}

rewrite_global_scalar :: (module: *IR.ZirModule, source: *u8, out: *u8, size: usize, context: *void) -> s32 {
    ctx := (cast(*GlobalRewrite)context).state
    tx_expr(ctx, module, source, out, size)
    return cast(s32)(((out)[0] != 0))
}

rewrite_global_type :: (module: *IR.ZirModule, source: *u8, out: *u8, size: usize, context: *void) -> s32 {
    ctx := (cast(*GlobalRewrite)context).state
    global: *IR.ZirGlobal = (cast(*GlobalRewrite)context).global
    require_go_type(ctx, source, out, size, (global).span)
    return cast(s32)(((out)[0] != 0))
}

rewrite_global_field :: (record: *IR.ZirType, source: *u8, out: *u8, size: usize, context: *void) {
    go_field_ident(source, out, size)
}

// Owned callable invoke and release storage spells its portable slot as an
// unnamed Go function signature. Module-local slot spellings of one
// canonical Owned(Signature) then stay one concrete Go struct, and raw
// procedure slot types keep their named identity.
go_owned_slot_field :: (ctx: *GoLowerState, record: *IR.ZirType, field: *IR.ZirTypeField, out: *u8, size: usize) -> s32 {
    if record.is_owned_callable == 0 && record.is_scoped_callable == 0 {
        return 0
    }
    owner: *IR.ZirModule = cast(*IR.ZirModule)(null)
    slot: *IR.ZirType = CFindType(ctx.type_scope, *((field).type)[0], *(owner))
    if ((slot == cast(*IR.ZirType)(null)) || ((slot).is_procedure_type == 0) || ((slot).is_c_call != 0)) {
        return 0
    }
    if (owner == cast(*IR.ZirModule)(null)) {
        owner = ctx.type_scope
    }
    arguments: *ZirParameters = ParametersOf(*((slot).body)[0])
    if (arguments == cast(*ZirParameters)(null)) {
        return 0
    }
    result_type: [256]u8
    (result_type)[0] = 0
    if (strcmp(*((slot).procedure_return_type)[0], CStr("void")) != 0) {
        if (NativeGoType(owner, *((slot).procedure_return_type)[0], *(result_type)[0], size_of([256]u8)) == 0) {
            return 0
        }
    }
    written: s32 = snprintf(out, size, CStr("func("))
    if ((written < 0) || (cast(usize)(written) >= size)) {
        Diagnostic((record).span, CStr("zir_go.type"), CStr("owned callable Go function signature is too long: %s"), *((record).name)[0])
        exit(1)
    }
    used: usize = cast(usize)(written)
    {
        p: s32 = 0
        while true {
            if (!((p < (arguments).count))) { break }
            mapped: [256]u8
            if (NativeGoType(owner, ((((arguments).items)[p])).type, *(mapped)[0], size_of([256]u8)) == 0) {
                return 0
            }
            written = snprintf(cast(*u8)(cast(usize)(out) + used), size - used, CStr("%s%s"), (ifx (p != 0) then CStr(", ") else CStr("")), *(mapped)[0])
            if ((written < 0) || (cast(usize)(written) >= size - used)) {
                Diagnostic((record).span, CStr("zir_go.type"), CStr("owned callable Go function signature is too long: %s"), *((record).name)[0])
                exit(1)
            }
            used += cast(usize)(written)
            p += 1
        }
    }
    if ((result_type)[0] != 0) {
        written = snprintf(cast(*u8)(cast(usize)(out) + used), size - used, CStr(") %s"), *(result_type)[0])
    } else {
        written = snprintf(cast(*u8)(cast(usize)(out) + used), size - used, CStr(")"))
    }
    if ((written < 0) || (used + cast(usize)(written) >= size)) {
        Diagnostic((record).span, CStr("zir_go.type"), CStr("owned callable Go function signature is too long: %s"), *((record).name)[0])
        exit(1)
    }
    return 1
}

require_go_field_type :: (ctx: *GoLowerState, type: *IR.ZirType, field: *IR.ZirTypeField, out: *u8, size: usize) {
    item: [128]u8
    if (!((strcmp(*((field).name)[0], CStr("data")) != 0)) && (VecElementType(ctx.type_scope, *((type).name)[0], *(item)[0], size_of([128]u8)) != 0)) {
        mapped: [256]u8
        require_go_type(ctx, *(item)[0], *(mapped)[0], size_of([256]u8), (type).span)
        snprintf(out, size, CStr("[]%s"), *(mapped)[0])
    } else if (go_owned_slot_field(ctx, type, field, out, size) == 0) {
        require_go_type(ctx, *((field).type)[0], out, size, (type).span)
    }
}

synthetic_type_emitted :: (ctx: *GoLowerState, programs: **IR.ZirProgram, program_index: s32, module_index: s32, type: *IR.ZirType, native: *u8) -> s32 {
    if (!(((type).is_synthetic_application != 0)) && !(((type).is_map != 0))) {
        return 0
    }
    current: *IR.ZirModule = ctx.type_scope
    {
        p: s32 = 0
        while true {
            if !((p <= program_index)) { break }
            end: s32 = (ifx (p == program_index) then module_index else ((programs)[p]).module_count)
            {
                m: s32 = 0
                while true {
                    if !((m < end)) { break }
                    previous: *IR.ZirModule = *((((programs)[p]).modules)[m])
                    {
                        t: s32 = 0
                        while true {
                            if !((t < (previous).type_count)) { break }
                            candidate: *IR.ZirType = *(((previous).types)[t])
                            candidate_name: [256]u8
                            if (!(((candidate).is_synthetic_application != 0)) && !(((candidate).is_map != 0))) {
                                t += 1
                                continue
                            }
                            NativeTypeName(previous, candidate, *(candidate_name)[0], size_of([256]u8))
                            if (strcmp(*(candidate_name)[0], native) != 0) {
                                t += 1
                                continue
                            }
                            if ((candidate).is_map != (type).is_map) {
                                Diagnostic((type).span, CStr("zir_go.type"), CStr("conflicting concrete Go type: %s"), native)
                                exit(1)
                            }
                            if (((type).is_map != 0) && (SameMapType(current, type, previous, candidate) != 0)) {
                                return 1
                            }
                            left_offset: usize = cast(usize)(0)
                            right_offset: usize = cast(usize)(0)
                            left: IR.ZirTypeField
                            right: IR.ZirTypeField
                            left_status: s32
                            right_status: s32
                            while true {
                                if !((1 != 0)) { break }
                                left_status = TypeNextField(type, *(left_offset), *(left))
                                right_status = TypeNextField(candidate, *(right_offset), *(right))
                                if ((left_status != 1) || (right_status != 1)) {
                                    break
                                }
                                left_type: [256]u8
                                right_type: [256]u8
                                ctx.type_scope = current
                                require_go_field_type(ctx, type, *(left), *(left_type)[0], size_of([256]u8))
                                ctx.type_scope = previous
                                require_go_field_type(ctx, candidate, *(right), *(right_type)[0], size_of([256]u8))
                                ctx.type_scope = current
                                if (((strcmp(*((left).name)[0], *((right).name)[0]) != 0) || (strcmp(*((left).go_tag)[0], *((right).go_tag)[0]) != 0)) || (strcmp(*(left_type)[0], *(right_type)[0]) != 0)) {
                                    break
                                }
                            }
                            if ((left_status == 0) && (right_status == 0)) {
                                return 1
                            }
                            Diagnostic((type).span, CStr("zir_go.type"), CStr("conflicting concrete Go type: %s"), native)
                            exit(1)
                            t += 1
                        }
                    }
                    m += 1
                }
            }
            p += 1
        }
    }
    return 0
}

go_c_type :: (ctx: *GoLowerState, source: *u8, cgo: s32, out: *u8, size: usize, span: IR.ZirSourceSpan) {
    scalars: [17]GoCScalar = .{.{source = CStr("s8"), c = CStr("int8_t")}, .{source = CStr("u8"), c = CStr("uint8_t")}, .{source = CStr("s16"), c = CStr("int16_t")}, .{source = CStr("u16"), c = CStr("uint16_t")}, .{source = CStr("s32"), c = CStr("int32_t")}, .{source = CStr("u32"), c = CStr("uint32_t")}, .{source = CStr("s64"), c = CStr("int64_t")}, .{source = CStr("u64"), c = CStr("uint64_t")}, .{source = CStr("integer"), c = CStr("int64_t")}, .{source = CStr("usize"), c = CStr("size_t")}, .{source = CStr("isize"), c = CStr("ptrdiff_t")}, .{source = CStr("float32"), c = CStr("float")}, .{source = CStr("float64"), c = CStr("double")}, .{source = CStr("bool"), c = CStr("bool")}, .{source = CStr("char"), c = CStr("char")}, .{source = CStr("void"), c = CStr("void")}, .{source = cast(*u8)(null), c = cast(*u8)(null)}}
    depth: s32 = 0
    while true {
        if !(((source)[0] == #char "*")) { break }
        depth += 1
        source = cast(*u8)(cast(usize)(source) + size_of(u8))
    }
    base: *u8 = cast(*u8)(null)
    {
        i: s32 = 0
        while true {
            if !((((scalars)[i]).source != null)) { break }
            if !((strcmp(source, ((scalars)[i]).source) != 0)) {
                base = ((scalars)[i]).c
            }
            i += 1
        }
    }
    native_c_type: [256]u8
    if ((base == cast(*u8)(null)) && (depth != 0)) {
        type: *IR.ZirType = CFindType(ctx.type_scope, source, cast(**IR.ZirModule)(null))
        package: [1024]u8
        if (((type != null) && (GoForeignCallParts(*((type).foreign_target)[0], *(package)[0], size_of([1024]u8), cast(*u8)(null), cast(usize)(0), *(native_c_type)[0], size_of([256]u8)) != 0)) && (GoCHeader(*(package)[0], cast(*u8)(null), cast(usize)(0)) != 0)) {
            base = *(native_c_type)[0]
        }
    }
    if (base == cast(*u8)(null)) {
        Diagnostic(span, CStr("zir_go.import"), CStr("unsupported C ABI symbol parameter or result type: %s"), source)
        exit(1)
    }
    if (((cgo != 0) && (depth != 0)) && !((strcmp(base, CStr("void")) != 0))) {
        depth -= 1
        snprintf(out, size, CStr("%.*sunsafe.Pointer"), depth, CStr("****************************************************************"))
    } else {
        if (cgo != 0) {
            snprintf(out, size, CStr("%.*sC.%s"), depth, CStr("****************************************************************"), base)
        } else {
            snprintf(out, size, CStr("%s%.*s"), base, depth, CStr("****************************************************************"))
        }
    }
}

go_has_c_foreigns :: (ctx: *GoLowerState) -> s32 {
    {
        i: s32 = 0
        while true {
            if !((i < ctx.g_extern_count)) { break }
            if (((ctx.g_externs)[i]).direct_c != 0) {
                return 1
            }
            i += 1
        }
    }
    return 0
}

go_module_has_headers :: (ctx: *GoLowerState, module: *IR.ZirModule) -> s32 {
    {
        i: s32 = 0
        while true {
            if !((i < ctx.g_extern_count)) { break }
            if ((((ctx.g_externs)[i]).c_header)[0] != 0) {
                return 1
            }
            i += 1
        }
    }
    {
        i: s32 = 0
        while true {
            if !((i < (module).type_count)) { break }
            package: [1024]u8
            if ((GoForeignCallParts(*((((module).types)[i]).foreign_target)[0], *(package)[0], size_of([1024]u8), cast(*u8)(null), cast(usize)(0), cast(*u8)(null), cast(usize)(0)) != 0) && (GoCHeader(*(package)[0], cast(*u8)(null), cast(usize)(0)) != 0)) {
                return 1
            }
            i += 1
        }
    }
    return 0
}

go_add_header :: (ctx: *GoLowerState, headers: *GoCHeaders, path: *u8, span: IR.ZirSourceSpan) {
    if !(((path)[0] != 0)) {
        return
    }
    {
        i: s32 = 0
        while true {
            if !((i < (headers).count)) { break }
            if !((strcmp(*(((headers).paths)[i])[0], path) != 0)) {
                return
            }
            i += 1
        }
    }
    if ((headers).count == 64) {
        Diagnostic(span, CStr("zir_go.import"), CStr("too many cgo headers"))
        exit(1)
    }
    post61: s32 = (headers).count
    (headers).count += 1
    copy_text(*(((headers).paths)[post61])[0], size_of([1024]u8), path)
}

go_add_type_header :: (ctx: *GoLowerState, headers: *GoCHeaders, module: *IR.ZirModule, source: *u8) {
    while true {
        if !(((source)[0] == #char "*")) { break }
        source = cast(*u8)(cast(usize)(source) + size_of(u8))
    }
    type: *IR.ZirType = CFindType(module, source, cast(**IR.ZirModule)(null))
    package: [1024]u8
    header: [1024]u8
    if (((type != null) && (GoForeignCallParts(*((type).foreign_target)[0], *(package)[0], size_of([1024]u8), cast(*u8)(null), cast(usize)(0), cast(*u8)(null), cast(usize)(0)) != 0)) && (GoCHeader(*(package)[0], *(header)[0], size_of([1024]u8)) != 0)) {
        go_add_header(ctx, headers, *(header)[0], (type).span)
    }
}

emit_go_c_preamble :: (ctx: *GoLowerState, out: *void, module: *IR.ZirModule) {
    if (!((go_has_c_foreigns(ctx) != 0)) && !((go_module_has_headers(ctx, module) != 0))) {
        return
    }
    fputs(CStr("/*\n#include <stdint.h>\n#include <stddef.h>\n#include <stdbool.h>\n"), out)
    headers: *GoCHeaders = cast(*GoCHeaders)(AllocateOrExit(size_of(GoCHeaders)))
    memset(cast(*void)(headers), 0, size_of(GoCHeaders))
    {
        i: s32 = 0
        while true {
            if !((i < (module).type_count)) { break }
            go_add_type_header(ctx, headers, module, *((((module).types)[i]).name)[0])
            i += 1
        }
    }
    {
        i: s32 = 0
        while true {
            if !((i < ctx.g_extern_count)) { break }
            binding: *ZirGoExtern = *((ctx.g_externs)[i])
            go_add_header(ctx, headers, *((binding).c_header)[0], (module).span)
            if (((binding).c_header)[0] != 0) {
                go_add_type_header(ctx, headers, module, *((binding).ret)[0])
                {
                    p: s32 = 0
                    while true {
                        if !((p < (binding).pcount)) { break }
                        go_add_type_header(ctx, headers, module, ((((binding).parameters).items)[p]).type)
                        p += 1
                    }
                }
            }
            i += 1
        }
    }
    {
        i: s32 = 0
        while true {
            if !((i < (headers).count)) { break }
            fprintf(out, CStr("#include <%s>\n"), *(((headers).paths)[i])[0])
            i += 1
        }
    }
    free(cast(*void)(headers))
    {
        i: s32 = 0
        while true {
            if !((i < ctx.g_extern_count)) { break }
            binding: *ZirGoExtern = *((ctx.g_externs)[i])
            if (!(((binding).direct_c != 0)) || (((binding).c_header)[0] != 0)) {
                i += 1
                continue
            }
            {
                p: *u8 = *((binding).c_symbol)[0]
                while true {
                    if !(((p)[0] != 0)) { break }
                    if (!(((isalnum(cast(s32)((p)[0])) != 0) || ((p)[0] == #char "_"))) || ((p == *((binding).c_symbol)[0]) && (isdigit(cast(s32)((p)[0])) != 0))) {
                        Diagnostic((module).span, CStr("zir_go.import"), CStr("invalid C ABI symbol: %s"), *((binding).c_symbol)[0])
                        exit(1)
                    }
                    p = cast(*u8)(cast(usize)(p) + size_of(u8))
                }
            }
            type: [256]u8
            go_c_type(ctx, *((binding).ret)[0], 0, *(type)[0], size_of([256]u8), (module).span)
            fprintf(out, CStr("extern %s %s("), *(type)[0], *((binding).c_symbol)[0])
            {
                p: s32 = 0
                while true {
                    if !((p < (binding).pcount)) { break }
                    go_c_type(ctx, ((((binding).parameters).items)[p]).type, 0, *(type)[0], size_of([256]u8), (module).span)
                    fprintf(out, CStr("%s%s"), (ifx (p != 0) then CStr(", ") else CStr("")), *(type)[0])
                    p += 1
                }
            }
            fprintf(out, CStr("%s);\n"), (ifx ((binding).pcount != 0) then CStr("") else CStr("void")))
            i += 1
        }
    }
    flags: [2]*u8 = .{getenv(CStr("LDFLAGS")), getenv(CStr("LDLIBS"))}
    {
        i: s32 = 0
        while true {
            if !((i < 2)) { break }
            if (!(((flags)[i] != null)) || !((((flags)[i])[0] != 0))) {
                i += 1
                continue
            }
            if ((strpbrk((flags)[i], CStr("\r\n")) != null) || (strstr((flags)[i], CStr("*/")) != null)) {
                Diagnostic((module).span, CStr("zir_go.import"), CStr("invalid cgo linker flags"))
                exit(1)
            }
            fprintf(out, CStr("#cgo LDFLAGS: %s\n"), (flags)[i])
            i += 1
        }
    }
    fputs(CStr("*/\nimport \"C\"\n\n"), out)
}

emit_go_c_adapters :: (ctx: *GoLowerState, out: *void, module: *IR.ZirModule) {
    {
        i: s32 = 0
        while true {
            if !((i < ctx.g_extern_count)) { break }
            binding: *ZirGoExtern = *((ctx.g_externs)[i])
            if !(((binding).direct_c != 0)) {
                i += 1
                continue
            }
            type: [256]u8
            name: [256]u8
            camel_ident(*((binding).source)[0], *(name)[0], size_of([256]u8))
            fprintf(out, CStr("func %s_%s("), *(ctx.g_guard)[0], *(name)[0])
            {
                p: s32 = 0
                while true {
                    if !((p < (binding).pcount)) { break }
                    require_go_type(ctx, ((((binding).parameters).items)[p]).type, *(type)[0], size_of([256]u8), (module).span)
                    fprintf(out, CStr("%sa%d %s"), (ifx (p != 0) then CStr(", ") else CStr("")), p, *(type)[0])
                    p += 1
                }
            }
            require_go_type(ctx, *((binding).ret)[0], *(type)[0], size_of([256]u8), (module).span)
            fprintf(out, CStr(") %s {\n\t"), *(type)[0])
            if ((((binding).c_header)[0] != 0) && ((binding).go_field != 0)) {
                setter: s32 = cast(s32)(!((strcmp(*((binding).ret)[0], CStr("void")) != 0)))
                if (setter != 0) {
                    value_type: [256]u8
                    go_c_type(ctx, ((((binding).parameters).items)[((binding).pcount - 1)]).type, 1, *(value_type)[0], size_of([256]u8), (module).span)
                    fprintf(out, CStr("%s.%s = (%s)(%sa%d%s)\n"), (ifx (((binding).go_receiver)[0] != 0) then CStr("a0") else CStr("C")), *((binding).go)[0], *(value_type)[0], (ifx ((((((binding).parameters).items)[((binding).pcount - 1)]).type)[0] == #char "*") then CStr("unsafe.Pointer(") else CStr("")), ((binding).pcount - 1), (ifx ((((((binding).parameters).items)[((binding).pcount - 1)]).type)[0] == #char "*") then CStr(")") else CStr("")))
                } else {
                    fprintf(out, CStr("result := %s.%s\n\treturn (%s)(%sresult%s)\n"), (ifx (((binding).go_receiver)[0] != 0) then CStr("a0") else CStr("C")), *((binding).go)[0], *(type)[0], (ifx (((binding).ret)[0] == #char "*") then CStr("unsafe.Pointer(") else CStr("")), (ifx (((binding).ret)[0] == #char "*") then CStr(")") else CStr("")))
                }
                fputs(CStr("}\n\n"), out)
                i += 1
                continue
            }
            if (strcmp(*((binding).ret)[0], CStr("void")) != 0) {
                fputs(CStr("result := "), out)
            }
            fprintf(out, CStr("C.%s("), *((binding).c_symbol)[0])
            {
                p: s32 = 0
                while true {
                    if !((p < (binding).pcount)) { break }
                    go_c_type(ctx, ((((binding).parameters).items)[p]).type, 1, *(type)[0], size_of([256]u8), (module).span)
                    fprintf(out, CStr("%s(%s)(%sa%d%s)"), (ifx (p != 0) then CStr(", ") else CStr("")), *(type)[0], (ifx ((((((binding).parameters).items)[p]).type)[0] == #char "*") then CStr("unsafe.Pointer(") else CStr("")), p, (ifx ((((((binding).parameters).items)[p]).type)[0] == #char "*") then CStr(")") else CStr("")))
                    p += 1
                }
            }
            fputs(CStr(")\n"), out)
            if (strcmp(*((binding).ret)[0], CStr("void")) != 0) {
                require_go_type(ctx, *((binding).ret)[0], *(type)[0], size_of([256]u8), (module).span)
                fprintf(out, CStr("\treturn (%s)(%sresult%s)\n"), *(type)[0], (ifx (((binding).ret)[0] == #char "*") then CStr("unsafe.Pointer(") else CStr("")), (ifx (((binding).ret)[0] == #char "*") then CStr(")") else CStr("")))
            }
            fputs(CStr("}\n\n"), out)
            i += 1
        }
    }
}

emit_go_c_header_stub :: (ctx: *GoLowerState, programs: **IR.ZirProgram, program_index: s32, module_index: s32, module: *IR.ZirModule, path: *u8, package: *u8) -> s32 {
    if !((go_module_has_headers(ctx, module) != 0)) {
        return 0
    }
    companion: [1024]u8
    length: usize = strlen(path)
    if ((length < cast(usize)(3)) || ((length + cast(usize)(6)) >= size_of([1024]u8))) {
