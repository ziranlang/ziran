            result_type: [256]u8 = .{}
            name: [256]u8
            record: *IR.ZirType = CFindType(module, *((binding).ret)[0], cast(**IR.ZirModule)(null))
            if (strcmp(*((binding).ret)[0], CStr("void")) != 0) {
                require_go_type(ctx, *((binding).ret)[0], *(result_type)[0], size_of([256]u8), (module).span)
            }
            camel_ident(*((binding).source)[0], *(name)[0], size_of([256]u8))
            fprintf(out, CStr("func %s_%s("), *(ctx.g_guard)[0], *(name)[0])
            {
                p: s32 = 0
                while true {
                    if !((p < (binding).pcount)) { break }
                    parameter: [256]u8
                    type: [256]u8
                    camel_ident(((((binding).parameters).items)[p]).name, *(parameter)[0], size_of([256]u8))
                    require_go_type(ctx, ((((binding).parameters).items)[p]).type, *(type)[0], size_of([256]u8), (module).span)
                    fprintf(out, CStr("%s%s %s"), (ifx (p != 0) then CStr(", ") else CStr("")), *(parameter)[0], *(type)[0])
                    p += 1
                }
            }
            fprintf(out, CStr(") %s {\n"), *(result_type)[0])
            if (go_package_initializer(ctx, binding) != 0) {
