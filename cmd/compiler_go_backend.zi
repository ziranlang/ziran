                } else {
                    camel_ident(((((binding).parameters).items)[0]).name, *(receiver)[0], size_of([256]u8))
                }
                if (setter != 0) {
                    value: [256]u8
                    camel_ident(((((binding).parameters).items)[((binding).pcount - 1)]).name, *(value)[0], size_of([256]u8))
                    fprintf(out, CStr("\t%s.%s = %s\n}\n\n"), *(receiver)[0], *((binding).go)[0], *(value)[0])
                } else {
                    fprintf(out, CStr("\treturn %s.%s\n}\n\n"), *(receiver)[0], *((binding).go)[0])
                }
                i += 1
                continue
            }
            if (((binding).go_variadic != 0) && !(((binding).go_results != 0))) {
                receiver: *u8 = *((binding).go_receiver)[0]
                fprintf(out, CStr("\t%s"), (ifx ((result_type)[0] != 0) then CStr("return ") else CStr("")))
                if ((receiver)[0] != 0) {
                    fprintf(out, CStr("(%s%s.%s).%s("), (ifx ((receiver)[0] == #char "*") then CStr("*") else CStr("")), *((binding).go_import_alias)[0], cast(*u8)(cast(usize)(receiver) + cast(usize)(((receiver)[0] == #char "*")) * size_of(u8)), *((binding).go)[0])
                } else {
                    fprintf(out, CStr("%s.%s("), *((binding).go_import_alias)[0], *((binding).go)[0])
                }
                {
                    p: s32 = 0
                    while true {
                        if !((p < (binding).pcount)) { break }
                        parameter: [256]u8
                        camel_ident(((((binding).parameters).items)[p]).name, *(parameter)[0], size_of([256]u8))
                        fprintf(out, CStr("%s%s%s"), (ifx (p != 0) then CStr(", ") else CStr("")), *(parameter)[0], (ifx ((p + 1) == (binding).pcount) then CStr("...") else CStr("")))
                        p += 1
                    }
                }
                fputs(CStr(")\n}\n\n"), out)
                i += 1
                continue
            }
            fprintf(out, CStr("\tvar result %s\n\t"), *(result_type)[0])
            offset: usize = cast(usize)(0)
            field: IR.ZirTypeField
            fields: s32 = 0
            while true {
                if !((TypeNextField(record, *(offset), *(field)) == 1)) { break }
                member: [256]u8
                go_field_ident(*((field).name)[0], *(member)[0], size_of([256]u8))
                post62: s32 = fields
                fields += 1
                fprintf(out, CStr("%sresult.%s"), (ifx (post62 != 0) then CStr(", ") else CStr("")), *(member)[0])
            }
            if ((((binding).direct_go != 0) && !((strcmp(*((binding).go_import_path)[0], CStr("builtin")) != 0))) && !((strcmp(*((binding).go)[0], CStr("assert")) != 0))) {
                parameter: [256]u8
                asserted: [256]u8
                offset = cast(usize)(0)
                TypeNextField(record, *(offset), *(field))
                require_go_type(ctx, *((field).type)[0], *(asserted)[0], size_of([256]u8), (module).span)
                camel_ident(((((binding).parameters).items)[0]).name, *(parameter)[0], size_of([256]u8))
                fprintf(out, CStr(" = %s.(%s)\n\treturn result\n}\n\n"), *(parameter)[0], *(asserted)[0])
                i += 1
                continue
            }
            receiver: *u8 = *((binding).go_receiver)[0]
            if ((receiver)[0] != 0) {
                fprintf(out, CStr(" = (%s%s.%s).%s("), (ifx ((receiver)[0] == #char "*") then CStr("*") else CStr("")), *((binding).go_import_alias)[0], cast(*u8)(cast(usize)(receiver) + cast(usize)(((receiver)[0] == #char "*")) * size_of(u8)), *((binding).go)[0])
            } else {
                fprintf(out, CStr(" = %s.%s("), *((binding).go_import_alias)[0], *((binding).go)[0])
            }
            {
                p: s32 = 0
                while true {
                    if !((p < (binding).pcount)) { break }
                    parameter: [256]u8
                    camel_ident(((((binding).parameters).items)[p]).name, *(parameter)[0], size_of([256]u8))
                    fprintf(out, CStr("%s%s%s"), (ifx (p != 0) then CStr(", ") else CStr("")), *(parameter)[0], (ifx (((binding).go_variadic != 0) && ((p + 1) == (binding).pcount)) then CStr("...") else CStr("")))
                    p += 1
                }
            }
            fputs(CStr(")\n\treturn result\n}\n\n"), out)
