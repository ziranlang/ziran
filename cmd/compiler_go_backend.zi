extern_go_name :: (ctx: *GoLowerState, target: *u8, source: *u8, dst: *u8, dst_size: usize) {
    dot: *u8 = strrchr(target, cast(s32)(#char "."))
    base: *u8 = (ifx (dot != cast(*u8)(null)) then cast(*u8)(cast(usize)(dot) + cast(usize)(1) * size_of(u8)) else target)
    if ((base)[0] != 0) {
        snprintf(dst, dst_size, CStr("%s"), base)
        {
            c: *u8 = dst
            while true {
                if !(((c)[0] != 0)) { break }
                if !((is_ident_char(cast(s32)((c)[0])) != 0)) {
                    (c)[0] = #char "_"
                }
                c = cast(*u8)(cast(usize)(c) + size_of(u8))
            }
        }
    } else {
        camel_ident(source, dst, dst_size)
    }
}

extern_direct_go_target :: (ctx: *GoLowerState, target: *u8, import_path: *u8, import_path_size: usize, alias: *u8, alias_size: usize) -> s32 {
    slash: *u8
    base: *u8
    n: usize = cast(usize)(0)
    if !((GoForeignCallParts(target, import_path, import_path_size, cast(*u8)(null), cast(usize)(0), cast(*u8)(null), cast(usize)(0)) != 0)) {
        return 0
    }
    if (GoCHeader(import_path, cast(*u8)(null), cast(usize)(0)) != 0) {
        snprintf(alias, alias_size, CStr("C"))
        return 1
    }
    slash = strrchr(import_path, cast(s32)(#char "/"))
    base = (ifx (slash != cast(*u8)(null)) then cast(*u8)(cast(usize)(slash) + cast(usize)(1) * size_of(u8)) else import_path)
    while true {
        if !((((base)[0] != 0) && ((n + cast(usize)(1)) < alias_size))) { break }
        post2: *u8 = base
        base = cast(*u8)(cast(usize)(base) + size_of(u8))
        c: u8 = (post2)[0]
        if ((isalnum(cast(s32)(c)) != 0) || (c == #char "_")) {
            post3: usize = n
            n += 1
            (alias)[post3] = c
        } else {
            post4: usize = n
            n += 1
            (alias)[post4] = #char "_"
        }
    }
    if ((n == cast(usize)(0)) && (alias_size > cast(usize)(1))) {
        post5: usize = n
        n += 1
        (alias)[post5] = #char "x"
    }
    if ((isdigit(cast(s32)((alias)[0])) != 0) && ((n + cast(usize)(1)) < alias_size)) {
        memmove(cast(*void)(cast(*u8)(cast(usize)(alias) + cast(usize)(1) * size_of(u8))), cast(*void)(alias), (n + cast(usize)(1)))
        (alias)[0] = #char "x"
        n += 1
    }
    (alias)[n] = 0
    return cast(s32)(((import_path)[0] != 0))
}

add_extern :: (ctx: *GoLowerState, source: *u8, args: *u8, ret: *u8, target: *u8, provider_symbol: *u8, go_results: s32, go_field: s32, go_defer: s32, go_variadic: s32, span: IR.ZirSourceSpan) {
    ex: *ZirGoExtern
    if ((go_extern_index(ctx, source, strlen(source)) >= 0) || (ctx.g_extern_count >= 64)) {
        return
    }
    post6: s32 = ctx.g_extern_count
    ctx.g_extern_count += 1
    ex = *((ctx.g_externs)[post6])
    memset(cast(*void)(ex), 0, size_of(ZirGoExtern))
    snprintf(*((ex).source)[0], size_of([256]u8), CStr("%s"), source)
    snprintf(*((ex).ret)[0], size_of([256]u8), CStr("%s"), ret)
    (ex).go_results = go_results
    (ex).go_field = go_field
    (ex).go_defer = go_defer
    (ex).go_variadic = go_variadic
    (ex).parameters = ParametersOf(args)
    (ex).pcount = ((ex).parameters).count
    {
        p: s32 = 0
        while true {
            if !((p < (ex).pcount)) { break }
            parameter: *ZirParameter = *((((ex).parameters).items)[p])
            if (((parameter).name == cast(*u8)(null)) || ((parameter).type == cast(*u8)(null))) {
                Diagnostic(span, CStr("zir_go.parameter"), CStr("parameters require name: type: %s"), (parameter).text)
                exit(1)
            }
            p += 1
        }
    }
    if ((target != cast(*u8)(null)) && !((strncmp(target, CStr("c."), cast(usize)(2)) != 0))) {
        (ex).direct_c = 1
        snprintf(*((ex).c_symbol)[0], size_of([256]u8), CStr("%s"), (ifx ((provider_symbol != null) && ((provider_symbol)[0] != 0)) then provider_symbol else cast(*u8)(cast(usize)(target) + cast(usize)(2) * size_of(u8))))
    } else {
        if ((target != cast(*u8)(null)) && (strncmp(target, CStr("ziran:"), cast(usize)(6)) == 0)) {
            bound: *u8 = go_bound_provider(ctx, cast(*u8)(cast(usize)(target) + cast(usize)(6) * size_of(u8)), provider_symbol)
            if (bound == cast(*u8)(null)) {
                Diagnostic(span, CStr("zir_go.bind"), CStr("bound Ziran host provider is missing: %s:%s"), cast(*u8)(cast(usize)(target) + cast(usize)(6) * size_of(u8)), provider_symbol)
                exit(1)
            }
            (ex).direct_ziran = 1
            snprintf(*((ex).provider_go)[0], size_of([512]u8), CStr("%s"), bound)
        } else {
            extern_go_name(ctx, target, source, *((ex).go)[0], size_of([256]u8))
            (ex).direct_go = extern_direct_go_target(ctx, target, *((ex).go_import_path)[0], size_of([1024]u8), *((ex).go_import_alias)[0], size_of([256]u8))
            if ((ex).direct_go != 0) {
                GoForeignCallParts(target, cast(*u8)(null), cast(usize)(0), *((ex).go_receiver)[0], size_of([256]u8), cast(*u8)(null), cast(usize)(0))
            }
            if (((ex).direct_go != 0) && (GoCHeader(*((ex).go_import_path)[0], *((ex).c_header)[0], size_of([1024]u8)) != 0)) {
                (ex).direct_c = 1
                copy_text(*((ex).c_symbol)[0], size_of([256]u8), *((ex).go)[0])
            }
        }
    }
    snprintf(*((ex).host_var)[0], size_of([264]u8), CStr("%c%sHost"), cast(u8)(tolower(cast(s32)((ctx.g_guard)[0]))), cast(*u8)(cast(usize)(*(ctx.g_guard)[0]) + cast(usize)(1) * size_of(u8)))
}

go_prints_floats :: (ctx: *GoLowerState, programs: **IR.ZirProgram, count: s32) -> s32 {
    {
        p: s32 = 0
        while true {
            if !((p < count)) { break }
            {
                m: s32 = 0
                while true {
                    if !((m < ((programs)[p]).module_count)) { break }
                    module: *IR.ZirModule = *((((programs)[p]).modules)[m])
                    {
                        f: s32 = 0
                        while true {
                            if !((f < (module).function_count)) { break }
                            fn: *IR.ZirFunction = *(((module).functions)[f])
                            {
                                e: s32 = 0
                                while true {
                                    if !((e < (fn).expr_count)) { break }
                                    call: *IR.ZirExpr = *(((fn).exprs)[e])
                                    if ((((call).kind != IR.ZirExprKind.CALL) || (strcmp((call).name, CStr("print")) != 0)) || ((call).first_child < 0)) {
                                        e += 1
                                        continue
                                    }
                                    {
                                        arg: s32 = (((fn).exprs)[(call).first_child]).next_sibling
                                        while true {
                                            if !((arg >= 0)) { break }
                                            if (!((strcmp((((fn).exprs)[arg]).type, CStr("float32")) != 0)) || !((strcmp((((fn).exprs)[arg]).type, CStr("float64")) != 0))) {
                                                return 1
                                            }
                                            arg = (((fn).exprs)[arg]).next_sibling
                                        }
                                    }
                                    e += 1
                                }
                            }
                            f += 1
                        }
                    }
                    m += 1
                }
            }
            p += 1
        }
    }
    return 0
}

go_uses_caller_location :: (ctx: *GoLowerState, programs: **IR.ZirProgram, count: s32) -> s32 {
    {
        p: s32 = 0
        while true {
            if !((p < count)) { break }
            {
                m: s32 = 0
                while true {
                    if !((m < ((programs)[p]).module_count)) { break }
                    module: *IR.ZirModule = *((((programs)[p]).modules)[m])
                    {
                        t: s32 = 0
                        while true {
                            if !((t < (module).type_count)) { break }
                            if (strstr(*((((module).types)[t]).body)[0], CStr("Source_Code_Location")) != null) {
                                return 1
                            }
                            t += 1
                        }
                    }
                    {
                        g: s32 = 0
                        while true {
                            if !((g < (module).global_count)) { break }
                            if (strstr(*((((module).globals)[g]).type)[0], CStr("Source_Code_Location")) != null) {
                                return 1
                            }
                            g += 1
                        }
                    }
                    {
                        f: s32 = 0
                        while true {
                            if !((f < (module).function_count)) { break }
                            fn: *IR.ZirFunction = *(((module).functions)[f])
                            if ((strstr(FunctionArgs(fn), CStr("Source_Code_Location")) != null) || (strstr(*((fn).return_type)[0], CStr("Source_Code_Location")) != null)) {
                                return 1
                            }
                            {
                                e: s32 = 0
                                while true {
                                    if !((e < (fn).expr_count)) { break }
                                    if (strstr((((fn).exprs)[e]).type, CStr("Source_Code_Location")) != null) {
                                        return 1
                                    }
                                    e += 1
                                }
                            }
                            {
                                s: s32 = 0
                                while true {
                                    if !((s < (fn).stmt_count)) { break }
                                    if (strstr((((fn).stmts)[s]).type, CStr("Source_Code_Location")) != null) {
                                        return 1
                                    }
                                    s += 1
                                }
                            }
                            f += 1
                        }
                    }
                    m += 1
                }
            }
            p += 1
        }
    }
    return 0
}

parse_extern_import_with_buffers :: (ctx: *GoLowerState, imp: *IR.ZirImport, buffers: *ParseExternImportBuffers) {
    if ((((imp).args)[0] != 0) || (((imp).return_type)[0] != 0)) {
        add_extern(ctx, *((imp).name)[0], *((imp).args)[0], (ifx (((imp).return_type)[0] != 0) then *((imp).return_type)[0] else CStr("void")), *((imp).target)[0], *((imp).extern_symbol)[0], (imp).go_results, (imp).go_field, (imp).go_defer, (imp).go_variadic, (imp).span)
        return
    }
    ret: [256]u8
    lp: *u8 = strchr(*((imp).signature)[0], cast(s32)(#char "("))
    rp: *u8 = (ifx (lp != cast(*u8)(null)) then strchr(lp, cast(s32)(#char ")")) else cast(*u8)(null))
    dir: *u8 = strstr(*((imp).signature)[0], CStr("#foreign"))
    ((buffers).args)[0] = 0
    snprintf(*(ret)[0], size_of([256]u8), CStr("void"))
    ((buffers).target)[0] = 0
    if (((lp != cast(*u8)(null)) && (rp != cast(*u8)(null))) && (rp > lp)) {
        snprintf(*((buffers).args)[0], size_of([8192]u8), CStr("%.*s"), cast(s32)((cast(isize)(cast(usize)(rp) - cast(usize)(lp)) / cast(isize)size_of(u8) - cast(isize)(1))), cast(*u8)(cast(usize)(lp) + cast(usize)(1) * size_of(u8)))
    }
    if (rp != cast(*u8)(null)) {
        arrow: *u8 = strstr(rp, CStr("->"))
