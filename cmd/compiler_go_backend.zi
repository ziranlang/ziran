emit_go_cgo_availability :: (ctx: *GoLowerState, module: *IR.ZirModule, directory: *u8, package: *u8) -> s32 {
    {
        enabled: s32 = 0
        while true {
            if !((enabled <= 1)) { break }
            path: [1024]u8
            length: s32 = snprintf(*(path)[0], size_of([1024]u8), CStr("%s/zi2go.%scgo.go"), directory, (ifx (enabled != 0) then CStr("") else CStr("no")))
            if ((length < 0) || (cast(usize)(length) >= size_of([1024]u8))) {
                Diagnostic((module).span, CStr("zir_go.import"), CStr("cgo availability output path exceeds limit"))
                return 1
            }
            GeneratedOutputRecord(*(path)[0])
            out: *void = fopen(*(path)[0], CStr("wb"))
            if (out == null) {
                Diagnostic((module).span, CStr("zir_go.import"), CStr("cannot create cgo availability: %s"), *(path)[0])
                return 1
            }
            fprintf(out, CStr("// Code generated by zi2go from native Go availability. DO NOT EDIT.\n//go:build %scgo\n\npackage %s\n\nconst zirGoCgoEnabled = %s\n"), (ifx (enabled != 0) then CStr("") else CStr("!")), package, (ifx (enabled != 0) then CStr("true") else CStr("false")))
            failed: s32 = cast(s32)((ferror(out) != 0))
            failed = (failed | cast(s32)((fclose(out) != 0)))
            if (failed != 0) {
                Diagnostic((module).span, CStr("zir_go.import"), CStr("cannot finish cgo availability: %s"), *(path)[0])
                return 1
            }
            enabled += 1
        }
    }
    return 0
}

emit_go_foreign_adapters :: (ctx: *GoLowerState, out: *void, module: *IR.ZirModule) {
    {
