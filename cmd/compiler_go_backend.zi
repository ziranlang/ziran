// Lower checked IR to a native Go package, including typed foreign adapters.
// Each invocation owns its symbol/type/enum state. Emitter callbacks carry that
// state explicitly; heap frames reuse the selected compiler context scratch pool.
using IR :: #import "compiler_ir"
using Native :: #import "compiler_native_names"
Asm :: #import "compiler_go_asm"

#scope_file
GoDestroyBuffer :: #type (p0: *void) #c_call;
GoResolveTarget :: #type (p0: *void, p1: *u8, p2: *u8, p3: usize) #c_call;
GoAssemblyBlockEmitter :: #type (p0: *void, p1: *IR.ZirModule, p2: *IR.ZirFunction, p3: s32, p4: *void) -> s32 #c_call;
GoGlobalRewrite :: #type (p0: *IR.ZirModule, p1: *u8, p2: *u8, p3: usize, p4: *void) -> s32 #c_call;
GoGlobalFieldRewrite :: #type (p0: *IR.ZirType, p1: *u8, p2: *u8, p3: usize, p4: *void) #c_call;
