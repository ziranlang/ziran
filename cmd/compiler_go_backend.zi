            i += 1
        }
    }
    {
        i: s32 = 0
        while true {
            if !((i < ctx.g_extern_count)) { break }
            binding: *ZirGoExtern = *((ctx.g_externs)[i])
            if !(((binding).direct_c != 0)) {
                i += 1
                continue
