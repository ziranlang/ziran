emit_field_tag :: (ctx: *GoLowerState, out: *void, field: *IR.ZirTypeField, span: IR.ZirSourceSpan) {
    if !((((field).go_tag)[0] != 0)) {
        return
    }
    bytes: [512]u8
    length: usize
    if !((DecodeStringLiteral(*((field).go_tag)[0], *(bytes)[0], size_of([512]u8), *(length)) != 0)) {
        Diagnostic(span, CStr("zir_go.type"), CStr("invalid Go field tag: %s"), *((field).name)[0])
        exit(1)
    }
    fputs(CStr(" \""), out)
    {
        i: usize = cast(usize)(0)
        while true {
            if !((i < length)) { break }
            byte: u8 = (bytes)[i]
            if ((byte == #char "\"") || (byte == #char "\\")) {
                fprintf(out, CStr("\\%c"), byte)
            } else {
                if ((byte < cast(u8)(32)) || (byte == cast(u8)(127))) {
                    fprintf(out, CStr("\\x%02x"), byte)
                } else {
                    fputc(cast(s32)(byte), out)
                }
            }
            i += 1
        }
    }
    fputc(cast(s32)(#char "\""), out)
}

go_startup_calls_host :: (ctx: *GoLowerState, module: *IR.ZirModule, start: *IR.ZirFunction) -> s32 {
    owners: **IR.ZirModule = cast(**IR.ZirModule)(AllocateOrExit((cast(usize)(4096) * size_of(*IR.ZirModule))))
    pending: **IR.ZirFunction = cast(**IR.ZirFunction)(AllocateOrExit((cast(usize)(4096) * size_of(*IR.ZirFunction))))
    count: s32 = 0
    next: s32 = 0
    found: s32 = 0
    (owners)[count] = module
    post63: s32 = count
    count += 1
    (pending)[post63] = start
    while true {
        if !(((next < count) && !((found != 0)))) { break }
        owner: *IR.ZirModule = (owners)[next]
        post64: s32 = next
        next += 1
        fn: *IR.ZirFunction = (pending)[post64]
        if ((fn).is_extern != 0) {
            found = cast(s32)(((fn).extern_kind == IR.ZirExternKind.HOST))
            continue
        }
        if !(((fn).uses_host != 0)) {
            continue
        }
        {
            x: s32 = 0
            while true {
                if !(((x < (fn).expr_count) && !((found != 0)))) { break }
                e: *IR.ZirExpr = *(((fn).exprs)[x])
                callee_owner: *IR.ZirModule = cast(*IR.ZirModule)(null)
                callee: *IR.ZirFunction = cast(*IR.ZirFunction)(null)
                if ((((e).kind != IR.ZirExprKind.CALL) || ((e).is_function_value != 0)) || ((e).name == cast(*u8)(null))) {
                    x += 1
                    continue
                }
                if (CResolveFunction(owner, (e).name, *(callee_owner), *(callee)) != 1) {
                    {
                        i: s32 = 0
                        while true {
                            if !((i < (owner).import_count)) { break }
                            if ((((((owner).imports)[i]).kind == IR.ZirImportKind.EXTERN) && ((((owner).imports)[i]).extern_kind == IR.ZirExternKind.HOST)) && !((strcmp(*((((owner).imports)[i]).name)[0], (e).name) != 0))) {
                                found = 1
                            }
                            i += 1
                        }
                    }
                    x += 1
                    continue
                }
                seen: s32 = 0
                {
                    i: s32 = 0
                    while true {
                        if !(((i < count) && !((seen != 0)))) { break }
                        seen = cast(s32)(((pending)[i] == callee))
                        i += 1
                    }
                }
                if (seen != 0) {
                    x += 1
                    continue
                }
                if (count == 4096) {
                    found = 1
                    break
                }
                (owners)[count] = callee_owner
                post65: s32 = count
                count += 1
                (pending)[post65] = callee
                x += 1
            }
        }
    }
    free(cast(*void)(owners))
    free(cast(*void)(pending))
    return found
}

go_lower_with_buffers :: (ctx: *GoLowerState, progs: **IR.ZirProgram, prog_count: s32, root: *u8, out_dir: *u8, pkg: *u8, no_main: s32, buffers: *GoLowerBuffers) -> s32 {
    number_helpers: u32 = cast(u32)(0)
    assembly_present: s32 = 0
    go_build_global_functions(ctx, progs, prog_count)
    if !((go_validate_exports(ctx, progs, prog_count) != 0)) {
        return 1
    }
    GoSimdBegin()
    {
        pi: s32 = 0
        while true {
            if !((pi < prog_count)) { break }
            prog: *IR.ZirProgram = (progs)[pi]
            {
                mi: s32 = 0
                while true {
                    if !((mi < (prog).module_count)) { break }
                    m: *IR.ZirModule = *(((prog).modules)[mi])
                    guard: [256]u8
                    f: *void
                    stream: TextStream
                    text: *u8 = cast(*u8)(null)
                    length: usize = cast(usize)(0)
                    NativeGoModuleIdentity(progs, prog_count, m, *((buffers).stem)[0], size_of([512]u8), *(guard)[0], size_of([256]u8))
                    {
                        fi: s32 = 0
