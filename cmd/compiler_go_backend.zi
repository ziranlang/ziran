                fprintf(out, CStr("\treturn %s == nil\n}\n\n"), *(parameter)[0])
                i += 1
                continue
            }
            if ((go_builtin_assertion(ctx, binding) != 0) && !(((binding).go_results != 0))) {
                parameter: [256]u8
                camel_ident(((((binding).parameters).items)[0]).name, *(parameter)[0], size_of([256]u8))
                fprintf(out, CStr("\treturn %s.(%s)\n}\n\n"), *(parameter)[0], *(result_type)[0])
                i += 1
                continue
            }
            if ((go_builtin_method(ctx, binding) != 0) || (go_builtin_callback(ctx, binding) != 0)) {
                parameter: [256]u8
                camel_ident(((((binding).parameters).items)[0]).name, *(parameter)[0], size_of([256]u8))
                fprintf(out, CStr("\t%s%s%s%s("), (ifx !((strcmp(*((binding).go)[0], CStr("spawn")) != 0)) then CStr("go ") else (ifx ((result_type)[0] != 0) then CStr("return ") else CStr(""))), *(parameter)[0], (ifx (go_builtin_callback(ctx, binding) != 0) then CStr("") else CStr(".")), (ifx (go_builtin_callback(ctx, binding) != 0) then CStr("") else *((binding).go)[0]))
                {
                    p: s32 = 1
                    while true {
                        if !((p < (binding).pcount)) { break }
                        camel_ident(((((binding).parameters).items)[p]).name, *(parameter)[0], size_of([256]u8))
                        fprintf(out, CStr("%s%s"), (ifx (p > 1) then CStr(", ") else CStr("")), *(parameter)[0])
                        p += 1
                    }
                }
                fputs(CStr(")\n}\n\n"), out)
                i += 1
                continue
            }
            if ((binding).go_field != 0) {
                setter: s32 = cast(s32)(!((strcmp(*((binding).ret)[0], CStr("void")) != 0)))
                receiver: [256]u8
                if !((((binding).go_receiver)[0] != 0)) {
