            NativeTypeName(module, *(((module).types)[i]), *(native)[0], size_of([256]u8))
            if (synthetic_type_emitted(ctx, programs, program_index, module_index, *(((module).types)[i]), *(native)[0]) != 0) {
                i += 1
                continue
