// Operand, clobber and template checks for `#asm` variants, and the checked
// operand metadata the native emitters read. Loaded by compiler_inline_asm.zi.

AssemblyBinding :: #type (context: *void, name: *u8) -> *u8 #c_call;

OUTPUT_NAME_SIZE :: 132

AssemblyOutputs :: struct {
    names: [30][132]u8
    fields: [30]IR.ZirTypeField
    count: s32
    record: s32
}

OutputName :: (outputs: *AssemblyOutputs, index: s32) -> *u8 { return *outputs.names[index][0] }

OperandType :: (type: *u8) -> bool {
    if type == null || type[0] == 0 { return false }
    if type[0] == #char "*" { return true }
    scalar := ScalarType(type)
    return TargetType(scalar, .ZIR_C) != null && !Same(scalar, CStr("void")) && !Same(scalar, CStr("string"))
}

// A slice parameter reaches assembly as its data pointer.
SliceOperand :: (type: *u8) -> bool {
    element: [IR.ZIR_NAME_MAX]u8
    if type == null { return false }
    return SliceElementType(type, *element[0], size_of([IR.ZIR_NAME_MAX]u8)) != 0 && OperandType(*element[0])
}

// A declaration can bind a scalar or a record. Resolve that choice at each
// specialization; known aggregates still cannot be input/block operands.
TemplateOperandType :: (fn: *IR.ZirFunction, type: *u8) -> bool {
    if OperandType(type) { return true }
    if fn.is_template == 0 || type == null { return false }
    name := ifx type[0] == #char "$" then PtrAdd(type, 1) else type
    return TemplateParameterIndex(*fn.template_param[0], name, strlen(name)) >= 0
}

TemplateResultType :: (fn: *IR.ZirFunction) -> bool {
    if fn.is_template == 0 { return false }
    at := *fn.return_type[0]
    while at[0] != 0 {
        if !IsIdent(at[0]) {
            at = PtrAdd(at, 1)
            continue
        }
        start := at
        at = PtrAdd(at, 1)
        while IsIdent(at[0]) || (at[0] == #char "." && (IsAlpha(at[1]) || at[1] == #char "_")) { at = PtrAdd(at, 1) }
        if TemplateParameterIndex(*fn.template_param[0], start, Distance(start, at)) >= 0 { return true }
    }
    return false
}

// Registers, as families a clobber covers: an x86 vector register whatever
// its width (xmm3, ymm3, zmm3), an AArch64 one (v3, q3, d3, s3, h3, b3), a
// general register in any width, and an ARMv7 q register as its d halves.
// Slots: x86 rax rbx rcx rdx rsi rdi rbp rsp r8..r15, vectors 16..47, k
// 48..55, mm 56..63, st 64; AArch64 x0..x30, sp 31, vectors 32..63; ARMv7
// r0..r15, d16..47 for d0..d31. Other architectures are not modelled.
RegisterSet :: struct { bits: [2]u64 }

Modelled :: (architecture: s32) -> bool { return architecture >= ASM_X86_64 && architecture <= ASM_ARM }

RegisterAdd :: (set: *RegisterSet, slot: s32) {
    word := slot >> 6
    set.bits[word] = set.bits[word] | (cast(u64)1 << cast(u64)(slot & 63))
}

RegisterHas :: (set: *RegisterSet, slot: s32) -> bool {
    return ((set.bits[slot >> 6] >> cast(u64)(slot & 63)) & 1) != 0
}

// The decimal number spelled by the LENGTH bytes at TEXT, or -1.
RegisterNumber :: (text: *u8, length: usize) -> s32 {
    if length == 0 || length > 2 || (length == 2 && text[0] == #char "0") { return -1 }
    value: s32 = 0
    for i: cast(usize)0..length - 1 {
        if !IsDigit(text[i]) { return -1 }
        value = value * 10 + cast(s32)(text[i] - #char "0")
    }
    return value
}

legacy_registers: [8][5]*u8 = .{
    .{CStr("rax"), CStr("eax"), CStr("ax"), CStr("al"), CStr("ah")}, .{CStr("rbx"), CStr("ebx"), CStr("bx"), CStr("bl"), CStr("bh")},
    .{CStr("rcx"), CStr("ecx"), CStr("cx"), CStr("cl"), CStr("ch")}, .{CStr("rdx"), CStr("edx"), CStr("dx"), CStr("dl"), CStr("dh")},
    .{CStr("rsi"), CStr("esi"), CStr("si"), CStr("sil"), CStr("")}, .{CStr("rdi"), CStr("edi"), CStr("di"), CStr("dil"), CStr("")},
    .{CStr("rbp"), CStr("ebp"), CStr("bp"), CStr("bpl"), CStr("")}, .{CStr("rsp"), CStr("esp"), CStr("sp"), CStr("spl"), CStr("")}};
arm_register_aliases: [14]*u8 = .{CStr("ip"), CStr("r12"), CStr("sp"), CStr("r13"), CStr("lr"), CStr("r14"),
    CStr("pc"), CStr("r15"), CStr("fp"), CStr("r11"), CStr("sl"), CStr("r10"), CStr("sb"), CStr("r9")};
x86_64_register_names: [8]*u8 = .{CStr("rax"), CStr("rbx"), CStr("rcx"), CStr("rdx"), CStr("rsi"), CStr("rdi"), CStr("rbp"), CStr("rsp")};
x86_32_register_names: [8]*u8 = .{CStr("eax"), CStr("ebx"), CStr("ecx"), CStr("edx"), CStr("esi"), CStr("edi"), CStr("ebp"), CStr("esp")};

X86RegisterSlots :: (text: *u8, length: usize, slots: *s32) -> s32 {
    for r: cast(s32)0..7 {
        for w: cast(s32)0..4 {
            spelling := legacy_registers[r][w]
            if spelling[0] != 0 && Same(text, spelling) {
                slots[0] = r
                return 1
            }
        }
    }
    if text[0] == #char "r" {
        digits: usize = 1
        while IsDigit(text[digits]) { digits += 1 }
        number := RegisterNumber(PtrAdd(text, 1), digits - 1)
        suffix := PtrAdd(text, digits)
        if number >= 8 && number <= 15 &&
           (suffix[0] == 0 || Same(suffix, CStr("d")) || Same(suffix, CStr("w")) || Same(suffix, CStr("b"))) {
            slots[0] = number
            return 1
        }
        return 0
    }
    if strncmp(text, CStr("xmm"), 3) == 0 || strncmp(text, CStr("ymm"), 3) == 0 || strncmp(text, CStr("zmm"), 3) == 0 {
        vector := RegisterNumber(PtrAdd(text, 3), length - 3)
        if vector >= 0 && vector < 32 {
            slots[0] = 16 + vector
            return 1
        }
    }
    if text[0] == #char "k" {
        mask := RegisterNumber(PtrAdd(text, 1), length - 1)
        if mask >= 0 && mask < 8 {
            slots[0] = 48 + mask
            return 1
        }
    }
    if strncmp(text, CStr("mm"), 2) == 0 {
        multimedia := RegisterNumber(PtrAdd(text, 2), length - 2)
        if multimedia >= 0 && multimedia < 8 {
            slots[0] = 56 + multimedia
            return 1
        }
    }
    if Same(text, CStr("st")) {
        slots[0] = 64
        return 1
    }
    return 0
}

AArch64RegisterSlots :: (text: *u8, length: usize, slots: *s32) -> s32 {
    number := RegisterNumber(PtrAdd(text, 1), length - 1)
    if (text[0] == #char "x" || text[0] == #char "w") && number >= 0 && number <= 30 {
        slots[0] = number
        return 1
    }
    if strchr(CStr("vqdshb"), text[0]) != null && number >= 0 && number < 32 {
        slots[0] = 32 + number
        return 1
    }
    if Same(text, CStr("lr")) {
        slots[0] = 30
        return 1
    }
    if Same(text, CStr("fp")) {
        slots[0] = 29
        return 1
    }
    if Same(text, CStr("sp")) || Same(text, CStr("wsp")) {
        slots[0] = 31
        return 1
    }
    return 0
}

ArmRegisterSlots :: (text: *u8, length: usize, slots: *s32) -> s32 {
    for i: cast(s32)0..6 {
        if Same(text, arm_register_aliases[i * 2]) {
            canonical := arm_register_aliases[i * 2 + 1]
            return RegisterSlots(ASM_ARM, canonical, strlen(canonical), slots)
        }
    }
    number := RegisterNumber(PtrAdd(text, 1), length - 1)
    if text[0] == #char "r" && number >= 0 && number <= 15 {
        slots[0] = number
        return 1
    }
    if text[0] == #char "d" && number >= 0 && number < 32 {
        slots[0] = 16 + number
        return 1
    }
    if text[0] == #char "s" && number >= 0 && number < 32 {
        slots[0] = 16 + number / 2
        return 1
    }
    if text[0] == #char "q" && number >= 0 && number < 16 {
        slots[0] = 16 + 2 * number
        slots[1] = 17 + 2 * number
        return 2
    }
    return 0
}

// Slots the LENGTH bytes at NAME cover: the count (0 when they name no
// register), filling SLOTS.
RegisterSlots :: (architecture: s32, name: *u8, length: usize, slots: *s32) -> s32 {
    text: [16]u8
    if length == 0 || length >= 16 { return 0 }
    for i: cast(usize)0..length - 1 { text[i] = ToLower(name[i]) }
    text[length] = 0
    if IsX86(architecture) { return X86RegisterSlots(*text[0], length, slots) }
    if architecture == ASM_AARCH64 { return AArch64RegisterSlots(*text[0], length, slots) }
    if architecture == ASM_ARM { return ArmRegisterSlots(*text[0], length, slots) }
    return 0
}

// Registers templates may read without declaring them, and clobbers may
// never name: the stack pointer always, and the frame pointer, which GCC
// and Clang reserve in frame-pointer builds (Thumb-2 uses r7, ARM r11);
// AArch64 x18 is the platform register on Android.
RegisterReserved :: (architecture: s32, slot: s32) -> bool {
    if IsX86(architecture) { return slot == 6 || slot == 7 }
    if architecture == ASM_AARCH64 { return slot == 18 || slot == 29 || slot == 31 }
    if architecture == ASM_ARM { return slot == 7 || slot == 11 || slot == 13 || slot == 15 }
    return false
}

RegisterClobberName :: (architecture: s32, slot: s32, out: *u8, size: usize) -> *u8 {
    if IsX86(architecture) {
        if slot < 8 {
            snprintf(out, size, CStr("%s"), ifx architecture == ASM_X86 then x86_32_register_names[slot] else x86_64_register_names[slot])
        } else if slot < 16 {
            snprintf(out, size, CStr("r%d"), slot)
        } else if slot < 48 {
            snprintf(out, size, CStr("xmm%d"), slot - 16)
        } else if slot < 56 {
            snprintf(out, size, CStr("k%d"), slot - 48)
        } else if slot < 64 {
            snprintf(out, size, CStr("mm%d"), slot - 56)
        } else {
            snprintf(out, size, CStr("st"))
        }
    } else if architecture == ASM_AARCH64 {
        if slot < 31 {
            snprintf(out, size, CStr("x%d"), slot)
        } else {
            snprintf(out, size, CStr("v%d"), slot - 32)
        }
    } else {
        if slot == 14 {
            snprintf(out, size, CStr("lr"))
        } else if slot < 16 {
            snprintf(out, size, CStr("r%d"), slot)
        } else {
            snprintf(out, size, CStr("d%d"), slot - 16)
        }
    }
    return out
}

// Parse one clobber item: a register, a range such as xmm0..xmm15 or
// q0..q7, "cc" or "memory". Slots go into SET; 0 with a diagnostic when the
// item is unknown or reserved.
ClobberItem :: (architecture: s32, item: *u8, set: *RegisterSet, memory: *s32, span: IR.ZirSourceSpan) -> s32 {
    if Same(item, CStr("memory")) {
        <<memory = 1
        return 1
    }
    if Same(item, CStr("cc")) { return 1 }
    if !Modelled(architecture) { return 1 }
    if IsX86(architecture) && (Same(item, CStr("dirflag")) || Same(item, CStr("fpsr")) || Same(item, CStr("flags"))) { return 1 }
    dots := strstr(item, CStr(".."))
    first_length := ifx dots != null then Distance(item, dots) else strlen(item)
    slots: [2]s32
    count := RegisterSlots(architecture, item, first_length, *slots[0])
    if count == 0 {
        Diagnostic(span, CStr("check.assembly"), CStr("unknown #asm clobber '%s' for %s"), item, architecture_names[architecture])
        return 0
    }
    last := slots[count - 1]
    if dots != null {
        // Both ends share a spelling, as xmm0..xmm15 or d8..d15 do.
        second := PtrAdd(dots, 2)
        prefix: usize = 0
        while prefix < first_length && !IsDigit(item[prefix]) { prefix += 1 }
        other: [2]s32
        other_count := RegisterSlots(architecture, second, strlen(second), *other[0])
        if other_count == 0 || strncmp(item, second, prefix) != 0 || !IsDigit(second[prefix]) ||
           other[other_count - 1] < slots[0] {
            Diagnostic(span, CStr("check.assembly"), CStr("invalid #asm clobber range '%s'"), item)
            return 0
        }
        last = other[other_count - 1]
    }
    for slot: slots[0]..last {
        if RegisterReserved(architecture, slot) {
            name: [16]u8
            Diagnostic(span, CStr("check.assembly"), CStr("#asm cannot clobber %s, the stack, frame or platform register"),
                       RegisterClobberName(architecture, slot, *name[0], 16))
            return 0
        }
        RegisterAdd(set, slot)
    }
    return 1
}

// All clobbers of a variant; 0 after a diagnostic.
ClobberSet :: (assembly: *Assembly, set: *RegisterSet, memory: *s32, span: IR.ZirSourceSpan) -> s32 {
    items: [30]*u8
    count := OperandList(assembly.part[4], *items[0])
    Zero(cast(*u8)set, size_of(RegisterSet))
    <<memory = 0
    if count < 0 { return AssemblyError(span, CStr("#asm permits at most 30 clobbers separated by semicolons")) }
    for i: cast(s32)0..count - 1 {
        if ClobberItem(assembly.architecture, items[i], set, memory, span) == 0 { return 0 }
    }
    return 1
}

// Registers a constraint fixes, which the template may then name.
PinnedRegisters :: (architecture: s32, constraint: *u8, set: *RegisterSet) {
    if !IsX86(architecture) { return }
    letters := CStr("abcdSD")
    at := constraint
    while at[0] != 0 {
        fixed := strchr(letters, at[0])
        if fixed != null { RegisterAdd(set, cast(s32)Distance(letters, fixed)) }
        if at[0] == #char "A" {
            RegisterAdd(set, 0)
            RegisterAdd(set, 3)
        }
        if at[0] == #char "t" || at[0] == #char "u" { RegisterAdd(set, 64) }
        at = PtrAdd(at, 1)
    }
}

// Whether one of the COUNT operand names spells the LENGTH bytes at TEXT.
OperandNamed :: (names: **u8, count: s32, text: *u8, length: usize) -> s32 {
    for i: cast(s32)0..count - 1 {
        if SameSpan(names[i], text, length) { return i }
    }
    return -1
}

// Check that every register a template names directly is declared, and
// every operand it references exists. x86 templates name registers as
// %%reg; AArch64 and ARMv7 ones as bare words, with ranges such as
// {d0-d3}. NAMES holds the operand aliases, outputs first.
CheckTemplate :: (assembly: *Assembly, names: **u8, count: s32, allowed: *RegisterSet, span: IR.ZirSourceSpan) -> s32 {
    text := assembly.part[1]
    architecture := assembly.architecture
    x86 := IsX86(architecture)
    code := CStr("check.assembly")
    previous_slot: s32 = -1
    at := text
    while at[0] != 0 {
        // Comments run to the end of the line.
        if (x86 && at[0] == #char "#") || (architecture == ASM_AARCH64 && at[0] == #char "/" && at[1] == #char "/") ||
           (architecture == ASM_ARM && at[0] == #char "@") {
            while at[0] != 0 && at[0] != 10 { at = PtrAdd(at, 1) }
            continue
        }
        if at[0] == #char "%" && at[1] == #char "%" {
            at = PtrAdd(at, 2)
            if !x86 { continue }
            named := at
            while IsAlnum(at[0]) { at = PtrAdd(at, 1) }
            named_slots: [2]s32
            named_count := RegisterSlots(architecture, named, Distance(named, at), *named_slots[0])
            for i: cast(s32)0..named_count - 1 {
                // The stack and frame pointers may be read, never clobbered.
                if RegisterReserved(architecture, named_slots[i]) { continue }
                if !RegisterHas(allowed, named_slots[i]) {
                    Diagnostic(span, code, CStr("#asm template uses %%%.*s, which its clobbers and constraints do not declare"),
                               cast(s32)Distance(named, at), named)
                    return 0
                }
            }
            continue
        }
        if at[0] == #char "%" {
            // An operand: %[name], %w[name], %0, %x1.
            operand := PtrAdd(at, 1)
            while IsAlpha(operand[0]) { operand = PtrAdd(operand, 1) }
            if operand[0] == #char "[" {
                close := strchr(operand, #char "]")
                if close == null {
                    Diagnostic(span, code, CStr("#asm template names unknown operand %%%.*s"), 1, CStr("["))
                    return 0
                }
                if OperandNamed(names, count, PtrAdd(operand, 1), Distance(operand, close) - 1) < 0 {
                    Diagnostic(span, code, CStr("#asm template names unknown operand %%%.*s"), cast(s32)Distance(at, close), PtrAdd(at, 1))
                    return 0
                }
                at = PtrAdd(close, 1)
            } else if IsDigit(operand[0]) {
                index: s32 = 0
                while IsDigit(operand[0]) {
                    index = index * 10 + cast(s32)(operand[0] - #char "0")
                    operand = PtrAdd(operand, 1)
                }
                if index >= count {
                    Diagnostic(span, code, CStr("#asm template operand %%%d exceeds its %d operands"), index, count)
                    return 0
                }
                at = operand
            } else if Distance(at, operand) > 1 {
                at = operand
            } else {
                at = PtrAdd(at, 1)
            }
            previous_slot = -1
            continue
        }
        if x86 || !Modelled(architecture) {
            at = PtrAdd(at, 1)
            continue
        }
        if IsAlpha(at[0]) || at[0] == #char "_" {
            word := at
            while IsAlnum(at[0]) || at[0] == #char "_" { at = PtrAdd(at, 1) }
            // Type suffixes (.s16, .8h) and directives are not registers.
            suffix := false
            if cast(usize)word > cast(usize)text {
                before := PtrSub(word, 1)
                suffix = before[0] == #char "." || IsDigit(before[0])
            }
            word_slots: [2]s32
            word_count: s32 = 0
            if !suffix { word_count = RegisterSlots(architecture, word, Distance(word, at), *word_slots[0]) }
            range_from := previous_slot
            previous_slot = -1
            if word_count == 0 { continue }
            if word_count == 1 && RegisterReserved(architecture, word_slots[0]) { continue }
            low := ifx range_from >= 0 && range_from < word_slots[0] then range_from else word_slots[0]
            for slot: low..word_slots[word_count - 1] {
                if !RegisterHas(allowed, slot) {
                    Diagnostic(span, code, CStr("#asm template uses %.*s, which its clobbers do not declare"),
                               cast(s32)Distance(word, at), word)
                    return 0
                }
            }
            // A range continues to the next register: {d0-d3}, {v0.8h-v3.8h}.
            next := at
            while next[0] == #char "." || IsAlnum(next[0]) { next = PtrAdd(next, 1) }
            if next[0] == #char "-" {
                previous_slot = word_slots[word_count - 1]
                at = next
            }
            continue
        }
        if at[0] != #char "-" && at[0] != #char " " { previous_slot = -1 }
        at = PtrAdd(at, 1)
    }
    return 1
}

// Check one variant's clobbers and template; ALIASES name its operands,
// outputs first, with their constraints.
CheckVariant :: (assembly: *Assembly, aliases: **u8, constraints: **u8, count: s32, span: IR.ZirSourceSpan) -> s32 {
    clobbers: RegisterSet
    memory: s32 = 0
    if ClobberSet(assembly, *clobbers, *memory, span) == 0 { return 0 }
    allowed := clobbers
    for i: cast(s32)0..count - 1 {
        pinned: RegisterSet
        Zero(cast(*u8)*pinned, size_of(RegisterSet))
        PinnedRegisters(assembly.architecture, constraints[i], *pinned)
        for slot: cast(s32)0..127 {
            if !RegisterHas(*pinned, slot) { continue }
            if RegisterHas(*clobbers, slot) {
                name: [16]u8
                Diagnostic(span, CStr("check.assembly"), CStr("#asm clobbers %s, which operand %s already holds"),
                           RegisterClobberName(assembly.architecture, slot, *name[0], 16), aliases[i])
                return 0
            }
            RegisterAdd(*allowed, slot)
        }
    }
    return CheckTemplate(assembly, aliases, count, *allowed, span)
}

BlockBinding :: struct {
    constraint: *u8
    alias: *u8
    name: *u8
}

BlockBindings :: struct {
    outputs: s32
    inputs: s32
    items: [30]BlockBinding
}

BlockOperands :: (bindings: *BlockBindings) -> s32 { return bindings.outputs + bindings.inputs }

AssemblyIdentifier :: (name: *u8) -> bool {
    if !IsAlpha(name[0]) && name[0] != #char "_" { return false }
    at := PtrAdd(name, 1)
    while at[0] != 0 {
        if !IsAlnum(at[0]) && at[0] != #char "_" { return false }
        at = PtrAdd(at, 1)
    }
    return !Same(name, CStr("_"))
}

// One block operand, `constraint:alias=binding` or `constraint:binding`,
// stored at POSITION; 0 after a diagnostic.
ReadBlockBinding :: (bindings: *BlockBindings, item: *u8, output: bool, position: s32, span: IR.ZirSourceSpan) -> s32 {
    text: [IR.ZIR_NAME_MAX]u8
    strcpy(*text[0], item)
    separator := strchr(*text[0], #char ":")
    if separator == null {
        return AssemblyError(span, CStr("#asm block operands require constraint:alias=binding (or constraint:binding)"))
    }
    separator[0] = 0
    constraint := trim_in_place(*text[0])
    alias := trim_in_place(PtrAdd(separator, 1))
    name := alias
    equals := strchr(alias, #char "=")
    if equals != null {
        equals[0] = 0
        name = trim_in_place(PtrAdd(equals, 1))
        alias = trim_in_place(alias)
    }
    valid := constraint[0] != 0 && AssemblyIdentifier(alias) && AssemblyIdentifier(name)
    if valid && output { valid = constraint[0] == #char "=" && constraint[1] != 0 }
    if valid && !output { valid = strchr(constraint, #char "=") == null && strchr(constraint, #char "+") == null }
    if !valid { return AssemblyError(span, CStr("invalid #asm block binding or constraint; use = outputs and tied inputs")) }
    for previous: cast(s32)0..position - 1 {
        if Same(bindings.items[previous].alias, alias) { return AssemblyError(span, CStr("duplicate #asm block operand alias")) }
    }
    bindings.items[position].constraint = KeepText(constraint)
    bindings.items[position].alias = KeepName(alias)
    bindings.items[position].name = KeepName(name)
    return 1
}

ReadBlockBindings :: (assembly: *Assembly, bindings: *BlockBindings, span: IR.ZirSourceSpan) -> s32 {
    parts: [30]*u8
    outputs := OperandList(assembly.part[2], *parts[0])
    inputs := OperandList(assembly.part[3], *parts[0])
    if outputs < 0 || inputs < 0 || outputs + inputs > ASSEMBLY_OPERANDS || OperandList(assembly.part[4], *parts[0]) < 0 {
        return AssemblyError(span, CStr("#asm block permits at most 30 operands separated by semicolons"))
    }
    bindings.outputs = outputs
    bindings.inputs = inputs
    for direction: cast(s32)0..1 {
        count := OperandList(assembly.part[direction + 2], *parts[0])
        for i: cast(s32)0..count - 1 {
            position := ifx direction == 0 then i else outputs + i
            if ReadBlockBinding(bindings, parts[i], direction == 0, position, span) == 0 { return 0 }
        }
    }
    return 1
}

OpensScope :: (kind: IR.ZirStmtKind) -> bool {
    return kind == .BLOCK_OPEN || kind == .IF || kind == .WHILE || kind == .FOR
}

// Resolve only real lexical storage. Closed scopes cannot contribute a
// binding, and native helpers must use the same declaration as the checker.
BlockBindingType :: (fn: *IR.ZirFunction, statement: s32, name: *u8) -> *u8 {
    closed: s32 = 0
    index := statement - 1
    while index >= 0 {
        st := StatementAt(fn, index)
        if st.kind == .BLOCK_CLOSE {
            closed += 1
        } else if OpensScope(st.kind) {
            if closed != 0 { closed -= 1 }
        } else if closed == 0 && st.kind == .DECL && Same(st.name, name) {
            return st.type
        }
        index -= 1
    }
    parameters := ParametersOf(FunctionArgs(fn))
    for i: cast(s32)0..parameters.count - 1 {
        parameter := ParameterAt(parameters, i)
        if parameter.name != null && Same(parameter.name, name) { return parameter.type }
    }
    return null
}

// Native assembly falls through. Its portable replacement must do so too;
// control inside a loop wholly contained in the block is fine.
CheckBlockFallsThrough :: (fn: *IR.ZirFunction, statement: s32) -> s32 {
    depth: s32 = 1
    for index: statement + 1..fn.stmt_count - 1 {
        body := StatementAt(fn, index)
        if body.kind == .BLOCK_CLOSE {
            depth -= 1
            if depth == 0 { break }
        }
        if OpensScope(body.kind) { depth += 1 }
        if body.kind == .RETURN || body.kind == .UNREACHABLE {
            return AssemblyError(body.span, CStr("#asm portable block must fall through"))
        }
        if body.kind == .BREAK || body.kind == .CONTINUE {
            closed: s32 = 0
            local_loop := false
            inner := index - 1
            while inner > statement {
                enclosing := StatementAt(fn, inner)
                if enclosing.kind == .BLOCK_CLOSE {
                    closed += 1
                } else if OpensScope(enclosing.kind) {
                    if closed != 0 {
                        closed -= 1
                    } else if enclosing.kind == .WHILE && (body.target_id == 0 || enclosing.loop_id == body.target_id) {
                        local_loop = true
                        break
                    }
                }
                inner -= 1
            }
            if !local_loop { return AssemblyError(body.span, CStr("#asm portable block cannot leave its scope")) }
        }
    }
    return 1
}

// A procedure value cannot be absent, so callers without a binding callback
// pass this one and ask for the lexical lookup instead.
LexicalBinding :: (context: *void, name: *u8) -> *u8 { return null }

// Checks the #asm block opened at STATEMENT. Operand types come from
// BINDING, or from the enclosing declarations when LEXICAL is set.
CheckBlock :: (fn: *IR.ZirFunction, statement: s32, binding: AssemblyBinding, context: *void, lexical: bool) -> s32 {
    st := StatementAt(fn, statement)
    if !StatementHasAssembly(st) {
        if !StartsAssembly(st.text) { return 1 }
        return AssemblyError(st.span, CStr("missing #asm block metadata"))
    }
    if st.kind != .BLOCK_OPEN || fn.is_extern != 0 || fn.is_global_initializer != 0 {
        return AssemblyError(st.span, CStr("#asm blocks require an ordinary procedure scope"))
    }
    if st.expr_root != -1 || st.lhs_root != -1 || st.type[0] != 0 || st.assignment_op[0] != 0 ||
       st.is_using != 0 || st.is_else != 0 || st.is_parallel != 0 || st.is_gpu != 0 {
        return AssemblyError(st.span, CStr("invalid #asm block statement metadata"))
    }
    canonical := AssemblyBlockText(st.text, st.span)
    if canonical == null || !AssemblyTextMatches(canonical, st.assembly_text) {
        return AssemblyError(st.span, CStr("#asm block metadata does not match its source"))
    }
    mismatch := CStr("#asm block variants must bind the same operands in the same order")
    cursor := st.assembly_text
    architectures_seen: [30]s32
    platforms_seen: [30]s32
    features_seen: [30]u64
    variants: s32 = 0
    first: BlockBindings
    while NextByte(cursor) != 0 {
        assembly: Assembly
        current: BlockBindings
        Zero(cast(*u8)*current, size_of(BlockBindings))
        if ReadAssembly(*cursor, *assembly, st.span) == 0 || ReadBlockBindings(*assembly, *current, st.span) == 0 { return 0 }
        if variants == ASSEMBLY_OPERANDS { return AssemblyError(st.span, CStr("too many #asm block variants")) }
        if AssemblyRequired(assembly.part[5]) { return AssemblyError(st.span, CStr("target-only #asm requires a procedure")) }
        for seen: cast(s32)0..variants - 1 {
            covers_os := platforms_seen[seen] == ASM_ANY_OS || platforms_seen[seen] == assembly.platform
            if architectures_seen[seen] == assembly.architecture && covers_os &&
                (features_seen[seen] & assembly.features) == features_seen[seen] {
                return AssemblyError(st.span, CStr("duplicate or shadowed #asm block variant"))
            }
        }
        architectures_seen[variants] = assembly.architecture
        platforms_seen[variants] = assembly.platform
        features_seen[variants] = assembly.features
        aliases: [30]*u8
        constraints: [30]*u8
        total := BlockOperands(*current)
        for i: cast(s32)0..total - 1 {
            aliases[i] = current.items[i].alias
            constraints[i] = current.items[i].constraint
        }
        if CheckVariant(*assembly, *aliases[0], *constraints[0], total, st.span) == 0 { return 0 }
        if variants == 0 { first = current }
        if first.inputs != current.inputs || first.outputs != current.outputs { return AssemblyError(st.span, mismatch) }
        for i: cast(s32)0..total - 1 {
            operand := *current.items[i]
            if !Same(first.items[i].alias, operand.alias) || !Same(first.items[i].name, operand.name) {
                return AssemblyError(st.span, mismatch)
            }
            type: *u8 = null
            if lexical {
                type = BlockBindingType(fn, statement, operand.name)
            } else {
                type = binding(context, operand.name)
            }
            deferred := fn.is_template != 0 && type != null && type[0] == 0
            if !deferred && !TemplateOperandType(fn, type) {
                return AssemblyError(st.span, CStr("#asm block bindings must be scalar/pointer locals or parameters"))
            }
        }
        variants += 1
    }
    if CheckBlockFallsThrough(fn, statement) == 0 { return 0 }
    return ifx variants > 0 then 1 else 0
}

#program_export
CheckAssemblyBlock :: (fn: *IR.ZirFunction, statement: s32, binding: AssemblyBinding, context: *void) -> s32 {
    return CheckBlock(fn, statement, binding, context, binding == null)
}

// CheckAssemblyBlock with the lexical lookup of bindings.
CheckBlockStatement :: (fn: *IR.ZirFunction, statement: s32) -> s32 {
    return CheckBlock(fn, statement, LexicalBinding, null, true)
}

#program_export
AssemblyBlockOperands :: (fn: *IR.ZirFunction, statement: s32, names: **u8, types: **u8, capacity: s32, outputs: *s32) -> s32 {
    st := StatementAt(fn, statement)
    if outputs != null { <<outputs = 0 }
    if !StatementHasAssembly(st) { return 0 }
    cursor := st.assembly_text
    assembly: Assembly
    bindings: BlockBindings
    Zero(cast(*u8)*bindings, size_of(BlockBindings))
    if ReadAssembly(*cursor, *assembly, st.span) == 0 || ReadBlockBindings(*assembly, *bindings, st.span) == 0 { return -1 }
    count := BlockOperands(*bindings)
    if count > capacity { return -1 }
    if outputs != null { <<outputs = bindings.outputs }
    for i: cast(s32)0..count - 1 {
        names[i] = bindings.items[i].name
        types[i] = BlockBindingType(fn, statement, names[i])
    }
    return count
}

// The outputs a procedure's assembly writes: its scalar result as "out", or
// each field of its result record as "out_FIELD". 0 when the result cannot
// be an assembly operand.
AssemblyOutputsOf :: (module: *IR.ZirModule, fn: *IR.ZirFunction, outputs: *AssemblyOutputs) -> s32 {
    result := *fn.return_type[0]
    if Same(result, CStr("void")) { return 1 }
    if OperandType(result) {
        strcpy(OutputName(outputs, 0), CStr("out"))
        outputs.count = 1
        return 1
    }
    type := FindType(module, result, null)
    if type == null || type.is_union != 0 || type.is_extern != 0 || type.is_procedure_type != 0 { return 0 }
    offset: usize = 0
    field: IR.ZirTypeField
    status: s32 = 0
    outputs.record = 1
    while true {
        status = TypeNextField(type, *offset, *field)
        if status != 1 { break }
        if outputs.count == ASSEMBLY_OPERANDS || !OperandType(*field.type[0]) || field.is_using != 0 ||
           Same(*field.name[0], CStr("_")) { return 0 }
        outputs.fields[outputs.count] = field
        snprintf(OutputName(outputs, outputs.count), OUTPUT_NAME_SIZE, CStr("out_%s"), *field.name[0])
        outputs.count += 1
    }
    return ifx status == 0 && outputs.count > 0 then 1 else 0
}

NewAssemblyOutputs :: () -> *AssemblyOutputs {
    return cast(*AssemblyOutputs)calloc(1, size_of(AssemblyOutputs))
}

FreeAssemblyOutputs :: (outputs: *AssemblyOutputs) { free(cast(*u8)outputs) }


// Advance over one checked variant. STATEMENT -1 selects the procedure's
// variants; otherwise it selects a local assembly block. 1 for a value, 0 at
// the end, -1 for invalid metadata. The frontend remains responsible for
// semantic checks.
#program_export
AssemblyVariantNext :: (module: *IR.ZirModule, fn: *IR.ZirFunction, statement: s32, cursor: **u8, variant: *AssemblyVariant) -> s32 {
    if cursor == null || <<cursor == null || NextByte(<<cursor) == 0 { return 0 }
    span := fn.span
    if statement >= 0 {
        block := StatementAt(fn, statement)
        span = block.span
    }
    assembly: Assembly
    if ReadAssembly(cursor, *assembly, span) == 0 { return -1 }
    Zero(cast(*u8)variant, size_of(AssemblyVariant))
    variant.target = assembly.part[0]
    variant.text = assembly.part[1]
    variant.clobbers = assembly.part[4]
    variant.options = assembly.part[5]
    if statement >= 0 {
        bindings: BlockBindings
        Zero(cast(*u8)*bindings, size_of(BlockBindings))
        if ReadBlockBindings(*assembly, *bindings, span) == 0 { return -1 }
        variant.outputs = bindings.outputs
        variant.inputs = bindings.inputs
        for i: cast(s32)0..BlockOperands(*bindings) - 1 {
            type := BlockBindingType(fn, statement, bindings.items[i].name)
            if type == null { return -1 }
            variant.operands[i].constraint = bindings.items[i].constraint
            variant.operands[i].alias = bindings.items[i].alias
            variant.operands[i].binding = bindings.items[i].name
            variant.operands[i].type = type
        }
        return 1
    }
    outputs := NewAssemblyOutputs()
    if outputs == null { return -1 }
    parameters := ParametersOf(FunctionArgs(fn))
    output_items: [30]*u8
    input_items: [30]*u8
    valid := AssemblyOutputsOf(module, fn, outputs)
    output_count := OperandList(assembly.part[2], *output_items[0])
    input_count := OperandList(assembly.part[3], *input_items[0])
    if valid == 0 || output_count != outputs.count || input_count != parameters.count ||
       output_count + input_count > ASSEMBLY_OPERANDS {
        FreeAssemblyOutputs(outputs)
        return -1
    }
    variant.outputs = output_count
    variant.inputs = input_count
    variant.record = outputs.record
    for i: cast(s32)0..output_count - 1 {
        variant.operands[i].constraint = output_items[i]
        variant.operands[i].alias = KeepText(OutputName(outputs, i))
        if outputs.record != 0 {
            variant.operands[i].binding = KeepText(*outputs.fields[i].name[0])
            variant.operands[i].type = KeepText(*outputs.fields[i].type[0])
        } else {
            variant.operands[i].binding = CStr("out")
            variant.operands[i].type = *fn.return_type[0]
        }
    }
    for i: cast(s32)0..input_count - 1 {
        parameter := ParameterAt(parameters, i)
        variant.operands[output_count + i].constraint = input_items[i]
        variant.operands[output_count + i].alias = parameter.name
        variant.operands[output_count + i].binding = parameter.name
        variant.operands[output_count + i].type = parameter.type
    }
    FreeAssemblyOutputs(outputs)
    return 1
}

// One procedure variant's constraint lists against its results and
// parameters, then its clobbers and template. 0 after a diagnostic.
CheckProcedureVariant :: (assembly: *Assembly, fn: *IR.ZirFunction, outputs: *AssemblyOutputs, parameters: *Parameters,
                          deferred_outputs: bool) -> s32 {
    output_items: [30]*u8
    input_items: [30]*u8
    clobber_items: [30]*u8
    output_count := OperandList(assembly.part[2], *output_items[0])
    input_count := OperandList(assembly.part[3], *input_items[0])
    clobber_count := OperandList(assembly.part[4], *clobber_items[0])
    if output_count < 0 || input_count < 0 || output_count + input_count > ASSEMBLY_OPERANDS || clobber_count < 0 ||
       (!deferred_outputs && output_count != outputs.count) || input_count != parameters.count {
        return AssemblyError(fn.span, CStr("#asm constraint counts must match results and parameters; separate items with semicolons"))
    }
    directions := true
    for i: cast(s32)0..output_count - 1 {
        item := output_items[i]
        if item[0] != #char "=" || item[1] == 0 { directions = false }
    }
    for i: cast(s32)0..input_count - 1 {
        if strchr(input_items[i], #char "=") != null || strchr(input_items[i], #char "+") != null { directions = false }
    }
    if !directions {
        return AssemblyError(fn.span, CStr("#asm outputs need = constraints; use tied inputs for read/write operands"))
    }
    if deferred_outputs { return 1 }
    aliases: [30]*u8
    constraints: [30]*u8
    for i: cast(s32)0..output_count - 1 {
        aliases[i] = OutputName(outputs, i)
        constraints[i] = output_items[i]
    }
    for i: cast(s32)0..input_count - 1 {
        parameter := ParameterAt(parameters, i)
        aliases[output_count + i] = parameter.name
        constraints[output_count + i] = input_items[i]
    }
    return CheckVariant(assembly, *aliases[0], *constraints[0], output_count + input_count, fn.span)
}

// Every variant of a procedure: distinct per architecture, and none hidden
// behind an earlier baseline or feature subset. 0 after a diagnostic.
CheckProcedureVariants :: (fn: *IR.ZirFunction, outputs: *AssemblyOutputs, parameters: *Parameters, deferred_outputs: bool) -> s32 {
    architecture: [30]s32
    platforms: [30]s32
    features: [30]u64
    variants: s32 = 0
    required := false
    cursor := fn.assembly_text
    while NextByte(cursor) != 0 {
        assembly: Assembly
        if ReadAssembly(*cursor, *assembly, fn.span) == 0 { return 0 }
        if variants == 0 { required = AssemblyRequired(assembly.part[5]) }
        else if required != AssemblyRequired(assembly.part[5]) {
            return AssemblyError(fn.span, CStr("all #asm variants of a procedure must agree on target-only"))
        }
        if variants == ASSEMBLY_OPERANDS { return AssemblyError(fn.span, CStr("too many #asm variants")) }
        for seen: cast(s32)0..variants - 1 {
            covers_os := platforms[seen] == ASM_ANY_OS || platforms[seen] == assembly.platform
            if architecture[seen] == assembly.architecture && covers_os && (features[seen] & assembly.features) == features[seen] {
                if features[seen] == assembly.features && platforms[seen] == assembly.platform {
                    return AssemblyError(fn.span, CStr("duplicate or too many #asm architecture variants"))
                }
                return AssemblyError(fn.span, CStr("#asm variant is shadowed by an earlier feature or baseline variant"))
            }
        }
        architecture[variants] = assembly.architecture
        platforms[variants] = assembly.platform
        features[variants] = assembly.features
        variants += 1
        if CheckProcedureVariant(*assembly, fn, outputs, parameters, deferred_outputs) == 0 { return 0 }
    }
    if required && (fn.stmt_count != 1 || StatementAt(fn, 0).kind != .UNREACHABLE) {
        return AssemblyError(fn.span, CStr("a target-only #asm procedure requires a single unreachable statement as its body"))
    }
    return ifx variants > 0 then 1 else 0
}

#program_export
CheckAssembly :: (module: *IR.ZirModule, fn: *IR.ZirFunction) -> s32 {
    if fn.assembly_text == null || fn.assembly_text[0] == 0 { return 1 }
    if fn.is_extern != 0 || fn.is_global_initializer != 0 {
        return AssemblyError(fn.span, CStr("#asm requires an ordinary procedure with a portable body"))
    }
    outputs := NewAssemblyOutputs()
    if outputs == null { return AssemblyError(fn.span, CStr("out of memory checking #asm")) }
    deferred_outputs := TemplateResultType(fn)
    valid_outputs := deferred_outputs
    if !valid_outputs { valid_outputs = AssemblyOutputsOf(module, fn, outputs) != 0 }
    parameters := ParametersOf(FunctionArgs(fn))
    if !valid_outputs || parameters.count + outputs.count > ASSEMBLY_OPERANDS {
        FreeAssemblyOutputs(outputs)
        return AssemblyError(fn.span, CStr("#asm needs scalar/pointer operands or a record of scalar/pointer results (at most 30 operands)"))
    }
    for i: cast(s32)0..parameters.count - 1 {
        parameter := ParameterAt(parameters, i)
        declared := ifx parameter.type != null then FindType(module, parameter.type, null) else null
        procedure := declared != null && declared.is_procedure_type != 0
        if parameter.name == null || (!TemplateOperandType(fn, parameter.type) && !SliceOperand(parameter.type) && !procedure) {
            FreeAssemblyOutputs(outputs)
            return AssemblyError(fn.span, CStr("#asm parameters must be named scalars, pointers or slices of scalars"))
        }
        for j: cast(s32)0..outputs.count - 1 {
            if Same(parameter.name, OutputName(outputs, j)) {
                FreeAssemblyOutputs(outputs)
                return AssemblyError(fn.span, CStr("#asm parameter conflicts with an output operand name"))
            }
        }
    }
    checked := CheckProcedureVariants(fn, outputs, parameters, deferred_outputs)
    FreeAssemblyOutputs(outputs)
    return checked
}

// Inputs with a possible memory alternative must retain their storage when
// an isolated feature helper is called. Unknown target classes are cautious.
#program_export
AssemblyInputNeedsStorage :: (constraint: *u8) -> s32 {
    registers := CStr("0123456789,=+&%!*#? rfvxwabcdqSDAt")
    at := constraint
    while at[0] != 0 {
        if at[0] == #char "[" {
            while at[1] != 0 && at[0] != #char "]" { at = PtrAdd(at, 1) }
            if at[0] != #char "]" { return 1 }
        } else if strchr(registers, at[0]) == null {
            return 1
        }
        at = PtrAdd(at, 1)
    }
    return 0
}

// The output an input constraint ties to, by number or by [alias]; -1 when
// it ties to none.
#program_export
AssemblyTiedOutput :: (source: *AssemblyVariant, constraint: *u8) -> s32 {
    if IsDigit(constraint[0]) {
        end: *u8 = null
        index := strtol(constraint, *end, 10)
        if end[0] == 0 && index >= 0 && index < cast(isize)source.outputs { return cast(s32)index }
        return -1
    }
    if constraint[0] == #char "[" {
        length := strlen(constraint)
        if length > 2 && constraint[length - 1] == #char "]" {
            for i: cast(s32)0..source.outputs - 1 {
                if SameSpan(source.operands[i].alias, PtrAdd(constraint, 1), length - 2) { return i }
            }
        }
    }
    return -1
}

// GNU alternatives select one column across every operand. Direction and
// commutativity apply to the whole constraint; early clobbers stay local.
#program_export
AssemblyAlternativeCount :: (source: *AssemblyVariant) -> s32 {
    count: s32 = 0
    for i: cast(s32)0..source.outputs + source.inputs - 1 {
        alternatives: s32 = 1
        at := source.operands[i].constraint
        while at[0] != 0 {
            if at[0] == #char "," { alternatives += 1 }
            at = PtrAdd(at, 1)
        }
        if count != 0 && count != alternatives { return 0 }
        count = alternatives
    }
    return ifx count != 0 then count else 1
}

// Direction is already known; commutativity permits but does not require
// swapping the inputs. Native emitters keep their declared order.
#program_export
AssemblyConstraintAlternative :: (constraint: *u8, column: s32) -> *u8 {
    at := constraint
    while at[0] == #char "=" || at[0] == #char "%" { at = PtrAdd(at, 1) }
    for skipped: cast(s32)0..column - 1 {
        comma := strchr(at, #char ",")
        if comma == null { return CStr("") }
        at = PtrAdd(comma, 1)
    }
    end := strchr(at, #char ",")
    length := ifx end != null then Distance(at, end) else strlen(at)
    word: [IR.ZIR_NAME_MAX]u8
    if length >= size_of([IR.ZIR_NAME_MAX]u8) { return CStr("") }
    memcpy(*word[0], at, length)
    word[length] = 0
    return KeepText(*word[0])
}
