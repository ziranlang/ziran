// Whether TEXT is one call, NAME(...) or Module.NAME(...), with nothing
// around it: `TextLines(s)` but not `a + F()` or `F()[1:]`.
call_collection :: (text: *u8) -> bool {
    value := IR.CText(text)
    end := value.count
    while end > 0 && (value[end - 1] == 32 || value[end - 1] == 9) { end -= 1 }
    start: s64 = 0
    while start < end && (value[start] == 32 || value[start] == 9) { start += 1 }
    if end - start < 3 || value[end - 1] != #char ")" || !name_start(value[start]) { return false }
    name_end := start
    while name_end < end && (name_start(value[name_end]) || (value[name_end] >= #char "0" && value[name_end] <= #char "9") || value[name_end] == #char ".") { name_end += 1 }
    if name_end >= end || value[name_end] != #char "(" { return false }
    // The parenthesis after the name closes at the very end.
    depth: s32 = 0
    at := name_end
    while at < end {
        byte := value[at]
        if byte == #char "\"" {
            at += 1
            while at < end && value[at] != #char "\"" { at += ifx value[at] == #char "\\" then 2 else 1 }
        } else if byte == #char "(" {
            depth += 1
        } else if byte == #char ")" {
            depth -= 1
            if depth == 0 && at != end - 1 { return false }
        }
        at += 1
    }
    return depth == 0
}

name_start :: (byte: u8) -> bool {
    return (byte >= #char "a" && byte <= #char "z") || (byte >= #char "A" && byte <= #char "Z") || byte == #char "_"
}

