    if !(portable_signature_type(module, cast(*u8)(*((fn).return_type)), 0) != 0) {
        snprintf(detail, size, ParserCString("%s result is outside the portable ABI"), cast(*u8)(*((law).payload)))
        return 1
    }
    snprintf(detail, size, ParserCString("%s has a portable signature"), cast(*u8)(*((law).payload)))
    return 0
}


