            snprintf(detail, size, ParserCString("%s is foreign; its ABI is the host contract"), cast(*u8)(*((law).payload)))
            return 2
        }
        snprintf(detail, size, ParserCString("no visible procedure named %s"), cast(*u8)(*((law).payload)))
        return 1
    }
    if ((fn).is_extern != 0) {
        snprintf(detail, size, ParserCString("%s is foreign; its ABI is the host contract"), cast(*u8)(*((law).payload)))
        return 2
