    copy_text(cast(*u8)(*((evidence).method)), cast(usize)size_of(CoreArray16_u8), (ifx !(strcmp(cast(*u8)(*((law).kind)), ParserCString("theorem")) != 0) then ParserCString("kernel") else (ifx !(strcmp(cast(*u8)(*((law).kind)), ParserCString("forall")) != 0) then ParserCString("exhaustive") else (ifx !(strcmp(cast(*u8)(*((law).kind)), ParserCString("custom")) != 0) then ParserCString("evaluation") else ParserCString("structural")))))
    arrow: *u8 = strstr(cast(*u8)(*((law).payload)), ParserCString("=>"))
    if ((arrow != null) && (!(strcmp(cast(*u8)(*((law).kind)), ParserCString("forall")) != 0) || !(strcmp(cast(*u8)(*((law).kind)), ParserCString("theorem")) != 0))) {
        snprintf(cast(*u8)(*((evidence).domain)), cast(usize)size_of(CoreArray4096_u8), ParserCString("%.*s"), cast(s32)(((cast(isize)(cast(usize)(arrow) - cast(usize)(cast(*u8)(*((law).payload)))) / cast(isize)size_of(u8)))), cast(*u8)(*((law).payload)))
