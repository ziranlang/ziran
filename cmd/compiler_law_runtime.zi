law_status_name :: (status: s32) -> *u8 {
    return (ifx (cast(u32)(status) == cast(u32)(0)) then ParserCString("proved") else (ifx (cast(u32)(status) == cast(u32)(1)) then ParserCString("disproved") else (ifx (cast(u32)(status) == cast(u32)(3)) then ParserCString("invalid") else ParserCString("unknown"))))
}


#scope_file
evaluate_type_law :: (module: *IR.ZirModule, law: *IR.ZirLaw, detail: *u8, size: usize) -> s32 {
    type: *IR.ZirType = FindType(module, cast(*u8)(*((law).payload)), null)
    if (type == cast(*IR.ZirType)((null))) {
        snprintf(detail, size, ParserCString("no visible type named %s"), cast(*u8)(*((law).payload)))
        return 1
    }
    if ((((type).is_record_template != 0) || ((type).is_extern != 0)) || ((type).is_procedure_type != 0)) {
        snprintf(detail, size, ParserCString("%s is generic or external; no concrete layout to check"), cast(*u8)(*((law).payload)))
        return 2
    }
    if ((type).is_enum != 0) {
        if (EnumMemberValue(type, null, null) != 0) {
            snprintf(detail, size, ParserCString("%s is a concrete enum"), cast(*u8)(*((law).payload)))
            return 0
        }
        snprintf(detail, size, ParserCString("%s has no valid member"), cast(*u8)(*((law).payload)))
        return 1
    }
    bytes: usize
    alignment: usize
    if (TypeLayout(module, cast(*u8)(*((law).payload)), *(bytes), *(alignment)) != 0) {
        snprintf(detail, size, ParserCString("%s lays out as %zu bytes"), cast(*u8)(*((law).payload)), bytes)
        return 0
    }
    snprintf(detail, size, ParserCString("%s has an incomplete field layout"), cast(*u8)(*((law).payload)))
    return 1
}


