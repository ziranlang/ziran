#scope_export
#program_export "EvaluateLaw"
EvaluateLaw :: (program: *IR.ZirProgram, module: *IR.ZirModule, law: *IR.ZirLaw, detail: *u8, size: usize) -> s32 {
    cached: *IR.ZirLaw = cast(*IR.ZirLaw)(law)
    if ((((cached).evaluated_in == module) && ((cached).evaluated_proof == (law).proof)) && ((cached).evaluated_detail != cast(*u8)((null)))) {
        copy_text(detail, size, (cached).evaluated_detail)
        return (cached).evaluated_status
    }
    status: s32 = evaluate_law_uncached(module, law, detail, size)
    (cached).evaluated_in = module
    (cached).evaluated_proof = (law).proof
    (cached).evaluated_status = status
    (cached).evaluated_detail = KeepText(detail)
    return status
}


#scope_file
evaluate_law_uncached :: (module: *IR.ZirModule, law: *IR.ZirLaw, detail: *u8, size: usize) -> s32 {
    status: s32
