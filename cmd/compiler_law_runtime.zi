    if (record == cast(*IR.ZirType)((null))) {
        return 0
    }
    if ((record).is_enum != 0) {
        return EnumMemberValue(record, null, null)
    }
    if (((((record).is_extern != 0) || ((record).is_record_template != 0)) || ((record).is_procedure_type != 0)) || ((record).is_union != 0)) {
