// Closed semantic vocabulary for the offline learner. A mined sequence may
// propose one of these rules; it cannot supply executable optimizer code.
LearningPolicyVersion :: 1
LearningRule :: enum s32 { None; MultiplyPower; MultiplyScaledAdd }
LearningTuning :: struct {
    leaf_operations: s32
    unroll_factor: s32
    block_layout: s32
    allocation: s32
}

LearningRuleForFactor :: (factor: s64) -> LearningRule {
    if factor == 2 || factor == 3 || factor == 5 || factor == 9 { return .MultiplyScaledAdd }
    if factor < 2 || factor > 1073741824 { return .None }
    bits := cast(u64)factor
    return ifx (bits & (bits - 1)) == 0 then .MultiplyPower else .None
}

// Only implemented choices are legal. New policies need a consumer and
// parity coverage before widening this domain.
LearningTuningValid :: (policy: LearningTuning) -> bool {
    return policy.leaf_operations >= 0 && policy.leaf_operations <= 1 &&
        policy.unroll_factor == 1 && policy.block_layout >= 0 && policy.block_layout <= 1 && policy.allocation == 0
}

LearningRewriteValue :: (rule: LearningRule, value: u64, factor: s64) -> u64 {
    if rule == .MultiplyScaledAdd {
        if factor == 2 { return value + value }
        if factor == 3 { return value + (value << 1) }
        if factor == 5 { return value + (value << 2) }
        if factor == 9 { return value + (value << 3) }
    }
    if rule == .MultiplyPower {
        power := cast(u64)factor
        shift: u64
        while power > 1 { power = power >> 1; shift += 1 }
        return value << shift
    }
    return value
}

// A deterministic preflight, additional to C/native differential execution.
// Test every supported parameter, not just the factors the teacher observed.
LearningCheckFamily :: (rule: LearningRule) -> bool {
    if rule != .MultiplyPower && rule != .MultiplyScaledAdd { return false }
    edges := u64.[0, 1, 127, 128, 255, 256, 32767, 32768, 65535, 65536,
        2147483647, 2147483648, 4294967295, 4294967296, 9223372036854775807,
        9223372036854775808, 18446744073709551615]
    for index: 0..33 {
        factor: s64
        if index < 30 { factor = cast(s64)(cast(u64)1 << cast(u64)(index + 1)) }
        else if index == 30 { factor = 2 }
        else if index == 31 { factor = 3 }
        else if index == 32 { factor = 5 }
        else { factor = 9 }
        if LearningRuleForFactor(factor) != rule { continue }
        random: u64 = 521288629
        for trial: 0..2064 {
            random = random ^ (random << 13)
            random = random ^ (random >> 7)
            random = random ^ (random << 17)
            value := ifx trial < edges.count then edges[trial] else random
            expected := value * cast(u64)factor
            actual := LearningRewriteValue(rule, value, factor)
            if actual != expected { return false }
        }
    }
    return true
}
