using Lir :: #import "compiler_lowered_ir"
using Machine :: #import "compiler_machine_ir"
using Vectors :: #import "std/vec"

// Frame storage and in-place views for the aggregate (stack-class) values of
// one LIR function, planned before machine lowering. This is the native
// counterpart of zx2wasm's coalesce_aggregates and plan_views.
//
// Storage: aggregate values whose lifetimes never overlap share one frame
// object. An insert takes its source's object when the source dies there, so
// it changes one member in place; a block parameter takes its arguments'
// objects, so loop-carried and branch-joined aggregates need no edge copy.
// This is SSA coalescing over the liveness of the aggregate values alone; an
// instruction's aggregate operands conflict with its result, except the
// source of an insert.
//
// Split records: a small record of scalar fields that is only built,
// changed and read by constant member and passed between blocks never needs
// memory; each of its values is a set of field values, so a loop-carried
// header such as a vector's lives in registers.
//
// Placement: a member value built only to be put into a parent's storage is
// built there. A class whose every definition and use lies in one block, with
// exactly one use outside it, as the value of an aggregate build or of an
// insert that updates its source in place, takes a frame object inside the
// parent's at the member's offset, provided nothing between its first
// definition and that use touches the parent's storage; the copy at the use
// then moves a member onto itself and emits nothing.
//
// Views: an extract read only by extracts in its own block, while nothing
// writes the storage it reads, is read in place through its address. One
// that a single insert then changes and puts straight back where it came
// from is changed in place, and the put-back insert emits nothing. A view
// takes the address an earlier view of the same storage and member computed
// where that one dominates it, so a loop body checks an index once.

MachineAggregateView :: enum s32 { None; Read; Changed; PutBack }

MachineAggregatePlan :: struct {
    // Per value: the representative whose frame object it uses (itself for
    // a scalar); its view kind; for a view, the representative of the storage
    // it reads and the view whose address it uses (itself when it computes
    // it). Per representative: whether a value of its class needs the object.
    slot: Vec(s32)
    view: Vec(MachineAggregateView)
    root: Vec(s32)
    address: Vec(s32)
    storage: Vec(bool)
    // Per value: a split record value, kept as one value per field.
    split: Vec(bool)
    // Per representative: the representative of the class whose frame object
    // its object lies inside (MachineNoId: one of its own) and the byte offset
    // it starts at.
    place_root: Vec(s32)
    place_at: Vec(s64)
    // Per value: for a view, the byte offset of the member it names inside its
    // root's storage (-1 when not constant); for an insert of a view, whether
    // its member value was built in place, so there is nothing to copy; for
    // an aggregate build, whether every member is replaced before it is read,
    // so building it emits nothing.
    view_at: Vec(s64)
    built_in_place: Vec(bool)
    covered: Vec(bool)
    // Whether the aggregate the function returns is built in the caller's
    // result memory (see Place): its class and every class placed in it have
    // place_root MachineAggregateInResult.
    result_placed: bool
    // Work spent by the last build.
    work: s64
    // Scratch, reused across functions. Per representative, for placement:
    // the one block holding every definition and use of its class (-1 none
    // yet, -2 several blocks or an edge), its first definition there, its
    // uses outside the class and the last of them, the last instruction that
    // defines or uses any of its values, whether the class owns a
    // function parameter, and where it was placed.
    class_block: Vec(s32)
    class_first: Vec(s32)
    class_outside: Vec(s32)
    class_item: Vec(s32)
    class_last: Vec(s32)
    class_fixed: Vec(bool)
    class_into: Vec(s32)
    class_at: Vec(s64)
    cover_root: Vec(s32)
    cover_mask: Vec(u64)
    index: Vec(s32)
    parent: Vec(s32)
    representative: Vec(s32)
    live: Vec(u64)
    live_in: Vec(u64)
    live_out: Vec(u64)
    interfere: Vec(u64)
    members: Vec(u64)
    home: Vec(s32)
    read: Vec(s32)
    update: Vec(s32)
    other: Vec(s32)
    uses: Vec(s32)
    successor_begin: Vec(s32)
    successors: Vec(s32)
    predecessor_begin: Vec(s32)
    predecessors: Vec(s32)
    cursor: Vec(s32)
    pending: Vec(s32)
    order: Vec(s32)
    position: Vec(s32)
    dominator: Vec(s32)
    block_of: Vec(s32)
    key_parent: Vec(s32)
    key_member: Vec(u64)
    key_dynamic: Vec(bool)
    chain_head: Vec(s32)
    chain_next: Vec(s32)
}

// The place_root of a class built in the caller's result memory, and the
// class_into of the one class that is.
MachineAggregateInResult :: -2

// The smallest returned aggregate built in the caller's result memory: the
// function then saves, sets and restores the result register (three
// instructions), which the copy it saves must outweigh. Copies of less than
// 16 bytes are one or two 8-byte moves through the scratch register.
MachineAggregateResultBytes :: 16

// Read and changed views have no storage of their own; a put-back value is
// stored in its root like any other.
MachineAggregateViewed :: (view: MachineAggregateView) -> bool { return view == .Read || view == .Changed }

#scope_file

// Coalescing compares every pair of aggregate values; past these sizes each
// value keeps its own object, which is always correct.
MaximumAggregates :: 8192
MaximumLiveWords :: 4194304

Context :: struct {
    plan: *MachineAggregatePlan
    function: LirFunction
    program: LirProgram
    stack_size: []s64
    sizes: []s64
    results: bool
    place_left: s64
    budget: s64
    bytes: s64
    problem: MachineProblem
    count: s64
    width: s64
}

Fail :: (context: *Context, problem: MachineProblem) -> bool {
    if context.problem == .None { context.problem = problem }
    return false
}

Spend :: (context: *Context, count: s64) -> bool {
    if count < 0 || count > context.budget - context.plan.work { return Fail(context, .Limit) }
    context.plan.work += count
    return true
}

Aggregate :: (context: *Context, value: s32) -> bool {
    return value >= 0 && context.stack_size[context.function.values[value]] >= 0
}

TypeOf :: (context: *Context, value: s32) -> s32 { return context.function.values[value] }

Mask :: (bit: s32) -> u64 { return cast(u64)1 << cast(u64)(bit & 63) }

Word :: (bit: s32) -> s64 { return cast(s64)(bit >> 6) }

// ---------------------------------------------------------------------------
// Liveness of aggregate values, in the working row `live`

Use :: (plan: *MachineAggregatePlan, value: s32) {
    if value < 0 { return }
    at := plan.index[value]
    if at >= 0 { plan.live[Word(at)] = plan.live[Word(at)] | Mask(at) }
}

Kill :: (plan: *MachineAggregatePlan, value: s32) {
    if value < 0 { return }
    at := plan.index[value]
    if at >= 0 { plan.live[Word(at)] = plan.live[Word(at)] & ~Mask(at) }
}

// Stores the working row as row ROW of ROWS; true when that changed it.
Save :: (live: []u64, rows: []u64, row: s64) -> bool {
    changed := false
    for word: cast(s64)0..live.count - 1 {
        if rows[row + word] != live[word] {
            rows[row + word] = live[word]
            changed = true
        }
    }
    return changed
}

// Live sets to a fixed point. An edge's arguments are used at the end of its
// block; a block's parameters are defined at its start.
Liveness :: (context: *Context) -> bool {
    plan := context.plan
    blocks := context.function.blocks
    width := context.width
    changed := true
    while changed {
        changed = false
        block := blocks.count - 1
        while block >= 0 {
            instructions := blocks[block].instructions
            if !Spend(context, width * 2 + instructions.count) { return false }
            for word: cast(s64)0..width - 1 { plan.live[word] = 0 }
            for instruction: instructions {
                for edge: instruction.edges {
                    if !Spend(context, width) { return false }
                    row := cast(s64)edge.block * width
                    for word: cast(s64)0..width - 1 { plan.live[word] = plan.live[word] | plan.live_in[row + word] }
                    for parameter: blocks[edge.block].parameters { Kill(plan, parameter) }
                }
            }
            if Save(plan.live[:], plan.live_out[:], block * width) { changed = true }
            at := instructions.count - 1
            while at >= 0 {
                instruction := instructions[at]
                Kill(plan, instruction.result)
                for operand: instruction.operands { Use(plan, operand) }
                for edge: instruction.edges { for argument: edge.arguments { Use(plan, argument) } }
                at -= 1
            }
            for parameter: blocks[block].parameters { Kill(plan, parameter) }
            if Save(plan.live[:], plan.live_in[:], block * width) { changed = true }
            block -= 1
        }
    }
    return true
}

// ---------------------------------------------------------------------------
// Interference and coalescing. A class's row holds the values live where one
// of its members is defined, so two classes conflict when either row meets
// the other's members.

Conflict :: (context: *Context, defined: s32) {
    plan := context.plan
    row := cast(s64)defined * context.width
    for word: cast(s64)0..context.width - 1 { plan.interfere[row + word] = plan.interfere[row + word] | plan.live[word] }
}

Pair :: (context: *Context, defined: s32, value: s32) {
    if !Aggregate(context, value) { return }
    plan := context.plan
    other := plan.index[value]
    if other == defined { return }
    at := cast(s64)defined * context.width + Word(other)
    plan.interfere[at] = plan.interfere[at] | Mask(other)
}

// Defines VALUES at one point: each conflicts with what is live there and
// with the others.
DefineTogether :: (context: *Context, values: []s32) -> bool {
    plan := context.plan
    if !Spend(context, values.count * (context.width + values.count)) { return false }
    for value: values { Kill(plan, value) }
    for value: values {
        if !Aggregate(context, value) { continue }
        Conflict(context, plan.index[value])
        for other: values { Pair(context, plan.index[value], other) }
    }
    return true
}

Interference :: (context: *Context) -> bool {
    plan := context.plan
    function := context.function
    width := context.width
    for block_index: cast(s64)0..function.blocks.count - 1 {
        block := function.blocks[block_index]
        if !Spend(context, width * (block.instructions.count + 1)) { return false }
        row := block_index * width
        for word: cast(s64)0..width - 1 { plan.live[word] = plan.live_out[row + word] }
        at := block.instructions.count - 1
        while at >= 0 {
            instruction := block.instructions[at]
            for edge: instruction.edges { for argument: edge.arguments { Use(plan, argument) } }
            if Aggregate(context, instruction.result) {
                Kill(plan, instruction.result)
                defined := plan.index[instruction.result]
                Conflict(context, defined)
                for operand, local: instruction.operands {
                    // An insert updating its source in place is the one
                    // instruction that may write the object it reads.
                    if instruction.op != .Insert || local != 0 { Pair(context, defined, operand) }
                }
            }
            for operand: instruction.operands { Use(plan, operand) }
            at -= 1
        }
        // The entry block's parameters are the function's.
        if !DefineTogether(context, block.parameters) { return false }
    }
    return true
}

Find :: (plan: *MachineAggregatePlan, at: s32) -> s32 {
    while plan.parent[at] != at {
        plan.parent[at] = plan.parent[plan.parent[at]]
        at = plan.parent[at]
    }
    return at
}

Join :: (context: *Context, left: s32, right: s32) -> bool {
    plan := context.plan
    if !Aggregate(context, left) || !Aggregate(context, right) || TypeOf(context, left) != TypeOf(context, right) {
        return true
    }
    a := Find(plan, plan.index[left])
    b := Find(plan, plan.index[right])
    if a == b { return true }
    if !Spend(context, context.width) { return false }
    row_a := cast(s64)a * context.width
    row_b := cast(s64)b * context.width
    for word: cast(s64)0..context.width - 1 {
        if (plan.interfere[row_a + word] & plan.members[row_b + word]) != 0 ||
            (plan.interfere[row_b + word] & plan.members[row_a + word]) != 0 { return true }
    }
    plan.parent[b] = a
    for word: cast(s64)0..context.width - 1 {
        plan.interfere[row_a + word] = plan.interfere[row_a + word] | plan.interfere[row_b + word]
        plan.members[row_a + word] = plan.members[row_a + word] | plan.members[row_b + word]
    }
    return true
}

// In program order: updates in place first, then edges.
Coalesce :: (context: *Context) -> bool {
    function := context.function
    for block: function.blocks {
        for instruction: block.instructions {
            if instruction.op == .Insert && instruction.operands.count > 0 &&
                !Join(context, instruction.result, instruction.operands[0]) { return false }
        }
    }
    for block: function.blocks {
        for instruction: block.instructions {
            for edge: instruction.edges {
                parameters := function.blocks[edge.block].parameters
                for argument, at: edge.arguments {
                    if !Join(context, parameters[at], argument) { return false }
                }
            }
        }
    }
    return true
}

// Each class is named by its function parameter (an entry block parameter),
// whose object is the incoming argument, or else by its smallest value.
AssignSlots :: (context: *Context) {
    plan := context.plan
    function := context.function
    for at: cast(s64)0..context.count - 1 { plan.representative[at] = MachineNoId }
    for parameter: function.blocks[function.entry].parameters {
        if Aggregate(context, parameter) {
            plan.representative[Find(plan, plan.index[parameter])] = parameter
        }
    }
    for value: cast(s32)0..cast(s32)function.values.count - 1 {
        if !Aggregate(context, value) { continue }
        class := Find(plan, plan.index[value])
        if plan.representative[class] == MachineNoId { plan.representative[class] = value }
        plan.slot[value] = plan.representative[class]
    }
}

Storage :: (context: *Context) -> bool {
    plan := context.plan
    function := context.function
    blocks := cast(s64)function.blocks.count
    context.count = 0
    for value: cast(s32)0..cast(s32)function.values.count - 1 {
        plan.index[value] = MachineNoId
        if Aggregate(context, value) {
            plan.index[value] = cast(s32)context.count
            context.count += 1
        }
    }
    context.width = (context.count + 63) / 64
    if context.count < 2 || context.count > MaximumAggregates || blocks * context.width > MaximumLiveWords {
        return true
    }
    width := context.width
    bound := context.bytes
    if !VecResizeBounded(plan.live, width, bound) || !VecResizeBounded(plan.live_in, blocks * width, bound) ||
        !VecResizeBounded(plan.live_out, blocks * width, bound) ||
        !VecResizeBounded(plan.interfere, context.count * width, bound) ||
        !VecResizeBounded(plan.members, context.count * width, bound) ||
        !VecResizeBounded(plan.parent, context.count, bound) ||
        !VecResizeBounded(plan.representative, context.count, bound) { return Fail(context, .Allocation) }
    if !Spend(context, (blocks + context.count) * width * 2) { return false }
    for at: cast(s64)0..plan.live_in.count - 1 { plan.live_in[at] = 0; plan.live_out[at] = 0 }
    for at: cast(s64)0..plan.interfere.count - 1 { plan.interfere[at] = 0; plan.members[at] = 0 }
    for at: cast(s32)0..cast(s32)context.count - 1 {
        plan.parent[at] = at
        plan.members[cast(s64)at * width + Word(at)] = Mask(at)
    }
    if !Liveness(context) || !Interference(context) || !Coalesce(context) { return false }
    AssignSlots(context)
    return true
}

// ---------------------------------------------------------------------------
// Views

// Where each value is used: uses counts operands and edge arguments; home is
// the block of all its uses (-1 unused, -2 several blocks or an edge); read
// the last extract from it; update the one insert that changes it (-2 for
// more); other its last other operand use.
Uses :: (context: *Context) -> bool {
    plan := context.plan
    for block, block_index: context.function.blocks {
        if !Spend(context, block.instructions.count) { return false }
        home := cast(s32)block_index
        for instruction, item: block.instructions {
            for value, at: instruction.operands {
                plan.uses[value] += 1
                if plan.home[value] != -1 && plan.home[value] != home { plan.home[value] = -2 }
                else { plan.home[value] = home }
                if instruction.op == .Extract && at == 0 { plan.read[value] = cast(s32)item }
                else if instruction.op == .Insert && at == 0 {
                    plan.update[value] = ifx plan.update[value] == -1 then cast(s32)item else -2
                } else { plan.other[value] = cast(s32)item }
            }
            for edge: instruction.edges {
                for argument: edge.arguments {
                    plan.uses[argument] += 1
                    plan.home[argument] = -2
                }
            }
        }
    }
    return true
}

// Whether two inserts or extracts name the same member.
SameMember :: (left: LirInstruction, left_fixed: s64, right: LirInstruction, right_fixed: s64) -> bool {
    dynamic := left.operands.count == left_fixed + 1
    if dynamic != (right.operands.count == right_fixed + 1) { return false }
    if dynamic { return left.operands[left_fixed] == right.operands[right_fixed] }
    return left.immediate == right.immediate
}

// Whether an instruction strictly between FROM and UNTIL reads SOURCE or a
// view of ROOT.
ReadsBetween :: (context: *Context, instructions: []LirInstruction, from: s32, until: s32,
    source: s32, root: s32) -> bool {
    plan := context.plan
    for between: from + 1..until - 1 {
        for value: instructions[between].operands {
            if value == source || MachineAggregateViewed(plan.view[value]) && plan.root[value] == root { return true }
        }
    }
    return false
}

// Whether an instruction strictly between FROM and UNTIL writes ROOT: defines
// a value stored there, or changes a view of it.
WritesBetween :: (context: *Context, instructions: []LirInstruction, from: s32, until: s32, root: s32) -> bool {
    plan := context.plan
    for between: from + 1..until - 1 {
        value := instructions[between].result
        if !Aggregate(context, value) { continue }
        if !MachineAggregateViewed(plan.view[value]) && plan.slot[value] == root ||
            plan.view[value] == .Changed && plan.root[value] == root { return true }
    }
    return false
}

// Plans the extract at ITEM; false only when the work budget runs out.
PlanView :: (context: *Context, instructions: []LirInstruction, block: s32, item: s32) -> bool {
    plan := context.plan
    instruction := instructions[item]
    result := instruction.result
    // An unused extract is a view too: a dynamic one keeps only its check.
    // An empty value has nothing to view.
    if instruction.op != .Extract || context.stack_size[TypeOf(context, result)] <= 0 || plan.other[result] >= 0 ||
        plan.update[result] == -2 || plan.home[result] != block && plan.home[result] != -1 { return true }
    source := instruction.operands[0]
    if instruction.operands.count == 2 && context.program.types[TypeOf(context, source)].kind != .Array { return true }
    viewed := MachineAggregateViewed(plan.view[source])
    root := ifx viewed then plan.root[source] else plan.slot[source]
    // A changed view: its insert follows its last read, the changed value
    // goes straight back into an insert of the source at the same member
    // stored in place, and nothing reads the source in between.
    changed := plan.update[result]
    changed_value: s32 = MachineNoId
    put: s32 = MachineNoId
    until := plan.read[result]
    if changed >= 0 {
        changed_value = instructions[changed].result
        if changed <= plan.read[result] || viewed || plan.home[changed_value] != block ||
            plan.uses[changed_value] != 1 || plan.other[changed_value] < 0 { return true }
        until = plan.other[changed_value]
        putting := instructions[until]
        put = putting.result
        if putting.op != .Insert || putting.operands.count < 2 || putting.operands[0] != source ||
            putting.operands[1] != changed_value || !SameMember(putting, 2, instruction, 1) ||
            put < 0 || plan.slot[put] != root { return true }
    }
    if until > item && !Spend(context, cast(s64)(until - item) * 2) { return false }
    if changed >= 0 && ReadsBetween(context, instructions, changed, until, source, root) ||
        until > item && WritesBetween(context, instructions, item, until, root) { return true }
    plan.view[result] = .Read
    plan.root[result] = root
    if changed >= 0 {
        plan.view[changed_value] = .Changed
        plan.root[changed_value] = root
        plan.view[put] = .PutBack
    }
    return true
}

Views :: (context: *Context) -> bool {
    if !Uses(context) { return false }
    for block, block_index: context.function.blocks {
        if !Spend(context, block.instructions.count) { return false }
        for item: cast(s32)0..cast(s32)block.instructions.count - 1 {
            if !PlanView(context, block.instructions, cast(s32)block_index, item) { return false }
        }
    }
    return true
}

// ---------------------------------------------------------------------------
// Shared view addresses: reverse postorder and immediate dominators

Order :: (context: *Context) -> bool {
    plan := context.plan
    function := context.function
    blocks := cast(s64)function.blocks.count
    bound := context.bytes
    edges: s64
    for block: function.blocks { for instruction: block.instructions { edges += instruction.edges.count } }
    if !Spend(context, blocks * 4 + edges * 2) { return false }
    if !VecResizeBounded(plan.successor_begin, blocks + 1, bound) || !VecResizeBounded(plan.successors, edges, bound) ||
        !VecResizeBounded(plan.predecessor_begin, blocks + 1, bound) ||
        !VecResizeBounded(plan.predecessors, edges, bound) || !VecResizeBounded(plan.cursor, blocks, bound) ||
        !VecResize(plan.pending, 0) || !VecResize(plan.order, 0) ||
        !VecResizeBounded(plan.position, blocks, bound) || !VecResizeBounded(plan.dominator, blocks, bound) {
        return Fail(context, .Allocation)
    }
    for at: cast(s64)0..blocks { plan.predecessor_begin[at] = 0 }
    at: s32 = 0
    for block, block_index: function.blocks {
        plan.successor_begin[block_index] = at
        for instruction: block.instructions {
            for edge: instruction.edges {
                plan.successors[at] = edge.block
                plan.predecessor_begin[edge.block + 1] += 1
                at += 1
            }
        }
    }
    plan.successor_begin[blocks] = at
    for block: cast(s64)0..blocks - 1 {
        plan.predecessor_begin[block + 1] += plan.predecessor_begin[block]
        plan.cursor[block] = plan.predecessor_begin[block]
        plan.position[block] = MachineNoId
        plan.dominator[block] = MachineNoId
    }
    for block: cast(s32)0..cast(s32)blocks - 1 {
        for edge: plan.successor_begin[block]..plan.successor_begin[block + 1] - 1 {
            successor := plan.successors[edge]
            plan.predecessors[plan.cursor[successor]] = block
            plan.cursor[successor] += 1
        }
    }
    // Iterative depth-first postorder from the entry, then reversed.
    for block: cast(s64)0..blocks - 1 { plan.cursor[block] = plan.successor_begin[block] }
    entry := function.entry
    plan.position[entry] = 0
    if !VecPush(plan.pending, entry) { return Fail(context, .Allocation) }
    while plan.pending.count > 0 {
        block := plan.pending[plan.pending.count - 1]
        if plan.cursor[block] < plan.successor_begin[block + 1] {
            successor := plan.successors[plan.cursor[block]]
            plan.cursor[block] += 1
            if plan.position[successor] == MachineNoId {
                plan.position[successor] = 0
                if !VecPush(plan.pending, successor) { return Fail(context, .Allocation) }
            }
        } else {
            if !VecResize(plan.pending, plan.pending.count - 1) || !VecPush(plan.order, block) {
                return Fail(context, .Allocation)
            }
        }
    }
    reached := plan.order.count
    for low: cast(s64)0..reached / 2 - 1 {
        high := reached - 1 - low
        swap := plan.order[low]
        plan.order[low] = plan.order[high]
        plan.order[high] = swap
    }
    for index: cast(s64)0..reached - 1 { plan.position[plan.order[index]] = cast(s32)index }
    return true
}

Intersect :: (plan: *MachineAggregatePlan, left: s32, right: s32) -> s32 {
    while left != right {
        while plan.position[left] > plan.position[right] { left = plan.dominator[left] }
        while plan.position[right] > plan.position[left] { right = plan.dominator[right] }
    }
    return left
}

Dominators :: (context: *Context) -> bool {
    plan := context.plan
    entry := context.function.entry
    plan.dominator[entry] = entry
    changed := true
    while changed {
        changed = false
        if !Spend(context, plan.order.count + plan.predecessors.count) { return false }
        for index: cast(s64)1..plan.order.count - 1 {
            block := plan.order[index]
            found: s32 = MachineNoId
            for edge: plan.predecessor_begin[block]..plan.predecessor_begin[block + 1] - 1 {
                predecessor := plan.predecessors[edge]
                if plan.dominator[predecessor] == MachineNoId { continue }
                found = ifx found == MachineNoId then predecessor else Intersect(plan, found, predecessor)
            }
            if plan.dominator[block] != found {
                plan.dominator[block] = found
                changed = true
            }
        }
    }
    return true
}

Dominates :: (plan: *MachineAggregatePlan, upper: s32, lower: s32) -> bool {
    if plan.position[upper] < 0 || plan.position[lower] < 0 { return false }
    while plan.position[lower] > plan.position[upper] { lower = plan.dominator[lower] }
    return lower == upper
}

// The view an extract VALUE in BLOCK shares its address with: an earlier view
// of the same root, parent address and member whose block dominates BLOCK.
ShareAddress :: (context: *Context, instruction: LirInstruction, block: s32) -> bool {
    plan := context.plan
    value := instruction.result
    source := instruction.operands[0]
    root := plan.root[value]
    parent := ifx MachineAggregateViewed(plan.view[source]) then plan.address[source] else MachineNoId
    dynamic := instruction.operands.count == 2
    member := ifx dynamic then cast(u64)instruction.operands[1] else instruction.immediate
    candidate := plan.chain_head[root]
    while candidate != MachineNoId {
        if !Spend(context, 1) { return false }
        if plan.key_parent[candidate] == parent && plan.key_dynamic[candidate] == dynamic &&
            plan.key_member[candidate] == member && Dominates(plan, plan.block_of[candidate], block) {
            plan.address[value] = candidate
            return true
        }
        candidate = plan.chain_next[candidate]
    }
    plan.block_of[value] = block
    plan.key_parent[value] = parent
    plan.key_dynamic[value] = dynamic
    plan.key_member[value] = member
    plan.chain_next[value] = plan.chain_head[root]
    plan.chain_head[root] = value
    return true
}

Addresses :: (context: *Context) -> bool {
    plan := context.plan
    function := context.function
    count := function.values.count
    bound := context.bytes
    if !VecResizeBounded(plan.block_of, count, bound) || !VecResizeBounded(plan.key_parent, count, bound) ||
        !VecResizeBounded(plan.key_member, count, bound) || !VecResizeBounded(plan.key_dynamic, count, bound) ||
        !VecResizeBounded(plan.chain_head, count, bound) || !VecResizeBounded(plan.chain_next, count, bound) {
        return Fail(context, .Allocation)
    }
    for value: cast(s64)0..count - 1 { plan.chain_head[value] = MachineNoId; plan.chain_next[value] = MachineNoId }
    if !Order(context) || !Dominators(context) { return false }
    for block: plan.order {
        instructions := function.blocks[block].instructions
        if !Spend(context, instructions.count) { return false }
        for instruction: instructions {
            result := instruction.result
            if result < 0 { continue }
            if plan.view[result] == .Read {
                if !ShareAddress(context, instruction, block) { return false }
            } else if plan.view[result] == .Changed {
                plan.address[result] = plan.address[instruction.operands[0]]
            }
        }
    }
    return true
}

// ---------------------------------------------------------------------------
// Split records

MaximumSplitFields :: 8

// Whether TYPE is a record of at most MaximumSplitFields scalar fields.
Splittable :: (context: *Context, type: s32) -> bool {
    record := context.program.types[type]
    if record.kind != .Record || record.fields.count == 0 || record.fields.count > MaximumSplitFields { return false }
    for field: record.fields {
        if context.stack_size[field] >= 0 || context.program.types[field].kind == .Void { return false }
    }
    return true
}

// Clears VALUE from the split set, reporting whether it was in it.
Unsplit :: (plan: *MachineAggregatePlan, value: s32) -> bool {
    if value < 0 || !plan.split[value] { return false }
    plan.split[value] = false
    return true
}

// Values a split record can be: built, changed by constant member or a
// parameter of a reachable block other than the entry, used only by constant
// extracts and inserts and as edge arguments, with every insert and edge
// joining two split values.
Split :: (context: *Context) -> bool {
    plan := context.plan
    function := context.function
    any := false
    for block, block_index: function.blocks {
        if !Spend(context, block.instructions.count + block.parameters.count) { return false }
        reached := plan.position[block_index] >= 0
        if reached && block_index != cast(s64)function.entry {
            for parameter: block.parameters {
                if Splittable(context, TypeOf(context, parameter)) { plan.split[parameter] = true; any = true }
            }
        }
        for instruction: block.instructions {
            result := instruction.result
            if !reached || result < 0 || !Splittable(context, TypeOf(context, result)) { continue }
            if instruction.op == .Aggregate || instruction.op == .Insert && instruction.operands.count == 2 {
                plan.split[result] = true
                any = true
            }
        }
    }
    if !any { return true }
    for block, block_index: function.blocks {
        reached := plan.position[block_index] >= 0
        for instruction: block.instructions {
            for value, at: instruction.operands {
                constant := instruction.operands.count == ifx instruction.op == .Extract then cast(s64)1 else 2
                if reached && at == 0 && constant && (instruction.op == .Extract || instruction.op == .Insert) { continue }
                unused Unsplit(plan, value)
            }
            if !reached { for edge: instruction.edges { for value: edge.arguments { unused Unsplit(plan, value) } } }
        }
    }
    changed := true
    while changed {
        changed = false
        for block: function.blocks {
            if !Spend(context, block.instructions.count) { return false }
            for instruction: block.instructions {
                if instruction.op == .Insert && instruction.operands.count == 2 && instruction.result >= 0 {
                    source := instruction.operands[0]
                    if plan.split[source] != plan.split[instruction.result] &&
                        (Unsplit(plan, source) || Unsplit(plan, instruction.result)) { changed = true }
                }
                for edge: instruction.edges {
                    parameters := function.blocks[edge.block].parameters
                    for argument, at: edge.arguments {
                        if plan.split[argument] != plan.split[parameters[at]] &&
                            (Unsplit(plan, argument) || Unsplit(plan, parameters[at])) { changed = true }
                    }
                }
            }
        }
    }
    return true
}

// ---------------------------------------------------------------------------
// Placement

// Work the scans of one function may spend per value beyond the linear passes
// before it stops placing; placement only saves copies, so declining is sound.
PlaceWork :: 64


// The offset of member MEMBER in a value of LIR type TYPE, or -1. Records are
// packed in declaration order, as the encoders lay them out.
MemberAt :: (context: *Context, type: s32, member: s64) -> s64 {
    shape := context.program.types[type]
    if shape.kind == .Array {
        if member < 0 || member >= shape.count || shape.element < 0 { return -1 }
        size := context.sizes[shape.element]
        return ifx size >= 0 then member * size else -1
    }
    if shape.kind != .Record || member < 0 || member >= cast(s64)shape.fields.count { return -1 }
    at: s64 = 0
    for field, index: shape.fields {
        if cast(s64)index == member { return at }
        size := context.sizes[field]
        if size < 0 { return -1 }
        at += size
    }
    return -1
}

// What MemberAt costs for a value of LIR type TYPE.
MemberCost :: (context: *Context, type: s32) -> s64 {
    return 1 + cast(s64)context.program.types[type].fields.count
}

// Spends COUNT of the work budget without failing: placement only saves
// copies, so a scan that would run past the budget is declined instead.
PlaceSpend :: (context: *Context, count: s64) -> bool {
    if count < 0 || count > context.budget - context.plan.work { return false }
    context.plan.work += count
    return true
}

// Whether VALUE is read or written in the storage of class ROOT.
Touches :: (context: *Context, value: s32, root: s32) -> bool {
    if !Aggregate(context, value) { return false }
    plan := context.plan
    if MachineAggregateViewed(plan.view[value]) { return plan.root[value] == root }
    return plan.slot[value] == root
}

Merge :: (plan: *MachineAggregatePlan, class: s32, block: s32) {
    if plan.class_block[class] == -1 { plan.class_block[class] = block }
    else if plan.class_block[class] != block { plan.class_block[class] = -2 }
}

// Where each class is defined and used: see the plan's class_ vectors.
Classes :: (context: *Context) -> bool {
    plan := context.plan
    function := context.function
    for parameter: function.blocks[function.entry].parameters {
        if Aggregate(context, parameter) { plan.class_fixed[plan.slot[parameter]] = true }
    }
    for block, block_index: function.blocks {
        home := cast(s32)block_index
        if !Spend(context, block.instructions.count + block.parameters.count + 1) { return false }
        for parameter: block.parameters {
            if Aggregate(context, parameter) { plan.class_block[plan.slot[parameter]] = -2 }
        }
        for instruction, item: block.instructions {
            if !Spend(context, instruction.operands.count + instruction.edges.count + 1) { return false }
            result := instruction.result
            if Aggregate(context, result) {
                class := plan.slot[result]
                Merge(plan, class, home)
                if cast(s32)item < plan.class_first[class] { plan.class_first[class] = cast(s32)item }
                if cast(s32)item > plan.class_last[class] { plan.class_last[class] = cast(s32)item }
                if plan.split[result] || MachineAggregateViewed(plan.view[result]) { plan.class_block[class] = -2 }
            }
            for value, at: instruction.operands {
                if !Aggregate(context, value) { continue }
                class := plan.slot[value]
                Merge(plan, class, home)
                if cast(s32)item > plan.class_last[class] { plan.class_last[class] = cast(s32)item }
                // An insert updating its source in place stays in the class.
                if instruction.op == .Insert && at == 0 && Aggregate(context, result) && plan.slot[result] == class {
                    continue
                }
                plan.class_outside[class] += 1
                plan.class_item[class] = cast(s32)item
            }
            for edge: instruction.edges {
                if !Spend(context, edge.arguments.count) { return false }
                for argument: edge.arguments {
                    if Aggregate(context, argument) { plan.class_block[plan.slot[argument]] = -2 }
                }
            }
        }
    }
    return true
}

// Places the class of VALUE, used only by the instruction at ITEM of BLOCK as
// the member at OFFSET of the value in class PARENT, inside PARENT's storage
// when nothing between its first definition and ITEM touches that storage.
// The scan covers results and operands of the instructions before ITEM, all
// that can name the parent's values: the parent is a stack-class value whose
// address nothing takes, and edge arguments (the only source of the machine
// edge copies) belong to the block's terminator, after every ITEM. Reports
// whether it did; a scan past the work budget declines.
TryPlace :: (context: *Context, block: s32, item: s32, value: s32, offset: s64, parent: s32) -> bool {
    plan := context.plan
    class := plan.slot[value]
    size := context.sizes[TypeOf(context, value)]
    first := plan.class_first[class]
    if class == parent || offset < 0 || size <= 0 || plan.class_fixed[parent] ||
        plan.class_block[class] != block || plan.class_outside[class] != 1 || plan.class_item[class] != item ||
        plan.class_last[class] != item || plan.class_into[class] != MachineNoId || first >= item { return false }
    instructions := context.function.blocks[block].instructions
    context.place_left -= cast(s64)(item - first)
    if context.place_left < 0 || !PlaceSpend(context, cast(s64)(item - first)) { return false }
    for between: first..item - 1 {
        other := instructions[between]
        if Touches(context, other.result, parent) { return false }
        for operand: other.operands { if Touches(context, operand, parent) { return false } }
    }
    plan.class_into[class] = parent
    plan.class_at[class] = offset
    if first < plan.class_first[parent] { plan.class_first[parent] = first }
    return true
}

// Where each view lies in its root's storage, in program order: a read view
// of a constant member lies at that member's offset from where its source
// does, a changed view where its source does.
ViewOffsets :: (context: *Context) -> bool {
    plan := context.plan
    for block: context.function.blocks {
        if !Spend(context, block.instructions.count + 1) { return false }
        for instruction: block.instructions {
            result := instruction.result
            if result < 0 { continue }
            if plan.view[result] == .Read && instruction.op == .Extract && instruction.operands.count == 1 {
                source := instruction.operands[0]
                if !Spend(context, MemberCost(context, TypeOf(context, source))) { return false }
                base: s64 = 0
                if MachineAggregateViewed(plan.view[source]) { base = plan.view_at[source] }
                member := MemberAt(context, TypeOf(context, source), cast(s64)instruction.immediate)
                if base >= 0 && member >= 0 { plan.view_at[result] = base + member }
            } else if plan.view[result] == .Changed && instruction.op == .Insert && instruction.operands.count >= 1 {
                plan.view_at[result] = plan.view_at[instruction.operands[0]]
            }
        }
    }
    return true
}

// A member value's chain nests: each class names the class it lies in, so a
// class's own storage is found by following them to one with a home.
Flatten :: (context: *Context) -> bool {
    plan := context.plan
    count := cast(s32)context.function.values.count
    for value: cast(s32)0..count - 1 {
        if plan.slot[value] != value || plan.class_into[value] == MachineNoId { continue }
        root := value
        at: s64 = 0
        steps: s32 = 0
        while plan.class_into[root] >= 0 && steps <= count {
            at += plan.class_at[root]
            root = plan.class_into[root]
            steps += 1
        }
        if !Spend(context, cast(s64)steps + 1) { return false }
        if plan.class_into[root] >= 0 { continue }
        if plan.class_into[root] == MachineAggregateInResult {
            plan.place_root[value] = MachineAggregateInResult
            plan.place_at[value] = at + plan.class_at[root]
        } else {
            plan.place_root[value] = root
            plan.place_at[value] = at
        }
    }
    return true
}

// Places member values inside the values that take them, in program order so
// a member's own members are placed before it is.
Place :: (context: *Context) -> bool {
    plan := context.plan
    function := context.function
    if !Classes(context) || !ViewOffsets(context) { return false }
    for block, block_index: function.blocks {
        home := cast(s32)block_index
        if !Spend(context, block.instructions.count + 1) { return false }
        for instruction, item: block.instructions {
            result := instruction.result
            if !Aggregate(context, result) || plan.split[result] { continue }
            // A member value inserted through a changed view's address goes
            // where the view is, in its root's storage.
            if plan.view[result] == .Changed {
                if instruction.op != .Insert || instruction.operands.count != 2 ||
                    !Aggregate(context, instruction.operands[1]) { continue }
                if !Spend(context, MemberCost(context, TypeOf(context, instruction.operands[0]))) { return false }
                at := plan.view_at[instruction.operands[0]]
                member := MemberAt(context, TypeOf(context, instruction.operands[0]), cast(s64)instruction.immediate)
                if at >= 0 && member >= 0 &&
                    TryPlace(context, home, cast(s32)item, instruction.operands[1], at + member, plan.root[result]) {
                    plan.built_in_place[result] = true
                }
                continue
            }
            if plan.view[result] != .None { continue }
            parent := plan.slot[result]
            if instruction.op == .Aggregate {
                if !Spend(context, instruction.operands.count + 1) { return false }
                shape := context.program.types[TypeOf(context, result)]
                at: s64 = 0
                for value, member: instruction.operands {
                    offset := at
                    if shape.kind == .Array {
                        size := ifx shape.element >= 0 then context.sizes[shape.element] else -1
                        offset = ifx size >= 0 then cast(s64)member * size else -1
                    } else if cast(s64)member < cast(s64)shape.fields.count {
                        size := context.sizes[shape.fields[member]]
                        at = ifx size >= 0 && at >= 0 then at + size else -1
                    } else { offset = -1 }
                    if !Aggregate(context, value) { continue }
                    unused TryPlace(context, home, cast(s32)item, value, offset, parent)
                }
            } else if instruction.op == .Insert && instruction.operands.count == 2 &&
                Aggregate(context, instruction.operands[1]) && !plan.split[instruction.operands[0]] &&
                plan.view[instruction.operands[0]] == .None && plan.slot[instruction.operands[0]] == parent {
                if !Spend(context, MemberCost(context, TypeOf(context, result))) { return false }
                unused TryPlace(context, home, cast(s32)item, instruction.operands[1],
                    MemberAt(context, TypeOf(context, result), cast(s64)instruction.immediate), parent)
            }
        }
    }
    if context.results && !ChooseResult(context) { return false }
    return Flatten(context)
}

// Builds returned aggregates in the caller's result memory. A single
// returned class may span blocks. Several classes can share that memory
// when each is defined and used only in its own terminal return block and
// its sole use outside in-place updates is that return. Their lifetimes
// cannot overlap: execution leaves the function at each class's last use.
// Parameters, views and classes placed inside another keep their storage.
ChooseResult :: (context: *Context) -> bool {
    plan := context.plan
    function := context.function
    result_type := function.result
    if result_type < 0 || result_type >= context.program.types.count ||
        context.stack_size[result_type] < MachineAggregateResultBytes { return true }
    chosen: s32 = MachineNoId
    several := false
    terminal := true
    for block, home: function.blocks {
        if !Spend(context, block.instructions.count + 1) { return false }
        for instruction, item: block.instructions {
            if instruction.op != .Return { continue }
            if instruction.operands.count != 1 || !Aggregate(context, instruction.operands[0]) { return true }
            value := instruction.operands[0]
            if TypeOf(context, value) != result_type || plan.split[value] ||
                (plan.view[value] != .None && plan.view[value] != .PutBack) { return true }
            class := plan.slot[value]
            if plan.class_fixed[class] || plan.class_into[class] != MachineNoId { return true }
            if chosen != MachineNoId && chosen != class { several = true }
            chosen = class
            if plan.class_block[class] != cast(s32)home || plan.class_outside[class] != 1 ||
                plan.class_item[class] != cast(s32)item || plan.class_last[class] != cast(s32)item {
                terminal = false
            }
        }
    }
    // Several terminal values add a persistent destination register even
    // though only one return executes. Keep two-vector copies or larger so
    // eliminating that copy outweighs preserving the destination register.
    if chosen == MachineNoId || several && (!terminal || context.stack_size[result_type] < 32) { return true }
    // Publish only after every returned class has passed the proof. Placed
    // members follow their class into the same result memory in Collapse.
    for block: function.blocks {
        if !Spend(context, block.instructions.count + 1) { return false }
        for instruction: block.instructions {
            if instruction.op != .Return { continue }
            class := plan.slot[instruction.operands[0]]
            plan.class_into[class] = MachineAggregateInResult
            plan.class_at[class] = 0
        }
    }
    plan.result_placed = true
    return true
}

// Marks the aggregate builds whose members are all replaced, one constant
// member at a time by inserts that each take the only use of the value before
// them and update it in place, before any read: building them emits nothing.
Cover :: (context: *Context) -> bool {
    plan := context.plan
    for block: context.function.blocks {
        if !Spend(context, block.instructions.count + 1) { return false }
        for instruction: block.instructions {
            result := instruction.result
            if !Aggregate(context, result) || plan.split[result] || plan.view[result] != .None { continue }
            members: s64
            shape := context.program.types[TypeOf(context, result)]
            if shape.kind == .Array { members = shape.count }
            else if shape.kind == .Record { members = cast(s64)shape.fields.count }
            if members < 1 || members > 64 { continue }
            if instruction.op == .Aggregate {
                if plan.uses[result] == 1 { plan.cover_root[result] = result; plan.cover_mask[result] = 0 }
            } else if instruction.op == .Insert && instruction.operands.count == 2 {
                source := instruction.operands[0]
                if plan.cover_root[source] == MachineNoId || plan.uses[source] != 1 || plan.slot[result] != plan.slot[source] ||
                    instruction.immediate >= cast(u64)members { continue }
                mask := plan.cover_mask[source] | (cast(u64)1 << instruction.immediate)
                plan.cover_root[result] = plan.cover_root[source]
                plan.cover_mask[result] = mask
                full := ifx members == 64 then ~cast(u64)0 else (cast(u64)1 << cast(u64)members) - 1
                if mask == full { plan.covered[plan.cover_root[result]] = true }
            }
        }
    }
    return true
}

#scope_export

// Plans FUNCTION of PROGRAM into PLAN. STACK_SIZE gives the size of each
// stack-class type and -1 for the others, SIZES that of every type; VIEWS also
// plans views and placement, RESULTS also lets the returned aggregate be built
// in the caller's result memory. BUDGET bounds the work, recorded in plan.work,
// and BYTES the element capacity of each scratch vector.
MachineAggregatePlanBuild :: (plan: *MachineAggregatePlan, program: LirProgram, function: LirFunction,
    stack_size: []s64, sizes: []s64, views: bool, results: bool, budget: s64, bytes: s64) -> MachineProblem {
    plan.work = 0
    plan.result_placed = false
    context := Context.{plan = plan, function = function, program = program, stack_size = stack_size,
        sizes = sizes, results = results, budget = budget, bytes = bytes, problem = .None}
    count := function.values.count
    context.place_left = cast(s64)count * PlaceWork + 4096
    if !VecResizeBounded(plan.slot, count, bytes) || !VecResizeBounded(plan.view, count, bytes) ||
        !VecResizeBounded(plan.root, count, bytes) || !VecResizeBounded(plan.address, count, bytes) ||
        !VecResizeBounded(plan.storage, count, bytes) || !VecResizeBounded(plan.split, count, bytes) ||
        !VecResizeBounded(plan.index, count, bytes) ||
        !VecResizeBounded(plan.place_root, count, bytes) || !VecResizeBounded(plan.place_at, count, bytes) ||
        !VecResizeBounded(plan.class_block, count, bytes) || !VecResizeBounded(plan.class_first, count, bytes) ||
        !VecResizeBounded(plan.class_outside, count, bytes) || !VecResizeBounded(plan.class_item, count, bytes) ||
        !VecResizeBounded(plan.class_last, count, bytes) ||
        !VecResizeBounded(plan.class_fixed, count, bytes) || !VecResizeBounded(plan.class_into, count, bytes) ||
        !VecResizeBounded(plan.class_at, count, bytes) || !VecResizeBounded(plan.view_at, count, bytes) ||
        !VecResizeBounded(plan.built_in_place, count, bytes) || !VecResizeBounded(plan.covered, count, bytes) ||
        !VecResizeBounded(plan.cover_root, count, bytes) || !VecResizeBounded(plan.cover_mask, count, bytes) ||
        !VecResizeBounded(plan.home, count, bytes) || !VecResizeBounded(plan.read, count, bytes) ||
        !VecResizeBounded(plan.update, count, bytes) || !VecResizeBounded(plan.other, count, bytes) ||
        !VecResizeBounded(plan.uses, count, bytes) { return .Allocation }
    if !Spend(*context, count) { return context.problem }
    for value: cast(s32)0..cast(s32)count - 1 {
        plan.slot[value] = value
        plan.view[value] = .None
        plan.root[value] = MachineNoId
        plan.address[value] = value
        plan.storage[value] = false
        plan.split[value] = false
        plan.place_root[value] = MachineNoId
        plan.place_at[value] = 0
        plan.class_block[value] = -1
        plan.class_first[value] = 2147483647
        plan.class_outside[value] = 0
        plan.class_item[value] = -1
        plan.class_last[value] = -1
        plan.class_fixed[value] = false
        plan.class_into[value] = MachineNoId
        plan.class_at[value] = 0
        plan.view_at[value] = -1
        plan.built_in_place[value] = false
        plan.covered[value] = false
        plan.cover_root[value] = MachineNoId
        plan.cover_mask[value] = 0
        plan.home[value] = -1
        plan.read[value] = -1
        plan.update[value] = -1
        plan.other[value] = -1
        plan.uses[value] = 0
    }
    if !Storage(*context) || views && (!Views(*context) || !Addresses(*context) || !Split(*context)) {
        return context.problem
    }
    if views && (!Place(*context) || !Cover(*context)) { return context.problem }
    // Views and split records live elsewhere, so only the rest take frame storage.
    for value: cast(s32)0..cast(s32)count - 1 {
        if Aggregate(*context, value) && !plan.split[value] &&
            (plan.view[value] == .None || plan.view[value] == .PutBack) {
            plan.storage[plan.slot[value]] = true
        }
    }
    return .None
}

MachineAggregatePlanFree :: (plan: *MachineAggregatePlan) {
    VecFree(plan.slot)
    VecFree(plan.view)
    VecFree(plan.root)
    VecFree(plan.address)
    VecFree(plan.storage)
    VecFree(plan.split)
    VecFree(plan.place_root)
    VecFree(plan.place_at)
    VecFree(plan.class_block)
    VecFree(plan.class_first)
    VecFree(plan.class_outside)
    VecFree(plan.class_item)
    VecFree(plan.class_last)
    VecFree(plan.class_fixed)
    VecFree(plan.class_into)
    VecFree(plan.class_at)
    VecFree(plan.view_at)
    VecFree(plan.built_in_place)
    VecFree(plan.covered)
    VecFree(plan.cover_root)
    VecFree(plan.cover_mask)
    VecFree(plan.index)
    VecFree(plan.parent)
    VecFree(plan.representative)
    VecFree(plan.live)
    VecFree(plan.live_in)
    VecFree(plan.live_out)
    VecFree(plan.interfere)
    VecFree(plan.members)
    VecFree(plan.home)
    VecFree(plan.read)
    VecFree(plan.update)
    VecFree(plan.other)
    VecFree(plan.uses)
    VecFree(plan.successor_begin)
    VecFree(plan.successors)
    VecFree(plan.predecessor_begin)
    VecFree(plan.predecessors)
    VecFree(plan.cursor)
    VecFree(plan.pending)
    VecFree(plan.order)
    VecFree(plan.position)
    VecFree(plan.dominator)
    VecFree(plan.block_of)
    VecFree(plan.key_parent)
    VecFree(plan.key_member)
    VecFree(plan.key_dynamic)
    VecFree(plan.chain_head)
    VecFree(plan.chain_next)
}
