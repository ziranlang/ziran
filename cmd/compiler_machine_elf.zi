using Machine :: #import "compiler_machine_ir"
using Target :: #import "compiler_target"
using X64 :: #import "compiler_x86_64"
using X64Image :: #import "compiler_x86_image"

// Deterministic, sectionless Linux x86-64 ELF image for allocated machine IR,
// with the contents compiler_x86_image.zi lays out, carrying only what the
// program uses. The first PT_LOAD maps the file from offset 0: the ELF
// headers, then (16-byte aligned) the text and the read-only globals after
// it. It is read/execute only. A second PT_LOAD exists only when the program
// needs writable state. Its bytes follow the text in the file and map one
// page higher in memory, so the two segments never share a page and the
// file needs no padding. It is read/write but never executable. Positions are
// virtual offsets from MachineElfBase. No dynamic linker, runtime, assembler
// or foreign object participates.

MachineElfBase :: 0x400000
MachineElfPage :: 4096
MachineElfHeaderSize :: 64
MachineElfProgramHeaderSize :: 56

// File offsets, and the data segment's virtual offset from MachineElfBase
// (both 0 without a data segment); a piece the image does not carry has
// offset -1.
MachineElfResult :: struct {
    diagnostic: MachineDiagnostic
    size: s64
    text_offset: s64
    text_size: s64
    startup_size: s64
    data_offset: s64
    data_address: s64
    data_size: s64
    fuel_offset: s64
    trap_status_offset: s64
    pointer_offset: s64
}

#scope_file

Layout :: struct {
    image: MachineX64ImageLayout
    headers: s64
    data_offset: s64
    file_size: s64
}

Failure :: (problem: MachineProblem) -> MachineElfResult {
    return .{diagnostic = .{problem = problem, function = MachineNoId, block = MachineNoId,
        instruction = MachineNoId, operand = MachineNoId, virtual = MachineNoId}}
}

Align :: (value: s64, alignment: s64) -> s64 {
    return (value + alignment - 1) & ~(alignment - 1)
}

PutLittle :: (output: []u8, at: s64, value: u64, count: s32) {
    for index: 0..count - 1 {
        output[at + index] = cast(u8)((value >> cast(u64)(index * 8)) & 255)
    }
}

// The end of the text segment: the text, then the read-only globals.
TextEnd :: (layout: Layout) -> s64 { return layout.image.constants + layout.image.constants_size }

// The text right after the program headers, the read-only globals 16-byte
// aligned after it, then the data.
ElfLayout :: (program: MachineProgram, encoded: MachineX64Image, layout: *Layout) -> MachineDiagnostic {
    image := *layout.image
    image.os = .Linux
    diagnostic := MachineX64ImageMeasure(program, encoded, image)
    if diagnostic.problem != .None { return diagnostic }
    layout.headers = ifx MachineX64ImageHasData(<<image) then 2 else 1
    image.text = Align(MachineElfHeaderSize + layout.headers * MachineElfProgramHeaderSize, 16)
    diagnostic = MachineX64ImageText(program, encoded, image)
    if diagnostic.problem != .None { return diagnostic }
    image.constants = Align(image.text_end, 16)
    if TextEnd(<<layout) > 2147483647 - MachineElfPage {
        diagnostic.problem = .Limit
        return diagnostic
    }
    layout.data_offset = TextEnd(<<layout)
    image.data = layout.data_offset
    if layout.headers == 2 {
        layout.data_offset = Align(layout.data_offset, MachineX64DataAlignment(program))
        image.data = layout.data_offset + MachineElfPage
    }
    image.data_file = layout.data_offset
    layout.file_size = layout.data_offset + image.data_layout.size
    return MachineX64ImageResolve(program, encoded, <<image)
}

Write :: (program: MachineProgram, encoded: MachineX64Image, layout: Layout, output: []u8, fuel: s64) -> bool {
    for index: cast(s64)0..output.count - 1 { output[index] = 0 }
    image := layout.image
    data := cast(u64)(MachineElfBase + image.data)

    // ELF64 little-endian ET_EXEC, x86-64, its program headers, no sections.
    output[0] = 0x7f; output[1] = 69; output[2] = 76; output[3] = 70
    output[4] = 2; output[5] = 1; output[6] = 1
    PutLittle(output, 16, 2, 2); PutLittle(output, 18, 62, 2); PutLittle(output, 20, 1, 4)
    PutLittle(output, 24, cast(u64)(MachineElfBase + image.text), 8)
    PutLittle(output, 32, MachineElfHeaderSize, 8)
    PutLittle(output, 52, MachineElfHeaderSize, 2)
    PutLittle(output, 54, MachineElfProgramHeaderSize, 2)
    PutLittle(output, 56, cast(u64)layout.headers, 2)

    // RX PT_LOAD: the headers and text.
    ph := cast(s64)MachineElfHeaderSize
    PutLittle(output, ph, 1, 4); PutLittle(output, ph + 4, 5, 4)
    PutLittle(output, ph + 16, MachineElfBase, 8); PutLittle(output, ph + 24, MachineElfBase, 8)
    PutLittle(output, ph + 32, cast(u64)TextEnd(layout), 8)
    PutLittle(output, ph + 40, cast(u64)TextEnd(layout), 8)
    PutLittle(output, ph + 48, MachineElfPage, 8)

    // RW PT_LOAD, a page above its file offset and never executable.
    if layout.headers == 2 {
        ph += MachineElfProgramHeaderSize
        PutLittle(output, ph, 1, 4); PutLittle(output, ph + 4, 6, 4)
        PutLittle(output, ph + 8, cast(u64)layout.data_offset, 8)
        PutLittle(output, ph + 16, data, 8)
        PutLittle(output, ph + 24, data, 8)
        PutLittle(output, ph + 32, cast(u64)image.data_layout.size, 8)
        PutLittle(output, ph + 40, cast(u64)image.data_layout.memory, 8)
        PutLittle(output, ph + 48, MachineElfPage, 8)
    }
    return MachineX64ImageWrite(program, encoded, image, output, MachineElfBase, fuel)
}

// The file offset of a data piece at OFFSET, or -1 when absent.
DataAt :: (layout: Layout, offset: s64) -> s64 { return ifx offset < 0 then -1 else layout.data_offset + offset }

#scope_export

// Empty OUTPUT measures. A non-empty OUTPUT must have exactly the measured
// length. Verification, complete relocation resolution and i32 range checks
// all finish before the first output byte is changed.
MachineElfEncode :: (program: MachineProgram, encoded: MachineX64Image, output: []u8,
    fuel: s64 = MachineX64InitialFuel) -> MachineElfResult {
    if fuel < 0 { return Failure(.Fuel) }
    layout: Layout
    diagnostic := ElfLayout(program, encoded, *layout)
    if diagnostic.problem != .None { return .{diagnostic = diagnostic} }
    image := layout.image
    data := image.data_layout
    // No data segment reports zero offsets.
    result := MachineElfResult.{diagnostic = diagnostic, size = layout.file_size,
        text_offset = image.text, text_size = TextEnd(layout) - image.text, startup_size = image.startup_size,
        data_offset = ifx layout.headers == 2 then layout.data_offset else 0,
        data_address = ifx layout.headers == 2 then image.data else 0, data_size = data.size,
        fuel_offset = DataAt(layout, data.fuel), trap_status_offset = DataAt(layout, data.trap_status),
        pointer_offset = DataAt(layout, data.pointer_header)}
    if output.count == 0 { return result }
    if output.count != layout.file_size { return Failure(.Limit) }
    if !Write(program, encoded, layout, output, fuel) { return Failure(.Relocation) }
    return result
}
