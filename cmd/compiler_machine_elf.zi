using Archive :: #import "compiler_x86_archive"
using Bytes :: #import "compiler_x86_bytes"
using Host :: #import "compiler_x86_host"
using Machine :: #import "compiler_machine_ir"
using Target :: #import "compiler_target"
using X64 :: #import "compiler_x86_64"
using X64Image :: #import "compiler_x86_image"

// Deterministic, sectionless Linux x86-64 ELF image for allocated machine IR,
// with the contents compiler_x86_image.zi lays out, carrying only what the
// program uses. The first PT_LOAD maps the file from offset 0: the ELF
// headers, then (16-byte aligned) the text and the read-only globals after
// it. It is read/execute only. A second PT_LOAD exists only when the program
// needs writable state. Its bytes follow the text in the file and map one
// page higher in memory, so the two segments never share a page and the
// file needs no padding. It is read/write but never executable. Positions are
// virtual offsets from MachineElfBase. No runtime, assembler or foreign
// object participates.
//
// A program with no host capabilities is static: no dynamic linker runs. The
// ZX Runner's files and clock services (std/guest_files and std/guest_clock)
// are built in: the executable carries their veneers, makes the system calls
// itself and stays static. A program that imports other host capabilities
// links the host libraries that provide them,
// as a C program links a host's symbols by name: PT_INTERP names the system's
// dynamic linker, PT_DYNAMIC lists each library as a DT_NEEDED path, and each
// capability is an undefined function symbol whose R_X86_64_GLOB_DAT
// relocation fills the capability's slot in the data before the entry runs,
// so a library missing the symbol stops the program before it starts. These
// records follow the read-only globals in the first PT_LOAD, and
// PT_GNU_STACK keeps the stack non-executable.

MachineElfBase :: 0x400000
MachineElfPage :: 4096
MachineElfHeaderSize :: 64
MachineElfProgramHeaderSize :: 56
MachineElfInterpreter :: "/lib64/ld-linux-x86-64.so.2"

// The host libraries an executable links and the capabilities it imports
// from them, and the services it supplies itself; a static executable has
// no libraries or imports.
MachineElfHosts :: struct {
    // Absolute paths, one DT_NEEDED each, in order.
    libraries: []string
    // Parallel to libraries: the bytes of each one that is a static archive
    // (compiler_x86_archive.zi) and empty for a shared object. An archive
    // is linked into the executable and needs no dynamic record.
    archives: []string
    // In function order; each import's library indexes libraries.
    imports: []MachineX64HostImport
    // The built-in files and clock services, in function order; they link
    // nothing and have no dynamic symbol.
    builtins: []MachineX64HostImport
    // The capabilities the archives provide, in function order, and the
    // archives' loaded members, in archive order.
    statics: []MachineX64HostImport
    objects: []Archive.MachineX64Object
}

// File offsets, and the data segment's virtual offset from MachineElfBase
// (both 0 without a data segment); a piece the image does not carry has
// offset -1.
MachineElfResult :: struct {
    diagnostic: MachineDiagnostic
    size: s64
    text_offset: s64
    text_size: s64
    startup_size: s64
    data_offset: s64
    data_address: s64
    data_size: s64
    fuel_offset: s64
    trap_status_offset: s64
    pointer_offset: s64
    // The dynamic linking records, or -1 for a static executable.
    dynamic_offset: s64
    // The .eh_frame unwind section, or -1 when the image carries none.
    eh_frame_offset: s64
    eh_frame_size: s64
}

#scope_file

SymbolSize :: 24
RelocationSize :: 24
DynamicEntrySize :: 16
SectionHeaderSize :: 64
SectionCount :: 10
SectionText :: 1
SectionStrings :: 6
SectionDynamic :: 7
SectionEhFrame :: 8
SectionNames :: 9
// The section name table: a leading NUL, then each name and its NUL.
SectionNameBytes :: 71
SectionNameText :: 1
SectionNameConstants :: 7
SectionNameData :: 15
SectionNameBss :: 21
SectionNameSymbols :: 26
SectionNameStrings :: 34
SectionNameDynamic :: 42
SectionNameNames :: 51
SectionNameEhFrame :: 61
// d_tag values, R_X86_64_GLOB_DAT and the symbol's STB_GLOBAL STT_FUNC.
DtNull :: 0
DtNeeded :: 1
DtHash :: 4
DtStrtab :: 5
DtSymtab :: 6
DtRela :: 7
DtRelasz :: 8
DtRelaent :: 9
DtStrsz :: 10
DtSyment :: 11
GlobDat :: 6
GlobalFunction :: 0x12

Layout :: struct {
    image: MachineX64ImageLayout
    headers: s64
    // The dynamic linking records' file offsets, which are also their
    // virtual offsets; zero for a static executable.
    interpreter: s64
    strings: s64
    strings_size: s64
    symbols: s64
    hash: s64
    relocations: s64
    dynamic: s64
    dynamic_count: s64
    // The unwind section after the dynamic records: it is mapped by the
    // first PT_LOAD and is read-only.
    eh_frame: s64
    eh_frame_size: s64
    // The end of the first PT_LOAD's bytes.
    read_end: s64
    data_offset: s64
    // The section data after the segments: the symbol and string tables,
    // then the section header table. They describe the image; none is
    // mapped.
    symtab: s64
    symtab_size: s64
    strtab: s64
    strtab_size: s64
    shstrtab: s64
    sections: s64
    file_size: s64
}

Failure :: (problem: MachineProblem) -> MachineElfResult {
    return .{diagnostic = .{problem = problem, function = MachineNoId, block = MachineNoId,
        instruction = MachineNoId, operand = MachineNoId, virtual = MachineNoId}}
}

Align :: (value: s64, alignment: s64) -> s64 {
    return (value + alignment - 1) & ~(alignment - 1)
}

PutLittle :: (output: []u8, at: s64, value: u64, count: s32) {
    for index: 0..count - 1 {
        output[at + index] = cast(u8)((value >> cast(u64)(index * 8)) & 255)
    }
}

PutBytes :: (output: []u8, at: s64, bytes: []u8) {
    for index: cast(s64)0..bytes.count - 1 { output[at + index] = bytes[index] }
}

PutText :: (output: []u8, at: s64, text: string) {
    for index: cast(s64)0..text.count - 1 { output[at + index] = cast(u8)text[index] }
}

// The end of the text and the read-only globals after it.
TextEnd :: (layout: Layout) -> s64 { return layout.image.constants + layout.image.constants_size }

// Whether the INDEX-th library is a static archive.
ArchiveAt :: (hosts: MachineElfHosts, index: s64) -> bool {
    return index < hosts.archives.count && hosts.archives[index].count > 0
}

// The number of shared objects among the libraries.
SharedCount :: (hosts: MachineElfHosts) -> s64 {
    count: s64 = 0
    for index: cast(s64)0..hosts.libraries.count - 1 {
        if !ArchiveAt(hosts, index) { count += 1 }
    }
    return count
}

Dynamic :: (layout: Layout) -> bool { return layout.image.hosts.count > 0 }

// A host capability's symbol: its function's name.
SymbolName :: (program: MachineProgram, function: s32) -> []u8 {
    record := program.functions[function]
    return program.text[record.name_offset:record.name_offset + record.name_length]
}

// A name the string table can hold: not empty and without a NUL.
Named :: (text: []u8) -> bool {
    if text.count == 0 { return false }
    for byte: text { if byte == 0 { return false } }
    return true
}

// An absolute path the string table can hold.
AbsolutePath :: (path: string) -> bool {
    if path.count == 0 || path.count > 4096 || path[0] != #char "/" { return false }
    for index: cast(s64)0..path.count - 1 { if cast(u8)path[index] == 0 { return false } }
    return true
}

// The dynamic records after the read-only globals: the interpreter path; the
// strings, a NUL then each library path and each symbol name; the symbols,
// a null one first; a hash table with one empty bucket, since the
// executable defines nothing; the relocations; and the dynamic entries.
DynamicLayout :: (program: MachineProgram, hosts: MachineElfHosts, layout: *Layout) -> MachineDiagnostic {
    diagnostic := MachineDiagnostic.{problem = .None, function = MachineNoId, block = MachineNoId,
        instruction = MachineNoId, operand = MachineNoId, virtual = MachineNoId}
    strings: s64 = 1
    for index: cast(s64)0..hosts.libraries.count - 1 {
        if ArchiveAt(hosts, index) { continue }
        path := hosts.libraries[index]
        if !AbsolutePath(path) {
            diagnostic.problem = .Unsupported
            return diagnostic
        }
        strings += path.count + 1
    }
    for host: hosts.imports {
        name := SymbolName(program, host.function)
        if host.library < 0 || cast(s64)host.library >= hosts.libraries.count || !Named(name) {
            diagnostic.problem = .Unsupported
            diagnostic.function = host.function
            return diagnostic
        }
        strings += name.count + 1
    }
    count := hosts.imports.count
    at := Align(layout.read_end, 8)
    layout.interpreter = at
    at += MachineElfInterpreter.count + 1
    layout.strings = at
    layout.strings_size = strings
    at = Align(at + strings, 8)
    layout.symbols = at
    at += (count + 1) * SymbolSize
    layout.hash = at
    at = Align(at + (3 + count + 1) * 4, 8)
    layout.relocations = at
    at += count * RelocationSize
    layout.dynamic = at
    layout.dynamic_count = SharedCount(hosts) + 9
    layout.read_end = at + layout.dynamic_count * DynamicEntrySize
    return diagnostic
}

// The text right after the program headers, the read-only globals 16-byte
// aligned after it, any dynamic records, then the data.
ElfLayout :: (program: MachineProgram, encoded: MachineX64Image, hosts: MachineElfHosts,
    layout: *Layout) -> MachineDiagnostic {
    image := *layout.image
    image.os = .Linux
    image.hosts = hosts.imports
    image.builtins = hosts.builtins
    image.statics = hosts.statics
    image.objects = hosts.objects
    diagnostic := MachineX64ImageMeasure(program, encoded, image)
    if diagnostic.problem != .None { return diagnostic }
    // PT_INTERP, both PT_LOADs, PT_DYNAMIC, PT_GNU_STACK and PT_GNU_EH_FRAME
    // when linking; PT_GNU_EH_FRAME follows the loads in every image.
    if Dynamic(<<layout) { layout.headers = 6 }
    else { layout.headers = ifx MachineX64ImageHasData(<<image) then 3 else 2 }
    image.text = Align(MachineElfHeaderSize + layout.headers * MachineElfProgramHeaderSize, 16)
    diagnostic = MachineX64ImageText(program, encoded, image)
    if diagnostic.problem != .None { return diagnostic }
    image.constants = Align(image.text_end, 16)
    layout.read_end = TextEnd(<<layout)
    if Dynamic(<<layout) {
        diagnostic = DynamicLayout(program, hosts, layout)
        if diagnostic.problem != .None { return diagnostic }
    }
    // The unwind records follow the dynamic records inside the first
    // PT_LOAD, so they are mapped and read-only without another segment.
    layout.eh_frame = Align(layout.read_end, 8)
    layout.eh_frame_size = EhFrameSize(program, encoded, <<image)
    layout.read_end = layout.eh_frame + layout.eh_frame_size
    if layout.read_end > 2147483647 - MachineElfPage {
        diagnostic.problem = .Limit
        return diagnostic
    }
    layout.data_offset = layout.read_end
    image.data = layout.data_offset
    if MachineX64ImageHasData(<<image) {
        layout.data_offset = Align(layout.data_offset, MachineX64DataAlignment(program, hosts.objects))
        image.data = layout.data_offset + MachineElfPage
    }
    image.data_file = layout.data_offset
    layout.file_size = layout.data_offset + image.data_layout.size
    SectionLayout(program, encoded, layout)
    // The linked archives' pieces take their positions and relocations
    // with the data placed, before the program's own are checked.
    diagnostic = MachineX64ImageObjects(program, image, MachineElfBase)
    if diagnostic.problem != .None { return diagnostic }
    return MachineX64ImageResolve(program, encoded, <<image)
}

ProgramHeader :: (output: []u8, at: s64, kind: u64, flags: u64, offset: s64, address: s64,
    file_size: s64, memory_size: s64, alignment: s64) {
    PutLittle(output, at, kind, 4); PutLittle(output, at + 4, flags, 4)
    PutLittle(output, at + 8, cast(u64)offset, 8)
    PutLittle(output, at + 16, cast(u64)address, 8); PutLittle(output, at + 24, cast(u64)address, 8)
    PutLittle(output, at + 32, cast(u64)file_size, 8)
    PutLittle(output, at + 40, cast(u64)memory_size, 8)
    PutLittle(output, at + 48, cast(u64)alignment, 8)
}

DynamicEntry :: (output: []u8, layout: Layout, index: s64, tag: u64, value: u64) {
    at := layout.dynamic + index * DynamicEntrySize
    PutLittle(output, at, tag, 8)
    PutLittle(output, at + 8, value, 8)
}

WriteDynamic :: (program: MachineProgram, hosts: MachineElfHosts, layout: Layout, output: []u8) {
    base := cast(u64)MachineElfBase
    PutText(output, layout.interpreter, MachineElfInterpreter)
    at := layout.strings + 1
    entry: s64 = 0
    for index: cast(s64)0..hosts.libraries.count - 1 {
        if ArchiveAt(hosts, index) { continue }
        DynamicEntry(output, layout, entry, DtNeeded, cast(u64)(at - layout.strings))
        entry += 1
        path := hosts.libraries[index]
        PutText(output, at, path)
        at += path.count + 1
    }
    count := hosts.imports.count
    image := layout.image
    for index: cast(s64)0..count - 1 {
        name := SymbolName(program, hosts.imports[index].function)
        symbol := layout.symbols + (index + 1) * SymbolSize
        PutLittle(output, symbol, cast(u64)(at - layout.strings), 4)
        output[symbol + 4] = GlobalFunction
        PutBytes(output, at, name)
        at += name.count + 1
        relocation := layout.relocations + index * RelocationSize
        slot := image.data + image.data_layout.host_slots + index * 8
        PutLittle(output, relocation, base + cast(u64)slot, 8)
        PutLittle(output, relocation + 8, (cast(u64)(index + 1) << 32) | GlobDat, 8)
    }
    // One bucket, empty, and a chain entry per symbol.
    PutLittle(output, layout.hash, 1, 4)
    PutLittle(output, layout.hash + 4, cast(u64)(count + 1), 4)
    entry = SharedCount(hosts)
    DynamicEntry(output, layout, entry, DtHash, base + cast(u64)layout.hash)
    DynamicEntry(output, layout, entry + 1, DtStrtab, base + cast(u64)layout.strings)
    DynamicEntry(output, layout, entry + 2, DtSymtab, base + cast(u64)layout.symbols)
    DynamicEntry(output, layout, entry + 3, DtStrsz, cast(u64)layout.strings_size)
    DynamicEntry(output, layout, entry + 4, DtSyment, SymbolSize)
    DynamicEntry(output, layout, entry + 5, DtRela, base + cast(u64)layout.relocations)
    DynamicEntry(output, layout, entry + 6, DtRelasz, cast(u64)(count * RelocationSize))
    DynamicEntry(output, layout, entry + 7, DtRelaent, RelocationSize)
    DynamicEntry(output, layout, entry + 8, DtNull, 0)
}

// A program function with text to name in the symbol table.
SymbolNamed :: (program: MachineProgram, encoded: MachineX64Image, id: s64) -> bool {
    return id >= 0 && id < encoded.functions.count && id < program.functions.count &&
        encoded.functions[id].end > encoded.functions[id].begin &&
        program.functions[id].name_length > 0
}

// The null symbol, "_start", then one per named function.
SymbolCount :: (program: MachineProgram, encoded: MachineX64Image) -> s64 {
    count: s64 = 2
    for id: cast(s64)0..encoded.functions.count - 1 {
        if SymbolNamed(program, encoded, id) { count += 1 }
    }
    return count
}

// The string table after its leading NUL: "_start" and each named function.
SymbolStringsSize :: (program: MachineProgram, encoded: MachineX64Image) -> s64 {
    size: s64 = 1 + 6 + 1
    for id: cast(s64)0..encoded.functions.count - 1 {
        if !SymbolNamed(program, encoded, id) { continue }
        size += cast(s64)program.functions[id].name_length + 1
    }
    return size
}

// The section data after the segments: the symbol table, the strings it
// names, the section names and the section header table. None is mapped, so
// the segments' extents and addresses are unchanged.
SectionLayout :: (program: MachineProgram, encoded: MachineX64Image, layout: *Layout) {
    layout.symtab = Align(layout.file_size, 8)
    layout.symtab_size = SymbolCount(program, encoded) * SymbolSize
    layout.strtab = layout.symtab + layout.symtab_size
    layout.strtab_size = SymbolStringsSize(program, encoded)
    layout.shstrtab = layout.strtab + layout.strtab_size
    layout.sections = Align(layout.shstrtab + SectionNameBytes, 8)
    layout.file_size = layout.sections + SectionCount * SectionHeaderSize
}

// The .eh_frame writer: empty output measures. One CIE describes the
// platform's frame, and each generated extent gets an FDE whose CFI rows
// follow its actual prologue and epilogue bytes. At a call the return address
// is at CFA-8 and the CFA is rsp+8. A framed extent pushes rbp and moves it to
// rsp, so the CFA becomes rsp+16 after the push and rbp+16 after the move, and
// returns to rsp+8 at each ret or tail-call jump. A frameless extent changes
// none of it. The records are 4-byte aligned and deterministic.
EhFrameState :: struct {
    output: []u8
    // The section's file offset, for the FDEs' pcrel addresses.
    base: s64
    at: s64
    cie: s64
}

EhFrameExtent :: struct {
    fde: s64
    location: s64
    begin: s64
    previous: s64
}

EhFramePut :: (state: *EhFrameState, at: s64, value: u64, count: s32) {
    if state.output.count == 0 { return }
    for index: 0..count - 1 {
        state.output[state.base + at + index] = cast(u8)((value >> cast(u64)(index * 8)) & 255)
    }
}

EhFrameByte :: (state: *EhFrameState, value: u8) {
    EhFramePut(state, state.at, cast(u64)value, 1)
    state.at += 1
}

EhFrameLittle :: (state: *EhFrameState, value: u64, count: s32) {
    EhFramePut(state, state.at, value, count)
    state.at += count
}

EhFrameUleb :: (state: *EhFrameState, value: u64) {
    while true {
        byte := cast(u8)(value & 127)
        value = value >> 7
        if value != 0 { byte = byte | 128 }
        EhFrameByte(state, byte)
        if value == 0 { return }
    }
}

EhFrameAdvance :: (state: *EhFrameState, delta: s64) {
    if delta < 64 { EhFrameByte(state, cast(u8)(0x40 + delta)) }
    else if delta < 256 { EhFrameByte(state, 0x02); EhFrameByte(state, cast(u8)delta) }
    else { EhFrameByte(state, 0x03); EhFrameLittle(state, cast(u64)delta, 4) }
}

// A CIE for the ziran-internal x86-64 ABI: version 1, augmentation zR with
// pcrel sdata4 FDE addresses, and the default CFA rsp+8 with the return
// address at CFA-8.
EhFrameCie :: (state: *EhFrameState) {
    begin := state.at
    EhFrameLittle(state, 0, 4)
    EhFrameLittle(state, 0, 4)
    EhFrameByte(state, 1)
    EhFrameByte(state, 0x7a); EhFrameByte(state, 0x52); EhFrameByte(state, 0)
    EhFrameUleb(state, 1)
    // The data alignment factor -8 as SLEB128.
    EhFrameByte(state, 0x78)
    EhFrameUleb(state, 16)
    EhFrameUleb(state, 1)
    EhFrameByte(state, 0x1b)
    EhFrameByte(state, 0x0c); EhFrameUleb(state, 7); EhFrameUleb(state, 8)
    EhFrameByte(state, 0x90); EhFrameUleb(state, 1)
    while (state.at - begin - 4) % 4 != 0 { EhFrameByte(state, 0) }
    EhFramePut(state, begin, cast(u64)(state.at - begin - 4), 4)
    state.cie = begin
}

// An FDE for [BEGIN, END): the length, CIE pointer, pcrel start, range and
// an empty zR augmentation, then its CFI rows.
EhFrameExtentOpen :: (state: *EhFrameState, begin: s64, end: s64) -> EhFrameExtent {
    extent: EhFrameExtent = .{}
    extent.fde = state.at
    extent.begin = begin
    EhFrameLittle(state, 0, 4)
    EhFrameLittle(state, cast(u64)(extent.fde + 4 - state.cie), 4)
    extent.location = state.at
    EhFrameLittle(state, 0, 4)
    EhFrameLittle(state, cast(u64)(end - begin), 4)
    EhFrameUleb(state, 0)
    return extent
}

// One row at OFFSET from the extent's first byte. 1 is after the push, 2 is
// after the move to rbp, and 3 is the epilogue's return to rsp+8.
EhFrameExtentRow :: (state: *EhFrameState, extent: *EhFrameExtent, offset: s64, kind: s32) {
    if offset <= extent.previous { return }
    EhFrameAdvance(state, offset - extent.previous)
    extent.previous = offset
    if kind == 1 {
        EhFrameByte(state, 0x0e); EhFrameUleb(state, 16)
    } else if kind == 2 {
        EhFrameByte(state, 0x0c); EhFrameUleb(state, 6); EhFrameUleb(state, 16)
        EhFrameByte(state, 0x86); EhFrameUleb(state, 2)
    } else {
        EhFrameByte(state, 0x0c); EhFrameUleb(state, 7); EhFrameUleb(state, 8)
    }
}

// Ends the FDE: NOP padding to four bytes, its length, and the pcrel start.
EhFrameExtentClose :: (state: *EhFrameState, extent: *EhFrameExtent) {
    while (state.at - extent.fde - 4) % 4 != 0 { EhFrameByte(state, 0) }
    EhFramePut(state, extent.fde, cast(u64)(state.at - extent.fde - 4), 4)
    EhFramePut(state, extent.location,
        cast(u64)(extent.begin - (state.base + extent.location)), 4)
}

// The FDE of a program function: its prologue rows, then a row at every
// ret and tail-call jump the encoder placed in its instruction ranges.
EhFrameFunction :: (state: *EhFrameState, program: MachineProgram, encoded: MachineX64Image,
                    id: s64, begin_code: s64, end_code: s64) {
    function := encoded.functions[id]
    framed := function.frame < function.body && function.frame + 4 <= function.body &&
        encoded.code[function.frame] == 0x55 && encoded.code[function.frame + 1] == 0x48 &&
        encoded.code[function.frame + 2] == 0x89 && encoded.code[function.frame + 3] == 0xe5
    extent := EhFrameExtentOpen(state, begin_code, end_code)
    if framed {
        EhFrameExtentRow(state, *extent, function.frame - function.begin + 1, 1)
        EhFrameExtentRow(state, *extent, function.frame - function.begin + 4, 2)
        record := program.functions[id]
        first_block := cast(s64)record.block_begin
        last_block := first_block + cast(s64)record.block_count - 1
        for block_id: first_block..last_block {
            block := program.blocks[block_id]
            first_instruction := cast(s64)block.instruction_begin
            last_instruction := first_instruction + cast(s64)block.instruction_count - 1
            for instruction_id: first_instruction..last_instruction {
                instruction := program.instructions[instruction_id]
                range := encoded.instructions[instruction_id]
                if instruction.opcode == .Return {
                    EhFrameExtentRow(state, *extent, range.end - 1 - function.begin, 3)
                } else if instruction.opcode == .CallDirect && range.end - range.begin >= 5 &&
                    encoded.code[range.end - 5] == 0xe9 {
                    EhFrameExtentRow(state, *extent, range.end - 5 - function.begin, 3)
                }
            }
        }
    }
    EhFrameExtentClose(state, *extent)
}

// Whether FUNCTION is one of the two built-in services that grow a block and
// append their growth routine after the veneer's ret.
BuiltinName :: (program: MachineProgram, function: s32, expected: string) -> bool {
    if function < 0 || function >= program.functions.count { return false }
    record := program.functions[function]
    if cast(s64)record.name_length != expected.count { return false }
    for index: cast(s64)0..expected.count - 1 {
        if program.text[record.name_offset + index] != cast(u8)expected[index] { return false }
    }
    return true
}

// A reading built-in's growth-routine entry, or -1. The veneer's bytes are
// generated into a scratch buffer because the image writes them straight to
// the file; the routine follows the body's ret and starts with sub rsp, 8.
VeneerEnsureEntry :: (program: MachineProgram, image: MachineX64ImageLayout,
                      host: MachineX64HostImport, veneer: s64) -> s64 {
    if host.library != Host.MachineX64HostBuiltin ||
        (!BuiltinName(program, host.function, "FileReadHost") &&
         !BuiltinName(program, host.function, "DirectoryListHost")) { return -1 }
    buffer: [4096]u8
    writer := X86Writer.{output = buffer[:], at = 0, limit = 4096}
    if !Host.MachineX64HostVeneer(*writer, program, host, 0, image.routines.resize, image.imports) {
        return -1
    }
    for at: cast(s64)0..writer.at - 5 {
        if buffer[at] == 0xc3 && buffer[at + 1] == 0x48 && buffer[at + 2] == 0x83 &&
            buffer[at + 3] == 0xec && buffer[at + 4] == 0x08 { return veneer + at + 1 }
    }
    return -1
}

// The FDE of a host, built-in or archive veneer. Every veneer starts with
// push rbp; mov rbp, rsp, after a built-in's cld, and ends with pop rbp; ret.
// A reading built-in keeps its growth routine after the body's ret: that
// routine's own sub rsp, 8 and ret need rows of their own.
EhFrameVeneer :: (state: *EhFrameState, program: MachineProgram, image: MachineX64ImageLayout,
                  host: MachineX64HostImport, veneer: s64, end: s64, builtin: bool) {
    if end <= veneer { return }
    prologue := ifx builtin then 2 else 1
    extent := EhFrameExtentOpen(state, veneer, end)
    EhFrameExtentRow(state, *extent, prologue, 1)
    EhFrameExtentRow(state, *extent, prologue + 3, 2)
    ensure := VeneerEnsureEntry(program, image, host, veneer)
    if ensure >= 0 {
        // The rows are offsets from the veneer's first byte, not file offsets.
        EhFrameExtentRow(state, *extent, ensure - veneer - 1, 3)
        EhFrameExtentRow(state, *extent, ensure + 4 - veneer, 1)
    }
    EhFrameExtentRow(state, *extent, end - veneer - 1, 3)
    EhFrameExtentClose(state, *extent)
}

// The whole section: one CIE, an FDE per generated extent, and the zero
// terminator. Empty output measures the same bytes.
EhFrameBuild :: (program: MachineProgram, encoded: MachineX64Image, image: MachineX64ImageLayout,
                 output: []u8, base: s64) -> s64 {
    state := EhFrameState.{output = output, base = base}
    EhFrameCie(*state)
    // The process entry stub has no frame of its own to describe.
    entry := EhFrameExtentOpen(*state, image.text, image.text + image.startup_size)
    EhFrameExtentClose(*state, *entry)
    for id: cast(s64)0..encoded.functions.count - 1 {
        function := encoded.functions[id]
        if function.end <= function.begin { continue }
        EhFrameFunction(*state, program, encoded, id, image.text + image.startup_size + function.begin,
            image.text + image.startup_size + function.end)
    }
    for index: cast(s64)0..image.hosts.count - 1 {
        end := ifx index + 1 < image.hosts.count then image.hosts[index + 1].veneer else image.hosts_end
        EhFrameVeneer(*state, program, image, image.hosts[index], image.hosts[index].veneer, end, false)
    }
    for index: cast(s64)0..image.builtins.count - 1 {
        end := ifx index + 1 < image.builtins.count then image.builtins[index + 1].veneer else image.builtins_end
        EhFrameVeneer(*state, program, image, image.builtins[index], image.builtins[index].veneer, end, true)
    }
    for index: cast(s64)0..image.statics.count - 1 {
        end := ifx index + 1 < image.statics.count then image.statics[index + 1].veneer else image.statics_end
        EhFrameVeneer(*state, program, image, image.statics[index], image.statics[index].veneer, end, false)
    }
    EhFrameLittle(*state, 0, 4)
    return state.at
}

// The section's size, measured without writing.
EhFrameSize :: (program: MachineProgram, encoded: MachineX64Image, image: MachineX64ImageLayout) -> s64 {
    empty: []u8
    return EhFrameBuild(program, encoded, image, empty, 0)
}

// One ELF64 section header.
SectionHeader :: (output: []u8, at: s64, name: s64, kind: s64, flags: s64, address: u64,
    offset: s64, size: s64, link: s64, info: s64, alignment: s64, entry_size: s64) {
    PutLittle(output, at, cast(u64)name, 4)
    PutLittle(output, at + 4, cast(u64)kind, 4)
    PutLittle(output, at + 8, cast(u64)flags, 8)
    PutLittle(output, at + 16, address, 8)
    PutLittle(output, at + 24, cast(u64)offset, 8)
    PutLittle(output, at + 32, cast(u64)size, 8)
    PutLittle(output, at + 40, cast(u64)link, 4)
    PutLittle(output, at + 44, cast(u64)info, 4)
    PutLittle(output, at + 48, cast(u64)alignment, 8)
    PutLittle(output, at + 56, cast(u64)entry_size, 8)
}

// The symbol and string tables and the section names, then the section
// headers that describe the whole image.
SectionsWrite :: (program: MachineProgram, encoded: MachineX64Image, layout: Layout, output: []u8) {
    image := layout.image
    base := cast(u64)MachineElfBase
    // Symbol 0 is null, at an all-zero entry.
    at := layout.symtab + SymbolSize
    PutLittle(output, at, 1, 4)
    output[at + 4] = GlobalFunction
    PutLittle(output, at + 6, SectionText, 2)
    PutLittle(output, at + 8, base + cast(u64)image.text, 8)
    PutLittle(output, at + 16, cast(u64)image.startup_size, 8)
    string := 8
    at += SymbolSize
    for id: cast(s64)0..encoded.functions.count - 1 {
        if !SymbolNamed(program, encoded, id) { continue }
        record := program.functions[id]
        PutLittle(output, at, cast(u64)string, 4)
        output[at + 4] = GlobalFunction
        PutLittle(output, at + 6, SectionText, 2)
        PutLittle(output, at + 8, base + cast(u64)(image.text + image.startup_size +
            encoded.functions[id].begin), 8)
        PutLittle(output, at + 16, cast(u64)(encoded.functions[id].end -
            encoded.functions[id].begin), 8)
        string += cast(s64)record.name_length + 1
        at += SymbolSize
    }
    PutText(output, layout.strtab + 1, "_start")
    string = 8
    for id: cast(s64)0..encoded.functions.count - 1 {
        if !SymbolNamed(program, encoded, id) { continue }
        record := program.functions[id]
        PutBytes(output, layout.strtab + string, SymbolName(program, cast(s32)id))
        string += cast(s64)record.name_length + 1
    }
    PutText(output, layout.shstrtab + SectionNameText, ".text")
    PutText(output, layout.shstrtab + SectionNameConstants, ".rodata")
    PutText(output, layout.shstrtab + SectionNameData, ".data")
    PutText(output, layout.shstrtab + SectionNameBss, ".bss")
    PutText(output, layout.shstrtab + SectionNameSymbols, ".symtab")
    PutText(output, layout.shstrtab + SectionNameStrings, ".strtab")
    PutText(output, layout.shstrtab + SectionNameDynamic, ".dynamic")
    PutText(output, layout.shstrtab + SectionNameEhFrame, ".eh_frame")
    PutText(output, layout.shstrtab + SectionNameNames, ".shstrtab")
    data := layout.image.data_layout
    has_data := MachineX64ImageHasData(image)
    // Entry 0 stays the null section.
    text_offset := layout.sections + SectionHeaderSize
    SectionHeader(output, text_offset, SectionNameText, 1, 6, base + cast(u64)image.text,
        image.text, image.constants - image.text, 0, 0, 16, 0)
    SectionHeader(output, text_offset + SectionHeaderSize, SectionNameConstants, 1, 2,
        base + cast(u64)image.constants, image.constants, image.constants_size, 0, 0, 16, 0)
    SectionHeader(output, text_offset + SectionHeaderSize * 2, SectionNameData, 1, 3,
        base + cast(u64)image.data, ifx has_data then layout.data_offset else 0,
        data.size, 0, 0, 16, 0)
    SectionHeader(output, text_offset + SectionHeaderSize * 3, SectionNameBss, 8, 3,
        base + cast(u64)(image.data + data.size),
        ifx has_data then layout.data_offset + data.size else 0,
        data.memory - data.size, 0, 0, 16, 0)
    SectionHeader(output, text_offset + SectionHeaderSize * 4, SectionNameSymbols, 2, 0, 0,
        layout.symtab, layout.symtab_size, SectionStrings, 1, 8, SymbolSize)
    SectionHeader(output, text_offset + SectionHeaderSize * 5, SectionNameStrings, 3, 0, 0,
        layout.strtab, layout.strtab_size, 0, 0, 1, 0)
    has_dynamic := Dynamic(layout)
    SectionHeader(output, text_offset + SectionHeaderSize * 6, SectionNameDynamic, 6, 2,
        ifx has_dynamic then base + cast(u64)layout.dynamic else 0,
        ifx has_dynamic then layout.dynamic else 0,
        ifx has_dynamic then layout.dynamic_count * DynamicEntrySize else 0, 0, 0, 8, 16)
    SectionHeader(output, text_offset + SectionHeaderSize * 7, SectionNameEhFrame, 1, 2,
        base + cast(u64)layout.eh_frame, layout.eh_frame, layout.eh_frame_size, 0, 0, 4, 0)
    SectionHeader(output, text_offset + SectionHeaderSize * 8, SectionNameNames, 3, 0, 0,
        layout.shstrtab, SectionNameBytes, 0, 0, 1, 0)
}

Write :: (program: MachineProgram, encoded: MachineX64Image, hosts: MachineElfHosts, layout: Layout,
    output: []u8, fuel: s64) -> bool {
    for index: cast(s64)0..output.count - 1 { output[index] = 0 }
    image := layout.image
    data := MachineElfBase + image.data

    // ELF64 little-endian ET_EXEC, x86-64: its program headers describe the
    // mapped segments, and section headers after them name their contents.
    output[0] = 0x7f; output[1] = 69; output[2] = 76; output[3] = 70
    output[4] = 2; output[5] = 1; output[6] = 1
    PutLittle(output, 16, 2, 2); PutLittle(output, 18, 62, 2); PutLittle(output, 20, 1, 4)
    PutLittle(output, 24, cast(u64)(MachineElfBase + image.text), 8)
    PutLittle(output, 32, MachineElfHeaderSize, 8)
    PutLittle(output, 40, cast(u64)layout.sections, 8)
    PutLittle(output, 52, MachineElfHeaderSize, 2)
    PutLittle(output, 54, MachineElfProgramHeaderSize, 2)
    PutLittle(output, 56, cast(u64)layout.headers, 2)
    PutLittle(output, 58, SectionHeaderSize, 2)
    PutLittle(output, 60, SectionCount, 2)
    PutLittle(output, 62, SectionNames, 2)

    ph := cast(s64)MachineElfHeaderSize
    // PT_INTERP precedes every PT_LOAD.
    if Dynamic(layout) {
        ProgramHeader(output, ph, 3, 4, layout.interpreter, MachineElfBase + layout.interpreter,
            MachineElfInterpreter.count + 1, MachineElfInterpreter.count + 1, 1)
        ph += MachineElfProgramHeaderSize
    }
    // RX PT_LOAD: the headers, text, read-only globals and dynamic records.
    ProgramHeader(output, ph, 1, 5, 0, MachineElfBase, layout.read_end, layout.read_end, MachineElfPage)
    // RW PT_LOAD, a page above its file offset and never executable.
    if MachineX64ImageHasData(image) {
        ph += MachineElfProgramHeaderSize
        ProgramHeader(output, ph, 1, 6, layout.data_offset, data, image.data_layout.size,
            image.data_layout.memory, MachineElfPage)
    }
    if Dynamic(layout) {
        ph += MachineElfProgramHeaderSize
        size := layout.dynamic_count * DynamicEntrySize
        ProgramHeader(output, ph, 2, 4, layout.dynamic, MachineElfBase + layout.dynamic, size, size, 8)
        ph += MachineElfProgramHeaderSize
        ProgramHeader(output, ph, 0x6474e551, 6, 0, 0, 0, 0, 16)
        WriteDynamic(program, hosts, layout, output)
    }
    // PT_GNU_EH_FRAME names the mapped unwind records for debuggers and perf.
    if layout.eh_frame_size > 0 {
        ph += MachineElfProgramHeaderSize
        ProgramHeader(output, ph, 0x6474e550, 4, layout.eh_frame,
            MachineElfBase + layout.eh_frame, layout.eh_frame_size, layout.eh_frame_size, 4)
    }
    if !MachineX64ImageWrite(program, encoded, image, output, MachineElfBase, fuel) { return false }
    EhFrameBuild(program, encoded, image, output, layout.eh_frame)
    SectionsWrite(program, encoded, layout, output)
    return true
}

// The file offset of a data piece at OFFSET, or -1 when absent.
DataAt :: (layout: Layout, offset: s64) -> s64 { return ifx offset < 0 then -1 else layout.data_offset + offset }

// Little-endian fields of a library's bytes; callers check the bounds.
Read :: (bytes: []u8, at: s64, count: s32) -> u64 {
    value: u64 = 0
    for index: 0..count - 1 { value = value | (cast(u64)bytes[at + index] << cast(u64)(index * 8)) }
    return value
}

// Whether OFFSET + SIZE lies inside COUNT bytes.
Inside :: (offset: u64, size: u64, count: s64) -> bool {
    return offset <= cast(u64)count && size <= cast(u64)count - offset
}

// Whether the NUL-terminated string at AT, before END, is NAME.
NameAt :: (bytes: []u8, at: s64, end: s64, name: string) -> bool {
    if at < 0 || at > end - name.count - 1 { return false }
    for index: cast(s64)0..name.count - 1 { if bytes[at + index] != cast(u8)name[index] { return false } }
    return bytes[at + name.count] == 0
}

#scope_export

// Empty OUTPUT measures. A non-empty OUTPUT must have exactly the measured
// length. Verification, complete relocation resolution and i32 range checks
// all finish before the first output byte is changed. HOSTS names the host
// libraries a program that calls host capabilities links, and the services
// the executable carries itself; a program with neither is static.
MachineElfEncode :: (program: MachineProgram, encoded: MachineX64Image, output: []u8,
    fuel: s64, hosts: MachineElfHosts) -> MachineElfResult {
    if fuel < 0 { return Failure(.Fuel) }
    layout: Layout
    diagnostic := ElfLayout(program, encoded, hosts, *layout)
    if diagnostic.problem != .None { return .{diagnostic = diagnostic} }
    image := layout.image
    data := image.data_layout
    has_data := MachineX64ImageHasData(image)
    // No data segment reports zero offsets.
    result := MachineElfResult.{diagnostic = diagnostic, size = layout.file_size,
        text_offset = image.text, text_size = TextEnd(layout) - image.text, startup_size = image.startup_size,
        data_offset = ifx has_data then layout.data_offset else 0,
        data_address = ifx has_data then image.data else 0, data_size = data.size,
        fuel_offset = DataAt(layout, data.fuel), trap_status_offset = DataAt(layout, data.trap_status),
        pointer_offset = DataAt(layout, data.pointer_header),
        dynamic_offset = ifx Dynamic(layout) then layout.dynamic else -1,
        eh_frame_offset = ifx layout.eh_frame_size > 0 then layout.eh_frame else -1,
        eh_frame_size = layout.eh_frame_size}
    if output.count == 0 { return result }
    if output.count != layout.file_size { return Failure(.Limit) }
    if !Write(program, encoded, hosts, layout, output, fuel) { return Failure(.Relocation) }
    return result
}

// Whether LIBRARY, the bytes of a little-endian ELF64 x86-64 shared object,
// defines NAME as a global or weak function in its dynamic symbol table: the
// symbol the dynamic linker binds an executable's import of NAME to.
MachineElfLibraryDefines :: (library: []u8, name: string) -> bool {
    count := library.count
    if count < 64 || name.count == 0 || library[0] != 0x7f || library[1] != 69 || library[2] != 76 ||
        library[3] != 70 || library[4] != 2 || library[5] != 1 || Read(library, 16, 2) != 3 ||
        Read(library, 18, 2) != 62 || Read(library, 58, 2) != 64 { return false }
    sections := Read(library, 40, 8)
    section_count := cast(s64)Read(library, 60, 2)
    if !Inside(sections, cast(u64)section_count * 64, count) { return false }
    section: s64 = 0
    while section < section_count {
        header := cast(s64)sections + section * 64
        section += 1
        if Read(library, header + 4, 4) != 11 { continue }
        symbols := Read(library, header + 24, 8)
        symbols_size := Read(library, header + 32, 8)
        link := cast(s64)Read(library, header + 40, 4)
        if Read(library, header + 56, 8) != SymbolSize || link >= section_count ||
            !Inside(symbols, symbols_size, count) { return false }
        strings_header := cast(s64)sections + link * 64
        strings := Read(library, strings_header + 24, 8)
        strings_size := Read(library, strings_header + 32, 8)
        if !Inside(strings, strings_size, count) { return false }
        symbol_count := cast(s64)(symbols_size / SymbolSize)
        // Symbol 0 is the null symbol.
        symbol: s64 = 1
        while symbol < symbol_count {
            at := cast(s64)symbols + symbol * SymbolSize
            symbol += 1
            info := library[at + 4]
            bind := info >> 4
            kind := info & 15
            // Defined (st_shndx is not SHN_UNDEF), global or weak, a function
            // or an indirect function.
            if Read(library, at + 6, 2) == 0 || bind != 1 && bind != 2 || kind != 2 && kind != 10 { continue }
            offset := Read(library, at, 4)
            if offset >= strings_size { continue }
            if NameAt(library, cast(s64)(strings + offset), cast(s64)(strings + strings_size), name) { return true }
        }
    }
    return false
}
