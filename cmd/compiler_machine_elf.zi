  0x45,0x85,0xdb,0x74,0x11,0xd9,0x1c,0x24,0xf3,0x0f,0x10,0x14]
second: [384]u8 = .[
  0x24,0xf2,0x0f,0x5a,0xc8,0x0f,0x2e,0xd1,0xeb,0x0c,0xdd,0x1c,
  0x24,0xf2,0x0f,0x10,0x0c,0x24,0x66,0x0f,0x2e,0xc8,0x7a,0x02,
