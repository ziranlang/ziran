using Allocated :: #import "compiler_machine_verify_allocated"
using Image :: #import "compiler_machine_image"
using Machine :: #import "compiler_machine_ir"
using Runtime :: #import "compiler_x86_runtime"
using X64 :: #import "compiler_x86_64"

// Deterministic, sectionless Linux x86-64 ELF image for allocated machine IR.
// The first PT_LOAD contains the ELF headers, a Ziran-owned process entry stub,
// the encoded machine text and the hard-trap stub, and is read/execute only.
// The second PT_LOAD contains zero-initialized globals, the fuel counter, the
// last trap code, the stack limit and the pointer runtime: its header, the
// pointer table (slot 0 and the globals' slots in the file, the rest zero
// fill), the frame arena and the heap's state. It is read/write but never
// executable.
//
// Process convention:
//   * a void entry exits zero; a bool/integer entry exits with its low byte;
//   * fuel starts at the requested budget, by default MachineElfInitialFuel,
//     the same unbounded budget a bundle run starts with, and every
//     MachineOpcode.Fuel debits it;
//   * a hard trap stores its u32 MachineX64Trap* code and exits status 125;
//   * _start sets the stack limit MachineElfStackBytes below its own stack
//     pointer, inside the default 8 MiB process stack, so runaway recursion
//     takes MachineX64TrapStack instead of faulting.
// No dynamic linker, runtime, assembler or foreign object participates.

MachineElfBase :: 0x400000
MachineElfPage :: 4096
MachineElfHeaderSize :: 64
MachineElfProgramHeaderSize :: 56
MachineElfProgramHeaders :: 2
MachineElfTextOffset :: 4096
// Stack limit setup (16 bytes), then the entry call, its status and the
// jump to the runtime's exit (12 bytes).
MachineElfStartupSize :: 28
MachineElfStackBytes :: 0x7c0000
// Store the trap code, then exit with MachineElfTrapExitStatus.
MachineElfTrapSize :: 16
// The float formatter: position independent, with its naturally aligned SSE
// constants 16-byte aligned when it starts 12 bytes past a boundary. It writes
// its text through one call to the console's stdout_bytes.
MachineElfFloatSize :: 768
MachineElfFloatAlignment :: 12
MachineElfFloatWriteField :: 0x2b3
MachineElfFloat32Offset :: 704
MachineElfFloat64Offset :: 718
MachineElfInitialFuel :: 9223372036854775807
MachineElfTrapExitStatus :: 125

MachineElfResult :: struct {
    diagnostic: MachineDiagnostic
    size: s64
    text_offset: s64
    text_size: s64
    data_offset: s64
    data_size: s64
    fuel_offset: s64
    trap_status_offset: s64
    pointer_offset: s64
}

#scope_file

DataLayout :: struct {
    globals_size: s64
    fuel: s64
    trap_status: s64
    stack_limit: s64
    pointer_header: s64
    table: s64
    arena: s64
    heap: s64
    console: s64
    // Bytes in the file, and in memory with the zero fill.
    size: s64
    memory: s64
}

Layout :: struct {
    startup_size: s64
    text_size: s64
    data_offset: s64
    file_size: s64
    trap_text: s64
    // The emitted routines, then the float formatter when a program prints
    // floats.
    routines_text: s64
    routines: MachineX64RuntimeEntries
    float_text: s64
    constants_text: s64
    constants_size: s64
    data: DataLayout
}

NoDiagnostic :: () -> MachineDiagnostic {
    return .{problem = .None, function = MachineNoId, block = MachineNoId,
        instruction = MachineNoId, operand = MachineNoId, virtual = MachineNoId}
}

Failure :: (problem: MachineProblem, instruction: s32 = MachineNoId) -> MachineElfResult {
    return .{diagnostic = .{problem = problem, function = MachineNoId, block = MachineNoId,
        instruction = instruction, operand = MachineNoId, virtual = MachineNoId}}
}

Align :: (value: s64, alignment: s64) -> s64 {
    return (value + alignment - 1) & ~(alignment - 1)
}

ValidAlignment :: (alignment: s32) -> bool {
    return alignment > 0 && alignment <= MachineElfPage && (alignment & (alignment - 1)) == 0
}

DataMeasure :: (program: MachineProgram, layout: *DataLayout) -> MachineDiagnostic {
    at: s64 = 0
    for global: program.globals {
        if global.type < 0 || global.type >= program.types.count {
            result := NoDiagnostic(); result.problem = .Unsupported; return result
        }
        if !global.writable { continue }
        type := program.types[global.type]
        if type.size <= 0 || type.size > 2147483647 || !ValidAlignment(type.alignment) {
            result := NoDiagnostic(); result.problem = .Unsupported; return result
        }
        at = Align(at, type.alignment)
        if at > 2147483647 - type.size {
            result := NoDiagnostic(); result.problem = .Limit; return result
        }
        at += type.size
    }
    layout.globals_size = at
    layout.fuel = Align(at, 8)
    if layout.fuel > 2147483647 - 8 {
        result := NoDiagnostic(); result.problem = .Limit; return result
    }
    layout.trap_status = Align(layout.fuel + 8, 4)
    layout.stack_limit = Align(layout.trap_status + 4, 8)
    layout.pointer_header = layout.stack_limit + 8
    layout.table = Align(layout.pointer_header + MachinePointerHeaderBytes, MachinePointerEntryBytes)
    slots := program.globals.count + 1
    if slots > MachinePointerCapacity || layout.table > 2147483647 - slots * MachinePointerEntryBytes {
        result := NoDiagnostic(); result.problem = .Limit; return result
    }
    layout.size = layout.table + slots * MachinePointerEntryBytes
    layout.arena = Align(layout.table + (MachinePointerCapacity + 1) * MachinePointerEntryBytes, 16)
    layout.heap = Align(layout.arena + MachinePointerArenaBytes, 16)
    layout.console = layout.heap + MachineX64RuntimeHeapBytes
    layout.memory = layout.console + MachineX64RuntimeConsoleBytes
    return NoDiagnostic()
}

GlobalsMeasure :: (program: MachineProgram, writable: bool, size: *s64) -> MachineDiagnostic {
    at: s64 = 0
    for global: program.globals {
        if global.type < 0 || global.type >= program.types.count {
            result := NoDiagnostic(); result.problem = .Unsupported; return result
        }
        if global.writable != writable { continue }
        type := program.types[global.type]
        if type.size <= 0 || type.size > 2147483647 || !ValidAlignment(type.alignment) {
            result := NoDiagnostic(); result.problem = .Unsupported; return result
        }
        at = Align(at, type.alignment)
        if at > 2147483647 - type.size {
            result := NoDiagnostic(); result.problem = .Limit; return result
        }
        at += type.size
    }
    <<size = at
    return NoDiagnostic()
}

GlobalOffset :: (program: MachineProgram, symbol: s32, writable: bool, offset: *s64) -> bool {
    if symbol < 0 || symbol >= program.globals.count { return false }
    if program.globals[symbol].writable != writable { return false }
    at: s64 = 0
    for index: cast(s64)0..program.globals.count - 1 {
        global := program.globals[index]
        if global.type < 0 || global.type >= program.types.count { return false }
        if global.writable != writable { continue }
        type := program.types[global.type]
        if type.size <= 0 || !ValidAlignment(type.alignment) { return false }
        at = Align(at, type.alignment)
        if index == symbol { <<offset = at; return true }
        at += type.size
    }
    return false
}

Relative32 :: (target: u64, addend: s64, field: u64, value: *s64) -> bool {
    // Every address in this image is bounded below 2^32 and relocation addends
    // are restricted to i32, so this subtraction cannot overflow s64.
    if target > 0xffffffff || field > 0xffffffff ||
        addend < -2147483648 || addend > 2147483647 { return false }
    displacement := cast(s64)target + addend - cast(s64)field
    if displacement < -2147483648 || displacement > 2147483647 { return false }
    <<value = displacement
    return true
}

TrapOpcode :: (opcode: MachineOpcode) -> bool {
    return opcode == .IntegerDivide || opcode == .IntegerRemainder ||
        opcode == .ShiftLeft || opcode == .ShiftRight || opcode == .AggregateExtract ||
        opcode == .AggregateInsert || opcode == .ElementAddress ||
        opcode == .Convert || opcode == .Fuel || opcode == .Trap || opcode == .Unreachable ||
        PointerOpcode(opcode)
}

// Instructions whose sequences use the pointer runtime header.
PointerOpcode :: (opcode: MachineOpcode) -> bool {
    return opcode == .PointerResolve || opcode == .PointerCreate || opcode == .ArenaAllocate ||
        opcode == .Resize
}

FunctionNameEqual :: (program: MachineProgram, symbol: s32, expected: string) -> bool {
    if symbol < 0 || symbol >= program.functions.count { return false }
    function := program.functions[symbol]
    if function.name_offset < 0 || function.name_length != expected.count ||
        function.name_offset > program.text.count - function.name_length { return false }
    for index: cast(s64)0..expected.count - 1 {
        if program.text[function.name_offset + index] != cast(u8)expected[index] { return false }
    }
    return true
}

// The image file offset of a platform service the runtime implements.
PlatformTarget :: (program: MachineProgram, layout: Layout, symbol: s32, offset: *s64) -> bool {
    routines := layout.routines
    float := MachineElfTextOffset + layout.float_text
    if FunctionNameEqual(program, symbol, "ziran.platform.write_all") { <<offset = routines.write_all; return true }
    if FunctionNameEqual(program, symbol, "ziran.print.signed") { <<offset = routines.print_signed; return true }
    if FunctionNameEqual(program, symbol, "ziran.print.unsigned") { <<offset = routines.print_unsigned; return true }
    if FunctionNameEqual(program, symbol, "ziran.print.bool") { <<offset = routines.print_bool; return true }
    if layout.float_text == 0 { return false }
    if FunctionNameEqual(program, symbol, "ziran.print.float32") { <<offset = float + MachineElfFloat32Offset; return true }
    if FunctionNameEqual(program, symbol, "ziran.print.float64") { <<offset = float + MachineElfFloat64Offset; return true }
    return false
}

// The runtime routines the program calls: any platform service writes
// through the console, and a float one also needs the float formatter.
RuntimeUses :: (program: MachineProgram, image: MachineX64Image, float: *bool) -> MachineX64RuntimeUses {
    uses: MachineX64RuntimeUses
    for instruction: program.instructions {
        if instruction.opcode == .Resize { uses.resize = true }
    }
    for relocation: image.relocations {
        if relocation.kind != .PlatformService { continue }
        uses.console = true
        if FunctionNameEqual(program, relocation.symbol, "ziran.print.float32") ||
            FunctionNameEqual(program, relocation.symbol, "ziran.print.float64") { <<float = true }
    }
    return uses
}

RuntimePlaces :: (layout: Layout) -> MachineX64RuntimePlaces {
    return .{trap = MachineElfTextOffset + layout.trap_text, heap = layout.data_offset + layout.data.heap,
        console = layout.data_offset + layout.data.console}
}

StartupSize :: (program: MachineProgram) -> s64 {
    return MachineElfStartupSize + program.initializers.count * 5
}

ImageLayout :: (program: MachineProgram, image: MachineX64Image, layout: *Layout) -> MachineDiagnostic {
    verified := MachineVerifyAllocated(program, MachineDefaultLimits())
    if verified.problem != .None { return verified }
    if program.target.arch != .X86_64 || program.target.os != .Linux || program.target.abi != .SysV {
        result := NoDiagnostic(); result.problem = .UnsupportedTarget; return result
    }
    if program.entry < 0 || program.entry >= program.functions.count || image.entry != program.entry ||
        image.code.count <= 0 || image.code.count > 2147483647 ||
        image.functions.count != program.functions.count || image.blocks.count != program.blocks.count ||
        image.instructions.count != program.instructions.count {
        result := NoDiagnostic(); result.problem = .Relocation; return result
    }
    entry := program.functions[program.entry]
    if entry.parameter_count != 0 || entry.result_type < 0 || entry.result_type >= program.types.count {
        result := NoDiagnostic(); result.problem = .Unsupported; return result
    }
    result_type := program.types[entry.result_type]
    if result_type.kind != .Void && result_type.kind != .Bool && result_type.kind != .Integer {
        result := NoDiagnostic(); result.problem = .Unsupported; return result
    }
    for global: program.globals {
        if !global.writable && global.constant < 0 {
            result := NoDiagnostic(); result.problem = .Unsupported; return result
        }
        if global.constant >= 0 {
            constant := program.constants[global.constant]
            type := program.types[global.type]
            if (constant.bytes_count == 0 && type.size > 8) ||
                (constant.bytes_count != 0 && constant.bytes_count != type.size) {
                result := NoDiagnostic(); result.problem = .Unsupported; return result
            }
        }
    }
    previous: s64 = 0
    for function: image.functions {
        if function.begin < previous || function.body < function.begin || function.end < function.body ||
            function.end > image.code.count {
            result := NoDiagnostic(); result.problem = .Relocation; return result
        }
        previous = function.end
    }
    for block: image.blocks {
        if block < 0 || block > image.code.count {
            result := NoDiagnostic(); result.problem = .Relocation; return result
        }
    }
    for range: image.instructions {
        if range.begin < 0 || range.end < range.begin || range.end > image.code.count {
            result := NoDiagnostic(); result.problem = .Relocation; return result
        }
    }
    data_diagnostic := DataMeasure(program, *layout.data)
    if data_diagnostic.problem != .None { return data_diagnostic }
    constants_diagnostic := GlobalsMeasure(program, false, *layout.constants_size)
    if constants_diagnostic.problem != .None { return constants_diagnostic }
    layout.startup_size = StartupSize(program)
    if layout.startup_size > 2147483647 - image.code.count {
        result := NoDiagnostic(); result.problem = .Limit; return result
    }
    layout.trap_text = layout.startup_size + image.code.count
    layout.routines_text = Align(layout.trap_text + MachineElfTrapSize, 16)
    float := false
    measuring: []u8
    if !MachineX64RuntimeEmit(measuring, MachineElfTextOffset + layout.routines_text,
        RuntimeUses(program, image, *float), RuntimePlaces(<<layout), *layout.routines) {
        result := NoDiagnostic(); result.problem = .Limit; return result
    }
    end := layout.routines.end - MachineElfTextOffset
    if float {
        layout.float_text = Align(end + 16 - MachineElfFloatAlignment, 16) - 16 + MachineElfFloatAlignment
        end = layout.float_text + MachineElfFloatSize
    }
    layout.constants_text = Align(end, 16)
    layout.text_size = layout.constants_text + layout.constants_size
    if layout.text_size > 2147483647 - MachineElfTextOffset {
        result := NoDiagnostic(); result.problem = .Limit; return result
    }
    layout.data_offset = Align(MachineElfTextOffset + layout.text_size, MachineElfPage)
    if layout.data_offset > 2147483647 - layout.data.size {
        result := NoDiagnostic(); result.problem = .Limit; return result
    }
    layout.file_size = layout.data_offset + layout.data.size

    // The encoder's own measuring pass must find exactly these relocations.
    remeasured := MachineX64Measure(program, MachineDefaultLimits())
    if remeasured.diagnostic.problem != .None || remeasured.relocations != image.relocations.count {
        result := NoDiagnostic(); result.problem = .Relocation; return result
    }
    previous = -1
    for relocation: image.relocations {
        if relocation.instruction == MachineNoId {
            // Only a checked prologue has relocations outside an instruction.
            if relocation.offset <= previous || relocation.offset < 0 ||
                relocation.offset > image.code.count - 4 ||
                (relocation.kind != .StackLimit && relocation.kind != .TrapHandler &&
                 relocation.kind != .PointerRuntime) ||
                relocation.symbol != 0 || relocation.addend != -4 ||
                !InPrologue(program, image, relocation.offset) {
                result := NoDiagnostic(); result.problem = .Relocation; return result
            }
            previous = relocation.offset
            continue
        }
        if relocation.kind == .StackLimit ||
            relocation.kind == .PointerRuntime &&
                !PointerOpcode(program.instructions[relocation.instruction].opcode) &&
                program.instructions[relocation.instruction].opcode != .Return ||
            relocation.offset <= previous || relocation.offset < 0 ||
            relocation.offset > image.code.count - 4 || relocation.instruction < 0 ||
            relocation.instruction >= image.instructions.count ||
            relocation.offset < image.instructions[relocation.instruction].begin ||
            relocation.offset + 4 > image.instructions[relocation.instruction].end {
            result := NoDiagnostic(); result.problem = .Relocation
            result.instruction = relocation.instruction; return result
        }
        previous = relocation.offset
        target: u64 = 0
        if relocation.kind == .GlobalAddress || relocation.kind == .ConstantAddress {
            readonly := relocation.kind == .ConstantAddress
            if program.instructions[relocation.instruction].opcode != .GlobalAddress {
                result := NoDiagnostic(); result.problem = .Relocation
                result.instruction = relocation.instruction; return result
            }
            global_offset: s64 = 0
            if !GlobalOffset(program, relocation.symbol, !readonly, *global_offset) {
                result := NoDiagnostic(); result.problem = .Relocation
                result.instruction = relocation.instruction; return result
            }
            if readonly {
                target = cast(u64)(MachineElfBase + MachineElfTextOffset +
                    layout.constants_text + global_offset)
            } else { target = cast(u64)(MachineElfBase + layout.data_offset + global_offset) }
        } else if relocation.kind == .FuelCounter && relocation.symbol == 0 {
            if program.instructions[relocation.instruction].opcode != .Fuel {
                result := NoDiagnostic(); result.problem = .Relocation
                result.instruction = relocation.instruction; return result
            }
            target = cast(u64)(MachineElfBase + layout.data_offset + layout.data.fuel)
        } else if relocation.kind == .TrapHandler && relocation.symbol == 0 {
            if !TrapOpcode(program.instructions[relocation.instruction].opcode) || relocation.addend != -4 {
                result := NoDiagnostic(); result.problem = .Relocation
                result.instruction = relocation.instruction; return result
            }
            target = cast(u64)(MachineElfBase + MachineElfTextOffset + layout.trap_text)
        } else if relocation.kind == .PlatformService {
            if program.instructions[relocation.instruction].opcode != .CallDirect {
                result := NoDiagnostic(); result.problem = .Relocation
                result.instruction = relocation.instruction; return result
            }
            service_offset: s64 = 0
            if !PlatformTarget(program, <<layout, relocation.symbol, *service_offset) {
                result := NoDiagnostic(); result.problem = .Unsupported
                result.instruction = relocation.instruction; return result
            }
            target = cast(u64)(MachineElfBase + service_offset)
        } else if relocation.kind == .PointerRuntime && relocation.symbol == 0 {
            target = cast(u64)(MachineElfBase + layout.data_offset + layout.data.pointer_header)
        } else if relocation.kind == .RuntimeResize && relocation.symbol == 0 {
            if program.instructions[relocation.instruction].opcode != .Resize {
                result := NoDiagnostic(); result.problem = .Relocation
                result.instruction = relocation.instruction; return result
            }
            target = cast(u64)(MachineElfBase + layout.routines.resize)
        } else {
            result := NoDiagnostic(); result.problem = .Relocation
            result.instruction = relocation.instruction; return result
        }
        field := cast(u64)(MachineElfBase + MachineElfTextOffset + layout.startup_size + relocation.offset)
        displacement: s64 = 0
        if !Relative32(target, relocation.addend, field, *displacement) {
            result := NoDiagnostic(); result.problem = .Relocation
            result.instruction = relocation.instruction; return result
        }
    }
    return NoDiagnostic()
}

// Whether a field at OFFSET lies inside the prologue of a function that
// checks its stack or keeps checked frame storage.
InPrologue :: (program: MachineProgram, image: MachineX64Image, offset: s64) -> bool {
    for function_id: cast(s64)0..image.functions.count - 1 {
        function := image.functions[function_id]
        if offset >= function.begin && offset + 4 <= function.body {
            return MachineX64StackChecked(program, cast(s32)function_id) ||
                program.functions[function_id].pointer_chain != 0
        }
    }
    return false
}

Put8 :: (output: []u8, at: s64, value: u8) { output[at] = value }

PutLittle :: (output: []u8, at: s64, value: u64, count: s32) {
    for index: 0..count - 1 {
        output[at + index] = cast(u8)((value >> cast(u64)(index * 8)) & 255)
    }
}

PutRelative :: (output: []u8, at: s64, target: u64, addend: s64, field: u64) -> bool {
    value: s64 = 0
    if !Relative32(target, addend, field, *value) { return false }
    PutLittle(output, at, cast(u64)value, 4)
    return true
}

WriteFloatRuntime :: (output: []u8, at: s64) {
first: [384]u8 = .[
  0x53,0x66,0x48,0x0f,0x7e,0xc2,0x41,0x89,0xfb,0x31,0xc9,0x48,
