  0x8d,0x71,0x02,0x4c,0x01,0xd1,0x48,0xff,0xc1,0x39,0xd0,0x7e,
  0x0d,0x41,0x8a,0x3c,0x11,0x48,0xff,0xc2,0x40,0x88,0x79,0x01,
  0xeb,0xec,0x89,0xf0,0x44,0x29,0xc0,0x41,0x8d,0x7c,0x03,0xff,
  0x48,0x63,0xf7,0x4c,0x89,0xd7,0xe8,0x1d,0xfd,0xff,0xff,0x48,
  0x81,0xc4,0xc0,0x01,0x00,0x00,0x5b,0xc3,0xbf,0x01,0x00,0x00,
  0x00,0xf3,0x0f,0x5a,0xc0,0xe9,0x32,0xfd,0xff,0xff,0x31,0xff,
  0xe9,0x2b,0xfd,0xff,0xff,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x00,0x80,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
  0x00,0x00,0x20,0x41,0x00,0x00,0x80,0x5f,0x00,0x00,0x00,0x3f]
    for index: cast(s64)0..first.count - 1 { output[at + index] = first[index] }
    for index: cast(s64)0..second.count - 1 { output[at + first.count + index] = second[index] }
}

WriteGlobal :: (program: MachineProgram, symbol: s32, at: s64, output: []u8) -> bool {
    global := program.globals[symbol]
    if global.constant < 0 { return global.writable }
    constant := program.constants[global.constant]
    type := program.types[global.type]
    if constant.bytes_count == 0 {
        if type.size > 8 { return false }
        PutLittle(output, at, constant.bits, cast(s32)type.size)
        return true
    }
    if constant.bytes_count != type.size { return false }
    for index: cast(s64)0..constant.bytes_count - 1 {
        output[at + index] = program.data[constant.bytes_begin + index]
    }
    return true
}

Write :: (program: MachineProgram, image: MachineX64Image, layout: Layout, output: []u8, fuel: s64) -> bool {
    for index: cast(s64)0..output.count - 1 { output[index] = 0 }

    // ELF64 little-endian ET_EXEC, x86-64, two program headers, no sections.
    Put8(output, 0, 0x7f); Put8(output, 1, 69); Put8(output, 2, 76); Put8(output, 3, 70)
    Put8(output, 4, 2); Put8(output, 5, 1); Put8(output, 6, 1)
    PutLittle(output, 16, 2, 2); PutLittle(output, 18, 62, 2); PutLittle(output, 20, 1, 4)
    PutLittle(output, 24, cast(u64)(MachineElfBase + MachineElfTextOffset), 8)
    PutLittle(output, 32, MachineElfHeaderSize, 8)
    PutLittle(output, 52, MachineElfHeaderSize, 2)
    PutLittle(output, 54, MachineElfProgramHeaderSize, 2)
    PutLittle(output, 56, MachineElfProgramHeaders, 2)

    // RX PT_LOAD includes the headers and text but ends before the RW page.
    ph := cast(s64)MachineElfHeaderSize
    PutLittle(output, ph, 1, 4); PutLittle(output, ph + 4, 5, 4)
    PutLittle(output, ph + 16, MachineElfBase, 8); PutLittle(output, ph + 24, MachineElfBase, 8)
    PutLittle(output, ph + 32, cast(u64)(MachineElfTextOffset + layout.text_size), 8)
    PutLittle(output, ph + 40, cast(u64)(MachineElfTextOffset + layout.text_size), 8)
    PutLittle(output, ph + 48, MachineElfPage, 8)

    // RW PT_LOAD is congruent to its file offset and is never executable.
    ph += MachineElfProgramHeaderSize
    PutLittle(output, ph, 1, 4); PutLittle(output, ph + 4, 6, 4)
    PutLittle(output, ph + 8, cast(u64)layout.data_offset, 8)
    PutLittle(output, ph + 16, cast(u64)(MachineElfBase + layout.data_offset), 8)
    PutLittle(output, ph + 24, cast(u64)(MachineElfBase + layout.data_offset), 8)
    PutLittle(output, ph + 32, cast(u64)layout.data.size, 8)
    PutLittle(output, ph + 40, cast(u64)layout.data.memory, 8)
    PutLittle(output, ph + 48, MachineElfPage, 8)

    // _start: set the stack limit (mov rax, rsp; sub rax, MachineElfStackBytes;
    // mov [rip + limit], rax), call startup initializers in order, then machine
    // entry; move (or clear) status; the runtime's exit.
    start := cast(s64)MachineElfTextOffset
    Put8(output, start, 0x48); Put8(output, start + 1, 0x89); Put8(output, start + 2, 0xe0)
    Put8(output, start + 3, 0x48); Put8(output, start + 4, 0x2d)
    PutLittle(output, start + 5, MachineElfStackBytes, 4)
    Put8(output, start + 9, 0x48); Put8(output, start + 10, 0x89); Put8(output, start + 11, 0x05)
    stack_limit := cast(u64)(MachineElfBase + layout.data_offset + layout.data.stack_limit)
    if !PutRelative(output, start + 12, stack_limit, -4, cast(u64)(MachineElfBase + start + 12)) { return false }
    startup_at := start + 16
    for initializer: program.initializers {
        Put8(output, startup_at, 0xe8)
        initializer_target := cast(u64)(MachineElfBase + MachineElfTextOffset + layout.startup_size +
            image.functions[initializer].begin)
        if !PutRelative(output, startup_at + 1, initializer_target, -4,
            cast(u64)(MachineElfBase + startup_at + 1)) { return false }
        startup_at += 5
    }
    Put8(output, startup_at, 0xe8)
    entry_target := cast(u64)(MachineElfBase + MachineElfTextOffset + layout.startup_size +
        image.functions[program.entry].begin)
    if !PutRelative(output, startup_at + 1, entry_target, -4,
        cast(u64)(MachineElfBase + startup_at + 1)) { return false }
    result_type := program.types[program.functions[program.entry].result_type]
    if result_type.kind == .Void { Put8(output, startup_at + 5, 0x31); Put8(output, startup_at + 6, 0xff) }
    else { Put8(output, startup_at + 5, 0x89); Put8(output, startup_at + 6, 0xc7) }
    exit_address := cast(u64)(MachineElfBase + layout.routines.exit)
    Put8(output, startup_at + 7, 0xe9)
    if !PutRelative(output, startup_at + 8, exit_address, -4, cast(u64)(MachineElfBase + startup_at + 8)) { return false }

    code_at := start + layout.startup_size
    for index: cast(s64)0..image.code.count - 1 { output[code_at + index] = image.code[index] }

    // trap_handler: store edi, then the runtime's exit with status 125.
    trap := start + layout.trap_text
    Put8(output, trap, 0x89); Put8(output, trap + 1, 0x3d)
    trap_status := cast(u64)(MachineElfBase + layout.data_offset + layout.data.trap_status)
    if !PutRelative(output, trap + 2, trap_status, -4, cast(u64)(MachineElfBase + trap + 2)) { return false }
    Put8(output, trap + 6, 0xbf); PutLittle(output, trap + 7, MachineElfTrapExitStatus, 4)
    Put8(output, trap + 11, 0xe9)
    if !PutRelative(output, trap + 12, exit_address, -4, cast(u64)(MachineElfBase + trap + 12)) { return false }

    float := false
    routines: MachineX64RuntimeEntries
    if !MachineX64RuntimeEmit(output, start + layout.routines_text, RuntimeUses(program, image, *float),
        RuntimePlaces(layout), *routines) || routines.end != layout.routines.end { return false }
    if float {
        // The formatter's one write is a rel32 call to stdout_bytes.
        float_at := start + layout.float_text
        WriteFloatRuntime(output, float_at)
        field := float_at + MachineElfFloatWriteField
        if !PutRelative(output, field, cast(u64)(MachineElfBase + routines.stdout_bytes), -4,
            cast(u64)(MachineElfBase + field)) { return false }
    }

    for relocation: image.relocations {
        target: u64 = 0
        if relocation.kind == .GlobalAddress || relocation.kind == .ConstantAddress {
            readonly := relocation.kind == .ConstantAddress
            global_offset: s64 = 0
            if !GlobalOffset(program, relocation.symbol, !readonly, *global_offset) { return false }
            if readonly {
                target = cast(u64)(MachineElfBase + MachineElfTextOffset +
                    layout.constants_text + global_offset)
            } else { target = cast(u64)(MachineElfBase + layout.data_offset + global_offset) }
        } else if relocation.kind == .FuelCounter {
            target = cast(u64)(MachineElfBase + layout.data_offset + layout.data.fuel)
        } else if relocation.kind == .TrapHandler {
            target = cast(u64)(MachineElfBase + MachineElfTextOffset + layout.trap_text)
        } else if relocation.kind == .PlatformService {
            service_offset: s64 = 0
            if !PlatformTarget(program, layout, relocation.symbol, *service_offset) { return false }
            target = cast(u64)(MachineElfBase + service_offset)
        } else if relocation.kind == .RuntimeResize {
            target = cast(u64)(MachineElfBase + layout.routines.resize)
        } else if relocation.kind == .StackLimit {
            target = stack_limit
        } else if relocation.kind == .PointerRuntime {
            target = cast(u64)(MachineElfBase + layout.data_offset + layout.data.pointer_header)
        } else { return false }
        field_at := code_at + relocation.offset
        field := cast(u64)(MachineElfBase + field_at)
        if !PutRelative(output, field_at, target, relocation.addend, field) { return false }
    }
    for symbol: cast(s64)0..program.globals.count - 1 {
        global := program.globals[symbol]
        global_offset: s64 = 0
        if !GlobalOffset(program, cast(s32)symbol, global.writable, *global_offset) { return false }
        global_at := layout.data_offset + global_offset
        if !global.writable {
            global_at = MachineElfTextOffset + layout.constants_text + global_offset
        }
        if !WriteGlobal(program, cast(s32)symbol, global_at, output) { return false }
    }
    PutLittle(output, layout.data_offset + layout.data.fuel, cast(u64)fuel, 8)
    // Pointer runtime: an empty free list, the next slot after the globals,
    // the arena, and live entries for slot 0 (empty, at address 0) and each
    // global.
    data_base := cast(u64)(MachineElfBase + layout.data_offset)
    header := layout.data_offset + layout.data.pointer_header
    PutLittle(output, header + MachinePointerHeaderUnused, cast(u64)(program.globals.count + 1), 8)
    PutLittle(output, header + MachinePointerHeaderCapacity, MachinePointerCapacity, 8)
    PutLittle(output, header + MachinePointerHeaderArenaTop, data_base + cast(u64)layout.data.arena, 8)
    PutLittle(output, header + MachinePointerHeaderArenaLimit,
        data_base + cast(u64)(layout.data.arena + MachinePointerArenaBytes), 8)
    PutLittle(output, header + MachinePointerHeaderTable, data_base + cast(u64)layout.data.table, 8)
    table := layout.data_offset + layout.data.table
    PutLittle(output, table + MachinePointerEntryFlags, MachinePointerLive, 2)
    for symbol: cast(s64)0..program.globals.count - 1 {
        global := program.globals[symbol]
        global_offset: s64 = 0
        if !GlobalOffset(program, cast(s32)symbol, global.writable, *global_offset) { return false }
        address := cast(u64)(MachineElfBase + layout.data_offset + global_offset)
        if !global.writable {
            address = cast(u64)(MachineElfBase + MachineElfTextOffset + layout.constants_text + global_offset)
        }
        entry := table + (symbol + 1) * MachinePointerEntryBytes
        PutLittle(output, entry + MachinePointerEntryBase, address, 8)
        PutLittle(output, entry + MachinePointerEntrySize, cast(u64)program.types[global.type].size, 8)
        PutLittle(output, entry + MachinePointerEntryFlags,
            ifx global.writable then cast(u64)(MachinePointerLive | MachinePointerWritable) else MachinePointerLive, 2)
    }
    return true
}

#scope_export

// Bytes of the process entry stub before the encoded text.
MachineElfStartupBytes :: (program: MachineProgram) -> s64 { return StartupSize(program) }

// Empty OUTPUT measures. A non-empty OUTPUT must have exactly the measured
// length. Verification, complete relocation resolution and i32 range checks
// all finish before the first output byte is changed.
MachineElfEncode :: (program: MachineProgram, encoded: MachineX64Image, output: []u8,
    fuel: s64 = MachineElfInitialFuel) -> MachineElfResult {
    if fuel < 0 { return Failure(.Fuel) }
    layout: Layout
    diagnostic := ImageLayout(program, encoded, *layout)
    if diagnostic.problem != .None { return .{diagnostic = diagnostic} }
    result := MachineElfResult.{diagnostic = NoDiagnostic(), size = layout.file_size,
        text_offset = MachineElfTextOffset, text_size = layout.text_size,
        data_offset = layout.data_offset, data_size = layout.data.size,
        fuel_offset = layout.data_offset + layout.data.fuel,
        trap_status_offset = layout.data_offset + layout.data.trap_status,
        pointer_offset = layout.data_offset + layout.data.pointer_header}
    if output.count == 0 { return result }
    if output.count != layout.file_size { return Failure(.Limit) }
    if !Write(program, encoded, layout, output, fuel) { return Failure(.Relocation) }
    return result
}
