using Image :: #import "compiler_machine_image"
using Target :: #import "compiler_target"
using Vectors :: #import "std/vec"

MachineVersion :: 4
MachineNoId :: -1

MachineRegisterClass :: enum s32 {
    Invalid; General; Float; Vector; Flags; Stack
}

MachineOperandKind :: enum s32 {
    Invalid; Virtual; Physical; Immediate; Block; Function; StackObject; Global
}

MachineOperandRole :: enum s32 { Invalid; Use; Define; UseDefine }

// A program starts in the Virtual stage. RegAllocAllocate publishes the
// Allocated stage: no Virtual operands, resolved edge copies, one frame per
// function and explicit spill/reload records.
MachineStage :: enum s32 { Virtual; Allocated }

MachineOpcode :: enum s32 {
    Invalid
    Move; MoveImmediate; Allocate; StackAddress; GlobalAddress; FunctionAddress
    IntegerAdd; IntegerSubtract; IntegerMultiply; IntegerDivide; IntegerRemainder
    IntegerNegate; IntegerAnd; IntegerOr; IntegerXor; IntegerNot
    ShiftLeft; ShiftRight
    FloatAdd; FloatSubtract; FloatMultiply; FloatDivide; FloatNegate
    Compare; SetCondition; Convert; Bitcast
    AggregateBuild; AggregateExtract; AggregateInsert
    Load; Store; Copy; Zero; FieldAddress; ElementAddress; BytesEqual; Resize
    CallDirect; CallIndirect
    Fuel; Trap; Jump; Branch; Return; Unreachable
    // Checked pointers (see compiler_machine_image MachinePointer*): a data
    // pointer is a token naming a slot of the instance's pointer table.
    //   PointerResolve raw, token, width, flags: the address WIDTH bytes may
    //     be read (or written, flag 1) at, or the bounds trap.
    //   PointerCreate token, raw, size, flags: a new slot for SIZE bytes at
    //     RAW, linked into the frame's chain unless it is heap storage.
    //   ArenaAllocate raw, size: fresh frame storage, released at return.
    PointerResolve; PointerCreate; ArenaAllocate
    // Allocator-inserted, flag-preserving transfers. Spill stores a register
    // into a stack object; Reload loads one into a register.
    Spill; Reload
    //   PointerDirect raw, token, base, width, flags: raw = base + the
    //     token's byte offset, with no runtime check. BASE is the raw start of
    //     the token's root (a GlobalAddress, or the ArenaAllocate behind the
    //     PointerCreate it derives from); MachineVerify re-derives that root
    //     and accepts the instruction only where it covers the slot, version,
    //     liveness, WIDTH bytes and, for flag 1, writability.
    PointerDirect
}

MachineCondition :: enum s32 {
    None; Equal; NotEqual; Less; LessEqual; Greater; GreaterEqual
}

MachineStackKind :: enum s32 {
    Invalid; Value; Local; IncomingArgument; OutgoingArgument; Spill
    // Allocation frame storage: the hidden destination pointer for aggregate
    // returns, callee-saved register homes and parallel-copy temporaries.
    ResultAddress; CalleeSave; Temporary
}

MachineSpillReason :: enum s32 { Invalid; Pressure; Call; Fixed; Parameter; Cycle }

// Internal is ordinary generated code. Host and Platform are the only
// external call contracts accepted by the native path; C/System remain named
// so verification can reject them explicitly instead of changing backends.
MachineCalling :: enum s32 { Invalid; Internal; C; System; Host; Platform }

MachineOperand :: struct {
    kind: MachineOperandKind
    role: MachineOperandRole
    class: MachineRegisterClass
    id: s32
    type: s32
    fixed_register: s32
    tied_to: s32
    immediate: u64
    // The SSA virtual this operand reads or writes, or MachineNoId. Allocation
    // keeps it on the physical and stack-object operands that replace a
    // virtual so the allocated verifier can check every value location.
    value: s32
}

MachineInstruction :: struct {
    opcode: MachineOpcode
    operand_begin: s32
    operand_count: s32
    edge_begin: s32
    edge_count: s32
    flags_use: s32
    flags_def: s32
    call: s32
    condition: MachineCondition
    origin: s32
}

MachineVirtual :: struct {
    class: MachineRegisterClass
    type: s32
    fixed_register: s32
    stack_object: s32
    origin: s32
}

MachineCopy :: struct {
    destination: s32
    source: s32
    class: MachineRegisterClass
}

MachineEdge :: struct {
    target: s32
    copy_begin: s32
    copy_count: s32
}

MachineStackObject :: struct {
    function: s32
    kind: MachineStackKind
    size: s64
    alignment: s32
    type: s32
    origin: s32
    // Allocated stage: IncomingArgument offsets are from the frame pointer
    // (at least 16), OutgoingArgument offsets are from the stack pointer at
    // the call (0), and every other object is at a negative frame-pointer
    // offset inside the frame.
    offset: s64
    // Spill: the virtual it holds. CalleeSave: the saved physical register.
    value: s32
}

// One frame per function in the Allocated stage. The frame pointer is pushed
// on entry; `size` bytes below it hold callee-save homes, values, spills and
// temporaries, with `outgoing_size` bytes of stack arguments at the bottom.
MachineFrame :: struct {
    function: s32
    size: s64
    alignment: s32
    outgoing_size: s64
    incoming_size: s64
    callee_saved_general: u64
    callee_saved_float: u64
    dynamic_allocation: bool
}

// Every Spill and Reload instruction with the value, slot, register, reason
// and nearest source origin that caused it.
MachineSpill :: struct {
    function: s32
    instruction: s32
    virtual: s32
    stack_object: s32
    register: s32
    reason: MachineSpillReason
    origin: s32
}

MachineCall :: struct {
    instruction: s32
    calling: MachineCalling
    argument_begin: s32
    argument_count: s32
    result_operand: s32
    stack_argument_bytes: s64
    clobber_general: u64
    clobber_float: u64
    clobber_vector: u64
    indirect: bool
}

MachineGlobal :: struct {
    type: s32
    constant: s32
    writable: bool
}

MachineConstant :: struct {
    type: s32
    bits: u64
    bytes_begin: s32
    bytes_count: s32
}

MachineBlock :: struct {
    function: s32
    lir_block: s32
    instruction_begin: s32
    instruction_count: s32
}

MachineFunction :: struct {
    lir_function: s32
    name_offset: s32
    name_length: s32
    block_begin: s32
    block_count: s32
    virtual_begin: s32
    virtual_count: s32
    stack_begin: s32
    stack_count: s32
    parameter_count: s32
    result_type: s32
    calling: MachineCalling
    entry: s32
    origin: s32
    // Frame words of a function with checked frame storage, each one more
    // than its stack object's index from stack_begin, which allocation keeps
    // (0 without frame storage): the frame arena's top at entry and the head
    // of the function's pointer slot chain.
    arena_mark: s32
    pointer_chain: s32
    // A function that loops keeps its step budget in the target's fuel
    // register (MachineAbiFuelRegister) instead of the instance counter,
    // writing it back wherever another function or the host may read it.
    fuel_register: bool
}

MachineOrigin :: struct {
    file: s32
    line: s32
    column: s32
    end_line: s32
    end_column: s32
    begin: s64
    end: s64
    parent: s32
}

MachineSource :: struct { text_offset: s32; text_length: s32 }

MachineTypeKind :: enum s32 {
    Invalid; Void; Bool; Integer; Float; Pointer; Array; Record; Function
}

MachineType :: struct {
    kind: MachineTypeKind
    class: MachineRegisterClass
    bits: s32
    is_signed: bool
    native_width: bool
    size: s64
    alignment: s32
    element: s32
    count: s64
    fields_begin: s32
    fields_count: s32
    parameters_begin: s32
    parameters_count: s32
    result: s32
}

MachineProgram :: struct {
    version: s32
    target: TargetDescription
    text: []u8
    sources: []MachineSource
    origins: []MachineOrigin
    types: []MachineType
    type_ids: []s32
    data: []u8
    constants: []MachineConstant
    globals: []MachineGlobal
    initializers: []s32
    functions: []MachineFunction
    blocks: []MachineBlock
    virtuals: []MachineVirtual
    instructions: []MachineInstruction
    operands: []MachineOperand
    edges: []MachineEdge
    copies: []MachineCopy
    stack_objects: []MachineStackObject
    relocations: []MachineRelocation
    calls: []MachineCall
    entry: s32
    stage: MachineStage
    frames: []MachineFrame
    spills: []MachineSpill
    // Allocated stage: registers reserved for transfers through memory.
    scratch_general: s32
    scratch_float: s32
    // Built with --checks: data pointers are tokens checked at every access.
    // Otherwise a pointer is the address, as in C.
    checks: bool
    // An AOT executable, which owns its process: built without checks, its
    // deep recursion faults on the guard page as C's does.
    executable: bool
}

MachineLimits :: struct {
    work: s64
    bytes: s64
    functions: s64
    types: s64
    type_ids: s64
    constants: s64
    globals: s64
    blocks: s64
    virtuals: s64
    instructions: s64
    operands: s64
    edges: s64
    copies: s64
    stack_objects: s64
    relocations: s64
    calls: s64
}

MachineProblem :: enum s32 {
    None; Owner; Target; UnsupportedTarget; VerifyInput; Limit; Allocation
    Version; Source; Origin; Function; Block; Virtual; Instruction; Operand
    Constraint; Flags; Call; Stack; Edge; Copy; Relocation; NativeWidth; Unsupported
    // Allocation and allocated-program failures.
    Stage; Fuel; Undefined; Interference; Clobber; Tie; Frame; Pressure; Cycle; Spill
    // A memory access whose address is neither a checked resolve nor a
    // PointerDirect the verifier proves safe.
    Unchecked
    // A host capability an executable imports whose parameters or result
    // the C ABI veneer cannot carry; the diagnostic names its function.
    HostAbi
}

MachineDiagnostic :: struct {
    problem: MachineProblem
    function: s32
    block: s32
    instruction: s32
    operand: s32
    virtual: s32
}

MachineOptions :: struct {
    preserve_origins: bool
    // Whether code charges fuel; an AOT executable with an unbounded budget
    // never runs out, so it carries no fuel checks.
    fuel: bool
    // An AOT executable rather than code loaded into a host process.
    executable: bool
}

MachineResult :: struct {
    problem: MachineProblem
    diagnostic: MachineDiagnostic
    lir_diagnostic_problem: s32
    work: s64
    bytes: s64
}

MachineOwner :: struct {
    valid: bool
    program: MachineProgram
    text: Vec(u8)
    sources: Vec(MachineSource)
    origins: Vec(MachineOrigin)
    types: Vec(MachineType)
    type_ids: Vec(s32)
    data: Vec(u8)
    constants: Vec(MachineConstant)
    globals: Vec(MachineGlobal)
    initializers: Vec(s32)
    functions: Vec(MachineFunction)
    blocks: Vec(MachineBlock)
    virtuals: Vec(MachineVirtual)
    instructions: Vec(MachineInstruction)
    operands: Vec(MachineOperand)
    edges: Vec(MachineEdge)
    copies: Vec(MachineCopy)
    stack_objects: Vec(MachineStackObject)
    relocations: Vec(MachineRelocation)
    calls: Vec(MachineCall)
    frames: Vec(MachineFrame)
    spills: Vec(MachineSpill)
}

#scope_export

// Work is charged per instruction, operand and live interval visited by
// lowering, allocation and encoding; the default admits a program at the
// LIR instruction limit. The table limits bound the program itself.
MachineDefaultLimits :: () -> MachineLimits {
    return .{.work = 4000000000, .bytes = 268435456, .functions = 65536, .types = 65536,
        .type_ids = 1048576, .constants = 1048576, .globals = 1048576,
        .blocks = 262144, .virtuals = 1048576, .instructions = 2097152,
        .operands = 8388608, .edges = 524288, .copies = 2097152,
        .stack_objects = 1048576, .relocations = 1048576, .calls = 1048576}
}

MachineDefaultOptions :: () -> MachineOptions {
    return .{preserve_origins = true, fuel = true}
}

// PROGRAM's relocations by instruction: the first of each instruction's, and
// after each the next of the same instruction, in program order, so a lookup
// scans only one instruction's relocations.
MachineRelocationIndex :: struct {
    first: Vec(s32)
    next: Vec(s32)
}

MachineRelocationIndexBuild :: (index: *MachineRelocationIndex, program: MachineProgram, bytes: s64) -> bool {
    if !VecResizeBounded(index.first, program.instructions.count, bytes) ||
        !VecResizeBounded(index.next, program.relocations.count, bytes) { return false }
    for at: cast(s64)0..index.first.count - 1 { index.first[at] = MachineNoId }
    at := program.relocations.count - 1
    while at >= 0 {
        instruction := program.relocations[at].instruction
        index.next[at] = MachineNoId
        if instruction >= 0 && instruction < program.instructions.count {
            index.next[at] = index.first[instruction]
            index.first[instruction] = cast(s32)at
        }
        at -= 1
    }
    return true
}

MachineRelocationIndexFree :: (index: *MachineRelocationIndex) {
    VecFree(index.first)
    VecFree(index.next)
}

// Whether a relocation of KIND is the symbol reference CALL's instruction
// carries: its host capability, platform service or direct callee.
MachineCallReference :: (call: MachineCall, kind: MachineRelocationKind) -> bool {
    return call.calling == .Host && kind == .HostCapability ||
        call.calling == .Platform && kind == .PlatformService ||
        call.calling == .Internal && !call.indirect && kind == .FunctionCall
}

// Counts each call's symbol references among PROGRAM's relocations into
// REFERENCES in one pass; false when the counts would exceed BYTES.
MachineCallReferences :: (program: MachineProgram, references: *Vec(s32), bytes: s64) -> bool {
    if !VecResizeBounded(<<references, program.calls.count, bytes) { return false }
    for at: cast(s64)0..program.calls.count - 1 { (<<references)[at] = 0 }
    for relocation: program.relocations {
        if relocation.instruction < 0 || relocation.instruction >= program.instructions.count { continue }
        call := program.instructions[relocation.instruction].call
        if call < 0 || call >= program.calls.count || program.calls[call].instruction != relocation.instruction ||
            !MachineCallReference(program.calls[call], relocation.kind) { continue }
        (<<references)[call] += 1
    }
    return true
}
