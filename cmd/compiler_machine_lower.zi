using Vectorizer :: #import "compiler_vectorize"
using VectorForm :: #import "compiler_vector_form"
using ABI :: #import "compiler_abi"
using Aggregates :: #import "compiler_machine_aggregate"
using Fields :: #import "compiler_machine_fields"
using Lir :: #import "compiler_lowered_ir"
using LirVerifyModule :: #import "compiler_lowered_verify"
using Image :: #import "compiler_machine_image"
using Machine :: #import "compiler_machine_ir"
using MachineVerifyModule :: #import "compiler_machine_verify"
using Select :: #import "compiler_machine_select"
using Proven :: #import "compiler_lowered_proven"
using Target :: #import "compiler_target"
using Vectors :: #import "std/vec"

#scope_file

LowerState :: struct {
    owner: *MachineOwner
    lir: LirProgram
    target: TargetDescription
    options: MachineOptions
    limits: MachineLimits
    problem: MachineProblem
    diagnostic: MachineDiagnostic
    lir_diagnostic_problem: s32
    remaining: s64
    used: s64
    bytes: s64
    // A --checks program: checked pointers and every bounds check.
    checks: bool
    // The shared LIR facts, and per value of the function being lowered the
    // raw-storage virtual of its `allocate`, or MachineNoId.
    proven: *LirProvenOwner
    frame_raw: *Vec(s32)
    aggregates: *AggregateLowering
    fields: *MachineFieldsPlan
    // The selection plan of the function being lowered (see
    // compiler_machine_select), the LIR block and instruction number being
    // lowered, and the flags and condition of a compare whose branch follows.
    select: *MachineSelectPlan
    select_block: s32
    select_at: s64
    fused_flags: s32
    fused_condition: MachineCondition
    vector_header: s32
    vector_iv: s32
    vector_acc: s32
    vector_iv_out: s32
    vector_acc_out: s32
}

// The aggregate plan of the function being lowered (see
// compiler_machine_aggregate), the virtual holding each view's address, and
// per type its size when stack-class (else -1) and the pointer type made to it.
AggregateLowering :: struct {
    plan: MachineAggregatePlan
    view_address: Vec(s32)
    // Per value of a split record, where its field virtuals start in fields;
    // per value, the field virtual an extract of a split record stands for.
    field_begin: Vec(s32)
    fields: Vec(s32)
    alias: Vec(s32)
    stack_size: Vec(s64)
    size: Vec(s64)
    pointer_to: Vec(s32)
}

AggregateLoweringFree :: (lowering: *AggregateLowering) {
    MachineAggregatePlanFree(*lowering.plan)
    VecFree(lowering.view_address)
    VecFree(lowering.field_begin)
    VecFree(lowering.fields)
    VecFree(lowering.alias)
    VecFree(lowering.stack_size)
    VecFree(lowering.size)
    VecFree(lowering.pointer_to)
}

EmptyDiagnostic :: () -> MachineDiagnostic {
    return .{problem = .None, function = MachineNoId, block = MachineNoId,
        instruction = MachineNoId, operand = MachineNoId, virtual = MachineNoId}
}

Fail :: (state: *LowerState, problem: MachineProblem) -> bool {
    if state.problem == .None { state.problem = problem }
    return false
}

Spend :: (state: *LowerState, count: s64) -> bool {
    if count < 0 || count > state.remaining { return Fail(state, .Limit) }
    state.remaining -= count
    state.used += count
    return true
}

Reserve :: (state: *LowerState, count: s64, width: s64, limit: s64) -> bool {
    if count < 0 || width < 1 || count > limit || state.bytes > state.limits.bytes ||
        count > (state.limits.bytes - state.bytes) / width { return Fail(state, .Limit) }
    state.bytes += count * width
    return true
}

Text :: (state: *LowerState, text: string) -> s32 {
    if text.count < 0 || state.owner.text.count > 2147483647 - text.count ||
        !Reserve(state, text.count, 1, state.limits.bytes) { return MachineNoId }
    offset := cast(s32)state.owner.text.count
    for byte: text {
        if !VecPush(state.owner.text, byte) { Fail(state, .Allocation); return MachineNoId }
    }
    return offset
}

Alignment :: (size: s64) -> s32 {
    if size >= 8 { return 8 }
    if size >= 4 { return 4 }
    if size >= 2 { return 2 }
    return 1
}

AddType :: (state: *LowerState, type: MachineType) -> s32 {
    if state.owner.types.count >= state.limits.types { Fail(state, .Limit); return MachineNoId }
    if !Reserve(state, 1, size_of(MachineType), state.limits.types) { return MachineNoId }
    index := cast(s32)state.owner.types.count
    if !VecPush(state.owner.types, type) { Fail(state, .Allocation); return MachineNoId }
    return index
}

AddTypeId :: (state: *LowerState, id: s32) -> bool {
    if state.owner.type_ids.count >= state.limits.type_ids { return Fail(state, .Limit) }
    if !Reserve(state, 1, size_of(s32), state.limits.type_ids) { return false }
    if !VecPush(state.owner.type_ids, id) { return Fail(state, .Allocation) }
    return true
}

AddGlobal :: (state: *LowerState, global: MachineGlobal) -> bool {
    if state.owner.globals.count >= state.limits.globals { return Fail(state, .Limit) }
    if !Reserve(state, 1, size_of(MachineGlobal), state.limits.globals) { return false }
    if !VecPush(state.owner.globals, global) { return Fail(state, .Allocation) }
    return true
}

AddData :: (state: *LowerState, bytes: []u8) -> s32 {
    if bytes.count < 0 || state.owner.data.count > 2147483647 - bytes.count ||
        !Reserve(state, bytes.count, 1, state.limits.bytes) { return MachineNoId }
    begin := cast(s32)state.owner.data.count
    for byte: bytes {
        if !VecPush(state.owner.data, byte) { Fail(state, .Allocation); return MachineNoId }
    }
    return begin
}

AddConstant :: (state: *LowerState, constant: MachineConstant) -> bool {
    if state.owner.constants.count >= state.limits.constants { return Fail(state, .Limit) }
    if !Reserve(state, 1, size_of(MachineConstant), state.limits.constants) { return false }
    if !VecPush(state.owner.constants, constant) { return Fail(state, .Allocation) }
    return true
}

AddFunction :: (state: *LowerState, function: MachineFunction) -> s32 {
    if state.owner.functions.count >= state.limits.functions { Fail(state, .Limit); return MachineNoId }
    if !Reserve(state, 1, size_of(MachineFunction), state.limits.functions) { return MachineNoId }
    index := cast(s32)state.owner.functions.count
    if !VecPush(state.owner.functions, function) { Fail(state, .Allocation); return MachineNoId }
    return index
}

AddBlock :: (state: *LowerState, block: MachineBlock) -> s32 {
    if state.owner.blocks.count >= state.limits.blocks { Fail(state, .Limit); return MachineNoId }
    if !Reserve(state, 1, size_of(MachineBlock), state.limits.blocks) { return MachineNoId }
    index := cast(s32)state.owner.blocks.count
    if !VecPush(state.owner.blocks, block) { Fail(state, .Allocation); return MachineNoId }
    return index
}

AddVirtual :: (state: *LowerState, value: MachineVirtual) -> s32 {
    if state.owner.virtuals.count >= state.limits.virtuals { Fail(state, .Limit); return MachineNoId }
    if !Reserve(state, 1, size_of(MachineVirtual), state.limits.virtuals) { return MachineNoId }
    index := cast(s32)state.owner.virtuals.count
    if !VecPush(state.owner.virtuals, value) { Fail(state, .Allocation); return MachineNoId }
    return index
}

AddStack :: (state: *LowerState, object: MachineStackObject) -> s32 {
    if state.owner.stack_objects.count >= state.limits.stack_objects { Fail(state, .Limit); return MachineNoId }
    if !Reserve(state, 1, size_of(MachineStackObject), state.limits.stack_objects) { return MachineNoId }
    index := cast(s32)state.owner.stack_objects.count
    if !VecPush(state.owner.stack_objects, object) { Fail(state, .Allocation); return MachineNoId }
    return index
}

AddOperand :: (state: *LowerState, operand: MachineOperand) -> s32 {
    if state.owner.operands.count >= state.limits.operands { Fail(state, .Limit); return MachineNoId }
    if !Reserve(state, 1, size_of(MachineOperand), state.limits.operands) { return MachineNoId }
    index := cast(s32)state.owner.operands.count
    if !VecPush(state.owner.operands, operand) { Fail(state, .Allocation); return MachineNoId }
    return index
}

AddInstruction :: (state: *LowerState, instruction: MachineInstruction) -> s32 {
    if state.owner.instructions.count >= state.limits.instructions { Fail(state, .Limit); return MachineNoId }
    if !Reserve(state, 1, size_of(MachineInstruction), state.limits.instructions) { return MachineNoId }
    index := cast(s32)state.owner.instructions.count
    if !VecPush(state.owner.instructions, instruction) { Fail(state, .Allocation); return MachineNoId }
    return index
}

AddCopy :: (state: *LowerState, copy: MachineCopy) -> s32 {
    if state.owner.copies.count >= state.limits.copies { Fail(state, .Limit); return MachineNoId }
    if !Reserve(state, 1, size_of(MachineCopy), state.limits.copies) { return MachineNoId }
    index := cast(s32)state.owner.copies.count
    if !VecPush(state.owner.copies, copy) { Fail(state, .Allocation); return MachineNoId }
    return index
}

AddEdge :: (state: *LowerState, edge: MachineEdge) -> s32 {
    if state.owner.edges.count >= state.limits.edges { Fail(state, .Limit); return MachineNoId }
    if !Reserve(state, 1, size_of(MachineEdge), state.limits.edges) { return MachineNoId }
    index := cast(s32)state.owner.edges.count
    if !VecPush(state.owner.edges, edge) { Fail(state, .Allocation); return MachineNoId }
    return index
}

AddRelocation :: (state: *LowerState, relocation: MachineRelocation) -> bool {
    if state.owner.relocations.count >= state.limits.relocations { return Fail(state, .Limit) }
    if !Reserve(state, 1, size_of(MachineRelocation), state.limits.relocations) { return false }
    if !VecPush(state.owner.relocations, relocation) { return Fail(state, .Allocation) }
    return true
}

AddCall :: (state: *LowerState, call: MachineCall) -> s32 {
    if state.owner.calls.count >= state.limits.calls { Fail(state, .Limit); return MachineNoId }
    if !Reserve(state, 1, size_of(MachineCall), state.limits.calls) { return MachineNoId }
    index := cast(s32)state.owner.calls.count
    if !VecPush(state.owner.calls, call) { Fail(state, .Allocation); return MachineNoId }
    return index
}

Origin :: (state: *LowerState, origin: s32) -> s32 {
    if !state.options.preserve_origins { return MachineNoId }
    return origin
}

VirtualOperand :: (state: *LowerState, id: s32, role: MachineOperandRole,
    fixed: s32 = MachineNoId, tied: s32 = MachineNoId) -> s32 {
    if id < 0 || id >= state.owner.virtuals.count { Fail(state, .Virtual); return MachineNoId }
    value := state.owner.virtuals[id]
    return AddOperand(state, .{kind = .Virtual, role = role, class = value.class, id = id,
        type = value.type, fixed_register = fixed, tied_to = tied, value = id})
}

ImmediateOperand :: (state: *LowerState, value: u64, class: MachineRegisterClass = .General) -> s32 {
    return AddOperand(state, .{kind = .Immediate, role = .Use, class = class,
        id = MachineNoId, type = MachineNoId, fixed_register = MachineNoId,
        tied_to = MachineNoId, immediate = value, value = MachineNoId})
}

SymbolOperand :: (state: *LowerState, kind: MachineOperandKind, symbol: s32) -> s32 {
    return AddOperand(state, .{kind = kind, role = .Use, class = .General, id = symbol,
        type = MachineNoId, fixed_register = MachineNoId, tied_to = MachineNoId, value = MachineNoId})
}

StackOperand :: (state: *LowerState, object: s32) -> s32 {
    return AddOperand(state, .{kind = .StackObject, role = .Use, class = .Stack, id = object,
        type = state.owner.stack_objects[object].type, fixed_register = MachineNoId,
        tied_to = MachineNoId, value = MachineNoId})
}

PhysicalOperand :: (state: *LowerState, physical: s32, role: MachineOperandRole,
    class: MachineRegisterClass = .General) -> s32 {
    return AddOperand(state, .{kind = .Physical, role = role, class = class, id = physical,
        type = MachineNoId, fixed_register = physical, tied_to = MachineNoId, value = MachineNoId})
}

BeginInstruction :: (state: *LowerState, opcode: MachineOpcode, origin: s32) -> MachineInstruction {
    return .{opcode = opcode, operand_begin = cast(s32)state.owner.operands.count,
        edge_begin = cast(s32)state.owner.edges.count, flags_use = MachineNoId,
        flags_def = MachineNoId, call = MachineNoId, origin = Origin(state, origin)}
}

FinishInstruction :: (state: *LowerState, instruction: MachineInstruction) -> s32 {
    instruction.operand_count = cast(s32)state.owner.operands.count - instruction.operand_begin
    instruction.edge_count = cast(s32)state.owner.edges.count - instruction.edge_begin
    return AddInstruction(state, instruction)
}

AddSource :: (state: *LowerState, source: MachineSource) -> bool {
    if !Reserve(state, 1, size_of(MachineSource), 2147483647) { return false }
    if !VecPush(state.owner.sources, source) { return Fail(state, .Allocation) }
    return true
}

AddOrigin :: (state: *LowerState, origin: MachineOrigin) -> bool {
    if !Reserve(state, 1, size_of(MachineOrigin), 2147483647) { return false }
    if !VecPush(state.owner.origins, origin) { return Fail(state, .Allocation) }
    return true
}

CopyMetadata :: (state: *LowerState) -> bool {
    if !state.options.preserve_origins { return true }
    for source: state.lir.sources {
        if !Spend(state, 1) { return false }
        offset := Text(state, source)
        if state.problem != .None || !AddSource(state, .{text_offset = offset,
            text_length = cast(s32)source.count}) { return false }
    }
    for source: state.lir.origins {
        if !Spend(state, 1) || !AddOrigin(state, .{file = source.file, line = source.line,
            column = source.column, end_line = source.end_line, end_column = source.end_column,
            begin = source.begin, end = source.end, parent = source.parent}) { return false }
    }
    return true
}

TypeKind :: (kind: LirTypeKind) -> MachineTypeKind {
    if kind == .Void { return .Void }
    if kind == .Bool { return .Bool }
    if kind == .Integer { return .Integer }
    if kind == .Float { return .Float }
    if kind == .Pointer { return .Pointer }
    if kind == .Array { return .Array }
    if kind == .Record { return .Record }
    if kind == .Function { return .Function }
    return .Invalid
}

CopyTypes :: (state: *LowerState) -> bool {
    for type_id: cast(s64)0..state.lir.types.count - 1 {
        if !Spend(state, 1) { return false }
        source := state.lir.types[type_id]
        kind := TypeKind(source.kind)
        class := MachineAbiClass(state.lir, cast(s32)type_id)
        if source.kind == .Void { class = .Stack }
        size := MachineAbiTypeSize(state.lir, cast(s32)type_id)
        if kind == .Invalid || class == .Invalid || size < 0 { return Fail(state, .Unsupported) }
        fields_begin := cast(s32)state.owner.type_ids.count
        for field: source.fields { if !AddTypeId(state, field) { return false } }
        parameters_begin := cast(s32)state.owner.type_ids.count
        for parameter: source.parameters { if !AddTypeId(state, parameter) { return false } }
        type := MachineType.{.kind = kind, .class = class, .bits = source.bits,
            .is_signed = source.is_signed, .native_width = source.native_width,
            .size = size, .alignment = Alignment(size),
            .element = ifx source.kind == .Array || source.kind == .Pointer then source.element else MachineNoId,
            .count = source.count, .fields_begin = fields_begin,
            .fields_count = cast(s32)source.fields.count,
            .parameters_begin = parameters_begin,
            .parameters_count = cast(s32)source.parameters.count,
            .result = ifx source.kind == .Function then source.result else MachineNoId}
        if AddType(state, type) != type_id { return false }
    }
    for source: state.lir.constants {
        if !Spend(state, 1) { return false }
        begin := AddData(state, source.bytes)
        if begin == MachineNoId || !AddConstant(state, .{type = source.type, bits = source.bits,
            bytes_begin = begin, bytes_count = cast(s32)source.bytes.count}) { return false }
    }
    for global: state.lir.globals {
        if !Spend(state, 1) || !AddGlobal(state, .{type = global.type,
            constant = global.constant, writable = global.writable}) {
            return false
        }
    }
    for initializer: state.lir.initializers {
        if !Spend(state, 1) || !Reserve(state, 1, size_of(s32), state.limits.functions) ||
            !VecPush(state.owner.initializers, initializer) { return Fail(state, .Allocation) }
    }
    return true
}

FunctionCalling :: (state: *LowerState, source: LirFunction) -> MachineCalling {
    if !source.external { return .Internal }
    if source.module >= 0 && source.module < state.lir.modules.count &&
        state.lir.modules[source.module] == "ziran.platform" { return .Platform }
    return .Host
}

AddFunctionRecords :: (state: *LowerState) -> bool {
    for function_id: cast(s64)0..state.lir.functions.count - 1 {
        if !Spend(state, 1) { return false }
        source := state.lir.functions[function_id]
        offset := Text(state, source.name)
        if state.problem != .None { return false }
        calling := FunctionCalling(state, source)
        function := MachineFunction.{.lir_function = ifx calling == .Internal then cast(s32)function_id else MachineNoId,
            .name_offset = offset, .name_length = cast(s32)source.name.count,
            .parameter_count = cast(s32)source.parameters.count, .result_type = source.result,
            .calling = calling, .entry = MachineNoId,
            .origin = Origin(state, source.origin)}
        if AddFunction(state, function) != function_id { return false }
    }
    return true
}

NewStack :: (state: *LowerState, function: s32, kind: MachineStackKind,
    type: s32, origin: s32 = MachineNoId) -> s32 {
    if type < 0 || type >= state.owner.types.count { Fail(state, .Stack); return MachineNoId }
    machine_type := state.owner.types[type]
    return AddStack(state, .{function = function, kind = kind, size = machine_type.size,
        alignment = machine_type.alignment, type = type, origin = Origin(state, origin)})
}

CreateVirtuals :: (state: *LowerState, function_id: s32) -> bool {
    source := state.lir.functions[function_id]
    function := state.owner.functions[function_id]
    function.virtual_begin = cast(s32)state.owner.virtuals.count
    function.stack_begin = cast(s32)state.owner.stack_objects.count
    plan := *state.aggregates.plan
    for value_id: cast(s64)0..source.values.count - 1 {
        if !Spend(state, 1) { return false }
        type := source.values[value_id]
        class := state.owner.types[type].class
        stack: s32 = MachineNoId
        // A storage class's representative owns its frame object.
        if class == .Stack && plan.slot[value_id] == cast(s32)value_id && plan.storage[value_id] {
            stack = NewStack(state, function_id, .Value, type)
            if stack == MachineNoId { return false }
        }
        if AddVirtual(state, .{class = class, type = type, fixed_register = MachineNoId,
            stack_object = stack, origin = MachineNoId}) == MachineNoId { return false }
    }
    // The rest of a class shares it; a class of views alone names its root's,
    // and a split record, held in its field registers, has none.
    for value_id: cast(s64)0..source.values.count - 1 {
        virtual_id := function.virtual_begin + cast(s32)value_id
        if state.owner.virtuals[virtual_id].class != .Stack ||
            state.owner.virtuals[virtual_id].stack_object != MachineNoId { continue }
        owner := plan.slot[value_id]
        if !plan.storage[owner] { owner = plan.root[value_id] }
        if owner == MachineNoId { continue }
        state.owner.virtuals[virtual_id].stack_object = state.owner.virtuals[function.virtual_begin + owner].stack_object
    }
    // An aggregate result comes back through a hidden address the caller
    // passes; the object holding it is made first so a class built in the
    // caller's memory can name it.
    result_stack: s32 = MachineNoId
    if source.result != MachineNoId && state.owner.types[source.result].class == .Stack &&
        state.lir.types[source.result].kind != .Void {
        result_stack = AddStack(state, .{function = function_id, kind = .ResultAddress, size = 8,
            alignment = 8, type = 0, origin = Origin(state, source.origin),
            value = MachineNoId})
        if result_stack == MachineNoId { return false }
    }
    // A class built inside another's object lies inside it, taking no frame
    // space of its own; the returned class may lie in the result memory.
    for value_id: cast(s64)0..source.values.count - 1 {
        if plan.slot[value_id] != cast(s32)value_id || plan.place_root[value_id] == MachineNoId { continue }
        child := state.owner.virtuals[function.virtual_begin + cast(s32)value_id].stack_object
        parent := result_stack
        if plan.place_root[value_id] != MachineAggregateInResult {
            parent = state.owner.virtuals[function.virtual_begin + plan.place_root[value_id]].stack_object
        }
        if child == MachineNoId || parent == MachineNoId { continue }
        object := state.owner.stack_objects[child]
        object.placed_in = parent - function.stack_begin + 1
        object.placed_at = plan.place_at[value_id]
        // Records are packed, so a member can start at an offset that is not
        // a multiple of its own alignment (a float64 after a byte); the object
        // keeps only the alignment that offset has. Every offset the planner
        // gives is a MemberAt layout offset, so this matches the unplaced
        // member read out of the parent.
        while object.alignment > 1 && object.placed_at % cast(s64)object.alignment != 0 { object.alignment = object.alignment / 2 }
        state.owner.stack_objects[child] = object
    }
    integer_ordinal: s32
    float_ordinal: s32
    for parameter: cast(s64)0..source.parameters.count - 1 {
        virtual_id := function.virtual_begin + cast(s32)parameter
        value := state.owner.virtuals[virtual_id]
        ordinal := integer_ordinal
        if value.class == .Float { ordinal = float_ordinal; float_ordinal += 1 }
        else if value.class == .General { integer_ordinal += 1 }
        fixed := MachineAbiArgumentRegister(state.target, value.class, ordinal)
        if fixed >= 0 { value.fixed_register = fixed }
        else if value.class == .General || value.class == .Float {
            value.stack_object = NewStack(state, function_id, .IncomingArgument, value.type)
            if value.stack_object == MachineNoId { return false }
        } else if value.class == .Stack {
            object := state.owner.stack_objects[value.stack_object]
            object.kind = .IncomingArgument
            state.owner.stack_objects[value.stack_object] = object
        }
        state.owner.virtuals[virtual_id] = value
    }
    function.virtual_count = cast(s32)state.owner.virtuals.count - function.virtual_begin
    function.stack_count = cast(s32)state.owner.stack_objects.count - function.stack_begin
    state.owner.functions[function_id] = function
    return true
}

GlobalVirtual :: (state: *LowerState, function: *MachineFunction, local: s32) -> s32 {
    if local < 0 || local >= function.virtual_count { Fail(state, .Virtual); return MachineNoId }
    // An extract of a split record is the field virtual itself.
    if local < state.aggregates.alias.count && state.aggregates.alias[local] != MachineNoId {
        return state.aggregates.alias[local]
    }
    return function.virtual_begin + local
}

// The arguments ONWARD, the jump of THROUGH, passes when THROUGH receives
// ARGUMENTS, into OUT.
PassArguments :: (state: *LowerState, through: LirBlock, onward: LirEdge, arguments: []s32, out: *Vec(s32)) -> bool {
    if !VecResizeBounded(<<out, onward.arguments.count, state.limits.bytes) { return Fail(state, .Allocation) }
    for argument, at: onward.arguments {
        value := argument
        for parameter, index: through.parameters { if parameter == argument { value = arguments[index] } }
        (<<out)[at] = value
    }
    return true
}

AddEdges :: (state: *LowerState, function: *MachineFunction, edges: []LirEdge) -> bool {
    source_function := state.lir.functions[function.lir_function]
    for edge: edges {
        if !Spend(state, 1) || edge.block < 0 || edge.block >= source_function.blocks.count {
            return Fail(state, .Edge)
        }
        // Past blocks that only jump on, with their parameters replaced by
        // the arguments passed to them.
        source := edge
        first: Vec(s32)
        defer VecFree(first)
        second: Vec(s32)
        defer VecFree(second)
        for step: 0..source_function.blocks.count - 1 {
            if state.select.pass[source.block] < 0 { break }
            through := source_function.blocks[source.block]
            onward := through.instructions[0].edges[0]
            if (step & 1) == 0 {
                if !PassArguments(state, through, onward, source.arguments, *first) { return false }
                source = .{block = onward.block, arguments = first[:]}
            } else {
                if !PassArguments(state, through, onward, source.arguments, *second) { return false }
                source = .{block = onward.block, arguments = second[:]}
            }
        }
        target := source_function.blocks[source.block]
        if source.arguments.count != target.parameters.count { return Fail(state, .Edge) }
        copy_begin := cast(s32)state.owner.copies.count
        for at: cast(s64)0..source.arguments.count - 1 {
            // A split record parameter takes each field separately.
            parameter := target.parameters[at]
            if state.aggregates.plan.split[parameter] {
                into := cast(s64)state.aggregates.field_begin[parameter]
                out := cast(s64)state.aggregates.field_begin[source.arguments[at]]
                for field: cast(s64)0..state.lir.types[source_function.values[parameter]].fields.count - 1 {
                    destination := state.aggregates.fields[into + field]
                    if AddCopy(state, .{destination = destination, source = state.aggregates.fields[out + field],
                        class = state.owner.virtuals[destination].class}) == MachineNoId { return false }
                }
                continue
            }
            from := GlobalVirtual(state, function, source.arguments[at])
            to := GlobalVirtual(state, function, target.parameters[at])
            if state.vector_header == source.block {
                if parameter == state.vector_iv { from = state.vector_iv_out }
                if parameter == state.vector_acc { from = state.vector_acc_out }
            }
            if state.problem != .None || state.owner.virtuals[from].class != state.owner.virtuals[to].class {
                return Fail(state, .Copy)
            }
            if AddCopy(state, .{destination = to, source = from,
                class = state.owner.virtuals[from].class}) == MachineNoId { return false }
        }
        if AddEdge(state, .{target = function.block_begin + state.select.position[source.block], copy_begin = copy_begin,
            copy_count = cast(s32)state.owner.copies.count - copy_begin}) == MachineNoId { return false }
    }
    return true
}

Condition :: (op: LirOp) -> MachineCondition {
    if op == .Equal { return .Equal }
    if op == .NotEqual { return .NotEqual }
    if op == .Less { return .Less }
    if op == .LessEqual { return .LessEqual }
    if op == .Greater { return .Greater }
    if op == .GreaterEqual { return .GreaterEqual }
    return .None
}

BinaryOpcode :: (op: LirOp, class: MachineRegisterClass) -> MachineOpcode {
    if op == .Add { return ifx class == .Float then .FloatAdd else .IntegerAdd }
    if op == .Subtract { return ifx class == .Float then .FloatSubtract else .IntegerSubtract }
    if op == .Multiply { return ifx class == .Float then .FloatMultiply else .IntegerMultiply }
    if op == .Divide { return ifx class == .Float then .FloatDivide else .IntegerDivide }
    if op == .Remainder { return .IntegerRemainder }
    if op == .BitAnd { return .IntegerAnd }
    if op == .BitOr { return .IntegerOr }
    if op == .BitXor { return .IntegerXor }
    if op == .ShiftLeft { return .ShiftLeft }
    if op == .ShiftRight { return .ShiftRight }
    return .Invalid
}

UnaryOpcode :: (op: LirOp, class: MachineRegisterClass) -> MachineOpcode {
    if op == .SquareRoot && class == .Float { return .FloatSquareRoot }
    if op == .Negate { return ifx class == .Float then .FloatNegate else .IntegerNegate }
    if op == .BitNot { return .IntegerNot }
    return .Invalid
}

LowerConstant :: (state: *LowerState, function: *MachineFunction,
    source: LirInstruction, opcode: MachineOpcode) -> bool {
    // A constant every use of which takes it as an immediate is not loaded.
    if !state.select.loaded[source.result] { return true }
    instruction := BeginInstruction(state, opcode, source.origin)
    result := GlobalVirtual(state, function, source.result)
    if VirtualOperand(state, result, .Define) == MachineNoId { return false }
    class := state.owner.virtuals[result].class
    if ImmediateOperand(state, ifx source.op == .Null then 0 else state.lir.constants[source.symbol].bits,
        class) == MachineNoId { return false }
    // x86 has no scalar floating immediate. The encoder materializes its bits
    // through r11, which must be an explicit clobber for allocation.
    if class == .Float &&
        PhysicalOperand(state, MachineAbiScratchRegister(state.target), .Define) == MachineNoId {
        return false
    }
    return FinishInstruction(state, instruction) != MachineNoId
}

LowerAddress :: (state: *LowerState, function: *MachineFunction,
    source: LirInstruction, opcode: MachineOpcode, kind: MachineOperandKind,
    relocation_kind: MachineRelocationKind) -> bool {
    instruction := BeginInstruction(state, opcode, source.origin)
    result := GlobalVirtual(state, function, source.result)
    if VirtualOperand(state, result, .Define) == MachineNoId { return false }
    operand := SymbolOperand(state, kind, source.symbol)
    if operand == MachineNoId { return false }
    instruction_id := FinishInstruction(state, instruction)
    return instruction_id != MachineNoId && AddRelocation(state, .{instruction = instruction_id,
        operand = operand, kind = relocation_kind, symbol = source.symbol})
}

// A flags virtual for an instruction whose sequence changes the flags.
FlagsVirtual :: (state: *LowerState, function: *MachineFunction, origin: s32) -> s32 {
    flags := AddVirtual(state, .{class = .Flags, type = 0, fixed_register = MachineNoId,
        stack_object = MachineNoId, origin = Origin(state, origin)})
    function.virtual_count = cast(s32)state.owner.virtuals.count - function.virtual_begin
    return flags
}

// A raw-address virtual with the type of TOKEN, a checked pointer.
RawVirtual :: (state: *LowerState, function: *MachineFunction, token: s32) -> s32 {
    raw := AddVirtual(state, .{class = .General, type = state.owner.virtuals[token].type,
        fixed_register = MachineNoId, stack_object = MachineNoId, origin = MachineNoId})
    function.virtual_count = cast(s32)state.owner.virtuals.count - function.virtual_begin
    return raw
}

// raw = the address WIDTH bytes may be accessed at through TOKEN (a width
// value when WIDTH_VALUE is a virtual), or the bounds trap. FLAGS: 1 for a
// write, 2 when a zero width needs no live pointer.
LowerResolve :: (state: *LowerState, function: *MachineFunction, token: s32, width: s64,
    width_value: s32, flags: u64, origin: s32) -> s32 {
    raw := RawVirtual(state, function, token)
    if raw == MachineNoId { return MachineNoId }
    instruction := BeginInstruction(state, .PointerResolve, origin)
    instruction.flags_def = FlagsVirtual(state, function, origin)
    if instruction.flags_def == MachineNoId { return MachineNoId }
    if VirtualOperand(state, raw, .Define) == MachineNoId ||
        VirtualOperand(state, token, .Use) == MachineNoId { return MachineNoId }
    if width_value != MachineNoId {
        if VirtualOperand(state, width_value, .Use) == MachineNoId { return MachineNoId }
    } else if ImmediateOperand(state, cast(u64)width) == MachineNoId { return MachineNoId }
    if PhysicalOperand(state, MachineAbiAddressScratchRegister(state.target), .UseDefine) == MachineNoId ||
        ImmediateOperand(state, flags) == MachineNoId ||
        FinishInstruction(state, instruction) == MachineNoId { return MachineNoId }
    return raw
}

LowerUnary :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    result := GlobalVirtual(state, function, source.result)
    input := GlobalVirtual(state, function, source.operands[0])
    opcode := UnaryOpcode(source.op, state.owner.virtuals[result].class)
    if opcode == .Invalid { return Fail(state, .Unsupported) }
    instruction := BeginInstruction(state, opcode, source.origin)
    if VirtualOperand(state, result, .Define, tied = 1) == MachineNoId ||
        VirtualOperand(state, input, .Use, tied = 0) == MachineNoId { return false }
    scratch := MachineAbiScratchRegister(state.target)
    if opcode == .FloatNegate && PhysicalOperand(state, scratch, .Define) == MachineNoId { return false }
    return FinishInstruction(state, instruction) != MachineNoId
}

// The operand of an instruction the selection plan folds: the constant's
// register value as an immediate, or the virtual.
SelectedOperand :: (state: *LowerState, function: *MachineFunction, value: s32, immediate: bool,
    fixed: s32 = MachineNoId) -> s32 {
    if immediate { return ImmediateOperand(state, state.select.bits[value]) }
    return VirtualOperand(state, GlobalVirtual(state, function, value), .Use, fixed)
}

LowerBinary :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    // A constant left operand of a commutative operation trades places.
    fold := state.select.fold[state.select_at]
    left_value := source.operands[ifx fold == .Left then 1 else 0]
    right_value := source.operands[ifx fold == .Left then 0 else 1]
    result := GlobalVirtual(state, function, source.result)
    left := GlobalVirtual(state, function, left_value)
    class := state.owner.virtuals[result].class
    opcode := ifx fold == .ExactHalf then MachineOpcode.ShiftRight else BinaryOpcode(source.op, class)
    if opcode == .Invalid { return Fail(state, .Unsupported) }
    instruction := BeginInstruction(state, opcode, source.origin)
    // Fixed registers come from the target description; -1 is no constraint.
    divide := opcode == .IntegerDivide || opcode == .IntegerRemainder
    result_fixed: s32 = MachineNoId
    left_fixed: s32 = MachineNoId
    right_fixed: s32 = MachineNoId
    clobber: s32 = MachineNoId
    if divide {
        result_fixed = MachineAbiFixedRegister(state.target, .DivideResult)
        left_fixed = MachineAbiFixedRegister(state.target, .DivideDividend)
        clobber = MachineAbiFixedRegister(state.target, .DivideClobber)
    } else if opcode == .ShiftLeft || opcode == .ShiftRight {
        right_fixed = MachineAbiFixedRegister(state.target, .ShiftCount)
    }
    // x86 LEA computes a sum without overwriting either input. Leaving ADD
    // untied avoids a temporary copy when its left input remains live.
    independent_add := state.target.arch == .X86_64 && opcode == .IntegerAdd
    result_tie: s32 = ifx independent_add then MachineNoId else 1
    left_tie: s32 = ifx independent_add then MachineNoId else 0
    if VirtualOperand(state, result, .Define, result_fixed, result_tie) == MachineNoId ||
        VirtualOperand(state, left, .Use, left_fixed, left_tie) == MachineNoId { return false }
    right: s32
    if fold == .ExactHalf { right = ImmediateOperand(state, 1) }
    else { right = SelectedOperand(state, function, right_value, fold != .None, right_fixed) }
    if right == MachineNoId { return false }
    if clobber >= 0 && PhysicalOperand(state, clobber, .UseDefine) == MachineNoId { return false }
    return FinishInstruction(state, instruction) != MachineNoId
}

// A compare makes a 0/1 value, or only flags when its branch follows.
LowerCompare :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    // Its one use, the branch, became a jump.
    if state.select.known[source.result] { return true }
    left := GlobalVirtual(state, function, source.operands[0])
    result := GlobalVirtual(state, function, source.result)
    flags := AddVirtual(state, .{class = .Flags, type = state.owner.virtuals[result].type,
        fixed_register = MachineNoId, stack_object = MachineNoId, origin = Origin(state, source.origin)})
    if flags == MachineNoId { return false }
    compare := BeginInstruction(state, .Compare, source.origin)
    compare.flags_def = flags
    compare.condition = Condition(source.op)
    if VirtualOperand(state, left, .Use) == MachineNoId ||
        SelectedOperand(state, function, source.operands[1], state.select.fold[state.select_at] == .Right) ==
            MachineNoId || FinishInstruction(state, compare) == MachineNoId { return false }
    function.virtual_count = cast(s32)state.owner.virtuals.count - function.virtual_begin
    if state.select.fused[source.result] {
        state.fused_flags = flags
        state.fused_condition = compare.condition
        return true
    }
    set := BeginInstruction(state, .SetCondition, source.origin)
    set.flags_use = flags
    set.condition = compare.condition
    if VirtualOperand(state, result, .Define) == MachineNoId { return false }
    if state.owner.virtuals[left].class == .Float &&
        PhysicalOperand(state, MachineAbiScratchRegister(state.target), .Define) == MachineNoId {
        return false
    }
    return FinishInstruction(state, set) != MachineNoId
}

LowerMove :: (state: *LowerState, function: *MachineFunction, source: LirInstruction,
    opcode: MachineOpcode) -> bool {
    instruction := BeginInstruction(state, opcode, source.origin)
    result := GlobalVirtual(state, function, source.result)
    if VirtualOperand(state, result, .Define) == MachineNoId { return false }
    for operand: source.operands {
        if VirtualOperand(state, GlobalVirtual(state, function, operand), .Use) == MachineNoId { return false }
    }
    if opcode == .Convert && source.operands.count == 1 {
        input := GlobalVirtual(state, function, source.operands[0])
        if state.owner.virtuals[result].class == .Float || state.owner.virtuals[input].class == .Float {
            // Checked float conversions use r11 for exact bit constants and
            // xmm15 as the comparison/arithmetic temporary.
            if PhysicalOperand(state, MachineAbiScratchRegister(state.target), .Define) == MachineNoId ||
                PhysicalOperand(state, MachineAbiScratchFloatRegister(state.target), .Define, .Float) == MachineNoId {
                return false
            }
        }
    }
    return FinishInstruction(state, instruction) != MachineNoId
}

// The raw start of the root a shared LIR fact gives pointer LOCAL, when that
// fact covers an access of WIDTH bytes: a fresh GlobalAddress for a global,
// the `allocate`'s storage for a frame slot. MachineNoId keeps the check.
// AArch64 elides after its checked-memory stage lands.
DirectBase :: (state: *LowerState, function: *MachineFunction, local: s32, width: s64,
    write: bool, origin: s32) -> s32 {
    if state.target.arch != .X86_64 { return MachineNoId }
    fact := LirProvenPointerOf(state.proven, function.lir_function, local)
    if !LirProvenCovers(fact, width, write) { return MachineNoId }
    if fact.root == .Frame {
        if fact.symbol < 0 || fact.symbol >= state.frame_raw.count { return MachineNoId }
        return (<<state.frame_raw)[fact.symbol]
    }
    if fact.root != .Global || fact.symbol < 0 || fact.symbol >= state.owner.globals.count { return MachineNoId }
    base := RawVirtual(state, function, GlobalVirtual(state, function, local))
    if base == MachineNoId { return MachineNoId }
    instruction := BeginInstruction(state, .GlobalAddress, origin)
    if VirtualOperand(state, base, .Define) == MachineNoId { return MachineNoId }
    operand := SymbolOperand(state, .Global, fact.symbol)
    if operand == MachineNoId { return MachineNoId }
    instruction_id := FinishInstruction(state, instruction)
    kind: MachineRelocationKind = ifx state.owner.globals[fact.symbol].writable then .GlobalAddress else .ConstantAddress
    if instruction_id == MachineNoId || !AddRelocation(state, .{instruction = instruction_id,
        operand = operand, kind = kind, symbol = fact.symbol}) { return MachineNoId }
    return base
}

// raw = BASE + TOKEN's offset for an access the verifier re-derives as safe.
LowerDirect :: (state: *LowerState, function: *MachineFunction, token: s32, base: s32, width: s64,
    write: bool, origin: s32) -> s32 {
    raw := RawVirtual(state, function, token)
    if raw == MachineNoId { return MachineNoId }
    instruction := BeginInstruction(state, .PointerDirect, origin)
    instruction.flags_def = FlagsVirtual(state, function, origin)
    if instruction.flags_def == MachineNoId || VirtualOperand(state, raw, .Define) == MachineNoId ||
        VirtualOperand(state, token, .Use) == MachineNoId || VirtualOperand(state, base, .Use) == MachineNoId ||
        ImmediateOperand(state, cast(u64)width) == MachineNoId ||
        ImmediateOperand(state, ifx write then cast(u64)1 else 0) == MachineNoId ||
        FinishInstruction(state, instruction) == MachineNoId { return MachineNoId }
    return raw
}

// An element whose index the shared facts prove below a bound needs no
// index check: ElementAddress result, base, index, bound.
LowerElement :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    // Folded into the load or store that uses it.
    if state.select.address_shift[source.result] >= 0 { return true }
    // A constant zero index folded to its base: nothing to emit.
    if source.result >= 0 && source.result < state.aggregates.alias.count &&
        state.aggregates.alias[source.result] != MachineNoId { return true }
    bound: s64
    if !state.checks && !source.checked && source.operands.count >= 2 && source.operands.count <= 4 {
        // Unchecked: the no-check form at base + index (a subview's low);
        // its bound only records the shape.
        bound = 1
    } else if state.target.arch == .X86_64 && source.operands.count >= 2 && source.operands.count <= 3 {
        bound = LirProvenIndexBound(state.proven, function.lir_function, source.result)
    }
    if bound <= 0 { return LowerMemory(state, function, source, .ElementAddress) }
    instruction := BeginInstruction(state, .ElementAddress, source.origin)
    if VirtualOperand(state, GlobalVirtual(state, function, source.result), .Define) == MachineNoId ||
        VirtualOperand(state, GlobalVirtual(state, function, source.operands[0]), .Use) == MachineNoId ||
        VirtualOperand(state, GlobalVirtual(state, function, source.operands[1]), .Use) == MachineNoId ||
        ImmediateOperand(state, cast(u64)bound) == MachineNoId { return false }
    return FinishInstruction(state, instruction) != MachineNoId
}

LowerMemory :: (state: *LowerState, function: *MachineFunction, source: LirInstruction,
    opcode: MachineOpcode) -> bool {
    // With --checks a load, store or zero goes through the address its
    // pointer resolves to, or the one a shared fact proves needs no check.
    // Otherwise the pointer is the address.
    resolved: s32 = MachineNoId
    if state.checks && (opcode == .Load || opcode == .Store || opcode == .Zero) && source.operands.count >= 1 {
        token := GlobalVirtual(state, function, source.operands[0])
        if token == MachineNoId { return false }
        width: s64
        if opcode == .Zero {
            pointer := state.owner.types[state.owner.virtuals[token].type]
            if pointer.kind != .Pointer || pointer.element < 0 { return Fail(state, .Unsupported) }
            width = state.owner.types[pointer.element].size
        } else {
            accessed := ifx opcode == .Load then source.result else source.operands[source.operands.count - 1]
            width = state.owner.types[state.owner.virtuals[GlobalVirtual(state, function, accessed)].type].size
        }
        write := opcode != .Load
        base := DirectBase(state, function, source.operands[0], width, write, source.origin)
        if state.problem != .None { return false }
        if base != MachineNoId {
            resolved = LowerDirect(state, function, token, base, width, write, source.origin)
        } else {
            resolved = LowerResolve(state, function, token, width, MachineNoId,
                ifx write then cast(u64)1 else 0, source.origin)
        }
        if resolved == MachineNoId { return false }
    }
    instruction := BeginInstruction(state, opcode, source.origin)
    if source.result != LirNoId &&
        VirtualOperand(state, GlobalVirtual(state, function, source.result), .Define) == MachineNoId { return false }
    // A folded element address: the access takes base, index and scale.
    address := ifx source.operands.count > 0 then source.operands[0] else LirNoId
    if (opcode == .Load || opcode == .Store) && address != LirNoId && state.select.address_shift[address] >= 0 {
        if VirtualOperand(state, GlobalVirtual(state, function, state.select.address_base[address]), .Use) == MachineNoId ||
            VirtualOperand(state, GlobalVirtual(state, function, state.select.address_index[address]), .Use) == MachineNoId ||
            ImmediateOperand(state, cast(u64)state.select.address_shift[address]) == MachineNoId { return false }
    }
    for operand, at: source.operands {
        if at == 0 && address != LirNoId && state.select.address_shift[address] >= 0 { continue }
        if opcode == .Store && at == 1 && state.select.fold[state.select_at] == .Right {
            if ImmediateOperand(state, state.select.bits[operand]) == MachineNoId { return false }
            continue
        }
        value := ifx at == 0 && resolved != MachineNoId then resolved else GlobalVirtual(state, function, operand)
        if VirtualOperand(state, value, .Use) == MachineNoId { return false }
    }
    if source.op == .FieldAddress && ImmediateOperand(state, source.immediate) == MachineNoId { return false }
    return FinishInstruction(state, instruction) != MachineNoId
}

// Every execution of `allocate` gets fresh storage that stays valid until
// its frame returns, as on the portable engine: frame arena bytes, zeroed or
// given their initial value. With --checks a new slot on the frame's chain
// names them; otherwise their address is the pointer.
LowerAllocate :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    result := GlobalVirtual(state, function, source.result)
    pointer := state.owner.types[state.owner.virtuals[result].type]
    if pointer.kind != .Pointer || pointer.element < 0 { return Fail(state, .Unsupported) }
    if function.arena_mark == 0 || state.checks && function.pointer_chain == 0 { return Fail(state, .Stack) }
    size := state.owner.types[pointer.element].size
    raw := result
    if state.checks {
        if source.result < 0 || source.result >= state.frame_raw.count { return Fail(state, .Virtual) }
        raw = (<<state.frame_raw)[source.result]
        if raw == MachineNoId { return Fail(state, .Virtual) }
    }
    scratch := MachineAbiAddressScratchRegister(state.target)
    allocate := BeginInstruction(state, .ArenaAllocate, source.origin)
    allocate.flags_def = FlagsVirtual(state, function, source.origin)
    if allocate.flags_def == MachineNoId || VirtualOperand(state, raw, .Define) == MachineNoId ||
        ImmediateOperand(state, cast(u64)size) == MachineNoId ||
        PhysicalOperand(state, scratch, .UseDefine) == MachineNoId ||
        FinishInstruction(state, allocate) == MachineNoId { return false }
    if source.operands.count == 1 {
        store := BeginInstruction(state, .Store, source.origin)
        if VirtualOperand(state, raw, .Use) == MachineNoId ||
            VirtualOperand(state, GlobalVirtual(state, function, source.operands[0]), .Use) == MachineNoId ||
            FinishInstruction(state, store) == MachineNoId { return false }
    } else {
        zero := BeginInstruction(state, .Zero, source.origin)
        if VirtualOperand(state, raw, .Use) == MachineNoId ||
            FinishInstruction(state, zero) == MachineNoId { return false }
    }
    if !state.checks { return true }
    create := BeginInstruction(state, .PointerCreate, source.origin)
    create.flags_def = FlagsVirtual(state, function, source.origin)
    if create.flags_def == MachineNoId || VirtualOperand(state, result, .Define) == MachineNoId ||
        VirtualOperand(state, raw, .Use) == MachineNoId ||
        ImmediateOperand(state, cast(u64)size) == MachineNoId ||
        PhysicalOperand(state, scratch, .UseDefine) == MachineNoId ||
        ImmediateOperand(state, cast(u64)(MachinePointerLive | MachinePointerWritable)) == MachineNoId ||
        StackOperand(state, function.stack_begin + function.pointer_chain - 1) == MachineNoId ||
        FinishInstruction(state, create) == MachineNoId { return false }
    return true
}

LowerBytesEqual :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    if source.operands.count != 4 { return Fail(state, .Unsupported) }
    // Both byte views are read through their resolved addresses; an empty
    // view needs no live pointer.
    values: [4]s32
    for at: cast(s64)0..3 { values[at] = GlobalVirtual(state, function, source.operands[at]) }
    for at: cast(s64)0..1 {
        if !state.checks { break }
        values[at * 2] = LowerResolve(state, function, values[at * 2], 0, values[at * 2 + 1], 2, source.origin)
        if values[at * 2] == MachineNoId { return false }
    }
    instruction := BeginInstruction(state, .BytesEqual, source.origin)
    result := GlobalVirtual(state, function, source.result)
    if VirtualOperand(state, result, .Define, 0) == MachineNoId { return false }
    for at: cast(s64)0..3 {
        if VirtualOperand(state, values[at], .Use,
            MachineAbiFormFixedRegister(state.target, .BytesEqual, cast(s32)at)) == MachineNoId {
            return false
        }
    }
    // A target with fewer spare registers ends its clobber list early.
    for at: cast(s64)0..2 {
        clobber := MachineAbiFormClobberRegister(state.target, .BytesEqual, cast(s32)at)
        if clobber < 0 { break }
        if PhysicalOperand(state, clobber, .Define) == MachineNoId { return false }
    }
    return FinishInstruction(state, instruction) != MachineNoId
}

LowerResize :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    if source.operands.count != 3 { return Fail(state, .Unsupported) }
    instruction := BeginInstruction(state, .Resize, source.origin)
    result := GlobalVirtual(state, function, source.result)
    if VirtualOperand(state, result, .Define, 0) == MachineNoId { return false }
    for at: cast(s64)0..2 {
        if VirtualOperand(state, GlobalVirtual(state, function, source.operands[at]), .Use,
            MachineAbiFormFixedRegister(state.target, .Resize, cast(s32)at)) == MachineNoId {
            return false
        }
    }
    for at: cast(s64)0..7 {
        clobber := MachineAbiFormClobberRegister(state.target, .Resize, cast(s32)at)
        if clobber < 0 { break }
        if PhysicalOperand(state, clobber, .Define) == MachineNoId { return false }
    }
    runtime := ImmediateOperand(state, 0)
    if runtime == MachineNoId { return false }
    instruction_id := FinishInstruction(state, instruction)
    if instruction_id == MachineNoId { return false }
    return AddRelocation(state, .{instruction = instruction_id, operand = runtime,
        kind = .RuntimeResize, symbol = 0})
}

// Whether some instruction of PROGRAM is under `#checks`.
AnyChecked :: (program: LirProgram) -> bool {
    for function: program.functions {
        for block: function.blocks {
            for instruction: block.instructions { if instruction.checked { return true } }
        }
    }
    return false
}

RoundEight :: (value: s64) -> s64 {
    if value < 0 || value > 9223372036854775799 { return -1 }
    return (value + 7) & ~cast(s64)7
}

LowerCall :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    indirect := source.op == .CallIndirect
    if source.op != .Call && source.op != .HostCall && !indirect { return Fail(state, .Unsupported) }
    // Platform services take raw addresses: a pointer argument is resolved
    // for the byte count that follows it, or for its pointee.
    resolved: [16]s32
    for at: 0..15 { resolved[at] = MachineNoId }
    if state.checks && !indirect && source.symbol >= 0 && source.symbol < state.owner.functions.count &&
        state.owner.functions[source.symbol].calling == .Platform && source.operands.count <= 16 {
        for at: cast(s64)0..source.operands.count - 1 {
            token := GlobalVirtual(state, function, source.operands[at])
            type := state.owner.types[state.owner.virtuals[token].type]
            if type.kind != .Pointer { continue }
            width: s64 = 0
            width_value: s32 = MachineNoId
            if at + 1 < source.operands.count &&
                state.owner.types[state.owner.virtuals[GlobalVirtual(state, function, source.operands[at + 1])].type].kind == .Integer {
                width_value = GlobalVirtual(state, function, source.operands[at + 1])
            } else if type.element >= 0 { width = state.owner.types[type.element].size }
            resolved[at] = LowerResolve(state, function, token, width, width_value, 2, source.origin)
            if resolved[at] == MachineNoId { return false }
        }
    }
    instruction := BeginInstruction(state, ifx indirect then .CallIndirect else .CallDirect, source.origin)
    result_operand: s32 = MachineNoId
    result_class := MachineRegisterClass.Invalid
    if source.result != LirNoId {
        result := GlobalVirtual(state, function, source.result)
        result_class = state.owner.virtuals[result].class
        fixed := MachineAbiResultRegister(state.target, result_class)
        result_operand = VirtualOperand(state, result, .Define, fixed)
        if result_operand == MachineNoId { return false }
    }
    argument_offset: s32
    parameter_types: []s32
    if indirect {
        callable := GlobalVirtual(state, function, source.operands[0])
        fixed := MachineAbiIndirectCallRegister(state.target)
        if fixed < 0 { fixed = MachineNoId }
        if VirtualOperand(state, callable, .Use, fixed) == MachineNoId { return false }
        signature := state.lir.types[state.lir.functions[function.lir_function].values[source.operands[0]]]
        if signature.kind != .Function { return Fail(state, .Unsupported) }
        parameter_types = signature.parameters
        argument_offset = 1
    } else {
        symbol_operand := SymbolOperand(state, .Function, source.symbol)
        if symbol_operand == MachineNoId { return false }
        if source.symbol < 0 || source.symbol >= state.lir.functions.count { return Fail(state, .Function) }
        parameter_types = state.lir.functions[source.symbol].parameters
        argument_offset = 0
    }
    argument_begin := cast(s32)state.owner.operands.count
    integer_ordinal: s32
    float_ordinal: s32
    stack_bytes: s64
    for at: cast(s64)0..parameter_types.count - 1 {
        local := source.operands[at + cast(s64)argument_offset]
        value := GlobalVirtual(state, function, local)
        if argument_offset == 0 && at < 16 && resolved[at] != MachineNoId { value = resolved[at] }
        class := state.owner.virtuals[value].class
        ordinal := integer_ordinal
        if class == .Float { ordinal = float_ordinal; float_ordinal += 1 }
        else if class == .General { integer_ordinal += 1 }
        fixed := MachineAbiArgumentRegister(state.target, class, ordinal)
        if VirtualOperand(state, value, .Use, fixed) == MachineNoId { return false }
        if fixed < 0 || class == .Stack {
            size := RoundEight(state.owner.types[parameter_types[at]].size)
            if size < 0 || stack_bytes > 9223372036854775807 - size { return Fail(state, .Limit) }
            stack_bytes += size
        }
    }
    if stack_bytes > 0 {
        stack := AddStack(state, .{function = function.lir_function, kind = .OutgoingArgument,
            size = stack_bytes, alignment = 8, type = 0, origin = Origin(state, source.origin)})
        if stack == MachineNoId || AddOperand(state, .{kind = .StackObject, role = .Use,
            class = .Stack, id = stack, type = 0, fixed_register = MachineNoId,
            tied_to = MachineNoId, value = MachineNoId}) == MachineNoId { return false }
        function.stack_count = cast(s32)state.owner.stack_objects.count - function.stack_begin
    }
    instruction_id := cast(s32)state.owner.instructions.count
    calling := MachineCalling.Internal
    if !indirect { calling = state.owner.functions[source.symbol].calling }
    call_id := AddCall(state, .{instruction = instruction_id, calling = calling,
        argument_begin = argument_begin, argument_count = cast(s32)parameter_types.count,
        result_operand = result_operand, stack_argument_bytes = stack_bytes,
        clobber_general = MachineAbiCallGeneralClobbers(state.target),
        clobber_float = MachineAbiCallFloatClobbers(state.target),
        clobber_vector = MachineAbiCallFloatClobbers(state.target), indirect = indirect})
    if call_id == MachineNoId { return false }
    instruction.call = call_id
    instruction_id = FinishInstruction(state, instruction)
    if instruction_id == MachineNoId { return false }
    if !indirect {
        symbol_operand := argument_begin - 1
        relocation := MachineRelocationKind.FunctionCall
        if calling == .Host { relocation = .HostCapability }
        if calling == .Platform { relocation = .PlatformService }
        if !AddRelocation(state, .{instruction = instruction_id, operand = symbol_operand,
            kind = relocation, symbol = source.symbol}) { return false }
    }
    return true
}

// A branch on the flags of the compare just lowered, to EDGES.
FlagsBranch :: (state: *LowerState, function: *MachineFunction, edges: []LirEdge, origin: s32) -> bool {
    instruction := BeginInstruction(state, .Branch, origin)
    instruction.flags_use = state.fused_flags
    instruction.condition = state.fused_condition
    return AddEdges(state, function, edges) && FinishInstruction(state, instruction) != MachineNoId
}

// A jump into a block that only branches on its parameter does that branch
// itself: to the chosen edge for a constant, on the flags of the compare
// before it, or on the value.
LowerThreaded :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    target := state.select.thread[state.select_block]
    branch := state.lir.functions[function.lir_function].blocks[target].instructions[0]
    argument := source.edges[0].arguments[0]
    if state.select.constant[argument] {
        taken := ifx state.select.bits[argument] != 0 then cast(s64)0 else 1
        instruction := BeginInstruction(state, .Jump, source.origin)
        return AddEdges(state, function, branch.edges[taken:taken + 1]) &&
            FinishInstruction(state, instruction) != MachineNoId
    }
    if state.select.fused[argument] { return FlagsBranch(state, function, branch.edges, source.origin) }
    instruction := BeginInstruction(state, .Branch, source.origin)
    return VirtualOperand(state, GlobalVirtual(state, function, argument), .Use) != MachineNoId &&
        AddEdges(state, function, branch.edges) && FinishInstruction(state, instruction) != MachineNoId
}

LowerControl :: (state: *LowerState, function: *MachineFunction, source: LirInstruction,
    opcode: MachineOpcode) -> bool {
    if opcode == .Jump && state.select.thread[state.select_block] >= 0 {
        return LowerThreaded(state, function, source)
    }
    if opcode == .Branch && state.select.known[source.operands[0]] {
        // The test always holds (MachineSelectPlan.known): jump on its edge.
        jump := BeginInstruction(state, .Jump, source.origin)
        return AddEdges(state, function, source.edges[0:1]) && FinishInstruction(state, jump) != MachineNoId
    }
    if opcode == .Branch && state.select.fused[source.operands[0]] {
        return FlagsBranch(state, function, source.edges, source.origin)
    }
    instruction := BeginInstruction(state, opcode, source.origin)
    for operand: source.operands {
        id := GlobalVirtual(state, function, operand)
        fixed: s32 = MachineNoId
        if opcode == .Return { fixed = MachineAbiResultRegister(state.target, state.owner.virtuals[id].class) }
        if VirtualOperand(state, id, .Use, fixed) == MachineNoId { return false }
    }
    if source.op == .Fuel || source.op == .Trap {
        if ImmediateOperand(state, source.immediate) == MachineNoId { return false }
    }
    counter: s32 = MachineNoId
    if source.op == .Fuel {
        // A fuel check subtracts from the instance counter and traps on
        // exhaustion, so it names the counter through a relocation and
        // defines (clobbers) the flags before liveness sees it.
        counter = ImmediateOperand(state, 0)
        if counter == MachineNoId { return false }
        flags := AddVirtual(state, .{class = .Flags, type = 0, fixed_register = MachineNoId,
            stack_object = MachineNoId, origin = Origin(state, source.origin)})
        if flags == MachineNoId { return false }
        instruction.flags_def = flags
        function.virtual_count = cast(s32)state.owner.virtuals.count - function.virtual_begin
    }
    if !AddEdges(state, function, source.edges) { return false }
    instruction_id := FinishInstruction(state, instruction)
    if instruction_id == MachineNoId { return false }
    if counter != MachineNoId {
        return AddRelocation(state, .{instruction = instruction_id, operand = counter,
            kind = .FuelCounter, symbol = 0})
    }
    return true
}

// ---------------------------------------------------------------------------
// Aggregate storage and views (compiler_machine_aggregate)

AggregateTypes :: (state: *LowerState) -> bool {
    lowering := state.aggregates
    count := state.owner.types.count
    if !VecResizeBounded(lowering.stack_size, count, state.limits.bytes) ||
        !VecResizeBounded(lowering.size, count, state.limits.bytes) ||
        !VecResizeBounded(lowering.pointer_to, count, state.limits.bytes) { return Fail(state, .Allocation) }
    for type: cast(s64)0..count - 1 {
        machine := state.owner.types[type]
        lowering.size[type] = machine.size
        lowering.stack_size[type] = ifx machine.class == .Stack then machine.size else -1
        lowering.pointer_to[type] = MachineNoId
    }
    return true
}

// A pointer type to ELEMENT, made once per lowering.
PointerTo :: (state: *LowerState, element: s32) -> s32 {
    lowering := state.aggregates
    if lowering.pointer_to[element] != MachineNoId { return lowering.pointer_to[element] }
    size := cast(s64)(state.target.pointer_bits / 8)
    empty := cast(s32)state.owner.type_ids.count
    pointer := AddType(state, .{kind = .Pointer, class = .General, bits = state.target.pointer_bits, size = size,
        alignment = Alignment(size), element = element, count = 0, fields_begin = empty, fields_count = 0,
        parameters_begin = empty, parameters_count = 0, result = MachineNoId})
    lowering.pointer_to[element] = pointer
    return pointer
}

// A General virtual holding the frame address of a value of type ELEMENT.
AddressVirtual :: (state: *LowerState, function: *MachineFunction, element: s32) -> s32 {
    pointer := PointerTo(state, element)
    if pointer == MachineNoId { return MachineNoId }
    address := AddVirtual(state, .{class = .General, type = pointer, fixed_register = MachineNoId,
        stack_object = MachineNoId, origin = MachineNoId})
    function.virtual_count = cast(s32)state.owner.virtuals.count - function.virtual_begin
    return address
}

// Split records: each value gets one virtual per field. A block parameter's
// are fresh, a build's are its operands', an insert's its source's with one
// replaced, and an extract stands for its field's; walked in reverse
// postorder, so every value's fields exist before its uses.
SplitFields :: (state: *LowerState, function: *MachineFunction, source: LirFunction) -> bool {
    lowering := state.aggregates
    plan := *lowering.plan
    count := source.values.count
    if !VecResizeBounded(lowering.field_begin, count, state.limits.bytes) || !VecResize(lowering.fields, 0) {
        return Fail(state, .Allocation)
    }
    any := false
    for value: cast(s32)0..cast(s32)count - 1 {
        lowering.field_begin[value] = MachineNoId
        if !plan.split[value] { continue }
        any = true
        lowering.field_begin[value] = cast(s32)lowering.fields.count
        for field: state.lir.types[source.values[value]].fields {
            if !VecPush(lowering.fields, MachineNoId) { return Fail(state, .Allocation) }
        }
    }
    if !any { return true }
    for block: source.blocks {
        for parameter: block.parameters {
            if !plan.split[parameter] { continue }
            begin := cast(s64)lowering.field_begin[parameter]
            for field, at: state.lir.types[source.values[parameter]].fields {
                virtual := AddVirtual(state, .{class = state.owner.types[field].class, type = field,
                    fixed_register = MachineNoId, stack_object = MachineNoId, origin = MachineNoId})
                if virtual == MachineNoId { return false }
                lowering.fields[begin + at] = virtual
            }
        }
    }
    function.virtual_count = cast(s32)state.owner.virtuals.count - function.virtual_begin
    for block: plan.order {
        for instruction: source.blocks[block].instructions {
            if !Spend(state, 1) { return false }
            result := instruction.result
            if instruction.op == .Extract && instruction.operands.count == 1 && plan.split[instruction.operands[0]] {
                lowering.alias[result] = lowering.fields[cast(s64)lowering.field_begin[instruction.operands[0]] +
                    cast(s64)instruction.immediate]
                continue
            }
            if result < 0 || !plan.split[result] { continue }
            begin := cast(s64)lowering.field_begin[result]
            if instruction.op == .Aggregate {
                for operand, at: instruction.operands { lowering.fields[begin + at] = GlobalVirtual(state, function, operand) }
            } else {
                from := cast(s64)lowering.field_begin[instruction.operands[0]]
                for at: cast(s64)0..state.lir.types[source.values[result]].fields.count - 1 {
                    lowering.fields[begin + at] = lowering.fields[from + at]
                }
                lowering.fields[begin + cast(s64)instruction.immediate] = GlobalVirtual(state, function, instruction.operands[1])
            }
        }
    }
    return true
}

// Whether SOURCE builds, changes or reads a split record, which emits nothing.
Splits :: (state: *LowerState, source: LirInstruction) -> bool {
    plan := *state.aggregates.plan
    if source.op == .Extract { return source.operands.count == 1 && plan.split[source.operands[0]] }
    return (source.op == .Aggregate || source.op == .Insert) && source.result >= 0 && plan.split[source.result]
}

// Extract forwarding: a scalar read from an aggregate that inserts built is
// the value inserted at that place. Reading back the field just updated is
// the update's value, with no load. The walk looks through inserts at the
// same key (equal constants or the same index value), through inserts at a
// different constant key, and into the extracts its aggregates came from.
// It stops at anything else.
ForwardDepth :: 8

Key :: struct {
    dynamic: bool
    value: s64
}

// The key of an extract or insert: its constant member or its index value.
KeyOf :: (instruction: LirInstruction) -> Key {
    if instruction.op == .Extract && instruction.operands.count == 2 {
        return .{dynamic = true, value = cast(s64)instruction.operands[1]}
    }
    if instruction.op == .Insert && instruction.operands.count == 3 {
        return .{dynamic = true, value = cast(s64)instruction.operands[2]}
    }
    return .{value = cast(s64)instruction.immediate}
}

// The value the scalar extract EXTRACT reads, or LirNoId. DEFINER maps
// each value to its defining instruction (block * 2^32 + index), or -1.
Forwarded :: (source: LirFunction, definer: []s64, extract: LirInstruction) -> s32 {
    path: [ForwardDepth]Key
    depth: s64 = 1
    path[0] = KeyOf(extract)
    value := extract.operands[0]
    for step: 0..4 * ForwardDepth {
        if value < 0 || definer[value] < 0 { return LirNoId }
        at := definer[value]
        instruction := source.blocks[at >> 32].instructions[at & 0xffffffff]
        if instruction.op == .Insert && (instruction.operands.count == 2 || instruction.operands.count == 3) {
            key := KeyOf(instruction)
            top := path[depth - 1]
            if key.dynamic == top.dynamic && key.value == top.value {
                value = instruction.operands[1]
                depth -= 1
                if depth == 0 { return value }
            } else if !key.dynamic && !top.dynamic {
                value = instruction.operands[0]
            } else { return LirNoId }
        } else if instruction.op == .Extract && (instruction.operands.count == 1 || instruction.operands.count == 2) {
            if depth == ForwardDepth { return LirNoId }
            path[depth] = KeyOf(instruction)
            depth += 1
            value = instruction.operands[0]
        } else { return LirNoId }
    }
    return LirNoId
}

// Aliases every scalar extract that reads an inserted value to that value,
// in reverse postorder so chains resolve; such an extract emits nothing.
ForwardExtracts :: (state: *LowerState, function: *MachineFunction, source: LirFunction) -> bool {
    plan := *state.aggregates.plan
    if plan.order.count == 0 { return true }
    definer: Vec(s64)
    defer VecFree(definer)
    if !VecResizeBounded(definer, source.values.count, state.limits.bytes) { return Fail(state, .Allocation) }
    for at: cast(s64)0..definer.count - 1 { definer[at] = -1 }
    for block, block_index: source.blocks {
        for instruction, item: block.instructions {
            if instruction.result >= 0 { definer[instruction.result] = (block_index << 32) | item }
        }
    }
    for block: plan.order {
        for instruction: source.blocks[block].instructions {
            if !Spend(state, 1) { return false }
            result := instruction.result
            if instruction.op != .Extract || result < 0 || state.aggregates.alias[result] != MachineNoId ||
                !RegisterClassValue(state, function, result) { continue }
            value := Forwarded(source, definer[:], instruction)
            if value == LirNoId || source.values[value] != source.values[result] { continue }
            state.aggregates.alias[result] = GlobalVirtual(state, function, value)
        }
    }
    return true
}

// An alias may name a value that a later fold aliased in turn: point every
// alias at the end of its chain so no use names an eliminated virtual.
ResolveAliasChains :: (state: *LowerState, function: *MachineFunction) {
    count := function.virtual_count
    for local: cast(s64)0..count - 1 {
        if local >= state.aggregates.alias.count { break }
        target := state.aggregates.alias[local]
        steps: s64
        while target != MachineNoId && steps <= count {
            next := target - function.virtual_begin
            if next < 0 || next >= count || next >= state.aggregates.alias.count ||
                state.aggregates.alias[next] == MachineNoId { break }
            target = state.aggregates.alias[next]
            steps += 1
        }
        if state.aggregates.alias[local] != MachineNoId { state.aggregates.alias[local] = target }
    }
    // Field virtuals cached before a later fold aliased their source follow
    // the same chains; fresh field definitions are past the value range.
    for at: cast(s64)0..state.aggregates.fields.count - 1 {
        field := state.aggregates.fields[at]
        if field == MachineNoId { continue }
        local := cast(s64)field - cast(s64)function.virtual_begin
        if local < 0 || local >= state.aggregates.alias.count || state.aggregates.alias[local] == MachineNoId { continue }
        state.aggregates.fields[at] = state.aggregates.alias[local]
    }
}

// Every use of VALUE keeps a pointer word intact: a call argument, return
// value, control-edge argument, or member of a split record. The last uses
// scalar field storage instead of a typed aggregate build.
PointerValueUses :: (state: *LowerState, source: LirFunction, value: s32) -> bool {
    used := false
    for block: source.blocks {
        for instruction: block.instructions {
            for operand: instruction.operands {
                if operand != value { continue }
                if instruction.op == .Call || instruction.op == .CallIndirect ||
                    instruction.op == .HostCall || instruction.op == .Return { used = true; continue }
                if instruction.op == .Aggregate && instruction.result >= 0 &&
                    instruction.result < state.aggregates.plan.split.count &&
                    state.aggregates.plan.split[instruction.result] { used = true; continue }
                return false
            }
            if instruction.op != .Jump && instruction.op != .Branch { continue }
            for edge: instruction.edges {
                for argument: edge.arguments {
                    if argument != value { continue }
                    used = true
                }
            }
        }
    }
    return used
}

// A constant zero element index addresses its base exactly: every such
// address whose lowering needs no bounds check aliases to the base and
// emits nothing, and this use no longer materializes the index constant.
FoldZeroElements :: (state: *LowerState, function: *MachineFunction, source: LirFunction) -> bool {
    if state.target.arch != .X86_64 { return true }
    for at: cast(s64)0..source.blocks.count - 1 {
        block := source.blocks[state.select.layout[at]]
        for instruction: block.instructions {
            if !Spend(state, 1) { return false }
            if instruction.op != .ElementAddress || instruction.result < 0 { continue }
            if instruction.operands.count < 2 { continue }
            if state.select.address_shift[instruction.result] >= 0 { continue }
            if state.aggregates.alias[instruction.result] != MachineNoId { continue }
            if !state.checks && !instruction.checked && instruction.operands.count <= 4 {
                // The no-check form: its bound only records the shape.
            } else if instruction.operands.count <= 3 &&
                LirProvenIndexBound(state.proven, function.lir_function, instruction.result) > 0 {
                // Facts prove the index below its bound: no check.
            } else { continue }
            index := instruction.operands[1]
            if index < 0 || index >= state.select.constant.count { continue }
            if !state.select.constant[index] || state.select.bits[index] != 0 { continue }
            base := instruction.operands[0]
            if base < 0 || !RegisterClassValue(state, function, base) ||
                !RegisterClassValue(state, function, instruction.result) { continue }
            // A differing base pointer type may alias only when every use
            // moves the pointer value itself, never a typed aggregate build.
            if source.values[base] != source.values[instruction.result] &&
                (state.checks || !PointerValueUses(state, source, instruction.result)) { continue }
            state.aggregates.alias[instruction.result] = GlobalVirtual(state, function, base)
            if state.select.uses[index] > 0 { state.select.uses[index] -= 1 }
            state.select.loaded[index] = state.select.uses[index] > state.select.folded[index]
        }
    }
    return true
}

RegisterClassValue :: (state: *LowerState, function: *MachineFunction, value: s32) -> bool {
    class := state.owner.virtuals[function.virtual_begin + value].class
    return class == .General || class == .Float
}

// An aggregate build whose members are all replaced before it is read emits
// nothing, so its constant members lose that use and may go unloaded.
DropCovered :: (state: *LowerState, source: LirFunction) -> bool {
    for block: source.blocks {
        for instruction: block.instructions {
            if !Spend(state, 1) { return false }
            if instruction.op != .Aggregate || instruction.result < 0 || !state.aggregates.plan.covered[instruction.result] {
                continue
            }
            for operand: instruction.operands {
                if operand < 0 || operand >= state.select.constant.count || !state.select.constant[operand] { continue }
                if state.select.uses[operand] > 0 { state.select.uses[operand] -= 1 }
                state.select.loaded[operand] = state.select.uses[operand] > state.select.folded[operand]
            }
        }
    }
    return true
}

// Each view that computes an address gets the virtual holding it; every other
// view takes the virtual of the view whose address it shares.
ViewAddresses :: (state: *LowerState, function: *MachineFunction, source: LirFunction) -> bool {
    lowering := state.aggregates
    plan := *lowering.plan
    count := source.values.count
    if !VecResizeBounded(lowering.view_address, count, state.limits.bytes) { return Fail(state, .Allocation) }
    for value: cast(s32)0..cast(s32)count - 1 {
        lowering.view_address[value] = MachineNoId
        if MachineAggregateViewed(plan.view[value]) && plan.address[value] == value {
            lowering.view_address[value] = AddressVirtual(state, function, source.values[value])
            if lowering.view_address[value] == MachineNoId { return false }
        }
    }
    for value: cast(s32)0..cast(s32)count - 1 {
        if MachineAggregateViewed(plan.view[value]) { lowering.view_address[value] = lowering.view_address[plan.address[value]] }
    }
    return true
}

// The bound the shared facts prove the dynamic index of SOURCE below, so
// x86-64 code needs no check for it, or 0.
ProvenBound :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> s64 {
    if !state.checks && !source.checked {
        // Unchecked: the no-check form, with the array's count as its bound.
        aggregate := state.owner.types[state.owner.virtuals[GlobalVirtual(state, function, source.operands[0])].type]
        return ifx aggregate.kind == .Array && aggregate.count > 0 then aggregate.count else 0
    }
    if state.target.arch != .X86_64 { return 0 }
    return LirProvenIndexBound(state.proven, function.lir_function, source.result)
}

// Operands after the aggregate of a member access: the member immediate, or
// a dynamic index with the r10/r11 it may clobber and then its proven bound
// (0 keeps the check).
MemberOperands :: (state: *LowerState, function: *MachineFunction, source: LirInstruction, fixed: s64) -> bool {
    if source.operands.count != fixed + 1 { return ImmediateOperand(state, source.immediate) != MachineNoId }
    return VirtualOperand(state, GlobalVirtual(state, function, source.operands[fixed]), .Use) != MachineNoId &&
        PhysicalOperand(state, MachineAbiAddressScratchRegister(state.target), .Define) != MachineNoId &&
        PhysicalOperand(state, MachineAbiScratchRegister(state.target), .Define) != MachineNoId &&
        ImmediateOperand(state, cast(u64)ProvenBound(state, function, source)) != MachineNoId
}

// An extract or insert copying through frame objects: result, aggregate
// [, value], then the member operands.
LowerAggregate :: (state: *LowerState, function: *MachineFunction, source: LirInstruction,
    opcode: MachineOpcode, fixed: s64) -> bool {
    instruction := BeginInstruction(state, opcode, source.origin)
    if VirtualOperand(state, GlobalVirtual(state, function, source.result), .Define) == MachineNoId { return false }
    for at: cast(s64)0..fixed - 1 {
        if VirtualOperand(state, GlobalVirtual(state, function, source.operands[at]), .Use) == MachineNoId { return false }
    }
    return MemberOperands(state, function, source, fixed) && FinishInstruction(state, instruction) != MachineNoId
}

// A view that computes its address: from its source view's address, or the
// frame address of the storage it reads, then the member it names.
ViewAddress :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    lowering := state.aggregates
    result := source.result
    if lowering.plan.address[result] != result { return true }
    aggregate := source.operands[0]
    base: s32
    if MachineAggregateViewed(lowering.plan.view[aggregate]) {
        base = lowering.view_address[aggregate]
    } else {
        stored := state.owner.virtuals[GlobalVirtual(state, function, aggregate)]
        base = AddressVirtual(state, function, stored.type)
        if base == MachineNoId { return false }
        frame := BeginInstruction(state, .StackAddress, source.origin)
        if VirtualOperand(state, base, .Define) == MachineNoId || StackOperand(state, stored.stack_object) == MachineNoId ||
            FinishInstruction(state, frame) == MachineNoId { return false }
    }
    // A proven element address carries its bound and is not checked.
    dynamic := source.operands.count == 2
    bound := ifx dynamic then ProvenBound(state, function, source) else 0
    instruction := BeginInstruction(state, ifx dynamic then MachineOpcode.ElementAddress else .FieldAddress, source.origin)
    if VirtualOperand(state, lowering.view_address[result], .Define) == MachineNoId ||
        VirtualOperand(state, base, .Use) == MachineNoId { return false }
    if dynamic {
        if VirtualOperand(state, GlobalVirtual(state, function, source.operands[1]), .Use) == MachineNoId ||
            bound > 0 && ImmediateOperand(state, cast(u64)bound) == MachineNoId { return false }
    } else if ImmediateOperand(state, source.immediate) == MachineNoId { return false }
    return FinishInstruction(state, instruction) != MachineNoId
}

// A view computes or shares its address; a member of a view is read in place
// through it; any other extract copies the member out of its frame object.
LowerExtract :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    lowering := state.aggregates
    if lowering.plan.view[source.result] == .Read { return ViewAddress(state, function, source) }
    aggregate := source.operands[0]
    if !MachineAggregateViewed(lowering.plan.view[aggregate]) { return LowerAggregate(state, function, source, .AggregateExtract, 1) }
    instruction := BeginInstruction(state, .AggregateExtract, source.origin)
    if VirtualOperand(state, GlobalVirtual(state, function, source.result), .Define) == MachineNoId ||
        VirtualOperand(state, lowering.view_address[aggregate], .Use) == MachineNoId ||
        !MemberOperands(state, function, source, 1) { return false }
    return FinishInstruction(state, instruction) != MachineNoId
}

// A changed view's insert replaces the member in place through the view's
// address, and putting the view back emits nothing.
LowerInsert :: (state: *LowerState, function: *MachineFunction, source: LirInstruction) -> bool {
    lowering := state.aggregates
    view := lowering.plan.view[source.result]
    if view == .PutBack { return true }
    // The member value was built where this view puts it.
    if lowering.plan.built_in_place[source.result] { return true }
    if view != .Changed { return LowerAggregate(state, function, source, .AggregateInsert, 2) }
    instruction := BeginInstruction(state, .AggregateInsert, source.origin)
    if VirtualOperand(state, lowering.view_address[source.result], .Use) == MachineNoId ||
        VirtualOperand(state, GlobalVirtual(state, function, source.operands[1]), .Use) == MachineNoId ||
        !MemberOperands(state, function, source, 2) { return false }
    return FinishInstruction(state, instruction) != MachineNoId
}

LowerInstruction :: (state: *LowerState, function: *MachineFunction,
    source: LirInstruction) -> bool {
    if !Spend(state, 1) { return false }
    if source.op == .Constant { return LowerConstant(state, function, source, .MoveImmediate) }
    if source.op == .Null { return LowerConstant(state, function, source, .MoveImmediate) }
    if source.op == .GlobalAddress && !state.checks {
        kind: MachineRelocationKind = ifx state.lir.globals[source.symbol].writable then .GlobalAddress else .ConstantAddress
        return LowerAddress(state, function, source, .GlobalAddress, .Global, kind)
    }
    if source.op == .GlobalAddress {
        // Global G is pointer slot 1 + G, version 0, from instance start.
        instruction := BeginInstruction(state, .MoveImmediate, source.origin)
        if VirtualOperand(state, GlobalVirtual(state, function, source.result), .Define) == MachineNoId ||
            ImmediateOperand(state, MachinePointerToken(1 + cast(s64)source.symbol, 0, 0)) == MachineNoId {
            return false
        }
        return FinishInstruction(state, instruction) != MachineNoId
    }
    if source.op == .FunctionAddress {
        return LowerAddress(state, function, source, .FunctionAddress, .Function, .FunctionAddress)
    }
    if source.op == .Negate || source.op == .BitNot || source.op == .SquareRoot { return LowerUnary(state, function, source) }
    if source.op == .Add || source.op == .Subtract || source.op == .Multiply || source.op == .Divide ||
        source.op == .Remainder || source.op == .BitAnd || source.op == .BitOr || source.op == .BitXor ||
        source.op == .ShiftLeft || source.op == .ShiftRight { return LowerBinary(state, function, source) }
    if source.op == .Equal || source.op == .NotEqual || source.op == .Less || source.op == .LessEqual ||
        source.op == .Greater || source.op == .GreaterEqual { return LowerCompare(state, function, source) }
    if source.op == .Convert { return LowerMove(state, function, source, .Convert) }
    if source.op == .Bitcast { return LowerMove(state, function, source, .Bitcast) }
    if Splits(state, source) { return true }
    // A forwarded extract stands for the value it reads.
    if source.op == .Extract && source.result >= 0 && state.aggregates.alias[source.result] != MachineNoId { return true }
    if source.op == .Aggregate && state.aggregates.plan.covered[source.result] { return true }
    if source.op == .Aggregate { return LowerMove(state, function, source, .AggregateBuild) }
    if source.op == .Extract { return LowerExtract(state, function, source) }
    if source.op == .Insert { return LowerInsert(state, function, source) }
    if source.op == .Allocate { return LowerAllocate(state, function, source) }
    if source.op == .Load {
        if state.fields.pointer[source.result] >= 0 {
            instruction := BeginInstruction(state, .Move, source.origin)
            return VirtualOperand(state, state.aggregates.view_address[source.result], .Define) != MachineNoId &&
                VirtualOperand(state, GlobalVirtual(state, function, state.fields.pointer[source.result]), .Use) != MachineNoId &&
                FinishInstruction(state, instruction) != MachineNoId
        }
        return LowerMemory(state, function, source, .Load)
    }
    if source.op == .Store { return LowerMemory(state, function, source, .Store) }
    if source.op == .Copy { return LowerMemory(state, function, source, .Copy) }
    if source.op == .Zero { return LowerMemory(state, function, source, .Zero) }
    if source.op == .FieldAddress { return LowerMemory(state, function, source, .FieldAddress) }
    if source.op == .ElementAddress { return LowerElement(state, function, source) }
    if source.op == .BytesEqual { return LowerBytesEqual(state, function, source) }
    if source.op == .Resize { return LowerResize(state, function, source) }
    if source.op == .Call || source.op == .CallIndirect || source.op == .HostCall {
        return LowerCall(state, function, source)
    }
    if source.op == .Fuel { return !state.options.fuel || LowerControl(state, function, source, .Fuel) }
    if source.op == .Trap { return LowerControl(state, function, source, .Trap) }
    if source.op == .Jump { return LowerControl(state, function, source, .Jump) }
    if source.op == .Branch { return LowerControl(state, function, source, .Branch) }
    if source.op == .Return { return LowerControl(state, function, source, .Return) }
    if source.op == .Unreachable { return LowerControl(state, function, source, .Unreachable) }
    return Fail(state, .Unsupported)
}

// Whether FUNCTION charges fuel outside its entry block: at a loop header.
Loops :: (source: LirFunction) -> bool {
    for block, block_index: source.blocks {
        if block_index == cast(s64)source.entry { continue }
        for instruction: block.instructions { if instruction.op == .Fuel { return true } }
    }
    return false
}

// A field of an invariant aggregate is read before the prefix. Split
// records already have exactly the field virtual we need.
VectorInput :: (state: *LowerState, function: *MachineFunction, source: LirFunction,
    reference: VectorReference) -> s32 {
    if reference.field == 0 { return GlobalVirtual(state, function, reference.value) }
    field := reference.field - 1
    root := reference.value
    if state.aggregates.plan.split[root] {
        return state.aggregates.fields[state.aggregates.field_begin[root] + field]
    }
    type := state.lir.types[source.values[root]].fields[field]
    result := AddVirtual(state, .{class = MachineAbiClass(state.lir, type), type = type,
        fixed_register = -1, stack_object = -1, origin = -1})
    instruction := BeginInstruction(state, .AggregateExtract, source.origin)
    input := GlobalVirtual(state, function, root)
    if MachineAggregateViewed(state.aggregates.plan.view[root]) { input = state.aggregates.view_address[root] }
    if VirtualOperand(state, result, .Define) < 0 || VirtualOperand(state, input, .Use) < 0 ||
        ImmediateOperand(state, cast(u64)field) < 0 || FinishInstruction(state, instruction) < 0 { return -1 }
    return result
}

VectorPrefix :: (state: *LowerState, function: *MachineFunction, source: LirFunction, loop: VectorLoop) -> bool {
    inputs := s32.[GlobalVirtual(state, function, loop.initial), GlobalVirtual(state, function, loop.limit),
        -1, -1, -1, -1]
    inputs[2] = GlobalVirtual(state, function, loop.seed)
    // Map/copy loops without a scalar operand use a lane-typed zero seed.
    if source.values[loop.seed] != loop.type {
        inputs[2] = AddVirtual(state, .{class = MachineAbiClass(state.lir, loop.type), type = loop.type,
            fixed_register = -1, stack_object = -1, origin = -1})
        zero := BeginInstruction(state, .MoveImmediate, source.origin)
        if VirtualOperand(state, inputs[2], .Define) < 0 || ImmediateOperand(state, 0,
            MachineAbiClass(state.lir, loop.type)) < 0 { return false }
        if MachineAbiClass(state.lir, loop.type) == .Float &&
            PhysicalOperand(state, MachineAbiScratchRegister(state.target), .Define) < 0 { return false }
        if FinishInstruction(state, zero) < 0 { return false }
    }
    inputs[3] = VectorInput(state, function, source, loop.source)
    inputs[4] = VectorInput(state, function, source, loop.right)
    inputs[5] = VectorInput(state, function, source, loop.destination)
    for input: inputs { if input < 0 { return false } }
    iv := AddVirtual(state, .{class = .General, type = source.values[loop.initial],
        fixed_register = -1, stack_object = -1, origin = -1})
    acc := AddVirtual(state, .{class = MachineAbiClass(state.lir, loop.type), type = loop.type,
        fixed_register = -1, stack_object = -1, origin = -1})
    instruction := BeginInstruction(state, .VectorLoop, source.origin)
    if VirtualOperand(state, iv, .Define) < 0 || VirtualOperand(state, acc, .Define) < 0 { return false }
    for input: inputs { if VirtualOperand(state, input, .Use) < 0 { return false } }
    metadata := cast(u64)loop.operation
    if loop.reduction { metadata |= VectorReduce }
    if loop.fill { metadata |= VectorFill }
    if loop.scalar_right { metadata |= VectorScalarRight }
    if loop.inclusive { metadata |= VectorInclusive }
    if ImmediateOperand(state, metadata) < 0 || FinishInstruction(state, instruction) < 0 { return false }
    state.vector_header = loop.header; state.vector_iv = loop.induction; state.vector_acc = loop.accumulator
    state.vector_iv_out = iv; state.vector_acc_out = acc
    function.virtual_count = cast(s32)state.owner.virtuals.count - function.virtual_begin
    return true
}

LowerFunction :: (state: *LowerState, function_id: s32) -> bool {
    source := state.lir.functions[function_id]
    if source.external { return true }
    vectors: VectorPlan
    defer VectorPlanFree(*vectors)
    if state.target.arch == .X86_64 && !state.checks && !state.options.fuel {
        vector_problem := VectorPlanBuild(*vectors, state.lir, source, state.remaining, state.limits.bytes)
        if vector_problem != .None { return Fail(state, ifx vector_problem == .Allocation then .Allocation else .Limit) }
        if !Spend(state, vectors.work) { return false }
    }
    function := state.owner.functions[function_id]
    // Views read and change members in place through x86-64 address
    // registers; other targets share storage only.
    problem := MachineAggregatePlanBuild(*state.aggregates.plan, state.lir, source, state.aggregates.stack_size[:],
        state.aggregates.size[:], state.target.arch == .X86_64,
        state.target.arch == .X86_64 && MachineAbiResultPointerRegister(state.target) >= 0,
        state.remaining, state.limits.bytes)
    if problem != .None { return Fail(state, problem) }
    if !Spend(state, state.aggregates.plan.work) { return false }
    if !VecResizeBounded(state.aggregates.alias, source.values.count, state.limits.bytes) { return Fail(state, .Allocation) }
    for at: cast(s64)0..source.values.count - 1 { state.aggregates.alias[at] = MachineNoId }
    // An unchecked store may write an immediate; a checked one names its
    // value so the checked-memory proof can size the access.
    x86 := state.target.arch == .X86_64
    problem = MachineSelectPlanBuild(state.select, state.lir, source, x86, x86 && !state.checks,
        state.remaining, state.limits.bytes)
    if problem != .None { return Fail(state, problem) }
    if !Spend(state, state.select.work) { return false }
    // Prefix operands must also materialize constants that scalar selection
    // would otherwise fold exclusively into immediates.
    for at: 0..vectors.loops.count - 1 {
        loop := vectors.loops[at]
        state.select.loaded[loop.initial] = true
        state.select.loaded[loop.limit] = true
        state.select.loaded[loop.seed] = true
    }
    problem = MachineFieldsPlanBuild(state.fields, source, *state.aggregates.plan, state.aggregates.stack_size[:],
        state.select.address_shift[:], x86 && !state.checks, state.remaining, state.limits.bytes)
    if problem != .None { return Fail(state, problem) }
    if !Spend(state, state.fields.work) || !CreateVirtuals(state, function_id) { return false }
    function = state.owner.functions[function_id]
    function.fuel_register = state.options.fuel && MachineAbiFuelRegister(state.target) >= 0 && Loops(source)
    function.result_register = state.aggregates.plan.result_placed
    if !ViewAddresses(state, *function, source) || !SplitFields(state, *function, source) ||
        !FoldZeroElements(state, *function, source) || !DropCovered(state, source) ||
        !ForwardExtracts(state, *function, source) { return false }
    ResolveAliasChains(state, *function)
    // A function that allocates keeps the frame arena's top at entry and
    // the head of its pointer chain in two frame words. Each `allocate` gets
    // its raw-storage virtual up front, so a direct access in any block it
    // dominates can name it.
    frame_raw := state.frame_raw
    if !VecResizeBounded(<<frame_raw, source.values.count, state.limits.bytes / 4) { return Fail(state, .Allocation) }
    for at: cast(s64)0..source.values.count - 1 { (<<frame_raw)[at] = MachineNoId }
    allocates := false
    for block: source.blocks {
        for instruction: block.instructions {
            if instruction.op != .Allocate { continue }
            allocates = true
            if !state.checks { continue }
            if instruction.result < 0 || instruction.result >= source.values.count { return Fail(state, .Virtual) }
            raw := RawVirtual(state, *function, GlobalVirtual(state, *function, instruction.result))
            if raw == MachineNoId { return false }
            (<<frame_raw)[instruction.result] = raw
        }
    }
    if allocates {
        // The arena mark, and with --checks the frame's slot chain.
        for at: 0..ifx state.checks then 1 else 0 {
            object := AddStack(state, .{function = function_id, kind = .Local, size = 8,
                alignment = 8, type = 0, origin = Origin(state, source.origin), value = MachineNoId})
            if object == MachineNoId { return false }
            relative := object - function.stack_begin + 1
            if at == 0 { function.arena_mark = relative } else { function.pointer_chain = relative }
        }
        function.stack_count = cast(s32)state.owner.stack_objects.count - function.stack_begin
    }
    function.block_begin = cast(s32)state.owner.blocks.count
    function.block_count = cast(s32)source.blocks.count
    // Blocks go in the selection plan's layout; each keeps its LIR block.
    for position: cast(s64)0..source.blocks.count - 1 {
        if AddBlock(state, .{function = function_id, lir_block = state.select.layout[position]}) == MachineNoId {
            return false
        }
    }
    function.entry = function.block_begin + state.select.position[source.entry]
    state.owner.functions[function_id] = function
    for position: cast(s64)0..source.blocks.count - 1 {
        block_id := cast(s64)state.select.layout[position]
        block_index := function.block_begin + cast(s32)position
        block := state.owner.blocks[block_index]
        block.instruction_begin = cast(s32)state.owner.instructions.count
        state.vector_header = -1
        state.vector_iv = -1
        state.vector_acc = -1
        state.select_block = cast(s32)block_id
        state.select_at = state.select.start[block_id]
        if state.select.dead[block_id] {
            // Every edge into it threads past it.
            unreachable := BeginInstruction(state, .Unreachable, source.origin)
            if FinishInstruction(state, unreachable) == MachineNoId { return false }
            state.select_at += source.blocks[block_id].instructions.count
        } else {
            for instruction, local: source.blocks[block_id].instructions {
                // Insert before the comparison feeding a branch, so flag
                // fusion and the original entry guard retain their order.
                insert_at := source.blocks[block_id].instructions.count - 1
                terminal := source.blocks[block_id].instructions[insert_at]
                if terminal.op == .Branch { insert_at -= 1 }
                if local == insert_at {
                    for vector_index: 0..vectors.loops.count - 1 {
                        loop := vectors.loops[vector_index]
                        if loop.preheader == block_id && state.select.pass[loop.header] < 0 &&
                            !VectorPrefix(state, *function, source, loop) { return false }
                    }
                }
                if !LowerInstruction(state, *function, instruction) { return false }
                state.select_at += 1
            }
        }
        block.instruction_count = cast(s32)state.owner.instructions.count - block.instruction_begin
        state.owner.blocks[block_index] = block
    }
    function.virtual_count = cast(s32)state.owner.virtuals.count - function.virtual_begin
    function.stack_count = cast(s32)state.owner.stack_objects.count - function.stack_begin
    state.owner.functions[function_id] = function
    return true
}

Finalize :: (state: *LowerState) {
    owner := state.owner
    owner.program = .{version = MachineVersion, target = state.target,
        text = owner.text[:], sources = owner.sources[:], origins = owner.origins[:],
        types = owner.types[:], type_ids = owner.type_ids[:], data = owner.data[:],
        constants = owner.constants[:], globals = owner.globals[:], initializers = owner.initializers[:],
        functions = owner.functions[:],
        blocks = owner.blocks[:], virtuals = owner.virtuals[:], instructions = owner.instructions[:],
        operands = owner.operands[:], edges = owner.edges[:], copies = owner.copies[:],
        stack_objects = owner.stack_objects[:], relocations = owner.relocations[:],
        calls = owner.calls[:], entry = state.lir.entry, stage = .Virtual,
        frames = owner.frames[:], spills = owner.spills[:],
        scratch_general = MachineNoId, scratch_float = MachineNoId, checks = state.checks,
        executable = state.options.executable}
}

Result :: (state: LowerState) -> MachineResult {
    return .{problem = state.problem, diagnostic = state.diagnostic,
        lir_diagnostic_problem = state.lir_diagnostic_problem,
        work = state.used, bytes = state.bytes}
}

#scope_export

MachineFree :: (owner: *MachineOwner) {
    if owner == null { return }
    owner.valid = false
    owner.program = .{version = MachineVersion, entry = MachineNoId}
    VecFree(owner.text)
    VecFree(owner.sources)
    VecFree(owner.origins)
    VecFree(owner.types)
    VecFree(owner.type_ids)
    VecFree(owner.data)
    VecFree(owner.constants)
    VecFree(owner.globals)
    VecFree(owner.initializers)
    VecFree(owner.functions)
    VecFree(owner.blocks)
    VecFree(owner.virtuals)
    VecFree(owner.instructions)
    VecFree(owner.operands)
    VecFree(owner.edges)
    VecFree(owner.copies)
    VecFree(owner.stack_objects)
    VecFree(owner.relocations)
    VecFree(owner.calls)
    VecFree(owner.frames)
    VecFree(owner.spills)
}

MachineProgramView :: (owner: *MachineOwner) -> MachineProgram {
    if owner == null || !owner.valid { return .{version = MachineVersion, entry = MachineNoId} }
    return owner.program
}

MachineLower :: (owner: *MachineOwner, program: LirProgram, target: TargetDescription,
    options: MachineOptions, limits: MachineLimits) -> MachineResult {
    state := LowerState.{.owner = owner, .lir = program, .target = target,
        .options = options, .limits = limits, .diagnostic = EmptyDiagnostic(),
        .remaining = limits.work}
    if owner == null { state.problem = .Owner; return Result(state) }
    MachineFree(owner)
    if !TargetValid(target) { state.problem = .Target; return Result(state) }
    if !TargetMachineLoweringSupported(target) {
        state.problem = .UnsupportedTarget
        return Result(state)
    }
    if limits.work < 0 || limits.bytes < 0 { state.problem = .Limit; return Result(state) }
    state.checks = program.checks
    lir_diagnostic := LirVerify(program, LirDefaultLimits())
    if lir_diagnostic.problem != .None {
        state.lir_diagnostic_problem = cast(s32)lir_diagnostic.problem
        state.problem = ifx lir_diagnostic.problem == .Unsupported then .Unsupported else .VerifyInput
        return Result(state)
    }
    // Facts are an optimization: a program too large to prove keeps every
    // check.
    proven: LirProvenOwner
    defer LirProvenFree(*proven)
    // The facts remove checks, so they matter only where some are kept.
    if state.checks || AnyChecked(program) { unused LirProvenBuild(*proven, program, LirDefaultLimits()) }
    state.proven = *proven
    frame_raw: Vec(s32)
    defer VecFree(frame_raw)
    state.frame_raw = *frame_raw
    aggregates: AggregateLowering
    defer AggregateLoweringFree(*aggregates)
    state.aggregates = *aggregates
    fields: MachineFieldsPlan
    defer MachineFieldsPlanFree(*fields)
    state.fields = *fields
    select: MachineSelectPlan
    defer MachineSelectPlanFree(*select)
    state.select = *select
    if !CopyMetadata(*state) || !CopyTypes(*state) || !AggregateTypes(*state) || !AddFunctionRecords(*state) {
        result := Result(state)
        MachineFree(owner)
        return result
    }
    for function_id: cast(s64)0..program.functions.count - 1 {
        if !LowerFunction(*state, cast(s32)function_id) {
            result := Result(state)
            MachineFree(owner)
            return result
        }
    }
    Finalize(*state)
    diagnostic := MachineVerify(owner.program, limits)
    if diagnostic.problem != .None {
        state.problem = diagnostic.problem
        state.diagnostic = diagnostic
        result := Result(state)
        MachineFree(owner)
        return result
    }
    owner.valid = true
    return Result(state)
}
