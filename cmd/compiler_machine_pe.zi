using Host :: #import "compiler_x86_host"
using Machine :: #import "compiler_machine_ir"
using Runtime :: #import "compiler_x86_runtime"
using Target :: #import "compiler_target"
using Vectors :: #import "std/vec"
using Win64 :: #import "compiler_x86_win64"
using X64 :: #import "compiler_x86_64"
using X64Image :: #import "compiler_x86_image"

// Deterministic PE32+ console executable for Windows x86-64 with the
// contents compiler_x86_image.zi lays out, carrying only what the program
// uses. A 64-byte MS-DOS header whose e_lfanew points just past it, the PE
// signature, the COFF and optional headers and its sections, at the smallest
// file alignment (512 bytes), with sections on their own pages so each keeps
// its protection:
//
//   * .text, read/execute: the entry stub, machine text and runtime;
//   * .rdata, read-only: the read-only globals, kernel32 and host DLL import
//     descriptors whose lookup and address tables name only the functions the
//     image calls, and the base relocations;
//   * .data, read/write, only when the program needs writable state: its
//     stored bytes, and the zero fill as virtual size past them.
//
// Positions are RVAs. Code is rip-relative throughout, so the image is
// DYNAMIC_BASE and HIGH_ENTROPY_VA with base relocations only for the
// pointer runtime's absolute addresses (an empty block when it has none, so
// the loader still rebases it), and NX_COMPAT. It asks for an 8 MiB stack
// reserved and committed whole, so a frame larger than a page needs no stack
// probe. No CRT, exports, TLS, resources or debug data. Every function with a
// prologue carries x64 unwind data: a .pdata RUNTIME_FUNCTION and the .xdata
// UNWIND_INFO that walks its pushed frame pointer and stack allocation.

// Registered DLL names and their named capabilities in function order.
MachinePeHosts :: struct {
    libraries: []string
    imports: []MachineX64HostImport
}

MachinePeImageBase :: 0x140000000
MachinePeSectionAlignment :: 4096
MachinePeFileAlignment :: 512
MachinePeStackBytes :: 0x800000
MachinePeTextRva :: 0x1000

// File offsets and RVAs; both are 0 for .data when the image has none.
MachinePeResult :: struct {
    diagnostic: MachineDiagnostic
    size: s64
    text_offset: s64
    text_rva: s64
    text_size: s64
    startup_size: s64
    data_offset: s64
    data_rva: s64
    data_size: s64
    // The kernel32 functions imported, as a MachineWin64ImportBit mask.
    imports: u32
}

#scope_file

DosHeaderSize :: 64
FileHeader :: 68
OptionalHeader :: 88
OptionalHeaderSize :: 240
SectionTable :: 328
SectionHeaderSize :: 40
// Five sections at most (.text, .rdata, .pdata, .xdata and .data) need a
// 1024-byte header region at the 512-byte file alignment.
HeadersSize :: 1024
ImportDescriptorSize :: 20
KernelName :: "KERNEL32.dll"

Section :: struct { rva: s64; size: s64; file: s64; raw: s64 }

Layout :: struct {
    image: MachineX64ImageLayout
    libraries: []string
    thunks: s64
    imports: u32
    import_count: s64
    directory: s64
    lookup: s64
    address: s64
    names: s64
    dll: s64
    relocations: s64
    relocations_size: s64
    text: Section
    rdata: Section
    pdata: Section
    xdata: Section
    unwind_count: s64
    data: Section
    sections: s64
    file_size: s64
    image_size: s64
}

NoDiagnostic :: () -> MachineDiagnostic {
    return .{problem = .None, function = MachineNoId, block = MachineNoId,
        instruction = MachineNoId, operand = MachineNoId, virtual = MachineNoId}
}

Failure :: (problem: MachineProblem) -> MachinePeResult {
    result := MachinePeResult.{diagnostic = NoDiagnostic()}
    result.diagnostic.problem = problem
    return result
}

Align :: (value: s64, alignment: s64) -> s64 {
    return (value + alignment - 1) & ~(alignment - 1)
}

PutLittle :: (output: []u8, at: s64, value: u64, count: s32) {
    for index: 0..count - 1 {
        output[at + index] = cast(u8)((value >> cast(u64)(index * 8)) & 255)
    }
}

PutText :: (output: []u8, at: s64, text: string) {
    for index: cast(s64)0..text.count - 1 { output[at + index] = cast(u8)text[index] }
}

Imported :: (layout: Layout, which: s64) -> bool {
    return (layout.imports & MachineWin64ImportBit(cast(MachineWin64Import)which)) != 0
}

// A hint/name entry: a zero hint, the name and its terminator, even-sized.
NameSize :: (which: s64) -> s64 {
    return Align(2 + MachineWin64ImportName(cast(MachineWin64Import)which).count + 1, 2)
}

// The base relocation blocks: one per page holding absolute fields, each
// field an IMAGE_REL_BASED_DIR64 entry, and a zero entry pads a block to
// four bytes; with no fields, one block of two zero entries. With an OUTPUT,
// writes them at AT. Returns their size.
Relocations :: (program: MachineProgram, image: MachineX64ImageLayout, output: []u8, at: s64) -> s64 {
    count := MachineX64AbsoluteFieldCount(program, image)
    if count == 0 {
        if output.count != 0 { PutLittle(output, at + 4, 12, 4) }
        return 12
    }
    size: s64 = 0
    index: s64 = 0
    while index < count {
        page := MachineX64AbsoluteField(program, image, index) & ~cast(s64)4095
        last := index
        while last < count && (MachineX64AbsoluteField(program, image, last) & ~cast(s64)4095) == page { last += 1 }
        block := 8 + Align(last - index, 2) * 2
        if output.count != 0 {
            PutLittle(output, at + size, cast(u64)page, 4)
            PutLittle(output, at + size + 4, cast(u64)block, 4)
            for entry: index..last - 1 {
                field := MachineX64AbsoluteField(program, image, entry)
                PutLittle(output, at + size + 8 + (entry - index) * 2, cast(u64)(0xa000 | (field & 4095)), 2)
            }
        }
        size += block
        index = last
    }
    return size
}

SectionAt :: (rva: s64, size: s64, file: s64, raw_bytes: s64) -> Section {
    return .{rva = rva, size = size, file = file, raw = Align(raw_bytes, MachinePeFileAlignment)}
}

PeLayout :: (program: MachineProgram, encoded: MachineX64Image, hosts: MachinePeHosts, layout: *Layout) -> MachineDiagnostic {
    image := *layout.image
    image.os = .Windows
    image.hosts = hosts.imports
    layout.libraries = hosts.libraries
    diagnostic := MachineX64ImageMeasure(program, encoded, image)
    if diagnostic.problem != .None { return diagnostic }
    image.text = MachinePeTextRva
    diagnostic = MachineX64ImageText(program, encoded, image)
    if diagnostic.problem != .None { return diagnostic }

    // .rdata: constants, the import directory and its tables, names, then
    // the base relocations. Data positions within a page do not depend on
    // where the page-aligned data lands, so the relocations are measured
    // before it is placed.
    rdata := Align(image.text_end, MachinePeSectionAlignment)
    image.constants = rdata
    layout.imports = MachineX64RuntimeImports(image.needs.runtime)
    for which: cast(s64)0..MachineWin64ImportCount - 1 {
        if Imported(<<layout, which) { layout.import_count += 1 }
    }
    layout.directory = Align(rdata + image.constants_size, 8)
    layout.thunks = layout.import_count + 1 + hosts.imports.count + hosts.libraries.count
    layout.lookup = layout.directory + (2 + hosts.libraries.count) * ImportDescriptorSize
    layout.address = layout.lookup + layout.thunks * 8
    layout.names = layout.address + layout.thunks * 8
    at := layout.names
    slot := layout.address
    for which: cast(s64)0..MachineWin64ImportCount - 1 {
        if !Imported(<<layout, which) { continue }
        image.imports.slots[which] = slot
        slot += 8
        at += NameSize(which)
    }
    layout.dll = at
    at = layout.dll + KernelName.count + 1
    slot += 8 // kernel32's terminating thunk
    for host: hosts.imports {
        if host.library < 0 || host.library >= hosts.libraries.count {
            diagnostic.problem = .Relocation; return diagnostic
        }
    }
    for library: cast(s64)0..hosts.libraries.count - 1 {
        name := hosts.libraries[library]
        if name.count == 0 || name.count > 4096 { diagnostic.problem = .Unsupported; return diagnostic }
        for byte: name {
            if byte < cast(u8)32 || byte == #char "/" || byte == #char "\\" || byte == #char ":" {
                diagnostic.problem = .Unsupported; return diagnostic
            }
        }
        for index: cast(s64)0..hosts.imports.count - 1 {
            host := hosts.imports[index]
            if host.library != library { continue }
            function := program.functions[host.function]
            if function.name_length <= 0 { diagnostic.problem = .Relocation; return diagnostic }
            hosts.imports[index].slot = slot
            slot += 8
            at = Align(at, 2)
            at += Align(2 + function.name_length + 1, 2)
        }
        slot += 8
        at += name.count + 1
    }
    layout.relocations = Align(at, 4)
    empty: []u8
    image.data = 0
    layout.relocations_size = Relocations(program, <<image, empty, 0)
    rdata_end := layout.relocations + layout.relocations_size

    // One .pdata entry and one .xdata record per function with a prologue. A
    // frameless leaf has no stack to unwind and no entry.
    layout.unwind_count = 0
    xdata_size: s64 = 0
    for function_id: cast(s64)0..encoded.functions.count - 1 {
        function := encoded.functions[function_id]
        if function.body <= function.begin { continue }
        if function.body - function.begin > 255 { diagnostic.problem = .Limit; return diagnostic }
        slots := UnwindSlots(program, function_id)
        if slots < 0 { diagnostic.problem = .Unsupported; return diagnostic }
        layout.unwind_count += 1
        xdata_size += Align(4 + slots * 2, 4)
    }
    end := rdata_end
    if layout.unwind_count > 0 {
        pdata_size := layout.unwind_count * 12
        pdata_rva := Align(end, MachinePeSectionAlignment)
        layout.pdata = SectionAt(pdata_rva, pdata_size, 0, pdata_size)
        layout.xdata = SectionAt(Align(pdata_rva + pdata_size, MachinePeSectionAlignment),
            xdata_size, 0, xdata_size)
        end = layout.xdata.rva + layout.xdata.size
    }
    image.data = Align(end, MachinePeSectionAlignment)
    // The image is laid out in memory by RVA before its sections are copied
    // into the file; without data nothing is stored there.
    image.data_file = ifx MachineX64ImageHasData(<<image) then image.data else 0

    data := image.data_layout
    layout.text = SectionAt(MachinePeTextRva, image.text_end - MachinePeTextRva, HeadersSize,
        image.text_end - MachinePeTextRva)
    layout.rdata = SectionAt(rdata, rdata_end - rdata, layout.text.file + layout.text.raw, rdata_end - rdata)
    layout.sections = 2
    layout.file_size = layout.rdata.file + layout.rdata.raw
    layout.image_size = Align(rdata_end, MachinePeSectionAlignment)
    if layout.unwind_count > 0 {
        layout.pdata.file = layout.file_size
        layout.xdata.file = layout.pdata.file + layout.pdata.raw
        layout.file_size = layout.xdata.file + layout.xdata.raw
        layout.image_size = Align(layout.xdata.rva + layout.xdata.size, MachinePeSectionAlignment)
        layout.sections += 2
    }
    if MachineX64ImageHasData(<<image) {
        layout.sections += 1
        layout.data = SectionAt(image.data, data.memory, layout.file_size, data.size)
        layout.file_size = layout.data.file + layout.data.raw
        layout.image_size = Align(image.data + data.memory, MachinePeSectionAlignment)
    }
    if layout.image_size > 2147483647 || layout.file_size > 2147483647 {
        diagnostic.problem = .Limit
        return diagnostic
    }
    return MachineX64ImageResolve(program, encoded, <<image)
}

// Kernel32 and host DLL descriptors, a null one after them, and the lookup and
// address tables, which hold the same hint/name RVAs until the loader binds
// the address table.
WriteImports :: (program: MachineProgram, layout: Layout, output: []u8) {
    PutLittle(output, layout.directory, cast(u64)layout.lookup, 4)
    PutLittle(output, layout.directory + 12, cast(u64)layout.dll, 4)
    PutLittle(output, layout.directory + 16, cast(u64)layout.address, 4)
    entry: s64 = 0
    name := layout.names
    for which: cast(s64)0..MachineWin64ImportCount - 1 {
        if !Imported(layout, which) { continue }
        PutLittle(output, layout.lookup + entry * 8, cast(u64)name, 8)
        PutLittle(output, layout.address + entry * 8, cast(u64)name, 8)
        PutText(output, name + 2, MachineWin64ImportName(cast(MachineWin64Import)which))
        name += NameSize(which)
        entry += 1
    }
    PutText(output, layout.dll, KernelName)
    lookup := layout.lookup + (layout.import_count + 1) * 8
    address := layout.address + (layout.import_count + 1) * 8
    name = layout.dll + KernelName.count + 1
    for library: cast(s64)0..layout.libraries.count - 1 {
        descriptor := layout.directory + (library + 1) * ImportDescriptorSize
        PutLittle(output, descriptor, cast(u64)lookup, 4)
        PutLittle(output, descriptor + 16, cast(u64)address, 4)
        for host: layout.image.hosts {
            if host.library != library { continue }
            function := program.functions[host.function]
            symbol := program.text[function.name_offset:function.name_offset + function.name_length]
            name = Align(name, 2)
            PutLittle(output, lookup, cast(u64)name, 8)
            PutLittle(output, address, cast(u64)name, 8)
            for index: cast(s64)0..symbol.count - 1 { output[name + 2 + index] = symbol[index] }
            name += Align(2 + symbol.count + 1, 2)
            lookup += 8; address += 8
        }
        lookup += 8; address += 8
        PutLittle(output, descriptor + 12, cast(u64)name, 4)
        PutText(output, name, layout.libraries[library])
        name += layout.libraries[library].count + 1
    }
}

SectionHeader :: (output: []u8, index: s64, name: string, section: Section, characteristics: u64) {
    at := SectionTable + index * SectionHeaderSize
    PutText(output, at, name)
    PutLittle(output, at + 8, cast(u64)section.size, 4)
    PutLittle(output, at + 12, cast(u64)section.rva, 4)
    PutLittle(output, at + 16, cast(u64)section.raw, 4)
    PutLittle(output, at + 20, cast(u64)section.file, 4)
    PutLittle(output, at + 36, characteristics, 4)
}

DataDirectory :: (output: []u8, index: s64, rva: s64, size: s64) {
    at := OptionalHeader + 112 + index * 8
    PutLittle(output, at, cast(u64)rva, 4)
    PutLittle(output, at + 4, cast(u64)size, 4)
}

// The UNWIND_CODE slots for FUNCTION's prologue: the pushed frame pointer,
// the frame register, and the stack allocation when it has one. Returns -1
// for an allocation no unwind code can describe.
UnwindSlots :: (program: MachineProgram, function_id: s64) -> s64 {
    size := program.frames[function_id].size
    if size == 0 { return 2 }
    if size < 0 || size % 8 != 0 { return -1 }
    if size <= 128 { return 3 }
    if size / 8 <= 65535 { return 4 }
    return 5
}

// The .pdata entries, in function order, and the .xdata record each names.
// A record describes the prologue in reverse: the stack allocation, the
// frame register, then the pushed RBP. Code offsets are the ends of those
// instructions, and the frame pointer is RBP at offset zero because
// `mov rbp, rsp` follows the push. The frame starts where the encoder says
// it does: an early return can leave before any frame exists, so the push
// is not always the function's first byte.
WriteUnwind :: (program: MachineProgram, encoded: MachineX64Image, layout: Layout, output: []u8) {
    entry := layout.pdata.rva
    at := layout.xdata.rva
    for function_id: cast(s64)0..encoded.functions.count - 1 {
        function := encoded.functions[function_id]
        if function.body <= function.begin { continue }
        slots := UnwindSlots(program, function_id)
        size := program.frames[function_id].size
        frame := function.frame - function.begin
        code := MachinePeTextRva + layout.image.startup_size + function.begin
        PutLittle(output, entry, cast(u64)code, 4)
        PutLittle(output, entry + 4, cast(u64)(MachinePeTextRva + layout.image.startup_size + function.end), 4)
        PutLittle(output, entry + 8, cast(u64)at, 4)
        entry += 12
        output[at] = 1
        output[at + 1] = cast(u8)(function.body - function.begin)
        output[at + 2] = cast(u8)slots
        output[at + 3] = 5
        slot := at + 4
        if size > 0 {
            output[slot] = cast(u8)(frame + 4 + (ifx size <= 127 then 4 else 7))
            if size <= 128 {
                output[slot + 1] = cast(u8)((size / 8 - 1) << 4 | 2)
                slot += 2
            } else if size / 8 <= 65535 {
                output[slot + 1] = 1
                PutLittle(output, slot + 2, cast(u64)(size / 8), 2)
                slot += 4
            } else {
                output[slot + 1] = cast(u8)((1 << 4) | 1)
                PutLittle(output, slot + 2, cast(u64)(size / 8), 4)
                slot += 6
            }
        }
        output[slot] = cast(u8)(frame + 4); output[slot + 1] = 3; slot += 2
        output[slot] = cast(u8)(frame + 1); output[slot + 1] = cast(u8)((5 << 4) | 0); slot += 2
        used := 4 + slots * 2
        end := at + Align(used, 4)
        for pad: at + used..end - 1 { output[pad] = 0 }
        at = end
    }
}

WriteHeaders :: (layout: Layout, output: []u8) {
    // MS-DOS header: the signature and e_lfanew only.
    output[0] = 77; output[1] = 90
    PutLittle(output, 60, DosHeaderSize, 4)
    PutText(output, DosHeaderSize, "PE")

    // COFF: AMD64, its sections, an executable large-address-aware image.
    PutLittle(output, FileHeader, 0x8664, 2)
    PutLittle(output, FileHeader + 2, cast(u64)layout.sections, 2)
    PutLittle(output, FileHeader + 16, OptionalHeaderSize, 2)
    PutLittle(output, FileHeader + 18, 0x0022, 2)

    // PE32+ optional header: a Windows 6.0 console subsystem image.
    at := cast(s64)OptionalHeader
    PutLittle(output, at, 0x20b, 2)
    PutLittle(output, at + 4, cast(u64)layout.text.raw, 4)
    PutLittle(output, at + 8, cast(u64)(layout.rdata.raw + layout.pdata.raw + layout.xdata.raw + layout.data.raw), 4)
    PutLittle(output, at + 16, MachinePeTextRva, 4)
    PutLittle(output, at + 20, MachinePeTextRva, 4)
    PutLittle(output, at + 24, MachinePeImageBase, 8)
    PutLittle(output, at + 32, MachinePeSectionAlignment, 4)
    PutLittle(output, at + 36, MachinePeFileAlignment, 4)
    PutLittle(output, at + 40, 6, 2)
    PutLittle(output, at + 48, 6, 2)
    PutLittle(output, at + 56, cast(u64)layout.image_size, 4)
    PutLittle(output, at + 60, HeadersSize, 4)
    PutLittle(output, at + 68, 3, 2)
    // HIGH_ENTROPY_VA, DYNAMIC_BASE, NX_COMPAT, TERMINAL_SERVER_AWARE.
    PutLittle(output, at + 70, 0x8160, 2)
    PutLittle(output, at + 72, MachinePeStackBytes, 8)
    PutLittle(output, at + 80, MachinePeStackBytes, 8)
    PutLittle(output, at + 88, 0x100000, 8)
    PutLittle(output, at + 96, 0x1000, 8)
    PutLittle(output, at + 108, 16, 4)
    DataDirectory(output, 1, layout.directory, (2 + layout.libraries.count) * ImportDescriptorSize)
    if layout.unwind_count > 0 {
        DataDirectory(output, 3, layout.pdata.rva, layout.unwind_count * 12)
    }
    DataDirectory(output, 5, layout.relocations, layout.relocations_size)
    DataDirectory(output, 12, layout.address, layout.thunks * 8)

    SectionHeader(output, 0, ".text", layout.text, 0x60000020)
    SectionHeader(output, 1, ".rdata", layout.rdata, 0x40000040)
    index := 2
    if layout.unwind_count > 0 {
        SectionHeader(output, index, ".pdata", layout.pdata, 0x40000040)
        index += 1
        SectionHeader(output, index, ".xdata", layout.xdata, 0x40000040)
        index += 1
    }
    if layout.sections > index { SectionHeader(output, index, ".data", layout.data, 0xc0000040) }
}

CopySection :: (output: []u8, memory: []u8, section: Section, stored: s64) {
    for index: cast(s64)0..stored - 1 { output[section.file + index] = memory[section.rva + index] }
}

// Lays the image out in memory by RVA, then copies its sections into the
// file.
Write :: (program: MachineProgram, encoded: MachineX64Image, layout: Layout, output: []u8, fuel: s64) -> MachineProblem {
    memory_size := layout.rdata.rva + layout.rdata.size
    if layout.unwind_count > 0 { memory_size = layout.xdata.rva + layout.xdata.size }
    if layout.data.size > 0 { memory_size = layout.data.rva + layout.image.data_layout.size }
    memory: Vec(u8)
    defer VecFree(memory)
    if !VecResizeBounded(memory, memory_size, memory_size) { return .Allocation }
    if !MachineX64ImageWrite(program, encoded, layout.image, memory[:], MachinePeImageBase, fuel) {
        return .Relocation
    }
    WriteImports(program, layout, memory[:])
    unused Relocations(program, layout.image, memory[:], layout.relocations)
    WriteUnwind(program, encoded, layout, memory[:])
    for index: cast(s64)0..output.count - 1 { output[index] = 0 }
    WriteHeaders(layout, output)
    CopySection(output, memory[:], layout.text, layout.text.size)
    CopySection(output, memory[:], layout.rdata, layout.rdata.size)
    if layout.unwind_count > 0 {
        CopySection(output, memory[:], layout.pdata, layout.pdata.size)
        CopySection(output, memory[:], layout.xdata, layout.xdata.size)
    }
    if layout.data.size > 0 { CopySection(output, memory[:], layout.data, layout.image.data_layout.size) }
    return .None
}

#scope_export

// Empty OUTPUT measures. A non-empty OUTPUT must have exactly the measured
// length. Verification, complete relocation resolution and i32 range checks
// all finish before the first output byte is changed.
MachinePeEncode :: (program: MachineProgram, encoded: MachineX64Image, output: []u8,
    fuel: s64 = MachineX64InitialFuel, hosts: MachinePeHosts = .{}) -> MachinePeResult {
    if fuel < 0 { return Failure(.Fuel) }
    layout: Layout
    diagnostic := PeLayout(program, encoded, hosts, *layout)
    if diagnostic.problem != .None { return .{diagnostic = diagnostic} }
    result := MachinePeResult.{diagnostic = diagnostic, size = layout.file_size,
        text_offset = layout.text.file, text_rva = layout.text.rva, text_size = layout.text.size,
        startup_size = layout.image.startup_size, data_offset = layout.data.file, data_rva = layout.data.rva,
        data_size = layout.image.data_layout.size,
        imports = layout.imports}
    if output.count == 0 { return result }
    if output.count != layout.file_size { return Failure(.Limit) }
    problem := Write(program, encoded, layout, output, fuel)
    if problem != .None { return Failure(problem) }
    return result
}

#scope_file

// Bounded inspection of direct named exports in an AMD64 PE32+ DLL. This
// reads the file; it never loads or executes a candidate host library.
Inside :: (at: u64, size: u64, count: s64) -> bool {
    return at <= cast(u64)count && size <= cast(u64)count - at
}

Read :: (bytes: []u8, at: s64, count: s64) -> u64 {
    result: u64 = 0
    for index: cast(s64)0..count - 1 {
        result |= cast(u64)bytes[at + index] << cast(u64)(index * 8)
    }
    return result
}

RvaOffset :: (bytes: []u8, table: s64, sections: s64, rva: u64, size: u64,
    executable: bool = false) -> s64 {
    for index: cast(s64)0..sections - 1 {
        at := table + index * 40
        base := Read(bytes, at + 12, 4)
        raw := Read(bytes, at + 16, 4)
        if rva < base || rva - base > raw || size > raw - (rva - base) { continue }
        offset := Read(bytes, at + 20, 4) + rva - base
        if !Inside(offset, size, bytes.count) { return -1 }
        if executable && (Read(bytes, at + 36, 4) & 0x20000000) == 0 { return -1 }
        return cast(s64)offset
    }
    return -1
}

#scope_export

MachinePeLibraryDefines :: (library: []u8, name: string) -> bool {
    if library.count < 64 || name.count == 0 || library[0] != 77 || library[1] != 90 { return false }
    header := Read(library, 60, 4)
    if !Inside(header, 24, library.count) { return false }
    at := cast(s64)header
    optional := at + 24
    optional_size := cast(s64)Read(library, at + 20, 2)
    if Read(library, at, 4) != 0x4550 || Read(library, at + 4, 2) != 0x8664 ||
        (Read(library, at + 22, 2) & 0x2000) == 0 || optional_size < 120 ||
        !Inside(cast(u64)optional, cast(u64)optional_size, library.count) ||
        Read(library, optional, 2) != 0x20b || Read(library, optional + 108, 4) < 1 { return false }
    sections := cast(s64)Read(library, at + 6, 2)
    table := optional + optional_size
    if !Inside(cast(u64)table, cast(u64)sections * 40, library.count) { return false }
    export_rva := Read(library, optional + 112, 4)
    directory := RvaOffset(library, table, sections, export_rva, 40)
    if export_rva == 0 || directory < 0 { return false }
    functions := Read(library, directory + 20, 4)
    count := cast(s64)Read(library, directory + 24, 4)
    addresses := RvaOffset(library, table, sections, Read(library, directory + 28, 4), functions * 4)
    names := RvaOffset(library, table, sections, Read(library, directory + 32, 4), cast(u64)count * 4)
    ordinals := RvaOffset(library, table, sections, Read(library, directory + 36, 4), cast(u64)count * 2)
    if addresses < 0 || names < 0 || ordinals < 0 { return false }
    for index: cast(s64)0..count - 1 {
        position := RvaOffset(library, table, sections, Read(library, names + index * 4, 4), cast(u64)name.count + 1)
        if position < 0 { continue }
        same := library[position + name.count] == 0
        for byte: cast(s64)0..name.count - 1 {
            same = same && library[position + byte] == cast(u8)name[byte]
        }
        if !same { continue }
        ordinal := Read(library, ordinals + index * 2, 2)
        if ordinal >= functions { return false }
        address := Read(library, addresses + cast(s64)ordinal * 4, 4)
        // Forwarders require resolving another DLL; only direct function
        // exports are providers here. Zero entries and data are not callable.
        export_size := Read(library, optional + 116, 4)
        if address == 0 || address >= export_rva && address - export_rva < export_size { return false }
        return RvaOffset(library, table, sections, address, 1, true) >= 0
    }
    return false
}
