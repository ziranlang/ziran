// Owner for one complete direct machine pipeline. The borrowed executable
// view stays valid until the next successful MachineNativeBuild or
// MachineNativeFree.
MachineNativeOwner :: struct {
    valid: bool
    image: []u8
    machine: MachineOwner
    encoded: MachineX64Owner
    encoded_a64: MachineA64Owner
    encoded_v7: MachineV7Owner
    executable: Vec(u8)
}

#scope_file

NoDiagnostic :: () -> MachineDiagnostic {
    return .{problem = .None, function = MachineNoId, block = MachineNoId,
        instruction = MachineNoId, operand = MachineNoId, virtual = MachineNoId}
}

Problem :: (problem: MachineProblem) -> MachineDiagnostic {
    result := NoDiagnostic()
    result.problem = problem
    return result
}

LowerDiagnostic :: (result: MachineResult) -> MachineDiagnostic {
    diagnostic := result.diagnostic
    if diagnostic.problem == .None { diagnostic.problem = result.problem }
    return diagnostic
}

// Infallibly exchanges complete owners. Their borrowed program/image views
// move with the vectors they describe; BUILT receives the prior output and is
// released only after OUTPUT owns the fully completed native image.
NativeExchange :: (owner: *MachineNativeOwner, built: *MachineNativeOwner) {
    valid := owner.valid; owner.valid = built.valid; built.valid = valid

    machine_valid := owner.machine.valid
    owner.machine.valid = built.machine.valid
    built.machine.valid = machine_valid
    program := owner.machine.program
    owner.machine.program = built.machine.program
    built.machine.program = program
    VecSwap(owner.machine.text, built.machine.text)
    VecSwap(owner.machine.sources, built.machine.sources)
    VecSwap(owner.machine.origins, built.machine.origins)
    VecSwap(owner.machine.types, built.machine.types)
    VecSwap(owner.machine.type_ids, built.machine.type_ids)
    VecSwap(owner.machine.data, built.machine.data)
    VecSwap(owner.machine.constants, built.machine.constants)
    VecSwap(owner.machine.globals, built.machine.globals)
    VecSwap(owner.machine.initializers, built.machine.initializers)
    VecSwap(owner.machine.functions, built.machine.functions)
    VecSwap(owner.machine.blocks, built.machine.blocks)
    VecSwap(owner.machine.virtuals, built.machine.virtuals)
    VecSwap(owner.machine.instructions, built.machine.instructions)
    VecSwap(owner.machine.operands, built.machine.operands)
    VecSwap(owner.machine.edges, built.machine.edges)
    VecSwap(owner.machine.copies, built.machine.copies)
    VecSwap(owner.machine.stack_objects, built.machine.stack_objects)
    VecSwap(owner.machine.relocations, built.machine.relocations)
    VecSwap(owner.machine.calls, built.machine.calls)
    VecSwap(owner.machine.frames, built.machine.frames)
    VecSwap(owner.machine.spills, built.machine.spills)

    encoded_valid := owner.encoded.valid
    owner.encoded.valid = built.encoded.valid
    built.encoded.valid = encoded_valid
    image := owner.encoded.image
    owner.encoded.image = built.encoded.image
    built.encoded.image = image
    VecSwap(owner.encoded.code, built.encoded.code)
    VecSwap(owner.encoded.functions, built.encoded.functions)
    VecSwap(owner.encoded.blocks, built.encoded.blocks)
    VecSwap(owner.encoded.instructions, built.encoded.instructions)
    VecSwap(owner.encoded.relocations, built.encoded.relocations)
    machine_image_valid := owner.encoded.machine_image.valid
    owner.encoded.machine_image.valid = built.encoded.machine_image.valid
    built.encoded.machine_image.valid = machine_image_valid
    machine_image := owner.encoded.machine_image.image
    owner.encoded.machine_image.image = built.encoded.machine_image.image
    built.encoded.machine_image.image = machine_image
    VecSwap(owner.encoded.machine_image.code, built.encoded.machine_image.code)
    VecSwap(owner.encoded.machine_image.constants, built.encoded.machine_image.constants)
    VecSwap(owner.encoded.machine_image.data, built.encoded.machine_image.data)
    VecSwap(owner.encoded.machine_image.function_offsets, built.encoded.machine_image.function_offsets)
    VecSwap(owner.encoded.machine_image.global_offsets, built.encoded.machine_image.global_offsets)
    VecSwap(owner.encoded.machine_image.constant_offsets, built.encoded.machine_image.constant_offsets)
    VecSwap(owner.encoded.machine_image.initializers, built.encoded.machine_image.initializers)
    VecSwap(owner.encoded.machine_image.relocations, built.encoded.machine_image.relocations)

    encoded_a64_valid := owner.encoded_a64.valid
    owner.encoded_a64.valid = built.encoded_a64.valid
    built.encoded_a64.valid = encoded_a64_valid
    image_a64 := owner.encoded_a64.image
    owner.encoded_a64.image = built.encoded_a64.image
    built.encoded_a64.image = image_a64
    VecSwap(owner.encoded_a64.code, built.encoded_a64.code)
    VecSwap(owner.encoded_a64.functions, built.encoded_a64.functions)
    VecSwap(owner.encoded_a64.blocks, built.encoded_a64.blocks)
    VecSwap(owner.encoded_a64.instructions, built.encoded_a64.instructions)
    VecSwap(owner.encoded_a64.relocations, built.encoded_a64.relocations)
    machine_image_a64_valid := owner.encoded_a64.machine_image.valid
    owner.encoded_a64.machine_image.valid = built.encoded_a64.machine_image.valid
    built.encoded_a64.machine_image.valid = machine_image_a64_valid
    machine_image_a64 := owner.encoded_a64.machine_image.image
    owner.encoded_a64.machine_image.image = built.encoded_a64.machine_image.image
    built.encoded_a64.machine_image.image = machine_image_a64
    VecSwap(owner.encoded_a64.machine_image.code, built.encoded_a64.machine_image.code)
    VecSwap(owner.encoded_a64.machine_image.constants, built.encoded_a64.machine_image.constants)
    VecSwap(owner.encoded_a64.machine_image.data, built.encoded_a64.machine_image.data)
    VecSwap(owner.encoded_a64.machine_image.function_offsets, built.encoded_a64.machine_image.function_offsets)
    VecSwap(owner.encoded_a64.machine_image.global_offsets, built.encoded_a64.machine_image.global_offsets)
    VecSwap(owner.encoded_a64.machine_image.constant_offsets, built.encoded_a64.machine_image.constant_offsets)
    VecSwap(owner.encoded_a64.machine_image.initializers, built.encoded_a64.machine_image.initializers)
    VecSwap(owner.encoded_a64.machine_image.relocations, built.encoded_a64.machine_image.relocations)

    MachineV7Exchange(*owner.encoded_v7, *built.encoded_v7)

    VecSwap(owner.executable, built.executable)
    native_image := owner.image; owner.image = built.image; built.image = native_image
}

// The executable container's size, or its diagnostic: a PE on Windows, an
// ELF on Linux. An empty OUTPUT measures.
Encoded :: struct { diagnostic: MachineDiagnostic; size: s64 }

ExecutableEncode :: (program: MachineProgram, image: MachineX64Image, output: []u8, fuel: s64,
    hosts: MachineElfHosts) -> Encoded {
    if program.target.os == .Windows {
        pe := MachinePeEncode(program, image, output, fuel,
            .{libraries = hosts.libraries, imports = hosts.imports, builtins = hosts.builtins})
        return .{diagnostic = pe.diagnostic, size = pe.size}
    }
    elf := MachineElfEncode(program, image, output, fuel, hosts)
    return .{diagnostic = elf.diagnostic, size = elf.size}
}

// The imports of every host function of PROGRAM, in function order: the
// capabilities the libraries LINKS names provide fill IMPORTS, and the
// services the executable supplies itself (MachineX64HostBuiltin) fill
// BUILTINS; both are in function order. A host function no provider names
// fails with its function named.
HostImports :: (lir: LirProgram, program: MachineProgram, links: MachineHostLinks,
    imports: *Vec(MachineX64HostImport), builtins: *Vec(MachineX64HostImport)) -> MachineDiagnostic {
    for function_id: cast(s64)0..program.functions.count - 1 {
        if program.functions[function_id].calling != .Host { continue }
        provider: s32 = -1
        if function_id < links.providers.count { provider = links.providers[function_id] }
        builtin := provider == Host.MachineX64HostBuiltin
        if function_id >= lir.functions.count ||
            !builtin && (provider < 0 || cast(s64)provider >= links.libraries.count) {
            diagnostic := Problem(.Unsupported)
            diagnostic.function = cast(s32)function_id
            return diagnostic
        }
        source := lir.functions[function_id]
        target := ifx builtin then builtins else imports
        if !VecPush(<<target, MachineX64HostImport.{function = cast(s32)function_id, library = provider,
            parameters = source.parameters, result = source.result}) { return Problem(.Allocation) }
    }
    return NoDiagnostic()
}

// The SSA virtual an operand names in either stage.
ValueOf :: (operand: MachineOperand) -> s32 {
    return ifx operand.kind == .Virtual then operand.id else operand.value
}

#scope_export

// Checked-access counts of a lowered program: pointer resolves left in the
// code, accesses the verifier proved need none (by the root their base
// starts), element index checks left, and element indices the shared facts
// prove.
MachineChecks :: struct {
    resolves: s64
    direct_global: s64
    direct_frame: s64
    index_checks: s64
    index_proven: s64
}

MachineCheckCount :: (program: MachineProgram) -> MachineChecks {
    counts: MachineChecks
    // A direct access's base is defined by a GlobalAddress for a global.
    globals: Vec(u8)
    defer VecFree(globals)
    if !VecResizeBounded(globals, program.virtuals.count, program.virtuals.count) { return counts }
    for at: cast(s64)0..globals.count - 1 { globals[at] = 0 }
    for instruction: program.instructions {
        if instruction.opcode != .GlobalAddress || instruction.operand_count < 1 { continue }
        value := ValueOf(program.operands[instruction.operand_begin])
        if value >= 0 && value < globals.count { globals[value] = 1 }
    }
    for instruction: program.instructions {
        if instruction.opcode == .PointerResolve { counts.resolves += 1 }
        if instruction.opcode == .ElementAddress {
            proven := instruction.operand_count == 4 &&
                program.operands[instruction.operand_begin + 3].kind == .Immediate
            if proven { counts.index_proven += 1 } else { counts.index_checks += 1 }
        }
        if instruction.opcode != .PointerDirect || instruction.operand_count < 3 { continue }
        base := ValueOf(program.operands[instruction.operand_begin + 2])
        if base >= 0 && base < globals.count && globals[base] != 0 { counts.direct_global += 1 }
        else { counts.direct_frame += 1 }
    }
    return counts
}

#scope_export

MachineNativeFree :: (owner: *MachineNativeOwner) {
    if owner == null { return }
    owner.valid = false
    empty: []u8
    owner.image = empty
    MachineFree(*owner.machine)
    MachineX64Free(*owner.encoded)
    MachineA64Free(*owner.encoded_a64)
    MachineV7Free(*owner.encoded_v7)
    VecFree(owner.executable)
}

MachineNativeView :: (owner: *MachineNativeOwner) -> []u8 {
    if owner == null || !owner.valid { empty: []u8; return empty }
    return owner.image
}

MachineCodeImageView :: (owner: *MachineNativeOwner) -> MachineImage {
    if owner == null || !owner.valid { return .{version = MachineImageVersion, entry = MachineNoId} }
    if owner.encoded_a64.valid { return MachineA64MachineView(*owner.encoded_a64) }
    if owner.encoded_v7.valid { return MachineV7MachineView(*owner.encoded_v7) }
    return MachineX64MachineView(*owner.encoded)
}

// Transactional MachineLower -> RegAllocAllocate -> MachineX64Encode, with an
// optional AOT executable. A failure leaves OUTPUT unchanged.
Build :: (lir: LirProgram, target: TargetDescription, limits: MachineLimits,
    output: *MachineNativeOwner, emit_executable: bool, fuel: s64, links: MachineHostLinks) -> MachineDiagnostic {
    if output == null { return Problem(.Owner) }
    built: MachineNativeOwner
    options := MachineDefaultOptions()
    // Code charges fuel unless its budget is the unbounded one: an AOT
    // executable started without a budget, or code a host runs unmetered.
    options.fuel = fuel != MachineX64InitialFuel
    options.executable = emit_executable
    lowered := MachineLower(*built.machine, lir, target, options, limits)
    if lowered.problem != .None {
        diagnostic := LowerDiagnostic(lowered)
        MachineNativeFree(*built)
        return diagnostic
    }
    diagnostic := RegAllocAllocate(*built.machine, target, limits)
    if diagnostic.problem != .None { MachineNativeFree(*built); return diagnostic }
    program := MachineProgramView(*built.machine)
    if target.arch == .AArch64 || target.arch == .ArmV7 {
        if target.arch == .ArmV7 { diagnostic = MachineV7EncodeAllocated(program, limits, *built.encoded_v7) }
        else { diagnostic = MachineA64EncodeAllocated(program, limits, *built.encoded_a64) }
        if diagnostic.problem != .None { MachineNativeFree(*built); return diagnostic }
        if emit_executable {
            if links.libraries.count > 0 { MachineNativeFree(*built); return Problem(.Unsupported) }
            empty: [0]u8
            measured: MachineA64ElfResult
            if target.arch == .AArch64 {
                encoded := MachineA64View(*built.encoded_a64)
                extents: Vec(A64Elf.MachineA64ElfFunction)
                if !VecResizeBounded(extents, encoded.functions.count, encoded.functions.count) {
                    MachineNativeFree(*built)
                    return Problem(.Allocation)
                }
                for index: cast(s64)0..encoded.functions.count - 1 {
                    extents[index] = .{begin = encoded.functions[index].begin,
                        body = encoded.functions[index].body, end = encoded.functions[index].end}
                }
                defer VecFree(extents)
                code := MachineA64ElfCode.{code = encoded.code, functions = extents[:],
                    relocations = A64.MachineA64MachineView(*built.encoded_a64).relocations,
                    entry = encoded.entry}
                measured = MachineA64ElfEncode(program, code, empty[:])
                diagnostic = measured.diagnostic
                if diagnostic.problem == .None && (measured.size <= 0 || measured.size > limits.bytes ||
                    !VecResizeBounded(built.executable, measured.size, limits.bytes)) {
                    diagnostic = Problem(ifx measured.size > limits.bytes then MachineProblem.Limit else MachineProblem.Allocation)
                }
                if diagnostic.problem == .None {
                    written := MachineA64ElfEncode(program, code, built.executable[:])
                    diagnostic = written.diagnostic
                    if diagnostic.problem == .None && written.size != measured.size { diagnostic = Problem(.Relocation) }
                }
            } else {
                encoded := MachineV7View(*built.encoded_v7)
                extents: Vec(V7Elf.MachineV7ElfFunction)
                if !VecResizeBounded(extents, encoded.functions.count, encoded.functions.count) {
                    MachineNativeFree(*built)
                    return Problem(.Allocation)
                }
                for index: cast(s64)0..encoded.functions.count - 1 {
                    extents[index] = .{begin = encoded.functions[index].begin,
                        body = encoded.functions[index].body, end = encoded.functions[index].end}
                }
                defer VecFree(extents)
                code := V7Elf.MachineV7ElfCode.{code = encoded.code, functions = extents[:],
                    relocations = V7.MachineV7MachineView(*built.encoded_v7).relocations,
                    entry = encoded.entry}
                result := V7Elf.MachineV7ElfEncode(program, code, empty[:])
                diagnostic = result.diagnostic
                if diagnostic.problem == .None && (result.size <= 0 || result.size > limits.bytes ||
                    !VecResizeBounded(built.executable, result.size, limits.bytes)) {
                    diagnostic = Problem(ifx result.size > limits.bytes then MachineProblem.Limit else MachineProblem.Allocation)
                }
                if diagnostic.problem == .None {
                    written := V7Elf.MachineV7ElfEncode(program, code, built.executable[:])
                    diagnostic = written.diagnostic
                    if diagnostic.problem == .None && written.size != result.size { diagnostic = Problem(.Relocation) }
                }
            }
            if diagnostic.problem != .None { MachineNativeFree(*built); return diagnostic }
            built.image = built.executable[:]
        }
        built.valid = true
        NativeExchange(output, *built)
        MachineNativeFree(*built)
        return NoDiagnostic()
    }
    // Allocation verified PROGRAM; the encoders do not verify it again.
    diagnostic = MachineX64EncodeAllocated(program, limits, *built.encoded)
    if diagnostic.problem != .None { MachineNativeFree(*built); return diagnostic }
    if emit_executable {
        image := MachineX64View(*built.encoded)
        imports: Vec(MachineX64HostImport)
        builtins: Vec(MachineX64HostImport)
        diagnostic = HostImports(lir, program, links, *imports, *builtins)
        hosts := MachineElfHosts.{libraries = links.libraries, imports = imports[:], builtins = builtins[:]}
        empty: [0]u8
        measured: Encoded
        if diagnostic.problem == .None {
            measured = ExecutableEncode(program, image, empty[:], fuel, hosts)
            diagnostic = measured.diagnostic
        }
        if diagnostic.problem == .None && (measured.size <= 0 || measured.size > limits.bytes ||
            !VecResizeBounded(built.executable, measured.size, limits.bytes)) {
            diagnostic = Problem(ifx measured.size > limits.bytes then MachineProblem.Limit else MachineProblem.Allocation)
        }
        if diagnostic.problem == .None {
            written := ExecutableEncode(program, image, built.executable[:], fuel, hosts)
            diagnostic = written.diagnostic
            if diagnostic.problem == .None && written.size != measured.size { diagnostic = Problem(.Relocation) }
        }
        VecFree(imports)
        VecFree(builtins)
        if diagnostic.problem != .None {
            MachineNativeFree(*built)
            return diagnostic
        }
        built.image = built.executable[:]
    }
    built.valid = true
    NativeExchange(output, *built)
    MachineNativeFree(*built)
    return NoDiagnostic()
}

MachineCodeBuild :: (lir: LirProgram, target: TargetDescription, limits: MachineLimits,
    output: *MachineNativeOwner) -> MachineDiagnostic {
    none: MachineHostLinks
    return Build(lir, target, limits, output, false, 0, none)
}

// In-process code for a host that never limits its steps: no fuel checks,
// as in an unbounded executable.
MachineCodeBuildUnbounded :: (lir: LirProgram, target: TargetDescription, limits: MachineLimits,
    output: *MachineNativeOwner) -> MachineDiagnostic {
    none: MachineHostLinks
    return Build(lir, target, limits, output, false, MachineX64InitialFuel, none)
}

// The host libraries a Linux x86-64 or Windows x86-64 executable links its
// host capabilities from: their absolute paths, and for each function of the
// program the index of the library that provides it, -1, or
// MachineX64HostBuiltin for a files or clock service the executable supplies
// itself. Both are empty for a program that calls no host capability.
MachineHostLinks :: struct {
    libraries: []string
    providers: []s32
}

// FUEL is the AOT executable's starting budget; MachineX64InitialFuel is
// unbounded, as for a bundle run. The executable is an ELF on Linux and a PE
// on Windows; a Linux ELF links the host libraries LINKS names for its host
// capabilities, carries the ZX Runner's files and clock services itself, and
// is static when it links nothing.
MachineNativeBuild :: (lir: LirProgram, target: TargetDescription, limits: MachineLimits,
    output: *MachineNativeOwner, fuel: s64, links: MachineHostLinks) -> MachineDiagnostic {
    return Build(lir, target, limits, output, true, fuel, links)
}

// The layout of the Linux ELF MachineNativeBuild wrote for LIR into OWNER
// with LINKS, measured again for its map.
MachineNativeElfLayout :: (lir: LirProgram, owner: *MachineNativeOwner, links: MachineHostLinks) -> MachineElfResult {
    program := owner.machine.program
    imports: Vec(MachineX64HostImport)
    builtins: Vec(MachineX64HostImport)
    result: MachineElfResult
    result.diagnostic = HostImports(lir, program, links, *imports, *builtins)
    if result.diagnostic.problem == .None {
        empty: [0]u8
        result = MachineElfEncode(program, MachineX64View(*owner.encoded), empty[:], MachineX64InitialFuel,
            .{libraries = links.libraries, imports = imports[:], builtins = builtins[:]})
    }
    VecFree(imports)
    VecFree(builtins)
    return result
}

// The Windows PE layout measured with the same linked hosts as its executable.
MachineNativePeLayout :: (lir: LirProgram, owner: *MachineNativeOwner, links: MachineHostLinks) -> MachinePeResult {
    program := owner.machine.program
    imports: Vec(MachineX64HostImport)
    builtins: Vec(MachineX64HostImport)
    result: MachinePeResult
    result.diagnostic = HostImports(lir, program, links, *imports, *builtins)
    if result.diagnostic.problem == .None {
        empty: []u8
        result = MachinePeEncode(program, MachineX64View(*owner.encoded), empty, MachineX64InitialFuel,
            .{libraries = links.libraries, imports = imports[:], builtins = builtins[:]})
    }
    VecFree(imports)
    VecFree(builtins)
    return result
}
