using Lir :: #import "compiler_lowered_ir"
using Machine :: #import "compiler_machine_ir"
using Vectors :: #import "std/vec"
#import "compiler_learning"

// Instruction-selection facts for one LIR function on x86-64, planned before
// machine lowering so integer code compares, branches and computes the way a
// C compiler's would:
//
// - Immediates: a constant that fits a sign-extended 32-bit field becomes
//   the right operand of the integer compare, add, subtract, and, or, xor or
//   multiply that uses it; a commutative one takes a constant left operand
//   by swapping. A constant whose every use is folded is never loaded.
// - Fused branches: a compare whose only use is the branch right after it
//   branches on its flags instead of making a 0/1 value to test.
// - Threaded jumps: a jump to a block that does nothing but branch on its
//   one parameter branches there itself: straight to the chosen target for a
//   constant, on the flags of a compare just before the jump, or on the value.

MachineSelectFold :: enum u8 { None; Right; Left }

MachineSelectPlan :: struct {
    // Per value: defined by a constant, its 64-bit register value, whether
    // it still has a use that needs it loaded, and whether it is a compare
    // whose flags its only user branches on.
    constant: Vec(bool)
    bits: Vec(u64)
    loaded: Vec(bool)
    fused: Vec(bool)
    // A fused compare whose branch always takes its first edge (Known): the
    // compare is not emitted and the branch is a jump.
    known: Vec(bool)
    // Per instruction, numbered through the blocks in order: which operand of
    // a binary operation or compare is an immediate.
    fold: Vec(MachineSelectFold)
    // Per value: for an unchecked element address whose only use is the
    // address of a scalar load or store later in its block, the base, index
    // and scale shift that access takes as its memory operand; -1 shift
    // otherwise.
    address_base: Vec(s32)
    address_index: Vec(s32)
    address_shift: Vec(s32)
    // Per block: the block its closing jump threads into, or -1, and whether
    // every edge into it threads past it, so nothing reaches it.
    thread: Vec(s32)
    dead: Vec(bool)
    // Block layout: per position the LIR block lowered there, per block its
    // position, and per block the number of its first instruction. The
    // entry comes first, then the other blocks in order with every exit
    // (a block that returns, traps or is unreachable, or that nothing
    // reaches) after the rest, so hot blocks fall into each other.
    layout: Vec(s32)
    position: Vec(s32)
    start: Vec(s64)
    // Per block: where an edge into it goes instead, when it only passes
    // its parameters on (see PassThrough), or -1.
    pass: Vec(s32)
    // Scratch: edges into each block, and how many of them thread.
    incoming: Vec(s32)
    threaded: Vec(s32)
    // Scratch: uses of each value, and how many of them fold.
    uses: Vec(s32)
    folded: Vec(s32)
    work: s64
}

#scope_file

Context :: struct {
    plan: *MachineSelectPlan
    program: LirProgram
    function: LirFunction
    // An unchecked x86 build: stores take immediates and element addresses
    // fold into the access.
    unchecked: bool
    budget: s64
    problem: MachineProblem
}

Spend :: (context: *Context, count: s64) -> bool {
    if count < 0 || count > context.budget - context.plan.work {
        if context.problem == .None { context.problem = .Limit }
        return false
    }
    context.plan.work += count
    return true
}

TypeOf :: (context: *Context, value: s32) -> LirType {
    return context.program.types[context.function.values[value]]
}

Scalar :: (type: LirType) -> bool { return type.kind == .Integer || type.kind == .Bool }

// The value a register holds for constant BITS of TYPE: integers narrower
// than 64 bits are sign- or zero-extended, bools are 0 or 1.
Normalized :: (type: LirType, bits: u64) -> u64 {
    if type.kind == .Bool { return bits & 1 }
    if type.bits <= 0 || type.bits >= 64 { return bits }
    width := cast(u64)type.bits
    value := bits & ((cast(u64)1 << width) - 1)
    if type.is_signed && (value >> (width - 1)) != 0 { value = value | ~((cast(u64)1 << width) - 1) }
    return value
}

Fits32 :: (bits: u64) -> bool {
    value := cast(s64)bits
    return value >= -2147483648 && value <= 2147483647
}

Immediate :: (context: *Context, value: s32) -> bool {
    return context.plan.constant[value] && Fits32(context.plan.bits[value])
}

Compare :: (op: LirOp) -> bool {
    return op == .Equal || op == .NotEqual || op == .Less || op == .LessEqual || op == .Greater ||
        op == .GreaterEqual
}

Commutative :: (op: LirOp) -> bool {
    return op == .Add || op == .Multiply || op == .BitAnd || op == .BitOr || op == .BitXor
}

// Which operand of INSTRUCTION folds as an immediate: a constant operand of
// a binary operation or compare, or the scalar value a store writes.
Fold :: (context: *Context, instruction: LirInstruction) -> MachineSelectFold {
    op := instruction.op
    if op == .Store {
        if !context.unchecked || instruction.operands.count != 2 || !Scalar(TypeOf(context, instruction.operands[1])) ||
            !Immediate(context, instruction.operands[1]) { return .None }
        return .Right
    }
    if (op == .ShiftLeft || op == .ShiftRight) && instruction.operands.count == 2 {
        // A constant count inside the width shifts by an immediate: no cl,
        // and no range check, since it cannot trap.
        type := TypeOf(context, instruction.operands[0])
        count := instruction.operands[1]
        if type.kind == .Integer && type.bits > 0 && context.plan.constant[count] &&
            context.plan.bits[count] < cast(u64)type.bits { return .Right }
        return .None
    }
    if !Compare(op) && !Commutative(op) && op != .Subtract || instruction.operands.count != 2 {
        return .None
    }
    left := instruction.operands[0]
    right := instruction.operands[1]
    if !Scalar(TypeOf(context, left)) { return .None }
    if Immediate(context, right) { return .Right }
    if Commutative(op) && Immediate(context, left) { return .Left }
    return .None
}

Count :: (context: *Context) -> bool {
    plan := context.plan
    for block: context.function.blocks {
        if !Spend(context, block.instructions.count) { return false }
        for instruction: block.instructions {
            for value: instruction.operands { plan.uses[value] += 1 }
            for edge: instruction.edges {
                plan.incoming[edge.block] += 1
                for value: edge.arguments { plan.uses[value] += 1 }
            }
            result := instruction.result
            if instruction.op == .Constant && result >= 0 && Scalar(TypeOf(context, result)) {
                plan.constant[result] = true
                plan.bits[result] = Normalized(TypeOf(context, result),
                    context.program.constants[instruction.symbol].bits)
            }
        }
    }
    return true
}

// The block JUMP threads into: one that only branches on its one parameter,
// used nowhere else, with edges that do not pass it on.
ThreadTarget :: (context: *Context, jump: LirInstruction) -> s32 {
    if jump.op != .Jump || jump.edges.count != 1 || jump.edges[0].arguments.count != 1 { return -1 }
    target := jump.edges[0].block
    block := context.function.blocks[target]
    if target == context.function.entry || block.parameters.count != 1 || block.instructions.count != 1 {
        return -1
    }
    parameter := block.parameters[0]
    branch := block.instructions[0]
    if branch.op != .Branch || branch.operands.count != 1 || branch.operands[0] != parameter ||
        branch.edges.count != 2 || context.plan.uses[parameter] != 1 { return -1 }
    for edge: branch.edges { for value: edge.arguments { if value == parameter { return -1 } } }
    return target
}

// The scale shift of a scalar of TYPE as an array element, or -1.
ElementShift :: (type: LirType) -> s32 {
    size: s32 = 0
    if type.kind == .Bool { size = 1 }
    else if type.kind == .Integer || type.kind == .Float { size = type.bits / 8 }
    else if type.kind == .Pointer { size = 8 }
    if size == 1 { return 0 }
    if size == 2 { return 1 }
    if size == 4 { return 2 }
    if size == 8 { return 3 }
    return -1
}

// Folds the element address ITEM of INSTRUCTIONS into the scalar load or
// store after it that is its only use.
FoldAddress :: (context: *Context, instructions: []LirInstruction, item: s64) {
    address := instructions[item]
    result := address.result
    if !context.unchecked || address.op != .ElementAddress || address.checked || result < 0 ||
        address.operands.count < 2 || address.operands.count > 4 || context.plan.uses[result] != 1 { return }
    for at: item + 1..instructions.count - 1 {
        user := instructions[at]
        named := false
        for operand: user.operands { if operand == result { named = true } }
        if !named { continue }
        accessed: s32 = -1
        if user.op == .Load && user.operands.count == 1 { accessed = user.result }
        if user.op == .Store && user.operands.count == 2 && user.operands[0] == result && user.operands[1] != result {
            accessed = user.operands[1]
        }
        if accessed < 0 { return }
        shift := ElementShift(TypeOf(context, accessed))
        if shift < 0 { return }
        context.plan.address_base[result] = address.operands[0]
        context.plan.address_index[result] = address.operands[1]
        context.plan.address_shift[result] = shift
        return
    }
}

// Whether the compare defining VALUE at ITEM of INSTRUCTIONS has its only use
// right after it.
// An ordered float order test fuses too: x86 branches on it with one
// unsigned condition that an unordered compare fails. Float equality needs
// the parity flag as well and stays a value.
Fusable :: (context: *Context, instructions: []LirInstruction, item: s64, value: s32) -> bool {
    if item < 0 { return false }
    compare := instructions[item]
    if compare.result != value || !Compare(compare.op) || context.plan.uses[value] != 1 { return false }
    type := TypeOf(context, compare.operands[0])
    if type.kind == .Float { return compare.op != .Equal && compare.op != .NotEqual }
    return Scalar(type)
}

// The instruction of the function defining VALUE, or a zero one.
Definition :: (context: *Context, value: s32) -> LirInstruction {
    for block: context.function.blocks {
        if !Spend(context, block.instructions.count) { return .{} }
        for instruction: block.instructions { if instruction.result == value { return instruction } }
    }
    return .{}
}

// Whether TEST, a fused `less.equal` (`greater.equal` counting down) in a
// latch, always holds. The latch must test cursor + 1 (cursor - 1) against
// LAST, run only after a branch has left the loop on cursor == LAST, and
// every edge into the block whose parameter cursor is must have just tested
// the value it passes in that order against LAST. Then cursor <= LAST on
// every entry and cursor != LAST here, so cursor + 1 <= LAST without
// overflow. An inclusive range's rotated loop is exactly this; the LIR keeps
// the test, which the vectorizer reads (compiler_vectorize.zi).
KnownTest :: (context: *Context, latch: s32, test: LirInstruction) -> bool {
    function := context.function
    if test.op != .LessEqual && test.op != .GreaterEqual || test.operands.count != 2 { return false }
    step := Definition(context, test.operands[0])
    last := test.operands[1]
    advance := ifx test.op == .LessEqual then LirOp.Add else LirOp.Subtract
    if step.op != advance || step.operands.count != 2 || !context.plan.constant[step.operands[1]] ||
        context.plan.bits[step.operands[1]] != 1 { return false }
    cursor := step.operands[0]
    entries: s64
    home: s64 = -1
    slot: s64 = -1
    for block, index: function.blocks {
        if !Spend(context, block.parameters.count + 1) { return false }
        for value, at: block.parameters { if value == cursor { home = index; slot = at } }
        terminal := block.instructions[block.instructions.count - 1]
        for edge, at: terminal.edges {
            if edge.block != latch { continue }
            entries += 1
            if terminal.op != .Branch || at != 1 || terminal.operands.count != 1 { return false }
            exit := Definition(context, terminal.operands[0])
            if exit.op != .Equal || exit.operands.count != 2 ||
                !(exit.operands[0] == cursor && exit.operands[1] == last ||
                  exit.operands[0] == last && exit.operands[1] == cursor) { return false }
        }
    }
    if entries != 1 || home < 0 { return false }
    for block: function.blocks {
        terminal := block.instructions[block.instructions.count - 1]
        for edge, at: terminal.edges {
            if edge.block != home { continue }
            if terminal.op != .Branch || at != 0 || terminal.operands.count != 1 ||
                slot >= edge.arguments.count { return false }
            entry := Definition(context, terminal.operands[0])
            if entry.op != test.op || entry.operands.count != 2 || entry.operands[1] != last ||
                entry.operands[0] != edge.arguments[slot] { return false }
        }
    }
    return true
}

Known :: (context: *Context) -> bool {
    for block, index: context.function.blocks {
        if block.instructions.count < 2 { continue }
        branch := block.instructions[block.instructions.count - 1]
        if branch.op != .Branch || branch.operands.count != 1 || branch.edges.count != 2 ||
            !context.plan.fused[branch.operands[0]] { continue }
        test := block.instructions[block.instructions.count - 2]
        if test.result != branch.operands[0] { continue }
        if KnownTest(context, cast(s32)index, test) { context.plan.known[test.result] = true }
        if context.problem != .None { return false }
    }
    return true
}

Plan :: (context: *Context) -> bool {
    plan := context.plan
    at: s64 = 0
    for block, block_index: context.function.blocks {
        instructions := block.instructions
        if !Spend(context, instructions.count) { return false }
        for instruction, item: instructions {
            FoldAddress(context, instructions, item)
            fold := Fold(context, instruction)
            plan.fold[at] = fold
            if fold == .Right { plan.folded[instruction.operands[1]] += 1 }
            if fold == .Left { plan.folded[instruction.operands[0]] += 1 }
            at += 1
            if instruction.op == .Branch && instruction.operands.count == 1 &&
                Fusable(context, instructions, item - 1, instruction.operands[0]) {
                plan.fused[instruction.operands[0]] = true
            }
        }
        if instructions.count == 0 { continue }
        jump := instructions[instructions.count - 1]
        target := ThreadTarget(context, jump)
        plan.thread[block_index] = target
        if target < 0 { continue }
        plan.threaded[target] += 1
        argument := jump.edges[0].arguments[0]
        if plan.constant[argument] { plan.folded[argument] += 1 }
        else if Fusable(context, instructions, instructions.count - 2, argument) { plan.fused[argument] = true }
    }
    // A block whose jump threads into a branch stays: what it passes on to
    // may be dead.
    for block: cast(s64)0..context.function.blocks.count - 1 {
        plan.pass[block] = ifx plan.thread[block] >= 0 then cast(s32)-1 else PassThrough(context, block)
    }
    for block: context.function.blocks {
        for instruction: block.instructions {
            for edge: instruction.edges { if plan.pass[edge.block] >= 0 { plan.threaded[edge.block] += 1 } }
        }
    }
    return true
}

// Whether BLOCK leaves the function or never continues: it returns, traps
// or is unreachable.
Exit :: (block: LirBlock) -> bool {
    if block.instructions.count == 0 { return false }
    op := block.instructions[block.instructions.count - 1].op
    return op == .Return || op == .Trap || op == .Unreachable
}

// The block that BLOCK, which only jumps, passes control to, or -1. An edge
// into it can go there instead, passing the jump's arguments with BLOCK's
// parameters replaced by the edge's: values from elsewhere dominate BLOCK
// and so every edge into it, and each parameter is used at most by that
// jump. Every value passed is a register value.
PassThrough :: (context: *Context, block_index: s64) -> s32 {
    block := context.function.blocks[block_index]
    if block_index == cast(s64)context.function.entry || block.instructions.count != 1 { return -1 }
    jump := block.instructions[0]
    if jump.op != .Jump || jump.edges.count != 1 || jump.edges[0].block == cast(s32)block_index { return -1 }
    for parameter: block.parameters {
        named: s32 = 0
        for argument: jump.edges[0].arguments { if argument == parameter { named += 1 } }
        if context.plan.uses[parameter] != named || !RegisterKind(TypeOf(context, parameter)) { return -1 }
    }
    for argument: jump.edges[0].arguments { if !RegisterKind(TypeOf(context, argument)) { return -1 } }
    return jump.edges[0].block
}

RegisterKind :: (type: LirType) -> bool {
    return type.kind == .Integer || type.kind == .Bool || type.kind == .Float || type.kind == .Pointer
}

Layout :: (plan: *MachineSelectPlan, function: LirFunction, enabled: bool) {
    blocks := function.blocks.count
    at: s64 = 0
    for block: cast(s64)0..blocks - 1 {
        plan.start[block] = at
        at += function.blocks[block].instructions.count
    }
    count: s64 = 0
    if !enabled {
        for block: cast(s32)0..cast(s32)blocks - 1 { plan.layout[block] = block }
    } else {
        plan.layout[0] = cast(s32)function.entry
        count = 1
        for exits: 0..1 {
            for block: cast(s32)0..cast(s32)blocks - 1 {
                if block == cast(s32)function.entry { continue }
                exit := Exit(function.blocks[block]) || plan.dead[block]
                if exit != (exits == 1) { continue }
                plan.layout[count] = block
                count += 1
            }
        }
    }
    for position: cast(s32)0..cast(s32)blocks - 1 { plan.position[plan.layout[position]] = position }
}

#scope_export

// Plans FUNCTION of PROGRAM into PLAN within BUDGET work, recorded in
// plan.work, and BYTES elements per scratch vector. A plan that is not
// ENABLED loads every used value and folds, fuses and threads nothing.
MachineSelectPlanBuild :: (plan: *MachineSelectPlan, program: LirProgram, function: LirFunction,
    enabled: bool, unchecked: bool, budget: s64, bytes: s64) -> MachineProblem {
    plan.work = 0
    context := Context.{plan = plan, program = program, function = function, unchecked = unchecked,
        budget = budget, problem = .None}
    count := function.values.count
    instructions: s64
    for block: function.blocks { instructions += block.instructions.count }
    if !VecResizeBounded(plan.constant, count, bytes) || !VecResizeBounded(plan.bits, count, bytes) ||
        !VecResizeBounded(plan.loaded, count, bytes) || !VecResizeBounded(plan.fused, count, bytes) ||
        !VecResizeBounded(plan.known, count, bytes) ||
        !VecResizeBounded(plan.uses, count, bytes) || !VecResizeBounded(plan.folded, count, bytes) ||
        !VecResizeBounded(plan.address_base, count, bytes) || !VecResizeBounded(plan.address_index, count, bytes) ||
        !VecResizeBounded(plan.address_shift, count, bytes) ||
        !VecResizeBounded(plan.fold, instructions, bytes) ||
        !VecResizeBounded(plan.thread, function.blocks.count, bytes) ||
        !VecResizeBounded(plan.dead, function.blocks.count, bytes) ||
        !VecResizeBounded(plan.incoming, function.blocks.count, bytes) ||
        !VecResizeBounded(plan.threaded, function.blocks.count, bytes) ||
        !VecResizeBounded(plan.layout, function.blocks.count, bytes) ||
        !VecResizeBounded(plan.position, function.blocks.count, bytes) ||
        !VecResizeBounded(plan.start, function.blocks.count, bytes) ||
        !VecResizeBounded(plan.pass, function.blocks.count, bytes) { return .Allocation }
    if !Spend(*context, count) { return context.problem }
    for value: cast(s64)0..count - 1 {
        plan.constant[value] = false
        plan.bits[value] = 0
        plan.fused[value] = false
        plan.known[value] = false
        plan.uses[value] = 0
        plan.folded[value] = 0
        plan.address_base[value] = -1
        plan.address_index[value] = -1
        plan.address_shift[value] = -1
    }
    for at: cast(s64)0..instructions - 1 { plan.fold[at] = .None }
    for at: cast(s64)0..function.blocks.count - 1 {
        plan.pass[at] = -1
        plan.thread[at] = -1
        plan.incoming[at] = 0
        plan.threaded[at] = 0
    }
    if !Count(*context) || enabled && (!Plan(*context) || !Known(*context)) { return context.problem }
    for value: cast(s64)0..count - 1 { plan.loaded[value] = !enabled || plan.uses[value] > plan.folded[value] }
    for at: cast(s64)0..function.blocks.count - 1 {
        plan.dead[at] = plan.threaded[at] > 0 && plan.threaded[at] == plan.incoming[at]
    }
    Layout(plan, function, enabled && LearningTuningChoice().block_layout == 1)
    return .None
}

MachineSelectPlanFree :: (plan: *MachineSelectPlan) {
    VecFree(plan.pass)
    VecFree(plan.layout)
    VecFree(plan.position)
    VecFree(plan.start)
    VecFree(plan.address_base)
    VecFree(plan.address_index)
    VecFree(plan.address_shift)
    VecFree(plan.constant)
    VecFree(plan.bits)
    VecFree(plan.loaded)
    VecFree(plan.fused)
    VecFree(plan.known)
    VecFree(plan.fold)
    VecFree(plan.thread)
    VecFree(plan.dead)
    VecFree(plan.incoming)
    VecFree(plan.threaded)
    VecFree(plan.uses)
    VecFree(plan.folded)
}
