using ABI :: #import "compiler_abi"
using Image :: #import "compiler_machine_image"
using Machine :: #import "compiler_machine_ir"
using Target :: #import "compiler_target"
using Vectors :: #import "std/vec"

#scope_file

VerifyState :: struct {
    diagnostic: MachineDiagnostic
    remaining: s64
}

NoDiagnostic :: () -> MachineDiagnostic {
    return .{problem = .None, function = MachineNoId, block = MachineNoId,
        instruction = MachineNoId, operand = MachineNoId, virtual = MachineNoId}
}

Fail :: (state: *VerifyState, problem: MachineProblem, function: s32 = MachineNoId,
    block: s32 = MachineNoId, instruction: s32 = MachineNoId,
    operand: s32 = MachineNoId, virtual: s32 = MachineNoId) -> bool {
    if state.diagnostic.problem == .None {
        state.diagnostic = .{problem = problem, function = function, block = block,
            instruction = instruction, operand = operand, virtual = virtual}
    }
    return false
}

Spend :: (state: *VerifyState, count: s64) -> bool {
    if count < 0 || count > state.remaining { return Fail(state, .Limit) }
    state.remaining -= count
    return true
}

Range :: (begin: s32, count: s32, total: s64) -> bool {
    return begin >= 0 && count >= 0 && cast(s64)begin <= total &&
        cast(s64)count <= total - cast(s64)begin
}

Optional :: (id: s32, total: s64) -> bool {
    return id == MachineNoId || id >= 0 && cast(s64)id < total
}

ClassValid :: (class: MachineRegisterClass) -> bool {
    return cast(s32)class >= cast(s32)MachineRegisterClass.General &&
        cast(s32)class <= cast(s32)MachineRegisterClass.Stack
}

RelocationKindValid :: (kind: MachineRelocationKind) -> bool {
    return kind == .FunctionAddress || kind == .FunctionCall || kind == .GlobalAddress ||
        kind == .FuelCounter || kind == .ConstantAddress || kind == .RuntimeTrap ||
        kind == .PlatformService || kind == .HostCapability || kind == .EntryPoint || kind == .RuntimeResize
}

RelocationSymbolValid :: (program: MachineProgram, relocation: MachineRelocation) -> bool {
    symbol := relocation.symbol
    if relocation.kind == .FunctionAddress || relocation.kind == .FunctionCall ||
        relocation.kind == .EntryPoint {
        return symbol >= 0 && symbol < program.functions.count &&
            program.functions[symbol].calling == .Internal
    }
    if relocation.kind == .GlobalAddress {
        return symbol >= 0 && symbol < program.globals.count && program.globals[symbol].writable
    }
    if relocation.kind == .ConstantAddress {
        return symbol >= 0 && symbol < program.globals.count && !program.globals[symbol].writable
    }
    if relocation.kind == .FuelCounter || relocation.kind == .RuntimeTrap ||
        relocation.kind == .RuntimeResize { return symbol == 0 }
    if relocation.kind == .HostCapability {
        return symbol >= 0 && symbol < program.functions.count &&
            program.functions[symbol].calling == .Host
    }
    if relocation.kind == .PlatformService {
        return symbol >= 0 && symbol < program.functions.count &&
            program.functions[symbol].calling == .Platform
    }
    return false
}

RelocationFormValid :: (program: MachineProgram, relocation: MachineRelocation) -> bool {
    instruction := program.instructions[relocation.instruction]
    operand := program.operands[relocation.operand]
    if relocation.kind == .FunctionCall {
        return instruction.opcode == .CallDirect && operand.kind == .Function &&
            operand.id == relocation.symbol
    }
    if relocation.kind == .FunctionAddress || relocation.kind == .EntryPoint {
        return instruction.opcode == .FunctionAddress && operand.kind == .Function &&
            operand.id == relocation.symbol
    }
    if relocation.kind == .GlobalAddress || relocation.kind == .ConstantAddress {
        return instruction.opcode == .GlobalAddress && operand.kind == .Global &&
            operand.id == relocation.symbol
    }
    if relocation.kind == .FuelCounter {
        return instruction.opcode == .Fuel && operand.kind == .Immediate
    }
    if relocation.kind == .RuntimeTrap {
        return instruction.opcode == .Trap && operand.kind == .Immediate
    }
    if relocation.kind == .RuntimeResize {
        return instruction.opcode == .Resize && operand.kind == .Immediate
    }
    if relocation.kind == .HostCapability || relocation.kind == .PlatformService {
        return instruction.opcode == .CallDirect && operand.kind == .Function &&
            operand.id == relocation.symbol
    }
    return false
}

Counts :: (state: *VerifyState, program: MachineProgram, limits: MachineLimits) -> bool {
    if limits.work < 0 || limits.bytes < 0 || limits.functions < 0 || limits.types < 0 || limits.constants < 0 || limits.blocks < 0 ||
        limits.type_ids < 0 || limits.globals < 0 || limits.virtuals < 0 || limits.instructions < 0 || limits.operands < 0 ||
        limits.edges < 0 || limits.copies < 0 || limits.stack_objects < 0 ||
        limits.relocations < 0 || limits.calls < 0 { return Fail(state, .Limit) }
    if program.text.count > limits.bytes || program.data.count > limits.bytes ||
        program.constants.count > limits.constants || program.functions.count > limits.functions ||
        program.types.count > limits.types ||
        program.type_ids.count > limits.type_ids ||
        program.globals.count > limits.globals ||
        program.blocks.count > limits.blocks || program.virtuals.count > limits.virtuals ||
        program.instructions.count > limits.instructions || program.operands.count > limits.operands ||
        program.edges.count > limits.edges || program.copies.count > limits.copies ||
        program.stack_objects.count > limits.stack_objects ||
        program.relocations.count > limits.relocations || program.calls.count > limits.calls {
        return Fail(state, .Limit)
    }
    total := program.text.count + program.data.count +
        program.sources.count * cast(s64)size_of(MachineSource) +
        program.origins.count * cast(s64)size_of(MachineOrigin) +
        program.types.count * cast(s64)size_of(MachineType) +
        program.type_ids.count * cast(s64)size_of(s32) +
        program.constants.count * cast(s64)size_of(MachineConstant) +
        program.globals.count * cast(s64)size_of(MachineGlobal) +
        program.initializers.count * cast(s64)size_of(s32) +
        program.functions.count * cast(s64)size_of(MachineFunction) +
        program.blocks.count * cast(s64)size_of(MachineBlock) +
        program.virtuals.count * cast(s64)size_of(MachineVirtual) +
        program.instructions.count * cast(s64)size_of(MachineInstruction) +
        program.operands.count * cast(s64)size_of(MachineOperand) +
        program.edges.count * cast(s64)size_of(MachineEdge) +
        program.copies.count * cast(s64)size_of(MachineCopy) +
        program.stack_objects.count * cast(s64)size_of(MachineStackObject) +
        program.relocations.count * cast(s64)size_of(MachineRelocation) +
        program.calls.count * cast(s64)size_of(MachineCall)
    if total < 0 || total > limits.bytes { return Fail(state, .Limit) }
    return true
}

Metadata :: (state: *VerifyState, program: MachineProgram) -> bool {
    for source_index: cast(s64)0..program.sources.count - 1 {
        if !Spend(state, 1) { return false }
        source := program.sources[source_index]
        if !Range(source.text_offset, source.text_length, program.text.count) {
            return Fail(state, .Source)
        }
    }
    for origin_index: cast(s64)0..program.origins.count - 1 {
        if !Spend(state, 1) { return false }
        origin := program.origins[origin_index]
        if origin.file < 0 || origin.file >= program.sources.count ||
            origin.line < 1 || origin.column < 1 ||
            origin.end_line < 0 || origin.end_column < 0 ||
            (origin.end_line == 0) != (origin.end_column == 0) ||
            origin.begin < -1 || origin.end < -1 ||
            (origin.begin == -1) != (origin.end == -1) ||
            origin.begin > origin.end || !Optional(origin.parent, program.origins.count) {
            return Fail(state, .Origin)
        }
    }
    return true
}

VirtualsAndStack :: (state: *VerifyState, program: MachineProgram) -> bool {
    for index: cast(s64)0..program.types.count - 1 {
        if !Spend(state, 1) { return false }
        type := program.types[index]
        if type.kind == .Invalid || !ClassValid(type.class) || type.bits < 0 || type.size < 0 ||
            type.alignment < 1 || type.alignment > 4096 ||
            (type.alignment & (type.alignment - 1)) != 0 ||
            !Range(type.fields_begin, type.fields_count, program.type_ids.count) ||
            !Range(type.parameters_begin, type.parameters_count, program.type_ids.count) ||
            !Optional(type.element, program.types.count) || !Optional(type.result, program.types.count) {
            return Fail(state, .Virtual)
        }
        if type.native_width && (type.kind != .Integer || type.bits != program.target.pointer_bits ||
            type.size != program.target.pointer_bits / 8) {
            return Fail(state, .NativeWidth)
        }
        for at: type.fields_begin..type.fields_begin + type.fields_count - 1 {
            if !Spend(state, 1) || program.type_ids[at] < 0 || program.type_ids[at] >= program.types.count {
                return Fail(state, .Virtual)
            }
        }
        for at: type.parameters_begin..type.parameters_begin + type.parameters_count - 1 {
            if !Spend(state, 1) || program.type_ids[at] < 0 || program.type_ids[at] >= program.types.count {
                return Fail(state, .Virtual)
            }
        }
    }
    for index: cast(s64)0..program.stack_objects.count - 1 {
        if !Spend(state, 1) { return false }
        object := program.stack_objects[index]
        if object.function < 0 || object.function >= program.functions.count ||
            object.kind == .Invalid || object.size < 0 || object.alignment < 1 ||
            object.alignment > 4096 || (object.alignment & (object.alignment - 1)) != 0 ||
            object.type < 0 || object.type >= program.types.count ||
            !Optional(object.origin, program.origins.count) { return Fail(state, .Stack, object.function) }
        if object.placed_in != 0 && !PlacedWithin(program, object) { return Fail(state, .Stack, object.function) }
    }
    for global: program.globals {
        if !Spend(state, 1) || global.type < 0 || global.type >= program.types.count ||
            !Optional(global.constant, program.constants.count) ||
            global.constant != MachineNoId && program.constants[global.constant].type != global.type {
            return Fail(state, .Operand)
        }
    }
    for constant: program.constants {
        if !Spend(state, 1) || constant.type < 0 || constant.type >= program.types.count ||
            !Range(constant.bytes_begin, constant.bytes_count, program.data.count) {
            return Fail(state, .Operand)
        }
    }
    for initializer: program.initializers {
        if !Spend(state, 1) || initializer < 0 || initializer >= program.functions.count ||
            program.functions[initializer].calling != .Internal {
            return Fail(state, .Function)
        }
    }
    for index: cast(s64)0..program.virtuals.count - 1 {
        if !Spend(state, 1) { return false }
        value := program.virtuals[index]
        if !ClassValid(value.class) || !Optional(value.origin, program.origins.count) {
            return Fail(state, .Virtual, virtual = cast(s32)index)
        }
        if value.fixed_register != MachineNoId &&
            !MachineAbiPhysicalClass(program.target, value.class, value.fixed_register) {
            return Fail(state, .Constraint, virtual = cast(s32)index)
        }
        if value.type < 0 || value.type >= program.types.count {
            return Fail(state, .Virtual, virtual = cast(s32)index)
        }
        // A stack value no instruction names (a split record) has no object;
        // operands and copies check that the ones they name do.
        if value.class == .Stack {
            if value.stack_object < MachineNoId || value.stack_object >= program.stack_objects.count {
                return Fail(state, .Stack, virtual = cast(s32)index)
            }
        } else if value.stack_object != MachineNoId {
            if value.stack_object < 0 || value.stack_object >= program.stack_objects.count ||
                program.stack_objects[value.stack_object].kind != .IncomingArgument {
                return Fail(state, .Stack, virtual = cast(s32)index)
            }
        }
    }
    return true
}

// Whether the placed Value object OBJECT lies inside a Value object of its
// own function that has a frame home of its own, or inside the result memory
// of a function that keeps the address of it in its result register.
PlacedWithin :: (program: MachineProgram, object: MachineStackObject) -> bool {
    owner := program.functions[object.function]
    first := cast(s64)owner.stack_begin
    last := first + cast(s64)owner.stack_count
    parent_at := first + cast(s64)object.placed_in - 1
    if object.kind != .Value || object.placed_in < 0 || owner.stack_begin < 0 || owner.stack_count < 0 ||
        last > program.stack_objects.count || parent_at < first || parent_at >= last { return false }
    parent := program.stack_objects[parent_at]
    if parent.function != object.function { return false }
    capacity := parent.size
    if parent.kind == .ResultAddress {
        // The result's own type is what the caller's memory holds.
        if !owner.result_register || owner.calling != .Internal || owner.result_type < 0 ||
            owner.result_type >= program.types.count || program.types[owner.result_type].class != .Stack ||
            MachineAbiResultPointerRegister(program.target) < 0 { return false }
        capacity = program.types[owner.result_type].size
    } else if parent.kind != .Value || parent.placed_in != 0 { return false }
    return object.placed_at >= 0 && object.placed_at <= capacity && object.size <= capacity - object.placed_at
}

Operand :: (state: *VerifyState, program: MachineProgram, function: MachineFunction,
    instruction_id: s32, local: s32, operand_id: s32) -> bool {
    if !Spend(state, 1) { return false }
    operand := program.operands[operand_id]
    if operand.kind == .Invalid || operand.role == .Invalid || !ClassValid(operand.class) ||
        operand.tied_to < MachineNoId || operand.tied_to >= program.instructions[instruction_id].operand_count {
        return Fail(state, .Operand, function.lir_function, instruction = instruction_id, operand = operand_id)
    }
    if operand.kind == .Virtual {
        if operand.id < function.virtual_begin || operand.id >= function.virtual_begin + function.virtual_count ||
            program.virtuals[operand.id].class != operand.class {
            return Fail(state, .Virtual, function.lir_function, instruction = instruction_id,
                operand = operand_id, virtual = operand.id)
        }
        if operand.class == .Stack && program.virtuals[operand.id].stack_object == MachineNoId {
            return Fail(state, .Stack, function.lir_function, instruction = instruction_id,
                operand = operand_id, virtual = operand.id)
        }
    } else if operand.kind == .Physical {
        if !MachineAbiPhysicalClass(program.target, operand.class, operand.id) {
            return Fail(state, .Constraint, function.lir_function, instruction = instruction_id, operand = operand_id)
        }
    } else if operand.kind == .Block {
        if operand.id < function.block_begin || operand.id >= function.block_begin + function.block_count {
            return Fail(state, .Block, function.lir_function, instruction = instruction_id, operand = operand_id)
        }
    } else if operand.kind == .Function {
        if operand.id < 0 || operand.id >= program.functions.count {
            return Fail(state, .Function, function.lir_function, instruction = instruction_id, operand = operand_id)
        }
    } else if operand.kind == .StackObject {
        if operand.id < function.stack_begin || operand.id >= function.stack_begin + function.stack_count {
            return Fail(state, .Stack, function.lir_function, instruction = instruction_id, operand = operand_id)
        }
    } else if operand.kind == .Global {
        if operand.id < 0 || operand.id >= program.globals.count {
            return Fail(state, .Operand, function.lir_function, instruction = instruction_id, operand = operand_id)
        }
    } else if operand.kind != .Immediate {
        return Fail(state, .Operand, function.lir_function, instruction = instruction_id, operand = operand_id)
    }
    if operand.fixed_register != MachineNoId &&
        !MachineAbiPhysicalClass(program.target, operand.class, operand.fixed_register) {
        return Fail(state, .Constraint, function.lir_function, instruction = instruction_id, operand = operand_id)
    }
    if operand.tied_to != MachineNoId {
        tied := program.operands[program.instructions[instruction_id].operand_begin + operand.tied_to]
        if tied.class != operand.class || operand.tied_to == local {
            return Fail(state, .Constraint, function.lir_function, instruction = instruction_id, operand = operand_id)
        }
    }
    return true
}

Edges :: (state: *VerifyState, program: MachineProgram, function: MachineFunction,
    instruction: MachineInstruction, instruction_id: s32) -> bool {
    for edge_id: instruction.edge_begin..instruction.edge_begin + instruction.edge_count - 1 {
        if !Spend(state, 1) { return false }
        edge := program.edges[edge_id]
        if edge.target < function.block_begin || edge.target >= function.block_begin + function.block_count ||
            !Range(edge.copy_begin, edge.copy_count, program.copies.count) {
            return Fail(state, .Edge, function.lir_function, instruction = instruction_id)
        }
        for copy_id: edge.copy_begin..edge.copy_begin + edge.copy_count - 1 {
            if !Spend(state, 1) { return false }
            copy := program.copies[copy_id]
            if copy.source < function.virtual_begin || copy.source >= function.virtual_begin + function.virtual_count ||
                copy.destination < function.virtual_begin || copy.destination >= function.virtual_begin + function.virtual_count ||
                !ClassValid(copy.class) || program.virtuals[copy.source].class != copy.class ||
                program.virtuals[copy.destination].class != copy.class ||
                copy.class == .Stack && (program.virtuals[copy.source].stack_object == MachineNoId ||
                    program.virtuals[copy.destination].stack_object == MachineNoId) {
                return Fail(state, .Copy, function.lir_function, instruction = instruction_id)
            }
            for earlier: edge.copy_begin..copy_id - 1 {
                if !Spend(state, 1) { return false }
                if program.copies[earlier].destination == copy.destination {
                    return Fail(state, .Copy, function.lir_function, instruction = instruction_id)
                }
            }
        }
    }
    return true
}

Instructions :: (state: *VerifyState, program: MachineProgram, limits: MachineLimits) -> bool {
    definitions: Vec(u8)
    defer VecFree(definitions)
    if !VecResizeBounded(definitions, program.virtuals.count, limits.bytes) { return Fail(state, .Allocation) }
    for index: cast(s64)0..definitions.count - 1 { definitions[index] = 0 }
    for function_id: cast(s64)0..program.functions.count - 1 {
        function := program.functions[function_id]
        if !Spend(state, 1) ||
            !Range(function.name_offset, function.name_length, program.text.count) || function.name_length < 1 ||
            !Range(function.block_begin, function.block_count, program.blocks.count) ||
            !Range(function.virtual_begin, function.virtual_count, program.virtuals.count) ||
            !Range(function.stack_begin, function.stack_count, program.stack_objects.count) ||
            function.parameter_count < 0 ||
            !Optional(function.origin, program.origins.count) {
            return Fail(state, .Function, cast(s32)function_id)
        }
        external := function.calling == .Host || function.calling == .Platform
        if external {
            if function.lir_function != MachineNoId || function.block_count != 0 ||
                function.virtual_count != 0 || function.stack_count != 0 ||
                function.entry != MachineNoId {
                return Fail(state, .Function, cast(s32)function_id)
            }
            continue
        }
        if function.lir_function != function_id || function.calling != .Internal {
            return Fail(state, .Call, cast(s32)function_id)
        }
        if function.block_count < 1 || function.parameter_count > function.virtual_count ||
            function.entry < function.block_begin || function.entry >= function.block_begin + function.block_count {
            return Fail(state, .Function, cast(s32)function_id)
        }
        for block_id: function.block_begin..function.block_begin + function.block_count - 1 {
            block := program.blocks[block_id]
            if !Spend(state, 1) || block.function != function_id || block.lir_block < 0 ||
                !Range(block.instruction_begin, block.instruction_count, program.instructions.count) ||
                block.instruction_count < 1 {
                return Fail(state, .Block, cast(s32)function_id, block_id)
            }
            for instruction_id: block.instruction_begin..block.instruction_begin + block.instruction_count - 1 {
                if !Spend(state, 1) { return false }
                instruction := program.instructions[instruction_id]
                if instruction.opcode == .Invalid ||
                    !Range(instruction.operand_begin, instruction.operand_count, program.operands.count) ||
                    !Range(instruction.edge_begin, instruction.edge_count, program.edges.count) ||
                    !Optional(instruction.flags_use, program.virtuals.count) ||
                    !Optional(instruction.flags_def, program.virtuals.count) ||
                    !Optional(instruction.call, program.calls.count) ||
                    !Optional(instruction.origin, program.origins.count) {
                    return Fail(state, .Instruction, cast(s32)function_id, block_id, instruction_id)
                }
                for local: 0..instruction.operand_count - 1 {
                    operand_id := instruction.operand_begin + local
                    if !Operand(state, program, function, instruction_id, local, operand_id) { return false }
                    operand := program.operands[operand_id]
                    if operand.kind == .Virtual &&
                        (operand.role == .Define || operand.role == .UseDefine) {
                        if definitions[operand.id] != 0 {
                            return Fail(state, .Virtual, cast(s32)function_id, block_id,
                                instruction_id, operand_id, operand.id)
                        }
                        definitions[operand.id] = 1
                    }
                }
                if instruction.opcode == .Allocate {
                    if instruction.operand_count < 1 || instruction.operand_count > 2 {
                        return Fail(state, .Instruction, cast(s32)function_id, block_id, instruction_id)
                    }
                    result := program.operands[instruction.operand_begin]
                    if result.kind != .Virtual || result.role != .Define || result.type < 0 ||
                        result.type >= program.types.count || program.types[result.type].kind != .Pointer {
                        return Fail(state, .Instruction, cast(s32)function_id, block_id, instruction_id)
                    }
                    if instruction.operand_count == 2 {
                        initial := program.operands[instruction.operand_begin + 1]
                        if initial.kind != .Virtual || initial.role != .Use ||
                            initial.type != program.types[result.type].element {
                            return Fail(state, .Instruction, cast(s32)function_id, block_id, instruction_id)
                        }
                    }
                }
                if instruction.opcode == .StackAddress {
                    if instruction.operand_count != 2 {
                        return Fail(state, .Instruction, cast(s32)function_id, block_id, instruction_id)
                    }
                    result := program.operands[instruction.operand_begin]
                    object := program.operands[instruction.operand_begin + 1]
                    if result.kind != .Virtual || result.role != .Define || result.type < 0 ||
                        result.type >= program.types.count || program.types[result.type].kind != .Pointer ||
                        object.kind != .StackObject || object.role != .Use ||
                        program.stack_objects[object.id].type != program.types[result.type].element {
                        return Fail(state, .Instruction, cast(s32)function_id, block_id, instruction_id)
                    }
                }
                if instruction.flags_def != MachineNoId {
                    if program.virtuals[instruction.flags_def].class != .Flags || definitions[instruction.flags_def] != 0 {
                        return Fail(state, .Flags, cast(s32)function_id, block_id, instruction_id,
                            virtual = instruction.flags_def)
                    }
                    definitions[instruction.flags_def] = 1
                }
                if instruction.flags_use != MachineNoId {
                    if program.virtuals[instruction.flags_use].class != .Flags || instruction_id == block.instruction_begin ||
                        program.instructions[instruction_id - 1].flags_def != instruction.flags_use {
                        return Fail(state, .Flags, cast(s32)function_id, block_id, instruction_id,
                            virtual = instruction.flags_use)
                    }
                }
                // A branch tests its one operand, or the flags of the compare before it.
                if instruction.opcode == .Compare && instruction.flags_def == MachineNoId ||
                    instruction.opcode == .SetCondition && instruction.flags_use == MachineNoId ||
                    instruction.opcode == .Branch && (instruction.flags_use == MachineNoId) != (instruction.operand_count == 1) {
                    return Fail(state, .Flags, cast(s32)function_id, block_id, instruction_id)
                }
                is_call := instruction.opcode == .CallDirect || instruction.opcode == .CallIndirect
                if is_call != (instruction.call != MachineNoId) {
                    return Fail(state, .Call, cast(s32)function_id, block_id, instruction_id)
                }
                if instruction.opcode == .Jump && instruction.edge_count != 1 ||
                    instruction.opcode == .Branch && instruction.edge_count != 2 ||
                    instruction.opcode != .Jump && instruction.opcode != .Branch && instruction.edge_count != 0 {
                    return Fail(state, .Edge, cast(s32)function_id, block_id, instruction_id)
                }
                if !Edges(state, program, function, instruction, instruction_id) { return false }
            }
        }
    }
    return true
}

CallsAndRelocations :: (state: *VerifyState, program: MachineProgram, limits: MachineLimits) -> bool {
    // Relocations first, so a malformed one is reported as such.
    if !Spend(state, 2 * program.relocations.count) { return false }
    for relocation_id: cast(s64)0..program.relocations.count - 1 {
        relocation := program.relocations[relocation_id]
        if relocation.instruction < 0 || relocation.instruction >= program.instructions.count ||
            relocation.operand < 0 || relocation.operand >= program.operands.count ||
            !RelocationKindValid(relocation.kind) {
            return Fail(state, .Relocation, instruction = relocation.instruction, operand = relocation.operand)
        }
        instruction := program.instructions[relocation.instruction]
        if relocation.operand < instruction.operand_begin ||
            relocation.operand >= instruction.operand_begin + instruction.operand_count ||
            !RelocationSymbolValid(program, relocation) ||
            !RelocationFormValid(program, relocation) ||
            !MachineAbiRelocationAddend(program.target, relocation.kind, relocation.addend) {
            return Fail(state, .Relocation, instruction = relocation.instruction, operand = relocation.operand)
        }
    }
    references: Vec(s32)
    defer VecFree(references)
    if !MachineCallReferences(program, *references, limits.bytes) { return Fail(state, .Allocation) }
    for call_id: cast(s64)0..program.calls.count - 1 {
        if !Spend(state, 1) { return false }
        call := program.calls[call_id]
        if call.instruction < 0 || call.instruction >= program.instructions.count ||
            (call.calling != .Internal && call.calling != .Host && call.calling != .Platform) ||
            !Range(call.argument_begin, call.argument_count, program.operands.count) ||
            !Optional(call.result_operand, program.operands.count) || call.stack_argument_bytes < 0 ||
            (call.clobber_general >> cast(u64)program.target.general_registers) != 0 ||
            (call.clobber_float >> cast(u64)program.target.float_registers) != 0 ||
            (call.clobber_vector >> cast(u64)program.target.vector_registers) != 0 {
            return Fail(state, .Call, instruction = call.instruction)
        }
        instruction := program.instructions[call.instruction]
        if instruction.call != call_id ||
            call.indirect != (instruction.opcode == .CallIndirect) ||
            (call.indirect && call.calling != .Internal) ||
            call.argument_begin < instruction.operand_begin ||
            call.argument_begin + call.argument_count > instruction.operand_begin + instruction.operand_count ||
            (call.result_operand != MachineNoId &&
             (call.result_operand < instruction.operand_begin ||
              call.result_operand >= instruction.operand_begin + instruction.operand_count)) {
            return Fail(state, .Call, instruction = call.instruction)
        }
        if call.indirect && references[call_id] != 0 || !call.indirect && references[call_id] != 1 {
            return Fail(state, .Call, instruction = call.instruction)
        }
    }
    return true
}

// Every fuel check has exactly one counter relocation, and nothing else has
// one; the relocations were range-checked before.
FuelFacts :: (state: *VerifyState, program: MachineProgram, limits: MachineLimits) -> bool {
    counters: Vec(s32)
    defer VecFree(counters)
    if !Spend(state, program.relocations.count + program.instructions.count) { return false }
    if !VecResizeBounded(counters, program.instructions.count, limits.bytes) { return Fail(state, .Allocation) }
    for at: cast(s64)0..counters.count - 1 { counters[at] = 0 }
    for relocation: program.relocations {
        if relocation.kind == .FuelCounter { counters[relocation.instruction] += 1 }
    }
    for instruction_id: cast(s64)0..program.instructions.count - 1 {
        instruction := program.instructions[instruction_id]
        if instruction.opcode == .Fuel {
            if counters[instruction_id] != 1 || instruction.operand_count != 2 || instruction.flags_def == MachineNoId {
                return Fail(state, .Fuel, instruction = cast(s32)instruction_id)
            }
        } else if counters[instruction_id] != 0 {
            return Fail(state, .Fuel, instruction = cast(s32)instruction_id)
        }
    }
    return true
}

// Checked memory. Every load, store and zero reaches memory through an
// address that is checked or proven: a PointerResolve for at least its bytes
// (writable for a write), the fresh storage of an ArenaAllocate, or a
// PointerDirect covering them. Every PointerDirect is proven where it is
// defined: its token re-derives from the root its base starts. Byte
// comparisons read only views resolved for their own counts.

PointeeSize :: (program: MachineProgram, type_id: s32) -> s64 {
    if type_id < 0 || type_id >= program.types.count { return -1 }
    pointer := program.types[type_id]
    if pointer.kind != .Pointer || pointer.element < 0 || pointer.element >= program.types.count { return -1 }
    return program.types[pointer.element].size
}

// The virtual a Virtual operand names with ROLE, or MachineNoId.
VirtualAt :: (program: MachineProgram, instruction: MachineInstruction, local: s32,
    role: MachineOperandRole) -> s32 {
    if local < 0 || local >= instruction.operand_count { return MachineNoId }
    operand := program.operands[instruction.operand_begin + local]
    if operand.kind != .Virtual || operand.role != role { return MachineNoId }
    return operand.id
}

ImmediateAt :: (program: MachineProgram, instruction: MachineInstruction, local: s32, value: *u64) -> bool {
    if local < 0 || local >= instruction.operand_count { return false }
    operand := program.operands[instruction.operand_begin + local]
    if operand.kind != .Immediate { return false }
    <<value = operand.immediate
    return true
}

// The instruction defining each virtual, or MachineNoId, and the first
// instruction of each instruction's block.
Definers :: (state: *VerifyState, program: MachineProgram, limits: MachineLimits, definer: *Vec(s32),
    start: *Vec(s32)) -> bool {
    if !VecResizeBounded(<<definer, program.virtuals.count, limits.bytes / 4) ||
        !VecResizeBounded(<<start, program.instructions.count, limits.bytes / 4) { return Fail(state, .Allocation) }
    for at: cast(s64)0..program.virtuals.count - 1 { (<<definer)[at] = MachineNoId }
    for at: cast(s64)0..program.instructions.count - 1 { (<<start)[at] = MachineNoId }
    for block: program.blocks {
        for at: block.instruction_begin..block.instruction_begin + block.instruction_count - 1 {
            if !Spend(state, 1) { return false }
            (<<start)[at] = block.instruction_begin
        }
    }
    for instruction_id: cast(s32)0..cast(s32)program.instructions.count - 1 {
        instruction := program.instructions[instruction_id]
        for local: 0..instruction.operand_count - 1 {
            if !Spend(state, 1) { return false }
            operand := program.operands[instruction.operand_begin + local]
            if operand.kind == .Virtual && (operand.role == .Define || operand.role == .UseDefine) {
                (<<definer)[operand.id] = instruction_id
            }
        }
    }
    return true
}

// The constant a MoveImmediate gives VALUE, when one does.
ConstantOf :: (program: MachineProgram, definer: []s32, value: s32, constant: *u64) -> bool {
    if value < 0 || value >= definer.count || definer[value] < 0 { return false }
    source := program.instructions[definer[value]]
    return source.opcode == .MoveImmediate && source.operand_count == 2 &&
        VirtualAt(program, source, 0, .Define) == value && ImmediateAt(program, source, 1, constant)
}

// ROOM less INDEX elements of SIZE bytes, or -1 when that leaves the root.
Less :: (room: s64, index: s64, size: s64) -> s64 {
    if room < 0 || index < 0 || size < 0 || size > 0 && index > room / size { return -1 }
    return room - index * size
}

// The room after STEP, a field or element address, from a pointer with ROOM
// bytes to its root's end, or -1. An element moves by its constant index, or
// by at most bound - 1 elements where its index is checked (or proven) below
// the bound: a fixed array's count, a constant count, or the proven bound.
StepRoom :: (program: MachineProgram, definer: []s32, step: MachineInstruction, room: s64) -> s64 {
    parent := VirtualAt(program, step, 1, .Use)
    result := VirtualAt(program, step, 0, .Define)
    if parent < 0 || result < 0 || PointeeSize(program, program.virtuals[parent].type) < 0 { return -1 }
    target := program.types[program.types[program.virtuals[parent].type].element]
    if step.opcode == .FieldAddress {
        index: u64
        if step.operand_count != 3 || !ImmediateAt(program, step, 2, *index) { return -1 }
        if target.kind == .Array {
            if index >= cast(u64)target.count || target.element < 0 || target.element >= program.types.count { return -1 }
            return Less(room, cast(s64)index, program.types[target.element].size)
        }
        if target.kind != .Record || index >= cast(u64)target.fields_count || target.fields_begin < 0 ||
            cast(s64)target.fields_begin + target.fields_count > program.type_ids.count { return -1 }
        offset: s64
        for at: cast(s64)0..cast(s64)index - 1 {
            field := program.type_ids[target.fields_begin + at]
            if field < 0 || field >= program.types.count || program.types[field].size < 0 { return -1 }
            offset += program.types[field].size
        }
        return Less(room, offset, 1)
    }
    if step.opcode != .ElementAddress || step.operand_count < 3 || step.operand_count > 5 { return -1 }
    element := PointeeSize(program, program.virtuals[result].type)
    if element <= 0 { return -1 }
    bound: u64
    if step.operand_count == 3 {
        if target.kind != .Array || target.count < 0 { return -1 }
        bound = cast(u64)target.count
    } else if step.operand_count == 4 && !ImmediateAt(program, step, 3, *bound) &&
        !ConstantOf(program, definer, VirtualAt(program, step, 3, .Use), *bound) { return -1 }
    if step.operand_count == 5 {
        // A subview starts at low <= high <= count.
        if !ConstantOf(program, definer, VirtualAt(program, step, 4, .Use), *bound) ||
            bound > cast(u64)room { return -1 }
        return Less(room, cast(s64)bound, element)
    }
    if bound < 1 || bound > cast(u64)room { return -1 }
    largest := cast(s64)bound - 1
    index: u64
    if ConstantOf(program, definer, VirtualAt(program, step, 2, .Use), *index) {
        // A constant at or past a checked bound traps at the step; only the
        // proven form, which has no check, must hold it below its bound.
        proven := step.operand_count == 4 && program.operands[step.operand_begin + 3].kind == .Immediate
        if index < bound { largest = cast(s64)index }
        else if proven { return -1 }
    }
    return Less(room, largest, element)
}

// The room of TOKEN when it derives, through field and element steps, from
// the root whose raw start BASE holds: the PointerCreate on BASE's
// ArenaAllocate, or the token of the global BASE addresses. That root is live
// for the whole frame and writable when WRITE. -1 otherwise.
DirectRoom :: (state: *VerifyState, program: MachineProgram, definer: []s32, start: []s32,
    steps: *Vec(s32), token: s32, base: s32, write: bool) -> s64 {
    if base < 0 || base >= definer.count || definer[base] < 0 { return -1 }
    base_instruction := program.instructions[definer[base]]
    if VirtualAt(program, base_instruction, 0, .Define) != base || !VecResize(<<steps, 0) { return -1 }
    current := token
    room: s64 = -1
    while room < 0 {
        if !Spend(state, 1) { return -1 }
        if (<<steps).count > program.instructions.count || current < 0 || current >= definer.count ||
            definer[current] < 0 { return -1 }
        at := definer[current]
        instruction := program.instructions[at]
        if VirtualAt(program, instruction, 0, .Define) != current { return -1 }
        if instruction.opcode == .FieldAddress || instruction.opcode == .ElementAddress {
            if !VecPush(<<steps, at) { return -1 }
            current = VirtualAt(program, instruction, 1, .Use)
            continue
        }
        if instruction.opcode == .PointerCreate {
            // token, raw, size, scratch, flags, chain: frame storage stays
            // live until its function returns and is never resized. BASE is
            // that storage, an ArenaAllocate of at least those bytes earlier
            // in the same block, so each run of it reaches the create.
            created: u64
            flags: u64
            arena: u64
            if instruction.operand_count != 6 || VirtualAt(program, instruction, 1, .Use) != base ||
                !ImmediateAt(program, instruction, 2, *created) || !ImmediateAt(program, instruction, 4, *flags) ||
                (flags & cast(u64)MachinePointerHeap) != 0 || (flags & cast(u64)MachinePointerLive) == 0 ||
                write && (flags & cast(u64)MachinePointerWritable) == 0 ||
                base_instruction.opcode != .ArenaAllocate || base_instruction.operand_count != 3 ||
                !ImmediateAt(program, base_instruction, 1, *arena) || arena < created ||
                created > 9223372036854775807 || definer[base] >= at || start[at] == MachineNoId ||
                start[definer[base]] != start[at] { return -1 }
            room = cast(s64)created
        } else if instruction.opcode == .MoveImmediate {
            // A global's token: slot 1 + G, version 0, offset 0. Globals are
            // never retired or resized.
            immediate: u64
            if instruction.operand_count != 2 || !ImmediateAt(program, instruction, 1, *immediate) { return -1 }
            slot := cast(s64)(immediate >> cast(u64)MachinePointerSlotShift)
            global := slot - 1
            if global < 0 || global >= program.globals.count || immediate != MachinePointerToken(slot, 0, 0) { return -1 }
            entry := program.globals[global]
            symbol := program.operands[base_instruction.operand_begin + 1]
            if write && !entry.writable || entry.type < 0 || entry.type >= program.types.count ||
                base_instruction.opcode != .GlobalAddress || base_instruction.operand_count != 2 ||
                symbol.kind != .Global || symbol.id != cast(s32)global { return -1 }
            room = program.types[entry.type].size
            if room < 0 { return -1 }
        } else { return -1 }
    }
    at := (<<steps).count - 1
    while at >= 0 && room >= 0 {
        room = StepRoom(program, definer, program.instructions[(<<steps)[at]], room)
        at -= 1
    }
    return room
}

// Whether ADDRESS, operand LOCAL of INSTRUCTION, is checked or proven for
// WIDTH bytes.
CheckedAddress :: (state: *VerifyState, program: MachineProgram, definer: []s32, start: []s32,
    steps: *Vec(s32), instruction: MachineInstruction, local: s32, width: s64, write: bool) -> bool {
    address := VirtualAt(program, instruction, local, .Use)
    if address < 0 || width < 0 || definer[address] < 0 { return false }
    source := program.instructions[definer[address]]
    if VirtualAt(program, source, 0, .Define) != address { return false }
    if source.opcode == .PointerResolve {
        resolved: u64
        flags: u64
        return source.operand_count == 5 && ImmediateAt(program, source, 2, *resolved) &&
            ImmediateAt(program, source, 4, *flags) && resolved >= cast(u64)width &&
            (!write || (flags & 1) != 0)
    }
    if source.opcode == .ArenaAllocate {
        size: u64
        return source.operand_count == 3 && ImmediateAt(program, source, 1, *size) && size >= cast(u64)width
    }
    if source.opcode == .PointerDirect {
        // Proven where it is defined (DirectProven); here it must cover
        // the access.
        covered: u64
        flags: u64
        return source.operand_count == 5 && ImmediateAt(program, source, 3, *covered) &&
            ImmediateAt(program, source, 4, *flags) && covered >= cast(u64)width && (!write || (flags & 1) != 0)
    }
    return false
}

// Whether DIRECT, a PointerDirect, covers the bytes and writability it
// claims: its token derives from the root its base starts, with that much
// room.
DirectProven :: (state: *VerifyState, program: MachineProgram, definer: []s32, start: []s32,
    steps: *Vec(s32), direct: MachineInstruction) -> bool {
    covered: u64
    flags: u64
    token := VirtualAt(program, direct, 1, .Use)
    base := VirtualAt(program, direct, 2, .Use)
    if direct.operand_count != 5 || VirtualAt(program, direct, 0, .Define) < 0 || token < 0 || base < 0 ||
        !ImmediateAt(program, direct, 3, *covered) || !ImmediateAt(program, direct, 4, *flags) ||
        covered > 9223372036854775807 || flags > 1 { return false }
    room := DirectRoom(state, program, definer, start, steps, token, base, flags == 1)
    return room >= 0 && cast(s64)covered <= room
}

// A byte view at operand LOCAL, resolved for the count virtual after it.
ResolvedView :: (program: MachineProgram, definer: []s32, instruction: MachineInstruction, local: s32) -> bool {
    address := VirtualAt(program, instruction, local, .Use)
    count := VirtualAt(program, instruction, local + 1, .Use)
    if address < 0 || count < 0 || definer[address] < 0 { return false }
    source := program.instructions[definer[address]]
    return source.opcode == .PointerResolve && source.operand_count == 5 &&
        VirtualAt(program, source, 0, .Define) == address && VirtualAt(program, source, 2, .Use) == count
}

CheckedMemory :: (state: *VerifyState, program: MachineProgram, limits: MachineLimits) -> bool {
    definer: Vec(s32)
    defer VecFree(definer)
    start: Vec(s32)
    defer VecFree(start)
    steps: Vec(s32)
    defer VecFree(steps)
    if !Definers(state, program, limits, *definer, *start) { return false }
    for instruction_id: cast(s32)0..cast(s32)program.instructions.count - 1 {
        if !Spend(state, 1) { return false }
        instruction := program.instructions[instruction_id]
        checked := true
        if instruction.opcode == .Load || instruction.opcode == .Store {
            if instruction.operand_count != 2 { return Fail(state, .Unchecked, instruction = instruction_id) }
            address := ifx instruction.opcode == .Load then cast(s32)1 else 0
            value := VirtualAt(program, instruction, 1 - address,
                ifx instruction.opcode == .Load then MachineOperandRole.Define else .Use)
            checked = value >= 0 && CheckedAddress(state, program, definer[:], start[:], *steps, instruction, address,
                program.types[program.virtuals[value].type].size, instruction.opcode == .Store)
        } else if instruction.opcode == .Zero {
            address := VirtualAt(program, instruction, 0, .Use)
            checked = instruction.operand_count == 1 && address >= 0 && CheckedAddress(state, program, definer[:],
                start[:], *steps, instruction, 0, PointeeSize(program, program.virtuals[address].type), true)
        } else if instruction.opcode == .BytesEqual {
            checked = ResolvedView(program, definer[:], instruction, 1) && ResolvedView(program, definer[:], instruction, 3)
        } else if instruction.opcode == .PointerDirect {
            checked = DirectProven(state, program, definer[:], start[:], *steps, instruction)
        }
        if state.diagnostic.problem != .None { return false }
        if !checked { return Fail(state, .Unchecked, instruction = instruction_id) }
    }
    return true
}

#scope_export

MachineVerify :: (program: MachineProgram, limits: MachineLimits) -> MachineDiagnostic {
    state := VerifyState.{.diagnostic = NoDiagnostic(), .remaining = limits.work}
    if program.version != MachineVersion { Fail(*state, .Version); return state.diagnostic }
    if program.stage != .Virtual { Fail(*state, .Stage); return state.diagnostic }
    if !TargetValid(program.target) { Fail(*state, .Target); return state.diagnostic }
    if !TargetMachineLoweringSupported(program.target) {
        Fail(*state, .UnsupportedTarget)
        return state.diagnostic
    }
    if !Counts(*state, program, limits) || !Metadata(*state, program) ||
        !VirtualsAndStack(*state, program) || !Instructions(*state, program, limits) ||
        !CallsAndRelocations(*state, program, limits) || !FuelFacts(*state, program, limits) ||
        program.checks && !CheckedMemory(*state, program, limits) { return state.diagnostic }
    if !Optional(program.entry, program.functions.count) ||
        program.entry != MachineNoId && program.functions[program.entry].calling != .Internal {
        Fail(*state, .Function)
    }
    return state.diagnostic
}
