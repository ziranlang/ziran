using IR :: #import "compiler_lowered_ir"
using Verify :: #import "compiler_lowered_verify"
using Codec :: #import "compiler_exec_serial"
using Vectors :: #import "std/vec"
using Rotate :: #import "compiler_opt_rotate"
using LoopSSA :: #import "compiler_opt_ssa"
using Licm :: #import "compiler_opt_licm"
using Induction :: #import "compiler_opt_induction"
using Layout :: #import "compiler_opt_layout"
using Inline :: #import "compiler_opt_inline"
#import "compiler_learning"

LirOptProblem :: enum s32 {
    None; Owner; Options; VerifyInput; VerifyPass; Limit; Allocation; Codec
}

LirOptPassCounters :: struct {
    runs: s64
    instructions: s64
    values: s64
    blocks: s64
    constants: s64
    types: s64
    origins: s64
}

LirOptCounters :: struct {
    fold: LirOptPassCounters
    copy: LirOptPassCounters
    cse: LirOptPassCounters
    dead: LirOptPassCounters
    cfg: LirOptPassCounters
    compact: LirOptPassCounters
    rotate: LirOptPassCounters
    licm: LirOptPassCounters
    induction: LirOptPassCounters
    layout: LirOptPassCounters
    inline_leaf: LirOptPassCounters
    inline_calls: LirOptPassCounters
    input_functions: s64
    input_blocks: s64
    input_values: s64
    input_instructions: s64
    output_functions: s64
    output_blocks: s64
    output_values: s64
    output_instructions: s64
}

LirOptOptions :: struct {
    fold_constants: bool
    propagate_copies: bool
    eliminate_dead: bool
    simplify_cfg: bool
    maximum_rounds: s32
    inline_leaf_operations: s32
    // Calls to procedures of at most this many instructions are inlined; 0 keeps every call.
    inline_calls: s32
}

LirOptOwner :: struct {
    valid: bool
    program: LirProgram
    storage: LirReadOwner
}

LirOptResult :: struct {
    problem: LirOptProblem
    diagnostic: LirDiagnostic
    counters: LirOptCounters
    work: s64
    scratch_bytes: s64
}

#scope_file
OptState :: struct {
    problem: LirOptProblem
    diagnostic: LirDiagnostic
    remaining: s64
    used: s64
    scratch_bytes: s64
    peak_scratch_bytes: s64
    maximum_bytes: s64
    counters: LirOptCounters
}

ConstantFact :: struct {
    known: bool
    type: s32
    bits: u64
}

TextFact :: struct {
    known: bool
    bytes: []u8
    count: s64
}

DefinitionAt :: (function: LirFunction, value: s32) -> LirInstruction {
    if value < 0 { return .{} }
    for block: function.blocks {
        for instruction: block.instructions {
            if instruction.result == value { return instruction }
        }
    }
    return .{}
}

TextByteAt :: (text: TextFact, index: s64) -> u8 {
    if index < 0 || index >= text.count || index >= text.bytes.count { return 0 }
    return text.bytes[index]
}

// Pure-call interpretation has its own small budget. Exhaustion leaves the
// runtime call in place and never marks optimizer state as a compilation error.
EvalBudget :: struct {
    work: s64
    scratch_bytes: s64
    maximum_bytes: s64
}

// Successful result of bounded interpretation of one direct call.
EvalFact :: struct {
    fact: ConstantFact
    ok: bool
}

// A compile-time string is the constant bytes addressed by an aggregate's
// first field and the aggregate's constant element count. Rejecting writable
// globals and nonzero element offsets keeps the view tied to literal storage.
ConstantText :: (program: LirProgram, function: LirFunction,
    value: s32) -> TextFact {
    unknown: TextFact
    if value < 0 { return unknown }
    aggregate := DefinitionAt(function, value)
    if aggregate.op != .Aggregate || aggregate.operands.count != 2 { return unknown }
    count := DefinitionAt(function, aggregate.operands[1])
    if count.op != .Constant || count.symbol < 0 ||
        count.symbol >= program.constants.count { return unknown }
    length := program.constants[count.symbol].bits
    address := DefinitionAt(function, aggregate.operands[0])
    if address.op == .ElementAddress {
        if address.operands.count != 2 { return unknown }
        offset := DefinitionAt(function, address.operands[1])
        if offset.op != .Constant || offset.symbol < 0 ||
            offset.symbol >= program.constants.count ||
            program.constants[offset.symbol].bits != 0 { return unknown }
        address = DefinitionAt(function, address.operands[0])
    }
    if address.op != .GlobalAddress || address.symbol < 0 ||
        address.symbol >= program.globals.count { return unknown }
    global := program.globals[address.symbol]
    if global.writable || global.constant < 0 ||
        global.constant >= program.constants.count { return unknown }
    bytes := program.constants[global.constant].bytes
    if length > cast(u64)bytes.count { return unknown }
    return .{known = true, bytes = bytes, count = cast(s64)length}
}

TextLowerASCII :: (value: u8) -> u8 {
    if value >= 65 && value <= 90 { return value + 32 }
    return value
}

// Folds the two exported ASCII predicates by their published definitions.
// Interpretation work is bounded independently; exhaustion leaves the call.
FoldTextCall :: (state: *OptState, program: LirProgram, callee: LirFunction,
    function: LirFunction, instruction: LirInstruction,
    budget: *EvalBudget) -> ConstantFact {
    unknown: ConstantFact
    if callee.module < 0 || callee.module >= program.modules.count ||
        program.modules[callee.module] != "text" || instruction.operands.count != 2 {
        return unknown
    }
    if callee.name == "StartsWithFoldASCII" {
        value := ConstantText(program, function, instruction.operands[0])
        prefix := ConstantText(program, function, instruction.operands[1])
        if !value.known || !prefix.known || prefix.count > value.count { return unknown }
        for index: 0..cast(s64)prefix.count - 1 {
            if !EvalSpend(budget, 1) { return unknown }
            if TextLowerASCII(TextByteAt(value, index)) != TextLowerASCII(TextByteAt(prefix, index)) {
                return .{known = true, type = callee.result, bits = 0}
            }
        }
        return .{known = true, type = callee.result, bits = 1}
    }
    if callee.name == "ContainsFoldASCII" {
        value := ConstantText(program, function, instruction.operands[0])
        needle := ConstantText(program, function, instruction.operands[1])
        if !value.known || !needle.known { return unknown }
        if needle.count == 0 { return .{known = true, type = callee.result, bits = 1} }
        if needle.count > value.count { return .{known = true, type = callee.result, bits = 0} }
        last := cast(s64)value.count - cast(s64)needle.count
        for start: 0..last {
            same := true
            for index: 0..cast(s64)needle.count - 1 {
                if !EvalSpend(budget, 1) { return unknown }
                if TextLowerASCII(TextByteAt(value, start + index)) != TextLowerASCII(TextByteAt(needle, index)) {
                    same = false
                    break
                }
            }
            if same { return .{known = true, type = callee.result, bits = 1} }
        }
        return .{known = true, type = callee.result, bits = 0}
    }
    return unknown
}

EmptyDiagnostic :: () -> LirDiagnostic {
    return .{problem = .None, function = LirNoId, block = LirNoId,
        instruction = LirNoId, value = LirNoId, origin = LirNoId}
}

Fail :: (state: *OptState, problem: LirOptProblem) -> bool {
    if state.problem == .None { state.problem = problem }
    return false
}

RenumberEffects :: (function: *LirFunction) {
    for block_index: 0..function.blocks.count - 1 {
        effect: s32
        block := function.blocks[block_index]
        for instruction_index: 0..block.instructions.count - 1 {
            instruction := block.instructions[instruction_index]
            if LirEffectful(instruction.op) {
                effect += 1
                instruction.effect = effect
            } else {
                instruction.effect = 0
            }
            block.instructions[instruction_index] = instruction
        }
        function.blocks[block_index] = block
    }
}

Spend :: (state: *OptState, count: s64) -> bool {
    if count < 0 || count > state.remaining { return Fail(state, .Limit) }
    state.remaining -= count
    state.used += count
    return true
}

EvalSpend :: (budget: *EvalBudget, count: s64) -> bool {
    if count < 0 || count > budget.work { return false }
    budget.work -= count
    return true
}

EvalScratch :: (budget: *EvalBudget, count: s64, width: s64) -> bool {
    if count < 0 || width < 1 || count > 2147483647 ||
        budget.scratch_bytes > budget.maximum_bytes ||
        count > (budget.maximum_bytes - budget.scratch_bytes) / width { return false }
    budget.scratch_bytes += count * width
    return true
}

EvalRelease :: (budget: *EvalBudget, bytes: s64) {
    budget.scratch_bytes -= bytes
}

Scratch :: (state: *OptState, count: s64, width: s64) -> bool {
    if count < 0 || width < 1 || count > 2147483647 ||
        state.scratch_bytes > state.maximum_bytes ||
        count > (state.maximum_bytes - state.scratch_bytes) / width { return Fail(state, .Limit) }
    state.scratch_bytes += count * width
    if state.scratch_bytes > state.peak_scratch_bytes {
        state.peak_scratch_bytes = state.scratch_bytes
    }
    return true
}

ScratchRelease :: (state: *OptState, bytes: s64) {
    if bytes >= 0 && bytes <= state.scratch_bytes { state.scratch_bytes -= bytes }
}

ScratchReset :: (state: *OptState) {
    state.scratch_bytes = 0
}

CountProgram :: (state: *OptState, program: LirProgram, output: bool) -> bool {
    blocks: s64
    values: s64
    instructions: s64
    for function: program.functions {
        if !Spend(state, 1) { return false }
        if function.blocks.count > 9223372036854775807 - blocks ||
            function.values.count > 9223372036854775807 - values { return Fail(state, .Limit) }
        blocks += function.blocks.count
        values += function.values.count
        for block: function.blocks {
            if !Spend(state, 1) || block.instructions.count > 9223372036854775807 - instructions {
                return Fail(state, .Limit)
            }
            instructions += block.instructions.count
        }
    }
    if output {
        state.counters.output_functions = program.functions.count
        state.counters.output_blocks = blocks
        state.counters.output_values = values
        state.counters.output_instructions = instructions
    } else {
        state.counters.input_functions = program.functions.count
        state.counters.input_blocks = blocks
        state.counters.input_values = values
        state.counters.input_instructions = instructions
    }
    return true
}

CodecFailure :: (state: *OptState, result: LirCodecResult) -> bool {
    if result.problem == .Allocation { return Fail(state, .Allocation) }
    if result.problem == .Limit || result.problem == .Output || result.problem == .Count {
        return Fail(state, .Limit)
    }
    if result.problem == .Verify {
        state.diagnostic = result.diagnostic
        return Fail(state, .VerifyPass)
    }
    return Fail(state, .Codec)
}

SharedPassResult :: (state: *OptState, problem: LirSsaProblem,
    codec: LirCodecResult, work: s64, scratch_bytes: s64) -> bool {
    if !Spend(state, work) { return false }
    if scratch_bytes > state.peak_scratch_bytes { state.peak_scratch_bytes = scratch_bytes }
    if problem != .None { return Fail(state, ifx problem == .Allocation then .Allocation else .Limit) }
    if codec.problem != .None { return CodecFailure(state, codec) }
    return true
}

CloneProgram :: (state: *OptState, program: LirProgram, limits: LirLimits,
    owner: *LirReadOwner) -> bool {
    empty: []u8
    measured := LirWrite(program, empty)
    if measured.problem != .None { return CodecFailure(state, measured) }
    if !Scratch(state, measured.size, 1) { return false }
    defer ScratchRelease(state, measured.size)
    encoded: Vec(u8)
    defer VecFree(encoded)
    if !VecResizeBounded(encoded, measured.size, measured.size) { return Fail(state, .Allocation) }
    written := LirWrite(program, encoded[:])
    if written.problem != .None || written.size != measured.size { return CodecFailure(state, written) }
    read := LirRead(owner, TextView(encoded[:]), limits)
    if read.problem != .None { return CodecFailure(state, read) }
    return true
}

VerifyPass :: (state: *OptState, program: LirProgram, limits: LirLimits) -> bool {
    state.diagnostic = LirVerify(program, limits)
    if state.diagnostic.problem != .None { return Fail(state, .VerifyPass) }
    return true
}

Mask :: (bits: s32) -> u64 {
    if bits >= 64 { return 18446744073709551615 }
    return (cast(u64)1 << cast(u64)bits) - 1
}

Signed :: (bits: u64, width: s32) -> s64 {
    value := bits & Mask(width)
    if width < 64 && (value & (cast(u64)1 << cast(u64)(width - 1))) != 0 {
        value |= ~Mask(width)
    }
    return cast(s64)value
}

// The f32 pattern nearest the f64 pattern BITS, ties to even as the hardware
// converts; false for a NaN, whose payload is left to run time.
NarrowFloatBits :: (bits: u64, out: *u64) -> bool {
    sign := (bits >> 63) << 31
    exponent := cast(s64)((bits >> 52) & 0x7ff)
    fraction := bits & 0xfffffffffffff
    if exponent == 0x7ff {
        if fraction != 0 { return false }
        <<out = sign | 0x7f800000
        return true
    }
    // Zero, or a subnormal far below any f32.
    if exponent == 0 { <<out = sign; return true }
    unbiased := exponent - 1023
    if unbiased > 127 { <<out = sign | 0x7f800000; return true }
    if unbiased >= -126 {
        keep := fraction >> 29
        rest := fraction & 0x1fffffff
        if rest > 0x10000000 || rest == 0x10000000 && (keep & 1) == 1 { keep += 1 }
        biased := unbiased + 127
        if keep == 0x800000 { keep = 0; biased += 1 }
        if biased >= 255 { <<out = sign | 0x7f800000; return true }
        <<out = sign | (cast(u64)biased << 23) | keep
        return true
    }
    // An f32 subnormal or zero: the 53-bit significand shifted down to units
    // of 2^-149.
    shift := -unbiased - 97
    if shift > 54 { <<out = sign; return true }
    full := (cast(u64)1 << 52) | fraction
    keep := full >> cast(u64)shift
    rest := full & ((cast(u64)1 << cast(u64)shift) - 1)
    half := cast(u64)1 << cast(u64)(shift - 1)
    if rest > half || rest == half && (keep & 1) == 1 { keep += 1 }
    <<out = sign | keep
    return true
}

// The f64 pattern of the f32 pattern BITS, exactly; false for a NaN.
WidenFloatBits :: (bits: u64, out: *u64) -> bool {
    sign := ((bits >> 31) & 1) << 63
    exponent := (bits >> 23) & 0xff
    fraction := bits & 0x7fffff
    if exponent == 0xff {
        if fraction != 0 { return false }
        <<out = sign | 0x7ff0000000000000
        return true
    }
    if exponent == 0 {
        if fraction == 0 { <<out = sign; return true }
        // A subnormal: shift its leading bit up to the implicit one.
        shift: u64 = 0
        while (fraction & 0x800000) == 0 { fraction = fraction << 1; shift += 1 }
        <<out = sign | ((897 - shift) << 52) | ((fraction & 0x7fffff) << 29)
        return true
    }
    <<out = sign | ((exponent + 896) << 52) | (fraction << 29)
    return true
}

// A fixed-array global has its full extent before any use. Allocations have
// a different pointer shape, so only the GlobalAddress marker is accepted.
SafeConstantElement :: (program: LirProgram, function: LirFunction,
    base: s32, result: s32, index_symbol: s32) -> s32 {
    if base < 0 || base >= function.values.count || result < 0 ||
        result >= function.values.count || index_symbol < 0 ||
        index_symbol >= program.constants.count { return LirNoId }
    base_pointer := program.types[function.values[base]]
    result_pointer := program.types[function.values[result]]
    if base_pointer.kind != .Pointer || base_pointer.element == result_pointer.element ||
        result_pointer.kind != .Pointer ||
        base_pointer.element < 0 || base_pointer.element >= program.types.count ||
        result_pointer.element < 0 || result_pointer.element >= program.types.count {
        return LirNoId
    }
    target := program.types[base_pointer.element]
    if target.kind != .Array || target.element != result_pointer.element ||
        target.count < 1 { return LirNoId }
    constant := program.constants[index_symbol]
    if constant.type < 0 || constant.type >= program.types.count { return LirNoId }
    index_type := program.types[constant.type]
    if index_type.kind != .Integer || index_type.bits < 1 || index_type.bits > 64 {
        return LirNoId
    }
    if index_type.is_signed {
        index := Signed(constant.bits, index_type.bits)
        if index < 0 || index >= target.count { return LirNoId }
    } else if constant.bits >= cast(u64)target.count { return LirNoId }
    return base
}

Fact :: (facts: []ConstantFact, value: s32) -> ConstantFact {
    if value < 0 || value >= facts.count { return .{} }
    return facts[value]
}

FoldInstruction :: (program: LirProgram, function: LirFunction,
    instruction: LirInstruction, facts: []ConstantFact) -> ConstantFact {
    if instruction.result == LirNoId { return .{} }
    result_type_id := function.values[instruction.result]
    result_type := program.types[result_type_id]
    first: ConstantFact
    second: ConstantFact
    if instruction.operands.count > 0 { first = Fact(facts, instruction.operands[0]) }
    if instruction.operands.count > 1 { second = Fact(facts, instruction.operands[1]) }
    op := instruction.op
    if op == .Bitcast && first.known {
        source := program.types[first.type]
        if (source.kind == .Integer || source.kind == .Float) &&
            (result_type.kind == .Integer || result_type.kind == .Float) && source.bits == result_type.bits {
            return .{known = true, type = result_type_id, bits = first.bits & Mask(result_type.bits)}
        }
    }
    if op == .Convert && first.known {
        source := program.types[first.type]
        bits: u64
        if source.kind == .Bool && result_type.kind == .Integer {
            bits = cast(u64)(first.bits != 0)
        } else if source.kind == .Integer && result_type.kind == .Bool {
            bits = cast(u64)((first.bits & Mask(source.bits)) != 0)
        } else if source.kind == .Integer && result_type.kind == .Integer {
            bits = first.bits & Mask(source.bits)
            if source.is_signed && source.bits < 64 &&
                (bits & (cast(u64)1 << cast(u64)(source.bits - 1))) != 0 { bits |= ~Mask(source.bits) }
            bits &= Mask(result_type.bits)
        } else if source.kind == .Float && result_type.kind == .Float && source.bits == result_type.bits {
            bits = first.bits
        } else if source.kind == .Float && result_type.kind == .Float && source.bits == 64 && result_type.bits == 32 {
            if !NarrowFloatBits(first.bits, *bits) { return .{} }
        } else if source.kind == .Float && result_type.kind == .Float && source.bits == 32 && result_type.bits == 64 {
            if !WidenFloatBits(first.bits & 0xffffffff, *bits) { return .{} }
        } else { return .{} }
        return .{known = true, type = result_type_id, bits = bits}
    }
    // Negating a float flips its sign bit, exactly as the hardware does.
    if op == .Negate && first.known && result_type.kind == .Float &&
        program.types[first.type].kind == .Float && program.types[first.type].bits == result_type.bits {
        return .{known = true, type = result_type_id,
            bits = first.bits ^ (cast(u64)1 << cast(u64)(result_type.bits - 1))}
    }
    if op == .Negate || op == .BitNot {
        if !first.known || result_type.kind != .Integer { return .{} }
        bits := first.bits & Mask(result_type.bits)
        if op == .Negate { bits = 0 - bits }
        else { bits = ~bits }
        return .{known = true, type = result_type_id, bits = bits & Mask(result_type.bits)}
    }
    if op == .Equal || op == .NotEqual || op == .Less || op == .LessEqual ||
        op == .Greater || op == .GreaterEqual {
        if !first.known || !second.known { return .{} }
        type := program.types[first.type]
        answer: bool
        if type.kind == .Integer && type.is_signed {
            left := Signed(first.bits, type.bits)
            right := Signed(second.bits, type.bits)
            if op == .Equal { answer = left == right }
            if op == .NotEqual { answer = left != right }
            if op == .Less { answer = left < right }
            if op == .LessEqual { answer = left <= right }
            if op == .Greater { answer = left > right }
            if op == .GreaterEqual { answer = left >= right }
        } else if type.kind == .Integer || type.kind == .Bool {
            left := first.bits
            right := second.bits
            if type.kind == .Integer { left &= Mask(type.bits); right &= Mask(type.bits) }
            if op == .Equal { answer = left == right }
            if op == .NotEqual { answer = left != right }
            if op == .Less { answer = left < right }
            if op == .LessEqual { answer = left <= right }
            if op == .Greater { answer = left > right }
            if op == .GreaterEqual { answer = left >= right }
        } else { return .{} }
        return .{known = true, type = result_type_id, bits = cast(u64)answer}
    }
    if !first.known || !second.known || result_type.kind != .Integer { return .{} }
    left := first.bits & Mask(result_type.bits)
    right := second.bits
    if op != .ShiftLeft && op != .ShiftRight { right &= Mask(result_type.bits) }
    bits: u64
    if op == .Add { bits = left + right }
    else if op == .Subtract { bits = left - right }
    else if op == .Multiply { bits = left * right }
    else if op == .BitAnd { bits = left & right }
    else if op == .BitOr { bits = left | right }
    else if op == .BitXor { bits = left ^ right }
    else if op == .Divide || op == .Remainder {
        if right == 0 { return .{} }
        if result_type.is_signed {
            signed_left := Signed(left, result_type.bits)
            signed_right := Signed(right, result_type.bits)
            minimum := cast(u64)1 << cast(u64)(result_type.bits - 1)
            if left == minimum && signed_right == -1 {
                bits = ifx op == .Divide then minimum else 0
            } else if op == .Divide { bits = cast(u64)(signed_left / signed_right) }
            else { bits = cast(u64)(signed_left % signed_right) }
        } else if op == .Divide { bits = left / right }
        else { bits = left % right }
    } else if op == .ShiftLeft || op == .ShiftRight {
        count_type := program.types[second.type]
        count := second.bits & Mask(count_type.bits)
        if count >= cast(u64)result_type.bits { return .{} }
        if op == .ShiftLeft { bits = left << count }
        else {
            bits = left >> count
            if result_type.is_signed && count != 0 &&
                (left & (cast(u64)1 << cast(u64)(result_type.bits - 1))) != 0 {
                bits |= Mask(result_type.bits) ^ (Mask(result_type.bits) >> count)
            }
        }
    } else { return .{} }
    return .{known = true, type = result_type_id, bits = bits & Mask(result_type.bits)}
}

FoldPass :: (state: *OptState, owner: *LirOptOwner, limits: LirLimits,
    options: LirOptOptions) -> bool {
    program := LirReadProgram(*owner.storage)
    maximum := program.constants.count + state.counters.input_instructions
    if maximum < program.constants.count || maximum > 2147483647 ||
        !Scratch(state, maximum, 40) { return false }
    constants: Vec(LirConstant)
    defer VecFree(constants)
    if !VecResizeBounded(constants, maximum, maximum) { return Fail(state, .Allocation) }
    for index: 0..program.constants.count - 1 {
        if !Spend(state, 1) { return false }
        constants[index] = program.constants[index]
    }
    constant_count := program.constants.count
    maximum_values: s64
    for function: program.functions { if function.values.count > maximum_values { maximum_values = function.values.count } }
    if !Scratch(state, maximum_values, 24) { return false }
    facts: Vec(ConstantFact)
    defer VecFree(facts)
    if !VecResizeBounded(facts, maximum_values, maximum_values) { return Fail(state, .Allocation) }
    total: s64
    for round: 0..options.maximum_rounds - 1 {
        changed: s64
        state.counters.fold.runs += 1
        for function_index: 0..program.functions.count - 1 {
            function := program.functions[function_index]
            function_changed: s64
            for value: 0..function.values.count - 1 { facts[value] = .{} }
            uses_text := false
            for block: function.blocks {
                for instruction: block.instructions {
                    if instruction.op != .Call || instruction.symbol < 0 ||
                        instruction.symbol >= program.functions.count { continue }
                    callee := program.functions[instruction.symbol]
                    if callee.module < 0 || callee.module >= program.modules.count { continue }
                    if program.modules[callee.module] == "text" &&
                        (callee.name == "StartsWithFoldASCII" ||
                         callee.name == "ContainsFoldASCII") { uses_text = true; break }
                }
                if uses_text { break }
            }
            for block: function.blocks {
                for instruction: block.instructions {
                    if !Spend(state, 1) { return false }
                    if instruction.op == .Constant {
                        constant := constants[instruction.symbol]
                        facts[instruction.result] = .{known = true, type = constant.type, bits = constant.bits}
                    }
                }
            }
            for block_index: 0..function.blocks.count - 1 {
                block := function.blocks[block_index]
                for instruction_index: 0..block.instructions.count - 1 {
                    if !Spend(state, 1) { return false }
                    instruction := block.instructions[instruction_index]
                    if instruction.op == .Constant {
                        constant := constants[instruction.symbol]
                        facts[instruction.result] = .{known = true, type = constant.type, bits = constant.bits}
                        continue
                    }
                    if instruction.op == .Call {
                        if instruction.symbol < 0 ||
                            instruction.symbol >= program.functions.count { continue }
                        arguments_known := true
                        for argument: instruction.operands {
                            if !facts[argument].known { arguments_known = false; break }
                        }
                        if arguments_known {
                            evaluation_work := limits.work
                            if evaluation_work > 1000000 { evaluation_work = 1000000 }
                            evaluation_bytes := limits.bytes
                            if evaluation_bytes > 1048576 { evaluation_bytes = 1048576 }
                            budget := EvalBudget.{work = evaluation_work,
                                maximum_bytes = evaluation_bytes}
                            evaluated := EvaluatePureCall(state, program,
                                instruction.symbol, facts[:function.values.count],
                                instruction.operands[:], 0, *budget)
                            if state.problem != .None { return false }
                            if evaluated.ok && instruction.result != LirNoId &&
                                evaluated.fact.type == function.values[instruction.result] {
                                if constant_count >= constants.count { return Fail(state, .Limit) }
                                constants[constant_count] = .{type = evaluated.fact.type,
                                    bits = evaluated.fact.bits}
                                instruction.op = .Constant
                                instruction.operands = instruction.operands[:0]
                                instruction.edges = instruction.edges[:0]
                                instruction.immediate = 0
                                instruction.symbol = cast(s32)constant_count
                                instruction.alignment = 0
                                instruction.effect = 0
                                block.instructions[instruction_index] = instruction
                                facts[instruction.result] = evaluated.fact
                                constant_count += 1
                                program.constants = constants[:constant_count]
                                changed += 1
                                function_changed += 1
                                total += 1
                                continue
                            }
                        }
                        if uses_text && instruction.result != LirNoId {
                            callee := program.functions[instruction.symbol]
                            text_budget := EvalBudget.{work = 4096}
                            folded_text := FoldTextCall(state, program, callee,
                                function, instruction, *text_budget)
                            if state.problem != .None { return false }
                            if folded_text.known && folded_text.type == function.values[instruction.result] {
                                if constant_count >= constants.count { return Fail(state, .Limit) }
                                constants[constant_count] = .{type = folded_text.type,
                                    bits = folded_text.bits}
                                instruction.op = .Constant
                                instruction.operands = instruction.operands[:0]
                                instruction.edges = instruction.edges[:0]
                                instruction.immediate = 0
                                instruction.symbol = cast(s32)constant_count
                                instruction.alignment = 0
                                instruction.effect = 0
                                block.instructions[instruction_index] = instruction
                                facts[instruction.result] = folded_text
                                constant_count += 1
                                program.constants = constants[:constant_count]
                                changed += 1
                                function_changed += 1
                                total += 1
                                continue
                            }
                        }
                        continue
                    }
                    folded := FoldInstruction(program, function, instruction, facts[:function.values.count])
                    if !folded.known { continue }
                    if constant_count >= constants.count { return Fail(state, .Limit) }
                    constants[constant_count] = .{type = folded.type, bits = folded.bits}
                    instruction.op = .Constant
                    instruction.operands = instruction.operands[:0]
                    instruction.edges = instruction.edges[:0]
                    instruction.immediate = 0
                    instruction.symbol = cast(s32)constant_count
                    instruction.alignment = 0
                    instruction.effect = 0
                    block.instructions[instruction_index] = instruction
                    facts[instruction.result] = folded
                    constant_count += 1
                    program.constants = constants[:constant_count]
                    changed += 1
                    function_changed += 1
                    total += 1
                    continue
                }
                function.blocks[block_index] = block
            }
            if function_changed > 0 { RenumberEffects(*function) }
            program.functions[function_index] = function
        }
        if changed == 0 { break }
    }
    state.counters.fold.instructions += total
    state.counters.fold.constants += total
    pass_program := program
    pass_program.constants = constants[:constant_count]
    if !VerifyPass(state, pass_program, limits) { return false }
    if total == 0 { return true }
    return CloneProgram(state, pass_program, limits, *owner.storage)
}

// Follows one executable path through a direct non-external procedure. Only
// scalar integer and Boolean computations are admitted: every effectful
// operation except the fuel marker makes the value unknown, an unknown branch
// makes it unknown, and revisiting a block proves a loop. Recursive calls use
// the same rules and a hard depth bound. This folds only computations the
// program would actually perform; fuel and trapping behavior remain in every
// path the compiler leaves behind.
EvaluatePureCall :: (state: *OptState, program: LirProgram,
    symbol: s32, facts: []ConstantFact, arguments: []s32, depth: s32,
    budget: *EvalBudget) -> EvalFact {
    unknown: EvalFact
    if depth >= 64 || !EvalSpend(budget, 1) { return unknown }
    if symbol < 0 || symbol >= program.functions.count { return unknown }
    callee := program.functions[symbol]
    if callee.external || callee.calling != .Portable || callee.blocks.count < 1 ||
        callee.result < 0 || callee.result >= program.types.count ||
        callee.parameters.count != arguments.count { return unknown }
    result := program.types[callee.result]
    if (result.kind != .Integer && result.kind != .Bool) || result.bits < 1 || result.bits > 64 {
        return unknown
    }
    for at: 0..callee.parameters.count - 1 {
        type := program.types[facts[arguments[at]].type]
        if (type.kind != .Integer && type.kind != .Bool) || type.bits < 1 || type.bits > 64 {
            return unknown
        }
    }
    if !EvalScratch(budget, callee.values.count, 24) ||
        !EvalScratch(budget, callee.blocks.count, 1) {
        return unknown
    }
    frame_bytes := callee.values.count * 24 + callee.blocks.count
    defer EvalRelease(budget, frame_bytes)
    values: Vec(ConstantFact)
    defer VecFree(values)
    visited: Vec(u8)
    defer VecFree(visited)
    if !VecResizeBounded(values, callee.values.count, callee.values.count) ||
        !VecResizeBounded(visited, callee.blocks.count, callee.blocks.count) {
        return unknown
    }
    for value: 0..callee.values.count - 1 { values[value] = .{} }
    for block: 0..callee.blocks.count - 1 { visited[block] = 0 }
    entry := callee.blocks[callee.entry]
    if entry.parameters.count != callee.parameters.count { return unknown }
    for at: 0..entry.parameters.count - 1 {
        values[entry.parameters[at]] = facts[arguments[at]]
    }

    block_index := callee.entry
    while true {
        if visited[block_index] != 0 { return unknown }
        visited[block_index] = 1
        block := callee.blocks[block_index]
        next: s32 = LirNoId
        for instruction: block.instructions {
            if !EvalSpend(budget, 1) { return unknown }
            if instruction.op == .Constant {
                constant := program.constants[instruction.symbol]
                values[instruction.result] = .{known = true, type = constant.type,
                    bits = constant.bits}
                continue
            }
            if instruction.op == .Fuel { continue }
            if instruction.op == .Return {
                if instruction.operands.count != 1 { return unknown }
                answer := values[instruction.operands[0]]
                if !answer.known || answer.type != callee.result { return unknown }
                return .{fact = answer, ok = true}
            }
            if instruction.op == .Jump {
                if instruction.edges.count != 1 { return unknown }
                edge := instruction.edges[0]
                target := callee.blocks[edge.block]
                if edge.arguments.count != target.parameters.count { return unknown }
                for at: 0..edge.arguments.count - 1 {
                    values[target.parameters[at]] = values[edge.arguments[at]]
                }
                next = edge.block
                break
            }
            if instruction.op == .Branch {
                if instruction.operands.count != 1 || instruction.edges.count != 2 { return unknown }
                condition := values[instruction.operands[0]]
                if !condition.known || program.types[condition.type].kind != .Bool { return unknown }
                edge_index := ifx condition.bits != 0 then 0 else 1
                edge := instruction.edges[edge_index]
                target := callee.blocks[edge.block]
                if edge.arguments.count != target.parameters.count { return unknown }
                for at: 0..edge.arguments.count - 1 {
                    values[target.parameters[at]] = values[edge.arguments[at]]
                }
                next = edge.block
                break
            }
            if instruction.op == .Call {
                if instruction.result == LirNoId || instruction.symbol < 0 ||
                    instruction.symbol >= program.functions.count { return unknown }
                for argument: instruction.operands {
                    if !values[argument].known { return unknown }
                }
                nested := EvaluatePureCall(state, program, instruction.symbol,
                    values[:], instruction.operands[:], depth + 1, budget)
                if state.problem != .None { return unknown }
                if !nested.ok { return unknown }
                values[instruction.result] = nested.fact
                continue
            }
            if LirEffectful(instruction.op) { return unknown }
            folded := FoldInstruction(program, callee, instruction, values[:])
            if !folded.known || instruction.result == LirNoId ||
                folded.type != callee.values[instruction.result] { return unknown }
            values[instruction.result] = folded
        }
        if next == LirNoId { return unknown }
        block_index = next
    }
}

ResolveAlias :: (state: *OptState, aliases: []s32, value: s32) -> s32 {
    root := value
    steps: s64
    while root >= 0 && root < aliases.count && aliases[root] != root {
        if !Spend(state, 1) { return value }
        root = aliases[root]
        steps += 1
        if steps > aliases.count { unused Fail(state, .VerifyPass); return value }
    }
    return root
}

// The edges into each block, as (source block, instruction, edge) triples
// grouped by target: the edges into block b are entries first[b] ..
// first[b + 1] - 1.
IncomingEdges :: (state: *OptState, function: LirFunction, first: *Vec(s32), edges: *Vec(s32)) -> bool {
    blocks := function.blocks.count
    if !VecResizeBounded(<<first, blocks + 1, blocks + 1) { return Fail(state, .Allocation) }
    for at: 0..blocks { first.*[at] = 0 }
    total: s64
    for block: function.blocks {
        for instruction: block.instructions {
            for edge: instruction.edges {
                if !Spend(state, 1) { return false }
                first.*[edge.block + 1] += 1
                total += 1
            }
        }
    }
    for at: 1..blocks { first.*[at] += first.*[at - 1] }
    if !Scratch(state, total, 12) || !VecResizeBounded(<<edges, total * 3, total * 3) { return Fail(state, .Allocation) }
    fill: Vec(s32)
    defer VecFree(fill)
    if !VecResizeBounded(fill, blocks, blocks) { return Fail(state, .Allocation) }
    for at: 0..blocks - 1 { fill[at] = first.*[at] }
    for block_index: 0..function.blocks.count - 1 {
        block := function.blocks[block_index]
        for instruction_index: 0..block.instructions.count - 1 {
            instruction := block.instructions[instruction_index]
            for edge_index: 0..instruction.edges.count - 1 {
                at := cast(s64)fill[instruction.edges[edge_index].block]
                fill[instruction.edges[edge_index].block] += 1
                edges.*[at * 3] = cast(s32)block_index
                edges.*[at * 3 + 1] = cast(s32)instruction_index
                edges.*[at * 3 + 2] = cast(s32)edge_index
            }
        }
    }
    return true
}

// A block parameter that every edge into its block gives one value, or the
// parameter itself, is a copy of that value. The lowering passes every live
// binding to every block, so a loop's invariant bindings are such copies.
ParameterAliases :: (state: *OptState, function: LirFunction, aliases: []s32,
    first: []s32, edges: []s32) -> bool {
    changed := true
    while changed {
        changed = false
        for block_index: 0..function.blocks.count - 1 {
            if cast(s32)block_index == function.entry { continue }
            block := function.blocks[block_index]
            for at: 0..block.parameters.count - 1 {
                parameter := block.parameters[at]
                if aliases[parameter] != parameter { continue }
                candidate: s32 = LirNoId
                single := true
                for incoming: first[block_index]..first[block_index + 1] - 1 {
                    if !Spend(state, 1) { return false }
                    edge := function.blocks[edges[incoming * 3]].instructions[edges[incoming * 3 + 1]].edges[
                        edges[incoming * 3 + 2]]
                    value := ResolveAlias(state, aliases, edge.arguments[at])
                    if state.problem != .None { return false }
                    if value == parameter { continue }
                    if candidate == LirNoId { candidate = value }
                    else if candidate != value { single = false; break }
                }
                if single && candidate != LirNoId {
                    aliases[parameter] = candidate
                    changed = true
                }
            }
        }
    }
    return true
}

// Drops the parameters ParameterAliases made copies, and their arguments on
// every edge into the block.
DropParameters :: (state: *OptState, function: *LirFunction, aliases: []s32,
    first: []s32, edges: []s32) -> s64 {
    dropped: s64
    for block_index: 0..function.blocks.count - 1 {
        if cast(s32)block_index == function.entry { continue }
        block := function.blocks[block_index]
        kept: s64
        for at: 0..block.parameters.count - 1 {
            if aliases[block.parameters[at]] != block.parameters[at] { continue }
            kept += 1
        }
        if kept == block.parameters.count { continue }
        for incoming: first[block_index]..first[block_index + 1] - 1 {
            source := function.blocks[edges[incoming * 3]]
            instruction := source.instructions[edges[incoming * 3 + 1]]
            edge := instruction.edges[edges[incoming * 3 + 2]]
            write: s64
            for at: 0..block.parameters.count - 1 {
                if aliases[block.parameters[at]] != block.parameters[at] { continue }
                edge.arguments[write] = edge.arguments[at]
                write += 1
            }
            edge.arguments = edge.arguments[:write]
            instruction.edges[edges[incoming * 3 + 2]] = edge
            source.instructions[edges[incoming * 3 + 1]] = instruction
        }
        write: s64
        for at: 0..block.parameters.count - 1 {
            if aliases[block.parameters[at]] != block.parameters[at] { continue }
            block.parameters[write] = block.parameters[at]
            write += 1
        }
        dropped += block.parameters.count - write
        block.parameters = block.parameters[:write]
        function.blocks[block_index] = block
    }
    return dropped
}

CopyPass :: (state: *OptState, program: LirProgram, limits: LirLimits) -> bool {
    state.counters.copy.runs += 1
    for function_index: 0..program.functions.count - 1 {
        function := program.functions[function_index]
        if !Scratch(state, function.values.count, 27) { return false }
        // The insert defining a value, for member reads through updates.
        insert_block: Vec(s32)
        insert_instruction: Vec(s32)
        defer VecFree(insert_block)
        defer VecFree(insert_instruction)
        if !VecResizeBounded(insert_block, function.values.count, function.values.count) ||
            !VecResizeBounded(insert_instruction, function.values.count, function.values.count) {
            return Fail(state, .Allocation)
        }
        aliases: Vec(s32)
        changed: Vec(u8)
        aggregate_block: Vec(s32)
        aggregate_instruction: Vec(s32)
        escapes: Vec(u8)
        symbols: Vec(s32)
        non_null: Vec(u8)
        if !VecResizeBounded(aliases, function.values.count, function.values.count) ||
            !VecResizeBounded(changed, function.values.count, function.values.count) ||
            !VecResizeBounded(aggregate_block, function.values.count, function.values.count) ||
            !VecResizeBounded(aggregate_instruction, function.values.count, function.values.count) ||
            !VecResizeBounded(escapes, function.values.count, function.values.count) ||
            !VecResizeBounded(symbols, function.values.count, function.values.count) ||
            !VecResizeBounded(non_null, function.values.count, function.values.count) {
            VecFree(aliases); VecFree(changed); VecFree(aggregate_block)
            VecFree(aggregate_instruction); VecFree(escapes); VecFree(symbols); VecFree(non_null)
            return Fail(state, .Allocation)
        }
        for value: 0..function.values.count - 1 {
            aliases[value] = cast(s32)value
            aggregate_block[value] = LirNoId
            aggregate_instruction[value] = LirNoId
            insert_block[value] = LirNoId
            symbols[value] = LirNoId
        }
        for block_index: 0..function.blocks.count - 1 {
            block := function.blocks[block_index]
            for instruction_index: 0..block.instructions.count - 1 {
                instruction := block.instructions[instruction_index]
                if !Spend(state, 1) {
                    VecFree(aliases); VecFree(changed); VecFree(aggregate_block)
                    VecFree(aggregate_instruction); VecFree(escapes); VecFree(symbols); VecFree(non_null)
                    return false
                }
                if instruction.op == .Bitcast && instruction.result != LirNoId &&
                    function.values[instruction.result] == function.values[instruction.operands[0]] {
                    aliases[instruction.result] = instruction.operands[0]
                }
                if instruction.op == .Constant { symbols[instruction.result] = instruction.symbol }
                if instruction.op == .GlobalAddress { non_null[instruction.result] = 1 }
                if instruction.op == .Allocate { non_null[instruction.result] = 2 }
                if instruction.op == .Aggregate {
                    aggregate_block[instruction.result] = cast(s32)block_index
                    aggregate_instruction[instruction.result] = cast(s32)instruction_index
                }
                if instruction.op == .Insert && instruction.operands.count == 2 && instruction.result != LirNoId {
                    insert_block[instruction.result] = cast(s32)block_index
                    insert_instruction[instruction.result] = cast(s32)instruction_index
                }
            }
        }
        for block: function.blocks {
            for instruction: block.instructions {
                for at: 0..instruction.operands.count - 1 {
                    operand := instruction.operands[at]
                    if aggregate_block[operand] != LirNoId &&
                        !(instruction.op == .Extract && at == 0 && instruction.operands.count == 1) {
                        escapes[operand] = 1
                    }
                }
                for edge: instruction.edges {
                    for operand: edge.arguments {
                        if aggregate_block[operand] != LirNoId { escapes[operand] = 1 }
                    }
                }
            }
        }
        for block_index: 0..function.blocks.count - 1 {
            block := function.blocks[block_index]
            for instruction_index: 0..block.instructions.count - 1 {
                instruction := block.instructions[instruction_index]
                if instruction.op == .Extract && instruction.operands.count == 1 {
                    // Record values never change: a member read past inserts of
                    // other members reads what the insert of that member
                    // stored, or the constructor's operand beneath them.
                    aggregate := instruction.operands[0]
                    stored: s32 = LirNoId
                    walked := false
                    for step: 0..63 {
                        if insert_block[aggregate] == LirNoId { break }
                        put := function.blocks[insert_block[aggregate]].instructions[insert_instruction[aggregate]]
                        if put.immediate == instruction.immediate { stored = put.operands[1]; break }
                        aggregate = put.operands[0]
                        walked = true
                    }
                    if stored != LirNoId {
                        aliases[instruction.result] = stored
                    } else if aggregate_block[aggregate] != LirNoId && (walked || escapes[aggregate] == 0) {
                        definition := function.blocks[aggregate_block[aggregate]].instructions[
                            aggregate_instruction[aggregate]]
                        aliases[instruction.result] = definition.operands[instruction.immediate]
                    }
                }
                if instruction.op == .ElementAddress && instruction.operands.count == 3 {
                    base := instruction.operands[0]
                    index_symbol := symbols[instruction.operands[1]]
                    count_symbol := symbols[instruction.operands[2]]
                    if non_null[base] != 0 && index_symbol != LirNoId && count_symbol != LirNoId &&
                        program.constants[index_symbol].bits == 0 &&
                        program.constants[count_symbol].bits == 1 &&
                        function.values[base] == function.values[instruction.result] {
                        aliases[instruction.result] = base
                    }
                }
            }
            function.blocks[block_index] = block
        }
        first: Vec(s32)
        incoming: Vec(s32)
        if !IncomingEdges(state, function, *first, *incoming) ||
            !ParameterAliases(state, function, aliases[:], first[:], incoming[:]) {
            VecFree(first); VecFree(incoming)
            VecFree(aliases); VecFree(changed); VecFree(aggregate_block)
            VecFree(aggregate_instruction); VecFree(escapes); VecFree(symbols); VecFree(non_null)
            return false
        }
        for block_index: 0..function.blocks.count - 1 {
            block := function.blocks[block_index]
            for instruction_index: 0..block.instructions.count - 1 {
                instruction := block.instructions[instruction_index]
                for at: 0..instruction.operands.count - 1 {
                    old := instruction.operands[at]
                    replacement := ResolveAlias(state, aliases[:], old)
                    if state.problem != .None {
                        VecFree(aliases); VecFree(changed); VecFree(aggregate_block)
                        VecFree(aggregate_instruction); VecFree(escapes); VecFree(symbols); VecFree(non_null)
                        return false
                    }
                    if replacement != old { instruction.operands[at] = replacement; changed[old] = 1 }
                }
                for edge_index: 0..instruction.edges.count - 1 {
                    edge := instruction.edges[edge_index]
                    for at: 0..edge.arguments.count - 1 {
                        old := edge.arguments[at]
                        replacement := ResolveAlias(state, aliases[:], old)
                        if state.problem != .None {
                            VecFree(aliases); VecFree(changed); VecFree(aggregate_block)
                            VecFree(aggregate_instruction); VecFree(escapes); VecFree(symbols); VecFree(non_null)
                            return false
                        }
                        if replacement != old { edge.arguments[at] = replacement; changed[old] = 1 }
                    }
                    instruction.edges[edge_index] = edge
                }
                block.instructions[instruction_index] = instruction
            }
            function.blocks[block_index] = block
        }
        for value: 0..changed.count - 1 {
            if changed[value] != 0 { state.counters.copy.instructions += 1; state.counters.copy.values += 1 }
        }
        dropped := DropParameters(state, *function, aliases[:], first[:], incoming[:])
        VecFree(first)
        VecFree(incoming)
        if dropped > 0 {
            state.counters.copy.values += dropped
            empty: []u8
            if !CompactValues(state, *function, empty, *state.counters.copy) {
                VecFree(aliases); VecFree(changed); VecFree(aggregate_block)
                VecFree(aggregate_instruction); VecFree(escapes); VecFree(symbols); VecFree(non_null)
                return false
            }
        }
        program.functions[function_index] = function
        VecFree(aliases)
        VecFree(changed)
        VecFree(aggregate_block)
        VecFree(aggregate_instruction)
        VecFree(escapes)
        VecFree(symbols)
        VecFree(non_null)
    }
    return VerifyPass(state, program, limits)
}

DeadOperation :: (program: LirProgram, function: LirFunction,
    instruction: LirInstruction) -> bool {
    op := instruction.op
    if op == .Extract { return instruction.operands.count == 1 }
    if op == .Insert { return instruction.operands.count == 2 }
    if op == .Convert {
        source := program.types[function.values[instruction.operands[0]]]
        result := program.types[function.values[instruction.result]]
        return source.kind != .Float || result.kind != .Integer
    }
    return op == .Constant || op == .Null || op == .Add || op == .Subtract ||
        op == .Multiply || op == .Negate || op == .BitAnd || op == .BitOr ||
        op == .BitXor || op == .BitNot || op == .Equal || op == .NotEqual ||
        op == .Less || op == .LessEqual || op == .Greater || op == .GreaterEqual ||
        op == .Bitcast || op == .Aggregate || op == .GlobalAddress ||
        op == .FunctionAddress
}

CompactValues :: (state: *OptState, function: *LirFunction, keep: []u8,
    counter: *LirOptPassCounters) -> bool {
    old_count := function.values.count
    if !Scratch(state, old_count, 4) { return false }
    remap: Vec(s32)
    defer VecFree(remap)
    if !VecResizeBounded(remap, old_count, old_count) { return Fail(state, .Allocation) }
    for value: 0..old_count - 1 { remap[value] = LirNoId }
    for block_index: 0..function.blocks.count - 1 {
        if keep.count != 0 && keep[block_index] == 0 { continue }
        block := function.blocks[block_index]
        for value: block.parameters { remap[value] = 0 }
        for instruction: block.instructions {
            if instruction.result != LirNoId { remap[instruction.result] = 0 }
        }
    }
    next: s32
    for value: 0..old_count - 1 {
        if remap[value] == LirNoId { continue }
        remap[value] = next
        function.values[next] = function.values[value]
        next += 1
    }
    for block_index: 0..function.blocks.count - 1 {
        if keep.count != 0 && keep[block_index] == 0 { continue }
        block := function.blocks[block_index]
        for at: 0..block.parameters.count - 1 { block.parameters[at] = remap[block.parameters[at]] }
        for instruction_index: 0..block.instructions.count - 1 {
            instruction := block.instructions[instruction_index]
            if instruction.result != LirNoId { instruction.result = remap[instruction.result] }
            for at: 0..instruction.operands.count - 1 { instruction.operands[at] = remap[instruction.operands[at]] }
            for edge_index: 0..instruction.edges.count - 1 {
                edge := instruction.edges[edge_index]
                for at: 0..edge.arguments.count - 1 { edge.arguments[at] = remap[edge.arguments[at]] }
                instruction.edges[edge_index] = edge
            }
            block.instructions[instruction_index] = instruction
        }
        function.blocks[block_index] = block
    }
    function.values = function.values[:next]
    counter.values += old_count - cast(s64)next
    return true
}

// One distinct pure instruction remembered by the block scan.
CseEntry :: struct {
    op: LirOp
    immediate: u64
    symbol: s32
    alignment: u32
    result_type: s32
    operands: s32
    operand_count: s32
    value: s32
    next: s32
}

CseHash :: (hash: u64, value: u64) -> u64 {
    mixed := hash ^ value
    mixed *= 1099511628211
    mixed ^= mixed >> 29
    return mixed
}

// Whether an instruction is the same computation as a remembered entry:
// same operation, type, immediates and operand values, and for constants the
// same constant value rather than the same constant slot.
CseSame :: (state: *OptState, program: LirProgram, function: LirFunction,
    instruction: LirInstruction, entry: CseEntry, keys: []s32) -> bool {
    if entry.op != instruction.op || entry.immediate != instruction.immediate ||
        entry.alignment != instruction.alignment ||
        entry.result_type != function.values[instruction.result] ||
        entry.operand_count != instruction.operands.count { return false }
    if instruction.op == .Constant {
        left := program.constants[entry.symbol]
        right := program.constants[instruction.symbol]
        if left.type != right.type || left.bits != right.bits { return false }
        if left.bytes.count != right.bytes.count { return false }
        for at: 0..left.bytes.count - 1 {
            if !Spend(state, 1) { return Fail(state, .Limit) }
            if left.bytes[at] != right.bytes[at] { return false }
        }
        return true
    }
    if entry.symbol != instruction.symbol { return false }
    for at: 0..entry.operand_count - 1 {
        if !Spend(state, 1) { return Fail(state, .Limit) }
        if keys[entry.operands + at] != instruction.operands[at] { return false }
    }
    return true
}

// Common-subexpression elimination: within one block, a pure instruction
// whose operation, type, immediates and operand values repeat an earlier one
// computes the same value or raises the same trap, so the later copy is
// dropped and every use reads the earlier result. The earlier instruction
// still runs, so trapping behavior and the effectful order never change.
CsePass :: (state: *OptState, program: LirProgram, limits: LirLimits) -> bool {
    state.counters.cse.runs += 1
    for function_index: 0..program.functions.count - 1 {
        function := program.functions[function_index]
        if !Scratch(state, function.values.count, 4) { return false }
        aliases: Vec(s32)
        if !VecResizeBounded(aliases, function.values.count, function.values.count) {
            VecFree(aliases)
            return Fail(state, .Allocation)
        }
        for value: 0..function.values.count - 1 { aliases[value] = cast(s32)value }
        merged: s64 = 0
        for block_index: 0..function.blocks.count - 1 {
            block := function.blocks[block_index]
            count := block.instructions.count
            if count == 0 { continue }
            total_operands: s64
            for instruction: block.instructions { total_operands += instruction.operands.count }
            buckets := 16
            while buckets < count * 4 && buckets < 268435456 { buckets *= 2 }
            if !Scratch(state, count, 48) || !Scratch(state, count, 5) ||
                !Scratch(state, total_operands, 4) || !Scratch(state, buckets, 4) {
                VecFree(aliases)
                return false
            }
            seen: Vec(CseEntry)
            keys: Vec(s32)
            heads: Vec(s32)
            dropped: Vec(u8)
            if !VecResizeBounded(seen, count, count) ||
                !VecResizeBounded(keys, total_operands, total_operands) ||
                !VecResizeBounded(heads, buckets, buckets) ||
                !VecResizeBounded(dropped, count, count) {
                VecFree(seen); VecFree(keys); VecFree(heads); VecFree(dropped)
                VecFree(aliases)
                return Fail(state, .Allocation)
            }
            for bucket: 0..heads.count - 1 { heads[bucket] = LirNoId }
            seen_count: s64
            key_count: s64
            for read: 0..count - 1 {
                dropped[read] = 0
                instruction := block.instructions[read]
                if LirTerminator(instruction.op) || instruction.result == LirNoId || instruction.effect != 0 { continue }
                if !Spend(state, 1) {
                    VecFree(seen); VecFree(keys); VecFree(heads); VecFree(dropped)
                    VecFree(aliases)
                    return false
                }
                hash := CseHash(CseHash(CseHash(1469598103934665603,
                    cast(u64)cast(s32)instruction.op), instruction.immediate),
                    cast(u64)cast(s32)function.values[instruction.result])
                for operand: instruction.operands { hash = CseHash(hash, cast(u64)cast(s32)operand) }
                if instruction.op == .Constant {
                    constant := program.constants[instruction.symbol]
                    hash = CseHash(CseHash(hash, cast(u64)cast(s32)constant.type), constant.bits)
                } else {
                    hash = CseHash(hash, cast(u64)cast(s32)instruction.symbol)
                }
                bucket := cast(s32)(hash & cast(u64)(heads.count - 1))
                found: s32 = LirNoId
                at := heads[bucket]
                while at != LirNoId {
                    entry := seen[at]
                    same := CseSame(state, program, function, instruction, entry, keys[:])
                    if state.problem != .None {
                        VecFree(seen); VecFree(keys); VecFree(heads); VecFree(dropped)
                        VecFree(aliases)
                        return false
                    }
                    if same { found = entry.value; break }
                    at = entry.next
                }
                if found != LirNoId {
                    aliases[instruction.result] = found
                    dropped[read] = 1
                    merged += 1
                    state.counters.cse.instructions += 1
                    continue
                }
                if seen_count >= seen.count || key_count + instruction.operands.count > keys.count {
                    VecFree(seen); VecFree(keys); VecFree(heads); VecFree(dropped)
                    VecFree(aliases)
                    return Fail(state, .Limit)
                }
                entry := CseEntry.{op = instruction.op, immediate = instruction.immediate,
                    symbol = instruction.symbol, alignment = instruction.alignment,
                    result_type = function.values[instruction.result],
                    operands = cast(s32)key_count, operand_count = cast(s32)instruction.operands.count,
                    value = instruction.result, next = heads[bucket]}
                seen[seen_count] = entry
                for operand: instruction.operands {
                    keys[key_count] = operand
                    key_count += 1
                }
                heads[bucket] = cast(s32)seen_count
                seen_count += 1
            }
            if merged > 0 {
                write: s64
                for read: 0..count - 1 {
                    instruction := block.instructions[read]
                    if dropped[read] != 0 { continue }
                    block.instructions[write] = instruction
                    write += 1
                }
                block.instructions = block.instructions[:write]
                function.blocks[block_index] = block
            }
            VecFree(seen)
            VecFree(keys)
            VecFree(heads)
            VecFree(dropped)
        }
        if merged > 0 {
            for block_index: 0..function.blocks.count - 1 {
                block := function.blocks[block_index]
                for instruction_index: 0..block.instructions.count - 1 {
                    instruction := block.instructions[instruction_index]
                    for at: 0..instruction.operands.count - 1 {
                        instruction.operands[at] = ResolveAlias(state, aliases[:], instruction.operands[at])
                        if state.problem != .None { VecFree(aliases); return false }
                    }
                    for edge_index: 0..instruction.edges.count - 1 {
                        edge := instruction.edges[edge_index]
                        for at: 0..edge.arguments.count - 1 {
                            edge.arguments[at] = ResolveAlias(state, aliases[:], edge.arguments[at])
                            if state.problem != .None { VecFree(aliases); return false }
                        }
                        instruction.edges[edge_index] = edge
                    }
                    block.instructions[instruction_index] = instruction
                }
                function.blocks[block_index] = block
            }
            empty: []u8
            if !CompactValues(state, *function, empty, *state.counters.cse) { return false }
        }
        VecFree(aliases)
        program.functions[function_index] = function
    }
    return VerifyPass(state, program, limits)
}

// Whether FUNCTION's blocks form no cycle: every block leaves the
// topological order Kahn's method builds from the entry.
Acyclic :: (state: *OptState, function: LirFunction) -> bool {
    count := function.blocks.count
    indegree: Vec(s32)
    queue: Vec(s32)
    defer VecFree(indegree)
    defer VecFree(queue)
    if !VecResizeBounded(indegree, count, count) || !VecResizeBounded(queue, count, count) { return false }
    for block: function.blocks {
        for edge: block.instructions[block.instructions.count - 1].edges { indegree[edge.block] += 1 }
    }
    head: s64
    tail: s64
    for at: 0..count - 1 { if indegree[at] == 0 { queue[tail] = cast(s32)at; tail += 1 } }
    while head < tail {
        if !Spend(state, 1) { return false }
        block := function.blocks[queue[head]]
        head += 1
        for edge: block.instructions[block.instructions.count - 1].edges {
            indegree[edge.block] -= 1
            if indegree[edge.block] == 0 { queue[tail] = edge.block; tail += 1 }
        }
    }
    return tail == count
}

// Procedures a caller cannot observe: no stores, host or indirect calls,
// traps or operations that may trap, no loops, and calls only to such
// procedures. An unused call to one can go; its fuel goes with it, as an
// inlined leaf's does.
PureProcedures :: (state: *OptState, program: LirProgram, pure: []u8) -> bool {
    for function_index: 0..program.functions.count - 1 {
        function := program.functions[function_index]
        pure[function_index] = 0
        if function.external || function.variadic || function.calling != .Portable || function.blocks.count == 0 { continue }
        candidate := true
        for block: function.blocks {
            for instruction: block.instructions {
                if !Spend(state, 1) { return false }
                op := instruction.op
                memory := op == .Load || op == .ElementAddress || op == .FieldAddress || op == .BytesEqual
                trapping := op == .Divide || op == .Remainder || op == .Trap || op == .Unreachable ||
                    instruction.checked || program.checks && memory ||
                    op == .Convert && program.types[function.values[instruction.operands[0]]].kind == .Float &&
                    program.types[function.values[instruction.result]].kind == .Integer
                effect := op == .Store || op == .Copy || op == .Zero || op == .Allocate || op == .HostCall ||
                    op == .CallIndirect || op == .Resize
                if trapping || effect || op == .Call && cast(s64)instruction.symbol == function_index { candidate = false }
            }
        }
        if candidate && Acyclic(state, function) { pure[function_index] = 1 }
        if state.problem != .None { return false }
    }
    changed := true
    while changed {
        changed = false
        for function_index: 0..program.functions.count - 1 {
            if pure[function_index] == 0 { continue }
            for block: program.functions[function_index].blocks {
                for instruction: block.instructions {
                    if !Spend(state, 1) { return false }
                    if instruction.op == .Call && pure[function_index] != 0 &&
                        (instruction.symbol < 0 || pure[instruction.symbol] == 0) {
                        pure[function_index] = 0
                        changed = true
                    }
                }
            }
        }
    }
    return true
}

DeadPass :: (state: *OptState, program: LirProgram, limits: LirLimits) -> bool {
    state.counters.dead.runs += 1
    pure: Vec(u8)
    defer VecFree(pure)
    if !Scratch(state, program.functions.count, 1) { return false }
    if !VecResizeBounded(pure, program.functions.count, program.functions.count) { return Fail(state, .Allocation) }
    if !PureProcedures(state, program, pure[:]) { return false }
    for function_index: 0..program.functions.count - 1 {
        function := program.functions[function_index]
        count := function.values.count
        if !Scratch(state, count, 19) { return false }
        uses: Vec(s64)
        removed: Vec(u8)
        symbols: Vec(s32)
        non_null: Vec(u8)
        safe_element: Vec(u8)
        if !VecResizeBounded(uses, count, count) || !VecResizeBounded(removed, count, count) ||
            !VecResizeBounded(symbols, count, count) || !VecResizeBounded(non_null, count, count) ||
            !VecResizeBounded(safe_element, count, count) {
            VecFree(uses); VecFree(removed); VecFree(symbols); VecFree(non_null); VecFree(safe_element)
            return Fail(state, .Allocation)
        }
        for value: 0..count - 1 { symbols[value] = LirNoId }
        for block: function.blocks {
            for instruction: block.instructions {
                if !Spend(state, 1) {
                    VecFree(uses); VecFree(removed); VecFree(symbols); VecFree(non_null); VecFree(safe_element)
                    return false
                }
                for value: instruction.operands { uses[value] += 1 }
                for edge: instruction.edges { for value: edge.arguments { uses[value] += 1 } }
                if instruction.op == .Constant { symbols[instruction.result] = instruction.symbol }
                if instruction.op == .GlobalAddress { non_null[instruction.result] = 1 }
                if instruction.op == .Allocate { non_null[instruction.result] = 2 }
            }
        }
        for block: function.blocks {
            for instruction: block.instructions {
                if instruction.op != .ElementAddress ||
                    instruction.operands.count < 2 || instruction.operands.count > 3 { continue }
                base := instruction.operands[0]
                index_symbol := symbols[instruction.operands[1]]
                safe := false
                if instruction.operands.count == 3 {
                    count_symbol := symbols[instruction.operands[2]]
                    safe = non_null[base] != 0 && index_symbol != LirNoId && count_symbol != LirNoId &&
                        program.constants[index_symbol].bits == 0 &&
                        program.constants[count_symbol].bits == 1 &&
                        function.values[base] == function.values[instruction.result]
                } else {
                    safe = non_null[base] == 1 && index_symbol != LirNoId &&
                        SafeConstantElement(program, function, base,
                            instruction.result, index_symbol) != LirNoId
                }
                if safe {
                    safe_element[instruction.result] = 1
                }
            }
        }
        changed := true
        while changed {
            changed = false
            for block: function.blocks {
                for instruction: block.instructions {
                    if !Spend(state, 1) {
                        VecFree(uses); VecFree(removed); VecFree(symbols); VecFree(non_null); VecFree(safe_element)
                        return false
                    }
                    result := instruction.result
                    if result == LirNoId || removed[result] != 0 || uses[result] != 0 ||
                        !(DeadOperation(program, function, instruction) || safe_element[result] != 0 ||
                          instruction.op == .Call && instruction.symbol >= 0 && pure[instruction.symbol] != 0) { continue }
                    removed[result] = 1
                    for operand: instruction.operands {
                        if uses[operand] <= 0 {
                            VecFree(uses); VecFree(removed); VecFree(symbols); VecFree(non_null); VecFree(safe_element)
                            return Fail(state, .VerifyPass)
                        }
                        uses[operand] -= 1
                    }
                    changed = true
                    state.counters.dead.instructions += 1
                }
            }
        }
        for block_index: 0..function.blocks.count - 1 {
            block := function.blocks[block_index]
            write: s64
            for read: 0..block.instructions.count - 1 {
                instruction := block.instructions[read]
                if instruction.result != LirNoId && removed[instruction.result] != 0 { continue }
                block.instructions[write] = instruction
                write += 1
            }
            block.instructions = block.instructions[:write]
            // A removed call leaves a gap in the block's effect order.
            effect: s32
            for at: 0..write - 1 {
                if LirEffectful(block.instructions[at].op) { effect += 1; block.instructions[at].effect = effect }
                else { block.instructions[at].effect = 0 }
            }
            function.blocks[block_index] = block
        }
        VecFree(uses)
        VecFree(removed)
        VecFree(symbols)
        VecFree(non_null)
        VecFree(safe_element)
        empty: []u8
        if !CompactValues(state, *function, empty, *state.counters.dead) { return false }
        program.functions[function_index] = function
    }
    return VerifyPass(state, program, limits)
}

SameOrigin :: (left: LirOrigin, right: LirOrigin) -> bool {
    return left.file == right.file && left.line == right.line &&
        left.column == right.column && left.end_line == right.end_line &&
        left.end_column == right.end_column && left.begin == right.begin &&
        left.end == right.end && left.parent == right.parent
}

CompactPass :: (state: *OptState, owner: *LirOptOwner, limits: LirLimits) -> bool {
    state.counters.compact.runs += 1
    program := LirReadProgram(*owner.storage)

    if !Scratch(state, program.constants.count, 5) { return false }
    constant_used: Vec(u8)
    constant_map: Vec(s32)
    if !VecResizeBounded(constant_used, program.constants.count, program.constants.count) ||
        !VecResizeBounded(constant_map, program.constants.count, program.constants.count) {
        VecFree(constant_used); VecFree(constant_map)
        return Fail(state, .Allocation)
    }
    for constant: 0..program.constants.count - 1 { constant_map[constant] = LirNoId }
    for global: program.globals {
        if global.constant != LirNoId { constant_used[global.constant] = 1 }
    }
    for function: program.functions {
        for block: function.blocks {
            for instruction: block.instructions {
                if !Spend(state, 1) { VecFree(constant_used); VecFree(constant_map); return false }
                if instruction.op == .Constant { constant_used[instruction.symbol] = 1 }
            }
        }
    }
    constant_count: s32
    for old: 0..program.constants.count - 1 {
        if constant_used[old] == 0 { continue }
        constant_map[old] = constant_count
        program.constants[constant_count] = program.constants[old]
        constant_count += 1
    }
    for global_index: 0..program.globals.count - 1 {
        global := program.globals[global_index]
        if global.constant != LirNoId { global.constant = constant_map[global.constant] }
        program.globals[global_index] = global
    }
    for function_index: 0..program.functions.count - 1 {
        function := program.functions[function_index]
        for block_index: 0..function.blocks.count - 1 {
            block := function.blocks[block_index]
            for instruction_index: 0..block.instructions.count - 1 {
                instruction := block.instructions[instruction_index]
                if instruction.op == .Constant { instruction.symbol = constant_map[instruction.symbol] }
                block.instructions[instruction_index] = instruction
            }
            function.blocks[block_index] = block
        }
        program.functions[function_index] = function
    }
    state.counters.compact.constants += program.constants.count - cast(s64)constant_count
    program.constants = program.constants[:constant_count]

    if !Scratch(state, program.types.count, 5) { VecFree(constant_used); VecFree(constant_map); return false }
    type_used: Vec(u8)
    type_map: Vec(s32)
    if !VecResizeBounded(type_used, program.types.count, program.types.count) ||
        !VecResizeBounded(type_map, program.types.count, program.types.count) {
        VecFree(constant_used); VecFree(constant_map); VecFree(type_used); VecFree(type_map)
        return Fail(state, .Allocation)
    }
    for type: 0..program.types.count - 1 { type_map[type] = LirNoId }
    for constant: program.constants { type_used[constant.type] = 1 }
    for global: program.globals { type_used[global.type] = 1 }
    for function: program.functions {
        type_used[function.result] = 1
        for type: function.parameters { type_used[type] = 1 }
        for type: function.values { type_used[type] = 1 }
    }
    changed := true
    while changed {
        changed = false
        for old: 0..program.types.count - 1 {
            if type_used[old] == 0 { continue }
            if !Spend(state, 1) {
                VecFree(constant_used); VecFree(constant_map); VecFree(type_used); VecFree(type_map)
                return false
            }
            type := program.types[old]
            if type.kind == .Pointer || type.kind == .Array {
                if type_used[type.element] == 0 { type_used[type.element] = 1; changed = true }
            }
            if type.kind == .Record {
                for field: type.fields {
                    if type_used[field] == 0 { type_used[field] = 1; changed = true }
                }
            }
            if type.kind == .Function {
                if type_used[type.result] == 0 { type_used[type.result] = 1; changed = true }
                for parameter: type.parameters {
                    if type_used[parameter] == 0 { type_used[parameter] = 1; changed = true }
                }
            }
        }
    }
    type_count: s32
    for old: 0..program.types.count - 1 {
        if type_used[old] != 0 { type_map[old] = type_count; type_count += 1 }
    }
    write_type: s32
    for old: 0..program.types.count - 1 {
        if type_used[old] == 0 { continue }
        type := program.types[old]
        if type.kind == .Pointer || type.kind == .Array { type.element = type_map[type.element] }
        if type.kind == .Record {
            for at: 0..type.fields.count - 1 { type.fields[at] = type_map[type.fields[at]] }
        }
        if type.kind == .Function {
            type.result = type_map[type.result]
            for at: 0..type.parameters.count - 1 { type.parameters[at] = type_map[type.parameters[at]] }
        }
        program.types[write_type] = type
        write_type += 1
    }
    for constant_index: 0..program.constants.count - 1 {
        constant := program.constants[constant_index]
        constant.type = type_map[constant.type]
        program.constants[constant_index] = constant
    }
    for global_index: 0..program.globals.count - 1 {
        global := program.globals[global_index]
        global.type = type_map[global.type]
        program.globals[global_index] = global
    }
    for function_index: 0..program.functions.count - 1 {
        function := program.functions[function_index]
        function.result = type_map[function.result]
        for at: 0..function.parameters.count - 1 { function.parameters[at] = type_map[function.parameters[at]] }
        for at: 0..function.values.count - 1 { function.values[at] = type_map[function.values[at]] }
        program.functions[function_index] = function
    }
    state.counters.compact.types += program.types.count - cast(s64)type_count
    program.types = program.types[:type_count]

    if !Scratch(state, program.origins.count, 53) {
        VecFree(constant_used); VecFree(constant_map); VecFree(type_used); VecFree(type_map)
        return false
    }
    origin_used: Vec(u8)
    origin_map: Vec(s32)
    origins: Vec(LirOrigin)
    if !VecResizeBounded(origin_used, program.origins.count, program.origins.count) ||
        !VecResizeBounded(origin_map, program.origins.count, program.origins.count) ||
        !VecResizeBounded(origins, program.origins.count, program.origins.count) {
        VecFree(constant_used); VecFree(constant_map); VecFree(type_used); VecFree(type_map)
        VecFree(origin_used); VecFree(origin_map); VecFree(origins)
        return Fail(state, .Allocation)
    }
    for origin: 0..program.origins.count - 1 { origin_map[origin] = -2 }
    for function: program.functions {
        if function.origin != LirNoId { origin_used[function.origin] = 1 }
        for block: function.blocks {
            for instruction: block.instructions {
                if instruction.origin != LirNoId { origin_used[instruction.origin] = 1 }
            }
        }
    }
    changed = true
    while changed {
        changed = false
        for old: 0..program.origins.count - 1 {
            if origin_used[old] == 0 { continue }
            parent := program.origins[old].parent
            if parent != LirNoId && origin_used[parent] == 0 { origin_used[parent] = 1; changed = true }
        }
    }
    needed: s64
    for used: origin_used { if used != 0 { needed += 1 } }
    resolved: s64
    origin_count: s32
    while resolved < needed {
        progress := false
        for old: 0..program.origins.count - 1 {
            if origin_used[old] == 0 || origin_map[old] != -2 { continue }
            origin := program.origins[old]
            if origin.parent != LirNoId && origin_map[origin.parent] < 0 { continue }
            if origin.parent != LirNoId { origin.parent = origin_map[origin.parent] }
            canonical: s32 = LirNoId
            for at: 0..origin_count - 1 {
                if SameOrigin(origins[at], origin) { canonical = cast(s32)at; break }
            }
            if canonical == LirNoId {
                canonical = origin_count
                origins[origin_count] = origin
                origin_count += 1
            }
            origin_map[old] = canonical
            resolved += 1
            progress = true
        }
        if !progress {
            VecFree(constant_used); VecFree(constant_map); VecFree(type_used); VecFree(type_map)
            VecFree(origin_used); VecFree(origin_map); VecFree(origins)
            return Fail(state, .VerifyPass)
        }
    }
    for function_index: 0..program.functions.count - 1 {
        function := program.functions[function_index]
        if function.origin != LirNoId { function.origin = origin_map[function.origin] }
        for block_index: 0..function.blocks.count - 1 {
            block := function.blocks[block_index]
            for instruction_index: 0..block.instructions.count - 1 {
                instruction := block.instructions[instruction_index]
                if instruction.origin != LirNoId { instruction.origin = origin_map[instruction.origin] }
                block.instructions[instruction_index] = instruction
            }
            function.blocks[block_index] = block
        }
        program.functions[function_index] = function
    }
    state.counters.compact.origins += program.origins.count - cast(s64)origin_count
    program.origins = origins[:origin_count]

    VecFree(constant_used); VecFree(constant_map); VecFree(type_used); VecFree(type_map)
    VecFree(origin_used); VecFree(origin_map)
    if !VerifyPass(state, program, limits) { VecFree(origins); return false }
    result := CloneProgram(state, program, limits, *owner.storage)
    VecFree(origins)
    return result
}

CfgPass :: (state: *OptState, program: LirProgram, limits: LirLimits) -> bool {
    state.counters.cfg.runs += 1
    for function_index: 0..program.functions.count - 1 {
        function := program.functions[function_index]
        if function.external { continue }
        jump_target: s64 = -1
        if !Scratch(state, function.values.count, 4) || !Scratch(state, function.blocks.count, 9) {
            return false
        }
        symbols: Vec(s32)
        reachable: Vec(u8)
        queue: Vec(s32)
        block_map: Vec(s32)
        if !VecResizeBounded(symbols, function.values.count, function.values.count) ||
            !VecResizeBounded(reachable, function.blocks.count, function.blocks.count) ||
            !VecResizeBounded(queue, function.blocks.count, function.blocks.count) ||
            !VecResizeBounded(block_map, function.blocks.count, function.blocks.count) {
            VecFree(symbols); VecFree(reachable); VecFree(queue); VecFree(block_map)
            return Fail(state, .Allocation)
        }
        for value: 0..symbols.count - 1 { symbols[value] = LirNoId }
        for block: function.blocks {
            for instruction: block.instructions {
                if instruction.op == .Constant { symbols[instruction.result] = instruction.symbol }
            }
        }
        for block_index: 0..function.blocks.count - 1 {
            block := function.blocks[block_index]
            terminal_index := block.instructions.count - 1
            terminal := block.instructions[terminal_index]
            if terminal.op == .Branch {
                symbol := symbols[terminal.operands[0]]
                if symbol != LirNoId && program.constants[symbol].type == function.values[terminal.operands[0]] {
                    selected: s64 = ifx program.constants[symbol].bits != 0 then 0 else 1
                    terminal.op = .Jump
                    terminal.operands = terminal.operands[:0]
                    terminal.edges = terminal.edges[selected:selected + 1]
                    block.instructions[terminal_index] = terminal
                    state.counters.cfg.instructions += 1
                }
            }
            function.blocks[block_index] = block
        }
        entry_block := function.blocks[function.entry]
        if entry_block.instructions.count == 1 {
            entry_terminal_index := entry_block.instructions.count - 1
            entry_terminal := entry_block.instructions[entry_terminal_index]
            if entry_terminal.op == .Jump && entry_terminal.edges.count == 1 {
                target_index := entry_terminal.edges[0].block
                if target_index != function.entry &&
                    function.blocks[target_index].parameters.count == 0 {
                    target := function.blocks[target_index]
                    sole_predecessor := true
                    for block_index: 0..function.blocks.count - 1 {
                        if block_index == function.entry { continue }
                        for instruction: function.blocks[block_index].instructions {
                            for edge: instruction.edges {
                                if edge.block == target_index { sole_predecessor = false }
                            }
                        }
                    }
                    moves_fuel := false
                    for instruction: target.instructions {
                        if instruction.op == .Fuel { moves_fuel = true }
                    }
                    if sole_predecessor && !moves_fuel {
                        state.counters.cfg.instructions += 1
                        jump_target = target_index
                    }
                }
            }
        }
        head: s64
        tail: s64 = 1
        queue[0] = function.entry
        reachable[function.entry] = 1
        while head < tail {
            if !Spend(state, 1) { VecFree(symbols); VecFree(reachable); VecFree(queue); VecFree(block_map); return false }
            block_index := queue[head]
            head += 1
            block := function.blocks[block_index]
            terminal := block.instructions[block.instructions.count - 1]
            for edge: terminal.edges {
                if reachable[edge.block] == 0 {
                    reachable[edge.block] = 1
                    queue[tail] = edge.block
                    tail += 1
                }
            }
        }
        if tail != function.blocks.count || jump_target >= 0 {
            if !CompactValues(state, *function, reachable[:], *state.counters.cfg) {
                VecFree(symbols); VecFree(reachable); VecFree(queue); VecFree(block_map)
                return false
            }
            next: s32
            for old: 0..function.blocks.count - 1 {
                if reachable[old] == 0 { block_map[old] = LirNoId; continue }
                block_map[old] = next
                next += 1
            }
            for old: 0..function.blocks.count - 1 {
                if reachable[old] == 0 { continue }
                block := function.blocks[old]
                terminal_index := block.instructions.count - 1
                terminal := block.instructions[terminal_index]
                for edge_index: 0..terminal.edges.count - 1 {
                    edge := terminal.edges[edge_index]
                    edge.block = block_map[edge.block]
                    terminal.edges[edge_index] = edge
                }
                block.instructions[terminal_index] = terminal
                function.blocks[block_map[old]] = block
            }
            old_blocks := function.blocks.count
            function.blocks = function.blocks[:next]
            retained_entry: s64 = function.entry
            if jump_target >= 0 { retained_entry = jump_target }
            function.entry = block_map[retained_entry]
            state.counters.cfg.blocks += old_blocks - cast(s64)next
        }
        program.functions[function_index] = function
        VecFree(symbols)
        VecFree(reachable)
        VecFree(queue)
        VecFree(block_map)
    }
    return VerifyPass(state, program, limits)
}

Result :: (state: OptState) -> LirOptResult {
    return .{problem = state.problem, diagnostic = state.diagnostic,
        counters = state.counters, work = state.used,
        scratch_bytes = state.peak_scratch_bytes}
}

#scope_export
LirOptDefaultOptions :: () -> LirOptOptions {
    return .{fold_constants = true, propagate_copies = true, eliminate_dead = true,
        simplify_cfg = true, maximum_rounds = 8, inline_leaf_operations = LearningTuningChoice().leaf_operations,
        inline_calls = 48}
}

LirOptFree :: (owner: *LirOptOwner) {
    if owner == null { return }
    owner.valid = false
    owner.program = .{version = LirVersion, entry = LirNoId}
    LirReadFree(*owner.storage)
}

LirOptProgram :: (owner: *LirOptOwner) -> LirProgram {
    if owner == null || !owner.valid { return .{version = LirVersion, entry = LirNoId} }
    return owner.program
}

LirOptBuild :: (owner: *LirOptOwner, program: LirProgram, limits: LirLimits,
    options: LirOptOptions) -> LirOptResult {
    state := OptState.{remaining = limits.work, maximum_bytes = limits.bytes,
        diagnostic = EmptyDiagnostic()}
    if owner == null { state.problem = .Owner; return Result(state) }
    if limits.work < 0 || limits.types < 0 || limits.functions < 0 || limits.blocks < 0 ||
        limits.values < 0 || limits.instructions < 0 || limits.bytes < 0 {
        LirOptFree(owner)
        state.problem = .Limit
        return Result(state)
    }
    if options.maximum_rounds < 1 || options.maximum_rounds > 64 ||
        options.inline_leaf_operations < 0 || options.inline_leaf_operations > 1 ||
        options.inline_calls < 0 || options.inline_calls > 1024 {
        LirOptFree(owner)
        state.problem = .Options
        return Result(state)
    }
    state.diagnostic = LirVerify(program, limits)
    if state.diagnostic.problem != .None {
        LirOptFree(owner)
        state.problem = .VerifyInput
        return Result(state)
    }
    if !CountProgram(*state, program, false) {
        LirOptFree(owner)
        return Result(state)
    }
    if !CloneProgram(*state, program, limits, *owner.storage) {
        LirOptFree(owner)
        return Result(state)
    }
    owner.valid = false
    owner.program = .{version = LirVersion, entry = LirNoId}
    if options.inline_leaf_operations > 0 {
        inlined := LirInlineLeaves(LirReadProgram(*owner.storage), options.inline_leaf_operations, state.remaining)
        if !Spend(*state, inlined.work) || inlined.limited {
            unused Fail(*state, .Limit); LirOptFree(owner); return Result(state)
        }
        state.counters.inline_leaf.runs += 1
        state.counters.inline_leaf.instructions += inlined.calls
        if !VerifyPass(*state, LirReadProgram(*owner.storage), limits) { LirOptFree(owner); return Result(state) }
    }
    if options.inline_calls > 0 {
        expanded := LirInlineCalls(*owner.storage, limits, state.remaining, cast(s64)options.inline_calls)
        state.counters.inline_calls.runs += 1
        state.counters.inline_calls.instructions += expanded.calls
        if !SharedPassResult(*state, expanded.problem, expanded.codec, expanded.work, expanded.scratch_bytes) {
            LirOptFree(owner); return Result(state)
        }
    }
    ScratchReset(*state)
    if options.fold_constants && !FoldPass(*state, owner, limits, options) {
        LirOptFree(owner)
        return Result(state)
    }
    optimized := LirReadProgram(*owner.storage)
    ScratchReset(*state)
    if options.propagate_copies && !CopyPass(*state, optimized, limits) {
        LirOptFree(owner)
        return Result(state)
    }
    ScratchReset(*state)
    if options.fold_constants && !FoldPass(*state, owner, limits, options) {
        LirOptFree(owner)
        return Result(state)
    }
    optimized = LirReadProgram(*owner.storage)
    ScratchReset(*state)
    if options.propagate_copies && !CsePass(*state, optimized, limits) {
        LirOptFree(owner)
        return Result(state)
    }
    ScratchReset(*state)
    if options.simplify_cfg && !CfgPass(*state, optimized, limits) {
        LirOptFree(owner)
        return Result(state)
    }
    optimized = LirReadProgram(*owner.storage)
    ScratchReset(*state)
    if options.simplify_cfg {
        hoisted := LirLicm(*owner.storage, limits, state.remaining)
        state.counters.licm.runs += 1
        state.counters.licm.instructions += hoisted.instructions
        if !SharedPassResult(*state, hoisted.problem, hoisted.codec, hoisted.work, hoisted.scratch_bytes) ||
            !VerifyPass(*state, LirReadProgram(*owner.storage), limits) { LirOptFree(owner); return Result(state) }
        strength := LirInduction(*owner.storage, limits, state.remaining)
        state.counters.induction.runs += 1
        state.counters.induction.instructions += strength.products
        if !SharedPassResult(*state, strength.problem, strength.codec, strength.work, strength.scratch_bytes) ||
            !VerifyPass(*state, LirReadProgram(*owner.storage), limits) { LirOptFree(owner); return Result(state) }
        optimized = LirReadProgram(*owner.storage)
        if options.propagate_copies && !CopyPass(*state, optimized, limits) { LirOptFree(owner); return Result(state) }
        rotated := LirRotate(*owner.storage, limits, state.remaining)
        if !Spend(*state, rotated.work) { LirOptFree(owner); return Result(state) }
        if rotated.scratch_bytes > state.peak_scratch_bytes { state.peak_scratch_bytes = rotated.scratch_bytes }
        state.counters.rotate.runs += 1
        state.counters.rotate.blocks += rotated.loops
        if rotated.problem != .None {
            state.problem = ifx rotated.problem == .Allocation then .Allocation else .Limit
            LirOptFree(owner); return Result(state)
        }
        if rotated.codec.problem != .None {
            unused CodecFailure(*state, rotated.codec)
            LirOptFree(owner); return Result(state)
        }
        optimized = LirReadProgram(*owner.storage)
        if options.propagate_copies && !CopyPass(*state, optimized, limits) {
            LirOptFree(owner); return Result(state)
        }
        if !VerifyPass(*state, optimized, limits) { LirOptFree(owner); return Result(state) }
        ordered := LirLayout(*owner.storage, limits, state.remaining)
        state.counters.layout.runs += 1
        state.counters.layout.blocks += ordered.blocks
        if !SharedPassResult(*state, ordered.problem, ordered.codec, ordered.work, ordered.scratch_bytes) {
            LirOptFree(owner); return Result(state)
        }
        optimized = LirReadProgram(*owner.storage)
        if !VerifyPass(*state, optimized, limits) { LirOptFree(owner); return Result(state) }
    }
    ScratchReset(*state)
    if options.eliminate_dead && !DeadPass(*state, optimized, limits) {
        LirOptFree(owner)
        return Result(state)
    }
    ScratchReset(*state)
    if !CompactPass(*state, owner, limits) {
        LirOptFree(owner)
        return Result(state)
    }
    optimized = LirReadProgram(*owner.storage)
    optimized.checks = program.checks
    if !CountProgram(*state, optimized, true) {
        LirOptFree(owner)
        return Result(state)
    }
    owner.program = optimized
    owner.valid = true
    state.problem = .None
    state.diagnostic = EmptyDiagnostic()
    return Result(state)
}
