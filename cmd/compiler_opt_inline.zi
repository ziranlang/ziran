// Bounded scalar leaf inlining reuses the call's operand storage; it needs no
// new values, blocks or allocations. LirInlineCalls copies small procedures'
// blocks into their callers under a growth budget.
using IR :: #import "compiler_lowered_ir"
using Codec :: #import "compiler_exec_serial"
using SSA :: #import "compiler_opt_ssa"
using Vectors :: #import "std/vec"

LirInlineResult :: struct { work: s64; calls: s64; limited: bool }

#scope_file
Scalar :: (program: LirProgram, type: s32) -> bool {
    return type >= 0 && type < program.types.count &&
        (program.types[type].kind == .Integer || program.types[type].kind == .Bool)
}
Operation :: (op: LirOp) -> bool {
    return op == .Add || op == .Subtract || op == .Multiply || op == .Negate ||
        op == .BitAnd || op == .BitOr || op == .BitXor || op == .BitNot ||
        op == .Equal || op == .NotEqual || op == .Less || op == .LessEqual ||
        op == .Greater || op == .GreaterEqual || op == .Convert || op == .Bitcast
}
Parameter :: (parameters: []s32, value: s32) -> s64 {
    for at: 0..parameters.count - 1 { if parameters[at] == value { return at } }
    return -1
}
Leaf :: (program: LirProgram, call: LirInstruction) -> (instruction: LirInstruction, valid: bool) {
    if call.result < 0 || call.symbol < 0 || call.symbol >= program.functions.count { return .{}, false }
    function := program.functions[call.symbol]
    if function.external || function.variadic || function.calling != .Portable ||
        function.blocks.count != 1 || function.entry != 0 || !Scalar(program, function.result) { return .{}, false }
    block := function.blocks[0]
    if block.instructions.count != 2 || block.parameters.count != call.operands.count { return .{}, false }
    operation := block.instructions[0]
    terminal := block.instructions[1]
    if !Operation(operation.op) || operation.effect != 0 || operation.operands.count > 2 ||
        operation.operands.count > call.operands.count || terminal.op != .Return ||
        terminal.operands.count != 1 || terminal.operands[0] != operation.result { return .{}, false }
    for value: operation.operands {
        if Parameter(block.parameters, value) < 0 || !Scalar(program, function.values[value]) { return .{}, false }
    }
    return operation, true
}

#scope_export
// PROGRAM must have passed LirVerify. On budget exhaustion the caller discards
// its private clone, as for every other optimizer pass.
LirInlineLeaves :: (program: LirProgram, maximum_operations: s32, budget: s64) -> LirInlineResult {
    result: LirInlineResult
    if maximum_operations != 1 { return result }
    for function: program.functions {
        for block: function.blocks {
            for at: 0..block.instructions.count - 1 {
                if result.work >= budget { result.limited = true; return result }
                result.work += 1
                call := block.instructions[at]
                if call.op != .Call { continue }
                cost := cast(s64)call.operands.count * 3 + 1
                if cost > budget - result.work { result.limited = true; return result }
                result.work += cost
                operation, valid := Leaf(program, call)
                if !valid { continue }
                callee := program.functions[call.symbol]
                mapped: [2]s32
                for operand: 0..operation.operands.count - 1 {
                    parameter := Parameter(callee.blocks[0].parameters, operation.operands[operand])
                    mapped[operand] = call.operands[parameter]
                }
                for operand: 0..operation.operands.count - 1 { call.operands[operand] = mapped[operand] }
                call.operands = call.operands[:operation.operands.count]
                call.op = operation.op
                call.immediate = operation.immediate
                call.symbol = operation.symbol
                call.alignment = operation.alignment
                call.checked = operation.checked
                call.effect = 0
                block.instructions[at] = call
                result.calls += 1
            }
            effect: s32
            for at: 0..block.instructions.count - 1 {
                if result.work >= budget { result.limited = true; return result }
                result.work += 1
                if LirEffectful(block.instructions[at].op) {
                    effect += 1; block.instructions[at].effect = effect
                } else { block.instructions[at].effect = 0 }
            }
        }
    }
    return result
}

LirInlineCallsResult :: struct { problem: LirSsaProblem; codec: LirCodecResult; calls: s64; work: s64; scratch_bytes: s64; grown: s64 }

#scope_file
// One expanded caller and the tables it points into. Copies point only into
// these tables and the unchanged input, so they live until the one write.
Expanded :: struct {
    values: Vec(s32)
    instructions: Vec(LirInstruction)
    edges: Vec(LirEdge)
    data: Vec(s32)
    blocks: Vec(LirBlock)
    function: LirFunction
}

ExpandedFree :: (expanded: *Expanded) {
    VecFree(expanded.values)
    VecFree(expanded.instructions)
    VecFree(expanded.edges)
    VecFree(expanded.data)
    VecFree(expanded.blocks)
}

FreeExpanded :: (versions: []Expanded) {
    for at: 0..versions.count - 1 { ExpandedFree(*versions[at]) }
}

Shape :: struct { instructions: s64; edges: s64; words: s64; returns: s64 }

Measure :: (function: LirFunction) -> Shape {
    shape: Shape
    for block: function.blocks {
        shape.instructions += block.instructions.count
        shape.words += block.parameters.count
        for instruction: block.instructions {
            shape.words += instruction.operands.count
            shape.edges += instruction.edges.count
            for edge: instruction.edges { shape.words += edge.arguments.count }
            if instruction.op == .Return { shape.returns += 1 }
        }
    }
    return shape
}

// A direct call to a small portable procedure that returns, keeps no stack
// storage, does not call its host and does not call itself.
Expandable :: (program: LirProgram, caller: s64, call: LirInstruction, maximum: s64) -> bool {
    if call.op != .Call || call.symbol < 0 || cast(s64)call.symbol >= program.functions.count ||
        cast(s64)call.symbol == caller { return false }
    callee := program.functions[call.symbol]
    if callee.external || callee.variadic || callee.calling != .Portable || callee.blocks.count == 0 { return false }
    size: s64
    returns := false
    for block: callee.blocks {
        size += block.instructions.count
        if size > maximum { return false }
        for instruction: block.instructions {
            if instruction.op == .Allocate || instruction.op == .HostCall { return false }
            if instruction.op == .Call && instruction.symbol == call.symbol { return false }
            if instruction.op == .Return { returns = true }
        }
    }
    return returns
}

// A block is inside a loop when it can reach itself. DONE/FLAGS memoize one
// answer per block; SEEN/QUEUE hold one breadth-first walk over at most every
// block. Calls in such a block repeat every iteration, so their site pays
// twice the body limit.
InLoop :: (function: LirFunction, start: s64, done: []u8, flags: []u8,
    seen: []u8, queue: []s32, budget: *LirSsaBudget) -> bool {
    if done[start] != 0 { return flags[start] != 0 }
    // Charge both visiting and clearing each queued block before marking it.
    if !LirSsaSpend(budget, 2) { return false }
    end: s64 = 1
    queue[0] = cast(s32)start
    seen[start] = 1
    loops := false
    for first: 0..function.blocks.count - 1 {
        if first == end { break }
        block := function.blocks[queue[first]]
        for edge: block.instructions[block.instructions.count - 1].edges {
            if !LirSsaSpend(budget, 1) { break }
            if edge.block == start { loops = true; break }
            if seen[edge.block] != 0 { continue }
            if !LirSsaSpend(budget, 2) { break }
            seen[edge.block] = 1
            queue[end] = edge.block
            end += 1
        }
        if loops || budget.problem != .None { break }
    }
    for at: 0..end - 1 { seen[queue[at]] = 0 }
    if budget.problem != .None { return false }
    done[start] = 1
    if loops { flags[start] = 1 } else { flags[start] = 0 }
    return loops
}

// A single-block callee whose result, if any, an instruction of its block
// defines is copied into the caller's block in place: no blocks, jumps or
// block parameters. Returns that instruction's index, -2 for a void return,
// or -1 when the callee needs its own blocks.
InPlace :: (callee: LirFunction) -> s64 {
    if callee.blocks.count != 1 { return -1 }
    block := callee.blocks[0]
    terminal := block.instructions[block.instructions.count - 1]
    if terminal.op != .Return { return -1 }
    if terminal.operands.count == 0 { return -2 }
    for at: 0..block.instructions.count - 2 {
        if block.instructions[at].result == terminal.operands[0] { return at }
    }
    return -1
}

// Copies each site's callee into FUNCTION. sites[i] names the callee of the
// i-th instruction in block order, or is -1. The call's block ends with a
// jump to the copied entry; every copied return jumps to the rest of the
// block, whose one parameter, if the call had a result, is that result.
Expand :: (program: LirProgram, function: LirFunction, sites: []s32, limits: LirLimits,
    budget: *LirSsaBudget, out: *Expanded) -> bool {
    shape := Measure(function)
    block_count := function.blocks.count
    value_count := function.values.count
    widest: s64
    for site: sites {
        if site < 0 { continue }
        callee := program.functions[site]
        inner := Measure(callee)
        if callee.values.count > widest { widest = callee.values.count }
        value_count += callee.values.count
        shape.instructions += inner.instructions
        shape.words += inner.words + 1
        if InPlace(callee) != -1 { continue }
        block_count += 1 + callee.blocks.count
        shape.edges += 1 + inner.edges + inner.returns
    }
    if value_count > limits.values || shape.instructions > limits.instructions || block_count > limits.blocks ||
        !LirSsaReserve(budget, value_count, 4) || !LirSsaReserve(budget, shape.instructions, 112) ||
        !LirSsaReserve(budget, shape.edges, 24) || !LirSsaReserve(budget, shape.words, 4) ||
        !LirSsaReserve(budget, block_count + function.blocks.count, 36) { budget.problem = .Limit; return false }
    first: Vec(s32)
    map: Vec(s32)
    defer VecFree(first)
    defer VecFree(map)
    // The caller frees `out` whether or not the expansion succeeds.
    if !VecResizeBounded(out.values, value_count, value_count) ||
        !VecResizeBounded(out.instructions, shape.instructions, shape.instructions) ||
        !VecResizeBounded(out.edges, shape.edges, shape.edges) ||
        !VecResizeBounded(out.data, shape.words, shape.words) ||
        !VecResizeBounded(out.blocks, block_count, block_count) ||
        !VecResizeBounded(first, function.blocks.count, function.blocks.count) ||
        !VecResizeBounded(map, widest + 1, widest + 1) {
        budget.problem = .Allocation; return false
    }
    values := out.values[:]
    instructions := out.instructions[:]
    edges := out.edges[:]
    data := out.data[:]
    blocks := out.blocks[:]
    for v: 0..function.values.count - 1 { values[v] = function.values[v] }
    // Each original block keeps one number; its sites' continuations and
    // copies follow it.
    next_block: s64
    flat: s64
    for b: 0..function.blocks.count - 1 {
        first[b] = cast(s32)next_block
        next_block += 1
        for instruction: function.blocks[b].instructions {
            if sites[flat] >= 0 && InPlace(program.functions[sites[flat]]) == -1 {
                next_block += 1 + program.functions[sites[flat]].blocks.count
            }
            flat += 1
        }
    }
    ip: s64
    ep: s64
    wp: s64
    next_value := function.values.count
    flat = 0
    for b: 0..function.blocks.count - 1 {
        block := function.blocks[b]
        current := cast(s64)first[b]
        following := current + 1
        parameter_start := wp
        for value: block.parameters { data[wp] = value; wp += 1 }
        blocks[current].parameters = data[parameter_start:wp]
        instruction_start := ip
        for i: 0..block.instructions.count - 1 {
            if !LirSsaSpend(budget, 1) { return false }
            instruction := block.instructions[i]
            site := sites[flat]
            flat += 1
            if site < 0 {
                operand_start := wp
                for value: instruction.operands { data[wp] = value; wp += 1 }
                instruction.operands = data[operand_start:wp]
                edge_start := ep
                for edge: instruction.edges {
                    argument_start := wp
                    for value: edge.arguments { data[wp] = value; wp += 1 }
                    edges[ep] = .{block = first[edge.block], arguments = data[argument_start:wp]}
                    ep += 1
                }
                instruction.edges = edges[edge_start:ep]
                instructions[ip] = instruction
                ip += 1
                continue
            }
            callee := program.functions[site]
            returned := InPlace(callee)
            if returned != -1 {
                // Parameters become the call's operands; each result gets a
                // new value, except that the returned one is the call's.
                source := callee.blocks[0]
                for at: 0..source.parameters.count - 1 { map[source.parameters[at]] = instruction.operands[at] }
                for at: 0..source.instructions.count - 2 {
                    copied := source.instructions[at]
                    if copied.result == LirNoId { continue }
                    if at == returned && instruction.result != LirNoId {
                        map[copied.result] = instruction.result
                    } else {
                        map[copied.result] = cast(s32)next_value
                        values[next_value] = callee.values[copied.result]
                        next_value += 1
                    }
                }
                for at: 0..source.instructions.count - 2 {
                    if !LirSsaSpend(budget, 1) { return false }
                    item := source.instructions[at]
                    if item.result != LirNoId { item.result = map[item.result] }
                    operand_start := wp
                    for value: item.operands { data[wp] = map[value]; wp += 1 }
                    item.operands = data[operand_start:wp]
                    instructions[ip] = item
                    ip += 1
                }
                continue
            }
            continuation := following
            copy := following + 1
            following += 1 + callee.blocks.count
            base := cast(s32)next_value
            for v: 0..callee.values.count - 1 { values[next_value + v] = callee.values[v] }
            next_value += callee.values.count
            argument_start := wp
            for value: instruction.operands { data[wp] = value; wp += 1 }
            edges[ep] = .{block = cast(s32)copy + callee.entry, arguments = data[argument_start:wp]}
            instructions[ip] = .{op = .Jump, result = LirNoId, edges = edges[ep:ep + 1], symbol = LirNoId, origin = instruction.origin}
            ep += 1
            ip += 1
            blocks[current].instructions = instructions[instruction_start:ip]
            for cb: 0..callee.blocks.count - 1 {
                source := callee.blocks[cb]
                start := wp
                for value: source.parameters { data[wp] = value + base; wp += 1 }
                blocks[copy + cb].parameters = data[start:wp]
                copy_start := ip
                for copied: source.instructions {
                    if !LirSsaSpend(budget, 1) { return false }
                    if copied.op == .Return {
                        returned := wp
                        if instruction.result != LirNoId {
                            for value: copied.operands { data[wp] = value + base; wp += 1 }
                        }
                        edges[ep] = .{block = cast(s32)continuation, arguments = data[returned:wp]}
                        instructions[ip] = .{op = .Jump, result = LirNoId, edges = edges[ep:ep + 1], symbol = LirNoId, origin = copied.origin}
                        ep += 1
                        ip += 1
                        continue
                    }
                    item := copied
                    if item.result != LirNoId { item.result += base }
                    operand_start := wp
                    for value: copied.operands { data[wp] = value + base; wp += 1 }
                    item.operands = data[operand_start:wp]
                    edge_start := ep
                    for edge: copied.edges {
                        argument_start := wp
                        for value: edge.arguments { data[wp] = value + base; wp += 1 }
                        edges[ep] = .{block = cast(s32)copy + edge.block, arguments = data[argument_start:wp]}
                        ep += 1
                    }
                    item.edges = edges[edge_start:ep]
                    instructions[ip] = item
                    ip += 1
                }
                blocks[copy + cb].instructions = instructions[copy_start:ip]
            }
            current = continuation
            parameter_start = wp
            if instruction.result != LirNoId { data[wp] = instruction.result; wp += 1 }
            blocks[current].parameters = data[parameter_start:wp]
            instruction_start = ip
        }
        blocks[current].instructions = instructions[instruction_start:ip]
    }
    for b: 0..block_count - 1 {
        effect: s32
        for at: 0..blocks[b].instructions.count - 1 {
            if LirEffectful(blocks[b].instructions[at].op) {
                effect += 1
                blocks[b].instructions[at].effect = effect
            } else {
                blocks[b].instructions[at].effect = 0
            }
        }
    }
    function.values = values[:next_value]
    function.blocks = blocks
    function.entry = first[function.entry]
    out.function = function
    return true
}

// Write once, while every expanded table and the borrowed input still exist;
// only LirRead may replace the owner's storage.
// Fills ORDER with every function, each after the functions it calls
// (except along a cycle), by depth-first search without recursion.
CalleesFirst :: (program: LirProgram, order: []s32, budget: *LirSsaBudget) -> bool {
    count := program.functions.count
    stack: Vec(s32)
    state: Vec(u8)
    block_at: Vec(s64)
    instruction_at: Vec(s64)
    defer VecFree(stack)
    defer VecFree(state)
    defer VecFree(block_at)
    defer VecFree(instruction_at)
    if !LirSsaReserve(budget, count, 21) { return false }
    if !VecResizeBounded(stack, count, count) || !VecResizeBounded(state, count, count) ||
        !VecResizeBounded(block_at, count, count) || !VecResizeBounded(instruction_at, count, count) {
        budget.problem = .Allocation
        return false
    }
    for f: 0..count - 1 { state[f] = 0; block_at[f] = 0; instruction_at[f] = 0 }
    placed: s64
    for root: 0..count - 1 {
        if state[root] != 0 { continue }
        depth: s64
        stack[0] = cast(s32)root
        state[root] = 1
        while depth >= 0 {
            f := stack[depth]
            function := program.functions[f]
            pushed := false
            while block_at[f] < function.blocks.count {
                block := function.blocks[block_at[f]]
                if instruction_at[f] >= block.instructions.count {
                    block_at[f] += 1
                    instruction_at[f] = 0
                    continue
                }
                instruction := block.instructions[instruction_at[f]]
                instruction_at[f] += 1
                if !LirSsaSpend(budget, 1) { return false }
                callee := instruction.symbol
                if instruction.op == .Call && callee >= 0 && cast(s64)callee < count && state[callee] == 0 {
                    state[callee] = 1
                    depth += 1
                    stack[depth] = callee
                    pushed = true
                    break
                }
            }
            if pushed { continue }
            state[f] = 2
            order[placed] = f
            placed += 1
            depth -= 1
        }
    }
    return true
}

// Whether FUNCTION's blocks form no cycle: every block leaves the
// topological order Kahn's method builds from the entry.
Acyclic :: (function: LirFunction, budget: *LirSsaBudget) -> bool {
    count := function.blocks.count
    indegree: Vec(s32)
    queue: Vec(s32)
    defer VecFree(indegree)
    defer VecFree(queue)
    if !LirSsaReserve(budget, count, 8) { return false }
    if !VecResizeBounded(indegree, count, count) || !VecResizeBounded(queue, count, count) {
        budget.problem = .Allocation
        return false
    }
    for at: 0..count - 1 { indegree[at] = 0 }
    for block: function.blocks {
        for edge: block.instructions[block.instructions.count - 1].edges { indegree[edge.block] += 1 }
    }
    head: s64
    tail: s64
    for at: 0..count - 1 { if indegree[at] == 0 { queue[tail] = cast(s32)at; tail += 1 } }
    while head < tail {
        if !LirSsaSpend(budget, 1) { return false }
        block := function.blocks[queue[head]]
        head += 1
        for edge: block.instructions[block.instructions.count - 1].edges {
            indegree[edge.block] -= 1
            if indegree[edge.block] == 0 { queue[tail] = edge.block; tail += 1 }
        }
    }
    return tail == count
}

#scope_export
// Procedures a caller cannot observe: no stores, host or indirect calls,
// traps or operations that may trap, no loops, and calls only to such
// procedures. pure[f] is 1 for each. An unused call to one can go, and one
// whose result is only read member by member can be inlined for those reads.
LirPureProcedures :: (program: LirProgram, pure: []u8, budget: *LirSsaBudget) -> bool {
    for function_index: 0..program.functions.count - 1 {
        function := program.functions[function_index]
        pure[function_index] = 0
        if function.external || function.variadic || function.calling != .Portable || function.blocks.count == 0 { continue }
        candidate := true
        for block: function.blocks {
            for instruction: block.instructions {
                if !LirSsaSpend(budget, 1) { return false }
                op := instruction.op
                memory := op == .Load || op == .ElementAddress || op == .FieldAddress || op == .BytesEqual
                trapping := op == .Divide || op == .Remainder || op == .Trap || op == .Unreachable ||
                    instruction.checked || program.checks && memory ||
                    op == .Convert && program.types[function.values[instruction.operands[0]]].kind == .Float &&
                    program.types[function.values[instruction.result]].kind == .Integer
                effect := op == .Store || op == .Copy || op == .Zero || op == .Allocate || op == .HostCall ||
                    op == .CallIndirect || op == .Resize
                if trapping || effect || op == .Call && cast(s64)instruction.symbol == function_index { candidate = false }
            }
        }
        if !candidate { continue }
        held := budget.reserved
        acyclic := Acyclic(function, budget)
        budget.reserved = held
        if budget.problem != .None { return false }
        if acyclic { pure[function_index] = 1 }
    }
    changed := true
    while changed {
        changed = false
        for function_index: 0..program.functions.count - 1 {
            if pure[function_index] == 0 { continue }
            for block: program.functions[function_index].blocks {
                for instruction: block.instructions {
                    if !LirSsaSpend(budget, 1) { return false }
                    if instruction.op == .Call && pure[function_index] != 0 &&
                        (instruction.symbol < 0 || pure[instruction.symbol] == 0) {
                        pure[function_index] = 0
                        changed = true
                    }
                }
            }
        }
    }
    return true
}

// Inlines direct calls to procedures of at most MAXIMUM instructions.
// Callees are expanded before their callers, and a call copies its callee
// as expanded, so a helper's own inlined helpers come with it and a callee
// that grew past MAXIMUM stays a call. With PROJECTED, only calls to pure
// procedures whose result is read member by member and nowhere else are
// inlined, from callees up to four times as large: those reads then fold
// to what the callee built, and the rest of it is dead. The program grows
// by at most ALLOWANCE instructions (negative: half its size, or 256 for a
// small one) and never beyond what the remaining work budget admits; it is
// written and verified once.
LirInlineCalls :: (storage: *LirReadOwner, limits: LirLimits, work: s64, maximum: s64,
    projected := false, allowance: s64 = -1) -> LirInlineCallsResult {
    result: LirInlineCallsResult
    budget := LirSsaBudget.{work = work, bytes = limits.bytes}
    if maximum <= 0 { return result }
    program := LirReadProgram(storage)
    total: s64
    largest: s64
    widest: s64
    widest_blocks: s64
    for function: program.functions {
        size := Measure(function).instructions
        total += size
        if size > largest { largest = size }
        if function.values.count > widest { widest = function.values.count }
        if function.blocks.count > widest_blocks { widest_blocks = function.blocks.count }
    }
    if allowance < 0 {
        allowance = total / 2
        if allowance < 256 { allowance = 256 }
    }
    // Later passes spend over a thousand work units per instruction; keep
    // the grown program within a quarter of what the remaining work admits,
    // so a large program is never pushed past its optimizer budget.
    room := work / 4096 - total
    if room < allowance { allowance = room }
    functions: Vec(LirFunction)
    versions: Vec(Expanded)
    sites: Vec(s32)
    order: Vec(s32)
    pure: Vec(u8)
    read_only: Vec(u8)
    loop_done: Vec(u8)
    loop_flags: Vec(u8)
    loop_seen: Vec(u8)
    loop_queue: Vec(s32)
    defer VecFree(functions)
    defer VecFree(sites)
    defer VecFree(order)
    defer VecFree(pure)
    defer VecFree(read_only)
    defer VecFree(loop_done)
    defer VecFree(loop_flags)
    defer VecFree(loop_seen)
    defer VecFree(loop_queue)
    defer VecFree(versions)
    defer FreeExpanded(versions[:])
    if !LirSsaReserve(*budget, largest, 4) { result.problem = budget.problem; return result }
    if !VecResizeBounded(functions, program.functions.count, program.functions.count) ||
        !VecResizeBounded(sites, largest, largest) ||
        !VecResizeBounded(order, program.functions.count, program.functions.count) {
        result.problem = .Allocation
        return result
    }
    // Reuse one set of memo and walk arrays across differently sized callers.
    // Projected inlining does not use loop weighting.
    if projected { widest_blocks = 0 }
    if !LirSsaReserve(*budget, widest_blocks * 3, 1) || !LirSsaReserve(*budget, widest_blocks, 4) {
        result.problem = budget.problem
        return result
    }
    if !VecResizeBounded(loop_done, widest_blocks, widest_blocks) ||
        !VecResizeBounded(loop_flags, widest_blocks, widest_blocks) ||
        !VecResizeBounded(loop_seen, widest_blocks, widest_blocks) ||
        !VecResizeBounded(loop_queue, widest_blocks, widest_blocks) {
        result.problem = .Allocation
        return result
    }
    for fi: 0..program.functions.count - 1 { functions[fi] = program.functions[fi] }
    if !CalleesFirst(program, order[:], *budget) { result.problem = budget.problem; return result }
    if projected {
        if !LirSsaReserve(*budget, program.functions.count + widest, 1) { result.problem = budget.problem; return result }
        if !VecResizeBounded(pure, program.functions.count, program.functions.count) ||
            !VecResizeBounded(read_only, widest, widest) {
            result.problem = .Allocation
            return result
        }
        if !LirPureProcedures(program, pure[:], *budget) { result.problem = budget.problem; return result }
    }
    // The program as expanded so far: callers see their callees' new bodies.
    current := program
    current.functions = functions[:]
    for position: 0..program.functions.count - 1 {
        fi := cast(s64)order[position]
        function := program.functions[fi]
        if function.external || function.blocks.count == 0 { continue }
        count := Measure(function).instructions
        budget.reserved = 0
        if !LirSsaSpend(*budget, count) { break }
        if projected {
            // Values read member by member and nowhere else.
            for v: 0..function.values.count - 1 { read_only[v] = 0 }
            for block: function.blocks {
                for instruction: block.instructions {
                    if !LirSsaSpend(*budget, 1 + instruction.operands.count) { break }
                    for at: 0..instruction.operands.count - 1 {
                        value := instruction.operands[at]
                        read := instruction.op == .Extract && instruction.operands.count == 1 && !instruction.checked
                        read_only[value] = ifx read && read_only[value] != 2 then 1 else 2
                    }
                    for edge: instruction.edges { for value: edge.arguments { read_only[value] = 2 } }
                }
            }
            if budget.problem != .None { break }
        }
        // Clear memo entries for this caller; each new graph walk spends its
        // actual visited blocks and edges, including on an exhausted budget.
        loop_blocks := ifx projected then 0 else function.blocks.count
        if !LirSsaSpend(*budget, loop_blocks) { break }
        for at: 0..loop_blocks - 1 { loop_done[at] = 0 }
        found: s64
        flat: s64
        for block, bi: function.blocks {
            for instruction: block.instructions {
                sites[flat] = -1
                eligible := false
                if allowance > 0 && !projected {
                    // A call inside a loop repeats every iteration, so its
                    // site pays twice the body limit.
                    site_maximum := maximum
                    if instruction.op == .Call && InLoop(function, bi, loop_done[:],
                        loop_flags[:], loop_seen[:], loop_queue[:], *budget) &&
                        maximum <= 4611686018427387903 { site_maximum = maximum * 2 }
                    if budget.problem != .None { break }
                    eligible = Expandable(current, fi, instruction, site_maximum)
                }
                if allowance > 0 && projected && instruction.op == .Call && instruction.result != LirNoId &&
                    read_only[instruction.result] == 1 && instruction.symbol >= 0 &&
                    cast(s64)instruction.symbol < program.functions.count && pure[instruction.symbol] != 0 {
                    eligible = Expandable(current, fi, instruction, maximum * 4)
                }
                if eligible {
                    size := Measure(current.functions[instruction.symbol]).instructions
                    if size <= allowance {
                        sites[flat] = instruction.symbol
                        allowance -= size
                        result.grown += size
                        found += 1
                    }
                }
                flat += 1
            }
            if budget.problem != .None { break }
        }
        if budget.problem != .None { break }
        if found == 0 { continue }
        expanded: Expanded
        built := Expand(current, function, sites[:count], limits, *budget, *expanded)
        if budget.reserved > result.scratch_bytes { result.scratch_bytes = budget.reserved }
        if !built {
            ExpandedFree(*expanded)
            break
        }
        functions[fi] = expanded.function
        VecPush(versions, expanded)
        result.calls += found
    }
    if budget.problem == .None && result.calls > 0 {
        budget.reserved = 0
        inlined := program
        inlined.functions = functions[:]
        result.codec = LirSsaSerialize(storage, inlined, limits, *budget)
        if budget.reserved > result.scratch_bytes { result.scratch_bytes = budget.reserved }
    }
    result.problem = budget.problem
    result.work = budget.used
    return result
}

#scope_file
// The type of member MEMBER of the record or array TYPE, or -1.
MemberType :: (program: LirProgram, type: s32, member: u64) -> s32 {
    value := program.types[type]
    if value.kind == .Record && member < cast(u64)value.fields.count { return value.fields[cast(s64)member] }
    if value.kind == .Array && member < cast(u64)value.count { return value.element }
    return -1
}

// The members a sunk parameter is read at, and where its new parameters start.
Sunk :: struct { start: s64; count: s64; first: s32 }

// Replaces each block parameter that only fixed member reads use with one
// parameter per member read. Each edge into the block reads those members
// from its argument just before the jump, so a record joined from calls or
// loads is never needed whole when only some of its members are read.
SinkReads :: (program: LirProgram, function: LirFunction, limits: LirLimits,
    budget: *LirSsaBudget, out: *Expanded) -> s64 {
    count := function.values.count
    if !LirSsaReserve(budget, count, 32) { return -1 }
    reads_only: Vec(u8)
    owner: Vec(s32)
    plans: Vec(Sunk)
    members: Vec(u64)
    rename: Vec(s32)
    defer VecFree(reads_only)
    defer VecFree(owner)
    defer VecFree(plans)
    defer VecFree(members)
    defer VecFree(rename)
    if !VecResizeBounded(reads_only, count, count) || !VecResizeBounded(owner, count, count) ||
        !VecResizeBounded(plans, count, count) || !VecResizeBounded(rename, count, count) {
        budget.problem = .Allocation; return -1
    }
    for v: 0..count - 1 { reads_only[v] = 1; owner[v] = -1; rename[v] = cast(s32)v; plans[v].count = 0 }
    for b: 0..function.blocks.count - 1 {
        if cast(s32)b == function.entry { continue }
        for value: function.blocks[b].parameters { owner[value] = cast(s32)b }
    }
    uses: s64
    for block: function.blocks {
        for instruction: block.instructions {
            if !LirSsaSpend(budget, 1 + instruction.operands.count) { return -1 }
            for at: 0..instruction.operands.count - 1 {
                read := instruction.op == .Extract && instruction.operands.count == 1 && at == 0 && !instruction.checked
                if !read { reads_only[instruction.operands[at]] = 0 } else { uses += 1 }
            }
            for edge: instruction.edges { for value: edge.arguments { reads_only[value] = 0 } }
        }
    }
    // Each candidate's distinct members, at most eight.
    if !VecResizeBounded(members, uses + 1, uses + 1) { budget.problem = .Allocation; return -1 }
    used: s64
    for block: function.blocks {
        for instruction: block.instructions {
            if instruction.op != .Extract || instruction.operands.count != 1 { continue }
            p := instruction.operands[0]
            if owner[p] < 0 || reads_only[p] == 0 { continue }
            kind := program.types[function.values[p]].kind
            if kind != .Record && kind != .Array { reads_only[p] = 0; continue }
            if plans[p].count == 0 { plans[p].start = used }
            seen := false
            for j: 0..plans[p].count - 1 { if members[plans[p].start + j] == instruction.immediate { seen = true } }
            if seen { continue }
            // Members of one parameter are contiguous only while it is the
            // last one started; otherwise, or past eight, leave it whole.
            if plans[p].count >= 8 || plans[p].start + plans[p].count != used { reads_only[p] = 0; continue }
            members[used] = instruction.immediate
            used += 1
            plans[p].count += 1
        }
    }
    sunk: s64
    added_values: s64
    for v: 0..count - 1 {
        if owner[v] < 0 || reads_only[v] == 0 || plans[v].count == 0 { plans[v].count = 0; continue }
        plans[v].first = cast(s32)(count + added_values)
        added_values += plans[v].count
        sunk += 1
    }
    if sunk == 0 { return 0 }
    // Inserted reads: one per sunk member per edge into its block.
    inserted: s64
    for block: function.blocks {
        for edge: block.instructions[block.instructions.count - 1].edges {
            for value: function.blocks[edge.block].parameters { inserted += plans[value].count }
        }
    }
    shape := Measure(function)
    value_count := count + added_values + inserted
    instruction_count := shape.instructions + inserted
    word_count := shape.words + added_values * 2 + inserted * 2
    if value_count > limits.values || instruction_count > limits.instructions ||
        !LirSsaReserve(budget, value_count, 4) || !LirSsaReserve(budget, instruction_count, 112) ||
        !LirSsaReserve(budget, shape.edges + 1, 24) || !LirSsaReserve(budget, word_count, 4) ||
        !LirSsaReserve(budget, function.blocks.count, 32) { budget.problem = .Limit; return -1 }
    if !VecResizeBounded(out.values, value_count, value_count) ||
        !VecResizeBounded(out.instructions, instruction_count, instruction_count) ||
        !VecResizeBounded(out.edges, shape.edges + 1, shape.edges + 1) ||
        !VecResizeBounded(out.data, word_count, word_count) ||
        !VecResizeBounded(out.blocks, function.blocks.count, function.blocks.count) {
        budget.problem = .Allocation; return -1
    }
    values := out.values[:]
    instructions := out.instructions[:]
    edges := out.edges[:]
    data := out.data[:]
    blocks := out.blocks[:]
    for v: 0..count - 1 {
        values[v] = function.values[v]
        if plans[v].count == 0 { continue }
        for j: 0..plans[v].count - 1 {
            values[plans[v].first + j] = MemberType(program, function.values[v], members[plans[v].start + j])
        }
    }
    // A removed read names the new parameter for its member.
    for block: function.blocks {
        for instruction: block.instructions {
            if instruction.op != .Extract || instruction.operands.count != 1 || instruction.result == LirNoId { continue }
            p := instruction.operands[0]
            for j: 0..plans[p].count - 1 {
                if members[plans[p].start + j] == instruction.immediate { rename[instruction.result] = plans[p].first + cast(s32)j }
            }
        }
    }
    next_value := count + added_values
    ip: s64
    ep: s64
    wp: s64
    for b: 0..function.blocks.count - 1 {
        block := function.blocks[b]
        start := wp
        for value: block.parameters {
            if plans[value].count == 0 { data[wp] = value; wp += 1; continue }
            for j: 0..plans[value].count - 1 { data[wp] = plans[value].first + cast(s32)j; wp += 1 }
        }
        blocks[b].parameters = data[start:wp]
        first := ip
        for instruction: block.instructions {
            if !LirSsaSpend(budget, 1) { return -1 }
            if instruction.op == .Extract && instruction.operands.count == 1 && plans[instruction.operands[0]].count > 0 { continue }
            item := instruction
            // Before the jump, each edge reads the members its sunk parameters
            // need; the edges then pass those reads in the same order.
            read_base := next_value
            for edge: instruction.edges {
                target := function.blocks[edge.block]
                for at: 0..edge.arguments.count - 1 {
                    p := target.parameters[at]
                    if plans[p].count == 0 { continue }
                    source := rename[edge.arguments[at]]
                    for j: 0..plans[p].count - 1 {
                        data[wp] = source
                        instructions[ip] = .{op = .Extract, result = cast(s32)next_value, operands = data[wp:wp + 1],
                            immediate = members[plans[p].start + j], symbol = LirNoId, origin = instruction.origin}
                        values[next_value] = MemberType(program, function.values[p], members[plans[p].start + j])
                        wp += 1
                        ip += 1
                        next_value += 1
                    }
                }
            }
            operand_start := wp
            for value: instruction.operands { data[wp] = rename[value]; wp += 1 }
            item.operands = data[operand_start:wp]
            edge_start := ep
            fresh: s64
            for edge: instruction.edges {
                target := function.blocks[edge.block]
                argument_start := wp
                for at: 0..edge.arguments.count - 1 {
                    p := target.parameters[at]
                    if plans[p].count == 0 { data[wp] = rename[edge.arguments[at]]; wp += 1; continue }
                    for j: 0..plans[p].count - 1 {
                        data[wp] = cast(s32)(read_base + fresh)
                        wp += 1
                        fresh += 1
                    }
                }
                edges[ep] = .{block = edge.block, arguments = data[argument_start:wp]}
                ep += 1
            }
            item.edges = edges[edge_start:ep]
            instructions[ip] = item
            ip += 1
        }
        blocks[b].instructions = instructions[first:ip]
    }
    // Every value is defined once: drop the sunk parameters and the reads
    // they replaced, and number what is left densely. Every word in data is
    // a value: a parameter, an operand or an edge argument.
    dense: Vec(s32)
    defer VecFree(dense)
    if !VecResizeBounded(dense, next_value, next_value) { budget.problem = .Allocation; return -1 }
    for v: 0..next_value - 1 { dense[v] = -1 }
    for b: 0..function.blocks.count - 1 { for value: blocks[b].parameters { dense[value] = 0 } }
    for i: 0..ip - 1 { if instructions[i].result != LirNoId { dense[instructions[i].result] = 0 } }
    kept: s32
    for v: 0..next_value - 1 {
        if dense[v] < 0 { continue }
        dense[v] = kept
        values[kept] = values[v]
        kept += 1
    }
    for w: 0..wp - 1 { data[w] = dense[data[w]] }
    for i: 0..ip - 1 { if instructions[i].result != LirNoId { instructions[i].result = dense[instructions[i].result] } }
    function.values = values[:kept]
    function.blocks = blocks
    out.function = function
    return sunk
}

#scope_export
// Sinks member reads of joined records into the edges that join them (see
// SinkReads), ROUNDS times so nested members sink too. The program is
// written and verified once.
LirSinkFieldReads :: (storage: *LirReadOwner, limits: LirLimits, work: s64, rounds: s64) -> LirInlineCallsResult {
    result: LirInlineCallsResult
    budget := LirSsaBudget.{work = work, bytes = limits.bytes}
    program := LirReadProgram(storage)
    functions: Vec(LirFunction)
    versions: Vec(Expanded)
    defer VecFree(functions)
    defer VecFree(versions)
    defer FreeExpanded(versions[:])
    if !VecResizeBounded(functions, program.functions.count, program.functions.count) {
        result.problem = .Allocation
        return result
    }
    for fi: 0..program.functions.count - 1 { functions[fi] = program.functions[fi] }
    for round: 1..rounds {
        sunk_round: s64
        for fi: 0..program.functions.count - 1 {
            function := functions[fi]
            if function.external || function.blocks.count < 2 { continue }
            budget.reserved = 0
            expanded: Expanded
            sunk := SinkReads(program, function, limits, *budget, *expanded)
            if budget.reserved > result.scratch_bytes { result.scratch_bytes = budget.reserved }
            if sunk <= 0 {
                ExpandedFree(*expanded)
                if sunk < 0 { break }
                continue
            }
            functions[fi] = expanded.function
            VecPush(versions, expanded)
            sunk_round += sunk
        }
        if budget.problem != .None || sunk_round == 0 { break }
        result.calls += sunk_round
    }
    if budget.problem == .None && result.calls > 0 {
        budget.reserved = 0
        sunk_program := program
        sunk_program.functions = functions[:]
        result.codec = LirSsaSerialize(storage, sunk_program, limits, *budget)
        if budget.reserved > result.scratch_bytes { result.scratch_bytes = budget.reserved }
    }
    result.problem = budget.problem
    result.work = budget.used
    return result
}
