within :: (path: *u8, root: *u8) -> s32 {
    if !(root != null) {
        return 0
    }
    n: usize = strlen(root)
    return cast(s32)(((n != 0) && !(strncmp(path, root, n) != 0)) && (((n == cast(usize)(1)) || !((path)[n] != 0)) || (cast(s32)(cast(s8)((path)[n])) == 47)))
    unreachable
}

