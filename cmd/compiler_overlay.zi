}

#scope_file
canonical_path :: (path: *u8) -> *u8 {
    result: *u8
    if S15HostOS() == 1 {
        result = S15WindowsFullPath(path)
        p := result
        while p != null && p[0] != 0 { if p[0] == 92 { p[0] = 47 }; p = cast(*u8)(cast(usize)p + 1) }
        return result
    }
    return S15RealPath(path, null)
}

#scope_export
#program_export "SourceOverlayAllowed"
SourceOverlayAllowed :: (path: *u8) -> s32 {
    if (!((S15OverlayStateAddress()).path != null) || !((S15OverlayStateAddress()).root != null)) {
        return 1
    }
    canonical: *u8 = canonical_path(path)
    allowed: s32 = cast(s32)((canonical != null) && ((within(canonical, ((S15OverlayStateAddress()).root)) != 0) || (within(canonical, ((S15OverlayStateAddress()).standard)) != 0)))
    {
        i: s32 = 0
        while check_loop_60 := (((canonical != null) && !(allowed != 0)) && (i < ((S15OverlayStateAddress()).roots_count))) {
            allowed = within(canonical, (((S15OverlayStateAddress()).roots))[i])
            S15SupportPost1(*(i))
        }
    }
    free(cast(*void)(canonical))
    return allowed
    unreachable
}

