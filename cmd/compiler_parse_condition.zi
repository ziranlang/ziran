        (fr).selected |= chosen
        (fr).braces = 1
        return 1
    }
    if (((fr).braces == 1) && (line_is_compile_else(line) != 0)) {
        (fr).active = cast(s32)(((fr).parent_active != 0) && !((fr).selected != 0))
        (fr).selected = 1
        (fr).braces = 1
        return 1
    }
    (fr).braces += net_block_braces(line)
    if ((fr).braces <= 0) {
        ParserPost3(count)
        return 1
    }
    return 0
}

#scope_export
#program_export "private_parse_cond_frame_settle"
cond_frame_settle :: (frames: *ZirCondFrame, count: s32) {
    if (count > 0) {
        ParserPost3(*(((frames)[(count - 1)]).braces))
    }
}

#scope_export
#program_export "private_parse_strip_block_comments"
strip_block_comments :: (s: *u8, comment_depth: *s32) {
    length: usize = strlen(s)
    result := Source.StripComments(IR.CText(s), IR.CBuffer(s, length), comment_depth[0])
    s[result.count] = 0
    comment_depth[0] = result.depth
}


#scope_file
ParseExpr :: (fn: *IR.ZirFunction, module: *IR.ZirModule, text: *u8, span: IR.ZirSourceSpan) -> s32 {
    return CompilerParseExpr(fn, cast(*IR.ZirModule)(module), cast(*void)(text), span)
}

#scope_file
StructureFunction :: (fn: *IR.ZirFunction, module: *IR.ZirModule) {
    CompilerStructureFunction(fn, cast(*IR.ZirModule)(module))
}
