#scope_export
#program_export "private_parse_strip_program_export"
strip_program_export :: (line: *u8, symbol: *u8, symbol_size: usize, span: IR.ZirSourceSpan) -> s32 {
    directive: Declaration.ExportDirective = Declaration.ProgramExport(declaration_text(line), cast(s64)(symbol_size))
    check_declaration_error(cast(Declaration.DeclarationError)((directive).error), span)
    copy_declaration_part(symbol, symbol_size, (directive).symbol, 0)
