S14Slice :: (data: *$T, count: s64) -> []T {
    descriptor := ParserSlice.{cast(*void)data, count}
    result: []T
    memcpy(cast(*void)*result, cast(*void)*descriptor, size_of([]T))
    return result
}

declaration_text :: (source: *u8) -> string {
