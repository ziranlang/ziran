        memmove(cast(*void)(line), cast(*void)(S14StringData((directive).body)), (cast(usize)(cast(usize)(((directive).body).count)) + cast(usize)(1)))
    }
    return cast(s32)((directive).kind)
}

#scope_file
rewrite_parameters :: (args: *u8, cleaned: *u8, strip_defaults: s32, strip_using: s32, span: IR.ZirSourceSpan) -> Declaration.ParameterRewrite {
