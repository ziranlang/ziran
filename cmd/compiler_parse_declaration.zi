#scope_export
#program_export "private_parse_parse_function_header"
parse_function_header :: (name: *u8, name_size: usize, args: *u8, args_size: usize, ret: *u8, ret_size: usize, line: *u8) {
    header: Source.ProcedureHeader = Source.ProcedureHeaderParts(declaration_text(line))
    copy_declaration_part(name, name_size, (header).name, 0)
    copy_declaration_part(args, args_size, (header).parameters, 1)
    copy_declaration_part(ret, ret_size, (header).result, 1)
}

#scope_export
#program_export "private_parse_function_must_use"
function_must_use :: (line: *u8, return_type: *u8, span: IR.ZirSourceSpan) -> s32 {
    modifier: Source.MustUseModifier = Source.ProcedureMustUse(declaration_text(line), declaration_text(return_type))
    if (cast(s32)(modifier) == cast(s32)(2)) {
        die_at(span, ParserCString("#must does not take arguments"))
        unreachable
    }
    if (cast(s32)(modifier) == cast(s32)(3)) {
        die_at(span, ParserCString("duplicate #must procedure modifier"))
        unreachable
    }
    if (cast(s32)(modifier) == cast(s32)(4)) {
        die_at(span, ParserCString("#must requires a return value"))
        unreachable
    }
    return cast(s32)(cast(s32)(modifier) == cast(s32)(1))
}

#scope_export
#program_export "private_parse_function_inlining"
function_inlining :: (line: *u8, span: IR.ZirSourceSpan) -> s32 {
    modifier: Source.InliningModifier = Source.ProcedureInlining(declaration_text(line))
    if (cast(s32)(modifier) == cast(s32)(3)) {
        die_at(span, ParserCString("#inline and #cold do not take arguments"))
        unreachable
    }
    if (cast(s32)(modifier) == cast(s32)(4)) {
        die_at(span, ParserCString("duplicate #inline or #cold procedure modifier"))
        unreachable
    }
    if (cast(s32)(modifier) == cast(s32)(5)) {
        die_at(span, ParserCString("a procedure cannot be both #inline and #cold"))
        unreachable
    }
    return (ifx (cast(s32)(modifier) == cast(s32)(1)) then 1 else (ifx (cast(s32)(modifier) == cast(s32)(2)) then 2 else 0))
}

#scope_export
#program_export "private_parse_function_target"
function_target :: (line: *u8, span: IR.ZirSourceSpan) -> s32 {
    modifier: Source.TargetModifier = Source.ProcedureTarget(declaration_text(line))
    if (cast(s32)(modifier) == cast(s32)(2)) {
