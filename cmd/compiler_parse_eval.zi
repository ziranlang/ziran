evaluate_imported_typed_define_in_state :: (evaluation: *EvaluationState, module: *IR.ZirModule, path: *u8, name: *u8, depth: s32, fuel: *s32, result: *CompileValue) -> s32 {
    law_evaluation := ZirLawEvaluationAddress()
    owner: *IR.ZirModule = null
    definition: *IR.ZirDefine = (ifx (strchr(name, 46) != cast(*u8)((null))) then find_imported_define(module, path, name, strlen(name), *(owner)) else find_open_imported_define(module, path, name, *(owner)))
    names_storage_0 := cast(*ZirConsts)AllocateOrExit(size_of(ZirConsts))
    defer CompilerFree(cast(*void)names_storage_0)
    memset(cast(*void)names_storage_0, 0, size_of(ZirConsts))
    names_storage_0[0] = .{}
    ok: s32
    if ((definition == cast(*IR.ZirDefine)((null))) || (depth >= 32)) {
        return 0
    }
    if (law_evaluation[0] != 0) {
        return evaluate_typed_expression_in_state(evaluation, owner, *(names_storage_0[0]), (definition).value, (definition).span, (depth + 1), fuel, result)
    }
    (names_storage_0[0]).count = (owner).define_count
    (names_storage_0[0]).items = cast(*ZirConst)(CompilerCalloc((cast(usize)((names_storage_0[0]).count) + cast(usize)(1)), cast(usize)size_of(ZirConst)))
    if ((names_storage_0[0]).items == cast(*ZirConst)((null))) {
        die(ParserCString("out of memory evaluating imported constant"))
        unreachable
    }
    {
        i: s32 = 0
        while loop_61 := (i < (names_storage_0[0]).count) {
            source: *IR.ZirDefine = cast(*IR.ZirDefine)(cast(usize)((owner).defines) + cast(usize)(i) * size_of(IR.ZirDefine))
            constant: *ZirConst = cast(*ZirConst)(cast(usize)((names_storage_0[0]).items) + cast(usize)(i) * size_of(ZirConst))
            copy_text(cast(*u8)(*(((constant).name).items)), cast(usize)size_of(ParserArray128_u8), cast(*u8)(*((source).name)))
            (constant).expr = KeepText((source).value)
            copy_text(cast(*u8)(*(((constant).path).items)), cast(usize)size_of(ParserArray1024_u8), SpanPath((source).span))
            (constant).is_file_private = (source).is_file_private
            (constant).source_line = ((source).span).line
            S14ParserPost1(*(i))
        }
    }
    ok = evaluate_typed_expression_in_state(evaluation, owner, *(names_storage_0[0]), (definition).value, (definition).span, (depth + 1), fuel, result)
    CompilerFree(cast(*void)((names_storage_0[0]).items))
    return ok
}

#scope_export
#program_export "private_parse_evaluate_imported_typed_define"
evaluate_imported_typed_define :: (module: *IR.ZirModule, path: *u8, name: *u8, depth: s32, fuel: *s32, result: *CompileValue) -> s32 {
    evaluation: EvaluationState
    return evaluate_imported_typed_define_in_state(*evaluation, module, path, name, depth, fuel, result)
}

#scope_file
ScalarWidth :: (type: *u8) -> u32 {
    return ScalarWidthZiran(cast(*void)(type))
}

#scope_file
ScalarStored :: (bits: u64, type: *u8) -> s64 {
    return ScalarStoredZiran(bits, cast(*void)(type))
}

#scope_file
compile_literal :: (value: *CompileValue) -> *u8 {
    return (ifx ((value).kept != cast(*u8)((null))) then (value).kept else cast(*u8)(*(((value).spelling).items)))
}

#scope_file
compile_value_clear :: (value: *CompileValue) {
    (value).kind = 0
    (value).integer = cast(s64)(0)
    (value).real = cast(float64)(0)
    ((value).type).items[0] = cast(u8)(0)
    (value).kept = null
    ((value).spelling).items[0] = cast(u8)(0)
    (value).type_owner = null
}

#scope_file
ParseExpr :: (fn: *IR.ZirFunction, module: *IR.ZirModule, text: *u8, span: IR.ZirSourceSpan) -> s32 {
