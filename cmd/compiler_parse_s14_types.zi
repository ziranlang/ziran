__builtin_add_overflow :: (left: s64, right: s64, out: *s64) -> bool {
    result := cast(s64)(cast(u64)left + cast(u64)right)
    out[0] = result
    return ((left ^ result) & (right ^ result)) < 0
}
__builtin_sub_overflow :: (left: s64, right: s64, out: *s64) -> bool {
    result := cast(s64)(cast(u64)left - cast(u64)right)
    out[0] = result
    return ((left ^ right) & (left ^ result)) < 0
}
__builtin_mul_overflow :: (left: s64, right: s64, out: *s64) -> bool {
    a := ifx left < 0 then cast(u64)0 - cast(u64)left else cast(u64)left
    b := ifx right < 0 then cast(u64)0 - cast(u64)right else cast(u64)right
    limit := ifx (left < 0) != (right < 0) then cast(u64)9223372036854775808 else cast(u64)9223372036854775807
    out[0] = cast(s64)(cast(u64)left * cast(u64)right)
    return b != 0 && a > limit / b
}
