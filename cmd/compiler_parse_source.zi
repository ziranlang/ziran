#scope_export
#program_export "parse_file_with_imports"
parse_file_with_imports :: (path: *u8, root: *u8, resolver: ZirCompileImportResolver, context: *void) -> *IR.ZirProgram {
    return parse_file_with_imports_defined(path, root, resolver, context, null, 0)
}

#scope_file
resolve_imports_outside_operation :: (opaque: *void, program: *IR.ZirProgram, module: *IR.ZirModule, source_path: *u8, root: *u8, condition: *u8) -> s32 {
    resolver: *ImportResolver = cast(*ImportResolver)(opaque)
    memory: *void = CompilerMemoryPause()
    result: s32 = (resolver).resolve((resolver).context, program, module, source_path, root, condition)
    CompilerMemoryResume(memory)
    return result
}

