#program_export "parse_file_with_imports_defined"
parse_file_with_imports_defined :: (path: *u8, root: *u8, resolver: ZirCompileImportResolver, context: *void, defines: **u8, define_count: s32) -> *IR.ZirProgram {
    return ParserWithRecovery(path, root, null, resolver, context, defines, define_count, null)
}

#scope_export
#program_export "parse_module_with_imports"
parse_module_with_imports :: (path: *u8, root: *u8, resolver: ZirCompileImportResolver, context: *void, defines: **u8, define_count: s32, site: *IR.ZirImport) -> *IR.ZirProgram {
