}

#scope_file
StructureFunction :: (fn: *IR.ZirFunction, module: *IR.ZirModule) {
    CompilerStructureFunction(fn, cast(*IR.ZirModule)(module))
}

#scope_file
parse_source :: (path: *u8, root: *u8, source: *u8, resolver: ZirCompileImportResolver, resolver_context: *void, defines: **u8, define_count: s32, site: *IR.ZirImport) -> *IR.ZirProgram {
    buffers := cast(*ParseSourceBuffers)AllocateOrExit(size_of(ParseSourceBuffers))
    buffers.pending = null
    buffers.logical = null
    buffers.pending_capacity = 0
    buffers.logical_capacity = 0
    started := ProfileStart()
    returned := parse_source_with_buffers(path, root, source, resolver, resolver_context, defines, define_count, site, buffers)
    ProfileEnd(ParserCString("parse"), started)
    free_parse_source_buffers(cast(*void)buffers)
    return returned
}

#scope_export
#program_export "private_parse_ParserParseOperationBody"
ParserParseOperationBody :: (path: *u8, root: *u8, source: *u8, resolver: ZirCompileImportResolver, context: *void, defines: **u8, define_count: s32, site: *IR.ZirImport) -> *IR.ZirProgram {
    if source != null && DocumentRecord(path, source, strlen(source)) == null {
        die_at(Span(path, 0, 0), ParserCString("source document identity limit exceeded"))
        unreachable
    }
    lowered := ifx source != null then lower_jai_multiline_strings(source, path) else read_lowered_source(path)
    imports := ImportResolver.{resolve = resolver, context = context}
    callback: ZirCompileImportResolver = cast(ZirCompileImportResolver)null
    if resolver != cast(ZirCompileImportResolver)null { callback = resolve_imports_outside_operation }
    program := parse_source(path, root, lowered, callback, cast(*void)*imports, defines, define_count, site)
    CompilerFree(cast(*void)lowered)
    return program
}
