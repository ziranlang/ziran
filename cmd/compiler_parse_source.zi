}

#scope_file
compile_value_clear :: (value: *CompileValue) {
    (value).kind = 0
    (value).integer = cast(s64)(0)
    (value).real = cast(float64)(0)
    ((value).type).items[0] = cast(u8)(0)
    (value).kept = null
    ((value).spelling).items[0] = cast(u8)(0)
