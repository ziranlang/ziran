#scope_file
add_open_enum_defines :: (module: *IR.ZirModule, constants: *ZirConsts) {
    if module.using_count == 0 { return }
    for i: 0..constants.count - 1 {
        constant := *constants.items[i]
        expression := constant.expr
        if is_identifier_text(expression) == 0 || strcmp(expression, ParserCString("true")) == 0 ||
            strcmp(expression, ParserCString("false")) == 0 || strcmp(expression, ParserCString("null")) == 0 { continue }
        name := cast(*u8)*constant.name.items[0]
        defined := false
        for j: 0..module.define_count - 1 {
            if strcmp(cast(*u8)*module.defines[j].name[0], name) == 0 {
                defined = true
                break
            }
        }
        if defined { continue }
        span := Span(cast(*u8)*constant.path.items[0], constant.source_line, 1)
        definition := ModuleAddDefine(module, name, expression, span)
        if definition == null {
            die_at(span, ParserCString("out of memory recording enum constant"))
            unreachable
        }
        definition.is_public = constant.is_public
        definition.is_file_private = constant.is_file_private
        definition.requires_open_enum = 1
    }
}

finish_module_bodies :: (program: *IR.ZirProgram, path: *u8, root: *u8, resolver: ZirCompileImportResolver, resolver_context: *void, constants: *ZirConsts) -> bool {
    for mi: 0..program.module_count - 1 {
        module := *program.modules[mi]
        add_default_helpers(program, module, path, root, resolver, resolver_context)
        lookup_path := cast(*u8)*module.lookup_path[0]
        for gi: 0..module.global_count - 1 {
            global := *module.globals[gi]
            copy_text(lookup_path, size_of(ParserArray1024_u8), SpanPath(global.span))
            if find_unquoted(global.init, ParserCString("#ifx"), false) != null {
                capacity: usize
                edit := TextEditBegin(global.init, *capacity)
                lower_compile_ifx_value(edit, capacity, module, constants, global.span, 1)
                global.init = TextEditEnd(edit)
            }
            if find_unquoted(global.init, ParserCString("#ifx"), false) == null &&
                find_unquoted(global.init, ParserCString("size_of"), true) != null &&
                find_unquoted(global.init, ParserCString("type_of"), true) == null {
                capacity: usize
                edit := TextEditBegin(global.init, *capacity)
                lower_size_of_value(edit, capacity, module, global.span)
                global.init = TextEditEnd(edit)
            }
        }
        for fi: 0..module.function_count - 1 {
            function := *module.functions[fi]
            copy_text(lookup_path, size_of(ParserArray1024_u8), SpanPath(function.span))
            for si: 0..function.stmt_count - 1 {
                if find_unquoted(function.stmts[si].text, ParserCString("#ifx"), false) != null {
                    lower_compile_ifx_function(function, module, constants, 1)
                    break
                }
            }
            if NormalizeJaiBodies(function) == 0 || BindJaiLoopControls(function) == 0 || LowerCleanup(function) == 0 || LowerJaiFor(function, module) == 0 { return false }
            StructureFunction(function, module)
        }
        lookup_path[0] = 0
    }
    return true
}

ensure_source_import :: (module: *IR.ZirModule, path: *u8, target: *u8, short_name: *u8, declaration: *u8) {
    for i: 0..module.import_count - 1 {
        current := cast(*u8)*module.imports[i].target[0]
        if strcmp(current, target) == 0 || strcmp(current, short_name) == 0 { return }
    }
    parse_import_line(module, path, 1, declaration, 0)
}

