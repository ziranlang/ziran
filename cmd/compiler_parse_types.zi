ParserPost0 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] + 1; return old }
ParserSet1 :: (p: *s32, value: s32) -> s32 { p[0] = value; return value }
ParserPost2 :: (p: **u8) -> *u8 { old := p[0]; p[0] = cast(*u8)(cast(usize)p[0] + size_of(u8)); return old }
ParserPost3 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] - 1; return old }
ParserSet4 :: (p: *u8, value: u8) -> u8 { p[0] = value; return value }
ParserPost5 :: (p: *usize) -> usize { old := p[0]; p[0] = p[0] + 1; return old }
ParserPre6 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] - 1; return p[0] }
ParserPre7 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] + 1; return p[0] }
ParserSet8 :: (p: *IR.ZirImport, value: IR.ZirImport) -> IR.ZirImport { p[0] = value; return value }
ParserPost9 :: (p: *usize) -> usize { old := p[0]; p[0] = p[0] - 1; return old }
ParserSet10 :: (p: *ZirInserts, value: ZirInserts) -> ZirInserts { p[0] = value; return value }
ParserSet11 :: (p: *usize, value: usize) -> usize { p[0] = value; return value }
ParserSet12 :: (p: **u8, value: *u8) -> *u8 { p[0] = value; return value }
ParserPost13 :: (p: **u8) -> *u8 { old := p[0]; p[0] = cast(*u8)(cast(usize)p[0] - size_of(u8)); return old }
ParserSet14 :: (p: *IR.ZirModule, value: IR.ZirModule) -> IR.ZirModule { p[0] = value; return value }
ParserPre15 :: (p: *usize) -> usize { old := p[0]; p[0] = p[0] - 1; return p[0] }

ParserText :: struct { data: *u8; length: usize }
// Borrow text from the descriptor returned by the existing compiler modules.
ParserTextView :: (text: string) -> ParserText { return (cast(*ParserText)*text)[0] }
ParserCString :: (text: string) -> *u8 { return ParserTextView(text).data }

#scope_file
compiler :: #system_library "ziran";
Destroy :: #type (memory: *void) #c_call;
CompilerContextScratch :: (key: *void, destroy: Destroy) -> *void #foreign compiler "CompilerContextScratch";
CompilerScratchTake :: (pool: *void) -> *void #foreign compiler "CompilerScratchTake";
CompilerScratchPut :: (pool: *void, memory: *void) -> s32 #foreign compiler "CompilerScratchPut";
CompilerMemoryRecovering :: () -> s32 #foreign compiler "CompilerMemoryRecovering";
CompilerFree :: (memory: *void) #foreign compiler "CompilerFree";
DestroyScratch :: (memory: *void) { CompilerFree(memory) }
AllocateOrExit :: (size: usize) -> *void #foreign compiler "AllocateOrExit";

#scope_export
ParserScratchTake :: (key: *u8, size: usize) -> *void {
    if CompilerMemoryRecovering() == 0 {
        pool := CompilerContextScratch(cast(*void)key, DestroyScratch)
        memory := CompilerScratchTake(pool)
        if memory != null { return memory }
    }
    return AllocateOrExit(size)
}

ParserScratchRelease :: (key: *u8, memory: *void) {
    if CompilerMemoryRecovering() == 0 {
        pool := CompilerContextScratch(cast(*void)key, DestroyScratch)
        if CompilerScratchPut(pool, memory) != 0 { return }
    }
    CompilerFree(memory)
}
