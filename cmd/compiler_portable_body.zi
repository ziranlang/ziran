// Eligibility for the shared typed-body emitters. The caller owns the type
// memo and expression states for the duration of the check.
IR :: #import "compiler_ir";

#scope_file
Native :: #import "compiler_native_names";
compiler :: #system_library "ziran";

CFindType :: (module: *IR.ZirModule, name: *u8, owner: **IR.ZirModule) -> *IR.ZirType #foreign compiler "FindType";
CArrayElement :: (name: *u8, element: *u8, capacity: usize, count: *s32) -> s32 #foreign compiler "ArrayElementType";
CSliceElement :: (name: *u8, element: *u8, capacity: usize) -> s32 #foreign compiler "SliceElementType";
CPrimitiveFields :: (record: *IR.ZirType) -> s32 #foreign compiler "TypeHasOnlyPrimitiveFields";
CNextField :: (record: *IR.ZirType, offset: *usize, field: **IR.ZirTypeField) -> s32 #foreign compiler "TypeNextFieldShared";
CParameters :: (text: *u8) -> *Parameters #foreign compiler "ParametersOf";
CProfileCount :: (counter: *u8) #foreign compiler "ProfileCount";
CMemoType :: (module: *IR.ZirModule, name: *u8) -> s32 #foreign compiler "MemoPortableBodyType";

// zir_text.h's parameter cache owns the strings and the flexible array.
Parameter :: struct {
    text: *u8
    name: *u8
    type: *u8
    binding_name: *u8
    value_type: *u8
    default_value: *u8
    is_using: s32
}
Parameters :: struct {
    count: s32
    items: [1]Parameter
}
StaticText :: struct { data: *u8; length: usize }

TypePath :: struct {
    record: *IR.ZirType
    parent: *TypePath
}

CName :: (text: string) -> *u8 { return (cast(*StaticText)(*text)).data }

OnPath :: (path: *TypePath, record: *IR.ZirType) -> bool {
    ancestor := path
    while ancestor != null {
        if ancestor.record == record { return true }
        ancestor = ancestor.parent
    }
    return false
}

PortableParameters :: (module: *IR.ZirModule, text: *u8, path: *TypePath, memo: bool) -> bool {
    if text == null || text[0] == 0 { return true }
    parameters := CParameters(text)
    items := cast(*Parameter)(*parameters.items[0])
    for i: cast(s32)0..parameters.count - 1 {
        type := items[i].type
        if type == null { return false }
        if memo {
            if CMemoType(module, type) == 0 { return false }
        } else if !PortableType(module, type, path) { return false }
    }
    return true
}

PortableType :: (module: *IR.ZirModule, type: *u8, path: *TypePath) -> bool {
    // Slice layouts can refer back to an enclosing record.
    element: [IR.ZIR_NAME_MAX]u8
    if CSliceElement(type, *element[0], IR.ZIR_NAME_MAX) != 0 {
        record := CFindType(module, *element[0], null)
        return record != null && OnPath(path, record) || PortableType(module, *element[0], path)
    }
    text := IR.CText(type)
    if text == "null" || Native.TargetType(cast(*void)type, .ZIR_C) != null { return true }
    for byte: text { if byte == #char "*" { return true } }
    if CArrayElement(type, *element[0], IR.ZIR_NAME_MAX, null) != 0 {
        return PortableType(module, *element[0], path)
    }
    owner: *IR.ZirModule
    record := CFindType(module, type, *owner)
    if record == null { return false }
    if record.foreign_target[0] != 0 || record.is_map != 0 || record.is_enum != 0 { return true }
    if record.is_procedure_type != 0 {
        if record.is_c_call != 0 { return true }
        return PortableParameters(owner, *record.body[0], path, false) &&
            PortableType(owner, *record.procedure_return_type[0], path)
    }
    if OnPath(path, record) { return false }
    if CPrimitiveFields(record) != 0 { return true }
    current := TypePath.{record, path}
    offset: usize = 0
    field: *IR.ZirTypeField
    count := 0
    status := CNextField(record, *offset, *field)
    while status == 1 {
        field_type := *field.type[0]
        if !PortableType(owner, field_type, *current) || IR.CText(field_type) == "void" { return false }
        count += 1
        status = CNextField(record, *offset, *field)
    }
    return status == 0 && count > 0
}

PortableExpression :: (module: *IR.ZirModule, fn: *IR.ZirFunction, index: s32, support: *u8) -> bool {
    if index < 0 { return true }
    if index >= fn.expr_count { return false }
    if support[index] != 0 {
        CProfileCount(CName("body_expression_reuse"))
        return support[index] == 2
    }
    // Mark the node before following edges so a malformed cycle fails.
    support[index] = 1
    CProfileCount(CName("body_expression_check"))
    expr := *fn.exprs[index]
    if CMemoType(module, expr.type) == 0 { return false }
    kind := expr.kind
    if kind == .COMPOUND {
        record := CFindType(module, expr.name, null)
        if (record == null || record.is_enum != 0 || record.is_procedure_type != 0) &&
            CArrayElement(expr.name, null, 0, null) == 0 { return false }
    } else if kind == .CAST {
        record := CFindType(module, expr.name, null)
        named := record != null && (record.is_enum != 0 || record.foreign_target[0] != 0 ||
            record.is_procedure_type != 0 && record.is_c_call != 0)
        if (expr.name == null || expr.name[0] != #char "*") &&
            Native.TargetType(cast(*void)expr.name, .ZIR_C) == null && !named { return false }
    } else if kind == .CALL {
        indirect := expr.name == null || expr.name[0] == 0
        if indirect && (expr.left < 0 || expr.left >= fn.expr_count || CMemoType(module, fn.exprs[expr.left].type) == 0) {
            return false
        }
    } else if cast(s32)kind <= cast(s32)IR.ZirExprKind.UNKNOWN || cast(s32)kind > cast(s32)IR.ZirExprKind.COMPILE_TIME {
        return false
    }
    if !PortableExpression(module, fn, expr.left, support) ||
        !PortableExpression(module, fn, expr.right, support) ||
        !PortableExpression(module, fn, expr.third, support) { return false }
    child := expr.first_child
    while child >= 0 {
        if !PortableExpression(module, fn, child, support) { return false }
        child = fn.exprs[child].next_sibling
    }
    support[index] = 2
    return true
}

PortableDestination :: (fn: *IR.ZirFunction, index: s32) -> bool {
    if index < 0 || index >= fn.expr_count { return false }
    lhs := *fn.exprs[index]
    return lhs.kind == .IDENT || lhs.kind == .MEMBER || lhs.kind == .POINTER_MEMBER ||
        lhs.kind == .INDEX || lhs.kind == .UNARY && IR.BufferText(lhs.op[:]) == "*"
}

#scope_export

#program_export "CanEmitTypeZiran"
CanEmitType :: (module: *IR.ZirModule, type: *u8) -> s32 {
    return ifx PortableType(module, type, null) then 1 else 0
}

#program_export "CanEmitBodyZiran"
CanEmitBody :: (module: *IR.ZirModule, fn: *IR.ZirFunction, support: *u8) -> s32 {
    if fn.checked == 0 || fn.is_extern != 0 || fn.expr_count < 0 ||
        CMemoType(module, *fn.return_type[0]) == 0 || !PortableParameters(module, fn.args_text, null, true) {
        return 0
    }
    for i: cast(s32)0..fn.stmt_count - 1 {
        statement := *fn.stmts[i]
        kind := statement.kind
        if kind == .DECL {
            if CMemoType(module, statement.type) == 0 { return 0 }
        } else if kind == .ASSIGN {
            if !PortableDestination(fn, statement.lhs_root) { return 0 }
        } else if kind != .IF && kind != .BLOCK_OPEN && kind != .BLOCK_CLOSE &&
            kind != .WHILE && kind != .RETURN && kind != .BREAK && kind != .CONTINUE &&
            kind != .UNUSED && kind != .EXPR && kind != .UNREACHABLE {
            return 0
        }
        if !PortableExpression(module, fn, statement.expr_root, support) ||
            !PortableExpression(module, fn, statement.lhs_root, support) { return 0 }
    }
    return 1
}
