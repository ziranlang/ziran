    SIMD_COMBINE :: 31
    SIMD_COUNT :: 32
}

SimdVector :: struct {
    name: *u8
    lane: *u8
    lanes: s32
    lane_bits: s32
    bytes: s32
    is_signed: s32
    is_float: s32
    is_native: s32
    block: *u8
}

SimdOp :: struct {
    id: s32
    name: *u8 #c "const char *"
    snake: *u8 #c "const char *"
    checked: *u8 #c "const char *"
    shape: SimdShape
    lanes: u32
    type_argument: s32
}

SimdOperand :: struct {
    type: *u8 #c "const char *"
    is_constant: s32
    value: s64
}

#scope_file

libc :: #system_library "libc";
compiler :: #system_library "ziran";

free :: (memory: *void) #foreign libc "free";
memcpy :: (dst: *void, src: *void, count: usize) -> *void #foreign libc "memcpy";
memset :: (dst: *void, value: s32, count: usize) -> *void #foreign libc "memset";
memcmp :: (a: *void, b: *void, count: usize) -> s32 #foreign libc "memcmp";
strlen :: (s: *u8) -> usize #foreign libc "strlen";
strcmp :: (a: *u8, b: *u8) -> s32 #foreign libc "strcmp";
strncmp :: (a: *u8, b: *u8, n: usize) -> s32 #foreign libc "strncmp";
strcpy :: (dst: *u8, src: *u8) -> *u8 #foreign libc "strcpy";
snprintf :: (out: *u8, size: usize, fmt: *u8, args: ..any) -> s32 #foreign libc "snprintf";

AllocateOrExit :: (size: usize) -> *void #foreign compiler "AllocateOrExit";
ScalarType :: (type: *u8) -> *u8 #foreign compiler "ScalarType";
ScalarWidthZiran :: (type: *void) -> u32 #foreign compiler "ScalarWidthZiran";
SliceElementType :: (type: *u8, element: *u8, size: usize) -> s32 #foreign compiler "SliceElementType";
ArrayElementType :: (type: *u8, element: *u8, size: usize, capacity: *s32) -> s32 #foreign compiler "ArrayElementType";
VectorType :: (type: *u8, vector: *SimdVector) -> s32 #foreign compiler "VectorType";
VectorTypeName :: (lane: *u8, lanes: s32) -> *u8 #foreign compiler "VectorTypeName";
NativeVectorName :: (lane: *u8) -> *u8 #foreign compiler "NativeVectorName";

StaticText :: struct { data: *u8; length: usize }
CStr :: (s: string) -> *u8 { return (cast(*StaticText)(*s)).data }
PtrAdd :: (base: *u8, offset: usize) -> *u8 { return cast(*u8)(cast(usize)base + offset) }

LANE_U8 :: 1
LANE_S8 :: 2
LANE_U16 :: 4
LANE_S16 :: 8
LANE_U32 :: 16
LANE_S32 :: 32
LANE_U64 :: 64
LANE_S64 :: 128
LANE_F32 :: 256
LANE_F64 :: 512
LANE_INT :: 255
LANE_FLOAT :: 768
LANE_ANY :: 1023
LANE_SMALL :: 15
LANE_NARROWABLE :: 63

OP_COUNT :: 68

g_ops: [OP_COUNT]SimdOp;

SimdInitializer :: #type () #c_call;
ZirSimdInitialize :: (initialize: SimdInitializer) #foreign compiler "ZirSimdInitialize";

SetOp :: (idx: s32, id: s32, name: string, snake: string, checked: string, shape: SimdShape, lanes: u32, typed: s32) {
    g_ops[idx].id = id
    g_ops[idx].name = CStr(name)
    g_ops[idx].snake = CStr(snake)
    g_ops[idx].checked = CStr(checked)
    g_ops[idx].shape = shape
    g_ops[idx].lanes = lanes
    g_ops[idx].type_argument = typed
}

InitializeOps :: () {
    i: s32 = 0
    SetOp(i, ZI_OP_ADD, "Add", "add", "zi_simd_add", .SIMD_BINARY, LANE_ANY, 0); i += 1
    SetOp(i, ZI_OP_SUB, "Sub", "sub", "zi_simd_sub", .SIMD_BINARY, LANE_ANY, 0); i += 1
    SetOp(i, ZI_OP_MUL, "Mul", "mul", "zi_simd_mul", .SIMD_BINARY, LANE_ANY, 0); i += 1
    SetOp(i, ZI_OP_DIV, "Div", "div", "zi_simd_div", .SIMD_BINARY, LANE_FLOAT, 0); i += 1
    SetOp(i, ZI_OP_ADD_SAT, "AddSat", "add_sat", "zi_simd_add_sat", .SIMD_BINARY, LANE_SMALL, 0); i += 1
    SetOp(i, ZI_OP_SUB_SAT, "SubSat", "sub_sat", "zi_simd_sub_sat", .SIMD_BINARY, LANE_SMALL, 0); i += 1
    SetOp(i, ZI_OP_MIN, "Min", "min", "zi_simd_min", .SIMD_BINARY, LANE_ANY, 0); i += 1
    SetOp(i, ZI_OP_MAX, "Max", "max", "zi_simd_max", .SIMD_BINARY, LANE_ANY, 0); i += 1
    SetOp(i, ZI_OP_AVG, "Average", "avg", "zi_simd_avg", .SIMD_BINARY, LANE_U8 | LANE_U16, 0); i += 1
    SetOp(i, ZI_OP_MUL_HIGH, "MulHigh", "mul_high", "zi_simd_mul_high", .SIMD_BINARY, LANE_U16 | LANE_S16, 0); i += 1
    SetOp(i, ZI_OP_MUL_HIGH_ROUND, "MulHighRound", "mul_high_round", "zi_simd_mul_high_round", .SIMD_BINARY, LANE_S16, 0); i += 1
    SetOp(i, ZI_OP_AND, "And", "and", "zi_simd_and", .SIMD_BINARY, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_OR, "Or", "or", "zi_simd_or", .SIMD_BINARY, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_XOR, "Xor", "xor", "zi_simd_xor", .SIMD_BINARY, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_AND_NOT, "AndNot", "and_not", "zi_simd_and_not", .SIMD_BINARY, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_NOT, "Not", "not", "zi_simd_not", .SIMD_UNARY, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_ABS, "Abs", "abs", "zi_simd_abs", .SIMD_UNARY, LANE_S8 | LANE_S16 | LANE_S32 | LANE_S64 | LANE_FLOAT, 0); i += 1
    SetOp(i, ZI_OP_NEG, "Neg", "neg", "zi_simd_neg", .SIMD_UNARY, LANE_ANY, 0); i += 1
    SetOp(i, ZI_OP_SIGN, "Sign", "sign", "zi_simd_sign", .SIMD_BINARY, LANE_S8 | LANE_S16 | LANE_S32 | LANE_S64, 0); i += 1
    SetOp(i, ZI_OP_ABS_DIFF, "AbsDiff", "abs_diff", "zi_simd_abs_diff", .SIMD_BINARY, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_EQ, "Equal", "eq", "zi_simd_eq", .SIMD_COMPARE, LANE_ANY, 0); i += 1
    SetOp(i, ZI_OP_LT, "Less", "lt", "zi_simd_lt", .SIMD_COMPARE, LANE_ANY, 0); i += 1
    SetOp(i, ZI_OP_GT, "Greater", "gt", "zi_simd_gt", .SIMD_COMPARE, LANE_ANY, 0); i += 1
    SetOp(i, ZI_OP_SELECT, "Select", "select", "zi_simd_select", .SIMD_SELECT, LANE_ANY, 0); i += 1
    SetOp(i, ZI_OP_SHL, "ShiftLeft", "shl", "zi_simd_shl", .SIMD_SHIFT, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_SHR, "ShiftRight", "shr", "zi_simd_shr", .SIMD_SHIFT, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_SHR_ROUND, "ShiftRightRound", "shr_round", "zi_simd_shr_round", .SIMD_SHIFT, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_SHL_LANES, "ShiftLeftLanes", "shl_lanes", "zi_simd_shl_lanes", .SIMD_SHIFT_LANES, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_SHR_LANES, "ShiftRightLanes", "shr_lanes", "zi_simd_shr_lanes", .SIMD_SHIFT_LANES, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_SHL_BYTES, "ShiftBytesLeft", "shl_bytes", "zi_simd_shl_bytes", .SIMD_BYTE_SHIFT, LANE_INT, 0); i += 1
