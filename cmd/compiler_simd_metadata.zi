    SetOp(i, ZI_OP_ALL_ZERO, "AllZero", "all_zero", "zi_simd_all_zero", .SIMD_ALL_ZERO, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_BYTE_SHUFFLE, "ByteShuffle", "byte_shuffle", "zi_simd_byte_shuffle", .SIMD_BYTE_SHUFFLE, LANE_U8 | LANE_S8, 0); i += 1
