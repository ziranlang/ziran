SIMD_MEMORY_SLICE :: 1
SIMD_MEMORY_ARRAY :: 2
SIMD_MEMORY_POINTER :: 3
SIMD_MEMORY_STRING :: 4

SimdShape :: enum s32 {
    SIMD_BINARY :: 0
    SIMD_UNARY :: 1
    SIMD_COMPARE :: 2
    SIMD_SELECT :: 3
    SIMD_SHIFT :: 4
    SIMD_SHIFT_LANES :: 5
    SIMD_BYTE_SHIFT :: 6
    SIMD_ALIGN :: 7
    SIMD_MAKE :: 8
    SIMD_SPLAT :: 9
    SIMD_ZERO :: 10
    SIMD_LANE :: 11
    SIMD_WITH_LANE :: 12
    SIMD_LOAD :: 13
    SIMD_STORE :: 14
    SIMD_GATHER :: 15
    SIMD_WIDEN_HALF :: 16
    SIMD_WIDEN :: 17
    SIMD_NARROW :: 18
    SIMD_MUL_WIDE :: 19
    SIMD_MADD :: 20
    SIMD_MADD_SAT :: 21
    SIMD_ADD_PAIRS :: 22
    SIMD_SAD :: 23
    SIMD_REDUCE :: 24
    SIMD_ALL_ZERO :: 25
    SIMD_BYTE_SHUFFLE :: 26
    SIMD_SHUFFLE :: 27
    SIMD_REINTERPRET :: 28
