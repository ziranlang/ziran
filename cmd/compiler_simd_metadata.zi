// SIMD vector operations: names, signatures, constants, and helper-name tables.
using IR :: #import "compiler_ir"
Scalar :: #import "compiler_scalar"
using Runtime :: #import "compiler_runtime_emit"

#scope_export

ZI_K_U8 :: 0
ZI_K_S8 :: 1
ZI_K_U16 :: 2
