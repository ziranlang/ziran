    SetOp(i, ZI_OP_ALIGN_BYTES, "AlignBytes", "align_bytes", "zi_simd_align_bytes", .SIMD_ALIGN, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_MAKE, "Make", "make", "zi_simd_make", .SIMD_MAKE, LANE_ANY, 1); i += 1
    SetOp(i, ZI_OP_SPLAT, "Splat", "splat", "zi_simd_splat", .SIMD_SPLAT, LANE_ANY, 1); i += 1
    SetOp(i, ZI_OP_ZERO, "Zero", "zero", "zi_simd_zero", .SIMD_ZERO, LANE_ANY, 1); i += 1
    SetOp(i, ZI_OP_LANE, "Lane", "lane", "zi_simd_lane", .SIMD_LANE, LANE_ANY, 0); i += 1
    SetOp(i, ZI_OP_WITH_LANE, "WithLane", "with_lane", "zi_simd_with_lane", .SIMD_WITH_LANE, LANE_ANY, 0); i += 1
