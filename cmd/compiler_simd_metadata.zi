    SetOp(i, ZI_OP_REDUCE_MIN, "ReduceMin", "reduce_min", "zi_simd_reduce_min", .SIMD_REDUCE, LANE_INT, 0); i += 1
    SetOp(i, ZI_OP_REDUCE_MAX, "ReduceMax", "reduce_max", "zi_simd_reduce_max", .SIMD_REDUCE, LANE_INT, 0); i += 1
