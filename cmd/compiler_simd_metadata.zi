#scope_export

#program_export "SimdLaneKind"
SimdLaneKind :: (vector: *SimdVector) -> s32 {
    if strcmp(vector.lane, CStr("u8")) == 0 { return 0 }
    if strcmp(vector.lane, CStr("s8")) == 0 { return 1 }
    if strcmp(vector.lane, CStr("u16")) == 0 { return 2 }
    if strcmp(vector.lane, CStr("s16")) == 0 { return 3 }
    if strcmp(vector.lane, CStr("u32")) == 0 { return 4 }
    if strcmp(vector.lane, CStr("s32")) == 0 { return 5 }
    if strcmp(vector.lane, CStr("u64")) == 0 { return 6 }
    if strcmp(vector.lane, CStr("s64")) == 0 { return 7 }
    if strcmp(vector.lane, CStr("float32")) == 0 { return 8 }
    if strcmp(vector.lane, CStr("float64")) == 0 { return 9 }
    return -1
}

#program_export "SimdOpAt"
SimdOpAt :: (index: s32) -> *SimdOp {
    if index < 0 || index >= OP_COUNT { return null }
    ZirSimdInitialize(InitializeOps)
    return *g_ops[index]
}

#program_export "SimdOpNamed"
SimdOpNamed :: (name: *u8) -> *SimdOp {
    if name == null { return null }
    ZirSimdInitialize(InitializeOps)
    for i: cast(s32)0..OP_COUNT - 1 {
        if strcmp(name, g_ops[i].name) == 0 { return *g_ops[i] }
    }
    return null
}

#program_export "SimdOpChecked"
SimdOpChecked :: (name: *u8) -> *SimdOp {
    if name == null || strncmp(name, CStr("zi_simd_"), 8) != 0 { return null }
    ZirSimdInitialize(InitializeOps)
    rest := PtrAdd(name, 8)
    for i: cast(s32)0..OP_COUNT - 1 {
        if g_ops[i].snake[0] == rest[0] && strcmp(rest, g_ops[i].snake) == 0 {
            return *g_ops[i]
        }
    }
    return null
}

#program_export "SimdModule"
SimdModule :: (module: *IR.ZirModule) -> s32 {
    return ifx module != null && strcmp(*module.standard_name[0], CStr("simd")) == 0 then 1 else 0
}

#program_export "SimdBlockLanes"
SimdBlockLanes :: (vector: *SimdVector) -> s32 {
    return ifx vector.bytes > 16 then vector.lanes / 2 else vector.lanes
}

#program_export "SimdNativeHelper"
SimdNativeHelper :: (op: *SimdOp) -> s32 {
    id := op.id
    if id == ZI_OP_WIDEN_LOW || id == ZI_OP_WIDEN_HIGH || id == ZI_OP_MUL_WIDE_LOW ||
       id == ZI_OP_MUL_WIDE_HIGH || id == ZI_OP_NARROW || id == ZI_OP_MAKE ||
       id == ZI_OP_LOAD_LOW || id == ZI_OP_STORE_LOW {
        return 1
    }
    return 0
}

#program_export "SimdMemory"
SimdMemory :: (type: *u8, element: *u8, size: usize, capacity: *s32) -> s32 {
    inner: [IR.ZIR_NAME_MAX]u8
    kind: s32 = SIMD_MEMORY_NONE
    count: s32 = -1
    if type == null { return 0 }
    if strcmp(ScalarType(type), CStr("string")) == 0 {
        kind = SIMD_MEMORY_STRING
        strcpy(*inner[0], CStr("u8"))
    } else if SliceElementType(type, *inner[0], IR.ZIR_NAME_MAX) != 0 {
        kind = SIMD_MEMORY_SLICE
    } else if ArrayElementType(type, *inner[0], IR.ZIR_NAME_MAX, *count) != 0 {
        kind = SIMD_MEMORY_ARRAY
    } else if type[0] == #char "*" && strlen(PtrAdd(type, 1)) < IR.ZIR_NAME_MAX {
        kind = SIMD_MEMORY_POINTER
        strcpy(*inner[0], PtrAdd(type, 1))
    } else {
        return SIMD_MEMORY_NONE
    }
    scalar := ScalarType(*inner[0])
    if element != null {
        snprintf(element, size, CStr("%s"), ifx scalar[0] != 0 then scalar else *inner[0])
    }
    if capacity != null { capacity.* = count }
    return kind
}

#scope_file

IntegerScalar :: (type: *u8) -> bool {
    if strcmp(type, CStr("integer")) == 0 { return true }
    scalar := ScalarType(type)
    return ScalarWidthZiran(cast(*void)scalar) > 0 ||
           strcmp(scalar, CStr("isize")) == 0 || strcmp(scalar, CStr("usize")) == 0
}

LaneOperand :: (vector: *SimdVector, operand: *SimdOperand) -> bool {
    type := operand.type
    scalar := ScalarType(type)
    if vector.is_float != 0 {
        return strcmp(type, CStr("real")) == 0 || strcmp(type, CStr("integer")) == 0 ||
               strcmp(scalar, vector.lane) == 0 ||
               (strcmp(scalar, CStr("float32")) == 0 && strcmp(vector.lane, CStr("float64")) == 0)
    }
    if strcmp(type, CStr("integer")) == 0 {
        if operand.is_constant == 0 { return true }
        if vector.lane_bits == 64 { return vector.is_signed != 0 || operand.value >= 0 }
        high := ifx vector.is_signed != 0 then (cast(s64)1 << (vector.lane_bits - 1)) - 1 else (cast(s64)1 << vector.lane_bits) - 1
        low := ifx vector.is_signed != 0 then -high - 1 else cast(s64)0
        return operand.value >= low && operand.value <= high
    }
    w: u32 = ifx scalar[0] != 0 then ScalarWidthZiran(cast(*void)scalar) else 0
    if w == 0 { return false }
    if strcmp(scalar, vector.lane) == 0 { return true }
    return cast(s32)w < vector.lane_bits && (scalar[0] == #char "u" || vector.is_signed != 0)
}

Wider :: (vector: *SimdVector, lanes: s32) -> *u8 {
    lane: [8]u8
    ch: s32 = ifx vector.is_signed != 0 then #char "s" else #char "u"
    snprintf(*lane[0], 8, CStr("%c%d"), ch, vector.lane_bits * 2)
    return VectorTypeName(*lane[0], lanes)
}

VectorOf :: (op: *SimdOp, operand: *SimdOperand, vector: *SimdVector) -> bool {
    if VectorType(operand.type, vector) == 0 { return false }
    kind := SimdLaneKind(vector)
    return kind >= 0 && (op.lanes & (cast(u32)1 << cast(u32)kind)) != 0
}

Fail :: (message: **u8, text: string) -> *u8 {
    message.* = CStr(text)
    return null
}

Signature :: (op: *SimdOp, result: *u8, operands: *SimdOperand, count: s32, message: **u8) -> *u8 {
    a: SimdVector
    b: SimdVector
    r: SimdVector
    element: [IR.ZIR_NAME_MAX]u8
    unsupported := "does not take this vector type"
    message.* = CStr("")
    if op.type_argument != 0 && op.shape != .SIMD_COUNT && (result == null || VectorType(result, *r) == 0) {
        return Fail(message, "takes a vector type first, such as s16x8")
    }
    if op.shape == .SIMD_BINARY || op.shape == .SIMD_COMPARE {
        if count != 2 { return Fail(message, "takes two vectors of one type") }
        if !VectorOf(op, *operands[0], *a) { return Fail(message, unsupported) }
        if strcmp(operands[0].type, operands[1].type) != 0 {
            return Fail(message, "takes two vectors of one type")
        }
        if (op.shape == .SIMD_COMPARE && a.is_float != 0) || op.id == ZI_OP_ABS_DIFF {
            lane: [8]u8
            snprintf(*lane[0], 8, CStr("u%d"), a.lane_bits)
            return VectorTypeName(*lane[0], a.lanes)
        }
        return a.name
    }
    if op.shape == .SIMD_UNARY {
        if count != 1 { return Fail(message, "takes one vector") }
        if !VectorOf(op, *operands[0], *a) { return Fail(message, unsupported) }
        return a.name
    }
    if op.shape == .SIMD_SELECT {
        if count != 3 { return Fail(message, "takes a mask and two vectors of one type") }
        if VectorType(operands[0].type, *b) == 0 || b.is_float != 0 ||
           !VectorOf(op, *operands[1], *a) || strcmp(operands[1].type, operands[2].type) != 0 ||
           b.lanes != a.lanes || b.lane_bits != a.lane_bits {
            return Fail(message, "takes an integer mask with the vectors' lane width, then two vectors of one type")
        }
        return a.name
    }
    if op.shape == .SIMD_SHIFT {
        if count != 2 || !VectorOf(op, *operands[0], *a) || !IntegerScalar(operands[1].type) {
            return Fail(message, "takes an integer vector and an integer count")
        }
        return a.name
    }
    if op.shape == .SIMD_SHIFT_LANES {
        if count != 2 || !VectorOf(op, *operands[0], *a) || strcmp(operands[0].type, operands[1].type) != 0 {
            return Fail(message, "takes an integer vector and a vector of counts of the same type")
        }
        return a.name
    }
    if op.shape == .SIMD_BYTE_SHIFT {
        if count != 2 || !VectorOf(op, *operands[0], *a) {
            return Fail(message, "takes an integer vector and a constant byte count")
        }
        if operands[1].is_constant == 0 || operands[1].value < 0 || operands[1].value > 16 {
            return Fail(message, "takes a constant byte count from 0 to 16")
        }
        return a.name
    }
    if op.shape == .SIMD_ALIGN {
        if count != 3 || !VectorOf(op, *operands[0], *a) || strcmp(operands[0].type, operands[1].type) != 0 {
            return Fail(message, "takes two integer vectors of one type and a constant byte count")
        }
        if operands[2].is_constant == 0 || operands[2].value < 0 || operands[2].value > 16 {
            return Fail(message, "takes a constant byte count from 0 to 16")
        }
        return a.name
    }
    if op.shape == .SIMD_MAKE {
        kind := SimdLaneKind(*r)
        if (op.lanes & (cast(u32)1 << cast(u32)kind)) == 0 { return Fail(message, unsupported) }
        if count != r.lanes { return Fail(message, "takes the vector type and one value for each lane") }
        for i: cast(s32)0..count - 1 {
            if !LaneOperand(*r, *operands[i]) { return Fail(message, "takes lane values of the vector's lane type") }
        }
        return r.name
    }
    if op.shape == .SIMD_SPLAT {
        if count != 1 || !LaneOperand(*r, *operands[0]) {
            return Fail(message, "takes the vector type and one value of its lane type")
        }
        return r.name
    }
    if op.shape == .SIMD_ZERO {
        if count != 0 { return Fail(message, "takes only the vector type") }
        return r.name
    }
    if op.shape == .SIMD_LANE {
        if count != 2 || !VectorOf(op, *operands[0], *a) {
            return Fail(message, "takes a vector and a constant lane index")
        }
        if operands[1].is_constant == 0 || operands[1].value < 0 || operands[1].value >= cast(s64)a.lanes {
            return Fail(message, "takes a constant lane index below the lane count")
        }
        return a.lane
    }
    if op.shape == .SIMD_WITH_LANE {
        if count != 3 || !VectorOf(op, *operands[0], *a) {
            return Fail(message, "takes a vector, a constant lane index and a lane value")
        }
        if operands[1].is_constant == 0 || operands[1].value < 0 || operands[1].value >= cast(s64)a.lanes {
            return Fail(message, "takes a constant lane index below the lane count")
        }
        if !LaneOperand(*a, *operands[2]) { return Fail(message, "takes a lane value of the vector's lane type") }
        return a.name
    }
    if op.shape == .SIMD_LOAD {
        if count != 2 || SimdMemory(operands[0].type, *element[0], IR.ZIR_NAME_MAX, null) == 0 ||
           strcmp(*element[0], r.lane) != 0 || !IntegerScalar(operands[1].type) {
            return Fail(message, "takes the vector type, a slice, array or pointer of its lane type (or a string for u8 lanes), and an index")
        }
        return r.name
    }
    if op.shape == .SIMD_STORE {
        memory: s32 = ifx count == 3 then SimdMemory(operands[0].type, *element[0], IR.ZIR_NAME_MAX, null) else 0
        if (memory != SIMD_MEMORY_SLICE && memory != SIMD_MEMORY_POINTER) ||
           !IntegerScalar(operands[1].type) || VectorType(operands[2].type, *a) == 0 ||
           strcmp(*element[0], a.lane) != 0 {
            return Fail(message, "takes a slice or pointer of the vector's lane type, an index and the vector")
        }
        return CStr("void")
    }
    if op.shape == .SIMD_GATHER {
        if count != 2 || SimdMemory(operands[0].type, *element[0], IR.ZIR_NAME_MAX, null) == 0 ||
           !VectorOf(op, *operands[1], *a) || a.lane_bits != 32 ||
           (strcmp(*element[0], CStr("s32")) != 0 && strcmp(*element[0], CStr("u32")) != 0 && strcmp(*element[0], CStr("float32")) != 0) {
            return Fail(message, "takes a table of s32, u32 or float32 and a vector of s32 or u32 indices")
        }
        return VectorTypeName(*element[0], a.lanes)
    }
    if op.shape == .SIMD_WIDEN_HALF || op.shape == .SIMD_MUL_WIDE || op.shape == .SIMD_ADD_PAIRS {
        need: s32 = ifx op.shape == .SIMD_MUL_WIDE then 2 else 1
        if count != need || !VectorOf(op, *operands[0], *a) ||
           (count == 2 && strcmp(operands[0].type, operands[1].type) != 0) {
            msg := ifx op.shape == .SIMD_MUL_WIDE then "takes two integer vectors of one type with lanes up to 32 bits" else "takes an integer vector with lanes up to 32 bits"
            return Fail(message, msg)
        }
        return Wider(*a, a.lanes / 2)
    }
    if op.shape == .SIMD_WIDEN {
        if count != 1 || !VectorOf(op, *operands[0], *a) || a.bytes != 16 {
            return Fail(message, "takes a 128-bit integer vector with lanes up to 32 bits")
        }
        return Wider(*a, a.lanes)
    }
    if op.shape == .SIMD_NARROW {
        if count != 2 || !VectorOf(op, *operands[0], *a) || strcmp(operands[0].type, operands[1].type) != 0 ||
           r.is_float != 0 || r.lane_bits * 2 != a.lane_bits || r.lanes != a.lanes * 2 {
            return Fail(message, "takes the narrower result type and two integer vectors of one type")
        }
        return r.name
    }
    if op.shape == .SIMD_MADD {
        if count != 2 || !VectorOf(op, *operands[0], *a) || strcmp(operands[0].type, operands[1].type) != 0 {
            return Fail(message, "takes two s16 vectors of one type")
        }
        return VectorTypeName(CStr("s32"), a.lanes / 2)
    }
    if op.shape == .SIMD_MADD_SAT {
        if count != 2 || !VectorOf(op, *operands[0], *a) || VectorType(operands[1].type, *b) == 0 ||
           strcmp(b.lane, CStr("s8")) != 0 || b.lanes != a.lanes {
            return Fail(message, "takes a u8 vector and an s8 vector of the same width")
        }
        return VectorTypeName(CStr("s16"), a.lanes / 2)
    }
    if op.shape == .SIMD_SAD {
        if count != 2 || !VectorOf(op, *operands[0], *a) || strcmp(operands[0].type, operands[1].type) != 0 {
            return Fail(message, "takes two u8 vectors of one type")
        }
        return VectorTypeName(CStr("u64"), a.lanes / 8)
    }
    if op.shape == .SIMD_REDUCE {
        if count != 1 || !VectorOf(op, *operands[0], *a) { return Fail(message, "takes one integer vector") }
        return ifx op.id == ZI_OP_REDUCE_MAX_INDEX then CStr("s64") else a.lane
    }
    if op.shape == .SIMD_ALL_ZERO {
        if count != 1 || !VectorOf(op, *operands[0], *a) { return Fail(message, "takes one integer vector") }
        return CStr("bool")
    }
    if op.shape == .SIMD_BYTE_SHUFFLE {
        if count != 2 || !VectorOf(op, *operands[0], *a) || VectorType(operands[1].type, *b) == 0 ||
           strcmp(b.lane, CStr("u8")) != 0 || b.lanes != a.lanes {
            return Fail(message, "takes a u8 or s8 table and u8 indices of the same width")
        }
        return a.name
    }
    if op.shape == .SIMD_SHUFFLE {
        if count < 1 || !VectorOf(op, *operands[0], *a) { return Fail(message, "takes a vector and constant lane indices") }
        block := SimdBlockLanes(*a)
        if count != block + 1 { return Fail(message, "takes one constant index for each lane of a 128-bit block") }
        for i: cast(s32)1..count - 1 {
            if operands[i].is_constant == 0 || operands[i].value < 0 || operands[i].value >= cast(s64)block {
                return Fail(message, "takes constant lane indices within one 128-bit block")
            }
        }
        return a.name
    }
    if op.shape == .SIMD_REINTERPRET {
        if count != 1 || VectorType(operands[0].type, *a) == 0 || a.bytes != r.bytes {
            return Fail(message, "takes the result type and a vector of the same width")
        }
        return r.name
    }
    if op.shape == .SIMD_CONVERT {
        if count != 1 || VectorType(operands[0].type, *a) == 0 || a.lanes != r.lanes ||
           a.lane_bits != r.lane_bits || a.is_float == r.is_float {
            return Fail(message, "converts between integer and float lanes of the same width")
        }
        return r.name
    }
    if op.shape == .SIMD_HALF {
        if count != 1 || !VectorOf(op, *operands[0], *a) || a.bytes != 32 {
            return Fail(message, "takes one 256-bit vector")
        }
        return VectorTypeName(a.lane, a.lanes / 2)
    }
    if op.shape == .SIMD_COMBINE {
        if count != 2 || !VectorOf(op, *operands[0], *a) || a.bytes != 16 ||
           strcmp(operands[0].type, operands[1].type) != 0 {
            return Fail(message, "takes two 128-bit vectors of one type")
        }
        return VectorTypeName(a.lane, a.lanes * 2)
    }
    if op.shape == .SIMD_COUNT {
        need: s32 = ifx op.id == ZI_OP_LANES then 1 else 0
        if count != need || (count == 1 && (operands[0].is_constant == 0 || operands[0].value < 1 || operands[0].value > 16)) {
            return Fail(message, "takes one vector type, such as s16xN")
        }
        return CStr("s64")
    }
    return Fail(message, unsupported)
}

#scope_export

#program_export "SimdSignature"
SimdSignature :: (op: *SimdOp, result: *u8, operands: *SimdOperand, count: s32, message: **u8) -> *u8 {
    vector: SimdVector
    vectors: s32 = 0
    natives: s32 = 0
    if op.shape != .SIMD_COUNT && result != null && VectorType(result, *vector) != 0 {
        vectors += 1
        natives += vector.is_native
    }
    for i: cast(s32)0..count - 1 {
        if VectorType(operands[i].type, *vector) != 0 {
            vectors += 1
            natives += vector.is_native
        }
    }
    if natives == 0 {
        return Signature(op, result, operands, count, message)
    }
    message.* = CStr("")
    if natives != vectors {
        return Fail(message, "takes native vectors, such as s16xN, only with other native vectors")
    }
    if op.shape == .SIMD_LANE || op.shape == .SIMD_WITH_LANE || op.shape == .SIMD_WIDEN ||
       op.shape == .SIMD_HALF || op.shape == .SIMD_COMBINE {
        return Fail(message, "does not take native vectors, whose lane count the instruction set picks")
    }
    blocks: [40]SimdOperand
    if count > 40 { return Fail(message, "takes too many operands") }
    for i: cast(s32)0..count - 1 {
        blocks[i] = operands[i]
        if VectorType(operands[i].type, *vector) != 0 { blocks[i].type = vector.block }
    }
    res := result
    if res != null && VectorType(res, *vector) != 0 { res = vector.block }
    type := Signature(op, res, *blocks[0], count, message)
    if type == null || VectorType(type, *vector) == 0 { return type }
    return NativeVectorName(vector.lane)
}

#scope_file

Grown :: (items: *void, used: usize, size: usize) -> *void {
    bigger := AllocateOrExit(size)
    if used != 0 { memcpy(bigger, items, used) }
    free(items)
    return bigger
}

NameHash :: (name: *u8, length: usize) -> usize {
    hash: u64 = 1469598103934665603
    i: usize = 0
    while i < length {
        hash = (hash ^ cast(u64)name[i]) * 1099511628211
        i += 1
    }
    return cast(usize)(hash ^ (hash >> 32))
}

#scope_export

#program_export "SimdNamesFind"
SimdNamesFind :: (names: *SimdNames, name: *u8, length: usize, add: s32) -> s64 {
    if add != 0 && (names.count + 1) * 2 > names.slot_count {
        slot_count := ifx names.slot_count != 0 then names.slot_count * 2 else cast(usize)256
        slots := cast(*usize)AllocateOrExit(slot_count * size_of(usize))
        memset(cast(*void)slots, 0, slot_count * size_of(usize))
        i: usize = 0
        while i < names.count {
            at := NameHash(cast(*u8)names.text[i], names.length[i]) & (slot_count - 1)
            while slots[at] != 0 { at = (at + 1) & (slot_count - 1) }
            slots[at] = i + 1
            i += 1
        }
        free(cast(*void)names.slots)
        names.slots = slots
        names.slot_count = slot_count
    }
    if names.slot_count == 0 { return -1 }
    mask := names.slot_count - 1
    at := NameHash(name, length) & mask
    while true {
        slot := names.slots[at]
        if slot != 0 {
            if names.length[slot - 1] == length && memcmp(cast(*void)names.text[slot - 1], cast(*void)name, length) == 0 {
                return cast(s64)(slot - 1)
            }
            at = (at + 1) & mask
            continue
        }
        if add == 0 { return -1 }
        if names.count == names.capacity {
            capacity := ifx names.capacity != 0 then names.capacity * 2 else cast(usize)64
            names.text = cast(**u8)Grown(cast(*void)names.text, names.count * size_of(*u8), capacity * size_of(*u8))
            names.length = cast(*usize)Grown(cast(*void)names.length, names.count * size_of(usize), capacity * size_of(usize))
            names.capacity = capacity
        }
        entries := cast(**u8)names.text
        entries[names.count] = name
        names.length[names.count] = length
        names.count += 1
        names.slots[at] = names.count
        return cast(s64)(names.count - 1)
    }
    return -1
}

#program_export "SimdNamesFree"
SimdNamesFree :: (names: *SimdNames) {
    free(cast(*void)names.text)
    free(cast(*void)names.length)
    free(cast(*void)names.slots)
    memset(cast(*void)names, 0, size_of(SimdNames))
}

#program_export "SimdHelperWord"
SimdHelperWord :: (word: **u8, length: *usize) -> s32 {
    if length.* <= 3 || memcmp(cast(*void)word.*, cast(*void)CStr("zi_"), 3) != 0 { return 0 }
    word.* = PtrAdd(word.*, 3)
    length.* -= 3
    if length.* > 6 && memcmp(cast(*void)word.*, cast(*void)CStr("ssse3_"), 6) == 0 {
        word.* = PtrAdd(word.*, 6)
        length.* -= 6
    } else if length.* > 6 && memcmp(cast(*void)word.*, cast(*void)CStr("sse41_"), 6) == 0 {
        word.* = PtrAdd(word.*, 6)
        length.* -= 6
    } else if length.* > 5 && memcmp(cast(*void)word.*, cast(*void)CStr("avx2_"), 5) == 0 {
        word.* = PtrAdd(word.*, 5)
        length.* -= 5
    }
    if length.* > 3 && memcmp(cast(*void)PtrAdd(word.*, length.* - 3), cast(*void)CStr("_p_"), 3) == 0 {
        length.* -= 3
    }
    return 1
}

#program_export "SimdUsesNote"
SimdUsesNote :: (uses: *ZirSimdUses, word: *u8, length: usize) {
    w := word
    l := length
    if SimdHelperWord(*w, *l) == 0 || SimdNamesFind(*uses.names, w, l, 0) >= 0 { return }
    copy := cast(*u8)AllocateOrExit(l + 1)
    memcpy(cast(*void)copy, cast(*void)w, l)
    copy[l] = 0
    SimdNamesFind(*uses.names, copy, l, 1)
}

#program_export "SimdUsesFree"
SimdUsesFree :: (uses: *ZirSimdUses) {
    i: usize = 0
    while i < uses.names.count {
        free(cast(*void)uses.names.text[i])
        i += 1
    }
    SimdNamesFree(*uses.names)
    uses.header = 0
}
