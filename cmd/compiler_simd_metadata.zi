    SetOp(i, ZI_OP_MUL_WIDE_HIGH, "MulWideHigh", "mul_wide_high", "zi_simd_mul_wide_high", .SIMD_MUL_WIDE, LANE_NARROWABLE, 0); i += 1
    SetOp(i, ZI_OP_MADD, "MulAddPairs", "madd", "zi_simd_madd", .SIMD_MADD, LANE_S16, 0); i += 1
