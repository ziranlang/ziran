// Type spelling and record-field rules. Record fields borrow the input.
// Field scans accept bounded, zero-terminated IR buffers without measuring
// the whole record again for each field.
Text :: #import "compiler_text";

RecordField :: struct {
    status: s32
    next: s64
    name: string
    type: string
    tag: string
    c_type: string
    is_using: bool
}
ElementType :: struct { valid: bool; element: string; capacity: s64 }
ForeignCall :: struct { kind: s32; module: string; receiver: string; symbol: string }

TargetKnown :: (target: string) -> bool {
    return target == "c" || target == "go" || target == "zx"
}

// Empty means an ordinary language type. Foreign identities belong to the
// target that defines their representation, even when unused by an entry.
ForeignTypeTarget :: (foreign: string, is_map: bool) -> string {
    if is_map || (foreign.count >= 3 && foreign[0:3] == "go:") { return "go" }
    if foreign.count > 0 { return "unknown" }
    return ""
}

ForeignImportSupported :: (target: string, foreign: string) -> bool {
    if !TargetKnown(target) { return false }
    if foreign == "go" { return target == foreign }
    if foreign == "host" { return true }
    if foreign == "c" { return target != "zx" }
    return false
}

ProcedureTypeSupported :: (target: string, c_call: bool) -> bool {
    return TargetKnown(target) && (!c_call || (target != "go" && target != "zx"))
}

ScalarByteWidth :: (type: string) -> s32 {
    if type == "s8" || type == "u8" || type == "bool" { return 1 }
    if type == "s16" || type == "u16" { return 2 }
    if type == "s32" || type == "u32" || type == "float32" { return 4 }
    if type == "s64" || type == "u64" || type == "float64" || type == "integer" { return 8 }
    return 0
}

// The spelling of a whole `#c "SPELLING"` directive: the C type of a field,
// or the prefix of an enum's C constants. Identifier bytes, spaces and `*`
// only; empty for anything else.
CSpelling :: (directive: string) -> string {
    if directive.count < 6 || directive[0:2] != "#c" || !Text.SpaceByte(directive[2]) { return "" }
    literal := Trim(directive[3:])
    if literal.count < 3 || literal[0] != #char "\"" || literal[literal.count - 1] != #char "\"" { return "" }
    spelling := literal[1:literal.count - 1]
    for byte: spelling {
        if !Text.IdentifierByte(byte) && byte != #char " " && byte != #char "*" { return "" }
    }
    return spelling
}

NextField :: (body: string, at: s64, union_record: bool, name_limit: s64,
    type_limit: s64, tag_workspace: []u8) -> RecordField {
    result: RecordField
    result.status = -1
    result.next = at
    if at < 0 || at > body.count { return result }
    while Byte(body, at) != 0 {
        end := at
        quote := false
        while Byte(body, end) != 0 {
            byte := body[end]
            if quote {
                if byte == #char "\\" && Byte(body, end + 1) != 0 { end += 1 }
                else if byte == #char "\"" { quote = false }
            } else if byte == #char "\"" { quote = true }
            else if byte == #char ";" || byte == #char "\n" { break }
            end += 1
        }
        if quote { return result }
        result.next = end
        if Byte(body, end) != 0 { result.next += 1 }
        line := Trim(body[at:end])
        at = result.next
        if line.count == 0 { continue }
        if line.count >= 6 && line[0:5] == "using" && Text.SpaceByte(line[5]) {
            result.is_using = true
            line = Trim(line[5:])
        }
        colon := Find(line, #char ":", 0)
        if colon < 0 { return result }
        name := Trim(line[0:colon])
        type := Trim(line[colon + 1:])
        tag := Find(type, #char "#", 0)
        if tag >= 0 {
            directive := type[tag:]
            result.c_type = CSpelling(directive)
            if result.c_type.count >= type_limit { return result }
            if result.c_type.count == 0 {
                if union_record || directive.count < 8 || directive[0:7] != "#go_tag" ||
                !Text.SpaceByte(directive[7]) { return result }
                literal := Trim(directive[7:])
                if literal.count == 0 || literal.count >= tag_workspace.count { return result }
                decoded := Text.DecodeString(literal, tag_workspace)
                if !decoded.valid { return result }
                for byte: tag_workspace[0:decoded.count] { if byte == 0 { return result } }
                result.tag = literal
            }
            type = Trim(type[0:tag])
        }
        if !Identifier(name) || name.count >= name_limit ||
        type.count == 0 || type.count >= type_limit { return result }
        result.status = 1
        result.name = name
        result.type = type
        return result
    }
    result.status = 0
    return result
}

SliceElement :: (type: string) -> ElementType {
    if type.count < 2 || type[0:2] != "[]" { return .{} }
    element := Trim(type[2:])
    return .{element.count > 0, element, 0}
}

ArrayElement :: (type: string) -> ElementType {
    if type.count < 4 || type[0] != #char "[" { return .{} }
    close := Find(type, #char "]", 1)
    if close <= 1 { return .{} }
    element := Trim(type[close + 1:])
    if element.count == 0 { return .{} }
    digits := true
    for byte: type[1:close] {
        if byte < #char "0" || byte > #char "9" { digits = false; break }
    }
    capacity: s64 = -1 // The checker resolves constant expressions.
    if digits {
        capacity = 0
        for byte: type[1:close] {
            capacity = capacity * 10 + cast(s64)(byte - #char "0")
            if capacity > 1048576 { return .{} }
        }
    }
    return .{true, element, capacity}
}

// Fixed-width SIMD vectors spell their lane type and lane count, such as
// u8x16 or f32x8, and hold 128 or 256 bits. Native vectors, such as s16xN,
// hold as many 128-bit blocks as the code's instruction set has; their
// lanes are one block's. Float lanes are float32 and float64. An invalid
// spelling has zero lanes.
VectorShape :: struct { lanes: s32; lane: string }

VectorSpelling :: struct {
    name: string
    lane: string
    c: string
    go: string
    block: string // the 128-bit spelling for a native vector
    lanes: s32
    bits: s32
}

#scope_file
Vectors: [30]VectorSpelling = .{
    .{name = "u8x16", lane = "u8", c = "zi_u8x16", go = "[16]uint8", lanes = 16, bits = 8},
    .{name = "s8x16", lane = "s8", c = "zi_s8x16", go = "[16]int8", lanes = 16, bits = 8},
    .{name = "u16x8", lane = "u16", c = "zi_u16x8", go = "[8]uint16", lanes = 8, bits = 16},
    .{name = "s16x8", lane = "s16", c = "zi_s16x8", go = "[8]int16", lanes = 8, bits = 16},
    .{name = "u32x4", lane = "u32", c = "zi_u32x4", go = "[4]uint32", lanes = 4, bits = 32},
    .{name = "s32x4", lane = "s32", c = "zi_s32x4", go = "[4]int32", lanes = 4, bits = 32},
    .{name = "u64x2", lane = "u64", c = "zi_u64x2", go = "[2]uint64", lanes = 2, bits = 64},
    .{name = "s64x2", lane = "s64", c = "zi_s64x2", go = "[2]int64", lanes = 2, bits = 64},
    .{name = "f32x4", lane = "float32", c = "zi_f32x4", go = "[4]float32", lanes = 4, bits = 32},
    .{name = "f64x2", lane = "float64", c = "zi_f64x2", go = "[2]float64", lanes = 2, bits = 64},
    .{name = "u8x32", lane = "u8", c = "zi_u8x32", go = "[32]uint8", lanes = 32, bits = 8},
    .{name = "s8x32", lane = "s8", c = "zi_s8x32", go = "[32]int8", lanes = 32, bits = 8},
    .{name = "u16x16", lane = "u16", c = "zi_u16x16", go = "[16]uint16", lanes = 16, bits = 16},
    .{name = "s16x16", lane = "s16", c = "zi_s16x16", go = "[16]int16", lanes = 16, bits = 16},
    .{name = "u32x8", lane = "u32", c = "zi_u32x8", go = "[8]uint32", lanes = 8, bits = 32},
    .{name = "s32x8", lane = "s32", c = "zi_s32x8", go = "[8]int32", lanes = 8, bits = 32},
    .{name = "u64x4", lane = "u64", c = "zi_u64x4", go = "[4]uint64", lanes = 4, bits = 64},
    .{name = "s64x4", lane = "s64", c = "zi_s64x4", go = "[4]int64", lanes = 4, bits = 64},
    .{name = "f32x8", lane = "float32", c = "zi_f32x8", go = "[8]float32", lanes = 8, bits = 32},
    .{name = "f64x4", lane = "float64", c = "zi_f64x4", go = "[4]float64", lanes = 4, bits = 64},
    .{name = "u8xN", lane = "u8", c = "zi_u8xN", go = "[16]uint8", block = "u8x16", lanes = 16, bits = 8},
    .{name = "s8xN", lane = "s8", c = "zi_s8xN", go = "[16]int8", block = "s8x16", lanes = 16, bits = 8},
    .{name = "u16xN", lane = "u16", c = "zi_u16xN", go = "[8]uint16", block = "u16x8", lanes = 8, bits = 16},
    .{name = "s16xN", lane = "s16", c = "zi_s16xN", go = "[8]int16", block = "s16x8", lanes = 8, bits = 16},
    .{name = "u32xN", lane = "u32", c = "zi_u32xN", go = "[4]uint32", block = "u32x4", lanes = 4, bits = 32},
    .{name = "s32xN", lane = "s32", c = "zi_s32xN", go = "[4]int32", block = "s32x4", lanes = 4, bits = 32},
    .{name = "u64xN", lane = "u64", c = "zi_u64xN", go = "[2]uint64", block = "u64x2", lanes = 2, bits = 64},
    .{name = "s64xN", lane = "s64", c = "zi_s64xN", go = "[2]int64", block = "s64x2", lanes = 2, bits = 64},
    .{name = "f32xN", lane = "float32", c = "zi_f32xN", go = "[4]float32", block = "f32x4", lanes = 4, bits = 32},
    .{name = "f64xN", lane = "float64", c = "zi_f64xN", go = "[2]float64", block = "f64x2", lanes = 2, bits = 64},
};

VectorIndex :: (name: string) -> s64 {
    if name.count < 4 || name.count > 6 { return -1 }
    if name[0] != #char "u" && name[0] != #char "s" && name[0] != #char "f" { return -1 }
    for i: 0..Vectors.count - 1 {
        if Vectors[i].name == name { return i }
    }
    return -1
}

#scope_export
FindVector :: (name: string) -> *VectorSpelling {
    index := VectorIndex(name)
    return ifx index < 0 then null else *Vectors[index]
}

VectorType :: (name: string) -> VectorShape {
    index := VectorIndex(name)
    if index < 0 { return .{} }
    return .{Vectors[index].lanes, Vectors[index].lane}
}

// Zero lanes selects the native spelling for this lane type.
VectorForLane :: (lane: string, lanes: s32) -> *VectorSpelling {
    for i: 0..Vectors.count - 1 {
        vector := *Vectors[i]
        width := ifx vector.block.count > 0 then 0 else vector.lanes
        if width == lanes && vector.lane == lane { return vector }
    }
    return null
}

VectorForBlocks :: (vector: *VectorSpelling, blocks: s32) -> *VectorSpelling {
    if vector != null && vector.block.count > 0 {
        if blocks == 1 { return FindVector(vector.block) }
        if blocks == 2 { return VectorForLane(vector.lane, vector.lanes * 2) }
    }
    return vector
}

HoldsNativeVector :: (name: string) -> bool {
    if FindVector(name) != null { return false }
    for at: 0..name.count - 2 {
        if name[at] != #char "x" || name[at + 1] != #char "N" { continue }
        if at + 2 < name.count && VectorIdentifierByte(name[at + 2]) { continue }
        start := at
        while start > 0 && VectorIdentifierByte(name[start - 1]) { start -= 1 }
        if FindVector(name[start:at + 2]) != null { return true }
    }
    return false
}

BuiltinName :: (name: string) -> bool {
    if name.count < 2 || name.count > 7 { return false }
    if VectorType(name).lanes > 0 { return true }
    return name == "bool" || name == "void" || name == "s8" || name == "u8" ||
    name == "s16" || name == "u16" || name == "s32" || name == "u32" ||
    name == "s64" || name == "u64" || name == "isize" || name == "usize" ||
    name == "float32" || name == "float64" || name == "string" || name == "int" ||
    name == "float" || name == "Type" || name == "any"
}

// Concrete values that need no declaration or recursive layout walk.
// void and compile-time-only names cannot be record field values.
BuiltinValueName :: (name: string) -> bool {
    return name == "string" || name == "isize" || name == "usize" ||
        ScalarByteWidth(name) > 0 || VectorType(name).lanes > 0
}

MapPrimitive :: (name: string) -> bool {
    return name == "MapInit" || name == "MapSet" || name == "MapGet" ||
    name == "MapContains" || name == "MapDelete" || name == "MapClear" ||
    name == "MapCount" || name == "MapKeys" || name == "MapLookup"
}

// Go methods use package.(Type).Method or package.(*Type).Method. The
// explicit go: prefix also permits package paths without a slash.
GoCall :: (target: string, receiver_limit: s64) -> ForeignCall {
    explicit_go := target.count >= 3 && target[0:3] == "go:"
    start: s64 = 0
    if explicit_go { start = 3 }
    method: s64 = -1
    end: s64 = -1
    slash := false
    for at: start..target.count - 1 {
        if target[at] == #char "/" { slash = true }
        if target[at] == #char "." {
            end = at
            if Byte(target, at + 1) == #char "(" { method = at; break }
        }
    }
    if end <= start || (!explicit_go && !slash) { return .{} }
    module := target[start:end]
    for byte: module {
        if !Text.IdentifierByte(byte) && byte != #char "/" &&
        byte != #char "." && byte != #char "-" { return .{} }
    }
    receiver := ""
    name := end + 1
    if method >= 0 {
        close := Find(target, #char ")", method + 2)
        if close < 0 || Byte(target, close + 1) != #char "." { return .{} }
        receiver = target[method + 2:close]
        if receiver.count == 0 || receiver.count >= receiver_limit { return .{} }
        receiver_name := receiver
        if receiver[0] == #char "*" { receiver_name = receiver[1:] }
        if !Identifier(receiver_name) { return .{} }
        name = close + 2
    }
    symbol := target[name:]
    if !Identifier(symbol) { return .{} }
    kind: s32 = 1
    if method >= 0 { kind = 2 }
    return .{kind, module, receiver, symbol}
}

GoTypeTarget :: (target: string) -> bool {
    if target.count < 3 || target[0:3] != "go:" { return false }
    call := GoCall(target, 0)
    if call.kind != 1 { return false }
    if target.count >= 11 && target[0:11] == "go:builtin." {
        return call.module == "builtin" &&
            (call.symbol == "any" || call.symbol == "error" || call.symbol == "uintptr")
    }
    return true
}

#scope_file
libc :: #system_library "libc";
IsAlnum :: (byte: s32) -> s32 #foreign libc "isalnum";
VectorIdentifierByte :: (byte: u8) -> bool { return byte == #char "_" || IsAlnum(cast(s32)byte) != 0 }
Byte :: (source: string, at: s64) -> u8 {
    if at < 0 || at >= source.count { return 0 }
    return source[at]
}
Find :: (source: string, wanted: u8, at: s64) -> s64 {
    while at < source.count {
        if source[at] == wanted { return at }
        at += 1
    }
    return -1
}
Trim :: (source: string) -> string {
    range := Text.TrimRange(source)
    return source[range.begin:range.end]
}
Identifier :: (source: string) -> bool {
    if source.count == 0 { return false }
    first := source[0]
    if first != #char "_" && !(first >= #char "a" && first <= #char "z") &&
    !(first >= #char "A" && first <= #char "Z") { return false }
    for byte: source { if !Text.IdentifierByte(byte) { return false } }
    return true
}
