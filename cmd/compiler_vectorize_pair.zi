using Machine :: #import "compiler_machine_ir"
using Form :: #import "compiler_vector_form"
using SSA :: #import "compiler_opt_ssa"
using Vectorizer :: #import "compiler_vectorize"
using Vectors :: #import "std/vec"

// Two adjacent integer fields updated from disjoint adjacent fields of the
// same record. Aggregate lowering has already proved the in-place views;
// exact instruction adjacency keeps every intervening effect in its order.
VectorPair :: struct { instruction: s32; block: s32; operands: [8]MachineOperand }
VectorPairPlan :: struct { pairs: Vec(VectorPair); work: s64; problem: LirSsaProblem }

#scope_file
Context :: struct { program: MachineProgram; uses: Vec(s32); budget: LirSsaBudget }

Operand :: (c: *Context, instruction: s32, local: s32) -> MachineOperand {
    return c.program.operands[c.program.instructions[instruction].operand_begin + local]
}
Virtual :: (operand: MachineOperand, role: MachineOperandRole) -> bool {
    return operand.kind == .Virtual && operand.role == role && operand.id >= 0
}
Same :: (left: MachineOperand, right: MachineOperand) -> bool {
    return left.kind == .Virtual && right.kind == .Virtual && left.id == right.id
}
Immediate :: (bits: u64) -> MachineOperand {
    return .{kind = .Immediate, role = .Use, class = .General, id = -1,
        type = -1, fixed_register = -1, tied_to = -1, immediate = bits, value = -1}
}
Operation :: (opcode: MachineOpcode) -> VectorOperation {
    if opcode == .IntegerAdd { return .Add }
    if opcode == .IntegerSubtract { return .Subtract }
    if opcode == .IntegerAnd { return .And }
    if opcode == .IntegerOr { return .Or }
    if opcode == .IntegerXor { return .Xor }
    return .Copy
}
Candidate :: (c: *Context, first: s32, block: s32, out: *VectorPair) -> bool {
    operation := Operation(c.program.instructions[first + 2].opcode)
    if operation == .Copy { return false }
    for at: cast(s32)0..7 {
        instruction := c.program.instructions[first + at]
        if instruction.operand_count != 3 || instruction.edge_count != 0 ||
            instruction.call != -1 || instruction.flags_use != -1 || instruction.flags_def != -1 { return false }
        if at == 2 || at == 6 {
            if instruction.opcode != c.program.instructions[first + 2].opcode { return false }
        } else if instruction.opcode != (ifx at == 3 || at == 7 then MachineOpcode.AggregateInsert else .AggregateExtract) {
            return false
        }
    }
    base := Operand(c, first, 1)
    if !Virtual(base, .Use) || base.class != .General { return false }
    for lane: cast(s32)0..1 {
        at := first + lane * 4
        left := Operand(c, at, 0)
        right := Operand(c, at + 1, 0)
        result := Operand(c, at + 2, 0)
        if !Virtual(left, .Define) || !Virtual(right, .Define) || !Virtual(result, .Define) ||
            left.class != .General || right.class != .General || result.class != .General ||
            left.type != right.type || left.type != result.type ||
            c.uses[left.id] != 1 || c.uses[right.id] != 1 ||
            !Same(base, Operand(c, at, 1)) || !Same(base, Operand(c, at + 1, 1)) ||
            !Same(base, Operand(c, at + 3, 0)) ||
            !Same(left, Operand(c, at + 2, 1)) || !Same(right, Operand(c, at + 2, 2)) ||
            !Same(result, Operand(c, at + 3, 1)) { return false }
        field := Operand(c, at, 2)
        input := Operand(c, at + 1, 2)
        stored := Operand(c, at + 3, 2)
        if field.kind != .Immediate || input.kind != .Immediate || stored.kind != .Immediate ||
            field.immediate != stored.immediate { return false }
        if lane == 1 && (field.immediate != Operand(c, first, 2).immediate + 1 ||
            input.immediate != Operand(c, first + 1, 2).immediate + 1 ||
            result.type != Operand(c, first + 2, 0).type) { return false }
    }
    destination := Operand(c, first, 2).immediate
    right := Operand(c, first + 1, 2).immediate
    if !VectorPairRecord(c.program, base.type, Operand(c, first + 2, 0).type, destination, right) { return false }
    pair := VectorPair.{instruction = first, block = block}
    pair.operands[0] = Operand(c, first + 2, 0)
    pair.operands[1] = Operand(c, first + 6, 0)
    // Scalar two-address ties refer to the removed arithmetic operands.
    pair.operands[0].tied_to = -1
    pair.operands[1].tied_to = -1
    pair.operands[2] = base
    pair.operands[3] = Immediate(cast(u64)operation)
    pair.operands[4] = Immediate(destination)
    pair.operands[5] = Immediate(right)
    for register: cast(s32)0..1 {
        pair.operands[6 + register] = .{kind = .Physical, role = .Define, class = .Float,
            id = register, type = -1, fixed_register = register, tied_to = -1, value = -1}
    }
    <<out = pair
    return true
}

#scope_export
VectorPairPlanFree :: (plan: *VectorPairPlan) {
    VecFree(plan.pairs); plan.work = 0; plan.problem = .None
}
VectorPairPlanBuild :: (plan: *VectorPairPlan, program: MachineProgram, enabled: bool,
    work: s64, bytes: s64) -> LirSsaProblem {
    VectorPairPlanFree(plan)
    if !enabled || program.checks || program.target.arch != .X86_64 || program.stage != .Virtual { return .None }
    c := Context.{program = program, budget = .{work = work, bytes = bytes}}
    defer VecFree(c.uses)
    if !LirSsaReserve(*c.budget, program.virtuals.count, size_of(s32)) { return c.budget.problem }
    if !VecResize(c.uses, program.virtuals.count) { return .Allocation }
    for at: 0..c.uses.count - 1 { c.uses[at] = 0 }
    if LirSsaSpend(*c.budget, c.uses.count + program.operands.count + program.copies.count) {
        for operand: program.operands {
            if operand.kind == .Virtual && (operand.role == .Use || operand.role == .UseDefine) {
                if c.uses[operand.id] < 2 { c.uses[operand.id] += 1 }
            }
        }
        for copy: program.copies { if c.uses[copy.source] < 2 { c.uses[copy.source] += 1 } }
        for block, block_id: program.blocks {
            if c.budget.problem != .None { break }
            at := block.instruction_begin
            end := at + block.instruction_count
            while at <= end - 8 {
                if !LirSsaSpend(*c.budget, 32) { break }
                pair: VectorPair
                if Candidate(*c, at, cast(s32)block_id, *pair) {
                    if !LirSsaReserve(*c.budget, 1, size_of(VectorPair)) { break }
                    if !VecPush(plan.pairs, pair) { c.budget.problem = .Allocation; break }
                    at += 8
                } else { at += 1 }
            }
        }
    }
    plan.work = c.budget.used; plan.problem = c.budget.problem
    return plan.problem
}

// Apply only to the verified virtual program used to build PLAN. Keep the
// original operand coordinates; calls and relocations need only the compacted
// instruction coordinate. No borrowed operand view survives its resize.
VectorPairPlanApply :: (owner: *MachineOwner, plan: *VectorPairPlan, bytes: s64) -> MachineProblem {
    if plan.pairs.count == 0 { return .None }
    count := owner.instructions.count - plan.pairs.count * 7
    operands := owner.operands.count
    if count < 0 || operands > 2147483647 - plan.pairs.count * 8 || owner.spills.count != 0 { return .Limit }
    code: Vec(MachineInstruction)
    map: Vec(s32)
    defer { VecFree(code); VecFree(map) }
    if !VecResizeBounded(code, count, bytes) || !VecResizeBounded(map, owner.instructions.count, bytes) ||
        !VecResizeBounded(owner.operands, operands + plan.pairs.count * 8, bytes) { return .Allocation }
    next: s32
    pair_at: s64
    for block, block_id: owner.blocks {
        begin := next
        at := block.instruction_begin
        end := at + block.instruction_count
        while at < end {
            instruction := owner.instructions[at]
            if pair_at < plan.pairs.count && plan.pairs[pair_at].instruction == at {
                pair := plan.pairs[pair_at]
                if pair.block != block_id || at > end - 8 { return .Instruction }
                instruction.opcode = .VectorPair
                instruction.operand_begin = cast(s32)(operands + pair_at * 8)
                instruction.operand_count = 8
                for local: cast(s32)0..7 {
                    owner.operands[instruction.operand_begin + local] = pair.operands[local]
                    map[at + local] = next
                }
                pair_at += 1
                at += 8
            } else { map[at] = next; at += 1 }
            code[next] = instruction
            next += 1
        }
        owner.blocks[block_id].instruction_begin = begin
        owner.blocks[block_id].instruction_count = next - begin
    }
    if next != count || pair_at != plan.pairs.count { return .Instruction }
    for at: 0..owner.calls.count - 1 { owner.calls[at].instruction = map[owner.calls[at].instruction] }
    for at: 0..owner.relocations.count - 1 {
        if owner.relocations[at].instruction >= 0 {
            owner.relocations[at].instruction = map[owner.relocations[at].instruction]
        }
    }
    VecSwap(owner.instructions, code)
    owner.program.instructions = owner.instructions[:]
    owner.program.operands = owner.operands[:]
    return .None
}
