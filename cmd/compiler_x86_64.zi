using ABI :: #import "compiler_abi"
using Allocated :: #import "compiler_machine_verify_allocated"
using Bytes :: #import "compiler_x86_bytes"
using Image :: #import "compiler_machine_image"
using Machine :: #import "compiler_machine_ir"
using Target :: #import "compiler_target"
using Vectors :: #import "std/vec"

// Direct x86-64 encoder for allocated machine IR on Linux and Windows, whose
// programs share the Ziran-internal convention. It consumes
// only a program that passes MachineVerifyAllocated, which already rejects
// call forms outside the target ABI and relocation addends the target cannot
// hold, then checks
// every instruction form it encodes; anything else is a hard diagnostic
// reported before the output owner is touched. One pass emits each function: a
// measuring run records function, block and instruction offsets and counts
// relocations, and the writing run repeats the same calls into an exactly
// sized buffer and must reproduce every recorded offset.
//
// Calls: arguments follow SysV, with records and arrays copied to the
// outgoing area. A call with a record or array result, internal or host,
// passes the destination address in rax.
//
// Frame: push rbp; mov rbp, rsp; sub rsp, frame.size; callee-saved general
// registers stored to their CalleeSave homes. Return restores them, then
// leave; ret. Stack objects are addressed from rbp at their allocated
// offsets, except outgoing arguments, which are addressed from rsp.
//
// Values live in general registers normalized to 64 bits: signed integers
// sign-extended, unsigned integers zero-extended, bool 0 or 1. Direct calls
// and function addresses inside the image are resolved here; global
// addresses, the fuel counter and the trap handler are PC-relative 32-bit
// relocations that the loader resolves as symbol + addend - field.
// Every trap is `mov edi, code; call trap_handler; ud2`.
//
// Stack: a function that calls, or whose frame exceeds MachineX64StackSlack,
// compares rsp with the instance's stack limit word after reserving its frame
// and takes MachineX64TrapStack below it. A leaf with a small frame stays
// within the slack the limit leaves above the end of the stack.

MachineX64TrapReserved :: 0xffff0000
MachineX64TrapUnreachable :: 0xffff0001
MachineX64TrapDivideByZero :: 0xffff0002
MachineX64TrapShift :: 0xffff0003
MachineX64TrapFuel :: 0xffff0004
MachineX64TrapConversion :: 0xffff0005
MachineX64TrapStack :: 0xffff0006
MachineX64TrapStorage :: 0xffff0007
// Pointer, freed-block and bounds failures share the code of an invalid
// address, as on the portable engine.
MachineX64TrapPointer :: 0xfffeffff
MachineX64TrapSize :: 12
MachineX64StackSlack :: 4096

MachineX64RelocationKind :: enum s32 {
    Invalid; GlobalAddress; ConstantAddress; FuelCounter; TrapHandler; PlatformService; HostCapability; RuntimeResize
    StackLimit; PointerRuntime
}

MachineX64Relocation :: struct {
    offset: s64
    kind: MachineX64RelocationKind
    symbol: s32
    addend: s64
    instruction: s32
}

// Byte offsets of a function, the first byte after its prologue, and its end.
MachineX64Function :: struct { begin: s64; body: s64; end: s64 }
MachineX64Range :: struct { begin: s64; end: s64 }

MachineX64Image :: struct {
    code: []u8
    functions: []MachineX64Function
    blocks: []s64
    instructions: []MachineX64Range
    relocations: []MachineX64Relocation
    entry: s32
}

MachineX64Result :: struct {
    diagnostic: MachineDiagnostic
    code_bytes: s64
    relocations: s64
    work: s64
}

MachineX64Owner :: struct {
    valid: bool
    image: MachineX64Image
    code: Vec(u8)
    functions: Vec(MachineX64Function)
    blocks: Vec(s64)
    instructions: Vec(MachineX64Range)
    relocations: Vec(MachineX64Relocation)
    machine_image: MachineImageOwner
}

#scope_file

CodeLimit :: 2147483647

Layout :: struct {
    function_begin: Vec(s64)
    function_body: Vec(s64)
    function_end: Vec(s64)
    block_begin: Vec(s64)
    instruction_begin: Vec(s64)
    instruction_end: Vec(s64)
    relocation_of: Vec(s32)
}

State :: struct {
    program: MachineProgram
    writer: X86Writer
    diagnostic: MachineDiagnostic
    remaining: s64
    used: s64
    emit: bool
    function_begin: []s64
    function_body: []s64
    function_end: []s64
    block_begin: []s64
    instruction_begin: []s64
    instruction_end: []s64
    relocation_of: []s32
    relocations: []MachineX64Relocation
    relocation_count: s64
    consumed: s64
    function: s32
    block: s32
    instruction: s32
    flags_value: s32
    flags_signed: bool
    flags_float: bool
    // Above zero while a block is emitted only to measure its length.
    suppress: s32
    // The function keeps its step budget in the fuel register, and the
    // prologue has loaded it.
    fuel_register: bool
    fuel_live: bool
    // The function has no frame (no push rbp / leave), and the return after
    // a tail call, already left, emits nothing.
    frameless: bool
    tail_returned: bool
}

NoDiagnostic :: () -> MachineDiagnostic {
    return .{problem = .None, function = MachineNoId, block = MachineNoId,
        instruction = MachineNoId, operand = MachineNoId, virtual = MachineNoId}
}

Fail :: (state: *State, problem: MachineProblem, operand: s32 = MachineNoId) -> bool {
    if state.diagnostic.problem == .None {
        value: s32 = MachineNoId
        if operand >= 0 && operand < state.program.operands.count { value = state.program.operands[operand].value }
        state.diagnostic = .{problem = problem, function = state.function, block = state.block,
            instruction = state.instruction, operand = operand, virtual = value}
    }
    return false
}

Spend :: (state: *State, count: s64) -> bool {
    if count < 0 || count > state.remaining { return Fail(state, .Limit) }
    state.remaining -= count
    state.used += count
    return true
}

LayoutFree :: (layout: *Layout) {
    VecFree(layout.function_begin)
    VecFree(layout.function_body)
    VecFree(layout.function_end)
    VecFree(layout.block_begin)
    VecFree(layout.instruction_begin)
    VecFree(layout.instruction_end)
    VecFree(layout.relocation_of)
}

Filled :: (values: *Vec(s64), count: s64) -> bool {
    if !VecResizeBounded(<<values, count, count) { return false }
    for index: cast(s64)0..count - 1 { (<<values)[index] = -1 }
    return true
}

// Records the current offset while measuring; while writing, requires it.
Place :: (state: *State, slots: []s64, index: s64) -> bool {
    if state.emit {
        if slots[index] != state.writer.at { return Fail(state, .Instruction) }
        return true
    }
    slots[index] = state.writer.at
    return true
}

Relocate :: (state: *State, kind: MachineX64RelocationKind, symbol: s32, addend: s64, field: s64) {
    if state.suppress > 0 { return }
    if state.emit && state.relocation_count < state.relocations.count {
        state.relocations[state.relocation_count] = .{offset = field, kind = kind, symbol = symbol,
            addend = addend, instruction = state.instruction}
    }
    state.relocation_count += 1
}

Current :: (state: *State) -> MachineInstruction {
    return state.program.instructions[state.instruction]
}

OperandId :: (state: *State, local: s32) -> s32 {
    return Current(state).operand_begin + local
}

OperandAt :: (state: *State, local: s32) -> MachineOperand {
    return state.program.operands[OperandId(state, local)]
}

TypeOf :: (state: *State, operand: MachineOperand) -> MachineType {
    return state.program.types[state.program.virtuals[operand.value].type]
}

TypeIdOf :: (state: *State, operand: MachineOperand) -> s32 {
    if operand.value >= 0 { return state.program.virtuals[operand.value].type }
    if operand.type >= 0 { return operand.type }
    if operand.kind == .StackObject { return state.program.stack_objects[operand.id].type }
    return MachineNoId
}

AtOffset :: (memory: X86Operand, offset: s64) -> X86Operand {
    memory.displacement += offset
    return memory
}

// Copies and zeroing of at least LoopBytes run a loop over 16-byte chunks
// through the float scratch xmm15, with r11 counting up to zero, then finish
// the tail through r11; shorter ones move 8/4/2/1-byte pieces through r11.
LoopBytes :: 64

Looped :: (size: s64, first: X86Operand, second: X86Operand) -> bool {
    return size >= LoopBytes && first.kind == .Base && second.kind == .Base &&
        first.register != X86R11 && second.register != X86R11
}

// r11 = -(whole chunks of SIZE); returns the chunk bytes and the loop start.
LoopBegin :: (state: *State, size: s64, begin: *s64) -> s64 {
    chunks := size & ~cast(s64)15
    X86MoveImmediate(*state.writer, X86R11, cast(u64)(-chunks))
    <<begin = state.writer.at
    return chunks
}

LoopEnd :: (state: *State, begin: s64) {
    X86SubtractImmediate(*state.writer, X86Direct(X86R11), -16)
    X86JumpCondition32(*state.writer, X86NotEqual, begin)
}

CopyMemory :: (state: *State, destination: X86Operand, source: X86Operand, size: s64) -> bool {
    // A member built where its parent keeps it is already in place.
    if destination.kind == source.kind && destination.register == source.register &&
        destination.displacement == source.displacement && destination.index == source.index &&
        destination.shift == source.shift { return !state.writer.failed }
    offset: s64
    if Looped(size, destination, source) {
        scratch := MachineAbiScratchFloatRegister(state.program.target)
        begin: s64
        offset = LoopBegin(state, size, *begin)
        X86VectorLoad(*state.writer, scratch, X86Indexed(source.register, X86R11, source.displacement + offset))
        X86VectorStore(*state.writer, X86Indexed(destination.register, X86R11, destination.displacement + offset), scratch)
        LoopEnd(state, begin)
    }
    while offset < size {
        remaining := size - offset
        width: s64 = 1
        if remaining >= 8 { width = 8 }
        else if remaining >= 4 { width = 4 }
        else if remaining >= 2 { width = 2 }
        X86Load(*state.writer, X86R11, AtOffset(source, offset), width, false)
        X86Store(*state.writer, AtOffset(destination, offset), X86R11, width)
        offset += width
    }
    return !state.writer.failed
}

ZeroMemory :: (state: *State, destination: X86Operand, size: s64) -> bool {
    offset: s64
    if Looped(size, destination, destination) {
        scratch := MachineAbiScratchFloatRegister(state.program.target)
        X86VectorZero(*state.writer, scratch)
        begin: s64
        offset = LoopBegin(state, size, *begin)
        X86VectorStore(*state.writer, X86Indexed(destination.register, X86R11, destination.displacement + offset), scratch)
        LoopEnd(state, begin)
    }
    // The loop leaves r11 at zero.
    if offset == 0 && size > 0 { X86MoveImmediate(*state.writer, X86R11, 0) }
    while offset < size {
        remaining := size - offset
        width: s64 = 1
        if remaining >= 8 { width = 8 }
        else if remaining >= 4 { width = 4 }
        else if remaining >= 2 { width = 2 }
        X86Store(*state.writer, AtOffset(destination, offset), X86R11, width)
        offset += width
    }
    return !state.writer.failed
}

Member :: (state: *State, type_id: s32, index: u64, member: *s32, offset: *s64) -> bool {
    if type_id < 0 || type_id >= state.program.types.count { return false }
    type := state.program.types[type_id]
    <<offset = 0
    if type.kind == .Array {
        if index >= cast(u64)type.count || type.element < 0 { return false }
        <<member = type.element
        <<offset = cast(s64)index * state.program.types[type.element].size
        return true
    }
    if type.kind != .Record || index >= cast(u64)type.fields_count { return false }
    member_offset: s64
    for at: cast(s32)0..cast(s32)index {
        field := state.program.type_ids[type.fields_begin + at]
        field_type := state.program.types[field]
        // LIR records are packed in declaration order. The aggregate itself
        // is aligned as a stack object, but members have no implicit padding.
        if field_type.size < 0 || member_offset > type.size - field_type.size { return false }
        if at == cast(s32)index {
            <<member = field
            <<offset = member_offset
            return true
        }
        member_offset += field_type.size
    }
    return false
}

// Byte size of a general scalar the encoder can hold in a register, or -1.
ScalarSize :: (type: MachineType) -> s64 {
    if type.class != .General { return -1 }
    if type.kind == .Bool { return ifx type.size == 1 then cast(s64)1 else -1 }
    if type.kind == .Pointer || type.kind == .Function { return ifx type.size == 8 then cast(s64)8 else -1 }
    if type.kind == .Integer && (type.bits == 8 || type.bits == 16 || type.bits == 32 || type.bits == 64) &&
        type.size == cast(s64)(type.bits / 8) { return type.size }
    return -1
}

FloatSize :: (type: MachineType) -> s64 {
    if type.class != .Float || type.kind != .Float ||
        (type.bits != 32 && type.bits != 64) || type.size != cast(s64)(type.bits / 8) { return -1 }
    return type.size
}

Signed :: (type: MachineType) -> bool { return type.kind == .Integer && type.is_signed }

Integer :: (type: MachineType) -> bool { return type.kind == .Integer && ScalarSize(type) > 0 }

StackArgumentSize :: (value: s64) -> s64 {
    if value < 0 || value > 9223372036854775799 { return -1 }
    return (value + 7) & ~cast(s64)7
}

// A general physical register holding a typed value, or MachineNoId.
Register :: (state: *State, local: s32, role: MachineOperandRole) -> s32 {
    if local < 0 || local >= Current(state).operand_count { unused Fail(state, .Unsupported); return MachineNoId }
    id := OperandId(state, local)
    operand := state.program.operands[id]
    if operand.kind != .Physical || operand.class != .General || operand.role != role ||
        operand.value == MachineNoId || ScalarSize(TypeOf(state, operand)) < 0 ||
        !X86Register(operand.id) {
        unused Fail(state, .Unsupported, id)
        return MachineNoId
    }
    return operand.id
}

FloatRegister :: (state: *State, local: s32, role: MachineOperandRole) -> s32 {
    if local < 0 || local >= Current(state).operand_count { unused Fail(state, .Unsupported); return MachineNoId }
    id := OperandId(state, local)
    operand := state.program.operands[id]
    if operand.kind != .Physical || operand.class != .Float || operand.role != role ||
        operand.value == MachineNoId || FloatSize(TypeOf(state, operand)) < 0 ||
        !X86Register(operand.id) {
        unused Fail(state, .Unsupported, id)
        return MachineNoId
    }
    return operand.id
}

Count :: (state: *State, count: s32) -> bool {
    if Current(state).operand_count != count { return Fail(state, .Unsupported) }
    return true
}

StackMemory :: (state: *State, object_id: s32, operand: s32) -> X86Operand {
    object := state.program.stack_objects[object_id]
    if !X86Fits32(object.offset) || !X86Fits32(object.offset + object.size) {
        unused Fail(state, .Frame, operand)
        return X86At(X86Rbp, 0)
    }
    return X86At(ifx object.kind == .OutgoingArgument then X86Rsp else X86Rbp, object.offset)
}

// Re-establishes the register representation of TYPE after an operation
// that produced a full 64-bit result.
Normalize :: (state: *State, register: s32, type: MachineType) {
    size := ScalarSize(type)
    if type.kind != .Integer || size == 8 { return }
    X86Load(*state.writer, register, X86Direct(register), size, type.is_signed)
}

NormalizeConstant :: (value: u64, type: MachineType) -> u64 {
    size := ScalarSize(type)
    if type.kind != .Integer || size == 8 { return value }
    bits := cast(u64)(size * 8)
    mask := (cast(u64)1 << bits) - 1
    low := value & mask
    if type.is_signed && ((low >> (bits - 1)) & 1) != 0 { return low | ~mask }
    return low
}

ConditionCode :: (condition: MachineCondition, signed: bool) -> s32 {
    if condition == .Equal { return X86Equal }
    if condition == .NotEqual { return X86NotEqual }
    if condition == .Less { return ifx signed then X86Less else X86Below }
    if condition == .LessEqual { return ifx signed then X86LessEqual else X86BelowEqual }
    if condition == .Greater { return ifx signed then X86Greater else X86Above }
    if condition == .GreaterEqual { return ifx signed then X86GreaterEqual else X86AboveEqual }
    return MachineNoId
}

// The step budget of a function keeping it in the fuel register goes to, or
// comes back from, the instance counter: stored before calls and returns and
// on every trap, reloaded after calls.
FuelCounter :: (state: *State, store: bool) {
    register := MachineAbiFuelRegister(state.program.target)
    if store { X86Store(*state.writer, X86RipRelocated(), register, 8) }
    else { X86Load(*state.writer, register, X86RipRelocated(), 8, false) }
    Relocate(state, .FuelCounter, 0, -4, state.writer.at - 4)
}

FuelStore :: (state: *State) { if state.fuel_live { FuelCounter(state, true) } }

FuelReload :: (state: *State) { if state.fuel_live { FuelCounter(state, false) } }

TrapSequence :: (state: *State, code: u64) {
    FuelStore(state)
    X86MoveImmediate32(*state.writer, X86Rdi, code)
    X86Byte(*state.writer, 232)
    Relocate(state, .TrapHandler, 0, -4, state.writer.at)
    X86Little(*state.writer, 0, 4)
    X86Undefined(*state.writer)
}

// Continues past an inline trap when CONDITION holds.
// A trap that first writes back a register step budget, mov [rip + fuel],
// r15, is that many bytes longer.
FuelStoreBytes :: 7

TrapUnless :: (state: *State, condition: s32, code: u64) {
    X86JumpCondition8(*state.writer, condition, MachineX64TrapSize + ifx state.fuel_live then FuelStoreBytes else 0)
    TrapSequence(state, code)
}

// Where jumps enter BLOCK: its first byte, or past the fuel trap placed at
// the block's start.
BlockTarget :: (state: *State, block: s32) -> s64 {
    if FuelStub(state, block) { return state.block_begin[block] + MachineX64TrapSize + FuelStoreBytes }
    return state.block_begin[block]
}

FunctionTarget :: (state: *State, function: s32) -> s64 {
    return state.function_begin[function]
}

// The relocation attached to the current instruction, or MachineNoId after a
// diagnostic when it is missing, of another kind or carries an addend the
// form cannot hold.
Relocation :: (state: *State, kind: MachineRelocationKind, operand: s32, zero_addend: bool) -> s32 {
    id := state.relocation_of[state.instruction]
    if id < 0 { unused Fail(state, .Relocation, operand); return MachineNoId }
    relocation := state.program.relocations[id]
    if relocation.kind != kind || relocation.operand != operand || zero_addend && relocation.addend != 0 {
        unused Fail(state, .Relocation, operand)
        return MachineNoId
    }
    state.consumed += 1
    return id
}

Transfer :: (state: *State, instruction: MachineInstruction) -> bool {
    destination_id := instruction.operand_begin
    source_id := destination_id + 1
    destination := state.program.operands[destination_id]
    source := state.program.operands[source_id]
    if destination.class == .Stack {
        if instruction.opcode != .Move || destination.kind != .StackObject || source.kind != .StackObject {
            return Fail(state, .Unsupported, destination_id)
        }
        destination_memory := StackMemory(state, destination.id, destination_id)
        source_memory := StackMemory(state, source.id, source_id)
        if state.diagnostic.problem != .None { return false }
        size := state.program.stack_objects[destination.id].size
        if state.program.stack_objects[source.id].size != size { return Fail(state, .Stack, source_id) }
        return CopyMemory(state, destination_memory, source_memory, size)
    }
    if destination.class == .Float {
        size := FloatSize(TypeOf(state, destination))
        if size < 0 || FloatSize(TypeOf(state, source)) != size {
            return Fail(state, .Unsupported, destination_id)
        }
        if instruction.opcode == .Move {
            if destination.kind != .Physical || source.kind != .Physical {
                return Fail(state, .Unsupported, destination_id)
            }
            if destination.id != source.id {
                X86FloatLoad(*state.writer, destination.id, X86Direct(source.id), size)
            }
            return true
        }
        if instruction.opcode == .Spill {
            if destination.kind != .StackObject || source.kind != .Physical ||
                state.program.stack_objects[destination.id].size < size {
                return Fail(state, .Stack, destination_id)
            }
            memory := StackMemory(state, destination.id, destination_id)
            if state.diagnostic.problem != .None { return false }
            X86FloatStore(*state.writer, memory, source.id, size)
            return true
        }
        if destination.kind != .Physical || source.kind != .StackObject ||
            state.program.stack_objects[source.id].size < size {
            return Fail(state, .Stack, source_id)
        }
        memory := StackMemory(state, source.id, source_id)
        if state.diagnostic.problem != .None { return false }
        X86FloatLoad(*state.writer, destination.id, memory, size)
        return true
    }
    if destination.class != .General { return Fail(state, .Unsupported, destination_id) }
    if ScalarSize(TypeOf(state, destination)) < 0 { return Fail(state, .Unsupported, destination_id) }
    if ScalarSize(TypeOf(state, source)) < 0 { return Fail(state, .Unsupported, source_id) }
    if instruction.opcode == .Move {
        if destination.id != source.id { X86Move(*state.writer, destination.id, source.id) }
        return true
    }
    if instruction.opcode == .Spill {
        size := ScalarSize(TypeOf(state, source))
        if state.program.stack_objects[destination.id].size < size { return Fail(state, .Stack, destination_id) }
        memory := StackMemory(state, destination.id, destination_id)
        if state.diagnostic.problem != .None { return false }
        X86Store(*state.writer, memory, source.id, size)
        return true
    }
    type := TypeOf(state, destination)
    size := ScalarSize(type)
    if state.program.stack_objects[source.id].size < size { return Fail(state, .Stack, source_id) }
    memory := StackMemory(state, source.id, source_id)
    if state.diagnostic.problem != .None { return false }
    X86Load(*state.writer, destination.id, memory, size, Signed(type))
    return true
}

MoveImmediate :: (state: *State) -> bool {
    if Current(state).operand_count != 2 && Current(state).operand_count != 3 {
        return Fail(state, .Unsupported)
    }
    immediate := OperandAt(state, 1)
    if immediate.kind != .Immediate || immediate.role != .Use { return Fail(state, .Unsupported, OperandId(state, 1)) }
    type := TypeOf(state, OperandAt(state, 0))
    if type.class == .Float {
        destination := FloatRegister(state, 0, .Define)
        if destination == MachineNoId || FloatSize(type) < 0 || Current(state).operand_count != 3 { return false }
        scratch := OperandAt(state, 2)
        if scratch.kind != .Physical || scratch.class != .General ||
            scratch.id != MachineAbiScratchRegister(state.program.target) ||
            scratch.role != .Define || scratch.value != MachineNoId {
            return Fail(state, .Constraint, OperandId(state, 2))
        }
        X86MoveImmediate(*state.writer, X86R11, immediate.immediate)
        X86GeneralToFloatBits(*state.writer, destination, X86R11, type.size)
        return true
    }
    if Current(state).operand_count != 2 { return Fail(state, .Unsupported) }
    destination := Register(state, 0, .Define)
    if destination == MachineNoId { return false }
    if type.kind == .Bool && immediate.immediate > 1 { return Fail(state, .Unsupported, OperandId(state, 1)) }
    X86MoveImmediate(*state.writer, destination, NormalizeConstant(immediate.immediate, type))
    return true
}

// destination = left OPCODE right, with destination tied to left; the right
// operand is a register or a sign-extended 32-bit immediate.
Binary :: (state: *State, opcode: MachineOpcode) -> bool {
    if !Count(state, 3) { return false }
    destination := Register(state, 0, .Define)
    left := Register(state, 1, .Use)
    immediate := OperandAt(state, 2)
    constant := immediate.kind == .Immediate
    right := ifx constant then MachineNoId else Register(state, 2, .Use)
    if destination == MachineNoId || left == MachineNoId || !constant && right == MachineNoId { return false }
    if destination != left { return Fail(state, .Tie, OperandId(state, 0)) }
    if constant && !X86Fits32(cast(s64)immediate.immediate) { return Fail(state, .Unsupported, OperandId(state, 2)) }
    type := TypeOf(state, OperandAt(state, 0))
    logical := opcode == .IntegerAnd || opcode == .IntegerOr || opcode == .IntegerXor
    if type.kind == .Bool && !logical || type.kind == .Function { return Fail(state, .Unsupported, OperandId(state, 0)) }
    value := cast(s64)immediate.immediate
    if opcode == .IntegerMultiply {
        if constant { X86MultiplyValue(*state.writer, destination, destination, value) }
        else { X86Multiply(*state.writer, destination, right) }
    } else {
        code: u32 = X86Add
        if opcode == .IntegerSubtract { code = X86Subtract }
        if opcode == .IntegerAnd { code = X86And }
        if opcode == .IntegerOr { code = X86Or }
        if opcode == .IntegerXor { code = X86Xor }
        if constant { X86ArithmeticImmediate(*state.writer, code, destination, value) }
        else { X86Arithmetic(*state.writer, code, destination, right) }
    }
    Normalize(state, destination, type)
    return true
}

FloatBinary :: (state: *State, opcode: MachineOpcode) -> bool {
    if !Count(state, 3) { return false }
    destination := FloatRegister(state, 0, .Define)
    left := FloatRegister(state, 1, .Use)
    right := FloatRegister(state, 2, .Use)
    if destination == MachineNoId || left == MachineNoId || right == MachineNoId { return false }
    if destination != left { return Fail(state, .Tie, OperandId(state, 0)) }
    size := FloatSize(TypeOf(state, OperandAt(state, 0)))
    if size < 0 || FloatSize(TypeOf(state, OperandAt(state, 2))) != size {
        return Fail(state, .Unsupported, OperandId(state, 0))
    }
    code: u32 = 0x0f58
    if opcode == .FloatSubtract { code = 0x0f5c }
    if opcode == .FloatMultiply { code = 0x0f59 }
    if opcode == .FloatDivide { code = 0x0f5e }
    X86FloatArithmetic(*state.writer, destination, right, size, code)
    return true
}

Unary :: (state: *State, opcode: MachineOpcode) -> bool {
    if !Count(state, 2) { return false }
    destination := Register(state, 0, .Define)
    source := Register(state, 1, .Use)
    if destination == MachineNoId || source == MachineNoId { return false }
    if destination != source { return Fail(state, .Tie, OperandId(state, 0)) }
    type := TypeOf(state, OperandAt(state, 0))
    if !Integer(type) { return Fail(state, .Unsupported, OperandId(state, 0)) }
    X86Group3(*state.writer, ifx opcode == .IntegerNegate then 3 else 2, destination)
    Normalize(state, destination, type)
    return true
}

FloatUnary :: (state: *State) -> bool {
    if !Count(state, 3) { return false }
    destination := FloatRegister(state, 0, .Define)
    source := FloatRegister(state, 1, .Use)
    if destination == MachineNoId || source == MachineNoId { return false }
    if destination != source { return Fail(state, .Tie, OperandId(state, 0)) }
    scratch := OperandAt(state, 2)
    if scratch.kind != .Physical || scratch.class != .General ||
        scratch.id != MachineAbiScratchRegister(state.program.target) ||
        scratch.role != .Define || scratch.value != MachineNoId {
        return Fail(state, .Constraint, OperandId(state, 2))
    }
    size := FloatSize(TypeOf(state, OperandAt(state, 0)))
    X86FloatToGeneralBits(*state.writer, X86R11, destination, size)
    X86BitComplement(*state.writer, X86R11, cast(s32)(size * 8 - 1))
    X86GeneralToFloatBits(*state.writer, destination, X86R11, size)
    return true
}

// Divide and remainder: result and dividend in rax, rdx named as a clobber.
// Zero divisors trap; a signed divisor of -1 negates (or yields zero)
// without idiv, so the most negative dividend cannot fault.
Divide :: (state: *State, opcode: MachineOpcode) -> bool {
    if !Count(state, 4) { return false }
    destination := Register(state, 0, .Define)
    left := Register(state, 1, .Use)
    right := Register(state, 2, .Use)
    if destination == MachineNoId || left == MachineNoId || right == MachineNoId { return false }
    if destination != X86Rax || left != X86Rax { return Fail(state, .Constraint, OperandId(state, 0)) }
    clobber := OperandAt(state, 3)
    if clobber.kind != .Physical || clobber.class != .General || clobber.id != X86Rdx ||
        clobber.value != MachineNoId || clobber.role == .Use { return Fail(state, .Constraint, OperandId(state, 3)) }
    type := TypeOf(state, OperandAt(state, 1))
    if !Integer(type) { return Fail(state, .Unsupported, OperandId(state, 1)) }
    remainder := opcode == .IntegerRemainder
    divisor := right
    if divisor == X86Rax || divisor == X86Rdx {
        X86Move(*state.writer, X86R11, divisor)
        divisor = X86R11
    }
    X86Arithmetic(*state.writer, X86Test, divisor, divisor)
    TrapUnless(state, X86NotEqual, MachineX64TrapDivideByZero)
    tail: s64 = ifx remainder then 3 else 0
    if Signed(type) {
        X86CompareByte(*state.writer, divisor, -1)
        X86JumpCondition8(*state.writer, X86NotEqual, ifx remainder then cast(s64)4 else 5)
        if remainder { X86Encode(*state.writer, 0, false, X86Xor, 1, X86Rax, X86Direct(X86Rax)) }
        else { X86Group3(*state.writer, 3, X86Rax) }
        X86Jump8(*state.writer, 5 + tail)
        X86SignExtendRax(*state.writer)
        X86Group3(*state.writer, 7, divisor)
    } else {
        X86Encode(*state.writer, 0, false, X86Xor, 1, X86Rdx, X86Direct(X86Rdx))
        X86Group3(*state.writer, 6, divisor)
    }
    if remainder { X86Move(*state.writer, X86Rax, X86Rdx) }
    Normalize(state, X86Rax, type)
    return true
}

// Shifts by cl. A count outside [0, bits) traps.
Shift :: (state: *State, opcode: MachineOpcode) -> bool {
    if !Count(state, 3) { return false }
    destination := Register(state, 0, .Define)
    left := Register(state, 1, .Use)
    right := Register(state, 2, .Use)
    if destination == MachineNoId || left == MachineNoId || right == MachineNoId { return false }
    if destination != left { return Fail(state, .Tie, OperandId(state, 0)) }
    if right != X86Rcx { return Fail(state, .Constraint, OperandId(state, 2)) }
    type := TypeOf(state, OperandAt(state, 1))
    count_type := TypeOf(state, OperandAt(state, 2))
    if !Integer(type) { return Fail(state, .Unsupported, OperandId(state, 1)) }
    if !Integer(count_type) { return Fail(state, .Unsupported, OperandId(state, 2)) }
    X86CompareByte(*state.writer, X86Rcx, ScalarSize(type) * 8)
    TrapUnless(state, X86Below, MachineX64TrapShift)
    extension: s32 = 4
    if opcode == .ShiftRight { extension = ifx Signed(type) then 7 else 5 }
    X86ShiftCl(*state.writer, extension, destination)
    Normalize(state, destination, type)
    return true
}

Compare :: (state: *State) -> bool {
    if !Count(state, 2) { return false }
    type := TypeOf(state, OperandAt(state, 0))
    if type.class == .Float {
        left := FloatRegister(state, 0, .Use)
        right := FloatRegister(state, 1, .Use)
        if left == MachineNoId || right == MachineNoId ||
            FloatSize(TypeOf(state, OperandAt(state, 1))) != FloatSize(type) { return false }
        X86FloatCompare(*state.writer, left, right, FloatSize(type))
        state.flags_float = true
    } else {
        // The right operand is a register or a sign-extended 32-bit immediate.
        left := Register(state, 0, .Use)
        if left == MachineNoId { return false }
        immediate := OperandAt(state, 1)
        if immediate.kind == .Immediate {
            if !X86Fits32(cast(s64)immediate.immediate) { return Fail(state, .Unsupported, OperandId(state, 1)) }
            X86CompareImmediate(*state.writer, left, cast(s64)immediate.immediate)
        } else {
            right := Register(state, 1, .Use)
            if right == MachineNoId { return false }
            X86Arithmetic(*state.writer, X86Compare, left, right)
        }
        state.flags_float = false
    }
    state.flags_value = Current(state).flags_def
    state.flags_signed = Signed(type)
    return true
}

// The condition code for a flags use, which must read the flags of the
// latest Compare in this block with only transfers since.
FlagsCondition :: (state: *State) -> s32 {
    instruction := Current(state)
    if instruction.flags_use == MachineNoId || instruction.flags_use != state.flags_value {
        unused Fail(state, .Flags)
        return MachineNoId
    }
    if state.flags_float { unused Fail(state, .Unsupported); return MachineNoId }
    code := ConditionCode(instruction.condition, state.flags_signed)
    if code == MachineNoId { unused Fail(state, .Unsupported) }
    return code
}

SetCondition :: (state: *State) -> bool {
    if Current(state).operand_count != 1 && Current(state).operand_count != 2 {
        return Fail(state, .Unsupported)
    }
    destination := Register(state, 0, .Define)
    if destination == MachineNoId { return false }
    if !state.flags_float {
        if Current(state).operand_count != 1 { return Fail(state, .Unsupported) }
        code := FlagsCondition(state)
        if code == MachineNoId { return false }
        X86SetCondition(*state.writer, code, destination)
        X86Load(*state.writer, destination, X86Direct(destination), 1, false)
        return true
    }
    if Current(state).flags_use == MachineNoId || Current(state).flags_use != state.flags_value ||
        Current(state).operand_count != 2 { return Fail(state, .Flags) }
    scratch := OperandAt(state, 1)
    if scratch.kind != .Physical || scratch.class != .General ||
        scratch.id != MachineAbiScratchRegister(state.program.target) ||
        scratch.role != .Define || scratch.value != MachineNoId {
        return Fail(state, .Constraint, OperandId(state, 1))
    }
    condition := Current(state).condition
    code := ConditionCode(condition, false)
    if code == MachineNoId { return Fail(state, .Unsupported) }
    X86SetCondition(*state.writer, code, destination)
    X86Load(*state.writer, destination, X86Direct(destination), 1, false)
    if condition == .Greater || condition == .GreaterEqual { return true }
    X86SetCondition(*state.writer, ifx condition == .NotEqual then X86Parity else X86NotParity, X86R11)
    X86Load(*state.writer, X86R11, X86Direct(X86R11), 1, false)
    X86Arithmetic(*state.writer, ifx condition == .NotEqual then X86Or else X86And,
        destination, X86R11)
    return true
}

FloatConvertScratch :: (state: *State) -> bool {
    general := OperandAt(state, 2)
    floating := OperandAt(state, 3)
    return general.kind == .Physical && general.class == .General &&
        general.id == MachineAbiScratchRegister(state.program.target) &&
        general.role == .Define && general.value == MachineNoId &&
        floating.kind == .Physical && floating.class == .Float &&
        floating.id == MachineAbiScratchFloatRegister(state.program.target) &&
        floating.role == .Define && floating.value == MachineNoId
}

UnsignedIntegerToFloatHigh :: (writer: *X86Writer, destination: s32, source: s32,
    float_size: s64) {
    X86Move(writer, X86R11, source)
    X86ShiftImmediate(writer, 5, X86R11, 1)
    set_low: X86Writer = .{limit = CodeLimit}
    X86BitSet(*set_low, X86R11, 0)
    X86JumpCondition8(writer, X86AboveEqual, set_low.at)
    X86BitSet(writer, X86R11, 0)
    X86IntegerToFloat(writer, destination, X86R11, float_size, 8)
    X86FloatArithmetic(writer, destination, destination, float_size, 0x0f58)
}

UnsignedIntegerToFloat :: (state: *State, destination: s32, source: s32, float_size: s64) {
    high: X86Writer = .{limit = CodeLimit}
    UnsignedIntegerToFloatHigh(*high, destination, source, float_size)
    normal: X86Writer = .{limit = CodeLimit}
    X86IntegerToFloat(*normal, destination, source, float_size, 8)
    X86Arithmetic(*state.writer, X86Test, source, source)
    X86JumpCondition8(*state.writer, X86NotSign, high.at + 2)
    UnsignedIntegerToFloatHigh(*state.writer, destination, source, float_size)
    X86Jump8(*state.writer, normal.at)
    X86IntegerToFloat(*state.writer, destination, source, float_size, 8)
}

UnsignedFloatToIntegerHigh :: (writer: *X86Writer, destination: s32, source: s32,
    float_size: s64) {
    X86FloatArithmetic(writer, 15, source, float_size, 0x0f5c)
    X86FloatToInteger(writer, destination, 15, float_size, 8)
    X86Group3(writer, 3, destination)
    X86BitSet(writer, destination, 63)
}

UnsignedFloatToInteger :: (state: *State, destination: s32, source: s32, origin: MachineType) {
    exponent_bias := ifx origin.bits == 32 then 127 else 1023
    exponent_shift := ifx origin.bits == 32 then 23 else 52
    midpoint := cast(u64)(exponent_bias + 63) << cast(u64)exponent_shift
    X86MoveImmediate(*state.writer, X86R11, midpoint)
    X86GeneralToFloatBits(*state.writer, 15, X86R11, origin.size)
    X86FloatCompare(*state.writer, source, 15, origin.size)
    high: X86Writer = .{limit = CodeLimit}
    UnsignedFloatToIntegerHigh(*high, destination, source, origin.size)
    normal: X86Writer = .{limit = CodeLimit}
    X86FloatToInteger(*normal, destination, source, origin.size, 8)
    X86JumpCondition8(*state.writer, X86Below, high.at + 2)
    UnsignedFloatToIntegerHigh(*state.writer, destination, source, origin.size)
    X86Jump8(*state.writer, normal.at)
    X86FloatToInteger(*state.writer, destination, source, origin.size, 8)
}

FloatToIntegerValue :: (state: *State, destination: s32, source: s32,
    target: MachineType, origin: MachineType) -> bool {
    if target.kind != .Integer { return false }
    exponent := target.bits - (ifx target.is_signed then 1 else 0)
    exponent_bias := ifx origin.bits == 32 then 127 else 1023
    exponent_shift := ifx origin.bits == 32 then 23 else 52
    sign_bit := ifx origin.bits == 32 then cast(u64)1 << 31 else cast(u64)1 << 63
    bound := cast(u64)(exponent_bias + exponent) << cast(u64)exponent_shift
    lower := ifx target.is_signed then bound | sign_bit else cast(u64)0
    X86MoveImmediate(*state.writer, X86R11, lower)
    X86GeneralToFloatBits(*state.writer, 15, X86R11, origin.size)
    X86FloatCompare(*state.writer, source, 15, origin.size)
    TrapUnless(state, X86AboveEqual, MachineX64TrapConversion)
    X86MoveImmediate(*state.writer, X86R11, bound)
    X86GeneralToFloatBits(*state.writer, 15, X86R11, origin.size)
    X86FloatCompare(*state.writer, source, 15, origin.size)
    TrapUnless(state, X86NotParity, MachineX64TrapConversion)
    TrapUnless(state, X86Below, MachineX64TrapConversion)
    if target.bits == 64 && !target.is_signed {
        UnsignedFloatToInteger(state, destination, source, origin)
    } else { X86FloatToInteger(*state.writer, destination, source, origin.size, 8) }
    Normalize(state, destination, target)
    return true
}

Convert :: (state: *State, opcode: MachineOpcode) -> bool {
    if Current(state).operand_count != 2 && Current(state).operand_count != 4 {
        return Fail(state, .Unsupported)
    }
    target := TypeOf(state, OperandAt(state, 0))
    origin := TypeOf(state, OperandAt(state, 1))
    if target.kind == .Bool {
        return Fail(state, .Unsupported, OperandId(state, 0))
    }
    target_float := FloatSize(target) > 0
    origin_float := FloatSize(origin) > 0
    if !target_float && !origin_float {
        destination := Register(state, 0, .Define)
        source := Register(state, 1, .Use)
        if destination == MachineNoId || source == MachineNoId || Current(state).operand_count != 2 { return false }
        if destination != source { X86Move(*state.writer, destination, source) }
        Normalize(state, destination, target)
        return true
    }
    if opcode == .Bitcast {
        if Current(state).operand_count != 2 || target.size != origin.size {
            return Fail(state, .Unsupported, OperandId(state, 0))
        }
        if target_float {
            destination := FloatRegister(state, 0, .Define)
            source := Register(state, 1, .Use)
            if destination == MachineNoId || source == MachineNoId { return false }
            X86GeneralToFloatBits(*state.writer, destination, source, target.size)
        } else {
            destination := Register(state, 0, .Define)
            source := FloatRegister(state, 1, .Use)
            if destination == MachineNoId || source == MachineNoId { return false }
            X86FloatToGeneralBits(*state.writer, destination, source, origin.size)
            Normalize(state, destination, target)
        }
        return true
    }
    if Current(state).operand_count != 4 || !FloatConvertScratch(state) {
        return Fail(state, .Constraint, OperandId(state, 0))
    }
    if target_float && origin_float {
        destination := FloatRegister(state, 0, .Define)
        source := FloatRegister(state, 1, .Use)
        if destination == MachineNoId || source == MachineNoId { return false }
        if target.size == origin.size {
            if destination != source { X86FloatLoad(*state.writer, destination, X86Direct(source), target.size) }
        } else { X86FloatWidthConvert(*state.writer, destination, source, origin.size) }
        return true
    }
    if target_float {
        destination := FloatRegister(state, 0, .Define)
        source := Register(state, 1, .Use)
        if destination == MachineNoId || source == MachineNoId || origin.kind != .Integer {
            return Fail(state, .Unsupported, OperandId(state, 1))
        }
        if origin.bits == 64 && !origin.is_signed {
            UnsignedIntegerToFloat(state, destination, source, target.size)
        } else { X86IntegerToFloat(*state.writer, destination, source, target.size, 8) }
        return true
    }
    destination := Register(state, 0, .Define)
    source := FloatRegister(state, 1, .Use)
    if destination == MachineNoId || source == MachineNoId ||
        !FloatToIntegerValue(state, destination, source, target, origin) {
        return Fail(state, .Unsupported, OperandId(state, 0))
    }
    return true
}

// The memory of an element access whose operands LOCAL.. are base, index and
// scale shift (a folded element address).
ElementMemory :: (state: *State, local: s32, memory: *X86Operand) -> bool {
    base := Register(state, local, .Use)
    index := Register(state, local + 1, .Use)
    shift := OperandAt(state, local + 2)
    if base == MachineNoId || index == MachineNoId { return false }
    if shift.kind != .Immediate || shift.immediate > 3 { return Fail(state, .Unsupported, OperandId(state, local + 2)) }
    <<memory = X86Indexed(base, index, 0, cast(s32)shift.immediate)
    return true
}

// A scalar load or store through a folded element address: Load is
// destination, base, index, shift; Store is base, index, shift, value.
ElementAccess :: (state: *State, load: bool) -> bool {
    memory: X86Operand
    if !ElementMemory(state, ifx load then cast(s32)1 else 0, *memory) { return false }
    value_local: s32 = ifx load then 0 else 3
    value := OperandAt(state, value_local)
    size := cast(s64)(cast(u64)1 << OperandAt(state, ifx load then cast(s32)3 else 2).immediate)
    if !load && value.kind == .Immediate {
        X86StoreImmediate(*state.writer, memory, value.immediate, size)
        return true
    }
    type := TypeOf(state, value)
    if type.class == .Float {
        register := FloatRegister(state, value_local, ifx load then MachineOperandRole.Define else .Use)
        if register == MachineNoId { return false }
        if load { X86FloatLoad(*state.writer, register, memory, FloatSize(type)) }
        else { X86FloatStore(*state.writer, memory, register, FloatSize(type)) }
        return true
    }
    register := Register(state, value_local, ifx load then MachineOperandRole.Define else .Use)
    if register == MachineNoId { return false }
    if load { X86Load(*state.writer, register, memory, ScalarSize(type), Signed(type)) }
    else { X86Store(*state.writer, memory, register, ScalarSize(type)) }
    return true
}

Load :: (state: *State) -> bool {
    if Current(state).operand_count == 4 { return ElementAccess(state, true) }
    if !Count(state, 2) { return false }
    destination_operand := OperandAt(state, 0)
    address_operand := OperandAt(state, 1)
    if destination_operand.class == .Stack {
        address := Register(state, 1, .Use)
        if address == MachineNoId || destination_operand.kind != .StackObject ||
            TypeOf(state, address_operand).kind != .Pointer { return false }
        destination := StackMemory(state, destination_operand.id, OperandId(state, 0))
        if state.diagnostic.problem != .None { return false }
        return CopyMemory(state, destination, X86At(address, 0),
            state.program.stack_objects[destination_operand.id].size)
    }
    address := Register(state, 1, .Use)
    if address == MachineNoId { return false }
    if TypeOf(state, OperandAt(state, 1)).kind != .Pointer { return Fail(state, .Unsupported, OperandId(state, 1)) }
    type := TypeOf(state, OperandAt(state, 0))
    if type.class == .Float {
        destination := FloatRegister(state, 0, .Define)
        if destination == MachineNoId { return false }
        X86FloatLoad(*state.writer, destination, X86At(address, 0), FloatSize(type))
        return true
    }
    destination := Register(state, 0, .Define)
    if destination == MachineNoId { return false }
    X86Load(*state.writer, destination, X86At(address, 0), ScalarSize(type), Signed(type))
    return true
}

Store :: (state: *State) -> bool {
    if Current(state).operand_count == 4 { return ElementAccess(state, false) }
    if !Count(state, 2) { return false }
    value_operand := OperandAt(state, 1)
    if value_operand.class == .Stack {
        address := Register(state, 0, .Use)
        if address == MachineNoId || value_operand.kind != .StackObject ||
            TypeOf(state, OperandAt(state, 0)).kind != .Pointer { return false }
        source := StackMemory(state, value_operand.id, OperandId(state, 1))
        if state.diagnostic.problem != .None { return false }
        return CopyMemory(state, X86At(address, 0), source,
            state.program.stack_objects[value_operand.id].size)
    }
    address := Register(state, 0, .Use)
    if address == MachineNoId { return false }
    pointer := TypeOf(state, OperandAt(state, 0))
    if pointer.kind != .Pointer { return Fail(state, .Unsupported, OperandId(state, 0)) }
    if value_operand.kind == .Immediate {
        if pointer.element < 0 || pointer.element >= state.program.types.count {
            return Fail(state, .Unsupported, OperandId(state, 0))
        }
        X86StoreImmediate(*state.writer, X86At(address, 0), value_operand.immediate,
            ScalarSize(state.program.types[pointer.element]))
        return true
    }
    type := TypeOf(state, OperandAt(state, 1))
    if type.class == .Float {
        value := FloatRegister(state, 1, .Use)
        if value == MachineNoId { return false }
        X86FloatStore(*state.writer, X86At(address, 0), value, FloatSize(type))
        return true
    }
    value := Register(state, 1, .Use)
    if value == MachineNoId { return false }
    X86Store(*state.writer, X86At(address, 0), value, ScalarSize(type))
    return true
}

// Copies one allocated general scalar into memory. Uses may reside in either
// a physical register or a spill object after allocation.
ScalarToMemory :: (state: *State, operand: MachineOperand, operand_id: s32,
    destination: X86Operand, size: s64) -> bool {
    type := TypeOf(state, operand)
    scalar_size := ifx operand.class == .Float then FloatSize(type) else ScalarSize(type)
    if (operand.class != .General && operand.class != .Float) || operand.role != .Use ||
        scalar_size != size { return Fail(state, .Unsupported, operand_id) }
    if operand.kind == .Physical {
        if !X86Register(operand.id) { return Fail(state, .Unsupported, operand_id) }
        if operand.class == .Float { X86FloatStore(*state.writer, destination, operand.id, size) }
        else { X86Store(*state.writer, destination, operand.id, size) }
        return !state.writer.failed
    }
    if operand.kind != .StackObject || state.program.stack_objects[operand.id].size < size {
        return Fail(state, .Unsupported, operand_id)
    }
    source := StackMemory(state, operand.id, operand_id)
    if state.diagnostic.problem != .None { return false }
    return CopyMemory(state, destination, source, size)
}

// Copies one scalar member out of memory to its allocated definition.
MemoryToScalar :: (state: *State, operand: MachineOperand, operand_id: s32,
    source: X86Operand, type: MachineType) -> bool {
    size := ScalarSize(type)
    if operand.class == .Float { size = FloatSize(type) }
    if (operand.class != .General && operand.class != .Float) || operand.role != .Define || size < 0 {
        return Fail(state, .Unsupported, operand_id)
    }
    if operand.kind == .Physical {
        if !X86Register(operand.id) { return Fail(state, .Unsupported, operand_id) }
        if operand.class == .Float { X86FloatLoad(*state.writer, operand.id, source, size) }
        else { X86Load(*state.writer, operand.id, source, size, Signed(type)) }
        return !state.writer.failed
    }
    if operand.kind != .StackObject || state.program.stack_objects[operand.id].size < size {
        return Fail(state, .Unsupported, operand_id)
    }
    destination := StackMemory(state, operand.id, operand_id)
    if state.diagnostic.problem != .None { return false }
    return CopyMemory(state, destination, source, size)
}

AggregateBuild :: (state: *State) -> bool {
    instruction := Current(state)
    if instruction.operand_count < 1 { return Fail(state, .Unsupported) }
    destination := OperandAt(state, 0)
    if destination.kind != .StackObject || destination.class != .Stack || destination.role != .Define {
        return Fail(state, .Unsupported, OperandId(state, 0))
    }
    memory := StackMemory(state, destination.id, OperandId(state, 0))
    if state.diagnostic.problem != .None { return false }
    for local: 1..instruction.operand_count - 1 {
        source := OperandAt(state, local)
        member: s32
        offset: s64
        if !Member(state, TypeIdOf(state, destination), cast(u64)(local - 1), *member, *offset) ||
            TypeIdOf(state, source) != member {
            return Fail(state, .Unsupported, OperandId(state, local))
        }
        size := state.program.types[member].size
        if source.class == .Stack {
            if source.kind != .StackObject { return Fail(state, .Unsupported, OperandId(state, local)) }
            source_memory := StackMemory(state, source.id, OperandId(state, local))
            if state.diagnostic.problem != .None || !CopyMemory(state, AtOffset(memory, offset), source_memory, size) {
                return false
            }
        } else {
            if !ScalarToMemory(state, source, OperandId(state, local),
                AtOffset(memory, offset), size) { return false }
        }
    }
    aggregate := state.program.types[TypeIdOf(state, destination)]
    member_count := aggregate.count
    if aggregate.kind != .Array { member_count = cast(s64)aggregate.fields_count }
    return instruction.operand_count - 1 == member_count
}

// The memory and type of the aggregate operand LOCAL names: its frame object,
// or the pointee of a view's address held in a pointer register.
AggregateAt :: (state: *State, local: s32, memory: *X86Operand, type: *s32) -> bool {
    operand := OperandAt(state, local)
    if operand.class == .General {
        base := Register(state, local, .Use)
        if base == MachineNoId { return false }
        pointer := TypeOf(state, operand)
        if pointer.kind != .Pointer || pointer.element < 0 { return Fail(state, .Unsupported, OperandId(state, local)) }
        <<memory = X86At(base, 0)
        <<type = pointer.element
        return true
    }
    if operand.kind != .StackObject || operand.class != .Stack { return Fail(state, .Unsupported, OperandId(state, local)) }
    <<memory = StackMemory(state, operand.id, OperandId(state, local))
    <<type = TypeIdOf(state, operand)
    return state.diagnostic.problem == .None
}

// The memory and type of the member the current instruction names in the
// aggregate of TYPE at MEMORY: its last operand, an immediate member, or
// with operands INDEX, r10, r11 before it, an array element: bounds-checked
// when that immediate is 0, else the bound the shared facts prove the index
// below. Its address is then in r11, or in r10 when the access itself copies
// through r11 (COPIES).
MemberMemory :: (state: *State, memory: X86Operand, type: s32, index: s32, copies: bool,
    member: *s32, result: *X86Operand) -> bool {
    count := Current(state).operand_count
    immediate := OperandAt(state, count - 1)
    if immediate.kind != .Immediate { return Fail(state, .Unsupported) }
    offset: s64
    if count == index + 1 {
        if !Member(state, type, immediate.immediate, member, *offset) {
            return Fail(state, .Unsupported, OperandId(state, count - 1))
        }
        <<result = AtOffset(memory, offset)
        return true
    }
    dynamic := Register(state, index, .Use)
    scratch_address := OperandAt(state, index + 1)
    scratch_copy := OperandAt(state, index + 2)
    aggregate := state.program.types[type]
    if count != index + 4 || dynamic == MachineNoId || aggregate.kind != .Array || aggregate.element < 0 ||
        memory.kind != .Base || immediate.immediate > cast(u64)aggregate.count ||
        scratch_address.kind != .Physical || scratch_address.role != .Define ||
        scratch_address.id != MachineAbiAddressScratchRegister(state.program.target) ||
        scratch_copy.kind != .Physical || scratch_copy.role != .Define ||
        scratch_copy.id != MachineAbiScratchRegister(state.program.target) {
        return Fail(state, .Unsupported)
    }
    <<member = aggregate.element
    size := state.program.types[aggregate.element].size
    if immediate.immediate == 0 {
        X86CompareImmediate(*state.writer, dynamic, aggregate.count)
        TrapUnless(state, X86Below, MachineX64TrapReserved - 1)
    }
    // A 1-, 2-, 4- or 8-byte element is addressed by scaling the index.
    shift := X86ScaleShift(size)
    if shift >= 0 {
        <<result = X86Indexed(memory.register, dynamic, memory.displacement, shift)
        return true
    }
    X86MultiplyImmediate(*state.writer, X86R11, dynamic, size)
    address := ifx copies then cast(s32)10 else X86R11
    X86Lea(*state.writer, address, X86Indexed(memory.register, X86R11, memory.displacement))
    <<result = X86At(address, 0)
    return true
}

// destination = a member of an aggregate in a frame object or at a view's
// address: destination, aggregate[, index, r10, r11], member.
AggregateExtract :: (state: *State) -> bool {
    destination := OperandAt(state, 0)
    memory: X86Operand
    type: s32
    member: s32
    if !AggregateAt(state, 1, *memory, *type) ||
        !MemberMemory(state, memory, type, 2, destination.kind == .StackObject, *member, *memory) { return false }
    if destination.class == .Stack {
        if destination.kind != .StackObject { return Fail(state, .Unsupported, OperandId(state, 0)) }
        return CopyMemory(state, StackMemory(state, destination.id, OperandId(state, 0)), memory,
            state.program.types[member].size)
    }
    return MemoryToScalar(state, destination, OperandId(state, 0), memory, state.program.types[member])
}

// destination = aggregate with one member replaced: destination, aggregate,
// value[, index, r10, r11], member. An insert stored in its source's object
// changes only that member. Through a view's address the member is replaced
// in place: address, value[, index, r10, r11], member.
AggregateInsert :: (state: *State) -> bool {
    first := OperandAt(state, 0)
    value_local: s32 = 2
    memory: X86Operand
    type: s32
    if first.class == .General {
        value_local = 1
        if !AggregateAt(state, 0, *memory, *type) { return false }
    } else {
        source: X86Operand
        if first.kind != .StackObject || first.class != .Stack || first.role != .Define ||
            !AggregateAt(state, 1, *source, *type) { return Fail(state, .Unsupported) }
        aggregate := OperandAt(state, 1)
        memory = StackMemory(state, first.id, OperandId(state, 0))
        size := state.program.stack_objects[first.id].size
        if state.diagnostic.problem != .None { return false }
        if state.program.stack_objects[aggregate.id].size != size { return Fail(state, .Unsupported, OperandId(state, 1)) }
        if first.id != aggregate.id && !CopyMemory(state, memory, source, size) { return false }
    }
    value := OperandAt(state, value_local)
    member: s32
    if !MemberMemory(state, memory, type, value_local + 1, value.kind == .StackObject, *member, *memory) { return false }
    size := state.program.types[member].size
    if value.class == .Stack {
        if value.kind != .StackObject { return Fail(state, .Unsupported, OperandId(state, value_local)) }
        return CopyMemory(state, memory, StackMemory(state, value.id, OperandId(state, value_local)), size)
    }
    return ScalarToMemory(state, value, OperandId(state, value_local), memory, size)
}

FieldAddress :: (state: *State) -> bool {
    if !Count(state, 3) { return false }
    destination := Register(state, 0, .Define)
    base := Register(state, 1, .Use)
    index := OperandAt(state, 2)
    if destination == MachineNoId || base == MachineNoId || index.kind != .Immediate { return false }
    pointer := TypeOf(state, OperandAt(state, 1))
    member: s32
    offset: s64
    if pointer.kind != .Pointer || !Member(state, pointer.element, index.immediate, *member, *offset) {
        return Fail(state, .Unsupported, OperandId(state, 2))
    }
    X86Lea(*state.writer, destination, X86At(base, offset))
    return true
}

ElementAddress :: (state: *State) -> bool {
    instruction := Current(state)
    if instruction.operand_count < 3 || instruction.operand_count > 5 { return Fail(state, .Unsupported) }
    destination := Register(state, 0, .Define)
    base := Register(state, 1, .Use)
    low := Register(state, 2, .Use)
    if destination == MachineNoId || base == MachineNoId || low == MachineNoId { return false }
    pointer := TypeOf(state, OperandAt(state, 0))
    if pointer.kind != .Pointer || pointer.element < 0 { return Fail(state, .Unsupported, OperandId(state, 0)) }
    size := state.program.types[pointer.element].size
    if size <= 0 || size > 2147483647 { return Fail(state, .Unsupported, OperandId(state, 0)) }
    if instruction.operand_count == 3 {
        source_pointer := TypeOf(state, OperandAt(state, 1))
        if source_pointer.kind != .Pointer || source_pointer.element < 0 ||
            state.program.types[source_pointer.element].kind != .Array {
            return Fail(state, .Unsupported, OperandId(state, 1))
        }
        count := state.program.types[source_pointer.element].count
        X86CompareImmediate(*state.writer, low, count)
        TrapUnless(state, X86Below, MachineX64TrapReserved - 1)
    } else if instruction.operand_count == 4 && OperandAt(state, 3).kind == .Immediate {
        // The shared facts prove the index below this bound: no check.
    } else if instruction.operand_count == 4 {
        count := Register(state, 3, .Use)
        if count == MachineNoId { return false }
        X86Arithmetic(*state.writer, X86Compare, low, count)
        TrapUnless(state, X86Below, MachineX64TrapReserved - 1)
    } else {
        high := Register(state, 3, .Use)
        count := Register(state, 4, .Use)
        if high == MachineNoId || count == MachineNoId { return false }
        X86Arithmetic(*state.writer, X86Compare, low, high)
        TrapUnless(state, X86BelowEqual, MachineX64TrapReserved - 1)
        X86Arithmetic(*state.writer, X86Compare, high, count)
        TrapUnless(state, X86BelowEqual, MachineX64TrapReserved - 1)
    }
    shift := X86ScaleShift(size)
    if shift >= 0 {
        X86Lea(*state.writer, destination, X86Indexed(base, low, 0, shift))
        return true
    }
    X86MultiplyImmediate(*state.writer, X86R11, low, size)
    X86Lea(*state.writer, destination, X86Indexed(base, X86R11, 0))
    return true
}

BytesEqual :: (state: *State) -> bool {
    if !Count(state, 8) { return false }
    result := Register(state, 0, .Define)
    left := Register(state, 1, .Use)
    left_count := Register(state, 2, .Use)
    right := Register(state, 3, .Use)
    right_count := Register(state, 4, .Use)
    if result != MachineAbiResultRegister(state.program.target, .General) ||
        left != MachineAbiFormFixedRegister(state.program.target, .BytesEqual, 0) ||
        left_count != MachineAbiFormFixedRegister(state.program.target, .BytesEqual, 1) ||
        right != MachineAbiFormFixedRegister(state.program.target, .BytesEqual, 2) ||
        right_count != MachineAbiFormFixedRegister(state.program.target, .BytesEqual, 3) {
        return Fail(state, .Constraint)
    }
    target := state.program.target
    clobbers: [3]s32 = .[MachineAbiFormClobberRegister(target, .BytesEqual, 0),
        MachineAbiFormClobberRegister(target, .BytesEqual, 1),
        MachineAbiFormClobberRegister(target, .BytesEqual, 2)]
    for local: 5..7 {
        operand := OperandAt(state, cast(s32)local)
        if operand.kind != .Physical || operand.role != .Define || operand.value != MachineNoId ||
            operand.id != clobbers[local - 5] {
            return Fail(state, .Constraint, OperandId(state, cast(s32)local))
        }
    }
    X86Arithmetic(*state.writer, X86Compare, left_count, right_count)
    X86JumpCondition8(*state.writer, X86NotEqual, 2)
    X86Byte(*state.writer, 243)
    X86Byte(*state.writer, 166)
    X86SetCondition(*state.writer, X86Equal, X86Rax)
    X86Load(*state.writer, X86Rax, X86Direct(X86Rax), 1, false)
    X86Jump8(*state.writer, 2)
    X86Encode(*state.writer, 0, false, X86Xor, 1, X86Rax, X86Direct(X86Rax))
    return true
}

Resize :: (state: *State) -> bool {
    if !Count(state, 13) { return false }
    result := Register(state, 0, .Define)
    pointer := Register(state, 1, .Use)
    old_count := Register(state, 2, .Use)
    new_count := Register(state, 3, .Use)
    if result != MachineAbiResultRegister(state.program.target, .General) ||
        pointer != MachineAbiFormFixedRegister(state.program.target, .Resize, 0) ||
        old_count != MachineAbiFormFixedRegister(state.program.target, .Resize, 1) ||
        new_count != MachineAbiFormFixedRegister(state.program.target, .Resize, 2) {
        return Fail(state, .Constraint)
    }
    resize_target := state.program.target
    clobbers: [8]s32 = .[MachineAbiFormClobberRegister(resize_target, .Resize, 0),
        MachineAbiFormClobberRegister(resize_target, .Resize, 1),
        MachineAbiFormClobberRegister(resize_target, .Resize, 2),
        MachineAbiFormClobberRegister(resize_target, .Resize, 3),
        MachineAbiFormClobberRegister(resize_target, .Resize, 4),
        MachineAbiFormClobberRegister(resize_target, .Resize, 5),
        MachineAbiFormClobberRegister(resize_target, .Resize, 6),
        MachineAbiFormClobberRegister(resize_target, .Resize, 7)]
    for local: 4..11 {
        operand := OperandAt(state, cast(s32)local)
        if operand.kind != .Physical || operand.role != .Define || operand.value != MachineNoId ||
            operand.id != clobbers[local - 4] {
            return Fail(state, .Constraint, OperandId(state, cast(s32)local))
        }
    }
    runtime := OperandAt(state, 12)
    if runtime.kind != .Immediate || runtime.role != .Use || runtime.immediate != 0 ||
        Relocation(state, .RuntimeResize, OperandId(state, 12), true) == MachineNoId {
        return Fail(state, .Relocation, OperandId(state, 12))
    }
    pointer_type := TypeOf(state, OperandAt(state, 0))
    if pointer_type.kind != .Pointer || pointer_type.element < 0 ||
        pointer_type.element >= state.program.types.count { return Fail(state, .Unsupported) }
    element := state.program.types[pointer_type.element]
    if element.size < 0 || element.size > 2147483647 { return Fail(state, .Unsupported) }
    writer := *state.writer
    if !state.program.checks {
        // rdi is the old block's address; rax becomes the new one's.
        X86MoveImmediate(writer, X86Rcx, cast(u64)element.size)
        X86Call32(writer, state.writer.at + 5)
        Relocate(state, .RuntimeResize, 0, -4, state.writer.at - 4)
        return true
    }
    // rdi is the old block's token: unless null it must name a live heap
    // block at offset 0, and rdi becomes the block's address. Its slot ends
    // only once the runtime has freed or moved the block; a request that
    // does not fit gives null and leaves the old block valid, as on the
    // portable engine.
    X86Push(writer, X86Rdi)
    X86Arithmetic(writer, X86Test, X86Rdi, X86Rdi)
    saved := Probe(state)
    CheckHeapSlot(state)
    length := Unprobe(state, saved)
    SkipIf(writer, X86Equal, length)
    CheckHeapSlot(state)
    X86MoveImmediate(writer, X86Rcx, cast(u64)element.size)
    X86Push(writer, X86Rdx)
    X86Push(writer, X86Rcx)
    X86Push(writer, X86Rcx)
    X86Call32(writer, state.writer.at + 5)
    Relocate(state, .RuntimeResize, 0, -4, state.writer.at - 4)
    X86Encode(writer, 0, false, 0x8f, 1, 0, X86Direct(X86Rcx))
    X86Encode(writer, 0, false, 0x8f, 1, 0, X86Direct(X86Rcx))
    X86Encode(writer, 0, false, 0x8f, 1, 0, X86Direct(X86Rdx))
    X86Encode(writer, 0, false, 0x8f, 1, 0, X86Direct(8))
    // Failed: null with a nonzero count; nothing changes.
    saved = Probe(state)
    ResizeSlots(state)
    length = Unprobe(state, saved)
    // rax nonzero: skip `test rdx, rdx` (3 bytes) and its 6-byte jump.
    X86Arithmetic(writer, X86Test, X86Rax, X86Rax)
    SkipIf(writer, X86NotEqual, 9)
    X86Arithmetic(writer, X86Test, X86Rdx, X86Rdx)
    SkipIf(writer, X86NotEqual, length)
    ResizeSlots(state)
    return true
}

// After a successful resize (rax the new block or null when freed, rdx the
// new count, rcx the element size, r8 the old token): end the old slot and
// give a new block a heap slot; rax becomes its token.
ResizeSlots :: (state: *State) {
    writer := *state.writer
    X86Multiply(writer, X86Rdx, X86Rcx)
    X86Move(writer, 9, X86Rdx)
    X86Arithmetic(writer, X86Test, 8, 8)
    saved := Probe(state)
    RetireToken(state)
    length := Unprobe(state, saved)
    SkipIf(writer, X86Equal, length)
    RetireToken(state)
    X86Arithmetic(writer, X86Test, X86Rax, X86Rax)
    saved = Probe(state)
    HeapSlot(state)
    length = Unprobe(state, saved)
    SkipIf(writer, X86Equal, length)
    HeapSlot(state)
}

// Ends the slot of the token in r8.
RetireToken :: (state: *State) {
    writer := *state.writer
    PointerHeader(state)
    X86Move(writer, PointerScratch, 8)
    X86ShiftImmediate(writer, 5, PointerScratch, MachinePointerSlotShift)
    X86Move(writer, X86Rcx, PointerScratch)
    X86ShiftImmediate(writer, 4, X86Rcx, 5)
    X86Encode(writer, 0, true, 3, 1, X86Rcx, X86At(X86R11, MachinePointerHeaderTable))
    RetireSlot(state)
}

CheckHeapSlot :: (state: *State) {
    writer := *state.writer
    PointerHeader(state)
    X86Move(writer, PointerScratch, X86Rdi)
    X86ShiftImmediate(writer, 5, PointerScratch, MachinePointerSlotShift)
    X86Encode(writer, 0, true, 59, 1, PointerScratch, X86At(X86R11, MachinePointerHeaderCapacity))
    TrapUnless(state, X86Below, MachineX64TrapPointer)
    X86Move(writer, X86Rax, PointerScratch)
    X86ShiftImmediate(writer, 4, X86Rax, 5)
    X86Encode(writer, 0, true, 3, 1, X86Rax, X86At(X86R11, MachinePointerHeaderTable))
    X86Move(writer, 8, X86Rdi)
    X86ShiftImmediate(writer, 5, 8, MachinePointerVersionShift)
    X86Encode(writer, 0, false, 0x81, 1, 4, X86Direct(8))
    X86Little(writer, MachinePointerVersionMask, 4)
    X86Encode(writer, 102, false, 59, 1, 8, X86At(X86Rax, MachinePointerEntryVersion))
    TrapUnless(state, X86Equal, MachineX64TrapPointer)
    // Live, and heap storage.
    for bit: 0..2 {
        if bit == 1 { continue }
        X86Encode(writer, 0, false, 0xf6, 1, 0, X86At(X86Rax, MachinePointerEntryFlags))
        X86Byte(writer, cast(u8)(1 << bit))
        TrapUnless(state, X86NotEqual, MachineX64TrapPointer)
    }
    X86Load(writer, 8, X86Direct(X86Rdi), 4, false)
    X86Arithmetic(writer, X86Test, 8, 8)
    TrapUnless(state, X86Equal, MachineX64TrapPointer)
    X86Load(writer, X86Rdi, X86At(X86Rax, MachinePointerEntryBase), 8, false)
}

// rax = the token of a new heap slot for r9 bytes at rax.
HeapSlot :: (state: *State) {
    writer := *state.writer
    X86Push(writer, 9)
    X86Push(writer, X86Rax)
    CreateSlot(state, X86Rax, 0, true, MachinePointerLive | MachinePointerWritable | MachinePointerHeap,
        X86Direct(X86Rax), false)
}

// Zero: clears every byte the pointer operand addresses, through the reserved
// r11 scratch, as an `allocate` without an initial value requires.
Zero :: (state: *State) -> bool {
    if !Count(state, 1) { return false }
    pointer := Register(state, 0, .Use)
    if pointer == MachineNoId { return false }
    type := TypeOf(state, OperandAt(state, 0))
    if type.kind != .Pointer || type.element < 0 || type.element >= state.program.types.count {
        return Fail(state, .Unsupported, OperandId(state, 0))
    }
    size := state.program.types[type.element].size
    if size < 0 || size > 2147483647 { return Fail(state, .Unsupported, OperandId(state, 0)) }
    return ZeroMemory(state, X86At(pointer, 0), size)
}

StackAddress :: (state: *State) -> bool {
    if !Count(state, 2) { return false }
    destination := Register(state, 0, .Define)
    if destination == MachineNoId { return false }
    object := OperandAt(state, 1)
    if object.kind != .StackObject || object.role != .Use { return Fail(state, .Unsupported, OperandId(state, 1)) }
    memory := StackMemory(state, object.id, OperandId(state, 1))
    if state.diagnostic.problem != .None { return false }
    X86Lea(*state.writer, destination, memory)
    return true
}

FunctionAddress :: (state: *State) -> bool {
    if !Count(state, 2) { return false }
    destination := Register(state, 0, .Define)
    if destination == MachineNoId { return false }
    symbol := OperandAt(state, 1)
    if symbol.kind != .Function || symbol.role != .Use { return Fail(state, .Unsupported, OperandId(state, 1)) }
    if Relocation(state, .FunctionAddress, OperandId(state, 1), true) == MachineNoId { return false }
    X86Lea(*state.writer, destination, X86RipTarget(FunctionTarget(state, symbol.id)))
    return true
}

GlobalAddress :: (state: *State) -> bool {
    if !Count(state, 2) { return false }
    destination := Register(state, 0, .Define)
    if destination == MachineNoId { return false }
    symbol := OperandAt(state, 1)
    if symbol.kind != .Global || symbol.role != .Use { return Fail(state, .Unsupported, OperandId(state, 1)) }
    relocation_id := state.relocation_of[state.instruction]
    if relocation_id < 0 { return Fail(state, .Relocation, OperandId(state, 1)) }
    machine_kind := state.program.relocations[relocation_id].kind
    if machine_kind != .GlobalAddress && machine_kind != .ConstantAddress {
        return Fail(state, .Relocation, OperandId(state, 1))
    }
    id := Relocation(state, machine_kind, OperandId(state, 1), false)
    if id == MachineNoId { return false }
    addend := state.program.relocations[id].addend
    if addend < -2147483648 || addend > 2147483647 { return Fail(state, .Relocation, OperandId(state, 1)) }
    X86Lea(*state.writer, destination, X86RipRelocated())
    kind: MachineX64RelocationKind = ifx machine_kind == .GlobalAddress then .GlobalAddress else .ConstantAddress
    Relocate(state, kind, symbol.id, addend - 4, state.writer.at - 4)
    return true
}

// sub qword [rip + counter], amount; continue unless it borrowed.
Fuel :: (state: *State) -> bool {
    if !Count(state, 2) { return false }
    amount := OperandAt(state, 0)
    counter := OperandAt(state, 1)
    if amount.kind != .Immediate || counter.kind != .Immediate || amount.immediate == 0 ||
        amount.immediate > 9223372036854775807 { return Fail(state, .Unsupported, OperandId(state, 0)) }
    id := Relocation(state, .FuelCounter, OperandId(state, 1), true)
    if id == MachineNoId { return false }
    symbol := state.program.relocations[id].symbol
    value := cast(s64)amount.immediate
    if state.fuel_register {
        // The budget is in the fuel register: subtract there, trap on borrow.
        register := MachineAbiFuelRegister(state.program.target)
        if value <= 2147483647 { X86ArithmeticImmediate(*state.writer, X86Subtract, register, value) }
        else {
            X86MoveImmediate(*state.writer, X86R11, amount.immediate)
            X86Arithmetic(*state.writer, X86Subtract, register, X86R11)
        }
        block := state.program.blocks[state.block]
        if FuelStub(state, state.block) && state.instruction == block.instruction_begin {
            X86JumpCondition32(*state.writer, X86Below, state.instruction_begin[state.instruction])
        } else { TrapUnless(state, X86AboveEqual, MachineX64TrapFuel) }
        return true
    }
    trailing: s64 = 0
    if value <= 2147483647 {
        trailing = ifx X86Fits8(value) then cast(s64)1 else 4
        X86SubtractImmediate(*state.writer, X86RipRelocated(), value)
    } else {
        X86MoveImmediate(*state.writer, X86R11, amount.immediate)
        X86SubtractRegister(*state.writer, X86RipRelocated(), X86R11)
    }
    Relocate(state, .FuelCounter, symbol, -4 - trailing, state.writer.at - 4 - trailing)
    TrapUnless(state, X86AboveEqual, MachineX64TrapFuel)
    return true
}

Call :: (state: *State) -> bool {
    instruction := Current(state)
    call := state.program.calls[instruction.call]
    indirect := instruction.opcode == .CallIndirect
    target: s32 = MachineNoId
    outgoing: s32 = MachineNoId
    for local: 0..instruction.operand_count - 1 {
        id := instruction.operand_begin + local
        if id >= call.argument_begin && id < call.argument_begin + call.argument_count || id == call.result_operand { continue }
        operand := state.program.operands[id]
        if operand.kind == .StackObject && operand.class == .Stack && operand.role == .Use {
            if outgoing != MachineNoId { return Fail(state, .Call, id) }
            outgoing = operand.id
        }
    }
    integer_ordinal: s32
    float_ordinal: s32
    stack_offset: s64
    // A stack result's address passes in rax. The allocator may keep a stack
    // argument's value in rax, so the address is loaded only after every
    // argument is stored, just before the call.
    result_address := false
    result_destination: X86Operand
    for local: 0..instruction.operand_count - 1 {
        id := instruction.operand_begin + local
        operand := state.program.operands[id]
        if id == call.result_operand {
            if operand.class == .Stack {
                if (call.calling != .Internal && call.calling != .Host) ||
                    operand.kind != .StackObject || operand.role != .Define {
                    return Fail(state, .Unsupported, id)
                }
                result_destination = StackMemory(state, operand.id, id)
                if state.diagnostic.problem != .None { return false }
                result_address = true
            } else if operand.class == .Float {
                result := FloatRegister(state, local, .Define)
                if result == MachineNoId { return false }
                if result != 0 { return Fail(state, .Constraint, id) }
            } else {
                result := Register(state, local, .Define)
                if result == MachineNoId { return false }
                if result != X86Rax { return Fail(state, .Constraint, id) }
            }
        } else if id >= call.argument_begin && id < call.argument_begin + call.argument_count {
            ordinal := integer_ordinal
            if operand.class == .Float { ordinal = float_ordinal; float_ordinal += 1 }
            else if operand.class == .General { integer_ordinal += 1 }
            expected := MachineAbiArgumentRegister(state.program.target, operand.class, ordinal)
            if (operand.class == .General || operand.class == .Float) && expected >= 0 {
                argument := ifx operand.class == .Float then FloatRegister(state, local, .Use) else Register(state, local, .Use)
                if argument == MachineNoId { return false }
                if argument != expected { return Fail(state, .Constraint, id) }
                continue
            }
            // An empty record or array passes no bytes.
            if operand.class == .Stack && TypeOf(state, operand).size == 0 { continue }
            if outgoing == MachineNoId || operand.value == MachineNoId ||
                outgoing < 0 || outgoing >= state.program.stack_objects.count {
                return Fail(state, .Frame, id)
            }
            type := TypeOf(state, operand)
            size := StackArgumentSize(type.size)
            if size < 0 || stack_offset > call.stack_argument_bytes - size { return Fail(state, .Frame, id) }
            destination := AtOffset(StackMemory(state, outgoing, id), stack_offset)
            if state.diagnostic.problem != .None { return false }
            if operand.class == .Stack {
                if operand.kind != .StackObject || operand.role != .Use ||
                    !CopyMemory(state, destination, StackMemory(state, operand.id, id), type.size) { return false }
            } else if operand.class == .General {
                source: s32 = X86R11
                if operand.kind == .Physical && operand.role == .Use { source = operand.id }
                else if operand.kind == .StackObject && operand.role == .Use {
                    X86Load(*state.writer, X86R11, StackMemory(state, operand.id, id), 8, false)
                } else { return Fail(state, .Unsupported, id) }
                X86Store(*state.writer, destination, source, cast(s32)8)
            } else if operand.class == .Float {
                if operand.kind == .Physical && operand.role == .Use {
                    X86FloatStore(*state.writer, destination, operand.id, type.size)
                } else if operand.kind == .StackObject && operand.role == .Use {
                    if !CopyMemory(state, destination, StackMemory(state, operand.id, id), type.size) { return false }
                } else { return Fail(state, .Unsupported, id) }
            } else { return Fail(state, .Unsupported, id) }
            stack_offset += size
        } else {
            if operand.kind == .StackObject && operand.id == outgoing { continue }
            if target != MachineNoId { return Fail(state, .Unsupported, id) }
            target = id
            if indirect {
                if Register(state, local, .Use) == MachineNoId { return false }
            } else if operand.kind != .Function || operand.role != .Use {
                return Fail(state, .Unsupported, id)
            }
        }
    }
    if stack_offset != call.stack_argument_bytes { return Fail(state, .Frame) }
    if target == MachineNoId { return Fail(state, .Call) }
    if indirect && result_address && state.program.operands[target].id == X86Rax { return Fail(state, .Constraint, target) }
    if result_address { X86Lea(*state.writer, X86Rax, result_destination) }
    // Another function or the host may spend the step budget; a platform
    // service never does. A tail call stores it as it leaves.
    tail := !indirect && state.program.functions[state.function].arena_mark == 0 &&
        TailCallAt(state.program, state.block, state.instruction)
    synced := call.calling != .Platform
    if synced && !tail { FuelStore(state) }
    if indirect {
        X86CallRegister(*state.writer, state.program.operands[target].id)
        FuelReload(state)
        return true
    }
    machine_kind := MachineRelocationKind.FunctionCall
    image_kind := MachineX64RelocationKind.Invalid
    if call.calling == .Platform {
        machine_kind = .PlatformService
        image_kind = .PlatformService
    } else if call.calling == .Host {
        machine_kind = .HostCapability
        image_kind = .HostCapability
    }
    if Relocation(state, machine_kind, target, true) == MachineNoId { return false }
    if tail {
        if !Epilogue(state) { return false }
        state.tail_returned = true
    }
    if call.calling == .Internal {
        address := FunctionTarget(state, state.program.operands[target].id)
        if tail { X86Jump32(*state.writer, address) } else { X86Call32(*state.writer, address) }
    } else {
        if tail { X86Jump32(*state.writer, state.writer.at + 5) } else { X86Call32(*state.writer, state.writer.at + 5) }
        Relocate(state, image_kind, state.program.operands[target].id, -4, state.writer.at - 4)
    }
    if synced && !tail { FuelReload(state) }
    return true
}

// Whether BLOCK, past the first of its function, starts with the fuel check
// of a function keeping its budget in the fuel register. Its trap then opens
// the block, inside that check's range, and jumps enter past it, so a loop
// header spends no taken branch on it.
FuelStub :: (state: *State, block: s32) -> bool {
    if !state.fuel_register || block == state.program.functions[state.function].block_begin { return false }
    first := state.program.blocks[block]
    return first.instruction_count > 0 && state.program.instructions[first.instruction_begin].opcode == .Fuel
}

// Whether control falls from the current block into TARGET: it is the next
// block, or each block before it is a lone jump to it, which emits nothing.
// A fuel trap before TARGET's label must be jumped over.
Falls :: (state: *State, target: s32) -> bool {
    if FuelStub(state, target) { return false }
    function := state.program.functions[state.function]
    end := function.block_begin + function.block_count
    block := state.block + 1
    while block < end && block != target {
        if Forward(state, block) != target { return false }
        block += 1
    }
    return block == target
}

// The block BLOCK only jumps to: it holds nothing but moves of a register
// to itself and a closing jump, so it emits at most that jump; otherwise -1.
LoneJump :: (state: *State, block: s32) -> s32 {
    lone := state.program.blocks[block]
    if lone.instruction_count == 0 || FuelStub(state, block) { return MachineNoId }
    last := lone.instruction_begin + lone.instruction_count - 1
    for at: lone.instruction_begin..last - 1 {
        move := state.program.instructions[at]
        if move.opcode != .Move || move.operand_count != 2 { return MachineNoId }
        destination := state.program.operands[move.operand_begin]
        source := state.program.operands[move.operand_begin + 1]
        if destination.kind != .Physical || source.kind != .Physical || destination.id != source.id ||
            destination.class != source.class { return MachineNoId }
    }
    jump := state.program.instructions[last]
    if jump.opcode != .Jump { return MachineNoId }
    return state.program.edges[jump.edge_begin].target
}

// Where a jump to BLOCK really goes: past every lone jump (edge copies are
// already moves), so control takes one branch instead of a chain. A cycle
// of lone jumps stays where it is.
Forward :: (state: *State, block: s32) -> s32 {
    function := state.program.functions[state.function]
    target := block
    for step: 0..function.block_count - 1 {
        next := LoneJump(state, target)
        if next == MachineNoId { return target }
        target = next
    }
    return block
}

JumpTo :: (state: *State, block: s32) {
    target := Forward(state, block)
    if !Falls(state, target) { X86Jump32(*state.writer, BlockTarget(state, target)) }
}

Branch :: (state: *State) -> bool {
    instruction := Current(state)
    condition: s32 = MachineNoId
    if instruction.operand_count == 1 && instruction.flags_use == MachineNoId {
        value := Register(state, 0, .Use)
        if value == MachineNoId { return false }
        X86Arithmetic(*state.writer, X86Test, value, value)
        condition = X86NotEqual
    } else if instruction.operand_count == 0 {
        condition = FlagsCondition(state)
        if condition == MachineNoId { return false }
    } else {
        return Fail(state, .Unsupported)
    }
    taken := Forward(state, state.program.edges[instruction.edge_begin].target)
    other := Forward(state, state.program.edges[instruction.edge_begin + 1].target)
    if Falls(state, other) {
        X86JumpCondition32(*state.writer, condition, BlockTarget(state, taken))
    } else if Falls(state, taken) {
        X86JumpCondition32(*state.writer, condition ^ 1, BlockTarget(state, other))
    } else {
        X86JumpCondition32(*state.writer, condition, BlockTarget(state, taken))
        X86Jump32(*state.writer, BlockTarget(state, other))
    }
    return true
}

CalleeSaves :: (state: *State, restore: bool) -> bool {
    function := state.program.functions[state.function]
    for object_id: function.stack_begin..function.stack_begin + function.stack_count - 1 {
        object := state.program.stack_objects[object_id]
        if object.kind != .CalleeSave { continue }
        if !Spend(state, 1) { return false }
        register := object.value % MachineBankWidth
        if object.value / MachineBankWidth != 0 || !X86Register(register) { return Fail(state, .Frame) }
        memory := StackMemory(state, object_id, MachineNoId)
        if state.diagnostic.problem != .None { return false }
        if restore { X86Load(*state.writer, register, memory, 8, false) }
        else { X86Store(*state.writer, memory, register, 8) }
    }
    return true
}

Return :: (state: *State) -> bool {
    if state.tail_returned { state.tail_returned = false; return true }
    instruction := Current(state)
    if instruction.operand_count > 1 { return Fail(state, .Unsupported) }
    if instruction.operand_count == 1 {
        operand := OperandAt(state, 0)
        if operand.class == .Stack {
            function := state.program.functions[state.function]
            if operand.kind != .StackObject || operand.role != .Use ||
                function.result_type < 0 || function.result_type >= state.program.types.count {
                return Fail(state, .Unsupported, OperandId(state, 0))
            }
            address: s32 = MachineNoId
            for object_id: function.stack_begin..function.stack_begin + function.stack_count - 1 {
                if state.program.stack_objects[object_id].kind == .ResultAddress {
                    if address != MachineNoId { return Fail(state, .Frame) }
                    address = object_id
                }
            }
            size := state.program.types[function.result_type].size
            if address == MachineNoId || state.program.stack_objects[operand.id].size != size {
                return Fail(state, .Frame, OperandId(state, 0))
            }
            X86Load(*state.writer, X86Rax, StackMemory(state, address, OperandId(state, 0)), 8, false)
            if state.diagnostic.problem != .None || !CopyMemory(state, X86At(X86Rax, 0),
                StackMemory(state, operand.id, OperandId(state, 0)), size) { return false }
        } else {
            if operand.class == .Float {
                value := FloatRegister(state, 0, .Use)
                if value == MachineNoId { return false }
                if value != 0 { return Fail(state, .Constraint, OperandId(state, 0)) }
            } else {
                value := Register(state, 0, .Use)
                if value == MachineNoId { return false }
                if value != X86Rax { return Fail(state, .Constraint, OperandId(state, 0)) }
            }
        }
    }
    if !Epilogue(state) { return false }
    X86Return(*state.writer)
    return true
}

// Leaves the frame before a return or a tail call: the step budget goes back
// to memory, the pointer frame and callee-saved registers are restored.
Epilogue :: (state: *State) -> bool {
    function := state.program.functions[state.function]
    FuelStore(state)
    if function.arena_mark != 0 && !PointerFrameLeave(state, function) { return false }
    if !CalleeSaves(state, true) { return false }
    if !state.frameless { X86Leave(*state.writer) }
    return true
}

// Whether the direct call at AT is its function's last act: the next
// instruction of its block returns the call's register result (or nothing),
// and it passes nothing on the stack and returns nothing in memory. It then
// leaves the frame and jumps, and the callee returns to this function's
// caller with the stack as a direct call would leave it.
TailCallAt :: (program: MachineProgram, block_id: s32, at: s32) -> bool {
    instruction := program.instructions[at]
    block := program.blocks[block_id]
    if instruction.opcode != .CallDirect || instruction.call < 0 || instruction.call >= program.calls.count ||
        at + 1 >= block.instruction_begin + block.instruction_count { return false }
    call := program.calls[instruction.call]
    returned := program.instructions[at + 1]
    if call.stack_argument_bytes != 0 || returned.opcode != .Return { return false }
    if call.result_operand != MachineNoId && program.operands[call.result_operand].class == .Stack { return false }
    if returned.operand_count == 0 { return true }
    if call.result_operand == MachineNoId || returned.operand_count != 1 { return false }
    result := program.operands[call.result_operand]
    value := program.operands[returned.operand_begin]
    return result.kind == .Physical && value.kind == .Physical && result.class == value.class && result.id == value.id
}

// Whether FUNCTION needs no frame: nothing of it lives on the stack, it
// checks no stack limit, keeps no step budget in a register and runs only
// instructions that cannot trap, calling nothing except a tail call, so
// no callee or trap handler ever sees its stack.
Frameless :: (program: MachineProgram, function_id: s32) -> bool {
    function := program.functions[function_id]
    if function.calling != .Internal || function.stack_count != 0 || function.arena_mark != 0 ||
        function.fuel_register || function_id >= program.frames.count || program.frames[function_id].size != 0 ||
        MachineX64StackChecked(program, function_id) { return false }
    for block_id: function.block_begin..function.block_begin + function.block_count - 1 {
        block := program.blocks[block_id]
        end := block.instruction_begin + block.instruction_count
        for at: block.instruction_begin..end - 1 {
            if TailCallAt(program, block_id, at) { continue }
            if !PlainInstruction(program, program.instructions[at]) { return false }
        }
    }
    return true
}

// Whether INSTRUCTION never traps, calls or touches the frame: a plain
// opcode, or an element address whose bound needs no check.
PlainInstruction :: (program: MachineProgram, instruction: MachineInstruction) -> bool {
    if instruction.opcode == .ElementAddress {
        return instruction.operand_count == 4 && program.operands[instruction.operand_begin + 3].kind == .Immediate
    }
    return PlainOpcode(instruction.opcode)
}

PlainOpcode :: (opcode: MachineOpcode) -> bool {
    return opcode == .Move || opcode == .MoveImmediate || opcode == .GlobalAddress || opcode == .FunctionAddress ||
        opcode == .IntegerAdd || opcode == .IntegerSubtract || opcode == .IntegerMultiply ||
        opcode == .IntegerNegate || opcode == .IntegerAnd || opcode == .IntegerOr || opcode == .IntegerXor ||
        opcode == .IntegerNot || opcode == .FloatAdd || opcode == .FloatSubtract || opcode == .FloatMultiply ||
        opcode == .FloatDivide || opcode == .FloatNegate || opcode == .Compare || opcode == .SetCondition ||
        opcode == .Bitcast || opcode == .Load || opcode == .Store || opcode == .Copy || opcode == .Zero ||
        opcode == .FieldAddress || opcode == .PointerDirect || opcode == .Jump || opcode == .Branch ||
        opcode == .Return
}

Trap :: (state: *State) -> bool {
    if !Count(state, 1) { return false }
    code := OperandAt(state, 0)
    if code.kind != .Immediate || code.immediate >= MachineX64TrapReserved {
        return Fail(state, .Unsupported, OperandId(state, 0))
    }
    TrapSequence(state, code.immediate)
    return true
}

// ---------------------------------------------------------------------------
// Checked pointers. A data pointer is a token (compiler_machine_image
// MachinePointer*). The sequences below use only r10 (declared early-clobber
// by lowering), the reserved r11 and, at Return and Resize, registers dead
// there; every failure takes MachineX64TrapPointer or MachineX64TrapStorage.

PointerScratch :: 10

// Forward jumps over a measured block, whatever its length.
SkipIf :: (writer: *X86Writer, condition: s32, length: s64) {
    X86Byte(writer, 15)
    X86Byte(writer, cast(u8)(128 + condition))
    X86Signed32(writer, length)
}

SkipAlways :: (writer: *X86Writer, length: s64) {
    X86Byte(writer, 233)
    X86Signed32(writer, length)
}

// Starts measuring a block whose bytes are emitted only to learn its length.
Probe :: (state: *State) -> X86Writer {
    saved := state.writer
    empty: []u8
    state.writer = .{output = empty, at = saved.at, limit = saved.limit}
    state.suppress += 1
    return saved
}

Unprobe :: (state: *State, saved: X86Writer) -> s64 {
    length := state.writer.at - saved.at
    failed := state.writer.failed
    state.writer = saved
    state.suppress -= 1
    if failed { state.writer.failed = true }
    return length
}

// lea r11, [rip + pointer runtime header]
PointerHeader :: (state: *State) {
    X86Encode(*state.writer, 0, true, 141, 1, X86R11, X86RipRelocated())
    Relocate(state, .PointerRuntime, 0, -4, state.writer.at - 4)
}

// r10 = &entry[r10], from the header in r11.
PointerEntry :: (state: *State) {
    X86ShiftImmediate(*state.writer, 4, PointerScratch, 5)
    X86Encode(*state.writer, 0, true, 3, 1, PointerScratch, X86At(X86R11, MachinePointerHeaderTable))
}

// PointerResolve raw, token, width, r10, flags: checks the version,
// liveness (and writability for flag 1) and offset + width <= size, then
// raw = base + offset. A token's slot bits name an entry of the table in
// every runtime, which maps all MachinePointerCapacity + 1 of them and never
// makes the last one live, so the slot itself needs no bound check. Slot 0
// is a live empty entry, so null resolves only for zero width.
PointerResolve :: (state: *State) -> bool {
    if !Count(state, 5) { return false }
    destination := Register(state, 0, .Define)
    token := Register(state, 1, .Use)
    if destination == MachineNoId || token == MachineNoId { return false }
    width := OperandAt(state, 2)
    scratch := OperandAt(state, 3)
    flags := OperandAt(state, 4)
    if scratch.kind != .Physical || scratch.id != PointerScratch || scratch.role != .UseDefine ||
        flags.kind != .Immediate || width.kind != .Immediate && width.kind != .Physical ||
        width.kind == .Immediate && width.immediate > 2147483647 {
        return Fail(state, .Unsupported, OperandId(state, 2))
    }
    writer := *state.writer
    PointerHeader(state)
    X86Move(writer, PointerScratch, token)
    X86ShiftImmediate(writer, 5, PointerScratch, MachinePointerSlotShift)
    PointerEntry(state)
    // The entry's version and flags word, xor the token's version and the
    // flags the access needs, is zero in every bit that matters.
    required: u64 = MachinePointerLive
    if (flags.immediate & 1) != 0 { required = MachinePointerLive | MachinePointerWritable }
    required = required << cast(u64)((MachinePointerEntryFlags - MachinePointerEntryVersion) * 8)
    X86Move(writer, X86R11, token)
    X86ShiftImmediate(writer, 5, X86R11, MachinePointerVersionShift)
    X86Encode(writer, 0, false, 0x81, 1, 4, X86Direct(X86R11))
    X86Little(writer, MachinePointerVersionMask, 4)
    X86Encode(writer, 0, false, 0x81, 1, 1, X86Direct(X86R11))
    X86Little(writer, required, 4)
    X86Encode(writer, 0, false, 0x33, 1, X86R11, X86At(PointerScratch, MachinePointerEntryVersion))
    X86Encode(writer, 0, false, 0xf7, 1, 0, X86Direct(X86R11))
    X86Little(writer, 0xffff | required, 4)
    TrapUnless(state, X86Equal, MachineX64TrapPointer)
    // r11 = offset + width, at most the entry's size.
    X86Load(writer, X86R11, X86Direct(token), 4, false)
    if width.kind == .Immediate {
        X86Encode(writer, 0, true, 0x81, 1, 0, X86Direct(X86R11))
        X86Little(writer, width.immediate, 4)
    } else {
        if !X86Register(width.id) { return Fail(state, .Unsupported, OperandId(state, 2)) }
        X86Arithmetic(writer, X86Add, X86R11, width.id)
    }
    X86Encode(writer, 0, true, 59, 1, X86R11, X86At(PointerScratch, MachinePointerEntrySize))
    TrapUnless(state, X86BelowEqual, MachineX64TrapPointer)
    X86Load(writer, X86R11, X86Direct(token), 4, false)
    X86Load(writer, destination, X86At(PointerScratch, MachinePointerEntryBase), 8, false)
    X86Arithmetic(writer, X86Add, destination, X86R11)
    return true
}

// PointerDirect raw, token, base, width, flags: raw = base + the token's
// 32-bit offset. The machine verifier accepted the access, so nothing here
// reads the pointer table.
PointerDirect :: (state: *State) -> bool {
    if !Count(state, 5) { return false }
    destination := Register(state, 0, .Define)
    token := Register(state, 1, .Use)
    base := Register(state, 2, .Use)
    if destination == MachineNoId || token == MachineNoId || base == MachineNoId { return false }
    if OperandAt(state, 3).kind != .Immediate || OperandAt(state, 4).kind != .Immediate {
        return Fail(state, .Unsupported, OperandId(state, 3))
    }
    writer := *state.writer
    X86Load(writer, X86R11, X86Direct(token), 4, false)
    if destination != base { X86Move(writer, destination, base) }
    X86Arithmetic(writer, X86Add, destination, X86R11)
    return true
}

// ArenaAllocate raw, size, r10: SIZE fresh bytes, 16-byte aligned, from the
// frame arena; the storage trap past its limit.
ArenaAllocate :: (state: *State) -> bool {
    if !Count(state, 3) { return false }
    destination := Register(state, 0, .Define)
    if destination == MachineNoId { return false }
    size := OperandAt(state, 1)
    scratch := OperandAt(state, 2)
    if size.kind != .Immediate || size.immediate > 2147483632 || scratch.kind != .Physical ||
        scratch.id != PointerScratch || scratch.role != .UseDefine {
        return Fail(state, .Unsupported, OperandId(state, 1))
    }
    rounded := cast(s64)((size.immediate + 15) & ~cast(u64)15)
    if rounded == 0 { rounded = 16 }
    writer := *state.writer
    PointerHeader(state)
    X86Load(writer, destination, X86At(X86R11, MachinePointerHeaderArenaTop), 8, false)
    X86Lea(writer, PointerScratch, X86At(destination, rounded))
    X86Encode(writer, 0, true, 59, 1, PointerScratch, X86At(X86R11, MachinePointerHeaderArenaLimit))
    TrapUnless(state, X86BelowEqual, MachineX64TrapStorage)
    X86Store(writer, X86At(X86R11, MachinePointerHeaderArenaTop), PointerScratch, 8)
    return true
}

// The free-list pop: slot r10 != 0 leaves the list.
FreePop :: (state: *State, entry: s32) {
    writer := *state.writer
    X86Move(writer, entry, PointerScratch)
    X86ShiftImmediate(writer, 4, entry, 5)
    X86Encode(writer, 0, true, 3, 1, entry, X86At(X86R11, MachinePointerHeaderTable))
    X86Encode(writer, 0, false, 0xff, 1, 6, X86At(entry, MachinePointerEntryNext))
    X86Encode(writer, 0, false, 0x8f, 1, 0, X86At(X86R11, MachinePointerHeaderFree))
}

// Slot r10 for SIZE bytes at the address on top of the stack (popped), its
// token in DESTINATION. A frame slot joins CHAIN; heap slots have none.
// SIZE is an immediate or, when SIZE_REGISTER is not MachineNoId, a register
// already saved on the stack below the address.
CreateSlot :: (state: *State, destination: s32, size: s64, size_on_stack: bool, flags: u64, chain: X86Operand,
    chained: bool) {
    writer := *state.writer
    PointerHeader(state)
    X86Load(writer, PointerScratch, X86At(X86R11, MachinePointerHeaderFree), 8, false)
    X86Arithmetic(writer, X86Test, PointerScratch, PointerScratch)
    // Free list empty: take the next unused slot.
    saved := Probe(state)
    X86Load(*state.writer, PointerScratch, X86At(X86R11, MachinePointerHeaderUnused), 8, false)
    X86Encode(*state.writer, 0, true, 0x83, 1, 0, X86At(X86R11, MachinePointerHeaderUnused))
    X86Byte(*state.writer, 1)
    unused_length := Unprobe(state, saved)
    saved = Probe(state)
    FreePop(state, destination)
    pop_length := Unprobe(state, saved)
    SkipIf(writer, X86NotEqual, unused_length + 5)
    X86Load(writer, PointerScratch, X86At(X86R11, MachinePointerHeaderUnused), 8, false)
    X86Encode(writer, 0, true, 0x83, 1, 0, X86At(X86R11, MachinePointerHeaderUnused))
    X86Byte(writer, 1)
    SkipAlways(writer, pop_length)
    FreePop(state, destination)
    X86Encode(writer, 0, true, 59, 1, PointerScratch, X86At(X86R11, MachinePointerHeaderCapacity))
    TrapUnless(state, X86Below, MachineX64TrapStorage)
    // destination = &entry; base, size and flags.
    X86Move(writer, destination, PointerScratch)
    X86ShiftImmediate(writer, 4, destination, 5)
    X86Encode(writer, 0, true, 3, 1, destination, X86At(X86R11, MachinePointerHeaderTable))
    X86Encode(writer, 0, false, 0x8f, 1, 0, X86At(destination, MachinePointerEntryBase))
    if size_on_stack {
        X86Encode(writer, 0, false, 0x8f, 1, 0, X86At(destination, MachinePointerEntrySize))
    } else {
        X86Encode(writer, 0, true, 0xc7, 1, 0, X86At(destination, MachinePointerEntrySize))
        X86Little(writer, cast(u64)size, 4)
    }
    X86Encode(writer, 102, false, 0xc7, 1, 0, X86At(destination, MachinePointerEntryFlags))
    X86Little(writer, flags, 2)
    if chained {
        X86Load(writer, X86R11, chain, 8, false)
        X86Store(writer, X86At(destination, MachinePointerEntryNext), X86R11, 4)
        X86Store(writer, chain, PointerScratch, 8)
    } else {
        X86Encode(writer, 0, false, 0xc7, 1, 0, X86At(destination, MachinePointerEntryNext))
        X86Little(writer, 0, 4)
    }
    // token = slot << 44 | version << 32
    X86Load(writer, X86R11, X86At(destination, MachinePointerEntryVersion), 2, false)
    X86ShiftImmediate(writer, 4, X86R11, MachinePointerVersionShift)
    X86Move(writer, destination, PointerScratch)
    X86ShiftImmediate(writer, 4, destination, MachinePointerSlotShift)
    X86Arithmetic(writer, X86Or, destination, X86R11)
}

// PointerCreate token, raw, size, r10, flags, chain.
PointerCreate :: (state: *State) -> bool {
    if !Count(state, 6) { return false }
    destination := Register(state, 0, .Define)
    raw := Register(state, 1, .Use)
    if destination == MachineNoId || raw == MachineNoId { return false }
    size := OperandAt(state, 2)
    scratch := OperandAt(state, 3)
    flags := OperandAt(state, 4)
    chain := OperandAt(state, 5)
    if size.kind != .Immediate || size.immediate > 2147483647 || scratch.kind != .Physical ||
        scratch.id != PointerScratch || scratch.role != .UseDefine || flags.kind != .Immediate ||
        chain.kind != .StackObject {
        return Fail(state, .Unsupported, OperandId(state, 2))
    }
    chain_memory := StackMemory(state, chain.id, OperandId(state, 5))
    if state.diagnostic.problem != .None { return false }
    X86Push(*state.writer, raw)
    CreateSlot(state, destination, cast(s64)size.immediate, false, flags.immediate, chain_memory, true)
    return true
}

// Ends slot r10 (entry address in rcx): its version moves on, it is no longer
// live, and unless its versions are used up it goes back on the free list.
// Uses rdx; the header is in r11.
RetireSlot :: (state: *State) {
    writer := *state.writer
    X86Load(writer, X86Rdx, X86At(X86Rcx, MachinePointerEntryVersion), 2, false)
    X86Encode(writer, 0, false, 0xff, 1, 0, X86Direct(X86Rdx))
    X86Store(writer, X86At(X86Rcx, MachinePointerEntryVersion), X86Rdx, 2)
    X86Encode(writer, 102, false, 0xc7, 1, 0, X86At(X86Rcx, MachinePointerEntryFlags))
    X86Little(writer, 0, 2)
    X86Encode(writer, 0, false, 0x81, 1, 7, X86Direct(X86Rdx))
    X86Little(writer, MachinePointerVersions, 4)
    saved := Probe(state)
    X86Load(*state.writer, X86Rdx, X86At(X86R11, MachinePointerHeaderFree), 8, false)
    X86Store(*state.writer, X86At(X86Rcx, MachinePointerEntryNext), X86Rdx, 4)
    X86Store(*state.writer, X86At(X86R11, MachinePointerHeaderFree), PointerScratch, 8)
    length := Unprobe(state, saved)
    SkipIf(writer, X86AboveEqual, length)
    X86Load(writer, X86Rdx, X86At(X86R11, MachinePointerHeaderFree), 8, false)
    X86Store(writer, X86At(X86Rcx, MachinePointerEntryNext), X86Rdx, 4)
    X86Store(writer, X86At(X86R11, MachinePointerHeaderFree), PointerScratch, 8)
}

// A function with frame storage: save the arena top and, with --checks,
// start an empty chain. r10 and r11 are free at entry.
PointerFrameEnter :: (state: *State, function: MachineFunction) -> bool {
    mark := StackMemory(state, function.stack_begin + function.arena_mark - 1, MachineNoId)
    if state.diagnostic.problem != .None { return false }
    writer := *state.writer
    PointerHeader(state)
    X86Load(writer, PointerScratch, X86At(X86R11, MachinePointerHeaderArenaTop), 8, false)
    X86Store(writer, mark, PointerScratch, 8)
    if !state.program.checks { return true }
    chain := StackMemory(state, function.stack_begin + function.pointer_chain - 1, MachineNoId)
    if state.diagnostic.problem != .None { return false }
    X86Encode(writer, 0, true, 0xc7, 1, 0, chain)
    X86Little(writer, 0, 4)
    return true
}

// Before returning: give back the arena and, with --checks, end every slot
// on the chain. Only rax holds a live value here; rcx, rdx, r10 and r11 are
// free.
PointerFrameLeave :: (state: *State, function: MachineFunction) -> bool {
    mark := StackMemory(state, function.stack_begin + function.arena_mark - 1, MachineNoId)
    if state.diagnostic.problem != .None { return false }
    writer := *state.writer
    PointerHeader(state)
    X86Load(writer, PointerScratch, mark, 8, false)
    X86Store(writer, X86At(X86R11, MachinePointerHeaderArenaTop), PointerScratch, 8)
    if !state.program.checks { return true }
    chain := StackMemory(state, function.stack_begin + function.pointer_chain - 1, MachineNoId)
    if state.diagnostic.problem != .None { return false }
    loop := state.writer.at
    X86Load(writer, PointerScratch, chain, 8, false)
    X86Arithmetic(writer, X86Test, PointerScratch, PointerScratch)
    saved := Probe(state)
    PointerFrameStep(state, chain, loop)
    length := Unprobe(state, saved)
    SkipIf(writer, X86Equal, length)
    PointerFrameStep(state, chain, loop)
    return true
}

PointerFrameStep :: (state: *State, chain: X86Operand, loop: s64) {
    writer := *state.writer
    X86Move(writer, X86Rcx, PointerScratch)
    X86ShiftImmediate(writer, 4, X86Rcx, 5)
    X86Encode(writer, 0, true, 3, 1, X86Rcx, X86At(X86R11, MachinePointerHeaderTable))
    X86Load(writer, X86Rdx, X86At(X86Rcx, MachinePointerEntryNext), 4, false)
    X86Store(writer, chain, X86Rdx, 8)
    RetireSlot(state)
    X86Jump32(writer, loop)
}

Instruction :: (state: *State) -> bool {
    instruction := Current(state)
    op := instruction.opcode
    if !Spend(state, 1 + cast(s64)instruction.operand_count) { return false }
    if op == .Move || op == .Spill || op == .Reload { return Transfer(state, instruction) }
    ok := false
    if op == .MoveImmediate { ok = MoveImmediate(state) }
    else if op == .IntegerAdd || op == .IntegerSubtract || op == .IntegerMultiply ||
        op == .IntegerAnd || op == .IntegerOr || op == .IntegerXor { ok = Binary(state, op) }
    else if op == .FloatAdd || op == .FloatSubtract || op == .FloatMultiply ||
        op == .FloatDivide { ok = FloatBinary(state, op) }
    else if op == .IntegerNegate || op == .IntegerNot { ok = Unary(state, op) }
    else if op == .FloatNegate { ok = FloatUnary(state) }
    else if op == .IntegerDivide || op == .IntegerRemainder { ok = Divide(state, op) }
    else if op == .ShiftLeft || op == .ShiftRight { ok = Shift(state, op) }
    else if op == .Compare { ok = Compare(state) }
    else if op == .SetCondition { ok = SetCondition(state) }
    else if op == .Convert || op == .Bitcast { ok = Convert(state, op) }
    else if op == .Load { ok = Load(state) }
    else if op == .Store { ok = Store(state) }
    else if op == .AggregateBuild { ok = AggregateBuild(state) }
    else if op == .AggregateExtract { ok = AggregateExtract(state) }
    else if op == .AggregateInsert { ok = AggregateInsert(state) }
    else if op == .FieldAddress { ok = FieldAddress(state) }
    else if op == .ElementAddress { ok = ElementAddress(state) }
    else if op == .BytesEqual { ok = BytesEqual(state) }
    else if op == .Resize { ok = Resize(state) }
    else if op == .StackAddress { ok = StackAddress(state) }
    else if op == .Zero { ok = Zero(state) }
    else if op == .PointerResolve { ok = PointerResolve(state) }
    else if op == .PointerDirect { ok = PointerDirect(state) }
    else if op == .PointerCreate { ok = PointerCreate(state) }
    else if op == .ArenaAllocate { ok = ArenaAllocate(state) }
    else if op == .FunctionAddress { ok = FunctionAddress(state) }
    else if op == .GlobalAddress { ok = GlobalAddress(state) }
    else if op == .Fuel { ok = Fuel(state) }
    else if op == .CallDirect || op == .CallIndirect { ok = Call(state) }
    else if op == .Jump {
        ok = Count(state, 0)
        if ok { JumpTo(state, state.program.edges[instruction.edge_begin].target) }
    }
    else if op == .Branch { ok = Branch(state) }
    else if op == .Return { ok = Return(state) }
    else if op == .Trap { ok = Trap(state) }
    else if op == .Unreachable {
        ok = Count(state, 0)
        if ok { TrapSequence(state, MachineX64TrapUnreachable) }
    }
    else { return Fail(state, .Unsupported) }
    if op != .Compare { state.flags_value = MachineNoId }
    return ok
}

Prologue :: (state: *State) -> bool {
    frame := state.program.frames[state.function]
    function := state.program.functions[state.function]
    if frame.dynamic_allocation || frame.callee_saved_float != 0 { return Fail(state, .Frame) }
    if frame.size < 0 || frame.size > 2147483647 { return Fail(state, .Frame) }
    if !state.frameless {
        X86Push(*state.writer, X86Rbp)
        X86Move(*state.writer, X86Rbp, X86Rsp)
    }
    if frame.size > 0 { X86SubtractStack(*state.writer, frame.size) }
    if MachineX64StackChecked(state.program, state.function) {
        // cmp rsp, [rip + limit]; continue at or above it.
        X86Encode(*state.writer, 0, true, 59, 1, X86Rsp, X86RipRelocated())
        Relocate(state, .StackLimit, 0, -4, state.writer.at - 4)
        TrapUnless(state, X86AboveEqual, MachineX64TrapStack)
    }
    if !CalleeSaves(state, false) { return false }
    if function.arena_mark != 0 && !PointerFrameEnter(state, function) { return false }
    if state.fuel_register {
        FuelCounter(state, false)
        state.fuel_live = true
    }
    result_addresses: s32
    for object_id: function.stack_begin..function.stack_begin + function.stack_count - 1 {
        object := state.program.stack_objects[object_id]
        if object.kind != .ResultAddress { continue }
        result_addresses += 1
        X86Store(*state.writer, StackMemory(state, object_id, MachineNoId), X86Rax, 8)
    }
    result_class := MachineRegisterClass.Invalid
    if function.result_type >= 0 && function.result_type < state.program.types.count &&
        state.program.types[function.result_type].kind != .Void {
        result_class = state.program.types[function.result_type].class
    }
    if result_addresses > 1 || (result_addresses == 1) != (result_class == .Stack) {
        return Fail(state, .Frame)
    }
    if !Place(state, state.function_body, state.function) { return false }
    if function.entry != function.block_begin { X86Jump32(*state.writer, BlockTarget(state, function.entry)) }
    return true
}

Pass :: (state: *State) -> bool {
    program := state.program
    for function_index: cast(s64)0..program.functions.count - 1 {
        state.function = cast(s32)function_index
        state.block = MachineNoId
        state.instruction = MachineNoId
        function := program.functions[function_index]
        if function.calling != .Internal {
            if !Spend(state, 1) || !Place(state, state.function_begin, function_index) ||
                !Place(state, state.function_body, function_index) ||
                !Place(state, state.function_end, function_index) { return false }
            continue
        }
        state.fuel_register = function.fuel_register
        state.fuel_live = false
        state.frameless = Frameless(program, cast(s32)function_index)
        state.tail_returned = false
        if !Spend(state, 1) || !Place(state, state.function_begin, function_index) || !Prologue(state) { return false }
        if state.writer.failed { return Fail(state, .Limit) }
        for block_id: function.block_begin..function.block_begin + function.block_count - 1 {
            state.block = block_id
            state.instruction = MachineNoId
            state.flags_value = MachineNoId
            block := program.blocks[block_id]
            if !Spend(state, 1) || !Place(state, state.block_begin, block_id) { return false }
            stub := FuelStub(state, block_id)
            if stub {
                state.instruction = block.instruction_begin
                if !Place(state, state.instruction_begin, block.instruction_begin) { return false }
                TrapSequence(state, MachineX64TrapFuel)
            }
            for instruction_id: block.instruction_begin..block.instruction_begin + block.instruction_count - 1 {
                state.instruction = instruction_id
                if !(stub && instruction_id == block.instruction_begin) &&
                    !Place(state, state.instruction_begin, instruction_id) || !Instruction(state) { return false }
                if state.writer.failed { return Fail(state, .Limit) }
                if !Place(state, state.instruction_end, instruction_id) { return false }
            }
        }
        state.block = MachineNoId
        state.instruction = MachineNoId
        if !Place(state, state.function_end, function_index) { return false }
    }
    if state.consumed != program.relocations.count { return Fail(state, .Relocation) }
    return true
}

Failure :: (problem: MachineProblem) -> MachineX64Result {
    result := MachineX64Result.{diagnostic = NoDiagnostic()}
    result.diagnostic.problem = problem
    return result
}

Copy :: (destination: *Vec(s64), source: []s64) -> bool {
    if !VecResizeBounded(<<destination, source.count, source.count) { return false }
    for index: cast(s64)0..source.count - 1 { (<<destination)[index] = source[index] }
    return true
}

AlignValue :: (value: s64, alignment: s32) -> s64 {
    return (value + alignment - 1) & ~cast(s64)(alignment - 1)
}

PutSectionLittle :: (bytes: []u8, at: s64, value: u64, count: s64) {
    for index: cast(s64)0..count - 1 {
        bytes[at + index] = cast(u8)((value >> cast(u64)(index * 8)) & 255)
    }
}

WriteGlobalImage :: (program: MachineProgram, global_id: s32, bytes: []u8, at: s64) -> bool {
    global := program.globals[global_id]
    if global.constant < 0 { return global.writable }
    constant := program.constants[global.constant]
    size := program.types[global.type].size
    if constant.bytes_count == 0 {
        if size > 8 { return false }
        PutSectionLittle(bytes, at, constant.bits, size)
        return true
    }
    if constant.bytes_count != size { return false }
    for index: cast(s64)0..size - 1 {
        bytes[at + index] = program.data[constant.bytes_begin + index]
    }
    return true
}

ImageRelocationKind :: (kind: MachineX64RelocationKind) -> Image.MachineRelocationKind {
    if kind == .GlobalAddress { return .GlobalAddress }
    if kind == .ConstantAddress { return .ConstantAddress }
    if kind == .FuelCounter { return .FuelCounter }
    if kind == .TrapHandler { return .RuntimeTrap }
    if kind == .PlatformService { return .PlatformService }
    if kind == .HostCapability { return .HostCapability }
    if kind == .RuntimeResize { return .RuntimeResize }
    if kind == .StackLimit { return .StackLimit }
    if kind == .PointerRuntime { return .PointerRuntime }
    return .Invalid
}

ImageOperand :: (program: MachineProgram, index: *MachineRelocationIndex, relocation: MachineX64Relocation,
    kind: Image.MachineRelocationKind) -> s32 {
    if relocation.instruction < 0 || relocation.instruction >= index.first.count { return MachineNoId }
    at := index.first[relocation.instruction]
    while at != MachineNoId {
        source := program.relocations[at]
        if source.symbol == relocation.symbol &&
            (cast(s32)source.kind == cast(s32)kind || kind == .RuntimeTrap && source.kind != .Invalid) {
            return source.operand
        }
        at = index.next[at]
    }
    return MachineNoId
}

BuildMachineImage :: (program: MachineProgram, output: *MachineX64Owner,
    limits: MachineLimits) -> bool {
    owner := *output.machine_image
    code_count := output.code.count
    globals := program.globals.count
    functions := program.functions.count
    if !VecResizeBounded(owner.code, code_count, limits.bytes) ||
        !VecResizeBounded(owner.function_offsets, functions, limits.bytes) ||
        !VecResizeBounded(owner.global_offsets, globals, limits.bytes) ||
        !VecResizeBounded(owner.constant_offsets, globals, limits.bytes) ||
        !VecResizeBounded(owner.initializers, program.initializers.count, limits.bytes) ||
        !VecResizeBounded(owner.relocations, output.relocations.count, limits.bytes) {
        return false
    }
    for index: cast(s64)0..code_count - 1 { owner.code[index] = output.code[index] }
    for index: cast(s64)0..functions - 1 {
        owner.function_offsets[index] = -1
        if program.functions[index].calling == .Internal {
            owner.function_offsets[index] = output.functions[index].begin
        }
    }
    constants_size: s64 = 0
    data_size: s64 = 0
    for index: cast(s64)0..globals - 1 {
        global := program.globals[index]
        type := program.types[global.type]
        if type.size <= 0 || type.alignment <= 0 { return false }
        owner.global_offsets[index] = -1
        owner.constant_offsets[index] = -1
        if global.writable {
            data_size = AlignValue(data_size, type.alignment)
            owner.global_offsets[index] = data_size
            data_size += type.size
        } else {
            constants_size = AlignValue(constants_size, type.alignment)
            owner.constant_offsets[index] = constants_size
            constants_size += type.size
        }
        if data_size < 0 || constants_size < 0 || data_size > limits.bytes || constants_size > limits.bytes {
            return false
        }
    }
    // Fuel, the last trap code, the stack limit word, then the pointer
    // runtime header.
    fuel := AlignValue(data_size, 8)
    if fuel > limits.bytes - 24 - MachinePointerHeaderBytes { return false }
    stack_limit := fuel + 16
    pointer_header := stack_limit + 8
    data_size = pointer_header + MachinePointerHeaderBytes
    if !VecResizeBounded(owner.constants, constants_size, limits.bytes) ||
        !VecResizeBounded(owner.data, data_size, limits.bytes) { return false }
    for index: cast(s64)0..globals - 1 {
        global := program.globals[index]
        at := ifx global.writable then owner.global_offsets[index] else owner.constant_offsets[index]
        destination := ifx global.writable then owner.data[:] else owner.constants[:]
        if !WriteGlobalImage(program, cast(s32)index, destination, at) { return false }
    }
    for index: cast(s64)0..program.initializers.count - 1 {
        owner.initializers[index] = program.initializers[index]
    }
    sources: MachineRelocationIndex
    defer MachineRelocationIndexFree(*sources)
    if !MachineRelocationIndexBuild(*sources, program, limits.bytes) { return false }
    for index: cast(s64)0..output.relocations.count - 1 {
        relocation := output.relocations[index]
        kind := ImageRelocationKind(relocation.kind)
        if kind == .Invalid { return false }
        owner.relocations[index] = .{section = .Code, offset = relocation.offset, width = 4,
            instruction = relocation.instruction,
            operand = ImageOperand(program, *sources, relocation, kind), kind = kind,
            symbol = relocation.symbol, addend = relocation.addend}
    }
    stack_bytes: s64 = 16
    for frame: program.frames { if frame.size > stack_bytes { stack_bytes = frame.size } }
    stack_bytes = AlignValue(stack_bytes, 16)
    owner.image = .{version = MachineImageVersion, target = program.target,
        runtime_abi = .Revision1,
        code = .{bytes = owner.code[:], alignment = 16},
        constants = .{bytes = owner.constants[:], alignment = 16},
        data = .{bytes = owner.data[:], alignment = 8},
        function_offsets = owner.function_offsets[:], global_offsets = owner.global_offsets[:],
        constant_offsets = owner.constant_offsets[:], initializers = owner.initializers[:],
        relocations = owner.relocations[:], entry = program.entry,
        stack_alignment = 16, stack_bytes = stack_bytes, fuel_offset = fuel,
        stack_limit_offset = stack_limit, pointer_offset = pointer_header,
        host_symbols = cast(s32)functions, platform_symbols = cast(s32)functions,
        trap_symbols = 1}
    if MachineImageValidate(owner.image).problem != .None { return false }
    owner.valid = true
    return true
}

// Verifies and measures PROGRAM; with an OUTPUT, writes and publishes the
// image there. Every diagnostic from verification, form checks or measuring
// returns before OUTPUT is touched.
Process :: (program: MachineProgram, limits: MachineLimits, output: *MachineX64Owner) -> MachineX64Result {
    verified := MachineVerifyAllocated(program, limits)
    if verified.problem != .None { return .{diagnostic = verified} }
    if program.target.arch != .X86_64 || !TargetMachineLoweringSupported(program.target) {
        return Failure(.UnsupportedTarget)
    }
    layout: Layout
    defer LayoutFree(*layout)
    if !Filled(*layout.function_begin, program.functions.count) ||
        !Filled(*layout.function_body, program.functions.count) ||
        !Filled(*layout.function_end, program.functions.count) ||
        !Filled(*layout.block_begin, program.blocks.count) ||
        !Filled(*layout.instruction_begin, program.instructions.count) ||
        !Filled(*layout.instruction_end, program.instructions.count) ||
        !VecResizeBounded(layout.relocation_of, program.instructions.count, program.instructions.count) {
        return Failure(.Allocation)
    }
    for index: cast(s64)0..program.instructions.count - 1 { layout.relocation_of[index] = MachineNoId }
    for relocation_id: cast(s64)0..program.relocations.count - 1 {
        relocation := program.relocations[relocation_id]
        if layout.relocation_of[relocation.instruction] != MachineNoId {
            result := Failure(.Relocation)
            result.diagnostic.instruction = relocation.instruction
            result.diagnostic.operand = relocation.operand
            return result
        }
        layout.relocation_of[relocation.instruction] = cast(s32)relocation_id
    }
    limit := limits.bytes
    if limit > CodeLimit { limit = CodeLimit }
    state := State.{program = program, writer = .{limit = limit}, diagnostic = NoDiagnostic(),
        remaining = limits.work,
        function_begin = layout.function_begin[:], function_body = layout.function_body[:],
        function_end = layout.function_end[:], block_begin = layout.block_begin[:],
        instruction_begin = layout.instruction_begin[:], instruction_end = layout.instruction_end[:],
        relocation_of = layout.relocation_of[:],
        function = MachineNoId, block = MachineNoId, instruction = MachineNoId,
        flags_value = MachineNoId}
    if !Pass(*state) { return .{diagnostic = state.diagnostic, work = state.used} }
    measured := MachineX64Result.{diagnostic = state.diagnostic, code_bytes = state.writer.at,
        relocations = state.relocation_count, work = state.used}
    if output == null { return measured }

    MachineX64Free(output)
    if !VecResizeBounded(output.code, measured.code_bytes, measured.code_bytes) ||
        !VecResizeBounded(output.relocations, measured.relocations, measured.relocations) ||
        !VecResizeBounded(output.functions, program.functions.count, program.functions.count) ||
        !VecResizeBounded(output.instructions, program.instructions.count, program.instructions.count) ||
        !Copy(*output.blocks, layout.block_begin[:]) {
        MachineX64Free(output)
        return Failure(.Allocation)
    }
    state.emit = true
    state.writer = .{output = output.code[:], limit = limit}
    state.relocations = output.relocations[:]
    state.relocation_count = 0
    state.consumed = 0
    state.remaining = limits.work
    state.used = 0
    if !Pass(*state) || state.writer.at != measured.code_bytes || state.relocation_count != measured.relocations {
        result := MachineX64Result.{diagnostic = state.diagnostic}
        if result.diagnostic.problem == .None { result = Failure(.Instruction) }
        MachineX64Free(output)
        return result
    }
    for index: cast(s64)0..program.functions.count - 1 {
        output.functions[index] = .{begin = layout.function_begin[index], body = layout.function_body[index],
            end = layout.function_end[index]}
    }
    for index: cast(s64)0..program.instructions.count - 1 {
        output.instructions[index] = .{begin = layout.instruction_begin[index], end = layout.instruction_end[index]}
    }
    output.image = .{code = output.code[:], functions = output.functions[:], blocks = output.blocks[:],
        instructions = output.instructions[:], relocations = output.relocations[:], entry = program.entry}
    if !BuildMachineImage(program, output, limits) {
        MachineX64Free(output)
        return Failure(.Allocation)
    }
    output.valid = true
    return measured
}

#scope_export

// Whether FUNCTION's prologue checks the stack limit: its frame is larger
// than the slack the limit leaves, or it calls Ziran code (or the host,
// which may call back) in loaded or checked code.
MachineX64StackChecked :: (program: MachineProgram, function_id: s32) -> bool {
    if function_id < 0 || function_id >= program.functions.count { return false }
    function := program.functions[function_id]
    if function.calling != .Internal { return false }
    if function_id < program.frames.count && program.frames[function_id].size > MachineX64StackSlack { return true }
    // An unchecked executable lets deep recursion fault on the guard page,
    // as C does; a frame larger than the slack keeps its check, since it
    // could step past the guard page. Loaded code always checks: an
    // overflow there would take down its host.
    if program.executable && !program.checks { return false }
    for block_id: function.block_begin..function.block_begin + function.block_count - 1 {
        block := program.blocks[block_id]
        for instruction_id: block.instruction_begin..block.instruction_begin + block.instruction_count - 1 {
            // A runtime service never calls back, so it cannot recurse.
            instruction := program.instructions[instruction_id]
            if instruction.opcode == .CallIndirect { return true }
            if instruction.opcode == .CallDirect && (instruction.call < 0 || instruction.call >= program.calls.count ||
                program.calls[instruction.call].calling != .Platform) { return true }
        }
    }
    return false
}

MachineX64Free :: (owner: *MachineX64Owner) {
    if owner == null { return }
    owner.valid = false
    owner.image = .{entry = MachineNoId}
    VecFree(owner.code)
    VecFree(owner.functions)
    VecFree(owner.blocks)
    VecFree(owner.instructions)
    VecFree(owner.relocations)
    MachineImageFree(*owner.machine_image)
}

// A borrowed view of a published image, valid until the next Encode or Free.
MachineX64View :: (owner: *MachineX64Owner) -> MachineX64Image {
    if owner == null || !owner.valid { return .{entry = MachineNoId} }
    return owner.image
}

MachineX64MachineView :: (owner: *MachineX64Owner) -> MachineImage {
    if owner == null || !owner.valid || !owner.machine_image.valid {
        return .{version = MachineImageVersion, entry = MachineNoId}
    }
    return owner.machine_image.image
}

MachineX64Validate :: (program: MachineProgram, limits: MachineLimits) -> MachineDiagnostic {
    return Process(program, limits, null).diagnostic
}

MachineX64Measure :: (program: MachineProgram, limits: MachineLimits) -> MachineX64Result {
    return Process(program, limits, null)
}

// Publishes the encoded image in OUTPUT. A diagnostic from verification,
// form checks or measuring leaves OUTPUT exactly as it was.
MachineX64Encode :: (program: MachineProgram, limits: MachineLimits, output: *MachineX64Owner) -> MachineDiagnostic {
    if output == null { return Failure(.Owner).diagnostic }
    return Process(program, limits, output).diagnostic
}
