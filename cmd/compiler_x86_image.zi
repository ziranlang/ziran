    for index: cast(s64)0..first.count - 1 { output[at + index] = first[index] }
    for index: cast(s64)0..second.count - 1 { output[at + first.count + index] = second[index] }
}

WriteGlobal :: (program: MachineProgram, symbol: s32, at: s64, output: []u8) -> bool {
    global := program.globals[symbol]
    if global.constant < 0 { return global.writable }
    constant := program.constants[global.constant]
    type := program.types[global.type]
    if constant.bytes_count == 0 {
        if type.size > 8 { return false }
        PutLittle(output, at, constant.bits, cast(s32)type.size)
        return true
    }
    if constant.bytes_count != type.size { return false }
    for index: cast(s64)0..constant.bytes_count - 1 {
        output[at + index] = program.data[constant.bytes_begin + index]
    }
    return true
}

// The entry stub (see StartupSize): [sub rsp, 8; fninit]; [mov rax, rsp;
// sub rax, MachineX64StackBytes; mov [rip + limit], rax]; a call per
// initializer in order, then the machine entry; move (or clear) the status;
// then the runtime's exit, exit_group or ExitProcess.
WriteStartup :: (program: MachineProgram, image: MachineX64Image, layout: MachineX64ImageLayout,
    output: []u8) -> bool {
    at := layout.text
    needs := layout.needs
    if Windows(layout) {
        Put8(output, at, 0x48); Put8(output, at + 1, 0x83); Put8(output, at + 2, 0xec); Put8(output, at + 3, 8)
        at += 4
        if needs.float { Put8(output, at, 0xdb); Put8(output, at + 1, 0xe3); at += 2 }
    }
    if needs.stack {
        Put8(output, at, 0x48); Put8(output, at + 1, 0x89); Put8(output, at + 2, 0xe0)
        Put8(output, at + 3, 0x48); Put8(output, at + 4, 0x2d)
        PutLittle(output, at + 5, MachineX64StackBytes, 4)
        Put8(output, at + 9, 0x48); Put8(output, at + 10, 0x89); Put8(output, at + 11, 0x05)
        if !PutRelative(output, at + 12, layout.data + layout.data_layout.stack_limit, -4) { return false }
        at += StackSetupSize
    }
    code := Code(layout)
    for initializer: program.initializers {
        Put8(output, at, 0xe8)
        if !PutRelative(output, at + 1, code + image.functions[initializer].begin, -4) { return false }
        at += 5
    }
    Put8(output, at, 0xe8)
    if !PutRelative(output, at + 1, code + image.functions[program.entry].begin, -4) { return false }
    result_type := program.types[program.functions[program.entry].result_type]
    if result_type.kind == .Void { Put8(output, at + 5, 0x31); Put8(output, at + 6, 0xff) }
    else { Put8(output, at + 5, 0x89); Put8(output, at + 6, 0xc7) }
    at += 7
    if needs.runtime.buffered {
        Put8(output, at, 0xe9)
        if !PutRelative(output, at + 1, layout.routines.exit, -4) { return false }
        at += 5
    } else if Windows(layout) {
        // movzx ecx, dil; sub rsp, 32; call [rip + ExitProcess].
        Put8(output, at, 0x40); Put8(output, at + 1, 0x0f); Put8(output, at + 2, 0xb6); Put8(output, at + 3, 0xcf)
        Put8(output, at + 4, 0x48); Put8(output, at + 5, 0x83); Put8(output, at + 6, 0xec); Put8(output, at + 7, 32)
        Put8(output, at + 8, 0xff); Put8(output, at + 9, 0x15)
        if !PutRelative(output, at + 10, layout.imports.slots[cast(s64)MachineWin64Import.ExitProcess], -4) { return false }
        at += 14
    } else {
        Put8(output, at, 0xb8); PutLittle(output, at + 1, 231, 4)
        Put8(output, at + 5, 0x0f); Put8(output, at + 6, 0x05)
        at += 7
    }
    while at < code && code - at < 32 { Put8(output, at, 0xcc); at += 1 }
    return at == code
}

#scope_export

// Whether the image needs a data region at all.
MachineX64ImageHasData :: (layout: MachineX64ImageLayout) -> bool { return layout.data_layout.memory > 0 }

// The data region's alignment: every writable global's and the pointer
// table's.
MachineX64DataAlignment :: (program: MachineProgram) -> s64 {
    alignment: s64 = 64
    for global: program.globals {
        if global.writable && global.type >= 0 && global.type < program.types.count &&
            cast(s64)program.types[global.type].alignment > alignment {
            alignment = cast(s64)program.types[global.type].alignment
        }
    }
    return alignment
}

// Checks the allocated program and its encoding, finds what the image needs
// and measures its constants and data. It writes nothing.
MachineX64ImageMeasure :: (program: MachineProgram, image: MachineX64Image,
    layout: *MachineX64ImageLayout) -> MachineDiagnostic {
    verified := MachineVerifyAllocated(program, MachineDefaultLimits())
    if verified.problem != .None { return verified }
    if program.target.arch != .X86_64 || program.target.os != layout.os ||
        !TargetExecutableNativeSupported(program.target) {
        return Problem(.UnsupportedTarget)
    }
    if program.entry < 0 || program.entry >= program.functions.count || image.entry != program.entry ||
        image.code.count <= 0 || image.code.count > 2147483647 ||
        image.functions.count != program.functions.count || image.blocks.count != program.blocks.count ||
        image.instructions.count != program.instructions.count {
        return Problem(.Relocation)
    }
    entry := program.functions[program.entry]
    if entry.parameter_count != 0 || entry.result_type < 0 || entry.result_type >= program.types.count {
        return Problem(.Unsupported)
    }
    result_type := program.types[entry.result_type]
    if result_type.kind != .Void && result_type.kind != .Bool && result_type.kind != .Integer {
        return Problem(.Unsupported)
    }
    for global: program.globals {
        if !global.writable && global.constant < 0 { return Problem(.Unsupported) }
        if global.constant >= 0 {
            constant := program.constants[global.constant]
            type := program.types[global.type]
            if (constant.bytes_count == 0 && type.size > 8) ||
                (constant.bytes_count != 0 && constant.bytes_count != type.size) {
                return Problem(.Unsupported)
            }
        }
    }
    previous: s64 = 0
    for function: image.functions {
        if function.begin < previous || function.body < function.begin || function.cold < function.body ||
            function.end < function.cold || function.end > image.code.count {
            return Problem(.Relocation)
        }
        previous = function.end
    }
    for block: image.blocks {
        if block < 0 || block > image.code.count { return Problem(.Relocation) }
    }
    for range: image.instructions {
        if range.begin < 0 || range.end < range.begin || range.end > image.code.count {
            return Problem(.Relocation)
        }
    }
    hosts_diagnostic := HostsMeasure(program, layout.hosts)
    if hosts_diagnostic.problem != .None { return hosts_diagnostic }
    builtins_diagnostic := BuiltinsMeasure(program, layout.builtins)
    if builtins_diagnostic.problem != .None { return builtins_diagnostic }
    layout.needs = ImageNeeds(program, image)
    // A built-in service that reads grows its block through the runtime's
    // resize entry, which needs the heap; a growth the runtime refuses goes
    // to the service's own failure path, but a trapped one needs the stub.
    if Host.MachineX64HostBuiltinResize(program, layout.builtins) {
        layout.needs.runtime.resize = true
        layout.needs.trap = true
        layout.needs.runtime.exit = true
    }
    layout.builtin_imports = Host.MachineX64HostBuiltinImports(program, layout.builtins)
    data_diagnostic := DataMeasure(program, layout.needs, ifx Windows(<<layout) then cast(s64)0 else layout.hosts.count, *layout.data_layout)
    if data_diagnostic.problem != .None { return data_diagnostic }
    return GlobalsMeasure(program, false, *layout.constants_size)
}

// Lays out the text from LAYOUT.text: the entry stub, code, trap stub,
// runtime, float formatter and host veneers, ending at text_end.
MachineX64ImageText :: (program: MachineProgram, image: MachineX64Image,
    layout: *MachineX64ImageLayout) -> MachineDiagnostic {
    if layout.text <= 0 || layout.text > 2147483647 - Page { return Problem(.Limit) }
    layout.startup_size = StartupSize(program, <<layout)
    if layout.startup_size > 2147483647 - layout.text - image.code.count - TrapStubSize {
        return Problem(.Limit)
    }
    end := Code(<<layout) + image.code.count
    layout.trap = 0
    if layout.needs.trap { layout.trap = end; end += TrapStubSize }
    // Measuring: data places are not known yet, and every rip field is 32-bit.
    measuring: []u8
    if !MachineX64RuntimeEmit(measuring, Align(end, 16), layout.needs.runtime,
        RuntimePlaces(<<layout), *layout.routines) {
        return Problem(.Limit)
    }
    end = layout.routines.end
    layout.float = 0
    if layout.needs.float {
        layout.float = Align(end + 16 - FloatAlignment, 16) - 16 + FloatAlignment
        end = layout.float + FloatSize
    }
    // Each veneer's size depends only on its signature, never on its slot or
    // on where the runtime's resize entry lies.
    if layout.hosts.count > 0 { end = Align(end, 16) }
    for index: cast(s64)0..layout.hosts.count - 1 {
        layout.hosts[index].veneer = end
        measure := X86Writer.{at = end, limit = 2147483647 - Page}
        if !MachineX64HostVeneer(*measure, program, layout.hosts[index], 0, layout.routines.resize, layout.imports) {
            return Problem(.Limit)
        }
        end = measure.at
    }
    if layout.builtins.count > 0 { end = Align(end, 16) }
    for index: cast(s64)0..layout.builtins.count - 1 {
        layout.builtins[index].veneer = end
        measure := X86Writer.{at = end, limit = 2147483647 - Page}
        if !MachineX64HostVeneer(*measure, program, layout.builtins[index], 0, layout.routines.resize, layout.imports) {
            return Problem(.Limit)
        }
        end = measure.at
    }
    layout.text_end = end
    if layout.text_end > 2147483647 - Page { return Problem(.Limit) }
    return NoDiagnostic()
}

// Checks that every relocation of IMAGE resolves inside LAYOUT and fits its
// 32-bit field, once the container has placed the constants and data.
MachineX64ImageResolve :: (program: MachineProgram, image: MachineX64Image,
    layout: MachineX64ImageLayout) -> MachineDiagnostic {
    if layout.constants < 0 || layout.constants > 2147483647 - layout.constants_size ||
        layout.data < 0 || layout.data > 2147483647 - layout.data_layout.memory {
        return Problem(.Limit)
    }
    // The encoder's own measuring pass must find exactly these relocations.
    remeasured := MachineX64Measure(program, MachineDefaultLimits())
    if remeasured.diagnostic.problem != .None || remeasured.relocations != image.relocations.count {
        return Problem(.Relocation)
    }
    previous: s64 = -1
    // The function whose end follows the current field; fields ascend.
    owner: s64 = 0
    for relocation: image.relocations {
        while owner < image.functions.count && image.functions[owner].end <= relocation.offset { owner += 1 }
        if relocation.instruction == MachineNoId {
            // Only a prologue has relocations outside an instruction: its stack
            // check, pointer frame and the load of a register step budget, and
            // the stack check's trap after the function's blocks.
            if relocation.offset <= previous || relocation.offset < 0 ||
                relocation.offset > image.code.count - 4 ||
                (relocation.kind != .StackLimit && relocation.kind != .TrapHandler &&
                 relocation.kind != .PointerRuntime && relocation.kind != .FuelCounter) ||
                relocation.symbol != 0 || relocation.addend != -4 ||
                !InPrologue(program, image, relocation.offset) &&
                    !(InColdTraps(image, owner, relocation) && PrologueChecks(program, owner)) {
                return Problem(.Relocation)
            }
            previous = relocation.offset
            continue
        }
        if relocation.kind == .StackLimit ||
            relocation.kind == .PointerRuntime &&
                !PointerOpcode(program.instructions[relocation.instruction].opcode) &&
                program.instructions[relocation.instruction].opcode != .Return ||
            relocation.offset <= previous || relocation.offset < 0 ||
            relocation.offset > image.code.count - 4 || relocation.instruction < 0 ||
            relocation.instruction >= image.instructions.count ||
            !WithinInstruction(image, owner, relocation) {
            return Problem(.Relocation, relocation.instruction)
        }
        previous = relocation.offset
        opcode := program.instructions[relocation.instruction].opcode
        kind := relocation.kind
        if (kind == .GlobalAddress || kind == .ConstantAddress) && opcode != .GlobalAddress ||
            (kind == .FuelCounter || kind == .TrapHandler || kind == .PointerRuntime ||
             kind == .RuntimeResize) && relocation.symbol != 0 ||
            kind == .TrapHandler && (!TrapOpcode(opcode) || relocation.addend != -4) ||
            (kind == .PlatformService || kind == .HostCapability) && opcode != .CallDirect ||
            kind == .RuntimeResize && opcode != .Resize {
            return Problem(.Relocation, relocation.instruction)
        }
        target: s64 = 0
        if !RelocationTarget(program, layout, relocation, *target) {
            unsupported := kind == .PlatformService || kind == .HostCapability
            return Problem(ifx unsupported then MachineProblem.Unsupported else MachineProblem.Relocation,
                relocation.instruction)
        }
        displacement: s64 = 0
        if !Relative32(target, relocation.addend, Code(layout) + relocation.offset, *displacement) {
            return Problem(.Relocation, relocation.instruction)
        }
    }
    return NoDiagnostic()
}

// Writes a resolved LAYOUT's text and constants into OUTPUT at their
// positions and the data's stored bytes at data_file; BASE is the absolute
// address of position zero. Bytes it does not write keep their value, so
// OUTPUT starts zeroed.
MachineX64ImageWrite :: (program: MachineProgram, image: MachineX64Image, layout: MachineX64ImageLayout,
    output: []u8, base: u64, fuel: s64) -> bool {
    data := layout.data_layout
    if fuel < 0 || output.count < layout.text_end ||
        output.count < layout.constants + layout.constants_size ||
        output.count < layout.data_file + data.size { return false }
    if !WriteStartup(program, image, layout, output) { return false }
    code := Code(layout)
    for index: cast(s64)0..image.code.count - 1 { output[code + index] = image.code[index] }

    // trap_handler: store edi, then the runtime's exit with status 125.
    if layout.needs.trap {
        trap := layout.trap
        Put8(output, trap, 0x89); Put8(output, trap + 1, 0x3d)
        if !PutRelative(output, trap + 2, layout.data + data.trap_status, -4) { return false }
        Put8(output, trap + 6, 0xbf); PutLittle(output, trap + 7, MachineX64TrapExitStatus, 4)
        Put8(output, trap + 11, 0xe9)
        if !PutRelative(output, trap + 12, layout.routines.exit, -4) { return false }
    }

    routines: MachineX64RuntimeEntries
    start := Align(code + image.code.count + ifx layout.needs.trap then TrapStubSize else 0, 16)
    if !MachineX64RuntimeEmit(output, start, layout.needs.runtime, RuntimePlaces(layout), *routines) ||
        routines.end != layout.routines.end { return false }
    if layout.needs.float {
        // The formatter's one write is a rel32 call to stdout_bytes.
        WriteFloatRuntime(output, layout.float)
        if !PutRelative(output, layout.float + FloatWriteField, routines.stdout_bytes, -4) { return false }
    }
    for index: cast(s64)0..layout.hosts.count - 1 {
        host := layout.hosts[index]
        writer := X86Writer.{output = output, at = host.veneer, limit = layout.text_end}
        following := layout.text_end
        if layout.builtins.count > 0 { following = layout.builtins[0].veneer }
        if !MachineX64HostVeneer(*writer, program, host, HostSlot(layout, index), layout.routines.resize, layout.imports) ||
            index + 1 < layout.hosts.count && writer.at != layout.hosts[index + 1].veneer ||
            index + 1 == layout.hosts.count && writer.at != following { return false }
    }
    for index: cast(s64)0..layout.builtins.count - 1 {
        host := layout.builtins[index]
        writer := X86Writer.{output = output, at = host.veneer, limit = layout.text_end}
        if !MachineX64HostVeneer(*writer, program, host, 0, layout.routines.resize, layout.imports) ||
            index + 1 < layout.builtins.count && writer.at != layout.builtins[index + 1].veneer ||
            index + 1 == layout.builtins.count && writer.at != layout.text_end { return false }
    }

    for relocation: image.relocations {
        target: s64 = 0
        if !RelocationTarget(program, layout, relocation, *target) ||
            !PutRelative(output, code + relocation.offset, target, relocation.addend) { return false }
    }
    for symbol: cast(s64)0..program.globals.count - 1 {
        global := program.globals[symbol]
        offset: s64 = 0
        if !GlobalOffset(program, cast(s32)symbol, global.writable, *offset) { return false }
        at := ifx global.writable then layout.data_file + offset else layout.constants + offset
        if !WriteGlobal(program, cast(s32)symbol, at, output) { return false }
    }
    if data.fuel >= 0 { PutLittle(output, layout.data_file + data.fuel, cast(u64)fuel, 8) }
    if data.pointer_header < 0 { return true }
    // Pointer runtime: an empty free list, the next slot after the globals,
    // the arena, and live entries for slot 0 (empty, at address 0) and each
    // global.
    data_base := base + cast(u64)layout.data
    header := layout.data_file + data.pointer_header
    PutLittle(output, header + MachinePointerHeaderUnused, cast(u64)(program.globals.count + 1), 8)
    PutLittle(output, header + MachinePointerHeaderCapacity, MachinePointerCapacity, 8)
    PutLittle(output, header + MachinePointerHeaderArenaTop, data_base + cast(u64)data.arena, 8)
    PutLittle(output, header + MachinePointerHeaderArenaLimit,
        data_base + cast(u64)(data.arena + MachinePointerArenaBytes), 8)
    PutLittle(output, header + MachinePointerHeaderTable, data_base + cast(u64)data.table, 8)
    table := layout.data_file + data.table
    PutLittle(output, table + MachinePointerEntryFlags, MachinePointerLive, 2)
    for symbol: cast(s64)0..program.globals.count - 1 {
        global := program.globals[symbol]
        offset: s64 = 0
        if !GlobalOffset(program, cast(s32)symbol, global.writable, *offset) { return false }
        position := ifx global.writable then layout.data + offset else layout.constants + offset
        entry := table + (symbol + 1) * MachinePointerEntryBytes
        PutLittle(output, entry + MachinePointerEntryBase, base + cast(u64)position, 8)
        PutLittle(output, entry + MachinePointerEntrySize, cast(u64)program.types[global.type].size, 8)
        PutLittle(output, entry + MachinePointerEntryFlags,
            ifx global.writable then cast(u64)(MachinePointerLive | MachinePointerWritable) else MachinePointerLive, 2)
    }
    return true
}

// The data's 8-byte fields that hold absolute addresses, as positions in
// ascending order: the pointer header's arena top, arena limit and table,
// then each global's pointer-table base. Slot 0's base stays null.
MachineX64AbsoluteFieldCount :: (program: MachineProgram, layout: MachineX64ImageLayout) -> s64 {
    return ifx layout.data_layout.pointer_header >= 0 then 3 + program.globals.count else 0
}

MachineX64AbsoluteField :: (program: MachineProgram, layout: MachineX64ImageLayout, index: s64) -> s64 {
    data := layout.data_layout
    header := layout.data + data.pointer_header
    if index == 0 { return header + MachinePointerHeaderArenaTop }
    if index == 1 { return header + MachinePointerHeaderArenaLimit }
    if index == 2 { return header + MachinePointerHeaderTable }
    return layout.data + data.table + (index - 2) * MachinePointerEntryBytes + MachinePointerEntryBase
}
