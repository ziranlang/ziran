using Allocated :: #import "compiler_machine_verify_allocated"
using Bytes :: #import "compiler_x86_bytes"
using Host :: #import "compiler_x86_host"
using Image :: #import "compiler_machine_image"
using Machine :: #import "compiler_machine_ir"
using Runtime :: #import "compiler_x86_runtime"
using Target :: #import "compiler_target"
using Win64 :: #import "compiler_x86_win64"
using X64 :: #import "compiler_x86_64"

// The contents of an x86-64 native executable that its container does not
// decide, shared by the Linux ELF (compiler_machine_elf.zi) and Windows PE
// (compiler_machine_pe.zi) writers, carrying only what the program uses. A
// container places three regions at positions of one address space, ELF
// virtual offsets or PE RVAs, so every rip-relative field is the difference
// of two positions:
//
//   * text, read/execute: a Ziran-owned process entry stub, the encoded
//     machine text, the hard-trap stub when anything traps, the runtime
//     routines the program calls (compiler_x86_runtime.zi), when it
//     prints floats, the float formatter and, for each host capability a
//     Linux executable imports, its C ABI veneer (compiler_x86_host.zi);
//   * constants, read-only: the read-only globals;
//   * data, read/write, only when the program needs writable state: writable
//     globals, the fuel counter, the pointer runtime (its header, the pointer
//     table with slot 0 and the globals' slots stored and the rest zero fill,
//     and the frame arena), the last trap code, the stack limit, the heap's
//     state, the console buffer and the imported host capabilities' slots,
//     which the dynamic linker fills, each only when used.
//
// Process convention:
//   * a void entry exits zero; a bool/integer entry exits with its low byte;
//   * fuel starts at the requested budget; an unbounded budget, the default,
//     is the one a bundle run starts with, so such a program is built without
//     fuel checks, and every MachineOpcode.Fuel debits it;
//   * a hard trap stores its u32 MachineX64Trap* code and exits status 125;
//   * when any function checks its stack, the entry stub sets the stack limit
//     MachineX64StackBytes below its own stack pointer, inside the 8 MiB stack
//     of either container, so runaway recursion takes MachineX64TrapStack
//     instead of faulting.
// The pointer header and table hold absolute addresses, base plus position;
// MachineX64AbsoluteField names them for a container that relocates.

MachineX64StackBytes :: 0x7c0000
MachineX64InitialFuel :: 9223372036854775807
MachineX64TrapExitStatus :: 125

// Offsets in the data, -1 for a piece the program does not use.
MachineX64DataLayout :: struct {
    globals_size: s64
    fuel: s64
    trap_status: s64
    stack_limit: s64
    pointer_header: s64
    table: s64
    arena: s64
    heap: s64
    console: s64
    // The first imported host capability's 8-byte slot; the rest follow it.
    host_slots: s64
    // Bytes stored, and in memory with the zero fill.
    size: s64
    memory: s64
}

// What the image references, which decides what it carries.
MachineX64ImageNeeds :: struct {
    runtime: MachineX64RuntimeUses
    float: bool
    fuel: bool
    trap: bool
    stack: bool
    pointer: bool
}

// Positions of an image's parts. MachineX64ImageMeasure fills the needs and
// sizes; the container then sets os and text for MachineX64ImageText, and
// constants, data, data_file and on Windows the import slots before
// MachineX64ImageResolve. A container that links host libraries sets hosts,
// the capabilities it imports in function order, and one whose executable
// supplies the ZX Runner's files and clock services sets builtins the same
// way, before MachineX64ImageMeasure, and MachineX64ImageText places their
// veneers after the imports'.
MachineX64ImageLayout :: struct {
    os: TargetOS
    needs: MachineX64ImageNeeds
    text: s64
    startup_size: s64
    // The trap stub, or zero when nothing traps.
    trap: s64
    routines: MachineX64RuntimeEntries
    // The float formatter, or zero when nothing prints a float.
    float: s64
    text_end: s64
    constants: s64
    constants_size: s64
    data: s64
    // Where MachineX64ImageWrite's output takes the data's stored bytes; text
    // and constants go at their positions.
    data_file: s64
    data_layout: MachineX64DataLayout
    imports: MachineWin64Slots
    hosts: []MachineX64HostImport
    // The built-in services' imports, after the hosts' veneers, and the
    // kernel32 functions they call, as a MachineWin64ImportBit mask.
    builtins: []MachineX64HostImport
    builtin_imports: u32
}

#scope_file

// The entry stub, in order: on Windows, sub rsp, 8 restores the alignment a
// Linux process starts with (4 bytes), then fninit when the program prints
// floats (2 bytes), because Windows starts the x87 unit at 53-bit precision
// and the float formatter needs the 64 bits Linux starts with; the stack
// limit setup when used (16 bytes); a call per initializer (5 bytes each); the
// entry call and its status (7 bytes); then a jump to the runtime's exit to
// flush buffered output (5 bytes), or the exit itself: exit_group (7 bytes),
// or ExitProcess of the status's low byte (14 bytes).
StackSetupSize :: 16
TrapStubSize :: 16
Page :: 4096
// The float formatter: position independent, with its naturally aligned SSE
// constants 16-byte aligned when it starts 12 bytes past a boundary. It writes
// its text through one call to the console's stdout_bytes.
FloatSize :: 768
FloatAlignment :: 12
FloatWriteField :: 0x2b3
Float32Offset :: 704
Float64Offset :: 718

NoDiagnostic :: () -> MachineDiagnostic {
    return .{problem = .None, function = MachineNoId, block = MachineNoId,
        instruction = MachineNoId, operand = MachineNoId, virtual = MachineNoId}
}

Problem :: (problem: MachineProblem, instruction: s32 = MachineNoId) -> MachineDiagnostic {
    result := NoDiagnostic()
    result.problem = problem
    result.instruction = instruction
    return result
}

Align :: (value: s64, alignment: s64) -> s64 {
    return (value + alignment - 1) & ~(alignment - 1)
}

ValidAlignment :: (alignment: s32) -> bool {
    return alignment > 0 && alignment <= Page && (alignment & (alignment - 1)) == 0
}

DataMeasure :: (program: MachineProgram, needs: MachineX64ImageNeeds, hosts: s64,
    layout: *MachineX64DataLayout) -> MachineDiagnostic {
    at: s64 = 0
    for global: program.globals {
        if global.type < 0 || global.type >= program.types.count { return Problem(.Unsupported) }
        if !global.writable { continue }
        type := program.types[global.type]
        if type.size <= 0 || type.size > 2147483647 || !ValidAlignment(type.alignment) {
            return Problem(.Unsupported)
        }
        at = Align(at, type.alignment)
        if at > 2147483647 - type.size { return Problem(.Limit) }
        at += type.size
    }
    layout.globals_size = at
    layout.fuel = -1; layout.trap_status = -1; layout.stack_limit = -1; layout.pointer_header = -1
    layout.table = -1; layout.arena = -1; layout.heap = -1; layout.console = -1; layout.host_slots = -1
    // Stored bytes first: the fuel budget and the pointer runtime's header and
    // the globals' table entries; everything after is zero fill.
    if needs.fuel { layout.fuel = Align(at, 8); at = layout.fuel + 8 }
    memory := at
    if needs.pointer {
        layout.pointer_header = Align(at, 8)
        layout.table = Align(layout.pointer_header + MachinePointerHeaderBytes, MachinePointerEntryBytes)
        slots := program.globals.count + 1
        if slots > MachinePointerCapacity || layout.table > 2147483647 - slots * MachinePointerEntryBytes {
            return Problem(.Limit)
        }
        at = layout.table + slots * MachinePointerEntryBytes
        layout.arena = Align(layout.table + (MachinePointerCapacity + 1) * MachinePointerEntryBytes, 16)
        memory = layout.arena + MachinePointerArenaBytes
    }
    layout.size = at
    if needs.trap { layout.trap_status = Align(memory, 4); memory = layout.trap_status + 4 }
    if needs.stack { layout.stack_limit = Align(memory, 8); memory = layout.stack_limit + 8 }
    if needs.runtime.resize { layout.heap = Align(memory, 16); memory = layout.heap + MachineX64RuntimeHeapBytes }
    if needs.runtime.buffered {
        layout.console = Align(memory, 16)
        memory = layout.console + MachineX64RuntimeConsoleBytes
    }
    if hosts > 0 {
        if hosts > (2147483647 - memory) / 8 - 1 { return Problem(.Limit) }
        layout.host_slots = Align(memory, 8)
        memory = layout.host_slots + hosts * 8
    }
    layout.memory = memory
    return NoDiagnostic()
}

GlobalsMeasure :: (program: MachineProgram, writable: bool, size: *s64) -> MachineDiagnostic {
    at: s64 = 0
    for global: program.globals {
        if global.type < 0 || global.type >= program.types.count { return Problem(.Unsupported) }
        if global.writable != writable { continue }
        type := program.types[global.type]
        if type.size <= 0 || type.size > 2147483647 || !ValidAlignment(type.alignment) {
            return Problem(.Unsupported)
        }
        at = Align(at, type.alignment)
        if at > 2147483647 - type.size { return Problem(.Limit) }
        at += type.size
    }
    <<size = at
    return NoDiagnostic()
}

GlobalOffset :: (program: MachineProgram, symbol: s32, writable: bool, offset: *s64) -> bool {
    if symbol < 0 || symbol >= program.globals.count { return false }
    if program.globals[symbol].writable != writable { return false }
    at: s64 = 0
    for index: cast(s64)0..program.globals.count - 1 {
        global := program.globals[index]
        if global.type < 0 || global.type >= program.types.count { return false }
        if global.writable != writable { continue }
        type := program.types[global.type]
        if type.size <= 0 || !ValidAlignment(type.alignment) { return false }
        at = Align(at, type.alignment)
        if index == symbol { <<offset = at; return true }
        at += type.size
    }
    return false
}

Relative32 :: (target: s64, addend: s64, field: s64, value: *s64) -> bool {
    // Every position in an image is bounded below 2^32 and relocation
    // addends are restricted to i32, so this subtraction cannot overflow.
    if target < 0 || target > 0xffffffff || field < 0 || field > 0xffffffff ||
        addend < -2147483648 || addend > 2147483647 { return false }
    displacement := target + addend - field
    if displacement < -2147483648 || displacement > 2147483647 { return false }
    <<value = displacement
    return true
}

TrapOpcode :: (opcode: MachineOpcode) -> bool {
    return opcode == .IntegerDivide || opcode == .IntegerRemainder ||
        opcode == .ShiftLeft || opcode == .ShiftRight || opcode == .AggregateExtract ||
        opcode == .AggregateInsert || opcode == .ElementAddress ||
        opcode == .Convert || opcode == .Fuel || opcode == .Trap || opcode == .Unreachable ||
        PointerOpcode(opcode)
}

// Instructions whose sequences use the pointer runtime header.
PointerOpcode :: (opcode: MachineOpcode) -> bool {
    return opcode == .PointerResolve || opcode == .PointerCreate || opcode == .ArenaAllocate ||
        opcode == .Resize
}

FunctionNameEqual :: (program: MachineProgram, symbol: s32, expected: string) -> bool {
    if symbol < 0 || symbol >= program.functions.count { return false }
    function := program.functions[symbol]
    if function.name_offset < 0 || function.name_length != expected.count ||
        function.name_offset > program.text.count - function.name_length { return false }
    for index: cast(s64)0..expected.count - 1 {
        if program.text[function.name_offset + index] != cast(u8)expected[index] { return false }
    }
    return true
}

// The position of a platform service the runtime implements.
PlatformTarget :: (program: MachineProgram, layout: MachineX64ImageLayout, symbol: s32, position: *s64) -> bool {
    routines := layout.routines
    if FunctionNameEqual(program, symbol, "ziran.platform.write_all") { <<position = routines.write_all; return true }
    if FunctionNameEqual(program, symbol, "ziran.print.signed") { <<position = routines.print_signed; return true }
    if FunctionNameEqual(program, symbol, "ziran.print.unsigned") { <<position = routines.print_unsigned; return true }
    if FunctionNameEqual(program, symbol, "ziran.print.bool") { <<position = routines.print_bool; return true }
    if layout.float == 0 { return false }
    if FunctionNameEqual(program, symbol, "ziran.print.float32") { <<position = layout.float + Float32Offset; return true }
    if FunctionNameEqual(program, symbol, "ziran.print.float64") { <<position = layout.float + Float64Offset; return true }
    return false
}

// What the image references: fuel, traps, the stack limit, the pointer
// runtime and each runtime routine. Standard output is buffered unless the
// program's one console call runs at most once, which buffering cannot help.
ImageNeeds :: (program: MachineProgram, image: MachineX64Image) -> MachineX64ImageNeeds {
    needs: MachineX64ImageNeeds
    consoles: s64 = 0
    console_at: s32 = MachineNoId
    for instruction: program.instructions {
        if instruction.opcode == .Resize { needs.runtime.resize = true }
    }
    for relocation: image.relocations {
        if relocation.kind == .FuelCounter { needs.fuel = true }
        if relocation.kind == .TrapHandler { needs.trap = true }
        if relocation.kind == .StackLimit { needs.stack = true }
        if relocation.kind == .PointerRuntime { needs.pointer = true }
        if relocation.kind != .PlatformService { continue }
        consoles += 1
        console_at = relocation.instruction
        symbol := relocation.symbol
        if FunctionNameEqual(program, symbol, "ziran.platform.write_all") { needs.runtime.write_all = true }
        if FunctionNameEqual(program, symbol, "ziran.print.signed") { needs.runtime.signed = true }
        if FunctionNameEqual(program, symbol, "ziran.print.unsigned") { needs.runtime.unsigned = true }
        if FunctionNameEqual(program, symbol, "ziran.print.bool") { needs.runtime.print_bool = true }
        if FunctionNameEqual(program, symbol, "ziran.print.float32") ||
            FunctionNameEqual(program, symbol, "ziran.print.float64") {
            needs.float = true
            needs.runtime.stdout_bytes = true
        }
    }
    // A refused resize traps through the stub.
    if needs.runtime.resize { needs.trap = true }
    needs.runtime.buffered = MachineX64RuntimeConsole(needs.runtime) && (consoles != 1 || !Once(program, console_at))
    needs.runtime.exit = needs.trap || needs.runtime.buffered
    return needs
}

// Whether INSTRUCTION runs at most once: it lies in the entry function, which
// no call, address or initializer names and whose edges all lead to later
// blocks.
Once :: (program: MachineProgram, instruction: s32) -> bool {
    if instruction < 0 || program.entry < 0 { return false }
    entry := program.functions[program.entry]
    inside := false
    for block_id: entry.block_begin..entry.block_begin + entry.block_count - 1 {
        block := program.blocks[block_id]
        end := block.instruction_begin + block.instruction_count
        if instruction >= block.instruction_begin && instruction < end { inside = true }
        for at: block.instruction_begin..end - 1 {
            item := program.instructions[at]
            for edge: item.edge_begin..item.edge_begin + item.edge_count - 1 {
                if program.edges[edge].target <= block_id { return false }
            }
            for local: 0..item.operand_count - 1 {
                operand := program.operands[item.operand_begin + local]
                if operand.kind == .Block && operand.id <= block_id { return false }
            }
        }
    }
    if !inside { return false }
    for relocation: program.relocations {
        if (relocation.kind == .FunctionCall || relocation.kind == .FunctionAddress) &&
            relocation.symbol == program.entry { return false }
    }
    for initializer: program.initializers { if initializer == program.entry { return false } }
    return true
}

RuntimePlaces :: (layout: MachineX64ImageLayout) -> MachineX64RuntimePlaces {
    data := layout.data_layout
    return .{trap = layout.trap, heap = layout.data + data.heap, console = layout.data + data.console,
        os = layout.os, imports = layout.imports}
}

Windows :: (layout: MachineX64ImageLayout) -> bool { return layout.os == .Windows }

StartupSize :: (program: MachineProgram, layout: MachineX64ImageLayout) -> s64 {
    needs := layout.needs
    size := program.initializers.count * 5 + 7
    if Windows(layout) { size += 4 }
    if Windows(layout) && needs.float { size += 2 }
    if needs.stack { size += StackSetupSize }
    if needs.runtime.buffered { size += 5 } else { size += ifx Windows(layout) then 14 else 7 }
    // int3 bytes up to a 32-byte boundary: the encoder aligns functions and
    // keeps branches inside 32-byte blocks relative to the code's start.
    end := layout.text + size
    return size + (32 - end % 32) % 32
}

Code :: (layout: MachineX64ImageLayout) -> s64 { return layout.text + layout.startup_size }

// Whether FUNCTION's prologue checks its stack or keeps checked frame storage.
PrologueChecks :: (program: MachineProgram, function: s64) -> bool {
    return MachineX64StackChecked(program, cast(s32)function) ||
        program.functions[function].arena_mark != 0 || program.functions[function].fuel_register
}

// Whether a field at OFFSET lies inside the prologue of a function that
// checks its stack or keeps checked frame storage.
InPrologue :: (program: MachineProgram, image: MachineX64Image, offset: s64) -> bool {
    for function_id: cast(s64)0..image.functions.count - 1 {
        function := image.functions[function_id]
        if offset >= function.begin && offset + 4 <= function.body { return PrologueChecks(program, function_id) }
    }
    return false
}

// Whether RELOCATION's field lies in the traps after OWNER's blocks, where
// only a trap call and the fuel store before it have fields.
InColdTraps :: (image: MachineX64Image, owner: s64, relocation: MachineX64Relocation) -> bool {
    if relocation.kind != .TrapHandler && relocation.kind != .FuelCounter || owner >= image.functions.count {
        return false
    }
    function := image.functions[owner]
    return relocation.offset >= function.cold && relocation.offset + 4 <= function.end
}

// Whether RELOCATION's field lies inside its instruction, or in the traps
// after the blocks of the function that holds the checking instruction.
WithinInstruction :: (image: MachineX64Image, owner: s64, relocation: MachineX64Relocation) -> bool {
    range := image.instructions[relocation.instruction]
    if relocation.offset >= range.begin && relocation.offset + 4 <= range.end { return true }
    if !InColdTraps(image, owner, relocation) { return false }
    function := image.functions[owner]
    return range.begin >= function.begin && range.end <= function.cold
}

// The index of FUNCTION's import among HOSTS, which are in function order,
// or -1 when the image does not import it.
HostIndex :: (hosts: []MachineX64HostImport, function: s32) -> s64 {
    low: s64 = 0
    high := hosts.count
    while low < high {
        middle := low + (high - low) / 2
        if hosts[middle].function < function { low = middle + 1 } else { high = middle }
    }
    return ifx low < hosts.count && hosts[low].function == function then low else -1
}

// The position of the INDEX-th import's slot.
HostSlot :: (layout: MachineX64ImageLayout, index: s64) -> s64 {
    if Windows(layout) { return layout.hosts[index].slot }
    return layout.data + layout.data_layout.host_slots + index * 8
}

// The imports are the program's host functions, each once, in order, and
// each has a veneer.
HostsMeasure :: (program: MachineProgram, hosts: []MachineX64HostImport) -> MachineDiagnostic {
    previous: s32 = -1
    for host: hosts {
        if host.function <= previous || host.function >= program.functions.count ||
            program.functions[host.function].calling != .Host || host.library < 0 {
            return Problem(.Relocation)
        }
        previous = host.function
        if !MachineX64HostSupported(program, host) {
            diagnostic := Problem(.HostAbi)
            diagnostic.function = host.function
            return diagnostic
        }
    }
    return NoDiagnostic()
}

// The built-in services are host functions too: each once, in order, each
// provided by the executable itself (MachineX64HostBuiltin) with the
// signature its service takes, and each has a veneer.
BuiltinsMeasure :: (program: MachineProgram, builtins: []MachineX64HostImport) -> MachineDiagnostic {
    previous: s32 = -1
    for host: builtins {
        if host.function <= previous || host.function >= program.functions.count ||
            program.functions[host.function].calling != .Host || host.library != Host.MachineX64HostBuiltin {
            return Problem(.Relocation)
        }
        previous = host.function
        if !Host.MachineX64HostBuiltinSupported(program, host) {
            diagnostic := Problem(.HostAbi)
            diagnostic.function = host.function
            return diagnostic
        }
    }
    return NoDiagnostic()
}

// The position a relocation's field reaches, or false when the image has no
// such target.
RelocationTarget :: (program: MachineProgram, layout: MachineX64ImageLayout,
    relocation: MachineX64Relocation, target: *s64) -> bool {
    data := layout.data_layout
    if relocation.kind == .GlobalAddress || relocation.kind == .ConstantAddress {
        readonly := relocation.kind == .ConstantAddress
        offset: s64 = 0
        if !GlobalOffset(program, relocation.symbol, !readonly, *offset) { return false }
        <<target = ifx readonly then layout.constants + offset else layout.data + offset
        return true
    }
    if relocation.kind == .PlatformService { return PlatformTarget(program, layout, relocation.symbol, target) }
    piece: s64 = -1
    if relocation.kind == .FuelCounter { piece = data.fuel }
    if relocation.kind == .StackLimit { piece = data.stack_limit }
    if relocation.kind == .PointerRuntime { piece = data.pointer_header }
    if piece >= 0 { <<target = layout.data + piece; return true }
    if relocation.kind == .HostCapability {
        index := HostIndex(layout.builtins, relocation.symbol)
        if index >= 0 { <<target = layout.builtins[index].veneer; return true }
        index = HostIndex(layout.hosts, relocation.symbol)
        if index < 0 { return false }
        <<target = layout.hosts[index].veneer
        return true
    }
    if relocation.kind == .TrapHandler && layout.trap > 0 { <<target = layout.trap; return true }
    if relocation.kind == .RuntimeResize && layout.needs.runtime.resize { <<target = layout.routines.resize; return true }
    return false
}

Put8 :: (output: []u8, at: s64, value: u8) { output[at] = value }

PutLittle :: (output: []u8, at: s64, value: u64, count: s32) {
    for index: 0..count - 1 {
        output[at + index] = cast(u8)((value >> cast(u64)(index * 8)) & 255)
    }
}

PutRelative :: (output: []u8, at: s64, target: s64, addend: s64) -> bool {
    value: s64 = 0
    if !Relative32(target, addend, at, *value) { return false }
    PutLittle(output, at, cast(u64)value, 4)
    return true
}

WriteFloatRuntime :: (output: []u8, at: s64) {
first: [384]u8 = .[
  0x53,0x66,0x48,0x0f,0x7e,0xc2,0x41,0x89,0xfb,0x31,0xc9,0x48,
  0x81,0xec,0xc0,0x01,0x00,0x00,0x48,0x85,0xd2,0x79,0x11,0xc6,
  0x44,0x24,0x30,0x2d,0x0f,0x57,0x05,0xc1,0x02,0x00,0x00,0xb9,
  0x01,0x00,0x00,0x00,0xbe,0xff,0x07,0x00,0x00,0x48,0x89,0xd0,
  0x8d,0x79,0x01,0x48,0xc1,0xe6,0x34,0x48,0xf7,0xd0,0x48,0x85,
  0xf0,0x75,0x3f,0x49,0xb8,0xff,0xff,0xff,0xff,0xff,0xff,0x0f,
  0x00,0x8d,0x41,0x02,0x8d,0x71,0x03,0x4c,0x85,0xc2,0x75,0x0a,
  0x41,0xb1,0x69,0x41,0xb0,0x6e,0xb2,0x66,0xeb,0x08,0x41,0xb1,
  0x6e,0x41,0xb0,0x61,0xb2,0x6e,0x48,0x63,0xff,0x48,0x98,0x44,
  0x88,0x4c,0x0c,0x30,0x48,0x63,0xf6,0x44,0x88,0x44,0x3c,0x30,
  0x88,0x54,0x04,0x30,0xeb,0x13,0x0f,0x57,0xc9,0x66,0x0f,0x2e,
  0xc1,0x7a,0x14,0x75,0x12,0xc6,0x44,0x0c,0x30,0x30,0x48,0x63,
  0xf7,0x48,0x8d,0x7c,0x24,0x30,0xe9,0x17,0x02,0x00,0x00,0xf2,
  0x0f,0x11,0x04,0x24,0xdd,0x04,0x24,0x45,0x31,0xc0,0xd9,0x05,
  0x48,0x02,0x00,0x00,0xd9,0xc9,0xdb,0xf1,0xd9,0xc1,0x72,0x09,
  0xdd,0xd8,0xde,0xf1,0x41,0xff,0xc0,0xeb,0xe9,0xdd,0xda,0xd9,
  0xc9,0xd9,0xe8,0xdb,0xf2,0x76,0x0b,0xd9,0xca,0xd8,0xc9,0xd9,
  0xca,0x41,0xff,0xc8,0xeb,0xf1,0xdd,0xd8,0xbe,0x11,0x00,0x00,
  0x00,0x45,0x85,0xdb,0x74,0x05,0xbe,0x09,0x00,0x00,0x00,0xd9,
  0x7c,0x24,0x0e,0x41,0xb9,0x01,0x00,0x00,0x00,0x41,0xba,0x01,
  0x00,0x00,0x00,0xbb,0x0a,0x00,0x00,0x00,0x66,0x8b,0x44,0x24,
