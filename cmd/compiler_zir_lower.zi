}

ZIR_BIT_NONE :: 0
ZIR_BIT_CLZ :: 1
ZIR_BIT_CTZ :: 2
ZIR_BIT_POPCOUNT :: 3
ZIR_BIT_BSWAP :: 4

// Kind helpers: width, signedness, float classification, mask, sign extension
// and float bit moves.
LowerKindBits :: (kind: s32) -> s32 {
    if kind == ZI_K_F32 { return 32 }
    if kind == ZI_K_F64 { return 64 }
    shift: s32 = kind / 2
    return cast(s32)8 << shift
}
LowerKindSigned :: (kind: s32) -> bool { return kind <= ZI_K_S64 && (kind & 1) != 0 }
LowerKindFloat :: (kind: s32) -> bool { return kind >= ZI_K_F32 }
LowerKindMask :: (kind: s32) -> u64 {
    bits: u64 = cast(u64)LowerKindBits(kind)
    if bits == cast(u64)64 { return 18446744073709551615 }
    return (cast(u64)1 << bits) - cast(u64)1
}
LowerSignExtend :: (value: u64, kind: s32) -> s64 {
    width: u64 = cast(u64)LowerKindBits(kind)
    if width == cast(u64)64 { return cast(s64)value }
    sign := cast(u64)1 << (width - cast(u64)1)
    bits := value & LowerKindMask(kind)
    if (bits & sign) != cast(u64)0 { return cast(s64)(bits | ~LowerKindMask(kind)) }
    return cast(s64)bits
}
LowerFloatGet :: (bits: u64, kind: s32) -> float64 {
    if kind == ZI_K_F32 {
        word: s32 = cast(s32)(bits & 4294967295)
        single: float32
        memcpy(cast(*void)*single, cast(*void)*word, 4)
        return cast(float64)single
    }
    value: float64
    memcpy(cast(*void)*value, cast(*void)*bits, 8)
    return value
}
LowerFloatPut :: (value: float64, kind: s32) -> u64 {
    if kind == ZI_K_F32 {
        single := cast(float32)value
        word: s32
        memcpy(cast(*void)*word, cast(*void)*single, 4)
        return cast(u64)word & cast(u64)4294967295
    }
    word: u64
    memcpy(cast(*void)*word, cast(*void)*value, 8)
    return word
}

// A program-lifetime allocation; freed together in Free. The padding keeps
// every buffer 16-byte aligned, matching the C header's max_align_t.
Allocation :: struct {
    next: *Allocation
    padding: [8]u8
}

// A growable array whose buffers the program arena keeps. Generics replace
// the C version's runtime element width.
Vector :: struct ($T: Type) {
    data: *T
    count: s32
    capacity: s32
}

AssemblyBinding :: struct {
    name: *u8
    type: s32
    value: s32
    storage_type: s32
}

AssemblyLocalPlace :: struct {
    binding: s32
    type: s32
    value: s32
    member: s32
    index: s32
    storage: s32
    parent: *AssemblyLocalPlace
}

AssemblyType :: struct {
    module: *IR.ZirModule
    name: *u8
    record: *IR.ZirType
    identity: s32
}

AssemblyGlobal :: struct {
    module: *IR.ZirModule
    source: *IR.ZirGlobal
    result: LIR.LirGlobal
}

AssemblyBlock :: struct {
    parameters: Vector(s32)
    instructions: Vector(LIR.LirInstruction)
    effect: s32
}

// A frame slot of one type that the procedure allocates on entry and never
// writes: the source of that type's long zero values.
AssemblyZeroSlot :: struct {
    type: s32
    address: s32
}

AssemblyLoop :: struct {
    header: s32
    exit: s32
    bindings: s32
    identity: s32
    parent: *AssemblyLoop
}

AssemblyFunction :: struct {
    module: *IR.ZirModule
    source: *IR.ZirFunction
    // Source type spelling for a generated module dispatch capability.
    dispatch_type: *u8
    // Lowering a `#checks` access: its bounded instructions keep their checks.
    checking: bool
    import: *IR.ZirImport
    result: LIR.LirFunction
    blocks: Vector(AssemblyBlock)
    values: Vector(s32)
    bindings: Vector(AssemblyBinding)
    addressed: *u8
    addressed_count: s32
    current: s32
    loop: *AssemblyLoop
    // A constant global initializer: one more than the global it stores
    // into, and the root of its parsed initializer expression.
    initializes: s32
    initializer_root: s32
    // One more than the expression whose untyped numeric literal takes
    // `literal_type`: a member or global the literal initializes.
    literal_at: s32
    literal_type: s32
    zero_slots: Vector(AssemblyZeroSlot)
}

#scope_export

AssemblyExportRoot :: struct {
    module: *IR.ZirModule
    function: *IR.ZirFunction
}

// The module keeps this record; C hosts hold the pointer opaquely.
AssemblyProgram :: struct {
    result: LIR.LirProgram
    source: *IR.ZirProgram
    allocations: *Allocation
    modules: Vector(string)
    sources: Vector(string)
    constants: Vector(LIR.LirConstant)
    globals: Vector(AssemblyGlobal)
    origins: Vector(LIR.LirOrigin)
    functions: Vector(*AssemblyFunction)
    initializers: Vector(s32)
    // Initializers of constant aggregate, float and string globals. They
    // run before every module startup procedure.
    constant_initializers: Vector(s32)
    // Parsed initializer expressions, freed with the program.
    probes: Vector(*IR.ZirFunction)
    types: Vector(LIR.LirType)
    type_names: Vector(AssemblyType)
    bytes: usize
    work: s64
    failed: s32
    string_type: s32
    // The host interface text, built on first request.
    interface: *u8
    interface_length: usize
}

#scope_file

// The in-memory shape of a []T slice, for views over arena storage.
SliceParts :: struct {
    data: *void
    length: s64
}

// The in-memory shape of a string, for text over arena storage.
TextParts :: struct {
    data: *u8
    length: usize
}

// The same layout as a Vector($T), for the shared push core.
RawVector :: struct {
    data: *void
    count: s32
    capacity: s32
}

#scope_export

// Views over arena storage, one builder per element type: a polymorphic
// procedure cannot return []$T, so each spells its own slice.
Owned :: (bytes: *u8) -> string {
    result: string = ""
    if bytes == null { return result }
    parts := cast(*TextParts)(*result)
    parts.data = bytes
    parts.length = strlen(bytes)
    return result
}

U8Items :: (data: *u8, count: s64) -> []u8 {
    result: []u8
    parts := cast(*SliceParts)(*result)
    parts.data = cast(*void)data
    parts.length = count
    return result
}

S32Items :: (data: *s32, count: s64) -> []s32 {
    result: []s32
    parts := cast(*SliceParts)(*result)
    parts.data = cast(*void)data
    parts.length = count
    return result
}

StringItems :: (data: *string, count: s64) -> []string {
    result: []string
    parts := cast(*SliceParts)(*result)
    parts.data = cast(*void)data
    parts.length = count
    return result
}

LirTypeItems :: (data: *LIR.LirType, count: s64) -> []LIR.LirType {
    result: []LIR.LirType
    parts := cast(*SliceParts)(*result)
    parts.data = cast(*void)data
    parts.length = count
    return result
}

LirConstantItems :: (data: *LIR.LirConstant, count: s64) -> []LIR.LirConstant {
    result: []LIR.LirConstant
    parts := cast(*SliceParts)(*result)
    parts.data = cast(*void)data
    parts.length = count
    return result
}

LirOriginItems :: (data: *LIR.LirOrigin, count: s64) -> []LIR.LirOrigin {
    result: []LIR.LirOrigin
    parts := cast(*SliceParts)(*result)
    parts.data = cast(*void)data
    parts.length = count
    return result
}

#scope_file

Say :: (span: IR.ZirSourceSpan, code: string, message: string) {
    SVC.Diagnose(span, code, message)
}
// MESSAGE then one spelling, joined as C's printf reads the pair.
Say :: (span: IR.ZirSourceSpan, code: string, message: string, subject: string) {
    SVC.Diagnose(span, code, message, subject)
}

SayTarget :: (span: IR.ZirSourceSpan, code: string, message: string) {
    DiagnosticTarget(span, SVC.Keep(code), SVC.Keep("asm"), SVC.Keep("lowered-scalar"),
        SVC.Keep("%s"), SVC.Keep(message))
}

Fail :: (program: *AssemblyProgram, span: IR.ZirSourceSpan, message: string) -> s32 {
    if program.failed == 0 {
        SayTarget(span, "assembly.lower", message)
    }
    program.failed = 1
    return -1
}

// A call to a C or Go foreign import: the portable format runs neither,
// and it says so with the semantic bundle writer's words, at the import.
ForeignCall :: (program: *AssemblyProgram, name: *u8) {
    bare := strrchr(name, 46)
    spelled := IR.CText(name)
    if bare != null {
        spelled = IR.CText(bare)[1:IR.CText(bare).count]
    }
    index: s32 = 0
    while index < program.source.module_count && program.failed == 0 {
        module := *program.source.modules[index]
        at: s32 = 0
        while at < module.import_count {
            import := *module.imports[at]
            named := IR.CText(*import.name[0])
            if cast(s32)import.kind != cast(s32)IR.ZirImportKind.EXTERN ||
               cast(s32)import.extern_kind == cast(s32)IR.ZirExternKind.HOST ||
               named != spelled {
                at += 1
                continue
            }
            if cast(s32)import.extern_kind == cast(s32)IR.ZirExternKind.C {
                Say(import.span, "check.foreign",
                    "C foreign imports require a native target or a checked host binding: ", named)
            } else {
                Say(import.span, "check.foreign", "Go foreign imports require the Go target: ", named)
            }
            program.failed = 1
            return
        }
        index += 1
    }
}

Spend :: (program: *AssemblyProgram, span: IR.ZirSourceSpan) -> s32 {
    if program.failed != 0 { return 0 }
    if program.work > 0 {
        program.work -= 1
        return 1
    }
    Fail(program, span, "lowering work budget exhausted")
    return 0
}

Allocate :: (program: *AssemblyProgram, count: usize, width: usize) -> *void {
    budget: usize = 268435456
    header: usize = size_of(Allocation)
    if program.failed != 0 || width == cast(usize)0 || program.bytes > budget - header ||
       count > (budget - header - program.bytes) / width {
        zero: IR.ZirSourceSpan
        Fail(program, zero, "lowered program allocation budget exhausted")
        return null
    }
    size := count * width
    if size == cast(usize)0 { return null }
    allocation := cast(*Allocation)calloc(cast(usize)1, header + size)
    if allocation == null {
        zero: IR.ZirSourceSpan
        Fail(program, zero, "cannot allocate lowered program")
        return null
    }
    allocation.next = program.allocations
    program.allocations = allocation
    program.bytes += header + size
    return cast(*void)(cast(usize)allocation + header)
}

Push :: (program: *AssemblyProgram, vector: *RawVector, width: usize, value: *void) -> bool {
    if vector.count == 2147483647 || width == cast(usize)0 || program.failed != 0 { return false }
    if vector.count == vector.capacity {
        capacity: s32 = 8
        if vector.capacity >= 8 {
            if vector.capacity > 2147483647 / 2 { capacity = 2147483647 }
            else { capacity = vector.capacity * 2 }
        }
        data := Allocate(program, cast(usize)capacity, width)
        if data == null { return false }
        if vector.count > 0 {
            memcpy(data, vector.data, cast(usize)vector.count * width)
        }
        vector.data = data
        vector.capacity = capacity
    }
    destination := cast(*void)(cast(usize)vector.data + cast(usize)vector.count * width)
    if value != null { memcpy(destination, value, width) }
    vector.count += 1
    return true
}

PushS32 :: (program: *AssemblyProgram, vector: *Vector(s32), value: s32) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(s32), cast(*void)*value)
}

PushString :: (program: *AssemblyProgram, vector: *Vector(string), value: string) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(string), cast(*void)*value)
}

PushLirType :: (program: *AssemblyProgram, vector: *Vector(LIR.LirType), value: LIR.LirType) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(LIR.LirType), cast(*void)*value)
}

PushLirConstant :: (program: *AssemblyProgram, vector: *Vector(LIR.LirConstant), value: LIR.LirConstant) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(LIR.LirConstant), cast(*void)*value)
}

PushLirOrigin :: (program: *AssemblyProgram, vector: *Vector(LIR.LirOrigin), value: LIR.LirOrigin) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(LIR.LirOrigin), cast(*void)*value)
}

SliceOf :: (vector: Vector(u8)) -> []u8 { return U8Items(vector.data, cast(s64)vector.count) }
SliceOf :: (vector: Vector(s32)) -> []s32 { return S32Items(vector.data, cast(s64)vector.count) }
SliceOf :: (vector: Vector(string)) -> []string { return StringItems(vector.data, cast(s64)vector.count) }
SliceOf :: (vector: Vector(LIR.LirType)) -> []LIR.LirType { return LirTypeItems(vector.data, cast(s64)vector.count) }
SliceOf :: (vector: Vector(LIR.LirConstant)) -> []LIR.LirConstant { return LirConstantItems(vector.data, cast(s64)vector.count) }
SliceOf :: (vector: Vector(LIR.LirOrigin)) -> []LIR.LirOrigin { return LirOriginItems(vector.data, cast(s64)vector.count) }

// A NUL-terminated copy in the program arena, or "" when allocation failed.
Text :: (program: *AssemblyProgram, text: *u8) -> *u8 {
    if text == null { text = SVC.Keep("") }
    length := strlen(text)
    copy := cast(*u8)Allocate(program, length + cast(usize)1, cast(usize)1)
    if copy != null {
        memcpy(cast(*void)copy, cast(*void)text, length + cast(usize)1)
        return copy
    }
    return SVC.Keep("")
}

Name :: (program: *AssemblyProgram, names: *Vector(string), name: *u8) -> s32 {
    values := names.data
    index: s32 = 0
    while index < names.count {
        held := cast(*TextParts)(*values[index])
        if held.length == strlen(name) &&
           memcmp(cast(*void)name, cast(*void)held.data, held.length) == 0 {
            return index
        }
        index += 1
    }
    copy := Text(program, name)
    value := Owned(copy)
    at := names.count
    if PushString(program, names, value) { return at }
    return -1
}

Origin :: (program: *AssemblyProgram, span: IR.ZirSourceSpan) -> s32 {
    file := Name(program, *program.sources, SVC.SpanPath(span))
    line := ifx span.line > 0 then span.line else 1
    column := ifx span.column > 0 then span.column else 1
    has_end := span.end_line >= line && span.end_column > 0 &&
        (span.end_line != line || span.end_column >= column)
    end_line := ifx has_end then span.end_line else 0
    end_column := ifx has_end then span.end_column else 0
    origin := LIR.LirOrigin.{file = file, line = line, column = column,
        end_line = end_line, end_column = end_column,
        begin = -1, end = -1, parent = -1}
    // The instructions of one expression share its span: they share one
    // origin instead of each making a copy.
    if program.origins.count > 0 {
        last := *program.origins.data[program.origins.count - 1]
        if last.file == file && last.line == line && last.column == column &&
           last.end_line == end_line && last.end_column == end_column {
            return program.origins.count - 1
        }
    }
    index := program.origins.count
    if PushLirOrigin(program, *program.origins, origin) { return index }
    return -1
}

#scope_file

// ScalarWidth of zir_scalar.h: the width of a checked integer spelling.
// Portable ZX lowers pointer-sized isize/usize as 64-bit integers,
// matching size_of(isize)/size_of(usize) == 8 below.
ScalarWidth :: (name: *u8) -> s32 {
    spelled := IR.CText(name)
    if spelled == "int" || spelled == "integer" || spelled == "isize" || spelled == "usize" { return 64 }
    if spelled.count == 0 { return 0 }
    if spelled[0] != cast(u8)115 && spelled[0] != cast(u8)117 { return 0 }
    rest := spelled[1:spelled.count]
    if rest == "8" { return 8 }
    if rest == "16" { return 16 }
    if rest == "32" { return 32 }
    if rest == "64" { return 64 }
    return 0
}

// One more push wrapper per element type: a $T binder binds once.
PushAssemblyType :: (program: *AssemblyProgram, vector: *Vector(AssemblyType), value: AssemblyType) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(AssemblyType), cast(*void)*value)
}

PushAssemblyGlobal :: (program: *AssemblyProgram, vector: *Vector(AssemblyGlobal), value: AssemblyGlobal) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(AssemblyGlobal), cast(*void)*value)
}

PushFunctionPtr :: (program: *AssemblyProgram, vector: *Vector(*AssemblyFunction), value: *AssemblyFunction) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(*AssemblyFunction), cast(*void)*value)
}

PushBlock :: (program: *AssemblyProgram, vector: *Vector(AssemblyBlock), value: AssemblyBlock) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(AssemblyBlock), cast(*void)*value)
}

PushBinding :: (program: *AssemblyProgram, vector: *Vector(AssemblyBinding), value: AssemblyBinding) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(AssemblyBinding), cast(*void)*value)
}

PushZeroSlot :: (program: *AssemblyProgram, vector: *Vector(AssemblyZeroSlot), value: AssemblyZeroSlot) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(AssemblyZeroSlot), cast(*void)*value)
}

PushProbe :: (program: *AssemblyProgram, vector: *Vector(*IR.ZirFunction), value: *IR.ZirFunction) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(*IR.ZirFunction), cast(*void)*value)
}

PushInstruction :: (program: *AssemblyProgram, vector: *Vector(LIR.LirInstruction), value: LIR.LirInstruction) -> bool {
    return Push(program, cast(*RawVector)vector, size_of(LIR.LirInstruction), cast(*void)*value)
}

LirEdgeItems :: (data: *LIR.LirEdge, count: s64) -> []LIR.LirEdge {
    result: []LIR.LirEdge
    parts := cast(*SliceParts)(*result)
    parts.data = cast(*void)data
    parts.length = count
    return result
}

LirInstructionItems :: (data: *LIR.LirInstruction, count: s64) -> []LIR.LirInstruction {
    result: []LIR.LirInstruction
    parts := cast(*SliceParts)(*result)
    parts.data = cast(*void)data
    parts.length = count
    return result
}

TypeAt :: (program: *AssemblyProgram, identity: s32) -> *LIR.LirType {
    return *program.types.data[identity]
}

PointerType :: (program: *AssemblyProgram, element: s32, span: IR.ZirSourceSpan) -> s32 {
    if program.failed != 0 || element < 0 { return -1 }
    index: s32 = 0
    while index < program.types.count {
        if Spend(program, span) == 0 { return -1 }
        held := TypeAt(program, index)
        if held.kind == LirTypeKind.Pointer && held.element == element { return index }
        index += 1
    }
    held := LIR.LirType.{kind = LirTypeKind.Pointer, element = element}
    identity := program.types.count
    if PushLirType(program, *program.types, held) { return identity }
    return -1
}

// The element type of an owned Vec(T) record, or -1 for any other type.
VecElement :: (program: *AssemblyProgram, identity: s32) -> s32 {
    names := program.type_names.data
    index: s32 = 0
    while index < program.type_names.count {
        if names[index].identity == identity && names[index].record != null &&
           names[index].record.is_owned_vec != 0 {
            vector := TypeAt(program, identity)
            if vector.kind != LirTypeKind.Record || vector.fields.count != 3 { return -1 }
            pointer := TypeAt(program, vector.fields[0])
            if pointer.kind == LirTypeKind.Pointer { return pointer.element }
            return -1
        }
        index += 1
    }
    return -1
}

OwnedCallable :: (program: *AssemblyProgram, identity: s32) -> bool {
    index: s32 = 0
    while index < program.type_names.count {
        named := program.type_names.data[index]
        if named.identity == identity && named.record != null &&
           named.record.is_owned_callable != 0 { return true }
        index += 1
    }
    return false
}

// Whether values of a type own heap storage: a vector, callable, or a record or
// fixed array that holds one. Pointers and views own nothing.
OwnsStorage :: (program: *AssemblyProgram, identity: s32, depth: s32) -> s32 {
    if depth > 32 || identity <= 0 || identity >= program.types.count { return 0 }
    if VecElement(program, identity) >= 0 || OwnedCallable(program, identity) { return 1 }
    held := TypeAt(program, identity)
    if held.kind == LirTypeKind.Array {
        if held.count > 0 && OwnsStorage(program, held.element, depth + 1) != 0 { return 1 }
        return 0
    }
    if held.kind != LirTypeKind.Record { return 0 }
    field: s32 = 0
    while field < held.fields.count {
        if OwnsStorage(program, held.fields[field], depth + 1) != 0 { return 1 }
        field += 1
    }
    return 0
}

// `string` is the record {data: *u8, count: s64}. Literal bytes live in
// read-only byte-array globals; an empty literal has a null data pointer.
StringType :: (program: *AssemblyProgram, span: IR.ZirSourceSpan) -> s32 {
    if program.string_type > 0 { return program.string_type }
    pointer := PointerType(program, 3, span)
    fields := cast(*s32)Allocate(program, 2, size_of(s32))
    if program.failed != 0 || fields == null { return -1 }
    fields[0] = pointer
    fields[1] = 8
    held := LIR.LirType.{kind = LirTypeKind.Record, fields = S32Items(fields, 2)}
    identity := program.types.count
    if PushLirType(program, *program.types, held) == false { return -1 }
    program.string_type = identity
    return identity
}

#scope_export
// Temporary scaffold check; the real lowering follows below.
#scope_file

// C's ZirParameters flexible array starts after count and its padding.
ParameterAt :: (parameters: *ZirParameters, index: s32) -> *ZirParameter {
    items := cast(*ZirParameter)(cast(usize)parameters + 8)
    return *items[index]
}

TypeIn :: (program: *AssemblyProgram, module: *IR.ZirModule, name: *u8,
           span: IR.ZirSourceSpan, depth: s32) -> s32 {
    if Spend(program, span) == 0 { return -1 }
    if depth > 256 { return Fail(program, span, "lowered type nesting budget exhausted") }
    spelled := IR.CText(name)
    if name == null || spelled.count == 0 || spelled == "void" { return 0 }
    if spelled == "bool" { return 1 }
    width := ScalarWidth(name)
    if width != 0 {
        index: s32 = ifx width == 8 then 0 else ifx width == 16 then 1 else ifx width == 32 then 2 else 3
        offset: s32 = ifx spelled[0] == cast(u8)117 then 1 else 0
        return 2 + index * 2 + offset
    }
    names: *AssemblyType = program.type_names.data
    index: s32 = 0
    while index < program.type_names.count {
        if names[index].module == module && IR.CText(names[index].name) == spelled {
            return names[index].identity
        }
        index += 1
    }
    owner := module
    record := SVC.FindType(module, spelled, *owner)
    if record != null && record.is_enum != 0 {
        return TypeIn(program, owner, *record.enum_backing[0], span, depth + 1)
    }
    if record != null {
        index = 0
        names = program.type_names.data
        while index < program.type_names.count {
            if names[index].record == record { return names[index].identity }
            index += 1
        }
    }
    // Each module that applies a generic record gets its own copy of the
    // instance, named by the record and its arguments; copies with one name
    // and the same template and argument types are one type. Vec(State) of
    // two modules' own State records is two types under one name.
    if record != null && record.is_synthetic_application != 0 {
        index = 0
        names = program.type_names.data
        while index < program.type_names.count {
            known := names[index].record
            known_owner := names[index].module
            found_owner: *IR.ZirModule = null
            if known != null && SVC.FindType(names[index].module, IR.CText(names[index].name), *found_owner) == known &&
               found_owner != null { known_owner = found_owner }
            if known == null || known.is_synthetic_application == 0 ||
               IR.CText(*known.name[0]) != IR.CText(*record.name[0]) ||
               CSameTypeApplication(known_owner, known, owner, record) == 0 {
                index += 1
                continue
            }
            alias := AssemblyType.{module = module, name = Text(program, name),
                record = record, identity = names[index].identity}
            if PushAssemblyType(program, *program.type_names, alias) { return alias.identity }
            return -1
        }
    }
    if record != null && record.is_union != 0 {
        // A union of integers and floats is one unsigned integer as wide as
        // its widest member. A member is read and written by reinterpreting
        // its low bytes, which is what overlapping storage means on a
        // little-endian target.
        cursor: usize = 0
        field: IR.ZirTypeField
        status: s32 = 0
        widest: s32 = 0
        status = SVC.NextField(record, *cursor, *field)
        while status == 1 {
            member := TypeIn(program, owner, *field.type[0], span, depth + 1)
            if program.failed != 0 { return -1 }
            shape := TypeAt(program, member)
            if shape.kind != LirTypeKind.Integer && shape.kind != LirTypeKind.Float {
                return Fail(program, span, "portable unions support scalar fields only")
            }
            if shape.bits > widest { widest = shape.bits }
            status = SVC.NextField(record, *cursor, *field)
        }
        if status < 0 || widest == 0 { return Fail(program, span, "invalid checked union members") }
        identity: s32 = ifx widest == 8 then 3 else ifx widest == 16 then 5 else ifx widest == 32 then 7 else 9
        binding := AssemblyType.{module = module, name = Text(program, name), record = null, identity = identity}
        if PushAssemblyType(program, *program.type_names, binding) { return identity }
        return -1
    }
    if spelled[0] == cast(u8)42 {
        element := TypeIn(program, module, cast(*u8)(cast(usize)name + 1), span, depth + 1)
        identity := PointerType(program, element, span)
        if program.failed != 0 { return -1 }
        binding := AssemblyType.{module = module, name = Text(program, name), record = null, identity = identity}
        if PushAssemblyType(program, *program.type_names, binding) { return identity }
        return -1
    }
    if spelled == "string" { return StringType(program, span) }
    slice_element: [128]u8
    if CSliceElementType(name, *slice_element[0], 128) != 0 {
        // Views are structural: every spelling of []T (an alias, a generic
        // parameter, another module's name) is the same {data: *T, count}.
        element := TypeIn(program, module, *slice_element[0], span, depth + 1)
        pointer := PointerType(program, element, span)
        if program.failed != 0 { return -1 }
        names = program.type_names.data
        index = 0
        while index < program.type_names.count {
            if CSliceElementType(names[index].name, null, 0) == 0 {
                index += 1
                continue
            }
            known := TypeAt(program, names[index].identity)
            if known.kind == LirTypeKind.Record && known.fields.count == 2 &&
               known.fields[0] == pointer {
                alias := AssemblyType.{module = module, name = Text(program, name),
                    record = null, identity = names[index].identity}
                if PushAssemblyType(program, *program.type_names, alias) { return alias.identity }
                return -1
            }
            index += 1
        }
        fields := cast(*s32)Allocate(program, 2, size_of(s32))
        if program.failed != 0 || fields == null { return -1 }
        fields[0] = pointer
        fields[1] = 8
        view := LIR.LirType.{kind = LirTypeKind.Record, fields = S32Items(fields, 2)}
        identity := program.types.count
        binding := AssemblyType.{module = module, name = Text(program, name), record = null, identity = identity}
        if PushLirType(program, *program.types, view) == false { return -1 }
        if PushAssemblyType(program, *program.type_names, binding) == false { return -1 }
        return identity
    }
    vector: ZirVector
    if CVectorType(name, *vector) != 0 {
        // A vector is a fixed array of its lanes; each operation on it is
        // lowered lane by lane, so the portable engine needs no vector type.
        // A native vector, such as s16xN, is one 128-bit block here, as in
        // the portable engine.
        lane := TypeIn(program, module, vector.lane, span, depth + 1)
        if program.failed != 0 { return -1 }
        identity: s32 = -1
        index = 0
        while index < program.types.count && identity < 0 {
            known := TypeAt(program, index)
            if known.kind == LirTypeKind.Array && known.element == lane &&
               known.count == cast(s64)vector.lanes {
                identity = index
            }
            index += 1
        }
        if identity < 0 {
            lanes := LIR.LirType.{kind = LirTypeKind.Array, element = lane,
                count = cast(s64)vector.lanes}
            identity = program.types.count
            if PushLirType(program, *program.types, lanes) == false { return -1 }
        }
        binding := AssemblyType.{module = module, name = Text(program, name), record = null, identity = identity}
        if PushAssemblyType(program, *program.type_names, binding) { return identity }
        return -1
    }
    held: LIR.LirType
    if spelled == "float32" || spelled == "float64" || spelled == "real" {
        // One float type per width for the whole program: a float passed
        // between modules is the same type on both sides.
        bits: s32 = ifx spelled == "float32" then 32 else 64
        index = 0
        while index < program.types.count {
            known := TypeAt(program, index)
            if known.kind == LirTypeKind.Float && known.bits == bits { return index }
            index += 1
        }
        held.kind = LirTypeKind.Float
        held.bits = bits
    } else if CArrayValueType(name) != 0 {
        // Fixed arrays are structural like views: every spelling of [N]T,
        // whichever module wrote it, is one array of that element and count.
        element: [128]u8
        count: s32 = 0
        if CArrayElementType(name, *element[0], 128, *count) == 0 || count < 0 {
            return Fail(program, span, "invalid checked fixed-array type")
        }
        element_type := TypeIn(program, module, *element[0], span, depth + 1)
        if program.failed != 0 { return -1 }
        identity: s32 = -1
        index = 0
        while index < program.types.count && identity < 0 {
            known := TypeAt(program, index)
            if known.kind == LirTypeKind.Array && known.element == element_type &&
               known.count == cast(s64)count {
                identity = index
            }
            index += 1
        }
        if identity < 0 {
            held.kind = LirTypeKind.Array
            held.element = element_type
            held.count = cast(s64)count
            identity = program.types.count
            if PushLirType(program, *program.types, held) == false { return -1 }
        }
        binding := AssemblyType.{module = module, name = Text(program, name), record = record, identity = identity}
        if PushAssemblyType(program, *program.type_names, binding) { return identity }
        return -1
    } else if record != null && record.is_procedure_type != 0 && record.is_c_call == 0 {
        held.kind = LirTypeKind.Function
    } else if record != null && record.is_procedure_type == 0 && record.is_union == 0 &&
              record.is_record_template == 0 && record.is_map == 0 && record.is_extern == 0 &&
              record.foreign_target[0] == 0 {
        held.kind = LirTypeKind.Record
    } else {
        return Fail(program, span, "this type has no portable lowered representation yet")
    }
    if record != null && record.is_owned_vec != 0 {
        // Vectors are structural like views: every specialization of Vec(T),
        // whichever module spelled it, is one {data: *T, count, capacity}.
        cursor: usize = 0
        data_field: IR.ZirTypeField
        if SVC.NextField(record, *cursor, *data_field) != 1 {
            return Fail(program, span, "owned vector has an unexpected record shape")
        }
        data := TypeIn(program, owner, *data_field.type[0], span, depth + 1)
        if program.failed != 0 { return -1 }
        names = program.type_names.data
        index = 0
        while index < program.type_names.count {
            if names[index].record == null || names[index].record.is_owned_vec == 0 {
                index += 1
                continue
            }
            known := TypeAt(program, names[index].identity)
            if known.kind == LirTypeKind.Record && known.fields.count == 3 &&
               known.fields[0] == data {
                alias := AssemblyType.{module = module, name = Text(program, name),
                    record = record, identity = names[index].identity}
                if PushAssemblyType(program, *program.type_names, alias) { return alias.identity }
                return -1
            }
            index += 1
        }
    }
    identity := program.types.count
    binding := AssemblyType.{module = module, name = Text(program, name), record = record, identity = identity}
    if PushLirType(program, *program.types, held) == false { return -1 }
    if PushAssemblyType(program, *program.type_names, binding) == false { return -1 }
    if held.kind == LirTypeKind.Function {
        parameters := CParametersOf(*record.body[0])
        types := cast(*s32)Allocate(program, cast(usize)parameters.count, size_of(s32))
        if parameters.count > 0 && types == null { return -1 }
        at: s32 = 0
        while at < parameters.count && program.failed == 0 {
            parameter := ParameterAt(parameters, at)
            types[at] = TypeIn(program, owner, parameter.value_type, span, depth + 1)
            at += 1
        }
        returns := TypeIn(program, owner, *record.procedure_return_type[0], span, depth + 1)
        saved := TypeAt(program, identity)
        saved.parameters = S32Items(types, cast(s64)parameters.count)
        saved.result = returns
    } else if held.kind == LirTypeKind.Record {
        fields: Vector(s32)
        cursor: usize = 0
        field: IR.ZirTypeField
        status := SVC.NextField(record, *cursor, *field)
        while status == 1 && program.failed == 0 {
            field_type := TypeIn(program, owner, *field.type[0], span, depth + 1)
            PushS32(program, *fields, field_type)
            status = SVC.NextField(record, *cursor, *field)
        }
        if status < 0 { return Fail(program, span, "invalid checked record fields") }
        saved := TypeAt(program, identity)
        saved.fields = S32Items(fields.data, cast(s64)fields.count)
        // Vec(T) is {data: *T, count: s64, capacity: s64}.
        if record.is_owned_vec != 0 {
            members := fields.data
            if fields.count != 3 || TypeAt(program, members[0]).kind != LirTypeKind.Pointer ||
               members[1] != 8 || members[2] != 8 {
                return Fail(program, span, "owned vector has an unexpected record shape")
            }
        }
    }
    if program.failed != 0 { return -1 }
    return identity
}

#scope_file

ViewElement :: (program: *AssemblyProgram, identity: s32) -> s32 {
    if identity == program.string_type && identity > 0 { return 3 }
    names := program.type_names.data
    index: s32 = 0
    while index < program.type_names.count {
        if names[index].identity == identity && CSliceElementType(names[index].name, null, 0) != 0 {
            view := TypeAt(program, identity)
            if view.kind != LirTypeKind.Record || view.fields.count != 2 { return -1 }
            pointer := TypeAt(program, view.fields[0])
            if pointer.kind == LirTypeKind.Pointer { return pointer.element }
            return -1
        }
        index += 1
    }
    return -1
}

// Strings, slices and owned vectors index and slice alike: member 0 is
// the data pointer and member 1 the element count.
IndexableElement :: (program: *AssemblyProgram, identity: s32) -> s32 {
    element := ViewElement(program, identity)
    if element >= 0 { return element }
    return VecElement(program, identity)
}

// Whether a checked source type name is an owned Vec(T).
SourceVec :: (function: *AssemblyFunction, name: *u8) -> s32 {
    owner: *IR.ZirModule = function.module
    record: *IR.ZirType = null
    if name != null && IR.CText(name).count > 0 {
        record = SVC.FindType(function.module, IR.CText(name), *owner)
    }
    if record != null && record.is_owned_vec != 0 { return 1 }
    return 0
}

Value :: (program: *AssemblyProgram, function: *AssemblyFunction, type: s32) -> s32 {
    value := function.values.count
    if PushS32(program, *function.values, type) { return value }
    return -1
}

BlockAt :: (function: *AssemblyFunction, index: s32) -> *AssemblyBlock {
    return *function.blocks.data[index]
}

Block :: (program: *AssemblyProgram, function: *AssemblyFunction,
          bindings: *AssemblyBinding, count: s32) -> s32 {
    block: AssemblyBlock
    index: s32 = 0
    while index < count && program.failed == 0 {
        storage := ifx bindings[index].storage_type >= 0 then bindings[index].storage_type else bindings[index].type
        value := Value(program, function, storage)
        PushS32(program, *block.parameters, value)
        index += 1
    }
    at := function.blocks.count
    if PushBlock(program, *function.blocks, block) { return at }
    return -1
}

Enter :: (function: *AssemblyFunction, block: s32, bindings: *AssemblyBinding, count: s32) {
    function.current = block
    if count > 0 {
        memcpy(cast(*void)function.bindings.data, cast(*void)bindings,
            cast(usize)count * size_of(AssemblyBinding))
    }
    function.bindings.count = count
    active := function.bindings.data
    parameters := BlockAt(function, block).parameters.data
    index: s32 = 0
    while index < count {
        active[index].value = parameters[index]
        index += 1
    }
}

Snapshot :: (program: *AssemblyProgram, function: *AssemblyFunction, count: s32) -> *AssemblyBinding {
    copy := cast(*AssemblyBinding)Allocate(program, cast(usize)count, size_of(AssemblyBinding))
    if copy != null && count > 0 {
        memcpy(cast(*void)copy, cast(*void)function.bindings.data,
            cast(usize)count * size_of(AssemblyBinding))
    }
    return copy
}

Emit :: (program: *AssemblyProgram, function: *AssemblyFunction, op: LIR.LirOp, type: s32,
         operands: *s32, count: s32, symbol: s32, span: IR.ZirSourceSpan) -> s32 {
    if program.failed != 0 || function.current < 0 { return -1 }
    copy := cast(*s32)Allocate(program, cast(usize)count, size_of(s32))
    if count > 0 && copy == null { return -1 }
    if count > 0 {
        memcpy(cast(*void)copy, cast(*void)operands, cast(usize)count * size_of(s32))
    }
    instruction := LIR.LirInstruction.{op = op,
        result = ifx type != 0 then Value(program, function, type) else -1,
        operands = S32Items(copy, cast(s64)count),
        symbol = symbol, origin = Origin(program, span)}
    if op == LirOp.Fuel { instruction.immediate = 1 }
    if (op == LirOp.ElementAddress || op == LirOp.Extract || op == LirOp.Insert) &&
        program.source.checks == 0 &&
        (function.checking || function.module != null && function.module.checks != 0) {
        instruction.checked = true
    }
    block := BlockAt(function, function.current)
    if LIR.LirEffectful(op) {
        block.effect += 1
        instruction.effect = block.effect
    }
    if PushInstruction(program, *block.instructions, instruction) { return instruction.result }
    return -1
}

Edge :: (program: *AssemblyProgram, target: s32, bindings: *AssemblyBinding,
         count: s32) -> LIR.LirEdge {
    arguments := cast(*s32)Allocate(program, cast(usize)count, size_of(s32))
    if arguments != null {
        index: s32 = 0
        while index < count {
            arguments[index] = bindings[index].value
            index += 1
        }
    }
    return LIR.LirEdge.{block = target, arguments = S32Items(arguments, cast(s64)count)}
}

Jump :: (program: *AssemblyProgram, function: *AssemblyFunction, target: s32,
         bindings: s32, span: IR.ZirSourceSpan) {
    Emit(program, function, LirOp.Jump, 0, null, 0, -1, span)
    if program.failed != 0 { return }
    block := BlockAt(function, function.current)
    edge := cast(*LIR.LirEdge)Allocate(program, 1, size_of(LIR.LirEdge))
    if edge == null { return }
    <<edge = Edge(program, target, function.bindings.data, bindings)
    instructions := block.instructions.data
    instructions[block.instructions.count - 1].edges = LirEdgeItems(edge, 1)
    function.current = -1
}

Branch :: (program: *AssemblyProgram, function: *AssemblyFunction, condition_in: s32,
           yes: s32, no: s32, bindings: s32, span: IR.ZirSourceSpan) {
    condition := condition_in
    if condition >= 0 && program.failed == 0 && function.values.data[condition] != 1 {
        condition = Emit(program, function, LirOp.Convert, 1, *condition, 1, -1, span)
    }
    Emit(program, function, LirOp.Branch, 0, *condition, 1, -1, span)
    if program.failed != 0 { return }
    block := BlockAt(function, function.current)
    edges := cast(*LIR.LirEdge)Allocate(program, 2, size_of(LIR.LirEdge))
    if edges == null { return }
    edges[0] = Edge(program, yes, function.bindings.data, bindings)
    edges[1] = Edge(program, no, function.bindings.data, bindings)
    instructions := block.instructions.data
    instructions[block.instructions.count - 1].edges = LirEdgeItems(edges, 2)
    function.current = -1
}

Constant :: (program: *AssemblyProgram, function: *AssemblyFunction, type: s32,
             bits_in: u64, span: IR.ZirSourceSpan) -> s32 {
    if program.failed != 0 || type <= 0 || type >= program.types.count { return -1 }
    bits := bits_in
    width := TypeAt(program, type).bits
    if width > 0 && width < 64 {
        bits = bits & ((cast(u64)1 << cast(u64)width) - cast(u64)1)
    }
    held := LIR.LirConstant.{type = type, bits = bits}
    symbol := program.constants.count
    PushLirConstant(program, *program.constants, held)
    return Emit(program, function, LirOp.Constant, type, null, 0, symbol, span)
}

#scope_file

// The parsed initializer of a constant aggregate, float or string global:
// a private function that stores the folded expression, run before every
// module startup procedure.
ConstantInitializer :: (program: *AssemblyProgram, owner: *IR.ZirModule,
                         source: *IR.ZirGlobal, symbol: s32) -> s32 {
    probe := cast(*IR.ZirFunction)Allocate(program, 1, size_of(IR.ZirFunction))
    function := cast(*AssemblyFunction)Allocate(program, 1, size_of(AssemblyFunction))
    if probe == null || function == null { return 0 }
    root := ParseExprTyped(probe, owner, cast(*void)source.init, source.span, cast(*void)(*source.type[0]))
    if PushProbe(program, *program.probes, probe) == false { return 0 }
    if root < 0 {
        Fail(program, source.span, "global initializer is not a lowered constant expression")
        return 0
    }
    probe.span = source.span
    function.module = owner
    function.source = probe
    function.current = -1
    function.initializes = symbol + 1
    function.initializer_root = root
    function.result.module = Name(program, *program.modules, *owner.name[0])
    tail: [13]u8
    IR.CopyText(tail[:], ".initializer")
    name_length := strlen(*source.name[0])
    buffer := cast(*u8)Allocate(program, name_length + 13, 1)
    if buffer == null { return 0 }
    memcpy(cast(*void)buffer, cast(*void)*source.name[0], name_length)
    memcpy(cast(*void)(cast(usize)buffer + name_length), cast(*void)*tail[0], 13)
    function.result.name = Owned(buffer)
    function.result.origin = Origin(program, source.span)
    identity := program.functions.count
    if PushFunctionPtr(program, *program.functions, function) == false { return 0 }
    if PushS32(program, *program.constant_initializers, identity) == false { return 0 }
    return 1
}

// The LIR global of a checked declaration, lowered on first use.
GlobalSymbol :: (program: *AssemblyProgram, owner: *IR.ZirModule,
                 source: *IR.ZirGlobal, span: IR.ZirSourceSpan) -> s32 {
    symbol: s32 = -1
    globals := program.globals.data
    index: s32 = 0
    while index < program.globals.count {
        if Spend(program, span) == 0 { return -1 }
        if globals[index].module == owner && globals[index].source == source {
            symbol = index
            break
        }
        index += 1
    }
    if symbol < 0 {
        type := TypeIn(program, owner, *source.type[0], source.span, 0)
        if program.failed != 0 { return -1 }
        constant: s32 = -1
        parsed: s32 = 0
        if source.init != null && source.init[0] != 0 {
            value_type := TypeAt(program, type)
            literal: u64 = 0
            negative: s32 = 0
            evaluated: s64 = 0
            bits: u64 = 0
            folded: s32 = 0
            if value_type.kind == LirTypeKind.Integer || value_type.kind == LirTypeKind.Bool {
                if CZirSignedIntegerLiteral(source.init, *literal, *negative) != 0 {
                    bits = literal
                    folded = 1
                } else if EvaluateCompileExpression(owner, source.init, source.span, 0, *evaluated) != 0 {
                    bits = cast(u64)evaluated
                    folded = 1
                }
            }
            if folded != 0 {
                if value_type.bits > 0 && value_type.bits < 64 {
                    bits = bits & ((cast(u64)1 << cast(u64)value_type.bits) - cast(u64)1)
                }
                initial := LIR.LirConstant.{type = type, bits = bits}
                constant = program.constants.count
                if PushLirConstant(program, *program.constants, initial) == false { return -1 }
            } else {
                parsed = 1
            }
        }
        copied_name := Text(program, *source.name[0])
        if program.failed != 0 { return -1 }
        result := LIR.LirGlobal.{module = Name(program, *program.modules, *owner.name[0]),
            name = Owned(copied_name), type = type, constant = constant, writable = true}
        global := AssemblyGlobal.{module = owner, source = source, result = result}
        symbol = program.globals.count
        if PushAssemblyGlobal(program, *program.globals, global) == false { return -1 }
        // A record, array, float or string initializer is parsed as the
        // checked expression it is and stored by a private initializer.
        if parsed != 0 {
            if ConstantInitializer(program, owner, source, symbol) == 0 { return -1 }
        }
    }
    return symbol
}

GlobalAddress :: (program: *AssemblyProgram, function: *AssemblyFunction,
                  name: *u8, span: IR.ZirSourceSpan) -> s32 {
    owner: *IR.ZirModule = null
    source: *IR.ZirGlobal = null
    if ResolveGlobalAt(function.module, name, SVC.SpanPath(span), *owner, *source) != 1 {
        return Fail(program, span, "global reference has no unique checked declaration")
    }
    symbol := GlobalSymbol(program, owner, source, span)
    if symbol < 0 { return -1 }
    element := program.globals.data[symbol].result.type
    pointer_type := PointerType(program, element, span)
    return Emit(program, function, LirOp.GlobalAddress, pointer_type, null, 0, symbol, span)
}

// Emit OP and then write INDEX into the instruction's immediate.
Indexed :: (program: *AssemblyProgram, function: *AssemblyFunction, op: LIR.LirOp,
            type: s32, operands: *s32, count: s32, index: u64, span: IR.ZirSourceSpan) -> s32 {
    result := Emit(program, function, op, type, operands, count, -1, span)
    if program.failed == 0 && function.current >= 0 {
        block := BlockAt(function, function.current)
        instructions := block.instructions.data
        instructions[block.instructions.count - 1].immediate = index
    }
    return result
}

#scope_file

// Resolve address-taking to the declaration the checker saw. A declaration's
// initializer still sees an outer declaration with the same name, and closing
// a lexical block restores the previous binding.
ScopeBinding :: struct {
    name: *u8
    source: s32
}

FunctionArgs :: (fn: *IR.ZirFunction) -> *u8 {
    if fn.args_text != null { return fn.args_text }
    return SVC.Keep("")
}

// zir.h's ExprWalk: every expression of one tree, depth first. PENDING must
// have room for every expression of the function.
WalkPush :: (walk: *IR.ZirExprWalk, index: s32) {
    if index >= 0 && index < walk.fn.expr_count && walk.count < walk.fn.expr_count {
        walk.pending[walk.count] = index
        walk.count += 1
    }
}

WalkNext :: (walk: *IR.ZirExprWalk) -> s32 {
    if walk.count == 0 { return -1 }
    walk.count -= 1
    index := walk.pending[walk.count]
    expr := *walk.fn.exprs[index]
    WalkPush(walk, expr.next_sibling)
    WalkPush(walk, expr.third)
    WalkPush(walk, expr.right)
    WalkPush(walk, expr.left)
    WalkPush(walk, expr.first_child)
    return index
}

WalkFirst :: (walk: *IR.ZirExprWalk, root: s32) -> s32 {
    walk.count = 0
    WalkPush(walk, root)
    return WalkNext(walk)
}

FindAddressed :: (program: *AssemblyProgram, function: *AssemblyFunction) -> s32 {
    source := function.source
    parameters := CParametersOf(FunctionArgs(source))
    count := source.stmt_count + parameters.count
    function.addressed = cast(*u8)Allocate(program, cast(usize)count, 1)
    function.addressed_count = count
    binding_of := cast(*s32)Allocate(program, cast(usize)source.expr_count, size_of(s32))
    pending := cast(*s32)Allocate(program, cast(usize)source.expr_count, size_of(s32))
    scope := cast(*ScopeBinding)Allocate(program, cast(usize)count + 1, size_of(ScopeBinding))
    opens := cast(*s32)Allocate(program, cast(usize)(source.stmt_count + 1), size_of(s32))
    if program.failed != 0 { return 0 }
    index: s32 = 0
    while index < source.expr_count {
        binding_of[index] = -1
        index += 1
    }
    scope_count: s32 = 0
    open_count: s32 = 0
    index = 0
    while index < parameters.count {
        parameter := ParameterAt(parameters, index)
        name := ifx parameter.binding_name != null then parameter.binding_name else parameter.name
        if name != null && IR.CText(name).count > 0 {
            scope[scope_count].name = name
            scope[scope_count].source = source.stmt_count + index
            scope_count += 1
        }
        index += 1
    }
    walk := IR.ZirExprWalk.{fn = source, pending = pending, count = 0}
    statement: s32 = 0
    while statement < source.stmt_count && program.failed == 0 {
        body := *source.stmts[statement]
        roots: [2]s32
        roots[0] = body.expr_root
        roots[1] = body.lhs_root
        root: s32 = 0
        while root < 2 {
            expression := WalkFirst(*walk, roots[root])
            while expression >= 0 {
                if Spend(program, source.exprs[expression].span) == 0 { return 0 }
                value := *source.exprs[expression]
                if value.kind != ZirExprKind.IDENT || value.is_global_value != 0 ||
                   value.is_function_value != 0 || value.name == null {
                    expression = WalkNext(*walk)
                    continue
                }
                binding := scope_count
                while binding > 0 {
                    if IR.CText(scope[binding - 1].name) == IR.CText(value.name) {
                        binding_of[expression] = scope[binding - 1].source
                        break
                    }
                    binding -= 1
                }
                expression = WalkNext(*walk)
            }
            root += 1
        }
        if body.kind == ZirStmtKind.DECL && body.name != null && IR.CText(body.name).count > 0 {
            scope[scope_count].name = body.name
            scope[scope_count].source = statement
            scope_count += 1
        }
        if body.kind == ZirStmtKind.BLOCK_OPEN && body.assembly_text != null && body.assembly_text[0] != 0 {
            cursor := body.assembly_text
            variant: CheckedAssemblyVariant
            while AssemblyVariantNext(function.module, source, statement, *cursor, *variant) == 1 {
                for operand: cast(s32)0..variant.outputs + variant.inputs - 1 {
                    value := variant.operands[operand]
                    if !LirAssemblyUsesMemory(IR.CText(value.constraint)) { continue }
                    binding := scope_count
                    while binding > 0 {
                        binding -= 1
                        if IR.CText(scope[binding].name) != IR.CText(value.binding) { continue }
                        function.addressed[scope[binding].source] = 1
                        break
                    }
                }
            }
        }
        if body.kind == ZirStmtKind.IF || body.kind == ZirStmtKind.WHILE ||
           body.kind == ZirStmtKind.BLOCK_OPEN {
            opens[open_count] = scope_count
            open_count += 1
        }
        if body.kind == ZirStmtKind.BLOCK_CLOSE {
            if open_count == 0 {
                Fail(program, body.span, "unbalanced checked statement blocks")
                return 0
            }
            open_count -= 1
            scope_count = opens[open_count]
        }
        statement += 1
    }
    index = 0
    while index < source.expr_count && program.failed == 0 {
        expression := *source.exprs[index]
        target: s32 = -1
        if expression.kind == ZirExprKind.UNARY && IR.CText(*expression.op[0]) == "&" {
            target = expression.right
        } else if expression.kind == ZirExprKind.SLICE && expression.left >= 0 &&
                  CArrayValueType(source.exprs[expression.left].type) != 0 {
            target = expression.left
        } else if expression.kind == ZirExprKind.MEMBER && expression.left >= 0 &&
                  IR.CText(expression.name) == "data" &&
                  CArrayValueType(source.exprs[expression.left].type) != 0 {
            target = expression.left
        }
        if target < 0 {
            index += 1
            continue
        }
        while target >= 0 && target < source.expr_count &&
              (source.exprs[target].kind == ZirExprKind.MEMBER ||
               source.exprs[target].kind == ZirExprKind.INDEX) {
            target = source.exprs[target].left
        }
        if target >= 0 && target < source.expr_count && binding_of[target] >= 0 {
            function.addressed[binding_of[target]] = 1
        }
        index += 1
    }
    if program.failed != 0 { return 0 }
    return 1
}

#scope_file

PromoteBinding :: (program: *AssemblyProgram, function: *AssemblyFunction,
                   binding_index: s32, span: IR.ZirSourceSpan) -> s32 {
    binding := *function.bindings.data[binding_index]
    type := TypeAt(program, binding.type)
    if type.kind == LirTypeKind.Invalid || type.kind == LirTypeKind.Void ||
       type.kind == LirTypeKind.Vector || type.kind == LirTypeKind.Capability {
        return Fail(program, span, "this local type has no portable checked storage representation")
    }
    pointer_type := PointerType(program, binding.type, span)
    if program.failed != 0 { return -1 }
    operands: [1]s32
    operands[0] = binding.value
    address := Emit(program, function, LirOp.Allocate, pointer_type, *operands[0], 1, -1, span)
    if program.failed != 0 || address < 0 { return -1 }
    binding.value = address
    binding.storage_type = pointer_type
    return address
}

LayoutSize :: (program: *AssemblyProgram, identity: s32, alignment: *s64, depth: s32) -> s64 {
    ty := TypeAt(program, identity)
    size: s64 = 0
    align: s64 = 1
    if depth > 256 { return -1 }
    if ty.kind == LirTypeKind.Bool {
        size = 1
    } else if ty.kind == LirTypeKind.Integer || ty.kind == LirTypeKind.Float {
        size = cast(s64)(ty.bits) / 8
        align = size
    } else if ty.kind == LirTypeKind.Pointer || ty.kind == LirTypeKind.Function {
        size = 8
        align = 8
    } else if ty.kind == LirTypeKind.Array {
        element := LayoutSize(program, ty.element, *align, depth + 1)
        if element < 0 || (ty.count != 0 && element > 9223372036854775807 / ty.count) { return -1 }
        size = element * ty.count
    } else if ty.kind == LirTypeKind.Record {
        index: s32 = 0
        while index < ty.fields.count {
            field_align: s64 = 1
            field := LayoutSize(program, ty.fields[index], *field_align, depth + 1)
            if field < 0 || size > 9223372036854775807 - field - field_align { return -1 }
            size = (size + field_align - 1) / field_align * field_align + field
            if field_align > align { align = field_align }
            index += 1
        }
        size = (size + align - 1) / align * align
    } else {
        return -1
    }
    <<alignment = align
    return size
}

// A fixed-array or record local or parameter larger than this many bytes
// lives in a frame slot, like one whose address is taken. A value would be
// passed to every block it is live in, and each pass copies it: a loop over a
// large table would copy the whole table on every iteration. A smaller one
// stays a value, which the optimizer can take apart.
ASSEMBLY_VALUE_BYTES :: 4096

KeptInStorage :: (program: *AssemblyProgram, identity: s32) -> s32 {
    if program.failed != 0 || identity <= 0 || OwnsStorage(program, identity, 0) != 0 { return 0 }
    kind := TypeAt(program, identity).kind
    if kind != LirTypeKind.Array && kind != LirTypeKind.Record { return 0 }
    alignment: s64 = 1
    return ifx LayoutSize(program, identity, *alignment, 0) > ASSEMBLY_VALUE_BYTES then 1 else 0
}

// The zero value of a long fixed array is read from a frame slot that the
// procedure allocates on entry and never writes. Building it from one
// constant per element would cost an instruction per element: 65,536 of them
// for a `[65536]u8` buffer. A frame slot rather than a global, because the
// native encoder lists every element of a global.
ASSEMBLY_ZERO_ARRAY_INLINE :: 256

// A frame slot of type `identity`, allocated first in the entry block, after
// its fuel charge, so it dominates every use; the block's effects are
// numbered again.
EntrySlot :: (program: *AssemblyProgram, function: *AssemblyFunction,
              identity: s32, span: IR.ZirSourceSpan) -> s32 {
    pointer_type := PointerType(program, identity, span)
    if program.failed != 0 { return -1 }
    address := Value(program, function, pointer_type)
    allocate := LIR.LirInstruction.{op = LirOp.Allocate, result = address, symbol = -1,
        origin = Origin(program, span)}
    entry := BlockAt(function, function.result.entry)
    if program.failed != 0 { return -1 }
    if PushInstruction(program, *entry.instructions, allocate) == false { return -1 }
    instructions := entry.instructions.data
    count := entry.instructions.count
    at: s32 = 0
    if count > 1 && instructions[0].op == LirOp.Fuel { at = 1 }
    memmove(cast(*void)(cast(usize)instructions + cast(usize)(at + 1) * size_of(LIR.LirInstruction)),
        cast(*void)(cast(usize)instructions + cast(usize)at * size_of(LIR.LirInstruction)),
        cast(usize)(count - 1 - at) * size_of(LIR.LirInstruction))
    instructions[at] = allocate
    entry.effect = 0
    index: s32 = 0
    while index < count {
        if LIR.LirEffectful(instructions[index].op) {
            entry.effect += 1
            instructions[index].effect = entry.effect
        }
        index += 1
    }
    return address
}

ZeroSlot :: (program: *AssemblyProgram, function: *AssemblyFunction,
             identity: s32, span: IR.ZirSourceSpan) -> s32 {
    if program.failed != 0 || function.current < 0 { return -1 }
    slots := function.zero_slots.data
    address: s32 = -1
    index: s32 = 0
    while index < function.zero_slots.count && address < 0 {
        if slots[index].type == identity { address = slots[index].address }
        index += 1
    }
    if address < 0 {
        address = EntrySlot(program, function, identity, span)
        slot := AssemblyZeroSlot.{type = identity, address = address}
        if address < 0 { return -1 }
        if PushZeroSlot(program, *function.zero_slots, slot) == false { return -1 }
    }
    return Emit(program, function, LirOp.Load, identity, *address, 1, -1, span)
}

Zero :: (program: *AssemblyProgram, function: *AssemblyFunction, identity: s32,
         span: IR.ZirSourceSpan, depth: s32) -> s32 {
    if Spend(program, span) == 0 { return -1 }
    if depth > 256 { return Fail(program, span, "aggregate initialization nesting budget exhausted") }
    type := TypeAt(program, identity)
    if type.kind == LirTypeKind.Array && type.count > ASSEMBLY_ZERO_ARRAY_INLINE {
        return ZeroSlot(program, function, identity, span)
    }
    if type.kind == LirTypeKind.Record || type.kind == LirTypeKind.Array {
        count: s64 = ifx type.kind == LirTypeKind.Record then type.fields.count else type.count
        if count < 0 || count > 2147483647 {
            return Fail(program, span, "aggregate initialization size limit exceeded")
        }
        operands := cast(*s32)Allocate(program, cast(usize)count, size_of(s32))
        if count > 0 && operands == null { return -1 }
        index: s64 = 0
        while index < count && program.failed == 0 {
            element := ifx type.kind == LirTypeKind.Record then type.fields[index] else type.element
            operands[index] = Zero(program, function, element, span, depth + 1)
            index += 1
        }
        return Emit(program, function, LirOp.Aggregate, identity, operands, cast(s32)count, -1, span)
    }
    if type.kind == LirTypeKind.Pointer || type.kind == LirTypeKind.Function {
        return Emit(program, function, LirOp.Null, identity, null, 0, -1, span)
    }
    return Constant(program, function, identity, 0, span)
}

// The most recent binding of `name`, innermost scope first; -1 when the
// name is not a local of this function.
Binding :: (function: *AssemblyFunction, name: *u8) -> s32 {
    bindings := function.bindings.data
    index: s32 = function.bindings.count
    while index > 0 {
        if IR.CText(bindings[index - 1].name) == IR.CText(name) { return index - 1 }
        index -= 1
    }
    return -1
}

// The checked record behind lowered type `identity`, for member lookup; null
// when the lowered type has no checked record behind it, such as a scalar or
// a union lowered to one integer.
Record :: (program: *AssemblyProgram, identity: s32) -> *IR.ZirType {
    names := program.type_names.data
    index: s32 = 0
    while index < program.type_names.count {
        if names[index].identity == identity { return names[index].record }
        index += 1
    }
    return null
}

Field :: (program: *AssemblyProgram, identity: s32, name: *u8, span: IR.ZirSourceSpan) -> s32 {
    record := Record(program, identity)
    if record != null {
        cursor: usize = 0
        field: IR.ZirTypeField
        ordinal: s32 = 0
        status := SVC.NextField(record, *cursor, *field)
        while status == 1 {
            if Spend(program, span) == 0 { return -1 }
            if IR.CText(*field.name[0]) == IR.CText(name) { return ordinal }
            ordinal += 1
            status = SVC.NextField(record, *cursor, *field)
        }
    }
    return Fail(program, span, "record member has no lowered field identity")
}

MemberType :: (program: *AssemblyProgram, identity: s32, member: s32) -> s32 {
    ty := TypeAt(program, identity)
    if ty.kind == LirTypeKind.Record && member >= 0 && cast(s64)(member) < ty.fields.count {
        return ty.fields[member]
    }
    if ty.kind == LirTypeKind.Array && member >= 0 && cast(s64)(member) < ty.count {
        return ty.element
    }
    return -1
}

// A field promoted by `using` reaches its record through each `using` field.
// The checker writes such a member as the dotted path of those fields.
ASSEMBLY_FIELD_PATH_MAX :: 32

// The ordinal and type of each field along `name`, starting at record type
// `identity`. Returns the number of hops, or -1.
FieldPath :: (program: *AssemblyProgram, identity: s32, name: *u8, span: IR.ZirSourceSpan,
              fields: *s32, types: *s32) -> s32 {
    length := strlen(name)
    if length >= cast(usize)128 { return Fail(program, span, "record member path is too long") }
    path := cast(*u8)Allocate(program, length + 1, 1)
    if program.failed != 0 { return -1 }
    memcpy(cast(*void)path, cast(*void)name, length + 1)
    count: s32 = 0
    hop := path
    while hop != null {
        dot := strchr(hop, cast(s32)46)
        if dot != null { <<dot = 0 }
        if count == ASSEMBLY_FIELD_PATH_MAX { return Fail(program, span, "record member path is too long") }
        fields[count] = Field(program, identity, hop, span)
        if program.failed != 0 { return -1 }
        types[count] = MemberType(program, identity, fields[count])
        if types[count] < 0 { return Fail(program, span, "invalid lowered aggregate member") }
        identity = types[count]
        count += 1
        if dot != null { hop = cast(*u8)(cast(usize)dot + 1) } else { hop = null }
    }
    return count
}

// The address of member path `name` behind `address`, a record pointer.
FieldAddress :: (program: *AssemblyProgram, function: *AssemblyFunction, address: s32,
                 name: *u8, span: IR.ZirSourceSpan) -> s32 {
    values := function.values.data
    pointer := TypeAt(program, values[address])
    if pointer.kind != LirTypeKind.Pointer {
        return Fail(program, span, "record address requires a pointer")
    }
    fields := cast(*s32)Allocate(program, ASSEMBLY_FIELD_PATH_MAX, size_of(s32))
    types := cast(*s32)Allocate(program, ASSEMBLY_FIELD_PATH_MAX, size_of(s32))
    if fields == null || types == null { return -1 }
    count := FieldPath(program, pointer.element, name, span, fields, types)
    hop: s32 = 0
    while hop < count && program.failed == 0 {
        address = Indexed(program, function, LirOp.FieldAddress,
            PointerType(program, types[hop], span), *address, 1, cast(u64)(fields[hop]), span)
        hop += 1
    }
    if program.failed != 0 { return -1 }
    return address
}

NamedValue :: (program: *AssemblyProgram, function: *AssemblyFunction,
               name: *u8, span: IR.ZirSourceSpan) -> s32 {
    length := strlen(name)
    path := cast(*u8)Allocate(program, length + 1, 1)
    if path == null { return -1 }
    memcpy(cast(*void)path, cast(*void)name, length + 1)
    member := strchr(path, cast(s32)46)
    if member != null {
        <<member = 0
        member = cast(*u8)(cast(usize)member + 1)
    }
    binding := Binding(function, path)
    current: AssemblyBinding
    if binding >= 0 {
        bindings := function.bindings.data
        current = bindings[binding]
        if current.storage_type >= 0 {
            current.value = Emit(program, function, LirOp.Load, current.type, *current.value, 1, -1, span)
        }
    } else {
        // A receiver that is not local is a module global slot.
        owner: *IR.ZirModule = null
        global: *IR.ZirGlobal = null
        if ResolveGlobalAt(function.module, path, SVC.SpanPath(span), *owner, *global) != 1 {
            return Fail(program, span, "callable receiver is not a lowered local or global binding")
        }
        address := GlobalAddress(program, function, path, span)
        if program.failed != 0 { return -1 }
        pointer := TypeAt(program, function.values.data[address])
        current.type = pointer.element
        current.storage_type = -1
        current.value = Emit(program, function, LirOp.Load, current.type, *address, 1, -1, span)
    }
    while member != null && program.failed == 0 {
        if Spend(program, span) == 0 { return -1 }
        next := strchr(member, cast(s32)46)
        follower: *u8 = null
        if next != null {
            <<next = 0
            follower = cast(*u8)(cast(usize)next + 1)
        }
        shape := TypeAt(program, current.type)
        if shape.kind != LirTypeKind.Record {
            return Fail(program, span, "callable receiver path requires a lowered record value")
        }
        field := Field(program, current.type, member, span)
        if program.failed != 0 { return -1 }
        current.type = MemberType(program, current.type, field)
        current.value = Indexed(program, function, LirOp.Extract, current.type, *current.value, 1, cast(u64)(field), span)
        member = follower
    }
    return current.value
}

// The lowered identity of checked type spelling `name` in the function's
// own module.
Type :: (program: *AssemblyProgram, function: *AssemblyFunction, name: *u8, span: IR.ZirSourceSpan) -> s32 {
    return TypeIn(program, function.module, name, span, 0)
}

// "string.N" for the next free global slot N, in a fresh buffer.
DecimalName :: (program: *AssemblyProgram, prefix: *u8, number: s32) -> *u8 {
    buffer := cast(*u8)Allocate(program, cast(usize)32, cast(usize)1)
    if buffer == null { return null }
    length: s32 = cast(s32)(strlen(prefix))
    index: s32 = 0
    while index < length {
        buffer[index] = prefix[index]
        index += 1
    }
    digits: [20]u8
    count: s32 = 0
    value: u64 = cast(u64)(number)
    if value == 0 {
        digits[0] = cast(u8)48
        count = 1
    } else {
        while value > 0 {
            digits[count] = cast(u8)(48 + cast(s32)(value % 10))
            count += 1
            value = value / 10
        }
    }
    index = 0
    while index < count {
        buffer[length + index] = digits[count - 1 - index]
        index += 1
    }
    buffer[length + count] = cast(u8)0
    return buffer
}

// The constant global holding exactly these bytes, reusing a recorded
// constant when one matches.
StringGlobal :: (program: *AssemblyProgram, module: *IR.ZirModule,
                 bytes: *u8, length: usize, span: IR.ZirSourceSpan) -> s32 {
    globals := program.globals.data
    constants := program.constants.data
    index: s32 = 0
    while index < program.globals.count {
        held := globals[index].result
        if held.writable == false && held.constant >= 0 {
            constant := constants[held.constant]
            bytes_parts := cast(*SliceParts)(*constant.bytes)
            if cast(usize)(bytes_parts.length) == length &&
               memcmp(cast(*void)bytes_parts.data, cast(*void)bytes, length) == 0 {
                return index
            }
        }
        index += 1
    }
    array: s32 = -1
    index = 0
    while index < program.types.count && array < 0 {
        ty := TypeAt(program, index)
        if ty.kind == LirTypeKind.Array && ty.element == 3 && ty.count == cast(s64)(length) {
            array = index
        }
        index += 1
    }
    if array < 0 {
        spelling := LIR.LirType.{kind = LirTypeKind.Array, element = 3, count = cast(s64)(length)}
        array = program.types.count
        if PushLirType(program, *program.types, spelling) == false { return -1 }
    }
    copy := cast(*u8)Allocate(program, length, cast(usize)1)
    if copy == null { return -1 }
    memcpy(cast(*void)copy, cast(*void)bytes, length)
    initial := LIR.LirConstant.{type = array, bytes = U8Items(copy, cast(s64)(length))}
    constant := program.constants.count
    if PushLirConstant(program, *program.constants, initial) == false { return -1 }
    copied := Text(program, DecimalName(program, SVC.Keep("string."), program.globals.count))
    if program.failed != 0 { return -1 }
    result := LIR.LirGlobal.{module = Name(program, *program.modules, *module.name[0]),
        name = Owned(copied), type = array, constant = constant, writable = false}
    global := AssemblyGlobal.{module = module, source = null, result = result}
    symbol := program.globals.count
    if PushAssemblyGlobal(program, *program.globals, global) { return symbol }
    return Fail(program, span, "cannot record string data")
}

// The checked string literal: a slice aggregate over constant data, or null
// for the empty string.
String :: (program: *AssemblyProgram, function: *AssemblyFunction, expression: *IR.ZirExpr) -> s32 {
    capacity := strlen(expression.text) + cast(usize)1
    bytes := cast(*u8)Allocate(program, capacity, cast(usize)1)
    length: usize = 0
    if bytes == null || CDecodeStringLiteral(expression.text, bytes, capacity, *length) == 0 {
        return Fail(program, expression.span, "invalid checked string literal")
    }
    span := expression.span
    record := StringType(program, span)
    pointer := PointerType(program, 3, span)
    if program.failed != 0 { return -1 }
    data: s32 = 0
    if length == 0 {
        data = Emit(program, function, LirOp.Null, pointer, null, 0, -1, span)
    } else {
        global := StringGlobal(program, function.module, bytes, length, span)
        if global < 0 { return -1 }
        array := program.globals.data[global].result.type
        base := Emit(program, function, LirOp.GlobalAddress,
            PointerType(program, array, span), null, 0, global, span)
        operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if operands == null { return -1 }
        operands[0] = base
        operands[1] = Constant(program, function, 8, 0, span)
        data = Emit(program, function, LirOp.ElementAddress, pointer, operands, 2, -1, span)
    }
    fields := cast(*s32)Allocate(program, 2, size_of(s32))
    if fields == null { return -1 }
    fields[0] = data
    fields[1] = Constant(program, function, 8, cast(u64)(length), span)
    if program.failed != 0 { return -1 }
    return Emit(program, function, LirOp.Aggregate, record, fields, 2, -1, span)
}

// A named constant, which a parsed global initializer leaves by name, as
// `NAME` or `Module.NAME`: its compile-time value, typed by the member or
// global it sets. Returns -2 when `name` is not one.
Define :: (program: *AssemblyProgram, function: *AssemblyFunction, name: *u8, type: s32, root: s32,
           span: IR.ZirSourceSpan) -> s32 {
    definition: *IR.ZirDefine = null
    definition_owner: *IR.ZirModule = null
    constant_value: s64 = 0
    if ResolveDefine(function.module, name, *definition, *definition_owner, null) != 1 || definition == null ||
       EvaluateCompileExpression(definition_owner, definition.value, span, 0, *constant_value) == 0 {
        return -2
    }
    typed := type
    own := TypeAt(program, type).kind
    if own != LirTypeKind.Integer && own != LirTypeKind.Bool && function.literal_at == root + 1 {
        typed = function.literal_type
    }
    kind := TypeAt(program, typed).kind
    if kind != LirTypeKind.Integer && kind != LirTypeKind.Bool { return -2 }
    return Constant(program, function, typed, cast(u64)(constant_value), span)
}

Member :: (program: *AssemblyProgram, function: *AssemblyFunction, expression: *IR.ZirExpr, depth: s32) -> s32 {
    if expression.kind == ZirExprKind.MEMBER && expression.left >= 0 &&
       expression.left < function.source.expr_count &&
       function.source.exprs[expression.left].kind == ZirExprKind.IDENT &&
       function.source.exprs[expression.left].is_global_value == 0 &&
       Binding(function, function.source.exprs[expression.left].name) < 0 {
        // A parsed global initializer names an enum member through its type,
        // `Mode.High`, or a constant through a module alias, `Values.LIMIT`.
        left := function.source.exprs[expression.left].name
        enum_owner := function.module
        named := SVC.FindType(function.module, IR.CText(left), *enum_owner)
        member_bits: s64 = 0
        if named != null && named.is_enum != 0 && CEnumMemberValue(named, expression.name, *member_bits) != 0 {
            return Constant(program, function, Type(program, function, left, expression.span),
                cast(u64)(member_bits), expression.span)
        }
        left_length := strlen(left)
        name_length := strlen(expression.name)
        total := left_length + name_length + 1
        constant: s32 = -2
        if total > 0 && total < cast(usize)128 {
            qualified: [128]u8
            at: usize = 0
            while at < left_length {
                qualified[at] = left[at]
                at += 1
            }
            qualified[at] = cast(u8)46
            at += 1
            scan: usize = 0
            while scan < name_length {
                qualified[at] = expression.name[scan]
                at += 1
                scan += 1
            }
            qualified[at] = cast(u8)0
            root := cast(s32)((cast(usize)expression - cast(usize)function.source.exprs) /
                cast(usize)(size_of(IR.ZirExpr)))
            constant = Define(program, function, *qualified[0],
                Type(program, function, expression.type, expression.span), root, expression.span)
        }
        if constant != -2 { return constant }
    }
    if expression.kind == ZirExprKind.MEMBER {
        owner := function.module
        record := SVC.FindType(function.module, IR.CText(expression.type), *owner)
        bits: s64 = 0
        if record != null && record.is_enum != 0 && CEnumMemberValue(record, expression.name, *bits) != 0 {
            return Constant(program, function, Type(program, function, expression.type, expression.span),
                cast(u64)(bits), expression.span)
        }
    }
    if expression.kind == ZirExprKind.MEMBER && IR.CText(expression.name) == "data" &&
       expression.left >= 0 && CArrayValueType(function.source.exprs[expression.left].type) != 0 {
        base := Address(program, function, expression.left, depth + 1)
        if program.failed != 0 { return -1 }
        pointer := TypeAt(program, function.values.data[base])
        if pointer.kind != LirTypeKind.Pointer {
            return Fail(program, expression.span, "fixed-array data requires persistent checked storage")
        }
        array := TypeAt(program, pointer.element)
        if array.kind != LirTypeKind.Array {
            return Fail(program, expression.span, "fixed-array data requires an array address")
        }
        result_type := PointerType(program, array.element, expression.span)
        if array.count == 0 {
            return Emit(program, function, LirOp.Null, result_type, null, 0, -1, expression.span)
        }
        zero := Constant(program, function, 8, 0, expression.span)
        operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if operands == null { return -1 }
        operands[0] = base
        operands[1] = zero
        return Emit(program, function, LirOp.ElementAddress, result_type, operands, 2, -1, expression.span)
    }
    // A plain local's fixed length needs no load from its backing storage.
    // Other receiver expressions still evaluate before selecting the member.
    if expression.kind == ZirExprKind.MEMBER && IR.CText(expression.name) == "count" &&
       expression.left >= 0 && expression.left < function.source.expr_count {
        base := *function.source.exprs[expression.left]
        if base.kind == ZirExprKind.IDENT && base.is_global_value == 0 && base.is_move == 0 {
            binding := Binding(function, base.name)
            if binding >= 0 {
                array := TypeAt(program, function.bindings.data[binding].type)
                if array.kind == LirTypeKind.Array {
                    result_type := Type(program, function, expression.type, expression.span)
                    return Constant(program, function, result_type, cast(u64)array.count, expression.span)
                }
            }
        }
    }
    value := Expression(program, function, expression.left, depth + 1)
    if program.failed != 0 { return -1 }
    identity := function.values.data[value]
    ty := TypeAt(program, identity)
    member: s32 = -1
    if expression.kind == ZirExprKind.INDEX {
        if expression.right < 0 || expression.right >= function.source.expr_count {
            return Fail(program, expression.span, "invalid checked array index")
        }
        index_expr := *function.source.exprs[expression.right]
        view_element := IndexableElement(program, identity)
        if view_element >= 0 {
            data := Indexed(program, function, LirOp.Extract, MemberType(program, identity, 0), *value, 1, 0, expression.span)
            count := Indexed(program, function, LirOp.Extract, MemberType(program, identity, 1), *value, 1, 1, expression.span)
            selected := Expression(program, function, expression.right, depth + 1)
            if program.failed != 0 || TypeAt(program, function.values.data[selected]).kind != LirTypeKind.Integer {
                return Fail(program, expression.span, "string or slice index requires an integer")
            }
            operands := cast(*s32)Allocate(program, 3, size_of(s32))
            if operands == null { return -1 }
            operands[0] = data
            operands[1] = selected
            operands[2] = count
            pointer := PointerType(program, view_element, expression.span)
            address := Emit(program, function, LirOp.ElementAddress, pointer, operands, 3, -1, expression.span)
            return Emit(program, function, LirOp.Load, view_element, *address, 1, -1, expression.span)
        }
        ordinal: u64 = 0
        if ty.kind != LirTypeKind.Array {
            return Fail(program, expression.span, "indexed value is not a lowered fixed array")
        }
        if index_expr.kind != ZirExprKind.INT || CZirIntegerLiteral(index_expr.text, *ordinal) == 0 ||
           ordinal > cast(u64)2147483647 || ordinal >= cast(u64)(ty.count) {
            selected := Expression(program, function, expression.right, depth + 1)
            if program.failed != 0 { return -1 }
            operands := cast(*s32)Allocate(program, 2, size_of(s32))
            if operands == null { return -1 }
            operands[0] = value
            operands[1] = selected
            return Indexed(program, function, LirOp.Extract, ty.element, operands, 2, 0, expression.span)
        }
        member = cast(s32)(ordinal)
    } else if ViewElement(program, identity) >= 0 {
        if IR.CText(expression.name) != "count" && IR.CText(expression.name) != "data" {
            return Fail(program, expression.span, "string or slice has only data and count members")
        }
        member = ifx IR.CText(expression.name) == "count" then 1 else 0
    } else if ty.kind == LirTypeKind.Array && IR.CText(expression.name) == "count" {
        result_type := Type(program, function, expression.type, expression.span)
        return Constant(program, function, result_type, cast(u64)(ty.count), expression.span)
    } else {
        fields := cast(*s32)Allocate(program, ASSEMBLY_FIELD_PATH_MAX, size_of(s32))
        types := cast(*s32)Allocate(program, ASSEMBLY_FIELD_PATH_MAX, size_of(s32))
        if fields == null || types == null { return -1 }
        count := FieldPath(program, identity, expression.name, expression.span, fields, types)
        hop: s32 = 0
        while hop < count && program.failed == 0 {
            value = Indexed(program, function, LirOp.Extract, types[hop], *value, 1, cast(u64)(fields[hop]), expression.span)
            hop += 1
        }
        if program.failed != 0 { return -1 }
        return value
    }
    if program.failed != 0 { return -1 }
    result_type := MemberType(program, identity, member)
    if result_type < 0 { return Fail(program, expression.span, "invalid lowered aggregate member") }
    return Indexed(program, function, LirOp.Extract, result_type, *value, 1, cast(u64)(member), expression.span)
}

// Whether lowered code can take the address of expression `index`: globals,
// promoted locals, dereferences, pointer members, view elements and members
// of those, recursively.
Addressable :: (program: *AssemblyProgram, function: *AssemblyFunction, index: s32, depth: s32) -> s32 {
    if program.failed != 0 || index < 0 || index >= function.source.expr_count { return 0 }
    expression := *function.source.exprs[index]
    if Spend(program, expression.span) == 0 { return 0 }
    if depth > 256 {
        Fail(program, expression.span, "address nesting budget exhausted")
        return 0
    }
    if expression.kind == ZirExprKind.IDENT {
        if expression.is_global_value != 0 { return 1 }
        binding := Binding(function, expression.name)
        if binding < 0 { return 0 }
        return ifx function.bindings.data[binding].storage_type >= 0 then 1 else 0
    }
    if expression.kind == ZirExprKind.UNARY && IR.CText(*expression.op[0]) == "*" { return 1 }
    // `pointer.field` reaches the field through the pointer's own address.
    if expression.kind == ZirExprKind.POINTER_MEMBER { return 1 }
    if expression.kind == ZirExprKind.INDEX {
        base := function.source.exprs[expression.left].type
        // A borrowed view's elements live behind its checked data pointer,
        // whatever holds the view itself.
        if IR.CText(base) == "string" || base[0] == cast(u8)42 ||
           CSliceElementType(base, null, 0) != 0 || SourceVec(function, base) != 0 {
            return 1
        }
        return ifx CArrayValueType(base) != 0 then Addressable(program, function, expression.left, depth + 1) else 0
    }
    if expression.kind == ZirExprKind.MEMBER {
        return Addressable(program, function, expression.left, depth + 1)
    }
    return 0
}

// The address of expression INDEX, keeping its checks under `#checks`.
Address :: (program: *AssemblyProgram, function: *AssemblyFunction, index: s32, depth: s32) -> s32 {
    saved := function.checking
    if index >= 0 && index < function.source.expr_count && function.source.exprs[index].checked != 0 {
        function.checking = true
    }
    result := AddressOf(program, function, index, depth)
    function.checking = saved
    return result
}

AddressOf :: (program: *AssemblyProgram, function: *AssemblyFunction, index: s32, depth: s32) -> s32 {
    if program.failed != 0 { return -1 }
    if index < 0 || index >= function.source.expr_count {
        return Fail(program, function.source.span, "invalid checked address expression")
    }
    expression := *function.source.exprs[index]
    if Spend(program, expression.span) == 0 { return -1 }
    if depth > 256 { return Fail(program, expression.span, "address nesting budget exhausted") }
    if expression.kind == ZirExprKind.IDENT && expression.is_global_value != 0 {
        return GlobalAddress(program, function, expression.name, expression.span)
    }
    if expression.kind == ZirExprKind.IDENT {
        binding := Binding(function, expression.name)
        if binding < 0 || function.bindings.data[binding].storage_type < 0 {
            return Fail(program, expression.span, "address requires a promoted local")
        }
        return function.bindings.data[binding].value
    }
    if expression.kind == ZirExprKind.UNARY && IR.CText(*expression.op[0]) == "*" {
        return Expression(program, function, expression.right, depth + 1)
    }
    if expression.kind == ZirExprKind.POINTER_MEMBER {
        address := Expression(program, function, expression.left, depth + 1)
        if program.failed != 0 { return -1 }
        return FieldAddress(program, function, address, expression.name, expression.span)
    }
    if expression.kind == ZirExprKind.INDEX && expression.left >= 0 &&
       expression.left < function.source.expr_count &&
       (IR.CText(function.source.exprs[expression.left].type) == "string" ||
        CSliceElementType(function.source.exprs[expression.left].type, null, 0) != 0 ||
        SourceVec(function, function.source.exprs[expression.left].type) != 0) {
        view := Expression(program, function, expression.left, depth + 1)
        if program.failed != 0 { return -1 }
        identity := function.values.data[view]
        element := IndexableElement(program, identity)
        if element < 0 {
            return Fail(program, expression.span, "indexed view has no lowered element type")
        }
        data := Indexed(program, function, LirOp.Extract, MemberType(program, identity, 0), *view, 1, 0, expression.span)
        count := Indexed(program, function, LirOp.Extract, MemberType(program, identity, 1), *view, 1, 1, expression.span)
        ordinal := Expression(program, function, expression.right, depth + 1)
        if program.failed != 0 { return -1 }
        if TypeAt(program, function.values.data[ordinal]).kind != LirTypeKind.Integer {
            return Fail(program, expression.span, "string or slice index requires an integer")
        }
        operands := cast(*s32)Allocate(program, 3, size_of(s32))
        if operands == null { return -1 }
        operands[0] = data
        operands[1] = ordinal
        operands[2] = count
        return Emit(program, function, LirOp.ElementAddress,
            PointerType(program, element, expression.span), operands, 3, -1, expression.span)
    }
    if expression.kind == ZirExprKind.INDEX && expression.left >= 0 &&
       expression.left < function.source.expr_count &&
       function.source.exprs[expression.left].type[0] == cast(u8)42 {
        address := Expression(program, function, expression.left, depth + 1)
        ordinal := Expression(program, function, expression.right, depth + 1)
        if program.failed != 0 { return -1 }
        if TypeAt(program, function.values.data[address]).kind != LirTypeKind.Pointer ||
           TypeAt(program, function.values.data[ordinal]).kind != LirTypeKind.Integer {
            return Fail(program, expression.span, "pointer indexing requires a pointer and an integer")
        }
        // A raw pointer has no declared length. Require just the prefix up
        // to and including the index; checked backends bound it by the
        // pointer's actual extent. A wrapping count also fails the index check.
        operands := cast(*s32)Allocate(program, 3, size_of(s32))
        if operands == null { return -1 }
        operands[0] = address
        operands[1] = Convert(program, function, ordinal, 9, expression.span)
        prefix: [2]s32
        prefix[0] = operands[1]
        prefix[1] = Constant(program, function, 9, 1, expression.span)
        operands[2] = Emit(program, function, LirOp.Add, 9, *prefix[0], 2, -1, expression.span)
        return Emit(program, function, LirOp.ElementAddress, function.values.data[address],
            operands, 3, -1, expression.span)
    }
    if expression.kind == ZirExprKind.INDEX {
        address := Address(program, function, expression.left, depth + 1)
        if program.failed != 0 { return -1 }
        pointer := function.values.data[address]
        ty := TypeAt(program, pointer)
        if ty.kind != LirTypeKind.Pointer || TypeAt(program, ty.element).kind != LirTypeKind.Array {
            return Fail(program, expression.span, "element address requires a fixed-array pointer")
        }
        array_shape := TypeAt(program, ty.element)
        element := array_shape.element
        ordinal := Expression(program, function, expression.right, depth + 1)
        if program.failed != 0 { return -1 }
        if TypeAt(program, function.values.data[ordinal]).kind != LirTypeKind.Integer {
            return Fail(program, expression.span, "element address requires a fixed integer index")
        }
        result_type := PointerType(program, element, expression.span)
        operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if operands == null { return -1 }
        operands[0] = address
        operands[1] = ordinal
        return Emit(program, function, LirOp.ElementAddress, result_type, operands, 2, -1, expression.span)
    }
    if expression.kind == ZirExprKind.MEMBER {
        address := Address(program, function, expression.left, depth + 1)
        if program.failed != 0 { return -1 }
        return FieldAddress(program, function, address, expression.name, expression.span)
    }
    return Fail(program, expression.span,
        "only globals, dereferenced pointers and their fields or fixed-array elements have lowered addresses yet")
}

// The value `value` as lowered type `type`: identical types are the same
// value; two records of the same shape are one value under two names, the
// record a procedure returns several results in is declared once by the
// module that returns it and once by the module that receives it, so the
// value is rebuilt field by field under the wanted type; everything else
// converts.
Convert :: (program: *AssemblyProgram, function: *AssemblyFunction, value: s32, type: s32,
            span: IR.ZirSourceSpan) -> s32 {
    if value < 0 || type < 0 || program.failed != 0 { return -1 }
    actual := function.values.data[value]
    if actual == type { return value }
    from := TypeAt(program, actual)
    to := TypeAt(program, type)
    if from.kind == LirTypeKind.Record && to.kind == LirTypeKind.Record &&
       from.fields.count == to.fields.count && to.fields.count <= 64 {
        fields := cast(*s32)Allocate(program, 64, size_of(s32))
        if fields == null { return -1 }
        index: s32 = 0
        while index < to.fields.count && program.failed == 0 {
            fields[index] = Convert(program, function,
                Indexed(program, function, LirOp.Extract, from.fields[index], *value, 1, cast(u64)(index), span),
                to.fields[index], span)
            index += 1
        }
        return Emit(program, function, LirOp.Aggregate, type, fields, cast(s32)(to.fields.count), -1, span)
    }
    return Emit(program, function, LirOp.Convert, type, *value, 1, -1, span)
}

// The little-endian bit pattern of `value` narrowed to `bits` bits.
FloatBits :: (value: float64, bits: s32) -> u64 {
    representation: u64 = 0
    if bits == 32 {
        narrowed: float32 = cast(float32)(value)
        word: u32 = 0
        memcpy(cast(*void)(*word), cast(*void)(*narrowed), 4)
        representation = cast(u64)(word)
    } else {
        memcpy(cast(*void)(*representation), cast(*void)(*value), 8)
    }
    return representation
}

// The bits of numeric literal `expression` as a constant of `type`. A folded
// constant such as a negative enum member carries its sign in the text: the
// magnitude is read, then negated in two's complement, or becomes the nearest
// float when `type` is a float. Returns 0 when it is not a numeric literal.
LiteralBits :: (program: *AssemblyProgram, expression: *IR.ZirExpr, type: s32, out: *u64) -> s32 {
    shape := TypeAt(program, type)
    if expression.kind == ZirExprKind.INT {
        bits: u64 = 0
        digits := expression.text
        negative: s32 = 0
        if digits[0] == cast(u8)45 { negative = 1 }
        if negative != 0 || digits[0] == cast(u8)43 {
            digits = cast(*u8)(cast(usize)digits + 1)
        }
        if CZirIntegerLiteral(digits, *bits) == 0 {
            Fail(program, expression.span, "invalid checked integer literal")
            return 0
        }
        if shape.kind == LirTypeKind.Float {
            magnitude: float64 = cast(float64)(bits)
            signed: float64 = magnitude
            if negative != 0 { signed = 0 - magnitude }
            <<out = FloatBits(signed, cast(s32)(shape.bits))
        } else {
            <<out = ifx negative != 0 then 0 - bits else bits
        }
        return 1
    }
    if expression.kind == ZirExprKind.FLOAT {
        end: *u8 = null
        value := CParseDecimal(expression.text, *end)
        if end == expression.text || end[0] != cast(u8)0 || shape.kind != LirTypeKind.Float {
            Fail(program, expression.span, "invalid checked floating-point literal")
            return 0
        }
        <<out = FloatBits(value, cast(s32)(shape.bits))
        return 1
    }
    return 0
}

// The literal-type cache: the last checked type spelling looked up and its
// lowered identity, shared across one aggregate literal's elements.
LiteralCache :: struct {
    spelling: *u8
    identity: s32
}

LiteralType :: (program: *AssemblyProgram, function: *AssemblyFunction, expression: *IR.ZirExpr,
                member: s32, unary: s32, cache: *LiteralCache) -> s32 {
    if cache.spelling == null || IR.CText(cache.spelling) != IR.CText(expression.type) {
        cache.identity = Type(program, function, expression.type, expression.span)
        cache.spelling = expression.type
    }
    if program.failed != 0 { return -1 }
    own := TypeAt(program, cache.identity).kind
    if unary != 0 {
        return ifx own != LirTypeKind.Float && own != LirTypeKind.Integer then member else cache.identity
    }
    if own != LirTypeKind.Float && (expression.kind == ZirExprKind.FLOAT ||
       (own != LirTypeKind.Integer && own != LirTypeKind.Bool)) { return member }
    return cache.identity
}

// Whether a literal lowered as `type` and converted to `element` has the
// bits it would have as an `element` constant: the same type, two integer
// types, where conversion truncates, or a float64 narrowed to float32, which
// rounds the parsed value once either way.
LiteralFits :: (program: *AssemblyProgram, type: s32, element: s32) -> s32 {
    if type == element { return 1 }
    if type < 0 { return 0 }
    from := TypeAt(program, type)
    to := TypeAt(program, element)
    if (from.kind == LirTypeKind.Integer && to.kind == LirTypeKind.Integer) ||
       (from.kind == LirTypeKind.Float && to.kind == LirTypeKind.Float &&
        from.bits == 64 && to.bits == 32) {
        return 1
    }
    return 0
}

// The constant bits of array element `root` when it is a numeric literal,
// possibly signed, that lowers to the same bits as a constant of `element`.
ElementBits :: (program: *AssemblyProgram, function: *AssemblyFunction, root: s32, element: s32,
                cache: *LiteralCache, out: *u64) -> s32 {
    if root < 0 || root >= function.source.expr_count { return 0 }
    expression := *function.source.exprs[root]
    negate: s32 = 0
    if expression.kind == ZirExprKind.UNARY &&
       (IR.CText(*expression.op[0]) == "-" || IR.CText(*expression.op[0]) == "+") {
        if LiteralFits(program, LiteralType(program, function, expression, element, 1, cache), element) == 0 ||
           expression.right < 0 || expression.right >= function.source.expr_count { return 0 }
        negate = ifx expression.op[0] == cast(u8)45 then 1 else 0
        expression = *function.source.exprs[expression.right]
    }
    if (expression.kind != ZirExprKind.INT && expression.kind != ZirExprKind.FLOAT) ||
       LiteralFits(program, LiteralType(program, function, expression, element, 0, cache), element) == 0 ||
       LiteralBits(program, expression, element, out) == 0 { return 0 }
    shape := TypeAt(program, element)
    bits_value: u64 = <<out
    if negate != 0 {
        if shape.kind == LirTypeKind.Float {
            bits_value = bits_value ^ (cast(u64)1 << cast(u64)(shape.bits - 1))
        } else {
            bits_value = 0 - bits_value
        }
    }
    if shape.bits < 64 {
        bits_value = bits_value & ((cast(u64)1 << cast(u64)(shape.bits)) - cast(u64)1)
    }
    <<out = bits_value
    return 1
}

// The unsigned integer type as wide as `bits`: the identity used when union
// bytes are reinterpreted.
UnsignedOf :: (bits: s32) -> s32 {
    return ifx bits == 8 then 3 else ifx bits == 16 then 5 else ifx bits == 32 then 7 else 9
}

// Array literals at least this long whose elements are all numeric literals
// are read-only data.
ASSEMBLY_CONSTANT_ARRAY_MINIMUM :: 64

// A long array literal of numeric literals is read-only data: the elements'
// little-endian bytes are one read-only byte-array global, loaded once, and
// a loop takes each element's bytes out of that value into a frame slot. A
// table of any length then lowers to a fixed amount of code rather than an
// instruction per element, and derives no address inside the global. A byte
// array is the data itself. Returns -2 when the literal is not one.
ConstantArray :: (program: *AssemblyProgram, function: *AssemblyFunction,
                  expression: *IR.ZirExpr, identity: s32) -> s32 {
    span := expression.span
    if program.failed != 0 || function.current < 0 { return -2 }
    array := TypeAt(program, identity)
    if array.kind != LirTypeKind.Array || array.count < ASSEMBLY_CONSTANT_ARRAY_MINIMUM { return -2 }
    element := array.element
    shape := TypeAt(program, element)
    if shape.kind != LirTypeKind.Integer && shape.kind != LirTypeKind.Float { return -2 }
    width: s32 = cast(s32)(shape.bits) / 8
    if array.count > cast(s64)(2147483647 / width) { return -2 }
    total := cast(usize)(array.count) * cast(usize)(width)
    // Allocate zero-fills through calloc, so the bytes start cleared.
    bytes := cast(*u8)Allocate(program, total, cast(usize)1)
    if bytes == null { return -1 }
    cache: LiteralCache
    cache.spelling = null
    cache.identity = -1
    ordinal: s64 = 0
    child := expression.first_child
    while child >= 0 {
        if child >= function.source.expr_count || ordinal >= array.count || Spend(program, span) == 0 { return -2 }
        initializer := *function.source.exprs[child]
        bits: u64 = 0
        if initializer.kind != ZirExprKind.FIELD_INIT || initializer.name[0] != cast(u8)0 ||
           ElementBits(program, function, initializer.right, element, *cache, *bits) == 0 {
            return ifx program.failed != 0 then -1 else -2
        }
        at: s32 = 0
        while at < width {
            bytes[ordinal * cast(s64)(width) + cast(s64)(at)] = cast(u8)(bits >> cast(u64)(8 * at))
            at += 1
        }
        ordinal += 1
        child = initializer.next_sibling
    }
    global := StringGlobal(program, function.module, bytes, total, span)
    if global < 0 { return -1 }
    data_type := program.globals.data[global].result.type
    address := Emit(program, function, LirOp.GlobalAddress,
        PointerType(program, data_type, span), null, 0, global, span)
    data := Emit(program, function, LirOp.Load, data_type, *address, 1, -1, span)
    if width == 1 && shape.is_signed == false && data_type == identity { return data }
    slot := EntrySlot(program, function, identity, span)
    element_pointer := PointerType(program, element, span)
    bits_type := UnsignedOf(cast(s32)(shape.bits))
    base := function.bindings.count
    cursor := AssemblyBinding.{name = SVC.Keep(""), type = 8,
        value = Constant(program, function, 8, 0, span), storage_type = -1}
    PushBinding(program, *function.bindings, cursor)
    live := base + 1
    before := Snapshot(program, function, live)
    header := Block(program, function, before, live)
    body := Block(program, function, before, live)
    exit := Block(program, function, before, live)
    if program.failed != 0 || before == null || slot < 0 { return -1 }
    Jump(program, function, header, live, span)
    Enter(function, header, before, live)
    Emit(program, function, LirOp.Fuel, 0, null, 0, -1, span)
    more_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if more_operands == null { return -1 }
    more_operands[0] = function.bindings.data[base].value
    more_operands[1] = Constant(program, function, 8, cast(u64)(array.count), span)
    more := Emit(program, function, LirOp.Less, 1, more_operands, 2, -1, span)
    Branch(program, function, more, body, exit, live, span)
    Enter(function, body, before, live)
    at := function.bindings.data[base].value
    first_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if first_operands == null { return -1 }
    first_operands[0] = at
    first_operands[1] = Constant(program, function, 8, cast(u64)(width), span)
    first := Emit(program, function, LirOp.Multiply, 8, first_operands, 2, -1, span)
    value: s32 = -1
    part: s32 = 0
    while part < width {
        index_operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if index_operands == null { return -1 }
        index_operands[0] = first
        index_operands[1] = Constant(program, function, 8, cast(u64)(part), span)
        index: s32 = first
        if part != 0 {
            index = Emit(program, function, LirOp.Add, 8, index_operands, 2, -1, span)
        }
        byte_operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if byte_operands == null { return -1 }
        byte_operands[0] = data
        byte_operands[1] = index
        piece := Convert(program, function,
            Indexed(program, function, LirOp.Extract, 3, byte_operands, 2, 0, span), bits_type, span)
        if part != 0 {
            shift_operands := cast(*s32)Allocate(program, 2, size_of(s32))
            if shift_operands == null { return -1 }
            shift_operands[0] = piece
            shift_operands[1] = Constant(program, function, 8, cast(u64)(8 * part), span)
            piece = Emit(program, function, LirOp.ShiftLeft, bits_type, shift_operands, 2, -1, span)
            merge_operands := cast(*s32)Allocate(program, 2, size_of(s32))
            if merge_operands == null { return -1 }
            merge_operands[0] = value
            merge_operands[1] = piece
            piece = Emit(program, function, LirOp.BitOr, bits_type, merge_operands, 2, -1, span)
        }
        value = piece
        part += 1
    }
    if shape.kind == LirTypeKind.Float {
        value = Emit(program, function, LirOp.Bitcast, element, *value, 1, -1, span)
    } else {
        value = Convert(program, function, value, element, span)
    }
    slot_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if slot_operands == null { return -1 }
    slot_operands[0] = slot
    slot_operands[1] = at
    target := Emit(program, function, LirOp.ElementAddress, element_pointer, slot_operands, 2, -1, span)
    store_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if store_operands == null { return -1 }
    store_operands[0] = target
    store_operands[1] = value
    Emit(program, function, LirOp.Store, 0, store_operands, 2, -1, span)
    next_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if next_operands == null { return -1 }
    next_operands[0] = at
    next_operands[1] = Constant(program, function, 8, 1, span)
    function.bindings.data[base].value = Emit(program, function, LirOp.Add, 8, next_operands, 2, -1, span)
    Jump(program, function, header, live, span)
    Enter(function, exit, before, live)
    function.bindings.count = base
    return Emit(program, function, LirOp.Load, identity, *slot, 1, -1, span)
}

Compound :: (program: *AssemblyProgram, function: *AssemblyFunction,
             expression: *IR.ZirExpr, identity: s32, depth: s32) -> s32 {
    constant := ConstantArray(program, function, expression, identity)
    if constant != -2 { return constant }
    value := Zero(program, function, identity, expression.span, depth + 1)
    if program.failed != 0 { return -1 }
    ty := TypeAt(program, identity)
    ordinal: s32 = 0
    child := expression.first_child
    while child >= 0 {
        if child >= function.source.expr_count || Spend(program, expression.span) == 0 { return -1 }
        initializer := *function.source.exprs[child]
        if initializer.kind != ZirExprKind.FIELD_INIT {
            return Fail(program, initializer.span, "invalid checked aggregate initializer")
        }
        member: s32 = ordinal
        if ty.kind == LirTypeKind.Record && initializer.name[0] != cast(u8)0 {
            member = Field(program, identity, initializer.name, initializer.span)
        }
        if program.failed != 0 { return -1 }
        member_type := MemberType(program, identity, member)
        if member_type < 0 {
            return Fail(program, initializer.span, "aggregate initializer is outside its declared shape")
        }
        // A nested literal takes its member's type; a parsed global
        // initializer does not spell it on the inner literal.
        nested: s32 = 0
        if initializer.right >= 0 && initializer.right < function.source.expr_count &&
           function.source.exprs[initializer.right].kind == ZirExprKind.COMPOUND {
            nested = 1
        }
        outer_at := function.literal_at
        outer_type := function.literal_type
        function.literal_at = initializer.right + 1
        function.literal_type = member_type
        initialized: s32 = 0
        if nested != 0 {
            initialized = Compound(program, function, *function.source.exprs[initializer.right], member_type, depth + 1)
        } else {
            initialized = Expression(program, function, initializer.right, depth + 1)
        }
        function.literal_at = outer_at
        function.literal_type = outer_type
        initialized = Convert(program, function, initialized, member_type, initializer.span)
        operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if operands == null { return -1 }
        operands[0] = value
        operands[1] = initialized
        value = Indexed(program, function, LirOp.Insert, identity, operands, 2, cast(u64)(member), initializer.span)
        ordinal += 1
        child = initializer.next_sibling
    }
    return value
}

// The lowered operation for a checked binary operator spelling.
Binary :: (op: *u8) -> LIR.LirOp {
    if IR.CText(op) == "+" { return LirOp.Add }
    if IR.CText(op) == "-" { return LirOp.Subtract }
    if IR.CText(op) == "*" { return LirOp.Multiply }
    if IR.CText(op) == "/" { return LirOp.Divide }
    if IR.CText(op) == "%" { return LirOp.Remainder }
    if IR.CText(op) == "&" { return LirOp.BitAnd }
    if IR.CText(op) == "|" { return LirOp.BitOr }
    if IR.CText(op) == "^" { return LirOp.BitXor }
    if IR.CText(op) == "<<" { return LirOp.ShiftLeft }
    if IR.CText(op) == ">>" { return LirOp.ShiftRight }
    if IR.CText(op) == "==" { return LirOp.Equal }
    if IR.CText(op) == "!=" { return LirOp.NotEqual }
    if IR.CText(op) == "<" { return LirOp.Less }
    if IR.CText(op) == "<=" { return LirOp.LessEqual }
    if IR.CText(op) == ">" { return LirOp.Greater }
    if IR.CText(op) == ">=" { return LirOp.GreaterEqual }
    return LirOp.Invalid
}

// Repeating a local value, record member or fixed-array element cannot change
// it between two comparisons. Do not extend this to calls, pointer reads,
// slices, moves or arbitrary expressions: their second evaluation matters.
SameBoundsValue :: (program: *AssemblyProgram, function: *AssemblyFunction,
                    left: s32, right: s32, depth: s32) -> bool {
    if depth > 32 || left < 0 || right < 0 ||
       left >= function.source.expr_count || right >= function.source.expr_count { return false }
    a := *function.source.exprs[left]
    b := *function.source.exprs[right]
    if Spend(program, a.span) == 0 { return false }
    if a.kind != b.kind || a.is_move != 0 || b.is_move != 0 ||
       a.checked != b.checked || IR.CText(a.type) != IR.CText(b.type) { return false }
    if a.kind == ZirExprKind.IDENT {
        if a.is_global_value != 0 || b.is_global_value != 0 ||
           IR.CText(a.name) != IR.CText(b.name) { return false }
        return Binding(function, a.name) >= 0
    }
    if a.kind == ZirExprKind.INT { return IR.CText(a.text) == IR.CText(b.text) }
    if a.kind != ZirExprKind.MEMBER && a.kind != ZirExprKind.INDEX { return false }
    if !SameBoundsValue(program, function, a.left, b.left, depth + 1) { return false }
    parent := Type(program, function, function.source.exprs[a.left].type, a.span)
    if parent < 0 { return false }
    if a.kind == ZirExprKind.MEMBER {
        return TypeAt(program, parent).kind == LirTypeKind.Record &&
            IR.CText(a.name) == IR.CText(b.name)
    }
    return TypeAt(program, parent).kind == LirTypeKind.Array &&
        SameBoundsValue(program, function, a.right, b.right, depth + 1)
}

// For a signed integer x and a nonnegative literal U that fits x,
// x > U || x < 0 is exactly unsigned(x) > U. Both comparisons must read
// the same stable local value; otherwise retain normal short circuiting.
BoundsDisjunction :: (program: *AssemblyProgram, function: *AssemblyFunction,
                      expression: *IR.ZirExpr, depth: s32) -> s32 {
    if IR.CText(*expression.op[0]) != "||" || expression.left < 0 || expression.right < 0 ||
       expression.left >= function.source.expr_count || expression.right >= function.source.expr_count { return -1 }
    high := *function.source.exprs[expression.left]
    low := *function.source.exprs[expression.right]
    if IR.CText(*high.op[0]) == "<" {
        high = *function.source.exprs[expression.right]
        low = *function.source.exprs[expression.left]
    }
    if high.kind != ZirExprKind.BINARY || low.kind != ZirExprKind.BINARY || high.checked != low.checked ||
       IR.CText(*high.op[0]) != ">" || IR.CText(*low.op[0]) != "<" ||
       high.right < 0 || low.right < 0 || high.right >= function.source.expr_count ||
       low.right >= function.source.expr_count { return -1 }
    upper := *function.source.exprs[high.right]
    zero := *function.source.exprs[low.right]
    if upper.kind != ZirExprKind.INT || zero.kind != ZirExprKind.INT { return -1 }
    bound: u64
    bottom: u64
    if CZirIntegerLiteral(upper.text, *bound) == 0 ||
       CZirIntegerLiteral(zero.text, *bottom) == 0 || bottom != 0 { return -1 }
    if !SameBoundsValue(program, function, high.left, low.left, 0) { return -1 }
    value_type := Type(program, function, function.source.exprs[high.left].type, expression.span)
    upper_type := Type(program, function, upper.type, upper.span)
    zero_type := Type(program, function, zero.type, zero.span)
    if value_type < 0 || upper_type < 0 || zero_type < 0 { return -1 }
    shape := TypeAt(program, value_type)
    if shape.kind != LirTypeKind.Integer || !shape.is_signed || shape.bits < 1 || shape.bits > 64 ||
       TypeAt(program, upper_type).kind != LirTypeKind.Integer || !TypeAt(program, upper_type).is_signed ||
       TypeAt(program, zero_type).kind != LirTypeKind.Integer || !TypeAt(program, zero_type).is_signed ||
       bound > (cast(u64)1 << cast(u64)(shape.bits - 1)) - 1 { return -1 }
    unsigned_type: s32 = -1
    for at: cast(s32)0..program.types.count - 1 {
        if Spend(program, expression.span) == 0 { return -1 }
        candidate := TypeAt(program, at)
        if candidate.kind == LirTypeKind.Integer && !candidate.is_signed && candidate.bits == shape.bits {
            unsigned_type = at
            break
        }
    }
    if unsigned_type < 0 { return -1 }
    first := *function.source.exprs[expression.left]
    saved_checking := function.checking
    if first.checked != 0 { function.checking = true }
    value := Expression(program, function, first.left, depth + 1)
    function.checking = saved_checking
    if value < 0 { return -1 }
    value = Emit(program, function, LirOp.Bitcast, unsigned_type, *value, 1, -1, expression.span)
    operands: [2]s32 = .[value, Constant(program, function, unsigned_type, bound, expression.span)]
    return Emit(program, function, LirOp.Greater, 1, *operands[0], 2, -1, expression.span)
}

// For an integer x and literals L <= U that fit its type, x >= L && x <= U
// is exactly unsigned(x - L) <= U - L, the subtraction wrapping at x's
// width. Both comparisons must read the same stable local value.
BoundsConjunction :: (program: *AssemblyProgram, function: *AssemblyFunction,
                      expression: *IR.ZirExpr, depth: s32) -> s32 {
    if IR.CText(*expression.op[0]) != "&&" || expression.left < 0 || expression.right < 0 ||
       expression.left >= function.source.expr_count || expression.right >= function.source.expr_count { return -1 }
    low := *function.source.exprs[expression.left]
    high := *function.source.exprs[expression.right]
    if IR.CText(*low.op[0]) == "<=" {
        low = *function.source.exprs[expression.right]
        high = *function.source.exprs[expression.left]
    }
    if high.kind != ZirExprKind.BINARY || low.kind != ZirExprKind.BINARY || high.checked != low.checked ||
       IR.CText(*low.op[0]) != ">=" || IR.CText(*high.op[0]) != "<=" ||
       high.right < 0 || low.right < 0 || high.right >= function.source.expr_count ||
       low.right >= function.source.expr_count { return -1 }
    upper := *function.source.exprs[high.right]
    lower := *function.source.exprs[low.right]
    if upper.kind != ZirExprKind.INT || lower.kind != ZirExprKind.INT { return -1 }
    top: u64
    bottom: u64
    if CZirIntegerLiteral(upper.text, *top) == 0 || CZirIntegerLiteral(lower.text, *bottom) == 0 ||
       bottom > top { return -1 }
    if !SameBoundsValue(program, function, low.left, high.left, 0) { return -1 }
    value_type := Type(program, function, function.source.exprs[low.left].type, expression.span)
    upper_type := Type(program, function, upper.type, upper.span)
    lower_type := Type(program, function, lower.type, lower.span)
    if value_type < 0 || upper_type < 0 || lower_type < 0 { return -1 }
    shape := TypeAt(program, value_type)
    if shape.kind != LirTypeKind.Integer || shape.bits < 1 || shape.bits > 64 ||
       TypeAt(program, upper_type).kind != LirTypeKind.Integer ||
       TypeAt(program, lower_type).kind != LirTypeKind.Integer { return -1 }
    largest: u64 = 0xffffffffffffffff
    if shape.is_signed { largest = (cast(u64)1 << cast(u64)(shape.bits - 1)) - 1 }
    else if shape.bits < 64 { largest = (cast(u64)1 << cast(u64)shape.bits) - 1 }
    if top > largest { return -1 }
    unsigned_type: s32 = -1
    for at: cast(s32)0..program.types.count - 1 {
        if Spend(program, expression.span) == 0 { return -1 }
        candidate := TypeAt(program, at)
        if candidate.kind == LirTypeKind.Integer && !candidate.is_signed && candidate.bits == shape.bits {
            unsigned_type = at
            break
        }
    }
    if unsigned_type < 0 { return -1 }
    first := *function.source.exprs[expression.left]
    saved_checking := function.checking
    if first.checked != 0 { function.checking = true }
    value := Expression(program, function, low.left, depth + 1)
    function.checking = saved_checking
    if value < 0 { return -1 }
    if shape.is_signed { value = Emit(program, function, LirOp.Bitcast, unsigned_type, *value, 1, -1, expression.span) }
    if bottom != 0 {
        moved: [2]s32 = .[value, Constant(program, function, unsigned_type, bottom, expression.span)]
        value = Emit(program, function, LirOp.Subtract, unsigned_type, *moved[0], 2, -1, expression.span)
    }
    operands: [2]s32 = .[value, Constant(program, function, unsigned_type, top - bottom, expression.span)]
    return Emit(program, function, LirOp.LessEqual, 1, *operands[0], 2, -1, expression.span)
}

// Both arms of a conditional or short-circuiting expression, joined on one
// block that receives the selected value as a parameter.
Select :: (program: *AssemblyProgram, function: *AssemblyFunction, expression: *IR.ZirExpr,
           condition: s32, yes_root: s32, no_root: s32, short_circuit: s32, depth: s32) -> s32 {
    count := function.bindings.count
    before := Snapshot(program, function, count)
    yes := Block(program, function, before, count)
    no := Block(program, function, before, count)
    if program.failed != 0 { return -1 }
    Branch(program, function, condition, yes, no, count, expression.span)
    Enter(function, yes, before, count)
    yes_value: s32 = 0
    if short_circuit == 1 {
        yes_value = Constant(program, function, 1, 1, expression.span)
    } else {
        yes_value = Expression(program, function, yes_root, depth + 1)
    }
    type := Type(program, function, expression.type, expression.span)
    yes_value = Convert(program, function, yes_value, type, expression.span)
    yes_end := function.current
    yes_bindings := Snapshot(program, function, count)
    Enter(function, no, before, count)
    no_value: s32 = 0
    if short_circuit == 2 {
        no_value = Constant(program, function, 1, 0, expression.span)
    } else {
        no_value = Expression(program, function, no_root, depth + 1)
    }
    no_value = Convert(program, function, no_value, type, expression.span)
    no_end := function.current
    no_bindings := Snapshot(program, function, count)
    joined := cast(*AssemblyBinding)Allocate(program, cast(usize)(count) + 1, size_of(AssemblyBinding))
    if program.failed != 0 { return -1 }
    if count != 0 {
        memcpy(cast(*void)joined, cast(*void)yes_bindings, cast(usize)(count) * size_of(AssemblyBinding))
    }
    joined[count] = AssemblyBinding.{name = SVC.Keep(""), type = type, value = yes_value, storage_type = -1}
    join := Block(program, function, joined, count + 1)
    if program.failed != 0 { return -1 }
    edges := cast(*LIR.LirEdge)Allocate(program, 2, size_of(LIR.LirEdge))
    if edges == null { return -1 }
    edges[0] = Edge(program, join, joined, count + 1)
    if count != 0 {
        memcpy(cast(*void)joined, cast(*void)no_bindings, cast(usize)(count) * size_of(AssemblyBinding))
    }
    joined[count].value = no_value
    edges[1] = Edge(program, join, joined, count + 1)
    ends := cast(*s32)Allocate(program, 2, size_of(s32))
    if ends == null { return -1 }
    ends[0] = yes_end
    ends[1] = no_end
    branch: s32 = 0
    while branch < 2 && program.failed == 0 {
        function.current = ends[branch]
        Emit(program, function, LirOp.Jump, 0, null, 0, -1, expression.span)
        block := BlockAt(function, function.current)
        edge := cast(*LIR.LirEdge)Allocate(program, 1, size_of(LIR.LirEdge))
        if edge == null { return -1 }
        memcpy(cast(*void)edge, cast(*void)*edges[branch], size_of(LIR.LirEdge))
        instructions := block.instructions.data
        instructions[block.instructions.count - 1].edges = LirEdgeItems(edge, 1)
        branch += 1
    }
    Enter(function, join, before, count)
    parameters := BlockAt(function, join).parameters.data
    return parameters[count]
}

// A checked slice expression `data[low:high]`: the element address of the
// low bound and a subtracted count, as one slice record.
LowerSlice :: (program: *AssemblyProgram, function: *AssemblyFunction,
               expression: *IR.ZirExpr, result_type: s32, depth: s32) -> s32 {
    if expression.left < 0 || expression.left >= function.source.expr_count {
        return Fail(program, expression.span, "invalid checked slice source")
    }
    source := *function.source.exprs[expression.left]
    data: s32 = -1
    count: s32 = -1
    element: s32 = -1
    if CArrayValueType(source.type) != 0 {
        base := Address(program, function, expression.left, depth + 1)
        if program.failed != 0 { return -1 }
        pointer := TypeAt(program, function.values.data[base])
        if pointer.kind != LirTypeKind.Pointer {
            return Fail(program, expression.span, "slice source has no persistent array address")
        }
        array := TypeAt(program, pointer.element)
        if array.kind != LirTypeKind.Array {
            return Fail(program, expression.span, "slice source is not a lowered fixed array")
        }
        element = array.element
        count = Constant(program, function, 8, cast(u64)(array.count), expression.span)
        pointer_type := PointerType(program, element, expression.span)
        if array.count == 0 {
            data = Emit(program, function, LirOp.Null, pointer_type, null, 0, -1, expression.span)
        } else {
            zero := Constant(program, function, 8, 0, expression.span)
            operands := cast(*s32)Allocate(program, 2, size_of(s32))
            if operands == null { return -1 }
            operands[0] = base
            operands[1] = zero
            data = Emit(program, function, LirOp.ElementAddress, pointer_type, operands, 2, -1, expression.span)
        }
    } else {
        view := Expression(program, function, expression.left, depth + 1)
        if program.failed != 0 { return -1 }
        identity := function.values.data[view]
        element = IndexableElement(program, identity)
        if element < 0 {
            return Fail(program, expression.span, "slice source is not a lowered string, slice or vector")
        }
        data = Indexed(program, function, LirOp.Extract, MemberType(program, identity, 0), *view, 1, 0, expression.span)
        count = Indexed(program, function, LirOp.Extract, MemberType(program, identity, 1), *view, 1, 1, expression.span)
    }
    low: s32 = 0
    if expression.right >= 0 {
        low = Expression(program, function, expression.right, depth + 1)
    } else {
        low = Constant(program, function, 8, 0, expression.span)
    }
    high: s32 = count
    if expression.third >= 0 {
        high = Expression(program, function, expression.third, depth + 1)
    }
    low = Convert(program, function, low, 8, expression.span)
    high = Convert(program, function, high, 8, expression.span)
    if program.failed != 0 { return -1 }
    pointer_type := PointerType(program, element, expression.span)
    address_operands := cast(*s32)Allocate(program, 4, size_of(s32))
    if address_operands == null { return -1 }
    address_operands[0] = data
    address_operands[1] = low
    address_operands[2] = high
    address_operands[3] = count
    selected := Emit(program, function, LirOp.ElementAddress, pointer_type,
                     address_operands, 4, -1, expression.span)
    count_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if count_operands == null { return -1 }
    count_operands[0] = high
    count_operands[1] = low
    selected_count := Emit(program, function, LirOp.Subtract, 8,
                           count_operands, 2, -1, expression.span)
    fields := cast(*s32)Allocate(program, 2, size_of(s32))
    if fields == null { return -1 }
    fields[0] = selected
    fields[1] = selected_count
    return Emit(program, function, LirOp.Aggregate, result_type,
                fields, 2, -1, expression.span)
}

// Native services are typed LIR host calls with Ziran-owned names. A target
// either supplies the exact veneer or reports the service as unavailable; it
// is never rewritten to libc or to another execution engine.
PrintServiceName :: (service: s32) -> *u8 {
    if service == 0 { return SVC.Keep("ziran.platform.write_all") }
    if service == 1 { return SVC.Keep("ziran.print.signed") }
    if service == 2 { return SVC.Keep("ziran.print.unsigned") }
    if service == 3 { return SVC.Keep("ziran.print.bool") }
    if service == 4 { return SVC.Keep("ziran.print.float32") }
    if service == 5 { return SVC.Keep("ziran.print.float64") }
    return SVC.Keep("ziran.platform.write_all")
}

PlatformFunction :: (program: *AssemblyProgram, module: *IR.ZirModule, service: s32,
                     parameters: *s32, count: s32, span: IR.ZirSourceSpan) -> s32 {
    name := PrintServiceName(service)
    functions := program.functions.data
    index: s32 = 0
    while index < program.functions.count {
        snapshot := functions[index].result
        name_parts := cast(*TextParts)(*snapshot.name)
        if snapshot.external == true && name_parts.length == strlen(name) &&
           memcmp(cast(*void)name_parts.data, cast(*void)name, name_parts.length) == 0 {
            return index
        }
        index += 1
    }
    function := cast(*AssemblyFunction)Allocate(program, 1, size_of(AssemblyFunction))
    types := cast(*s32)Allocate(program, cast(usize)count, size_of(s32))
    if function == null || (count > 0 && types == null) { return -1 }
    if count > 0 {
        memcpy(cast(*void)types, cast(*void)parameters, cast(usize)count * size_of(s32))
    }
    function.module = module
    function.current = -1
    function.result = LIR.LirFunction.{
        module = Name(program, *program.modules, SVC.Keep("ziran.platform")),
        name = Owned(Text(program, name)),
        parameters = S32Items(types, cast(s64)count),
        result = 0, calling = LIR.LirCalling.Host, external = true, entry = -1,
        origin = Origin(program, span)}
    if program.failed != 0 { return -1 }
    identity := program.functions.count
    if PushFunctionPtr(program, *program.functions, function) { return identity }
    return -1
}

PrintService :: (program: *AssemblyProgram, function: *AssemblyFunction, service: s32,
                 operands: *s32, count: s32, span: IR.ZirSourceSpan) -> s32 {
    parameters := cast(*s32)Allocate(program, 3, size_of(s32))
    if parameters == null { return -1 }
    index: s32 = 0
    while index < count {
        parameters[index] = function.values.data[operands[index]]
        index += 1
    }
    symbol := PlatformFunction(program, function.module, service, parameters, count, span)
    if symbol < 0 { return -1 }
    return Emit(program, function, LirOp.HostCall, 0, operands, count, symbol, span)
}

PrintBytes :: (program: *AssemblyProgram, function: *AssemblyFunction,
               view: s32, span: IR.ZirSourceSpan) -> s32 {
    identity := function.values.data[view]
    ty := TypeAt(program, identity)
    if ty.kind != LirTypeKind.Record || ty.fields.count != 2 {
        return Fail(program, span, "print text has no lowered byte-view representation")
    }
    pointer := ty.fields[0]
    pointer_type := TypeAt(program, pointer)
    if pointer_type.kind != LirTypeKind.Pointer || pointer_type.element != 3 || ty.fields[1] != 8 {
        return Fail(program, span, "print text is not a byte view")
    }
    operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if operands == null { return -1 }
    operands[0] = Constant(program, function, 9, 1, span)
    operands[1] = Indexed(program, function, LirOp.Extract, pointer, *view, 1, 0, span)
    operands[2] = Indexed(program, function, LirOp.Extract, 8, *view, 1, 1, span)
    operands[2] = Convert(program, function, operands[2], 9, span)
    return PrintService(program, function, 0, operands, 3, span)
}

// The checked TextView call: the source record's byte-view pair, extracted
// from a text value or directly from a slice/vector.
AsTextView :: (program: *AssemblyProgram, function: *AssemblyFunction,
             expression: *IR.ZirExpr, result_type: s32, depth: s32) -> s32 {
    child := expression.first_child
    if child < 0 || child >= function.source.expr_count ||
       function.source.exprs[child].next_sibling >= 0 {
        return Fail(program, expression.span, "invalid checked TextView call")
    }
    source := Expression(program, function, child, depth + 1)
    if program.failed != 0 { return -1 }
    identity := function.values.data[source]
    ty := TypeAt(program, identity)
    fields := ty.fields
    if ty.kind == LirTypeKind.Record && fields.count == 1 &&
       VecElement(program, fields[0]) == 3 {
        identity = fields[0]
        source = Indexed(program, function, LirOp.Extract, identity,
                         *source, 1, 0, expression.span)
        ty = TypeAt(program, identity)
        fields = ty.fields
    }
    if ty.kind != LirTypeKind.Record ||
       (fields.count != 2 && VecElement(program, identity) != 3) {
        return Fail(program, expression.span,
                    "TextView source has no lowered slice representation")
    }
    pointer := TypeAt(program, fields[0])
    if pointer.kind != LirTypeKind.Pointer || pointer.element != 3 || fields[1] != 8 {
        return Fail(program, expression.span, "TextView source is not a byte slice")
    }
    values := cast(*s32)Allocate(program, 2, size_of(s32))
    if values == null { return -1 }
    values[0] = Indexed(program, function, LirOp.Extract, fields[0], *source, 1, 0, expression.span)
    values[1] = Indexed(program, function, LirOp.Extract, fields[1], *source, 1, 1, expression.span)
    return Emit(program, function, LirOp.Aggregate, result_type, values, 2, -1, expression.span)
}

Print :: (program: *AssemblyProgram, function: *AssemblyFunction,
          expression: *IR.ZirExpr, depth: s32) -> s32 {
    format := expression.first_child
    if format < 0 || format >= function.source.expr_count ||
       function.source.exprs[format].kind != ZirExprKind.STRING {
        return Fail(program, expression.span, "invalid checked print format")
    }
    argument_count: s32 = 0
    child := function.source.exprs[format].next_sibling
    while child >= 0 {
        if child >= function.source.expr_count || argument_count >= PRINT_PIECES_MAX {
            return Fail(program, expression.span, "invalid checked print arguments")
        }
        argument_count += 1
        child = function.source.exprs[child].next_sibling
    }
    values := cast(*s32)Allocate(program, cast(usize)argument_count, size_of(s32))
    types := cast(**u8)Allocate(program, cast(usize)argument_count, size_of(*u8))
    if argument_count > 0 && (values == null || types == null) { return -1 }
    argument: s32 = 0
    child = function.source.exprs[format].next_sibling
    while child >= 0 {
        values[argument] = Expression(program, function, child, depth + 1)
        types[argument] = CScalarType(function.source.exprs[child].type)
        if program.failed != 0 { return -1 }
        argument += 1
        child = function.source.exprs[child].next_sibling
    }
    pieces := cast(*PrintPiece)calloc(PRINT_PIECES_MAX, size_of(PrintPiece))
    count: s32 = -1
    if pieces != null {
        count = CPrintFormatPieces(function.source.exprs[format].text,
                                   pieces, PRINT_PIECES_MAX)
    }
    if count < 0 {
        free(cast(*void)pieces)
        return Fail(program, expression.span, "invalid checked print format")
    }
    argument = 0
    index: s32 = 0
    while index < count && program.failed == 0 {
        if pieces[index].is_argument == 0 {
            literal := function.source.exprs[format]
            literal.text = *pieces[index].literal[0]
            view := String(program, function, *literal)
            if view >= 0 {
                PrintBytes(program, function, view, expression.span)
            }
            index += 1
            continue
        }
        if argument >= argument_count {
            Fail(program, expression.span, "invalid checked print argument count")
            break
        }
        value := values[argument]
        scalar := types[argument]
        argument += 1
        if IR.CText(scalar) == "string" {
            PrintBytes(program, function, value, expression.span)
        } else if IR.CText(scalar) == "bool" {
            converted := Convert(program, function, value, 1, expression.span)
            PrintService(program, function, 3, *converted, 1, expression.span)
        } else if IR.CText(scalar) == "float32" || IR.CText(scalar) == "float64" {
            service: s32 = 5
            if IR.CText(scalar) == "float32" { service = 4 }
            PrintService(program, function, service, *value, 1, expression.span)
        } else {
            source_type := function.values.data[value]
            integer := TypeAt(program, source_type)
            if integer.kind != LirTypeKind.Integer {
                Fail(program, expression.span,
                     "print argument has no native scalar formatter")
                break
            }
            target: s32 = 9
            service: s32 = 2
            if integer.is_signed == true {
                target = 8
                service = 1
            }
            converted := Convert(program, function, value, target, expression.span)
            PrintService(program, function, service, *converted, 1, expression.span)
        }
        index += 1
    }
    free(cast(*void)pieces)
    return -1
}


// Whether values of a type own heap storage: a vector, or a record or
// fixed array that holds one. Pointers and views own nothing.
TypeOwned :: (program: *AssemblyProgram, identity: s32, depth: s32) -> bool {
    if depth > 32 || identity <= 0 || identity >= program.types.count { return false }
    if VecElement(program, identity) >= 0 || OwnedCallable(program, identity) { return true }
    ty := TypeAt(program, identity)
    if ty.kind == LirTypeKind.Array {
        return ty.count > 0 && TypeOwned(program, ty.element, depth + 1)
    }
    if ty.kind != LirTypeKind.Record { return false }
    field: s64 = 0
    while field < ty.fields.count {
        if TypeOwned(program, ty.fields[field], depth + 1) { return true }
        field += 1
    }
    return false
}

// Where an owned vector lives: a checked address, or a local binding path.
AssemblyVecPlace :: struct {
    address: s32
    local: *AssemblyLocalPlace
}

VecRead :: (program: *AssemblyProgram, function: *AssemblyFunction, root: s32,
            identity: s32, place: *AssemblyVecPlace, span: IR.ZirSourceSpan) -> s32 {
    place.address = -1
    place.local = null
    if Addressable(program, function, root, 0) != 0 {
        place.address = Address(program, function, root, 0)
    } else {
        place.local = CaptureLocal(program, function, root, 0)
    }
    if program.failed != 0 { return -1 }
    if place.address >= 0 {
        return Emit(program, function, LirOp.Load, identity, *place.address, 1, -1, span)
    }
    if place.local.storage != 0 {
        return Emit(program, function, LirOp.Load, identity, *place.local.value, 1, -1, span)
    }
    return place.local.value
}

VecWrite :: (program: *AssemblyProgram, function: *AssemblyFunction,
             place: *AssemblyVecPlace, value: s32, span: IR.ZirSourceSpan) {
    if program.failed != 0 { return }
    if place.address >= 0 {
        operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if operands == null { return }
        operands[0] = place.address
        operands[1] = value
        Emit(program, function, LirOp.Store, 0, operands, 2, -1, span)
        return
    }
    StoreCaptured(program, function, place.local, value, span)
}

// Free the heap block of one vector value. A null data pointer with
// capacity 0, which a default or freed vector holds, frees nothing.
VecRelease :: (program: *AssemblyProgram, function: *AssemblyFunction, vector: s32,
               identity: s32, span: IR.ZirSourceSpan) {
    element := VecElement(program, identity)
    if program.failed != 0 || element < 0 { return }
    pointer := PointerType(program, element, span)
    data := Indexed(program, function, LirOp.Extract, pointer, *vector, 1, 0, span)
    capacity := Indexed(program, function, LirOp.Extract, 8, *vector, 1, 2, span)
    zero := Constant(program, function, 8, 0, span)
    operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if operands == null { return }
    operands[0] = data
    operands[1] = capacity
    operands[2] = zero
    Emit(program, function, LirOp.Resize, pointer, operands, 3, -1, span)
}


// Drop every element of a vector whose elements own storage. The vector's
// own block and fields are left as they are.
DropElements :: (program: *AssemblyProgram, function: *AssemblyFunction, vector: s32,
                 identity: s32, span: IR.ZirSourceSpan, depth: s32) {
    element := VecElement(program, identity)
    if program.failed != 0 || function.current < 0 || element < 0 ||
       TypeOwned(program, element, 0) == false { return }
    pointer := PointerType(program, element, span)
    data := Indexed(program, function, LirOp.Extract, pointer, *vector, 1, 0, span)
    count := Indexed(program, function, LirOp.Extract, 8, *vector, 1, 1, span)
    base := function.bindings.count
    cursor := AssemblyBinding.{name = SVC.Keep(""), type = 8,
        value = Constant(program, function, 8, 0, span), storage_type = -1}
    if PushBinding(program, *function.bindings, cursor) == false { return }
    live := base + 1
    before := Snapshot(program, function, live)
    header := Block(program, function, before, live)
    body := Block(program, function, before, live)
    exit := Block(program, function, before, live)
    if program.failed != 0 || before == null { return }
    Jump(program, function, header, live, span)
    Enter(function, header, before, live)
    Emit(program, function, LirOp.Fuel, 0, null, 0, -1, span)
    more_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if more_operands == null { return }
    more_operands[0] = function.bindings.data[base].value
    more_operands[1] = count
    more := Emit(program, function, LirOp.Less, 1, more_operands, 2, -1, span)
    Branch(program, function, more, body, exit, live, span)
    Enter(function, body, before, live)
    at := function.bindings.data[base].value
    slot_operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if slot_operands == null { return }
    slot_operands[0] = data
    slot_operands[1] = at
    slot_operands[2] = count
    slot := Emit(program, function, LirOp.ElementAddress, pointer, slot_operands, 3, -1, span)
    item := Emit(program, function, LirOp.Load, element, *slot, 1, -1, span)
    DropValue(program, function, item, element, span, depth + 1)
    next_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if next_operands == null { return }
    next_operands[0] = at
    next_operands[1] = Constant(program, function, 8, 1, span)
    function.bindings.data[base].value = Emit(program, function, LirOp.Add, 8,
                                              next_operands, 2, -1, span)
    Jump(program, function, header, live, span)
    Enter(function, exit, before, live)
    function.bindings.count = base
}

// Free everything one owned value holds: a vector's elements and block,
// and the owned fields and elements of records and fixed arrays.
DropValue :: (program: *AssemblyProgram, function: *AssemblyFunction, value: s32,
              identity: s32, span: IR.ZirSourceSpan, depth: s32) {
    if program.failed != 0 || function.current < 0 || depth > 32 ||
       TypeOwned(program, identity, 0) == false { return }
    if OwnedCallable(program, identity) {
        DropCallable(program, function, value, identity, span)
        return
    }
    if VecElement(program, identity) >= 0 {
        DropElements(program, function, value, identity, span, depth)
        VecRelease(program, function, value, identity, span)
        return
    }
    ty := TypeAt(program, identity)
    members: s64 = 0
    if ty.kind == LirTypeKind.Array { members = ty.count } else { members = ty.fields.count }
    member: s64 = 0
    while member < members && program.failed == 0 {
        member_type: s32 = 0
        if ty.kind == LirTypeKind.Array { member_type = ty.element } else { member_type = ty.fields[member] }
        if TypeOwned(program, member_type, 0) == false {
            member += 1
            continue
        }
        item := Indexed(program, function, LirOp.Extract, member_type, *value, 1,
                        cast(u64)(member), span)
        DropValue(program, function, item, member_type, span, depth + 1)
        member += 1
    }
}


// Leaving a scope drops its owned values, newest first, as the C and Go
// emitters do at block close, return, break and continue.
DropBindings :: (program: *AssemblyProgram, function: *AssemblyFunction, first: s32,
                 span: IR.ZirSourceSpan) {
    index := function.bindings.count - 1
    while index >= first && program.failed == 0 && function.current >= 0 {
        binding := function.bindings.data[index]
        if binding.name == null || binding.name[0] == cast(u8)0 ||
           TypeOwned(program, binding.type, 0) == false {
            index -= 1
            continue
        }
        value: s32 = binding.value
        if binding.storage_type >= 0 {
            value = Emit(program, function, LirOp.Load, binding.type, *binding.value, 1, -1, span)
        }
        DropValue(program, function, value, binding.type, span, 0)
        index -= 1
    }
}

// Empty the source of a move. Only a local or a global, or a member path
// rooted at one, can be moved from; the checker rejects every other source.
MoveOut :: (program: *AssemblyProgram, function: *AssemblyFunction, root: s32,
            identity: s32, span: IR.ZirSourceSpan) {
    if program.failed != 0 || function.current < 0 || TypeOwned(program, identity, 0) == false { return }
    at := root
    while at >= 0 && at < function.source.expr_count &&
          function.source.exprs[at].kind == ZirExprKind.MEMBER {
        at = function.source.exprs[at].left
    }
    if at < 0 || at >= function.source.expr_count { return }
    base := *function.source.exprs[at]
    if base.kind != ZirExprKind.IDENT ||
       (base.is_global_value == 0 && Binding(function, base.name) < 0) {
        return
    }
    place := AssemblyVecPlace.{address = -1, local = null}
    if Addressable(program, function, root, 0) != 0 {
        place.address = Address(program, function, root, 0)
    } else {
        place.local = CaptureLocal(program, function, root, 0)
    }
    VecWrite(program, function, *place, Zero(program, function, identity, span, 0), span)
}

// An unnamed binding carries a value through block parameters.
Carry :: (program: *AssemblyProgram, function: *AssemblyFunction, type: s32, value: s32) -> s32 {
    binding := AssemblyBinding.{name = SVC.Keep(""), type = type, value = value, storage_type = -1}
    index := function.bindings.count
    if PushBinding(program, *function.bindings, binding) { return index }
    return -1
}

Carried :: (function: *AssemblyFunction, index: s32) -> s32 {
    return function.bindings.data[index].value
}

// A block template of the first `count` bindings plus one unnamed value.
Template :: (program: *AssemblyProgram, before: *AssemblyBinding, count: s32,
             type: s32) -> *AssemblyBinding {
    template := cast(*AssemblyBinding)Allocate(program, cast(usize)(count) + 1,
                                               size_of(AssemblyBinding))
    if template == null { return null }
    if count > 0 {
        memcpy(cast(*void)template, cast(*void)before,
               cast(usize)(count) * size_of(AssemblyBinding))
    }
    template[count] = AssemblyBinding.{name = SVC.Keep(""), type = type, value = -1, storage_type = -1}
    return template
}


CaptureLocal :: (program: *AssemblyProgram, function: *AssemblyFunction, root: s32,
                 depth: s32) -> *AssemblyLocalPlace {
    if Spend(program, function.source.span) == 0 { return null }
    if depth > 256 || root < 0 || root >= function.source.expr_count {
        Fail(program, function.source.span, "invalid or excessively deep local assignment")
        return null
    }
    destination := *function.source.exprs[root]
    if destination.kind == ZirExprKind.IDENT && destination.is_global_value == 0 {
        binding := Binding(function, destination.name)
        if binding < 0 {
            Fail(program, destination.span, "assignment requires a local binding")
            return null
        }
        place := cast(*AssemblyLocalPlace)Allocate(program, 1, size_of(AssemblyLocalPlace))
        if place == null { return null }
        current := function.bindings.data[binding]
        storage: s32 = 0
        if current.storage_type >= 0 { storage = 1 }
        <<place = AssemblyLocalPlace.{binding = binding, type = current.type,
            value = current.value, index = -1, storage = storage}
        return place
    }
    if destination.kind != ZirExprKind.MEMBER && destination.kind != ZirExprKind.INDEX {
        Fail(program, destination.span,
             "assignment destination has no lowered storage representation yet")
        return null
    }
    parent := CaptureLocal(program, function, destination.left, depth + 1)
    if parent == null { return null }
    member: s32 = -1
    selected: s32 = -1
    member_type: s32 = -1
    if destination.kind == ZirExprKind.MEMBER {
        fields := cast(*s32)Allocate(program, ASSEMBLY_FIELD_PATH_MAX, size_of(s32))
        types := cast(*s32)Allocate(program, ASSEMBLY_FIELD_PATH_MAX, size_of(s32))
        if fields == null || types == null { return null }
        count := FieldPath(program, parent.type, destination.name, destination.span,
                           fields, types)
        hop: s32 = 0
        while hop + 1 < count && program.failed == 0 {
            current_value := Indexed(program, function, LirOp.Extract, types[hop],
                                     *parent.value, 1, cast(u64)(fields[hop]), destination.span)
            place := cast(*AssemblyLocalPlace)Allocate(program, 1, size_of(AssemblyLocalPlace))
            if place == null { return null }
            <<place = AssemblyLocalPlace.{type = types[hop], value = current_value,
                member = fields[hop], index = -1, parent = parent}
            parent = place
            hop += 1
        }
        if program.failed != 0 { return null }
        member = fields[count - 1]
        member_type = types[count - 1]
    } else {
        ty := TypeAt(program, parent.type)
        if ty.kind != LirTypeKind.Array || destination.right < 0 ||
           destination.right >= function.source.expr_count {
            Fail(program, destination.span, "invalid checked array assignment index")
            return null
        }
        index := *function.source.exprs[destination.right]
        ordinal: u64 = 0
        if index.kind == ZirExprKind.INT && CZirIntegerLiteral(index.text, *ordinal) != 0 &&
           ordinal <= cast(u64)(2147483647) && ordinal < cast(u64)(ty.count) {
            member = cast(s32)(ordinal)
        } else {
            selected = Expression(program, function, destination.right, depth + 1)
        }
        member_type = ty.element
    }
    if program.failed != 0 { return null }
    if member_type < 0 {
        Fail(program, destination.span, "aggregate assignment is outside its declared shape")
        return null
    }
    operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if operands == null { return null }
    operands[0] = parent.value
    operands[1] = selected
    current_value: s32 = 0
    if selected < 0 {
        current_value = Indexed(program, function, LirOp.Extract, member_type,
                                operands, 1, cast(u64)(member), destination.span)
    } else {
        current_value = Indexed(program, function, LirOp.Extract, member_type,
                                operands, 2, 0, destination.span)
    }
    if program.failed != 0 { return null }
    place := cast(*AssemblyLocalPlace)Allocate(program, 1, size_of(AssemblyLocalPlace))
    if place != null {
        <<place = AssemblyLocalPlace.{type = member_type, value = current_value,
            member = member, index = selected, parent = parent}
    }
    return place
}


StoreCaptured :: (program: *AssemblyProgram, function: *AssemblyFunction,
                  place: *AssemblyLocalPlace, value_in: s32, span: IR.ZirSourceSpan) {
    if program.failed != 0 || place == null || Spend(program, span) == 0 { return }
    value := Convert(program, function, value_in, place.type, span)
    if program.failed != 0 { return }
    if place.parent == null {
        if place.storage != 0 {
            operands := cast(*s32)Allocate(program, 2, size_of(s32))
            if operands == null { return }
            operands[0] = place.value
            operands[1] = value
            Emit(program, function, LirOp.Store, 0, operands, 2, -1, span)
            return
        }
        function.bindings.data[place.binding].value = value
        return
    }
    operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if operands == null { return }
    operands[0] = place.parent.value
    operands[1] = value
    operands[2] = place.index
    updated: s32 = 0
    if place.index < 0 {
        updated = Indexed(program, function, LirOp.Insert, place.parent.type,
                          operands, 2, cast(u64)(place.member), span)
    } else {
        updated = Indexed(program, function, LirOp.Insert, place.parent.type,
                          operands, 3, 0, span)
    }
    StoreCaptured(program, function, place.parent, updated, span)
}


// Give the vector carried in binding `carried` room for `needed` elements,
// with the C runtime's policy: capacity 0 starts at 8 and doubles until it
// fits. Returns a bool value; on false the vector is unchanged. `carried`
// must be the newest binding.
VectorReserveCall :: (program: *AssemblyProgram, function: *AssemblyFunction, carried: s32,
               needed: s32, identity: s32, span: IR.ZirSourceSpan) -> s32 {
    element := VecElement(program, identity)
    if program.failed != 0 || function.current < 0 || element < 0 { return -1 }
    pointer := PointerType(program, element, span)
    live := function.bindings.count
    vector := Carried(function, carried)
    data := Indexed(program, function, LirOp.Extract, pointer, *vector, 1, 0, span)
    capacity := Indexed(program, function, LirOp.Extract, 8, *vector, 1, 2, span)
    zero := Constant(program, function, 8, 0, span)
    before := Snapshot(program, function, live)
    answered := Template(program, before, live, 1)
    sized := Template(program, before, live, 8)
    if program.failed != 0 || before == null || answered == null || sized == null { return -1 }
    fits := Block(program, function, before, live)
    grow := Block(program, function, before, live)
    header := Block(program, function, sized, live + 1)
    doubled := Block(program, function, sized, live + 1)
    resize := Block(program, function, sized, live + 1)
    granted := Block(program, function, before, live)
    refused := Block(program, function, before, live)
    done := Block(program, function, answered, live + 1)
    if program.failed != 0 { return -1 }
    enough_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if enough_operands == null { return -1 }
    enough_operands[0] = needed
    enough_operands[1] = capacity
    enough := Emit(program, function, LirOp.LessEqual, 1, enough_operands, 2, -1, span)
    Branch(program, function, enough, fits, grow, live, span)

    Enter(function, fits, before, live)
    Carry(program, function, 1, Constant(program, function, 1, 1, span))
    Jump(program, function, done, live + 1, span)

    Enter(function, grow, before, live)
    empty_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if empty_operands == null { return -1 }
    empty_operands[0] = capacity
    empty_operands[1] = zero
    empty := Emit(program, function, LirOp.Equal, 1, empty_operands, 2, -1, span)
    empty_converted := Emit(program, function, LirOp.Convert, 8, *empty, 1, -1, span)
    initial_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if initial_operands == null { return -1 }
    initial_operands[0] = empty_converted
    initial_operands[1] = Constant(program, function, 8, 8, span)
    start_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if start_operands == null { return -1 }
    start_operands[0] = capacity
    start_operands[1] = Emit(program, function, LirOp.Multiply, 8, initial_operands, 2, -1, span)
    Carry(program, function, 8, Emit(program, function, LirOp.Add, 8, start_operands, 2, -1, span))
    Jump(program, function, header, live + 1, span)

    Enter(function, header, sized, live + 1)
    Emit(program, function, LirOp.Fuel, 0, null, 0, -1, span)
    small_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if small_operands == null { return -1 }
    small_operands[0] = Carried(function, live)
    small_operands[1] = needed
    small := Emit(program, function, LirOp.Less, 1, small_operands, 2, -1, span)
    Branch(program, function, small, doubled, resize, live + 1, span)

    Enter(function, doubled, sized, live + 1)
    twice_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if twice_operands == null { return -1 }
    twice_operands[0] = Carried(function, live)
    twice_operands[1] = Carried(function, live)
    function.bindings.data[live].value = Emit(program, function, LirOp.Add, 8,
                                              twice_operands, 2, -1, span)
    Jump(program, function, header, live + 1, span)

    Enter(function, resize, sized, live + 1)
    next := Carried(function, live)
    resize_operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if resize_operands == null { return -1 }
    resize_operands[0] = data
    resize_operands[1] = capacity
    resize_operands[2] = next
    moved := Emit(program, function, LirOp.Resize, pointer, resize_operands, 3, -1, span)
    failed_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if failed_operands == null { return -1 }
    failed_operands[0] = moved
    failed_operands[1] = Emit(program, function, LirOp.Null, pointer, null, 0, -1, span)
    failed := Emit(program, function, LirOp.Equal, 1, failed_operands, 2, -1, span)
    Branch(program, function, failed, refused, granted, live, span)

    Enter(function, granted, before, live)
    data_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if data_operands == null { return -1 }
    data_operands[0] = Carried(function, carried)
    data_operands[1] = moved
    with_data := Indexed(program, function, LirOp.Insert, identity, data_operands, 2, 0, span)
    capacity_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if capacity_operands == null { return -1 }
    capacity_operands[0] = with_data
    capacity_operands[1] = next
    function.bindings.data[carried].value = Indexed(program, function, LirOp.Insert, identity,
                                                    capacity_operands, 2, 2, span)
    Carry(program, function, 1, Constant(program, function, 1, 1, span))
    Jump(program, function, done, live + 1, span)

    Enter(function, refused, before, live)
    Carry(program, function, 1, Constant(program, function, 1, 0, span))
    Jump(program, function, done, live + 1, span)

    if program.failed != 0 { return -1 }
    Enter(function, done, answered, live + 1)
    answer := Carried(function, live)
    function.bindings.count = live
    return answer
}


// BuilderAppend(builder, text): an empty text succeeds without allocating;
// otherwise room is reserved first, so a refused reserve appends nothing.
AppendBuilder :: (program: *AssemblyProgram, function: *AssemblyFunction,
                  expression: *IR.ZirExpr, depth: s32) -> s32 {
    span := expression.span
    first := expression.first_child
    second: s32 = -1
    if first >= 0 && first < function.source.expr_count {
        second = function.source.exprs[first].next_sibling
    }
    if second < 0 || second >= function.source.expr_count {
        return Fail(program, span, "BuilderAppend requires a builder and text")
    }
    identity := Type(program, function, function.source.exprs[first].type, span)
    string := StringType(program, span)
    if program.failed != 0 { return -1 }
    if VecElement(program, identity) != 3 {
        return Fail(program, span, "BuilderAppend requires a Vec(u8) builder")
    }
    pointer := PointerType(program, 3, span)
    text := Convert(program, function,
                    Expression(program, function, second, depth + 1), string, span)
    place: AssemblyVecPlace
    current := VecRead(program, function, first, identity, *place, span)
    if program.failed != 0 { return -1 }
    bytes := Indexed(program, function, LirOp.Extract, pointer, *text, 1, 0, span)
    length := Indexed(program, function, LirOp.Extract, 8, *text, 1, 1, span)
    used := Indexed(program, function, LirOp.Extract, 8, *current, 1, 1, span)
    zero := Constant(program, function, 8, 0, span)
    carried := Carry(program, function, identity, current)
    live := function.bindings.count
    before := Snapshot(program, function, live)
    answered := Template(program, before, live, 1)
    counted := Template(program, before, live, 8)
    if program.failed != 0 || before == null || answered == null || counted == null { return -1 }
    nothing := Block(program, function, before, live)
    work := Block(program, function, before, live)
    room := Block(program, function, before, live)
    refused := Block(program, function, before, live)
    header := Block(program, function, counted, live + 1)
    body := Block(program, function, counted, live + 1)
    copied := Block(program, function, counted, live + 1)
    done := Block(program, function, answered, live + 1)
    if program.failed != 0 { return -1 }
    empty_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if empty_operands == null { return -1 }
    empty_operands[0] = length
    empty_operands[1] = zero
    empty := Emit(program, function, LirOp.Equal, 1, empty_operands, 2, -1, span)
    Branch(program, function, empty, nothing, work, live, span)

    Enter(function, nothing, before, live)
    Carry(program, function, 1, Constant(program, function, 1, 1, span))
    Jump(program, function, done, live + 1, span)

    Enter(function, work, before, live)
    needed_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if needed_operands == null { return -1 }
    needed_operands[0] = used
    needed_operands[1] = length
    needed := Emit(program, function, LirOp.Add, 8, needed_operands, 2, -1, span)
    reserved := VectorReserveCall(program, function, carried, needed, identity, span)
    Branch(program, function, reserved, room, refused, live, span)

    Enter(function, refused, before, live)
    Carry(program, function, 1, Constant(program, function, 1, 0, span))
    Jump(program, function, done, live + 1, span)

    Enter(function, room, before, live)
    grown := Carried(function, carried)
    target := Indexed(program, function, LirOp.Extract, pointer, *grown, 1, 0, span)
    Carry(program, function, 8, zero)
    Jump(program, function, header, live + 1, span)

    Enter(function, header, counted, live + 1)
    Emit(program, function, LirOp.Fuel, 0, null, 0, -1, span)
    more_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if more_operands == null { return -1 }
    more_operands[0] = Carried(function, live)
    more_operands[1] = length
    more := Emit(program, function, LirOp.Less, 1, more_operands, 2, -1, span)
    Branch(program, function, more, body, copied, live + 1, span)

    Enter(function, body, counted, live + 1)
    at := Carried(function, live)
    from_operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if from_operands == null { return -1 }
    from_operands[0] = bytes
    from_operands[1] = at
    from_operands[2] = length
    from := Emit(program, function, LirOp.ElementAddress, pointer, from_operands, 3, -1, span)
    byte := Emit(program, function, LirOp.Load, 3, *from, 1, -1, span)
    offset_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if offset_operands == null { return -1 }
    offset_operands[0] = used
    offset_operands[1] = at
    to_operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if to_operands == null { return -1 }
    to_operands[0] = target
    to_operands[1] = Emit(program, function, LirOp.Add, 8, offset_operands, 2, -1, span)
    to_operands[2] = needed
    to := Emit(program, function, LirOp.ElementAddress, pointer, to_operands, 3, -1, span)
    store_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if store_operands == null { return -1 }
    store_operands[0] = to
    store_operands[1] = byte
    Emit(program, function, LirOp.Store, 0, store_operands, 2, -1, span)
    next_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if next_operands == null { return -1 }
    next_operands[0] = at
    next_operands[1] = Constant(program, function, 8, 1, span)
    function.bindings.data[live].value = Emit(program, function, LirOp.Add, 8,
                                              next_operands, 2, -1, span)
    Jump(program, function, header, live + 1, span)

    Enter(function, copied, counted, live + 1)
    function.bindings.count = live
    count_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if count_operands == null { return -1 }
    count_operands[0] = Carried(function, carried)
    count_operands[1] = needed
    function.bindings.data[carried].value = Indexed(program, function, LirOp.Insert, identity,
                                                    count_operands, 2, 1, span)
    Carry(program, function, 1, Constant(program, function, 1, 1, span))
    Jump(program, function, done, live + 1, span)

    if program.failed != 0 { return -1 }
    Enter(function, done, answered, live + 1)
    final := Carried(function, carried)
    answer := Carried(function, live)
    function.bindings.count = carried
    VecWrite(program, function, *place, final, span)
    return answer
}


// BuilderFinish(builder): the string keeps the builder's bytes, and the
// builder is left empty without freeing them. An empty builder frees its
// reserved block and gives the empty string.
FinishBuilder :: (program: *AssemblyProgram, function: *AssemblyFunction,
                  expression: *IR.ZirExpr) -> s32 {
    span := expression.span
    first := expression.first_child
    if first < 0 || first >= function.source.expr_count {
        return Fail(program, span, "BuilderFinish requires a builder")
    }
    identity := Type(program, function, function.source.exprs[first].type, span)
    string := StringType(program, span)
    if program.failed != 0 { return -1 }
    if VecElement(program, identity) != 3 {
        return Fail(program, span, "BuilderFinish requires a Vec(u8) builder")
    }
    pointer := PointerType(program, 3, span)
    place: AssemblyVecPlace
    current := VecRead(program, function, first, identity, *place, span)
    if program.failed != 0 { return -1 }
    data := Indexed(program, function, LirOp.Extract, pointer, *current, 1, 0, span)
    count := Indexed(program, function, LirOp.Extract, 8, *current, 1, 1, span)
    capacity := Indexed(program, function, LirOp.Extract, 8, *current, 1, 2, span)
    zero := Constant(program, function, 8, 0, span)
    live := function.bindings.count
    before := Snapshot(program, function, live)
    answered := Template(program, before, live, pointer)
    if program.failed != 0 || (live > 0 && before == null) || answered == null { return -1 }
    blank := Block(program, function, before, live)
    kept := Block(program, function, before, live)
    done := Block(program, function, answered, live + 1)
    if program.failed != 0 { return -1 }
    empty_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if empty_operands == null { return -1 }
    empty_operands[0] = count
    empty_operands[1] = zero
    empty := Emit(program, function, LirOp.Equal, 1, empty_operands, 2, -1, span)
    Branch(program, function, empty, blank, kept, live, span)

    Enter(function, blank, before, live)
    release_operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if release_operands == null { return -1 }
    release_operands[0] = data
    release_operands[1] = capacity
    release_operands[2] = zero
    Carry(program, function, pointer,
          Emit(program, function, LirOp.Resize, pointer, release_operands, 3, -1, span))
    Jump(program, function, done, live + 1, span)

    Enter(function, kept, before, live)
    Carry(program, function, pointer, data)
    Jump(program, function, done, live + 1, span)

    if program.failed != 0 { return -1 }
    Enter(function, done, answered, live + 1)
    fields := cast(*s32)Allocate(program, 2, size_of(s32))
    if fields == null { return -1 }
    fields[0] = Carried(function, live)
    fields[1] = count
    function.bindings.count = live
    VecWrite(program, function, *place, Zero(program, function, identity, span, 0), span)
    return Emit(program, function, LirOp.Aggregate, string, fields, 2, -1, span)
}


// Allocation failure and invocation of an empty callable trap on every target.
RequirePointer :: (program: *AssemblyProgram, function: *AssemblyFunction,
                   pointer: s32, span: IR.ZirSourceSpan) {
    if program.failed != 0 || pointer < 0 { return }
    type := function.values.data[pointer]
    live := function.bindings.count
    before := Snapshot(program, function, live)
    refused := Block(program, function, before, live)
    granted := Block(program, function, before, live)
    if program.failed != 0 { return }
    operands := s32.[pointer, Emit(program, function, LirOp.Null, type, null, 0, -1, span)]
    absent := Emit(program, function, LirOp.Equal, 1, operands.data, 2, -1, span)
    Branch(program, function, absent, refused, granted, live, span)
    Enter(function, refused, before, live)
    Emit(program, function, LirOp.Trap, 0, null, 0, -1, span)
    function.current = -1
    Enter(function, granted, before, live)
}

DropCallable :: (program: *AssemblyProgram, function: *AssemblyFunction,
                 value: s32, identity: s32, span: IR.ZirSourceSpan) {
    record := TypeAt(program, identity)
    state_type := record.fields[0]
    release_type := record.fields[2]
    state := Indexed(program, function, LirOp.Extract, state_type, *value, 1, 0, span)
    release := Indexed(program, function, LirOp.Extract, release_type, *value, 1, 2, span)
    live := function.bindings.count
    before := Snapshot(program, function, live)
    drop := Block(program, function, before, live)
    done := Block(program, function, before, live)
    if program.failed != 0 { return }
    operands := s32.[state, Emit(program, function, LirOp.Null, state_type, null, 0, -1, span)]
    absent := Emit(program, function, LirOp.Equal, 1, operands.data, 2, -1, span)
    Branch(program, function, absent, done, drop, live, span)
    Enter(function, drop, before, live)
    RequirePointer(program, function, release, span)
    arguments := s32.[release, state]
    Emit(program, function, LirOp.CallIndirect, 0, arguments.data, 2, -1, span)
    Jump(program, function, done, live, span)
    Enter(function, done, before, live)
}

OwnedClosure :: (program: *AssemblyProgram, function: *AssemblyFunction,
                 expression: *IR.ZirExpr, type: s32, depth: s32) -> s32 {
    span := expression.span
    environment := Type(program, function, expression.name, span)
    value := Expression(program, function, expression.left, depth + 1)
    pointer_type := PointerType(program, environment, span)
    pointer := New(program, function, expression, pointer_type)
    RequirePointer(program, function, pointer, span)
    if program.failed != 0 { return -1 }
    store := s32.[pointer, Convert(program, function, value, environment, span)]
    Emit(program, function, LirOp.Store, 0, store.data, 2, -1, span)
    state_type := TypeAt(program, type).fields[0]
    invoke_type := TypeAt(program, type).fields[1]
    release_type := TypeAt(program, type).fields[2]
    fields := s32.[Emit(program, function, LirOp.Bitcast, state_type, *pointer, 1, -1, span),
        Convert(program, function, Expression(program, function, expression.right, depth + 1), invoke_type, span),
        Convert(program, function, Expression(program, function, expression.third, depth + 1), release_type, span)]
    return Emit(program, function, LirOp.Aggregate, type, fields.data, 3, -1, span)
}

DropCapture :: (program: *AssemblyProgram, function: *AssemblyFunction,
                expression: *IR.ZirExpr, depth: s32) -> s32 {
    span := expression.span
    environment := Type(program, function, expression.name, span)
    pointer_type := PointerType(program, environment, span)
    state := Expression(program, function, expression.left, depth + 1)
    pointer := Emit(program, function, LirOp.Bitcast, pointer_type, *state, 1, -1, span)
    RequirePointer(program, function, pointer, span)
    if program.failed != 0 { return -1 }
    value := Emit(program, function, LirOp.Load, environment, *pointer, 1, -1, span)
    DropValue(program, function, value, environment, span, 0)
    operands := s32.[pointer, Constant(program, function, 8, 1, span),
        Constant(program, function, 8, 0, span)]
    Emit(program, function, LirOp.Resize, pointer_type, operands.data, 3, -1, span)
    return -1
}

// New(T): one zeroed T on the heap, or null when it cannot be had.
New :: (program: *AssemblyProgram, function: *AssemblyFunction,
        expression: *IR.ZirExpr, type: s32) -> s32 {
    span := expression.span
    if TypeAt(program, type).kind != LirTypeKind.Pointer {
        return Fail(program, span, "New requires a pointer result")
    }
    operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if operands == null { return -1 }
    operands[0] = Emit(program, function, LirOp.Null, type, null, 0, -1, span)
    operands[1] = Constant(program, function, 8, 0, span)
    operands[2] = Constant(program, function, 8, 1, span)
    return Emit(program, function, LirOp.Resize, type, operands, 3, -1, span)
}

// free(pointer): gives back what New made; freeing null does nothing.
FreePointer :: (program: *AssemblyProgram, function: *AssemblyFunction,
         expression: *IR.ZirExpr, depth: s32) -> s32 {
    span := expression.span
    if expression.first_child < 0 || expression.first_child >= function.source.expr_count {
        return Fail(program, span, "free requires a pointer")
    }
    pointer := Expression(program, function, expression.first_child, depth + 1)
    if program.failed != 0 { return -1 }
    type := function.values.data[pointer]
    if TypeAt(program, type).kind != LirTypeKind.Pointer {
        return Fail(program, span, "free requires a pointer")
    }
    live := function.bindings.count
    before := Snapshot(program, function, live)
    if program.failed != 0 || (live > 0 && before == null) { return -1 }
    release := Block(program, function, before, live)
    done := Block(program, function, before, live)
    if program.failed != 0 { return -1 }
    null_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if null_operands == null { return -1 }
    null_operands[0] = pointer
    null_operands[1] = Emit(program, function, LirOp.Null, type, null, 0, -1, span)
    absent := Emit(program, function, LirOp.Equal, 1, null_operands, 2, -1, span)
    Branch(program, function, absent, done, release, live, span)

    Enter(function, release, before, live)
    operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if operands == null { return -1 }
    operands[0] = pointer
    operands[1] = Constant(program, function, 8, 1, span)
    operands[2] = Constant(program, function, 8, 0, span)
    Emit(program, function, LirOp.Resize, type, operands, 3, -1, span)
    Jump(program, function, done, live, span)

    Enter(function, done, before, live)
    return -1
}


// Store over elements [from, to) of a vector block, dropping each one
// first when drop is set: the element at the same index of the block
// source, or the zero value when source is negative. bound is capacity.
VecReset :: (program: *AssemblyProgram, function: *AssemblyFunction, data: s32,
             from: s32, to: s32, bound: s32, element: s32, drop: bool, source: s32,
             span: IR.ZirSourceSpan) {
    if program.failed != 0 || function.current < 0 { return }
    pointer := PointerType(program, element, span)
    base := function.bindings.count
    cursor := AssemblyBinding.{name = null, type = 8, value = from, storage_type = -1}
    if PushBinding(program, *function.bindings, cursor) == false { return }
    live := base + 1
    before := Snapshot(program, function, live)
    header := Block(program, function, before, live)
    body := Block(program, function, before, live)
    exit := Block(program, function, before, live)
    if program.failed != 0 || before == null { return }
    Jump(program, function, header, live, span)
    Enter(function, header, before, live)
    Emit(program, function, LirOp.Fuel, 0, null, 0, -1, span)
    more_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if more_operands == null { return }
    more_operands[0] = function.bindings.data[base].value
    more_operands[1] = to
    more := Emit(program, function, LirOp.Less, 1, more_operands, 2, -1, span)
    Branch(program, function, more, body, exit, live, span)
    Enter(function, body, before, live)
    at := function.bindings.data[base].value
    slot_operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if slot_operands == null { return }
    slot_operands[0] = data
    slot_operands[1] = at
    slot_operands[2] = bound
    slot := Emit(program, function, LirOp.ElementAddress, pointer, slot_operands, 3, -1, span)
    if drop {
        DropValue(program, function,
                  Emit(program, function, LirOp.Load, element, *slot, 1, -1, span),
                  element, span, 0)
    }
    stored: s32 = 0
    if source >= 0 {
        from_operands := cast(*s32)Allocate(program, 3, size_of(s32))
        if from_operands == null { return }
        from_operands[0] = source
        from_operands[1] = at
        from_operands[2] = bound
        from_slot := Emit(program, function, LirOp.ElementAddress, pointer, from_operands, 3, -1, span)
        stored = Emit(program, function, LirOp.Load, element, *from_slot, 1, -1, span)
    } else {
        stored = Zero(program, function, element, span, 0)
    }
    store_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if store_operands == null { return }
    store_operands[0] = slot
    store_operands[1] = stored
    Emit(program, function, LirOp.Store, 0, store_operands, 2, -1, span)
    next_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if next_operands == null { return }
    next_operands[0] = at
    next_operands[1] = Constant(program, function, 8, 1, span)
    function.bindings.data[base].value = Emit(program, function, LirOp.Add, 8,
                                              next_operands, 2, -1, span)
    Jump(program, function, header, live, span)
    Enter(function, exit, before, live)
    function.bindings.count = base
}


// VecReserve(values, capacity): room for at least that many elements, with
// the count unchanged. The portable engine gives exactly the requested
// capacity when it grows; a negative request or a refused allocation gives
// false and leaves the vector as it was. VecResize(values, count) reserves
// the same way and then sets the count: elements it removes are dropped,
// and elements it adds are zero. VecResizeBounded(values, count, maximum)
// is VecResize that also fails, unchanged, when the maximum is negative or
// the count or the capacity it already has is above it.
VecReserveCall :: (program: *AssemblyProgram, function: *AssemblyFunction,
                   expression: *IR.ZirExpr, resize: bool, depth: s32) -> s32 {
    span := expression.span
    first := expression.first_child
    second: s32 = -1
    if first >= 0 && first < function.source.expr_count {
        second = function.source.exprs[first].next_sibling
    }
    if second < 0 || second >= function.source.expr_count {
        return Fail(program, span, "VecReserve requires a vector place and a capacity")
    }
    identity := Type(program, function, function.source.exprs[first].type, span)
    element := VecElement(program, identity)
    if program.failed != 0 { return -1 }
    if element < 0 { return Fail(program, span, "VecReserve requires an owned vector") }
    pointer := PointerType(program, element, span)
    requested := Convert(program, function,
                         Expression(program, function, second, depth + 1), 8, span)
    third := function.source.exprs[second].next_sibling
    bounded := false
    if resize == true && third >= 0 && third < function.source.expr_count { bounded = true }
    maximum: s32 = -1
    if bounded == true {
        maximum = Convert(program, function,
                          Expression(program, function, third, depth + 1), 8, span)
    }
    place: AssemblyVecPlace
    current := VecRead(program, function, first, identity, *place, span)
    if program.failed != 0 { return -1 }
    data := Indexed(program, function, LirOp.Extract, pointer, *current, 1, 0, span)
    capacity := Indexed(program, function, LirOp.Extract, 8, *current, 1, 2, span)
    zero := Constant(program, function, 8, 0, span)
    carried := Carry(program, function, identity, current)
    live := function.bindings.count
    before := Snapshot(program, function, live)
    answered := Template(program, before, live, 1)
    if program.failed != 0 || before == null || answered == null { return -1 }
    valid := Block(program, function, before, live)
    rejected := Block(program, function, before, live)
    fits := Block(program, function, before, live)
    grow := Block(program, function, before, live)
    granted := Block(program, function, before, live)
    done := Block(program, function, answered, live + 1)
    if program.failed != 0 { return -1 }
    negative_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if negative_operands == null { return -1 }
    negative_operands[0] = requested
    negative_operands[1] = zero
    negative := Emit(program, function, LirOp.Less, 1, negative_operands, 2, -1, span)
    if bounded == true {
        any := Convert(program, function, negative, 3, span)
        rule: s32 = 0
        while rule < 3 {
            left: s32 = maximum
            right: s32 = zero
            if rule == 1 {
                left = maximum
                right = requested
            }
            if rule == 2 { right = capacity }
            rule_operands := cast(*s32)Allocate(program, 2, size_of(s32))
            if rule_operands == null { return -1 }
            rule_operands[0] = left
            rule_operands[1] = right
            broken := Convert(program, function,
                              Emit(program, function, LirOp.Less, 1, rule_operands, 2, -1, span), 3, span)
            or_operands := cast(*s32)Allocate(program, 2, size_of(s32))
            if or_operands == null { return -1 }
            or_operands[0] = any
            or_operands[1] = broken
            any = Emit(program, function, LirOp.BitOr, 3, or_operands, 2, -1, span)
            rule += 1
        }
        any_operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if any_operands == null { return -1 }
        any_operands[0] = any
        any_operands[1] = Constant(program, function, 3, 0, span)
        negative = Emit(program, function, LirOp.NotEqual, 1, any_operands, 2, -1, span)
    }
    Branch(program, function, negative, rejected, valid, live, span)

    Enter(function, rejected, before, live)
    Carry(program, function, 1, Constant(program, function, 1, 0, span))
    Jump(program, function, done, live + 1, span)

    Enter(function, valid, before, live)
    enough_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if enough_operands == null { return -1 }
    enough_operands[0] = requested
    enough_operands[1] = capacity
    enough := Emit(program, function, LirOp.LessEqual, 1, enough_operands, 2, -1, span)
    Branch(program, function, enough, fits, grow, live, span)

    Enter(function, fits, before, live)
    Carry(program, function, 1, Constant(program, function, 1, 1, span))
    Jump(program, function, done, live + 1, span)

    Enter(function, grow, before, live)
    resize_operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if resize_operands == null { return -1 }
    resize_operands[0] = data
    resize_operands[1] = capacity
    resize_operands[2] = requested
    moved := Emit(program, function, LirOp.Resize, pointer, resize_operands, 3, -1, span)
    failed_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if failed_operands == null { return -1 }
    failed_operands[0] = moved
    failed_operands[1] = Emit(program, function, LirOp.Null, pointer, null, 0, -1, span)
    failed := Emit(program, function, LirOp.Equal, 1, failed_operands, 2, -1, span)
    Branch(program, function, failed, rejected, granted, live, span)

    Enter(function, granted, before, live)
    data_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if data_operands == null { return -1 }
    data_operands[0] = Carried(function, carried)
    data_operands[1] = moved
    with_data := Indexed(program, function, LirOp.Insert, identity, data_operands, 2, 0, span)
    capacity_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if capacity_operands == null { return -1 }
    capacity_operands[0] = with_data
    capacity_operands[1] = requested
    function.bindings.data[carried].value = Indexed(program, function, LirOp.Insert, identity,
                                                    capacity_operands, 2, 2, span)
    Carry(program, function, 1, Constant(program, function, 1, 1, span))
    Jump(program, function, done, live + 1, span)

    if program.failed != 0 { return -1 }
    Enter(function, done, answered, live + 1)
    if resize == true {
        all := live + 1
        settled := Snapshot(program, function, all)
        sizing := Block(program, function, settled, all)
        finished := Block(program, function, settled, all)
        if program.failed != 0 || settled == null { return -1 }
        Branch(program, function, Carried(function, live), sizing, finished, all, span)

        Enter(function, sizing, settled, all)
        vector := Carried(function, carried)
        block := Indexed(program, function, LirOp.Extract, pointer, *vector, 1, 0, span)
        count := Indexed(program, function, LirOp.Extract, 8, *vector, 1, 1, span)
        room := Indexed(program, function, LirOp.Extract, 8, *vector, 1, 2, span)
        if TypeOwned(program, element, 0) == true {
            VecReset(program, function, block, requested, count, room, element, true, -1, span)
        }
        VecReset(program, function, block, count, requested, room, element, false, -1, span)
        count_operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if count_operands == null { return -1 }
        count_operands[0] = Carried(function, carried)
        count_operands[1] = requested
        function.bindings.data[carried].value = Indexed(program, function, LirOp.Insert,
                                                        identity, count_operands, 2, 1, span)
        Jump(program, function, finished, all, span)

        if program.failed != 0 { return -1 }
        Enter(function, finished, settled, all)
    }
    final := Carried(function, carried)
    answer := Carried(function, live)
    function.bindings.count = carried
    VecWrite(program, function, *place, final, span)
    return answer
}

// clz, ctz, popcount and bswap of an integer, with the instructions every
// engine has: the argument's bits zero-extended to u64, a SWAR popcount,
// ctz(x) as popcount((x & -x) - 1) in the argument's width, clz as the width
// less the popcount of x with every bit below its highest set, bswap as byte
// moves. Zero gives the width for clz and ctz.

BitOp :: (program: *AssemblyProgram, function: *AssemblyFunction, op: LIR.LirOp,
          left: s32, right: s32, span: IR.ZirSourceSpan) -> s32 {
    operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if operands == null { return -1 }
    operands[0] = left
    operands[1] = right
    return Emit(program, function, op, 9, operands, 2, -1, span)
}

Popcount64 :: (program: *AssemblyProgram, function: *AssemblyFunction, value: s32,
               span: IR.ZirSourceSpan) -> s32 {
    halves := BitOp(program, function, LirOp.BitAnd,
        BitOp(program, function, LirOp.ShiftRight, value,
            Constant(program, function, 9, cast(u64)1, span), span),
        Constant(program, function, 9, cast(u64)0x5555555555555555, span), span)
    pairs := BitOp(program, function, LirOp.Subtract, value, halves, span)
    quads := BitOp(program, function, LirOp.Add,
        BitOp(program, function, LirOp.BitAnd, pairs,
            Constant(program, function, 9, cast(u64)0x3333333333333333, span), span),
        BitOp(program, function, LirOp.BitAnd,
            BitOp(program, function, LirOp.ShiftRight, pairs,
                Constant(program, function, 9, cast(u64)2, span), span),
            Constant(program, function, 9, cast(u64)0x3333333333333333, span), span), span)
    bytes := BitOp(program, function, LirOp.BitAnd,
        BitOp(program, function, LirOp.Add, quads,
            BitOp(program, function, LirOp.ShiftRight, quads,
                Constant(program, function, 9, cast(u64)4, span), span), span),
        Constant(program, function, 9, cast(u64)0x0f0f0f0f0f0f0f0f, span), span)
    return BitOp(program, function, LirOp.ShiftRight,
        BitOp(program, function, LirOp.Multiply, bytes,
            Constant(program, function, 9, cast(u64)0x0101010101010101, span), span),
        Constant(program, function, 9, cast(u64)56, span), span)
}

Bit :: (program: *AssemblyProgram, function: *AssemblyFunction, expression: *IR.ZirExpr,
        type: s32, bit: s32, depth: s32) -> s32 {
    span := expression.span
    if expression.first_child < 0 || expression.first_child >= function.source.expr_count {
        return Fail(program, span, "a bit builtin takes one integer")
    }
    value := Expression(program, function, expression.first_child, depth + 1)
    if program.failed != 0 { return -1 }
    argument := TypeAt(program, function.values.data[value])
    if argument.kind != LirTypeKind.Integer {
        return Fail(program, span, "a bit builtin takes one integer")
    }
    width := argument.bits
    same_width := UnsignedOf(width)
    bits := Convert(program, function, Convert(program, function, value, same_width, span), 9, span)
    result: s32 = -1
    if bit == ZIR_BIT_POPCOUNT {
        result = Popcount64(program, function, bits, span)
    } else if bit == ZIR_BIT_CTZ {
        lowest := BitOp(program, function, LirOp.BitAnd, bits,
            BitOp(program, function, LirOp.Subtract,
                Constant(program, function, 9, cast(u64)0, span), bits, span), span)
        below := BitOp(program, function, LirOp.Subtract, lowest,
            Constant(program, function, 9, cast(u64)1, span), span)
        if width < 64 {
            below = BitOp(program, function, LirOp.BitAnd, below,
                Constant(program, function, 9,
                    (cast(u64)1 << cast(u64)width) - cast(u64)1, span), span)
        }
        result = Popcount64(program, function, below, span)
    } else if bit == ZIR_BIT_CLZ {
        smeared := bits
        shift: s32 = 1
        while shift < width {
            smeared = BitOp(program, function, LirOp.BitOr, smeared,
                BitOp(program, function, LirOp.ShiftRight, smeared,
                    Constant(program, function, 9, cast(u64)shift, span), span), span)
            shift = shift * 2
        }
        result = BitOp(program, function, LirOp.Subtract,
            Constant(program, function, 9, cast(u64)width, span),
            Popcount64(program, function, smeared, span), span)
    } else {
        result = Constant(program, function, 9, cast(u64)0, span)
        byte: s32 = 0
        while byte < width / 8 {
            moved := BitOp(program, function, LirOp.BitAnd,
                BitOp(program, function, LirOp.ShiftRight, bits,
                    Constant(program, function, 9, cast(u64)(8 * byte), span), span),
                Constant(program, function, 9, cast(u64)0xff, span), span)
            moved = BitOp(program, function, LirOp.ShiftLeft, moved,
                Constant(program, function, 9,
                    cast(u64)(8 * (width / 8 - 1 - byte)), span), span)
            result = BitOp(program, function, LirOp.BitOr, result, moved, span)
            byte = byte + 1
        }
        result = Convert(program, function, result, same_width, span)
    }
    return Convert(program, function, result, type, span)
}


// VecClone(destination, source): the destination becomes a copy of the
// source's elements with exactly that many as its capacity, and what it held
// is dropped. When the copy cannot be allocated the answer is false and the
// destination is unchanged.
VectorClone :: (program: *AssemblyProgram, function: *AssemblyFunction,
                expression: *IR.ZirExpr, depth: s32) -> s32 {
    span := expression.span
    first := expression.first_child
    second: s32 = -1
    if first >= 0 && first < function.source.expr_count {
        second = function.source.exprs[first].next_sibling
    }
    if second < 0 || second >= function.source.expr_count {
        return Fail(program, span, "VecClone requires a destination and a source vector")
    }
    identity := Type(program, function, function.source.exprs[first].type, span)
    element := VecElement(program, identity)
    if program.failed != 0 { return -1 }
    if element < 0 { return Fail(program, span, "VecClone requires an owned vector") }
    if TypeOwned(program, element, 0) == true {
        return Fail(program, span, "VecClone of elements that own storage is not lowered yet")
    }
    pointer := PointerType(program, element, span)
    source := Convert(program, function,
        Expression(program, function, second, depth + 1), identity, span)
    place := AssemblyVecPlace.{address = -1, local = null}
    current := VecRead(program, function, first, identity, *place, span)
    if program.failed != 0 { return -1 }
    from := Indexed(program, function, LirOp.Extract, pointer, *source, 1, 0, span)
    count := Indexed(program, function, LirOp.Extract, 8, *source, 1, 1, span)
    zero := Constant(program, function, 8, 0, span)
    empty := Emit(program, function, LirOp.Null, pointer, null, 0, -1, span)
    carried := Carry(program, function, identity, current)
    live := function.bindings.count
    before := Snapshot(program, function, live)
    copied := Template(program, before, live, pointer)
    answered := Template(program, before, live, 1)
    if program.failed != 0 || before == null || copied == null || answered == null { return -1 }
    allocate := Block(program, function, before, live)
    nothing := Block(program, function, before, live)
    copy := Block(program, function, before, live)
    rejected := Block(program, function, before, live)
    publish := Block(program, function, copied, live + 1)
    done := Block(program, function, answered, live + 1)
    if program.failed != 0 { return -1 }
    some_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if some_operands == null { return -1 }
    some_operands[0] = zero
    some_operands[1] = count
    some := Emit(program, function, LirOp.Less, 1, some_operands, 2, -1, span)
    Branch(program, function, some, allocate, nothing, live, span)
    Enter(function, nothing, before, live)
    Carry(program, function, pointer, empty)
    Jump(program, function, publish, live + 1, span)

    Enter(function, allocate, before, live)
    resize_operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if resize_operands == null { return -1 }
    resize_operands[0] = empty
    resize_operands[1] = zero
    resize_operands[2] = count
    block := Emit(program, function, LirOp.Resize, pointer, resize_operands, 3, -1, span)
    failed_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if failed_operands == null { return -1 }
    failed_operands[0] = block
    failed_operands[1] = empty
    failed := Emit(program, function, LirOp.Equal, 1, failed_operands, 2, -1, span)
    Branch(program, function, failed, rejected, copy, live, span)

    Enter(function, rejected, before, live)
    Carry(program, function, 1, Constant(program, function, 1, 0, span))
    Jump(program, function, done, live + 1, span)

    Enter(function, copy, before, live)
    VecReset(program, function, block, zero, count, count, element, false, from, span)
    Carry(program, function, pointer, block)
    Jump(program, function, publish, live + 1, span)

    if program.failed != 0 { return -1 }
    Enter(function, publish, copied, live + 1)
    data := Carried(function, live)
    function.bindings.count = live
    DropValue(program, function, Carried(function, carried), identity, span, 0)
    fields := cast(*s32)Allocate(program, 3, size_of(s32))
    if fields == null { return -1 }
    fields[0] = data
    fields[1] = count
    fields[2] = count
    function.bindings.data[carried].value = Emit(program, function, LirOp.Aggregate,
                                                 identity, fields, 3, -1, span)
    Carry(program, function, 1, Constant(program, function, 1, 1, span))
    Jump(program, function, done, live + 1, span)

    if program.failed != 0 { return -1 }
    Enter(function, done, answered, live + 1)
    final := Carried(function, carried)
    answer := Carried(function, live)
    function.bindings.count = carried
    VecWrite(program, function, *place, final, span)
    return answer
}


// VecGet(values, index) and VecPop(values): an Option that holds the element
// when there is one. VecGet copies it and leaves the vector alone, with
// nothing for an index at or past the count; VecPop moves the last element
// out and shortens the vector by one.
VectorTake :: (program: *AssemblyProgram, function: *AssemblyFunction,
               expression: *IR.ZirExpr, option: s32, get: bool, depth: s32) -> s32 {
    span := expression.span
    first := expression.first_child
    second: s32 = -1
    if first >= 0 && first < function.source.expr_count {
        second = function.source.exprs[first].next_sibling
    }
    if first < 0 || first >= function.source.expr_count ||
       (get == true && (second < 0 || second >= function.source.expr_count)) {
        return Fail(program, span, "VecGet and VecPop require a vector place")
    }
    identity := Type(program, function, function.source.exprs[first].type, span)
    element := VecElement(program, identity)
    if program.failed != 0 { return -1 }
    shape := TypeAt(program, option)
    if element < 0 || shape.kind != LirTypeKind.Record || shape.fields.count != 2 ||
       shape.fields[0] != 1 || shape.fields[1] != element {
        return Fail(program, span, "VecGet and VecPop require an owned vector and its Option")
    }
    if get == true && TypeOwned(program, element, 0) == true {
        return Fail(program, span, "VecGet of an element that owns storage is not lowered yet")
    }
    pointer := PointerType(program, element, span)
    at: s32 = -1
    if get == true {
        at = Convert(program, function, Expression(program, function, second, depth + 1), 8, span)
    }
    place := AssemblyVecPlace.{address = -1, local = null}
    current := VecRead(program, function, first, identity, *place, span)
    if program.failed != 0 { return -1 }
    data := Indexed(program, function, LirOp.Extract, pointer, *current, 1, 0, span)
    count := Indexed(program, function, LirOp.Extract, 8, *current, 1, 1, span)
    zero := Constant(program, function, 8, 0, span)
    carried := Carry(program, function, identity, current)
    live := function.bindings.count
    before := Snapshot(program, function, live)
    answered := Template(program, before, live, option)
    if program.failed != 0 || before == null || answered == null { return -1 }
    present := Block(program, function, before, live)
    absent := Block(program, function, before, live)
    done := Block(program, function, answered, live + 1)
    if program.failed != 0 { return -1 }
    // A negative index compares below the count and then fails the element
    // address, as it fails on the portable engine.
    some_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if some_operands == null { return -1 }
    some_operands[0] = ifx get == true then at else zero
    some_operands[1] = count
    some := Emit(program, function, LirOp.Less, 1, some_operands, 2, -1, span)
    Branch(program, function, some, present, absent, live, span)

    Enter(function, present, before, live)
    if get == false {
        last_operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if last_operands == null { return -1 }
        last_operands[0] = count
        last_operands[1] = Constant(program, function, 8, 1, span)
        at = Emit(program, function, LirOp.Subtract, 8, last_operands, 2, -1, span)
    }
    slot_operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if slot_operands == null { return -1 }
    slot_operands[0] = data
    slot_operands[1] = at
    slot_operands[2] = count
    slot := Emit(program, function, LirOp.ElementAddress, pointer, slot_operands, 3, -1, span)
    item := Emit(program, function, LirOp.Load, element, *slot, 1, -1, span)
    if get == false {
        shorter_operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if shorter_operands == null { return -1 }
        shorter_operands[0] = Carried(function, carried)
        shorter_operands[1] = at
        function.bindings.data[carried].value = Indexed(program, function, LirOp.Insert,
                                                        identity, shorter_operands, 2, 1, span)
    }
    fields := cast(*s32)Allocate(program, 2, size_of(s32))
    if fields == null { return -1 }
    fields[0] = Constant(program, function, 1, 1, span)
    fields[1] = item
    Carry(program, function, option, Emit(program, function, LirOp.Aggregate,
                                          option, fields, 2, -1, span))
    Jump(program, function, done, live + 1, span)

    Enter(function, absent, before, live)
    Carry(program, function, option, Zero(program, function, option, span, 0))
    Jump(program, function, done, live + 1, span)

    if program.failed != 0 { return -1 }
    Enter(function, done, answered, live + 1)
    final := Carried(function, carried)
    answer := Carried(function, live)
    function.bindings.count = carried
    if get == false {
        VecWrite(program, function, *place, final, span)
    }
    return answer
}


// VecSwap(left, right): the two places exchange their vectors; no element
// moves and nothing is allocated.
VectorSwap :: (program: *AssemblyProgram, function: *AssemblyFunction,
               expression: *IR.ZirExpr) -> s32 {
    span := expression.span
    first := expression.first_child
    second: s32 = -1
    if first >= 0 && first < function.source.expr_count {
        second = function.source.exprs[first].next_sibling
    }
    if second < 0 || second >= function.source.expr_count {
        return Fail(program, span, "VecSwap requires two vector places")
    }
    identity := Type(program, function, function.source.exprs[first].type, span)
    other := Type(program, function, function.source.exprs[second].type, span)
    if program.failed != 0 { return -1 }
    if VecElement(program, identity) < 0 || other != identity {
        return Fail(program, span, "VecSwap requires two vectors of one element type")
    }
    left_place := AssemblyVecPlace.{address = -1, local = null}
    right_place := AssemblyVecPlace.{address = -1, local = null}
    left := VecRead(program, function, first, identity, *left_place, span)
    VecWrite(program, function, *left_place,
        VecRead(program, function, second, identity, *right_place, span), span)
    // The right place is captured again: writing the left one may have
    // rebuilt an aggregate both places live in.
    VecRead(program, function, second, identity, *right_place, span)
    VecWrite(program, function, *right_place, left, span)
    return -1
}

// VecSlice(values, low, high): a borrowed view of the vector's elements,
// bounds-checked against its count like any slice of a slice.
VectorSlice :: (program: *AssemblyProgram, function: *AssemblyFunction,
                expression: *IR.ZirExpr, depth: s32) -> s32 {
    span := expression.span
    first := expression.first_child
    second: s32 = -1
    if first >= 0 && first < function.source.expr_count {
        second = function.source.exprs[first].next_sibling
    }
    third: s32 = -1
    if second >= 0 && second < function.source.expr_count {
        third = function.source.exprs[second].next_sibling
    }
    if third < 0 || third >= function.source.expr_count {
        return Fail(program, span, "VecSlice requires a vector, a low bound and a high bound")
    }
    vector := Expression(program, function, first, depth + 1)
    if program.failed != 0 { return -1 }
    identity := function.values.data[vector]
    element := VecElement(program, identity)
    if element < 0 { return Fail(program, span, "VecSlice requires an owned vector") }
    pointer := PointerType(program, element, span)
    data := Indexed(program, function, LirOp.Extract, pointer, *vector, 1, 0, span)
    count := Indexed(program, function, LirOp.Extract, 8, *vector, 1, 1, span)
    low := Convert(program, function,
        Expression(program, function, second, depth + 1), 8, span)
    high := Convert(program, function,
        Expression(program, function, third, depth + 1), 8, span)
    result_type := Type(program, function, expression.type, span)
    if program.failed != 0 { return -1 }
    address_operands := cast(*s32)Allocate(program, 4, size_of(s32))
    if address_operands == null { return -1 }
    address_operands[0] = data
    address_operands[1] = low
    address_operands[2] = high
    address_operands[3] = count
    selected := Emit(program, function, LirOp.ElementAddress, pointer,
                     address_operands, 4, -1, span)
    count_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if count_operands == null { return -1 }
    count_operands[0] = high
    count_operands[1] = low
    selected_count := Emit(program, function, LirOp.Subtract, 8, count_operands, 2, -1, span)
    fields := cast(*s32)Allocate(program, 2, size_of(s32))
    if fields == null { return -1 }
    fields[0] = selected
    fields[1] = selected_count
    return Emit(program, function, LirOp.Aggregate, result_type, fields, 2, -1, span)
}


// VecPush, VecClear and VecFree on a vector place. Growth follows the C
// runtime: capacity 0 becomes 8, a full vector doubles, and a refused
// allocation leaves the vector unchanged and gives false.
VectorCall :: (program: *AssemblyProgram, function: *AssemblyFunction,
               expression: *IR.ZirExpr, depth: s32) -> s32 {
    span := expression.span
    first := expression.first_child
    if first < 0 || first >= function.source.expr_count {
        return Fail(program, span, "vector operation requires a vector place")
    }
    identity := Type(program, function, function.source.exprs[first].type, span)
    element := VecElement(program, identity)
    if program.failed != 0 { return -1 }
    if element < 0 { return Fail(program, span, "vector operation requires an owned vector") }
    pointer := PointerType(program, element, span)
    push := IR.CText(expression.name) == "VecPush"
    item: s32 = -1
    if push == true {
        second := function.source.exprs[first].next_sibling
        if second < 0 || second >= function.source.expr_count {
            return Fail(program, span, "VecPush requires a value")
        }
        item = Convert(program, function,
            Expression(program, function, second, depth + 1), element, span)
    }
    place := AssemblyVecPlace.{address = -1, local = null}
    current := VecRead(program, function, first, identity, *place, span)
    if program.failed != 0 { return -1 }
    zero := Constant(program, function, 8, 0, span)
    if IR.CText(expression.name) == "VecClear" {
        DropElements(program, function, current, identity, span, 0)
        operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if operands == null { return -1 }
        operands[0] = current
        operands[1] = zero
        VecWrite(program, function, *place,
            Indexed(program, function, LirOp.Insert, identity, operands, 2, 1, span), span)
        return -1
    }
    if IR.CText(expression.name) == "VecFree" {
        DropValue(program, function, current, identity, span, 0)
        VecWrite(program, function, *place, Zero(program, function, identity, span, 0), span)
        return -1
    }
    data := Indexed(program, function, LirOp.Extract, pointer, *current, 1, 0, span)
    count := Indexed(program, function, LirOp.Extract, 8, *current, 1, 1, span)
    capacity := Indexed(program, function, LirOp.Extract, 8, *current, 1, 2, span)
    // The vector travels through the branches as one unnamed binding.
    base := function.bindings.count
    Carry(program, function, identity, current)
    live := base + 1
    before := Snapshot(program, function, live)
    joined := cast(*AssemblyBinding)Allocate(program, cast(usize)(live + 1),
                                             size_of(AssemblyBinding))
    if program.failed != 0 || before == null || joined == null { return -1 }
    memcpy(cast(*void)joined, cast(*void)before,
           cast(usize)live * size_of(AssemblyBinding))
    joined[live] = AssemblyBinding.{name = null, type = 1, value = -1, storage_type = -1}
    grow := Block(program, function, before, live)
    grown := Block(program, function, before, live)
    refused := Block(program, function, before, live)
    store := Block(program, function, before, live)
    done := Block(program, function, joined, live + 1)
    if program.failed != 0 { return -1 }
    full_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if full_operands == null { return -1 }
    full_operands[0] = count
    full_operands[1] = capacity
    full := Emit(program, function, LirOp.GreaterEqual, 1, full_operands, 2, -1, span)
    Branch(program, function, full, grow, store, live, span)

    Enter(function, grow, before, live)
    empty_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if empty_operands == null { return -1 }
    empty_operands[0] = capacity
    empty_operands[1] = zero
    empty := Emit(program, function, LirOp.Equal, 1, empty_operands, 2, -1, span)
    initial_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if initial_operands == null { return -1 }
    initial_operands[0] = Emit(program, function, LirOp.Convert, 8, *empty, 1, -1, span)
    initial_operands[1] = Constant(program, function, 8, 8, span)
    initial := Emit(program, function, LirOp.Multiply, 8, initial_operands, 2, -1, span)
    doubled_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if doubled_operands == null { return -1 }
    doubled_operands[0] = capacity
    doubled_operands[1] = capacity
    doubled := Emit(program, function, LirOp.Add, 8, doubled_operands, 2, -1, span)
    next_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if next_operands == null { return -1 }
    next_operands[0] = doubled
    next_operands[1] = initial
    next := Emit(program, function, LirOp.Add, 8, next_operands, 2, -1, span)
    resize_operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if resize_operands == null { return -1 }
    resize_operands[0] = data
    resize_operands[1] = capacity
    resize_operands[2] = next
    moved := Emit(program, function, LirOp.Resize, pointer, resize_operands, 3, -1, span)
    failed_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if failed_operands == null { return -1 }
    failed_operands[0] = moved
    failed_operands[1] = Emit(program, function, LirOp.Null, pointer, null, 0, -1, span)
    failed := Emit(program, function, LirOp.Equal, 1, failed_operands, 2, -1, span)
    Branch(program, function, failed, refused, grown, live, span)

    Enter(function, grown, before, live)
    data_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if data_operands == null { return -1 }
    data_operands[0] = function.bindings.data[base].value
    data_operands[1] = moved
    with_data := Indexed(program, function, LirOp.Insert, identity, data_operands, 2, 0, span)
    capacity_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if capacity_operands == null { return -1 }
    capacity_operands[0] = with_data
    capacity_operands[1] = next
    function.bindings.data[base].value = Indexed(program, function, LirOp.Insert,
                                                 identity, capacity_operands, 2, 2, span)
    Jump(program, function, store, live, span)

    Enter(function, refused, before, live)
    Carry(program, function, 1, Constant(program, function, 1, 0, span))
    Jump(program, function, done, live + 1, span)

    Enter(function, store, before, live)
    vector := function.bindings.data[base].value
    here := Indexed(program, function, LirOp.Extract, pointer, *vector, 1, 0, span)
    used := Indexed(program, function, LirOp.Extract, 8, *vector, 1, 1, span)
    more_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if more_operands == null { return -1 }
    more_operands[0] = used
    more_operands[1] = Constant(program, function, 8, 1, span)
    more := Emit(program, function, LirOp.Add, 8, more_operands, 2, -1, span)
    slot_operands := cast(*s32)Allocate(program, 3, size_of(s32))
    if slot_operands == null { return -1 }
    slot_operands[0] = here
    slot_operands[1] = used
    slot_operands[2] = more
    slot := Emit(program, function, LirOp.ElementAddress, pointer, slot_operands, 3, -1, span)
    store_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if store_operands == null { return -1 }
    store_operands[0] = slot
    store_operands[1] = item
    Emit(program, function, LirOp.Store, 0, store_operands, 2, -1, span)
    count_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if count_operands == null { return -1 }
    count_operands[0] = vector
    count_operands[1] = more
    function.bindings.data[base].value = Indexed(program, function, LirOp.Insert,
                                                 identity, count_operands, 2, 1, span)
    Carry(program, function, 1, Constant(program, function, 1, 1, span))
    Jump(program, function, done, live + 1, span)

    if program.failed != 0 { return -1 }
    Enter(function, done, joined, live + 1)
    final := function.bindings.data[base].value
    pushed := function.bindings.data[base + 1].value
    function.bindings.count = base
    VecWrite(program, function, *place, final, span)
    return pushed
}


// The checker marks each move. A move reads the owned value and leaves its
// source empty, as the C emitter's clear_owned_value does, so the source's
// drop at scope exit frees nothing.
Expression :: (program: *AssemblyProgram, function: *AssemblyFunction, root: s32,
               depth: s32) -> s32 {
    saved := function.checking
    if root >= 0 && root < function.source.expr_count && function.source.exprs[root].checked != 0 {
        function.checking = true
    }
    value := ExpressionValue(program, function, root, depth)
    function.checking = saved
    if program.failed != 0 || value < 0 || root < 0 ||
       root >= function.source.expr_count || function.source.exprs[root].is_move == 0 {
        return value
    }
    MoveOut(program, function, root, function.values.data[value],
            function.source.exprs[root].span)
    return value
}


// Lane-kind predicates and shapes shared with include/ziran_simd.h.
ziKBits :: (kind: s32) -> s32 {
    if kind == ZI_K_F32 { return 32 }
    if kind == ZI_K_F64 { return 64 }
    return 8 << (kind / 2)
}

ziKSigned :: (kind: s32) -> bool {
    return kind <= ZI_K_S64 && (kind & 1) == 1
}

ziKFloat :: (kind: s32) -> bool {
    return kind >= ZI_K_F32
}

ziKMask :: (kind: s32) -> u64 {
    width := ziKBits(kind)
    if width >= 64 { return cast(u64)-1 }
    return (cast(u64)1 << cast(u64)width) - cast(u64)1
}


// Vector operations (`Simd.Add(a, b)`, checked as zi_simd_add) on vectors
// lowered as arrays of lanes. Each lane is taken out, operated on with
// scalar instructions that give zi_ref's result (include/ziran_simd.h), and
// the lanes are gathered again. The lane code has no branches: a choice
// between two lanes is made with a mask of all ones or zero.
AssemblySimd :: struct {
    program: *AssemblyProgram
    function: *AssemblyFunction
    span: IR.ZirSourceSpan
}

// One vector operand: its value, lane kind (ZI_K_*) and lanes.
AssemblyLanes :: struct {
    value: s32
    kind: s32
    count: s32
    lanes: [32]s32
}

SimdType :: (s: *AssemblySimd, value: s32) -> s32 {
    if value < 0 || s.program.failed != 0 { return -1 }
    return s.function.values.data[value]
}

SimdOne :: (s: *AssemblySimd, op: LIR.LirOp, type: s32, value: s32) -> s32 {
    if value < 0 { return -1 }
    return Emit(s.program, s.function, op, type, *value, 1, -1, s.span)
}

SimdTwo :: (s: *AssemblySimd, op: LIR.LirOp, type: s32, left: s32, right: s32) -> s32 {
    if left < 0 || right < 0 { return -1 }
    operands := cast(*s32)Allocate(s.program, 2, size_of(s32))
    if operands == null { return -1 }
    operands[0] = left
    operands[1] = right
    return Emit(s.program, s.function, op, type, operands, 2, -1, s.span)
}

SimdK :: (s: *AssemblySimd, type: s32, bits: u64) -> s32 {
    return Constant(s.program, s.function, type, bits, s.span)
}

SimdCast :: (s: *AssemblySimd, value: s32, type: s32) -> s32 {
    return Convert(s.program, s.function, value, type, s.span)
}

// The lowered scalar type of lane kind `kind`.
SimdLaneType :: (s: *AssemblySimd, kind: s32) -> s32 {
    if ziKFloat(kind) == true {
        name: *u8 = SVC.Keep("float64")
        if kind == ZI_K_F32 { name = SVC.Keep("float32") }
        return TypeIn(s.program, s.function.module, name, s.span, 0)
    }
    sign: s32 = ifx ziKSigned(kind) == true then 0 else 1
    return 2 + kind / 2 * 2 + sign
}

// The lane kind of lowered scalar type `type`, or -1.
SimdKind :: (s: *AssemblySimd, type: s32) -> s32 {
    if type < 0 { return -1 }
    lane := TypeAt(s.program, type)
    if lane.kind == LirTypeKind.Float {
        float_kind: s32 = ifx lane.bits == 32 then ZI_K_F32 else ZI_K_F64
        return float_kind
    }
    if lane.kind != LirTypeKind.Integer { return -1 }
    base: s32 = ifx lane.bits == 8 then 0 else ifx lane.bits == 16 then 2 else ifx lane.bits == 32 then 4 else 6
    sign: s32 = ifx lane.is_signed == true then 1 else 0
    return base + sign
}

SimdUnsigned :: (kind: s32) -> s32 {
    return UnsignedOf(ziKBits(kind))
}

// A lane's bits as an unsigned integer of its width, and back.
SimdBits :: (s: *AssemblySimd, value: s32, kind: s32) -> s32 {
    if ziKFloat(kind) == true {
        return SimdOne(s, LirOp.Bitcast, SimdUnsigned(kind), value)
    }
    return SimdCast(s, value, SimdUnsigned(kind))
}

SimdUnbits :: (s: *AssemblySimd, bits: s32, kind: s32) -> s32 {
    type := SimdLaneType(s, kind)
    if ziKFloat(kind) == true {
        return SimdOne(s, LirOp.Bitcast, type, bits)
    }
    return SimdCast(s, bits, type)
}

// `condition ? yes : no` for two lanes of one type.
SimdPick :: (s: *AssemblySimd, condition: s32, yes: s32, no: s32) -> s32 {
    kind := SimdKind(s, SimdType(s, yes))
    if kind < 0 || condition < 0 || no < 0 { return -1 }
    bits := SimdUnsigned(kind)
    mask := SimdOne(s, LirOp.Negate, bits, SimdCast(s, condition, bits))
    x := SimdBits(s, yes, kind)
    y := SimdBits(s, no, kind)
    mixed := SimdTwo(s, LirOp.BitAnd, bits, SimdTwo(s, LirOp.BitXor, bits, x, y), mask)
    return SimdUnbits(s, SimdTwo(s, LirOp.BitXor, bits, y, mixed), kind)
}

// A compare result as a lane of all ones or zero of type `type`.
SimdMask :: (s: *AssemblySimd, condition: s32, type: s32) -> s32 {
    return SimdOne(s, LirOp.Negate, type, SimdCast(s, condition, type))
}

// A float constant of lane kind `kind`.
SimdReal :: (s: *AssemblySimd, kind: s32, value: float64) -> s32 {
    width: s32 = ifx kind == ZI_K_F32 then 32 else 64
    return SimdK(s, SimdLaneType(s, kind), FloatBits(value, width))
}

// A shift count, read as unsigned 64 bits, is inside the lane when it is
// below the width; outside, the shift gives zero or, shifting a signed lane
// right, its sign (zi_shl1, zi_shr1). `safe` is a count the shift accepts.
SimdShiftCount :: (s: *AssemblySimd, count: s32, right: bool, kind: s32,
                   inside: *s32, safe: *s32) {
    fill := right == true && ziKSigned(kind) == true
    within := SimdTwo(s, LirOp.Less, 1, count, SimdK(s, 9, cast(u64)ziKBits(kind)))
    limit: u64 = 0
    if fill == true { limit = cast(u64)ziKBits(kind) - cast(u64)1 }
    accepted := SimdPick(s, within, count, SimdK(s, 9, limit))
    <<inside = within
    <<safe = accepted
}

SimdShift :: (s: *AssemblySimd, value: s32, right: bool, kind: s32,
              inside: s32, safe: s32) -> s32 {
    type := SimdLaneType(s, kind)
    op := LirOp.ShiftLeft
    if right == true { op = LirOp.ShiftRight }
    shifted := SimdTwo(s, op, type, value, safe)
    if right == true && ziKSigned(kind) == true { return shifted }
    return SimdPick(s, inside, shifted, SimdK(s, type, 0))
}

SimdShiftBy :: (s: *AssemblySimd, value: s32, right: bool, kind: s32,
                count: s32) -> s32 {
    within: s32 = -1
    accepted: s32 = -1
    SimdShiftCount(s, count, right, kind, *within, *accepted)
    return SimdShift(s, value, right, kind, within, accepted)
}

// `value`, a lane wider than kind `kind`, clamped to that kind's range and
// narrowed (zi_clamp, zi_clampu).
SimdClamp :: (s: *AssemblySimd, value: s32, kind: s32) -> s32 {
    type := SimdType(s, value)
    if type < 0 { return -1 }
    wide_signed := TypeAt(s.program, type).is_signed
    high: u64 = ziKMask(kind)
    if ziKSigned(kind) == true { high = ziKMask(kind) >> cast(u64)1 }
    limit := SimdK(s, type, high)
    value = SimdPick(s, SimdTwo(s, LirOp.Greater, 1, value, limit), limit, value)
    if wide_signed == true {
        low: u64 = 0
        if ziKSigned(kind) == true { low = ~high }
        bound := SimdK(s, type, low)
        value = SimdPick(s, SimdTwo(s, LirOp.Less, 1, value, bound), bound, value)
    }
    return SimdCast(s, value, SimdLaneType(s, kind))
}

// zi_float_to_int: NaN is zero, a value past either limit is that limit,
// and the rest truncate toward zero. Only a value strictly inside is
// converted, since a conversion out of range fails.
SimdFloatToInt :: (s: *AssemblySimd, value: s32, from: s32, to: s32) -> s32 {
    type := SimdLaneType(s, to)
    wide := ziKBits(to) == 64
    limit: float64 = 4294967296.0
    if wide == true { limit = 18446744073709551616.0 }
    low: float64 = 0.0
    if ziKSigned(to) == true {
        limit = 2147483648.0
        if wide == true { limit = 9223372036854775808.0 }
        low = -limit
    }
    zero := SimdReal(s, from, 0.0)
    top := SimdReal(s, from, limit)
    bottom := SimdReal(s, from, low)
    within := SimdPick(s, SimdTwo(s, LirOp.Less, 1, value, top), value, zero)
    within = SimdPick(s, SimdTwo(s, LirOp.Greater, 1, within, bottom), within, zero)
    result := SimdCast(s, within, type)
    high: u64 = ziKMask(to)
    if ziKSigned(to) == true { high = ziKMask(to) >> cast(u64)1 }
    result = SimdPick(s, SimdTwo(s, LirOp.GreaterEqual, 1, value, top),
        SimdK(s, type, high), result)
    if ziKSigned(to) == true {
        result = SimdPick(s, SimdTwo(s, LirOp.LessEqual, 1, value, bottom),
            SimdK(s, type, ~high), result)
    }
    return result
}

// Unsigned parts of `from` bits regrouped into parts of `to` bits, low
// part first, as little-endian memory holds them.
SimdRegroup :: (s: *AssemblySimd, parts: *s32, count: s32, from: s32, to: s32,
                out: *s32) -> s32 {
    total := count * from / to
    from_type := UnsignedOf(from)
    to_type := UnsignedOf(to)
    if from >= to {
        ratio := from / to
        part: s32 = 0
        while part < count {
            piece: s32 = 0
            while piece < ratio {
                source := parts[part]
                if piece != 0 {
                    source = SimdTwo(s, LirOp.ShiftRight, from_type, parts[part],
                        SimdK(s, 9, cast(u64)(piece * to)))
                }
                out[part * ratio + piece] = SimdCast(s, source, to_type)
                piece = piece + 1
            }
            part = part + 1
        }
        return total
    }
    ratio := to / from
    part: s32 = 0
    while part < total {
        value: s32 = -1
        piece: s32 = 0
        while piece < ratio {
            widened := SimdCast(s, parts[part * ratio + piece], to_type)
            if piece != 0 {
                widened = SimdTwo(s, LirOp.ShiftLeft, to_type, widened,
                    SimdK(s, 9, cast(u64)(piece * from)))
            }
            if piece != 0 {
                value = SimdTwo(s, LirOp.BitOr, to_type, value, widened)
            } else {
                value = widened
            }
            piece = piece + 1
        }
        out[part] = value
        part = part + 1
    }
    return total
}

// The lanes of a vector as unsigned parts of `bits` bits.
SimdParts :: (s: *AssemblySimd, vector: *AssemblyLanes, bits: s32,
              out: *s32) -> s32 {
    lanes: [32]s32
    lane: s32 = 0
    while lane < vector.count {
        lanes[lane] = SimdBits(s, vector.lanes[lane], vector.kind)
        lane = lane + 1
    }
    return SimdRegroup(s, *lanes[0], vector.count, ziKBits(vector.kind), bits, out)
}

// `count` unsigned parts of `bits` bits as `lanes` lanes of kind `kind`.
SimdFromParts :: (s: *AssemblySimd, parts: *s32, count: s32, bits: s32,
                  kind: s32, lanes: *s32) {
    grouped: [32]s32
    total := SimdRegroup(s, parts, count, bits, ziKBits(kind), *grouped[0])
    lane: s32 = 0
    while lane < total {
        lanes[lane] = SimdUnbits(s, grouped[lane], kind)
        lane = lane + 1
    }
}

// The value of a constant operand: it must lower to a constant.
SimdConstant :: (s: *AssemblySimd, value: s32, out: *s64) -> bool {
    if value < 0 || s.function.current < 0 { return false }
    block := BlockAt(s.function, s.function.current)
    if block.instructions.count == 0 { return false }
    instructions := block.instructions.data
    last := instructions[block.instructions.count - 1]
    if last.result != value || last.op != LirOp.Constant { return false }
    constants := cast(*LIR.LirConstant)s.program.constants.data
    constant := constants[last.symbol]
    type := TypeAt(s.program, constant.type)
    bits := constant.bits
    if type.is_signed == true && type.bits < 64 && ((bits >> cast(u64)(type.bits - 1)) & cast(u64)1) == cast(u64)1 {
        bits = bits | ~((cast(u64)1 << cast(u64)type.bits) - cast(u64)1)
    }
    <<out = cast(s64)bits
    return true
}

// A vector operand; its lanes are taken out unless `lanes` is zero.
SimdVector :: (s: *AssemblySimd, value: s32, vector: *AssemblyLanes,
               lanes: bool) -> bool {
    type := SimdType(s, value)
    if type < 0 { return false }
    shape := TypeAt(s.program, type)
    if shape.kind != LirTypeKind.Array || shape.count > 32 ||
       SimdKind(s, shape.element) < 0 { return false }
    vector.value = value
    vector.kind = SimdKind(s, shape.element)
    vector.count = cast(s32)shape.count
    if lanes == true {
        lane: s32 = 0
        while lane < vector.count {
            vector.lanes[lane] = Indexed(s.program, s.function, LirOp.Extract,
                shape.element, *value, 1, cast(u64)lane, s.span)
            lane = lane + 1
        }
    }
    return s.program.failed == 0
}

// The checked data pointer and count of a string or slice memory operand.
// A pointer has no count of its own: `length` is then -1, and each lane is
// reached as the last element of a view one past it, which the engine
// checks against the storage the pointer reaches, as the portable engine does.
SimdView :: (s: *AssemblySimd, view: s32, lane_type: s32,
             data: *s32, length: *s32) -> bool {
    type := SimdType(s, view)
    if type < 0 { return false }
    pointer := TypeAt(s.program, type)
    if pointer.kind == LirTypeKind.Pointer && pointer.element == lane_type {
        <<data = view
        <<length = -1
        return true
    }
    if ViewElement(s.program, type) != lane_type { return false }
    <<data = Indexed(s.program, s.function, LirOp.Extract,
        PointerType(s.program, lane_type, s.span), *view, 1, 0, s.span)
    <<length = Indexed(s.program, s.function, LirOp.Extract, 8, *view, 1, 1, s.span)
    return true
}


// Load, LoadLow, Store, StoreLow and Gather. Every address is formed, and
// checked against the view, before any lane is read or written, so an access
// past the end fails before it changes memory. A fixed array is read through
// a checked dynamic index.
SimdMemory :: (s: *AssemblySimd, op: *SimdOp, roots: *s32, count: s32,
               type: s32, depth: s32) -> s32 {
    program := s.program
    function := s.function
    store := op.shape == SimdShape.Store
    gather := op.shape == SimdShape.Gather
    wanted: s32 = 2
    if store == true { wanted = 3 }
    if count != wanted {
        return Fail(program, s.span, "invalid checked vector memory operation")
    }
    // Indices are unsigned, so a negative one is past the end and fails as
    // an out-of-bounds access.
    memory := Expression(program, function, roots[0], depth + 1)
    at: s32 = -1
    if gather == false {
        at = SimdCast(s, Expression(program, function, roots[1], depth + 1), 9)
    }
    vector := AssemblyLanes.{}
    if store == true || gather == true {
        index: s32 = 1
        if store == true { index = 2 }
        value := Expression(program, function, roots[index], depth + 1)
        if program.failed != 0 { return -1 }
        if SimdVector(s, value, *vector, true) == false {
            return Fail(program, s.span, "a vector memory operation needs a lowered vector")
        }
    }
    if program.failed != 0 { return -1 }
    vector_type := type
    if store == true { vector_type = SimdType(s, vector.value) }
    shape := TypeAt(program, vector_type)
    if shape.kind != LirTypeKind.Array {
        return Fail(program, s.span, "a vector memory operation needs a lowered vector")
    }
    lanes := cast(s32)shape.count
    lane_type := shape.element
    low := op.id == ZI_OP_LOAD_LOW || op.id == ZI_OP_STORE_LOW
    reach := lanes
    if low == true { reach = 64 / ziKBits(SimdKind(s, lane_type)) }
    indices: [32]s32
    lane: s32 = 0
    while lane < reach {
        if gather == true {
            indices[lane] = SimdCast(s, vector.lanes[lane], 9)
        } else if lane == 0 {
            indices[lane] = at
        } else {
            indices[lane] = SimdTwo(s, LirOp.Add, 9, at, SimdK(s, 9, cast(u64)lane))
        }
        lane = lane + 1
    }
    values: [32]s32
    held := TypeAt(program, SimdType(s, memory))
    if held.kind == LirTypeKind.Array && store == false {
        if held.element != lane_type {
            return Fail(program, s.span, "a vector load needs memory of the lane type")
        }
        lane = 0
        while lane < reach {
            pair := cast(*s32)Allocate(program, 2, size_of(s32))
            if pair == null { return -1 }
            pair[0] = memory
            pair[1] = indices[lane]
            values[lane] = Indexed(program, function, LirOp.Extract, lane_type,
                                   pair, 2, 0, s.span)
            lane = lane + 1
        }
    } else {
        data: s32 = -1
        length: s32 = -1
        if SimdView(s, memory, lane_type, *data, *length) == false {
            return Fail(program, s.span, "a vector memory operation needs a slice, string, array or pointer of the lane type")
        }
        pointer := PointerType(program, lane_type, s.span)
        addresses: [32]s32
        lane = 0
        while lane < reach {
            parts := cast(*s32)Allocate(program, 3, size_of(s32))
            if parts == null { return -1 }
            parts[0] = data
            parts[1] = indices[lane]
            if length < 0 {
                parts[2] = SimdTwo(s, LirOp.Add, 9, indices[lane], SimdK(s, 9, 1))
            } else {
                parts[2] = length
            }
            addresses[lane] = Emit(program, function, LirOp.ElementAddress,
                                   pointer, parts, 3, -1, s.span)
            lane = lane + 1
        }
        if store == true {
            lane = 0
            while lane < reach {
                pair := cast(*s32)Allocate(program, 2, size_of(s32))
                if pair == null { return -1 }
                pair[0] = addresses[lane]
                pair[1] = vector.lanes[lane]
                Emit(program, function, LirOp.Store, 0, pair, 2, -1, s.span)
                lane = lane + 1
            }
            return -1
        }
        lane = 0
        while lane < reach {
            values[lane] = SimdOne(s, LirOp.Load, lane_type, addresses[lane])
            lane = lane + 1
        }
    }
    lane = reach
    while lane < lanes {
        values[lane] = SimdK(s, lane_type, 0)
        lane = lane + 1
    }
    if program.failed != 0 { return -1 }
    return Emit(program, function, LirOp.Aggregate, type, *values[0], lanes, -1, s.span)
}


INT64_MIN :: -9223372036854775807 - 1

Simd :: (program: *AssemblyProgram, function: *AssemblyFunction,
         expression: *IR.ZirExpr, type: s32, depth: s32) -> s32 {
    context := AssemblySimd.{program = program, function = function, span = expression.span}
    s := *context
    op := CSimdOpChecked(expression.name)
    if op == null { return Fail(program, s.span, "unknown vector operation") }
    roots: [33]s32
    count: s32 = 0
    child := expression.first_child
    // Checked ZIR names the result type in the call's own type; a type
    // operand that is still listed is skipped.
    named := ZirVector.{}
    if op.type_argument != 0 && child >= 0 && child < function.source.expr_count &&
       function.source.exprs[child].kind == ZirExprKind.IDENT &&
       CVectorType(function.source.exprs[child].name, *named) != 0 {
        child = function.source.exprs[child].next_sibling
    }
    while child >= 0 && child < function.source.expr_count {
        if count == 33 {
            return Fail(program, s.span, "too many vector operands")
        }
        roots[count] = child
        count = count + 1
        child = function.source.exprs[child].next_sibling
    }
    if op.shape == SimdShape.Load || op.shape == SimdShape.Store || op.shape == SimdShape.Gather {
        return SimdMemory(s, op, *roots[0], count, type, depth)
    }
    // Operands in order: vectors, constants and scalar lane values.
    vectors: [3]AssemblyLanes
    scalars: [33]s32
    k: [33]s64
    vector_count: s32 = 0
    scalar_count: s32 = 0
    index: s32 = 0
    while index < count {
        value := Expression(program, function, roots[index], depth + 1)
        if program.failed != 0 { return -1 }
        take_lanes := op.id != ZI_OP_LANE && op.id != ZI_OP_WITH_LANE
        if vector_count < 3 && SimdVector(s, value, *vectors[vector_count], take_lanes) == true {
            vector_count = vector_count + 1
            index = index + 1
            continue
        }
        if SimdConstant(s, value, *k[scalar_count]) == false {
            k[scalar_count] = INT64_MIN
        }
        scalars[scalar_count] = value
        scalar_count = scalar_count + 1
        index = index + 1
    }
    if program.failed != 0 { return -1 }
    if op.shape == SimdShape.Count {
        // A native vector here is one block: Lanes is its lanes, Blocks 1.
        if scalar_count == 1 { return SimdCast(s, scalars[0], type) }
        return SimdK(s, type, 1)
    }
    result := TypeAt(program, type)
    rn: s32 = 1
    if result.kind == LirTypeKind.Array { rn = cast(s32)result.count }
    rt := type
    if result.kind == LirTypeKind.Array { rt = result.element }
    r := SimdKind(s, rt)
    out: [32]s32
    id := op.id
    if rn > 32 {
        return Fail(program, s.span, "vector has more lanes than the portable lowering handles")
    }
    if id == ZI_OP_ZERO || id == ZI_OP_SPLAT || id == ZI_OP_MAKE {
        wanted: s32 = rn
        if id == ZI_OP_SPLAT { wanted = 1 }
        if id != ZI_OP_ZERO && scalar_count != wanted {
            return Fail(program, s.span, "invalid checked vector construction")
        }
        lane: s32 = 0
        while lane < rn {
            if id == ZI_OP_ZERO {
                out[lane] = SimdK(s, rt, 0)
            } else if lane != 0 && id == ZI_OP_SPLAT {
                out[lane] = out[0]
            } else {
                source: s32 = lane
                if id == ZI_OP_SPLAT { source = 0 }
                out[lane] = SimdCast(s, scalars[source], rt)
            }
            lane = lane + 1
        }
        return Emit(program, function, LirOp.Aggregate, type, *out[0], rn, -1, s.span)
    }
    if vector_count < 1 {
        return Fail(program, s.span, "this vector operation needs a vector operand")
    }
    a := *vectors[0]
    b: *AssemblyLanes = null
    if vector_count > 1 { b = *vectors[1] }
    c: *AssemblyLanes = null
    if vector_count > 2 { c = *vectors[2] }
    ak := a.kind
    an := a.count
    at := SimdLaneType(s, ak)
    blocks: s32 = 1
    if an * ziKBits(ak) / 8 > 16 { blocks = 2 }
    per := an / blocks
    rper := rn / blocks
    needs_b := op.shape == SimdShape.Binary || op.shape == SimdShape.Compare ||
        op.shape == SimdShape.ShiftLanes || op.shape == SimdShape.Align ||
        op.shape == SimdShape.Narrow || op.shape == SimdShape.MulWide ||
        op.shape == SimdShape.Madd || op.shape == SimdShape.MaddSat ||
        op.shape == SimdShape.Sad || op.shape == SimdShape.ByteShuffle ||
        op.shape == SimdShape.Combine || op.shape == SimdShape.Select
    if (needs_b == true && b == null) || (op.shape == SimdShape.Select && c == null) {
        return Fail(program, s.span, "invalid checked vector operands")
    }
    literal := scalar_count > 0 && k[0] != INT64_MIN
    if id == ZI_OP_LANE || id == ZI_OP_WITH_LANE {
        if literal == false || k[0] < 0 || k[0] >= an ||
           (id == ZI_OP_WITH_LANE && scalar_count != 2) {
            return Fail(program, s.span, "a vector lane is chosen by a constant inside the vector")
        }
        if id == ZI_OP_LANE {
            return SimdCast(s, Indexed(program, function, LirOp.Extract, at,
                *a.value, 1, cast(u64)k[0], s.span), type)
        }
        pair := cast(*s32)Allocate(program, 2, size_of(s32))
        if pair == null { return -1 }
        pair[0] = a.value
        pair[1] = SimdCast(s, scalars[1], at)
        return Indexed(program, function, LirOp.Insert, SimdType(s, a.value),
                       pair, 2, cast(u64)k[0], s.span)
    }
    if id == ZI_OP_ALL_ZERO {
        any := SimdBits(s, a.lanes[0], ak)
        lane := 1
        while lane < an {
            any = SimdTwo(s, LirOp.BitOr, SimdUnsigned(ak), any,
                          SimdBits(s, a.lanes[lane], ak))
            lane = lane + 1
        }
        return SimdTwo(s, LirOp.Equal, 1, any, SimdK(s, SimdUnsigned(ak), 0))
    }
    if id == ZI_OP_REDUCE_ADD {
        sum := a.lanes[0]
        lane := 1
        while lane < an {
            sum = SimdTwo(s, LirOp.Add, at, sum, a.lanes[lane])
            lane = lane + 1
        }
        return SimdCast(s, sum, type)
    }
    if id == ZI_OP_REDUCE_MIN || id == ZI_OP_REDUCE_MAX || id == ZI_OP_REDUCE_MAX_INDEX {
        // The first lane of the extreme value wins.
        best := a.lanes[0]
        index := SimdK(s, 8, 0)
        lane := 1
        while lane < an {
            op := LirOp.Greater
            if id == ZI_OP_REDUCE_MIN { op = LirOp.Less }
            better := SimdTwo(s, op, 1, a.lanes[lane], best)
            best = SimdPick(s, better, a.lanes[lane], best)
            if id == ZI_OP_REDUCE_MAX_INDEX {
                index = SimdPick(s, better, SimdK(s, 8, cast(u64)lane), index)
            }
            lane = lane + 1
        }
        chosen := best
        if id == ZI_OP_REDUCE_MAX_INDEX { chosen = index }
        return SimdCast(s, chosen, type)
    }
    if result.kind != LirTypeKind.Array || r < 0 {
        return Fail(program, s.span, "invalid checked vector result")
    }
    if id == ZI_OP_ADD || id == ZI_OP_SUB || id == ZI_OP_MUL || id == ZI_OP_DIV {
        scalar := LirOp.Add
        if id == ZI_OP_SUB { scalar = LirOp.Subtract }
        if id == ZI_OP_MUL { scalar = LirOp.Multiply }
        if id == ZI_OP_DIV { scalar = LirOp.Divide }
        lane := 0
        while lane < an {
            out[lane] = SimdTwo(s, scalar, at, a.lanes[lane], b.lanes[lane])
            lane = lane + 1
        }
    } else if id == ZI_OP_ADD_SAT || id == ZI_OP_SUB_SAT {
        lane := 0
        while lane < an {
            op := LirOp.Subtract
            if id == ZI_OP_ADD_SAT { op = LirOp.Add }
            out[lane] = SimdClamp(s, SimdTwo(s, op, 6,
                SimdCast(s, a.lanes[lane], 6), SimdCast(s, b.lanes[lane], 6)), ak)
            lane = lane + 1
        }
    } else if id == ZI_OP_MIN || id == ZI_OP_MAX {
        // Min is a < b ? a : b and Max a > b ? a : b, so floats take b
        // when either is NaN.
        lane := 0
        while lane < an {
            op := LirOp.Greater
            if id == ZI_OP_MIN { op = LirOp.Less }
            out[lane] = SimdPick(s, SimdTwo(s, op, 1, a.lanes[lane], b.lanes[lane]),
                a.lanes[lane], b.lanes[lane])
            lane = lane + 1
        }
    } else if id == ZI_OP_AVG {
        lane := 0
        while lane < an {
            sum := SimdTwo(s, LirOp.Add, 7, SimdCast(s, a.lanes[lane], 7),
                SimdCast(s, b.lanes[lane], 7))
            sum = SimdTwo(s, LirOp.Add, 7, sum, SimdK(s, 7, 1))
            out[lane] = SimdCast(s, SimdTwo(s, LirOp.ShiftRight, 7, sum, SimdK(s, 7, 1)), at)
            lane = lane + 1
        }
    } else if id == ZI_OP_MUL_HIGH || id == ZI_OP_MUL_HIGH_ROUND {
        // The 32-bit product of two 16-bit lanes cannot overflow.
        wide: s32 = 7
        if ziKSigned(ak) == true { wide = 6 }
        lane := 0
        while lane < an {
            product := SimdTwo(s, LirOp.Multiply, wide, SimdCast(s, a.lanes[lane], wide),
                SimdCast(s, b.lanes[lane], wide))
            if id == ZI_OP_MUL_HIGH_ROUND {
                product = SimdTwo(s, LirOp.Add, wide, product, SimdK(s, wide, 0x4000))
            }
            shift: u64 = 15
            if id == ZI_OP_MUL_HIGH { shift = 16 }
            out[lane] = SimdCast(s, SimdTwo(s, LirOp.ShiftRight, wide, product,
                SimdK(s, 7, shift)), at)
            lane = lane + 1
        }
    } else if id == ZI_OP_AND || id == ZI_OP_OR || id == ZI_OP_XOR || id == ZI_OP_AND_NOT {
        lane := 0
        while lane < an {
            right := b.lanes[lane]
            if id == ZI_OP_AND_NOT { right = SimdOne(s, LirOp.BitNot, at, b.lanes[lane]) }
            op := LirOp.BitAnd
            if id == ZI_OP_OR { op = LirOp.BitOr }
            if id == ZI_OP_XOR { op = LirOp.BitXor }
            out[lane] = SimdTwo(s, op, at, a.lanes[lane], right)
            lane = lane + 1
        }
    } else if id == ZI_OP_NOT {
        lane := 0
        while lane < an {
            out[lane] = SimdOne(s, LirOp.BitNot, at, a.lanes[lane])
            lane = lane + 1
        }
    } else if id == ZI_OP_ABS {
        lane := 0
        while lane < an {
            if ziKFloat(ak) == true {
                bits := SimdTwo(s, LirOp.BitAnd, SimdUnsigned(ak),
                    SimdBits(s, a.lanes[lane], ak),
                    SimdK(s, SimdUnsigned(ak), ziKMask(ak) >> cast(u64)1))
                out[lane] = SimdUnbits(s, bits, ak)
            } else {
                out[lane] = SimdPick(s, SimdTwo(s, LirOp.Less, 1, a.lanes[lane], SimdK(s, at, 0)),
                    SimdTwo(s, LirOp.Subtract, at, SimdK(s, at, 0), a.lanes[lane]), a.lanes[lane])
            }
            lane = lane + 1
        }
    } else if id == ZI_OP_NEG {
        // Float negation flips the sign bit; an integer lane wraps.
        lane := 0
        while lane < an {
            if ziKFloat(ak) == true {
                out[lane] = SimdOne(s, LirOp.Negate, at, a.lanes[lane])
            } else {
                out[lane] = SimdTwo(s, LirOp.Subtract, at, SimdK(s, at, 0), a.lanes[lane])
            }
            lane = lane + 1
        }
    } else if id == ZI_OP_SIGN {
        lane := 0
        while lane < an {
            zero := SimdK(s, at, 0)
            kept := SimdPick(s, SimdTwo(s, LirOp.Equal, 1, b.lanes[lane], zero), zero, a.lanes[lane])
            out[lane] = SimdPick(s, SimdTwo(s, LirOp.Less, 1, b.lanes[lane], zero),
                SimdTwo(s, LirOp.Subtract, at, zero, a.lanes[lane]), kept)
            lane = lane + 1
        }
    } else if id == ZI_OP_ABS_DIFF {
        lane := 0
        while lane < an {
            below := SimdTwo(s, LirOp.Less, 1, a.lanes[lane], b.lanes[lane])
            out[lane] = SimdCast(s, SimdPick(s, below,
                SimdTwo(s, LirOp.Subtract, at, b.lanes[lane], a.lanes[lane]),
                SimdTwo(s, LirOp.Subtract, at, a.lanes[lane], b.lanes[lane])), rt)
            lane = lane + 1
        }
    } else if id == ZI_OP_EQ || id == ZI_OP_LT || id == ZI_OP_GT {
        lane := 0
        while lane < an {
            op := LirOp.Greater
            if id == ZI_OP_EQ { op = LirOp.Equal }
            if id == ZI_OP_LT { op = LirOp.Less }
            out[lane] = SimdMask(s, SimdTwo(s, op, 1, a.lanes[lane], b.lanes[lane]), rt)
            lane = lane + 1
        }
    } else if id == ZI_OP_SELECT {
        // The first vector is the mask.
        lane := 0
        while lane < rn {
            unsigned_type := SimdUnsigned(b.kind)
            mask := SimdBits(s, a.lanes[lane], ak)
            yes := SimdBits(s, b.lanes[lane], b.kind)
            no := SimdBits(s, c.lanes[lane], c.kind)
            mixed := SimdTwo(s, LirOp.BitAnd, unsigned_type,
                SimdTwo(s, LirOp.BitXor, unsigned_type, yes, no), mask)
            out[lane] = SimdUnbits(s, SimdTwo(s, LirOp.BitXor, unsigned_type, no, mixed), b.kind)
            lane = lane + 1
        }
    } else if id == ZI_OP_SHL || id == ZI_OP_SHR || id == ZI_OP_SHR_ROUND {
        if scalar_count != 1 {
            return Fail(program, s.span, "a vector shift takes one count")
        }
        right := id != ZI_OP_SHL
        count64 := SimdCast(s, scalars[0], 9)
        inside: s32 = -1
        safe: s32 = -1
        SimdShiftCount(s, count64, right, ak, *inside, *safe)
        inside_less: s32 = -1
        safe_less: s32 = -1
        none: s32 = -1
        if id == ZI_OP_SHR_ROUND {
            // (v + 2^(n-1)) >> n without an intermediate overflow.
            reduced := SimdTwo(s, LirOp.Subtract, 9, count64, SimdK(s, 9, 1))
            SimdShiftCount(s, reduced, true, ak, *inside_less, *safe_less)
            none = SimdTwo(s, LirOp.Equal, 1, count64, SimdK(s, 9, 0))
        }
        lane := 0
        while lane < an {
            out[lane] = SimdShift(s, a.lanes[lane], right, ak, inside, safe)
            if id == ZI_OP_SHR_ROUND {
                half := SimdTwo(s, LirOp.BitAnd, at,
                    SimdShift(s, a.lanes[lane], true, ak, inside_less, safe_less),
                    SimdK(s, at, 1))
                out[lane] = SimdPick(s, none, a.lanes[lane],
                    SimdTwo(s, LirOp.Add, at, out[lane], half))
            }
            lane = lane + 1
        }
    } else if id == ZI_OP_SHL_LANES || id == ZI_OP_SHR_LANES {
        lane := 0
        while lane < an {
            out[lane] = SimdShiftBy(s, a.lanes[lane], id == ZI_OP_SHR_LANES, ak,
                SimdCast(s, SimdBits(s, b.lanes[lane], ak), 9))
            lane = lane + 1
        }
    } else if id == ZI_OP_SHL_BYTES || id == ZI_OP_SHR_BYTES || id == ZI_OP_ALIGN_BYTES {
        // AlignBytes(high, low, n) shifts the 32 bytes low:high right by
        // n in each 128-bit block, as x86 alignr does.
        shift: s32 = -1
        if scalar_count == 1 && literal == true { shift = cast(s32)k[0] }
        if shift < 0 || shift > 16 {
            return Fail(program, s.span, "a byte shift takes a constant count from 0 to 16")
        }
        x: [32]s32
        y: [32]s32
        z: [32]s32
        pick_b := id == ZI_OP_ALIGN_BYTES
        source: *AssemblyLanes = a
        if pick_b == true { source = b }
        bytes := SimdParts(s, source, 8, *x[0])
        if pick_b == true { SimdParts(s, a, 8, *y[0]) }
        at_byte := 0
        while at_byte < bytes {
            base := at_byte & ~15
            offset := shift
            if id == ZI_OP_SHL_BYTES { offset = -shift }
            from := (at_byte & 15) + offset
            if from >= 0 && from < 16 {
                z[at_byte] = x[base + from]
            } else if pick_b == true && from >= 16 && from < 32 {
                z[at_byte] = y[base + from - 16]
            } else {
                z[at_byte] = SimdK(s, 3, 0)
            }
            at_byte = at_byte + 1
        }
        SimdFromParts(s, *z[0], bytes, 8, ak, *out[0])
    } else if id == ZI_OP_WIDEN_LOW || id == ZI_OP_WIDEN_HIGH {
        block := 0
        while block < blocks {
            lane := 0
            while lane < rper {
                from := block * per + lane
                if id == ZI_OP_WIDEN_HIGH { from = block * per + lane + per / 2 }
                out[block * rper + lane] = SimdCast(s, a.lanes[from], rt)
                lane = lane + 1
            }
            block = block + 1
        }
    } else if id == ZI_OP_WIDEN {
        lane := 0
        while lane < rn {
            out[lane] = SimdCast(s, a.lanes[lane], rt)
            lane = lane + 1
        }
    } else if id == ZI_OP_NARROW {
        block := 0
        while block < blocks {
            lane := 0
            while lane < per {
                half := 0
                while half < 2 {
                    from := a
                    if half != 0 { from = b }
                    out[block * rper + half * per + lane] = SimdClamp(s,
                        from.lanes[block * per + lane], r)
                    half = half + 1
                }
                lane = lane + 1
            }
            block = block + 1
        }
    } else if id == ZI_OP_MUL_WIDE_LOW || id == ZI_OP_MUL_WIDE_HIGH {
        block := 0
        while block < blocks {
            lane := 0
            while lane < rper {
                from := block * per + lane
                if id == ZI_OP_MUL_WIDE_HIGH { from = block * per + lane + per / 2 }
                out[block * rper + lane] = SimdTwo(s, LirOp.Multiply, rt,
                    SimdCast(s, a.lanes[from], rt), SimdCast(s, b.lanes[from], rt))
                lane = lane + 1
            }
            block = block + 1
        }
    } else if id == ZI_OP_MADD || id == ZI_OP_MADD_SAT || id == ZI_OP_ADD_PAIRS {
        // Pairs of lanes multiplied (or not) and added in 32 bits; the sums
        // of MulAddPairsSat are clamped to s16.
        wide: s32 = 6
        if id == ZI_OP_ADD_PAIRS { wide = rt }
        lane := 0
        while lane < rn {
            terms: [2]s32
            pair := 0
            while pair < 2 {
                left := SimdCast(s, a.lanes[2 * lane + pair], wide)
                if id == ZI_OP_ADD_PAIRS {
                    terms[pair] = left
                } else {
                    terms[pair] = SimdTwo(s, LirOp.Multiply, wide, left,
                        SimdCast(s, b.lanes[2 * lane + pair], wide))
                }
                pair = pair + 1
            }
            sum := SimdTwo(s, LirOp.Add, wide, terms[0], terms[1])
            if id == ZI_OP_MADD_SAT {
                out[lane] = SimdClamp(s, sum, r)
            } else {
                out[lane] = SimdCast(s, sum, rt)
            }
            lane = lane + 1
        }
    } else if id == ZI_OP_SAD {
        lane := 0
        while lane < rn {
            sum := SimdK(s, rt, 0)
            part := 0
            while part < 8 {
                x := a.lanes[8 * lane + part]
                y := b.lanes[8 * lane + part]
                difference := SimdPick(s, SimdTwo(s, LirOp.Greater, 1, x, y),
                    SimdTwo(s, LirOp.Subtract, at, x, y),
                    SimdTwo(s, LirOp.Subtract, at, y, x))
                sum = SimdTwo(s, LirOp.Add, rt, sum, SimdCast(s, difference, rt))
                part = part + 1
            }
            out[lane] = sum
            lane = lane + 1
        }
    } else if id == ZI_OP_BYTE_SHUFFLE {
        // An index of 16 or more gives zero; the rest pick a byte of their
        // own block through a checked dynamic index.
        lane := 0
        while lane < rn {
            index := SimdCast(s, b.lanes[lane], 8)
            inside := SimdTwo(s, LirOp.Less, 1, index, SimdK(s, 8, 16))
            picked := SimdTwo(s, LirOp.Add, 8, SimdPick(s, inside, index, SimdK(s, 8, 0)),
                SimdK(s, 8, cast(u64)(lane & ~15)))
            pair := cast(*s32)Allocate(program, 2, size_of(s32))
            if pair == null { return -1 }
            pair[0] = a.value
            pair[1] = picked
            byte := Indexed(program, function, LirOp.Extract, at, pair, 2, 0, s.span)
            out[lane] = SimdPick(s, inside, byte, SimdK(s, at, 0))
            lane = lane + 1
        }
    } else if id == ZI_OP_SHUFFLE {
        if scalar_count != per {
            return Fail(program, s.span, "a shuffle takes one constant index for each lane of a block")
        }
        lane := 0
        while lane < per {
            if k[lane] < 0 || k[lane] >= per {
                return Fail(program, s.span, "a shuffle takes constant lane indices within one block")
            }
            lane = lane + 1
        }
        block := 0
        while block < blocks {
            lane := 0
            while lane < per {
                out[block * per + lane] = a.lanes[block * per + cast(s32)k[lane]]
                lane = lane + 1
            }
            block = block + 1
        }
    } else if id == ZI_OP_REINTERPRET {
        parts: [32]s32
        bits := ziKBits(ak)
        if ziKBits(r) < bits { bits = ziKBits(r) }
        total := SimdParts(s, a, bits, *parts[0])
        SimdFromParts(s, *parts[0], total, bits, r, *out[0])
    } else if id == ZI_OP_CONVERT {
        lane := 0
        while lane < an {
            if ziKFloat(ak) == true {
                out[lane] = SimdFloatToInt(s, a.lanes[lane], ak, r)
            } else {
                out[lane] = SimdCast(s, a.lanes[lane], rt)
            }
            lane = lane + 1
        }
    } else if id == ZI_OP_LOW || id == ZI_OP_HIGH {
        lane := 0
        while lane < rn {
            offset := 0
            if id == ZI_OP_HIGH { offset = rn }
            out[lane] = a.lanes[lane + offset]
            lane = lane + 1
        }
    } else if id == ZI_OP_COMBINE {
        lane := 0
        while lane < an {
            out[lane] = a.lanes[lane]
            out[an + lane] = b.lanes[lane]
            lane = lane + 1
        }
    } else if id == ZI_OP_INTERLEAVE_LOW || id == ZI_OP_INTERLEAVE_HIGH {
        block := 0
        while block < blocks {
            lane := 0
            while lane < per / 2 {
                from := block * per + lane
                if id == ZI_OP_INTERLEAVE_HIGH { from = block * per + lane + per / 2 }
                out[block * per + 2 * lane] = a.lanes[from]
                out[block * per + 2 * lane + 1] = b.lanes[from]
                lane = lane + 1
            }
            block = block + 1
        }
    } else {
        return Fail(program, s.span, "this vector operation is not lowered yet")
    }
    if program.failed != 0 { return -1 }
    return Emit(program, function, LirOp.Aggregate, type, *out[0], rn, -1, s.span)
}


// The lowered type of member `name` when `type` is a union, else -1.
UnionMember :: (program: *AssemblyProgram, function: *AssemblyFunction,
                type: *u8, name: *u8, span: IR.ZirSourceSpan) -> s32 {
    owner := function.module
    record: *IR.ZirType = null
    if type != null && IR.CText(type).count > 0 {
        record = SVC.FindType(function.module, IR.CText(type), *owner)
    }
    if record == null || record.is_union == 0 { return -1 }
    cursor: usize = 0
    field: IR.ZirTypeField
    status := SVC.NextField(record, *cursor, *field)
    while status == 1 {
        if IR.CText(*field.name[0]) == IR.CText(name) {
            return TypeIn(program, owner, *field.type[0], span, 0)
        }
        status = SVC.NextField(record, *cursor, *field)
    }
    return Fail(program, span, "union has no such member")
}

// Read member type `member` out of the union value `whole`: its low bytes,
// reinterpreted.
UnionRead :: (program: *AssemblyProgram, function: *AssemblyFunction,
              whole: s32, member: s32, span: IR.ZirSourceSpan) -> s32 {
    part := TypeAt(program, member)
    bits := Convert(program, function, whole, UnsignedOf(part.bits), span)
    if part.kind == LirTypeKind.Float {
        return Emit(program, function, LirOp.Bitcast, member, *bits, 1, -1, span)
    }
    return Convert(program, function, bits, member, span)
}

// The union value `old` with `value`, of member type `member`, written over
// its low bytes; the bytes above the member stay.
UnionWrite :: (program: *AssemblyProgram, function: *AssemblyFunction,
               old: s32, value: s32, whole: s32, member: s32,
               span: IR.ZirSourceSpan) -> s32 {
    part := TypeAt(program, member)
    narrow := UnsignedOf(part.bits)
    bits: s32 = -1
    if part.kind == LirTypeKind.Float {
        bits = Emit(program, function, LirOp.Bitcast, narrow, *value, 1, -1, span)
    } else {
        bits = Convert(program, function, value, narrow, span)
    }
    widened := Convert(program, function, bits, whole, span)
    if part.bits == TypeAt(program, whole).bits { return widened }
    kept_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if kept_operands == null { return -1 }
    kept_operands[0] = old
    kept_operands[1] = Constant(program, function, whole,
        ~((cast(u64)1 << cast(u64)part.bits) - cast(u64)1), span)
    merged_operands := cast(*s32)Allocate(program, 2, size_of(s32))
    if merged_operands == null { return -1 }
    merged_operands[0] = Emit(program, function, LirOp.BitAnd, whole,
                              kept_operands, 2, -1, span)
    merged_operands[1] = widened
    return Emit(program, function, LirOp.BitOr, whole, merged_operands, 2, -1, span)
}

// A bare `null` has no type of its own in checked ZIR: it is the null of the
// pointer or procedure type it is passed, assigned or returned as.
ExpressionFor :: (program: *AssemblyProgram, function: *AssemblyFunction,
                  root: s32, wanted: s32, depth: s32) -> s32 {
    if program.failed == 0 && root >= 0 && root < function.source.expr_count && wanted > 0 {
        expression := *function.source.exprs[root]
        kind := TypeAt(program, wanted).kind
        if expression.kind == ZirExprKind.IDENT && expression.is_global_value == 0 &&
           IR.CText(expression.name) == "null" && IR.CText(expression.type) == "null" &&
           (kind == LirTypeKind.Pointer || kind == LirTypeKind.Function) {
            return Emit(program, function, LirOp.Null, wanted, null, 0, -1, expression.span)
        }
    }
    return Expression(program, function, root, depth)
}


ResolveFunctionAt :: (module: *IR.ZirModule, name: *u8, path: *u8, owner: **IR.ZirModule,
                      callee: **IR.ZirFunction) -> s32 #foreign compiler "ResolveFunctionAt";
ResolveQualifiedHostImportAt :: (module: *IR.ZirModule, name: *u8, path: *u8,
                                 owner: **IR.ZirModule,
                                 declaration: **IR.ZirImport) -> s32 #foreign compiler "ResolveQualifiedHostImportAt";

ExpressionValue :: (program: *AssemblyProgram, function: *AssemblyFunction,
                    root: s32, depth: s32) -> s32 {
    if Spend(program, function.source.span) == 0 { return -1 }
    if depth > 256 || root < 0 || root >= function.source.expr_count {
        return Fail(program, function.source.span, "invalid or excessively deep expression graph")
    }
    expression := *function.source.exprs[root]
    type := Type(program, function, expression.type, expression.span)
    if program.failed != 0 { return -1 }
    if expression.kind == .OWNED_CLOSURE {
        return OwnedClosure(program, function, expression, type, depth + 1)
    }
    if expression.kind == .OWNED_CAPTURE_DROP {
        return DropCapture(program, function, expression, depth + 1)
    }
    if expression.is_function_value != 0 {
        owner: *IR.ZirModule = null
        callee: *IR.ZirFunction = null
        if TypeAt(program, type).kind != LirTypeKind.Function ||
           ResolveFunctionAt(function.module, expression.name, SVC.SpanPath(expression.span),
                             *owner, *callee) != 1 {
            return Fail(program, expression.span, "procedure value is not a concrete portable function")
        }
        if callee.is_extern != 0 {
            return Fail(program, expression.span, "host and foreign procedures cannot become portable procedure values")
        }
        symbol := Function(program, owner, callee)
        if program.failed != 0 { return -1 }
        return Emit(program, function, LirOp.FunctionAddress, type, null, 0, symbol, expression.span)
    }
    if expression.kind == ZirExprKind.STRING { return String(program, function, expression) }
    if expression.kind == ZirExprKind.SIZE_OF {
        // isize and usize are pointer-sized: 8 bytes on every target the
        // portable format runs on, as the C target gives them there.
        spelled := IR.CText(expression.name)
        if spelled == "isize" || spelled == "usize" {
            return Constant(program, function, type, 8, expression.span)
        }
        measured := Type(program, function, expression.name, expression.span)
        if program.failed != 0 { return -1 }
        alignment: s64 = 1
        size := LayoutSize(program, measured, *alignment, 0)
        if size < 0 {
            return Fail(program, expression.span, "size_of this type has no portable lowered size")
        }
        return Constant(program, function, type, cast(u64)size, expression.span)
    }
    // A parsed global initializer leaves its numeric literals untyped; each
    // takes the type of the member or global it initializes.
    if function.literal_at == root + 1 &&
       (expression.kind == ZirExprKind.INT || expression.kind == ZirExprKind.FLOAT) {
        own := TypeAt(program, type).kind
        if own != LirTypeKind.Float && (expression.kind == ZirExprKind.FLOAT ||
           (own != LirTypeKind.Integer && own != LirTypeKind.Bool)) {
            type = function.literal_type
        }
    }
    if expression.kind == ZirExprKind.INT || expression.kind == ZirExprKind.FLOAT {
        bits: u64 = 0
        if LiteralBits(program, expression, type, *bits) == 0 { return -1 }
        return Constant(program, function, type, bits, expression.span)
    }
    if expression.kind == ZirExprKind.COMPOUND {
        return Compound(program, function, expression, type, depth + 1)
    }
    if expression.kind == ZirExprKind.SLICE {
        return LowerSlice(program, function, expression, type, depth + 1)
    }
    if expression.kind == ZirExprKind.INDEX && Addressable(program, function, root, depth + 1) != 0 {
        address := Address(program, function, root, depth + 1)
        return Emit(program, function, LirOp.Load, type, *address, 1, -1, expression.span)
    }
    if expression.kind == ZirExprKind.POINTER_MEMBER {
        address := Address(program, function, root, depth + 1)
        if program.failed != 0 { return -1 }
        return Emit(program, function, LirOp.Load, type, *address, 1, -1, expression.span)
    }
    if expression.kind == ZirExprKind.MEMBER && expression.left >= 0 &&
       expression.left < function.source.expr_count {
        member := UnionMember(program, function,
            function.source.exprs[expression.left].type, expression.name, expression.span)
        if program.failed != 0 { return -1 }
        if member >= 0 {
            return UnionRead(program, function,
                Expression(program, function, expression.left, depth + 1), member, expression.span)
        }
    }
    if expression.kind == ZirExprKind.MEMBER || expression.kind == ZirExprKind.INDEX {
        return Member(program, function, expression, depth + 1)
    }
    if expression.kind == ZirExprKind.IDENT {
        if expression.is_global_value != 0 {
            address := GlobalAddress(program, function, expression.name, expression.span)
            return Emit(program, function, LirOp.Load, type, *address, 1, -1, expression.span)
        }
        if IR.CText(expression.name) == "null" {
            kind := TypeAt(program, type).kind
            if kind != LirTypeKind.Pointer && kind != LirTypeKind.Function {
                return Fail(program, expression.span, "null requires a pointer or procedure type")
            }
            return Emit(program, function, LirOp.Null, type, null, 0, -1, expression.span)
        }
        if IR.CText(expression.name) == "true" || IR.CText(expression.name) == "false" {
            one: u64 = 0
            if IR.CText(expression.name) == "true" { one = 1 }
            return Constant(program, function, 1, one, expression.span)
        }
        binding := Binding(function, expression.name)
        if binding >= 0 {
            local := *function.bindings.data[binding]
            if local.storage_type < 0 { return local.value }
            return Emit(program, function, LirOp.Load, local.type, *local.value, 1, -1,
                expression.span)
        }
        named := Define(program, function, expression.name, type, root, expression.span)
        if named != -2 { return named }
        return Fail(program, expression.span, "only local scalar bindings are lowered in identifier expressions")
    }
    if expression.kind == ZirExprKind.CAST {
        value := Expression(program, function, expression.right, depth + 1)
        // Only the checked invocation prelude restores an erased capture.
        // Ordinary pointer reinterpretation has no portable lowered form.
        if function.source != null && IR.CaptureEnvironmentBinding(function.source) &&
           root == function.source.stmts[0].expr_root {
            return Emit(program, function, LirOp.Bitcast, type, *value, 1, -1, expression.span)
        }
        return Convert(program, function, value, type, expression.span)
    }
    if expression.kind == ZirExprKind.UNARY {
        if IR.CText(*expression.op[0]) == "&" {
            return Address(program, function, expression.right, depth + 1)
        }
        // A signed literal in a parsed global initializer is typed like the
        // bare literal: by the member or global it initializes.
        if function.literal_at == root + 1 &&
           (IR.CText(*expression.op[0]) == "-" || IR.CText(*expression.op[0]) == "+") {
            own := TypeAt(program, type).kind
            if own != LirTypeKind.Float && own != LirTypeKind.Integer {
                type = function.literal_type
            }
            function.literal_at = expression.right + 1
        }
        value := Expression(program, function, expression.right, depth + 1)
        if program.failed != 0 { return -1 }
        if IR.CText(*expression.op[0]) == "*" {
            return Emit(program, function, LirOp.Load, type, *value, 1, -1, expression.span)
        }
        if IR.CText(*expression.op[0]) == "+" {
            return Convert(program, function, value, type, expression.span)
        }
        if IR.CText(*expression.op[0]) == "!" {
            actual := function.values.data[value]
            operands := cast(*s32)Allocate(program, 2, size_of(s32))
            if operands == null { return -1 }
            operands[0] = value
            operands[1] = Zero(program, function, actual, expression.span, depth + 1)
            return Emit(program, function, LirOp.Equal, 1, operands, 2, -1, expression.span)
        }
        op := LirOp.Invalid
        if IR.CText(*expression.op[0]) == "-" { op = LirOp.Negate }
        if IR.CText(*expression.op[0]) == "~" { op = LirOp.BitNot }
        if op == LirOp.Invalid {
            return Fail(program, expression.span, "unsupported unary operation")
        }
        value = Convert(program, function, value, type, expression.span)
        return Emit(program, function, op, type, *value, 1, -1, expression.span)
    }
    if expression.kind == ZirExprKind.CONDITIONAL {
        condition := Expression(program, function, expression.left, depth + 1)
        return Select(program, function, expression, condition, expression.right,
                      expression.third, 0, depth + 1)
    }
    if expression.kind == ZirExprKind.BINARY {
        if expression.left >= 0 && expression.left < function.source.expr_count {
            left_source := *function.source.exprs[expression.left]
            if left_source.kind == ZirExprKind.IDENT &&
               IR.CText(left_source.name) == "null" &&
               IR.CText(left_source.type) == "null" &&
               (IR.CText(*expression.op[0]) == "==" || IR.CText(*expression.op[0]) == "!=") {
                // null has no effects, so comparing it on the right is the same.
                other := Expression(program, function, expression.right, depth + 1)
                if program.failed != 0 { return -1 }
                other_type := function.values.data[other]
                kind := TypeAt(program, other_type).kind
                if kind != LirTypeKind.Pointer && kind != LirTypeKind.Function {
                    return Fail(program, left_source.span, "null requires a pointer or procedure type")
                }
                compared := cast(*s32)Allocate(program, 2, size_of(s32))
                if compared == null { return -1 }
                compared[0] = other
                compared[1] = Emit(program, function, LirOp.Null, other_type, null, 0, -1, left_source.span)
                return Emit(program, function, Binary(*expression.op[0]), 1,
                            compared, 2, -1, expression.span)
            }
        }
        if IR.CText(*expression.op[0]) == "||" {
            folded := BoundsDisjunction(program, function, expression, depth)
            if folded >= 0 || program.failed != 0 { return folded }
        }
        if IR.CText(*expression.op[0]) == "&&" {
            folded := BoundsConjunction(program, function, expression, depth)
            if folded >= 0 || program.failed != 0 { return folded }
        }
        operands := cast(*s32)Allocate(program, 2, size_of(s32))
        if operands == null { return -1 }
        operands[0] = Expression(program, function, expression.left, depth + 1)
        operands[1] = -1
        if IR.CText(*expression.op[0]) == "&&" || IR.CText(*expression.op[0]) == "||" {
            branch: s32 = 2
            if IR.CText(*expression.op[0]) == "||" { branch = 1 }
            return Select(program, function, expression, operands[0], expression.right,
                expression.right, branch, depth + 1)
        }
        right_null := false
        if expression.right >= 0 && expression.right < function.source.expr_count {
            right_source := *function.source.exprs[expression.right]
            right_null = right_source.kind == ZirExprKind.IDENT &&
                IR.CText(right_source.name) == "null" && IR.CText(right_source.type) == "null"
            if right_null == true && operands[0] >= 0 {
                // An untyped null meets the other operand's pointer or slot type.
                other := function.values.data[operands[0]]
                kind := TypeAt(program, other).kind
                if kind != LirTypeKind.Pointer && kind != LirTypeKind.Function {
                    return Fail(program, right_source.span, "null requires a pointer or procedure type")
                }
                operands[1] = Emit(program, function, LirOp.Null, other, null, 0, -1,
                    right_source.span)
            }
        }
        if right_null == false {
            operands[1] = Expression(program, function, expression.right, depth + 1)
        }
        if program.failed != 0 { return -1 }
        op := Binary(*expression.op[0])
        if op == LirOp.Invalid {
            return Fail(program, expression.span, "unsupported binary operation")
        }
        left_type := function.values.data[operands[0]]
        right_type := function.values.data[operands[1]]
        if left_type == program.string_type && right_type == program.string_type &&
           (op == LirOp.Equal || op == LirOp.NotEqual) {
            compared := cast(*s32)Allocate(program, 4, size_of(s32))
            if compared == null { return -1 }
            compared[0] = Indexed(program, function, LirOp.Extract,
                MemberType(program, left_type, 0), *operands[0], 1, 0, expression.span)
            compared[1] = Indexed(program, function, LirOp.Extract,
                MemberType(program, left_type, 1), *operands[0], 1, 1, expression.span)
            compared[2] = Indexed(program, function, LirOp.Extract,
                MemberType(program, right_type, 0), *operands[1], 1, 0, expression.span)
            compared[3] = Indexed(program, function, LirOp.Extract,
                MemberType(program, right_type, 1), *operands[1], 1, 1, expression.span)
            equal := Emit(program, function, LirOp.BytesEqual, 1, compared, 4, -1, expression.span)
            if op == LirOp.Equal { return equal }
            inverted := cast(*s32)Allocate(program, 2, size_of(s32))
            if inverted == null { return -1 }
            inverted[0] = equal
            inverted[1] = Constant(program, function, 1, 0, expression.span)
            return Emit(program, function, LirOp.Equal, 1, inverted, 2, -1, expression.span)
        }
        compare := op >= LirOp.Equal && op <= LirOp.GreaterEqual
        common := type
        if compare == true { common = left_type }
        if compare == true && left_type != right_type {
            left := TypeAt(program, left_type)
            right := TypeAt(program, right_type)
            if left.kind == LirTypeKind.Float || right.kind == LirTypeKind.Float {
                // An untyped float literal takes the other operand's float
                // type, as `x != 0.55` compares with (float)0.55 in C.
                left_untyped := IR.CText(function.source.exprs[expression.left].type) == "real"
                right_untyped := IR.CText(function.source.exprs[expression.right].type) == "real"
                if right_untyped == true && left.kind == LirTypeKind.Float {
                    common = left_type
                } else if left_untyped == true && right.kind == LirTypeKind.Float {
                    common = right_type
                } else if left.kind != LirTypeKind.Float ||
                          (right.kind == LirTypeKind.Float && right.bits > left.bits) {
                    common = right_type
                }
            } else if left.is_signed != right.is_signed {
                // The checked language compares mixed-signedness integers
                // by value, except that a u64 operand compares 64-bit
                // patterns (an untyped literal such as -1 meets u64 as its
                // two's-complement bits). s64 holds every narrower value.
                wide_unsigned := (left.is_signed == false && left.bits == 64) ||
                    (right.is_signed == false && right.bits == 64)
                common = 8
                if wide_unsigned == true { common = 9 }
            } else if right.bits > left.bits {
                common = right_type
            }
        }
        operands[0] = Convert(program, function, operands[0], common, expression.span)
        if op != LirOp.ShiftLeft && op != LirOp.ShiftRight {
            operands[1] = Convert(program, function, operands[1], common, expression.span)
        }
        result_type: s32 = type
        if compare == true { result_type = 1 }
        return Emit(program, function, op, result_type, operands, 2, -1, expression.span)
    }
    if expression.kind == ZirExprKind.CALL {
        indirect := false
        if expression.slot_type != null && IR.CText(expression.slot_type).count > 0 {
            indirect = true
        }
        spelled := IR.CText(expression.name)
        if indirect == false && spelled == "print" {
            return Print(program, function, expression, depth + 1)
        }
        if indirect == false && spelled == "TextView" {
            return AsTextView(program, function, expression, type, depth + 1)
        }
        if indirect == false && (spelled == "VecPush" || spelled == "VecClear" ||
           spelled == "VecFree") {
            return VectorCall(program, function, expression, depth + 1)
        }
        if indirect == false && spelled == "VecSlice" {
            return VectorSlice(program, function, expression, depth + 1)
        }
        if indirect == false && (spelled == "VecReserve" || spelled == "VecResize" ||
           spelled == "VecResizeBounded") {
            bounded := true
            if spelled == "VecReserve" { bounded = false }
            return VecReserveCall(program, function, expression, bounded, depth + 1)
        }
        if indirect == false && spelled == "VecSwap" {
            return VectorSwap(program, function, expression)
        }
        if indirect == false && spelled.count > 8 && memcmp(cast(*void)expression.name,
           cast(*void)SVC.Keep("zi_simd_"), 8) == 0 {
            return Simd(program, function, expression, type, depth + 1)
        }
        if indirect == false && spelled == "VecClone" {
            return VectorClone(program, function, expression, depth + 1)
        }
        if indirect == false && (spelled == "VecGet" || spelled == "VecPop") {
            get := spelled == "VecGet"
            return VectorTake(program, function, expression, type, get, depth + 1)
        }
        if indirect == false && spelled == "BuilderAppend" {
            return AppendBuilder(program, function, expression, depth + 1)
        }
        if indirect == false && spelled == "BuilderFinish" {
            return FinishBuilder(program, function, expression)
        }
        symbol: s32 = -1
        receiver: s32 = -1
        owned_receiver: s32 = -1
        owned_identity: s32 = -1
        state: s32 = -1
        hidden: s32 = 0
        parameters: []s32
        result: s32 = 0
        if indirect == true {
            if expression.left >= 0 {
                receiver = Expression(program, function, expression.left, depth + 1)
            } else {
                receiver = NamedValue(program, function, expression.name, expression.span)
            }
            if program.failed != 0 { return -1 }
            owned_identity = function.values.data[receiver]
            if OwnedCallable(program, owned_identity) {
                owned_receiver = receiver
                record := TypeAt(program, owned_identity)
                state_type := record.fields[0]
                invoke_type := record.fields[1]
                state = Indexed(program, function, LirOp.Extract, state_type, *receiver, 1, 0, expression.span)
                receiver = Indexed(program, function, LirOp.Extract, invoke_type, *receiver, 1, 1, expression.span)
                RequirePointer(program, function, state, expression.span)
                RequirePointer(program, function, receiver, expression.span)
                hidden = 1
            }
            signature := TypeAt(program, function.values.data[receiver])
            if signature.kind != LirTypeKind.Function {
                return Fail(program, expression.span, "indirect call requires a portable procedure value")
            }
            parameters = signature.parameters
            result = signature.result
        } else {
            owner: *IR.ZirModule = null
            callee: *IR.ZirFunction = null
            if ResolveFunctionAt(function.module, expression.name, SVC.SpanPath(expression.span),
                                 *owner, *callee) == 1 {
                symbol = Function(program, owner, callee)
            } else if spelled == "zi_sqrt" {
                value := Expression(program, function, expression.first_child, depth + 1)
                if program.failed != 0 { return -1 }
                operands := s32.[value]
                return Emit(program, function, .SquareRoot, type, operands.data, 1, -1, expression.span)
            } else if BitBuiltin(expression.name) != ZIR_BIT_NONE {
                return Bit(program, function, expression, type,
                           BitBuiltin(expression.name), depth + 1)
            } else if spelled == "zi_new" {
                return New(program, function, expression, type)
            } else if spelled == "zi_free" {
                return FreePointer(program, function, expression, depth + 1)
            } else {
                symbol = HostFunction(program, function.module, expression.name, expression.span)
            }
            if program.failed != 0 { return -1 }
            if symbol < 0 { ForeignCall(program, expression.name) }
            if symbol < 0 {
                return Fail(program, expression.span, "call is not a direct concrete Ziran procedure")
            }
            targets := cast(**AssemblyFunction)program.functions.data
            target := targets[symbol]
            parameters = target.result.parameters
            result = target.result.result
        }
        count := cast(s32)parameters.count
        arguments := cast(*s32)Allocate(program,
            cast(usize)(count + cast(s32)(ifx indirect == true then 1 else 0)), size_of(s32))
        if (count > 0 || indirect == true) && arguments == null { return -1 }
        if indirect == true { arguments[0] = receiver }
        values := arguments
        if indirect == true { values = cast(*s32)(cast(usize)arguments + cast(usize)size_of(s32)) }
        index: s32 = 0
        while index < count {
            values[index] = -1
            index = index + 1
        }
        if hidden == 1 { values[0] = state }
        ordinal: s32 = 0
        child := expression.first_child
        while child >= 0 {
            if child >= function.source.expr_count || Spend(program, expression.span) == 0 {
                return -1
            }
            argument := *function.source.exprs[child]
            position := ordinal
            if argument.argument_index >= 0 { position = argument.argument_index }
            position += hidden
            if position < 0 || position >= count || values[position] >= 0 {
                return Fail(program, argument.span, "invalid checked call argument mapping")
            }
            wanted := parameters[position]
            value := ExpressionFor(program, function, child, wanted, depth + 1)
            values[position] = Convert(program, function, value, wanted, argument.span)
            ordinal = ordinal + 1
            child = argument.next_sibling
        }
        index = 0
        while index < count {
            if values[index] < 0 {
                return Fail(program, expression.span, "call arguments are not fully lowered")
            }
            index = index + 1
        }
        targets := cast(**AssemblyFunction)program.functions.data
        host := false
        if indirect == false { host = targets[symbol].result.external }
        op := LirOp.Call
        if indirect == true { op = LirOp.CallIndirect }
        if host == true { op = LirOp.HostCall }
        answer := Emit(program, function, op, result, arguments, count + cast(s32)(ifx indirect == true then 1 else 0),
            symbol, expression.span)
        if owned_receiver >= 0 && expression.left >= 0 {
            base := function.source.exprs[expression.left]
            if base.kind == .CALL || base.kind == .OWNED_CLOSURE || base.kind == .CONDITIONAL {
                DropValue(program, function, owned_receiver, owned_identity, expression.span, 0)
            }
        }
        return answer
    }
    return Fail(program, expression.span, "expression is outside the initial direct scalar backend")
}

// One arm of an integer case list: the value it matches, where its body
// begins and closes, and the block the body is lowered into.
AssemblyCase :: struct {
    value: u64
    open: s32
    close: s32
    block: s32
}

// Selects signed or unsigned order for the case-list binary search.
case_signed: bool = false;

CaseOrder :: (left: *AssemblyCase, right: *AssemblyCase) -> s32 {
    if case_signed == true {
        a: s64 = cast(s64)left.value
        b: s64 = cast(s64)right.value
        if a < b { return -1 }
        if a > b { return 1 }
        return 0
    }
    if left.value < right.value { return -1 }
    if left.value > right.value { return 1 }
    return 0
}

// Insertion sort by CaseOrder; case lists are short and mostly ordered.
SortCases :: (cases: *AssemblyCase, count: s32) {
    index: s32 = 1
    while index < count {
        key := cases[index]
        hole: s32 = index
        while hole > 0 && CaseOrder(*cases[hole - 1], *key) > 0 {
            cases[hole] = cases[hole - 1]
            hole -= 1
        }
        cases[hole] = key
        index += 1
    }
}

// Skip forward to the statement that closes the block opened at `begin`.
Close :: (program: *AssemblyProgram, source: *IR.ZirFunction, begin: s32,
          end: s32) -> s32 {
    nesting: s32 = 1
    index: s32 = begin + 1
    while index < end {
        if Spend(program, source.stmts[index].span) == 0 { return end }
        kind := source.stmts[index].kind
        if kind == ZirStmtKind.IF || kind == ZirStmtKind.WHILE || kind == ZirStmtKind.BLOCK_OPEN {
            nesting += 1
        }
        if kind == ZirStmtKind.BLOCK_CLOSE {
            nesting -= 1
            if nesting == 0 { return index }
        }
        index += 1
    }
    Fail(program, source.stmts[begin].span, "unbalanced checked statement blocks")
    return end
}

// Branch from the current block to the arm among cases[low..high) whose
// value `subject` equals, or to `otherwise`: a binary search, so a list of
// n cases costs about log2(n) compares instead of n.
Dispatch :: (program: *AssemblyProgram, function: *AssemblyFunction, subject: s32,
             type: s32, cases: *AssemblyCase, low: s32, high: s32, otherwise: s32,
             before: *AssemblyBinding, count: s32, span: IR.ZirSourceSpan) {
    if program.failed != 0 { return }
    middle: s32 = low + (high - low) / 2
    operands: [2]s32
    operands[0] = subject
    operands[1] = Constant(program, function, type, cases[middle].value, span)
    if high - low == 1 {
        same := Emit(program, function, LirOp.Equal, 1, *operands[0], 2, -1, span)
        Branch(program, function, same, cases[low].block, otherwise, count, span)
        return
    }
    lower := Block(program, function, before, count)
    upper := Block(program, function, before, count)
    below := Emit(program, function, LirOp.Less, 1, *operands[0], 2, -1, span)
    Branch(program, function, below, lower, upper, count, span)
    Enter(function, lower, before, count)
    Dispatch(program, function, subject, type, cases, low, middle, otherwise, before, count, span)
    Enter(function, upper, before, count)
    Dispatch(program, function, subject, type, cases, middle, high, otherwise, before, count, span)
}

// The arms of an `if` chain when it is a case list over one local: every
// link compares the same identifier with a distinct integer literal.
// Returns the arm count, with *otherwise the `else` statement or -1 and
// *next the statement after the chain; 0 when the chain is anything else.
CaseList :: (program: *AssemblyProgram, function: *AssemblyFunction, index: s32,
             end: s32, arms: *Vector(AssemblyCase), otherwise: *s32,
             next: *s32) -> s32 {
    source := function.source
    subject: *u8 = null
    <<otherwise = -1
    at: s32 = index
    while true {
        statement := *source.stmts[at]
        close := Close(program, source, at, end)
        if at != index && statement.expr_root < 0 {
            <<otherwise = at
            <<next = close + 1
            break
        }
        if statement.expr_root < 0 || statement.expr_root >= source.expr_count { return 0 }
        condition := *source.exprs[statement.expr_root]
        if condition.kind != ZirExprKind.BINARY || IR.CText(*condition.op[0]) != "==" ||
           condition.left < 0 || condition.right < 0 { return 0 }
        left := *source.exprs[condition.left]
        right := *source.exprs[condition.right]
        // The value is an integer literal, bare or negated.
        negative: s32 = 0
        if right.kind == ZirExprKind.UNARY && IR.CText(*right.op[0]) == "-" &&
           right.right >= 0 && right.right < source.expr_count {
            right = *source.exprs[right.right]
            negative = 1
        }
        spelling: *u8 = left.name
        if left.kind != ZirExprKind.IDENT || left.is_global_value != 0 ||
           right.kind != ZirExprKind.INT ||
           (subject != null && IR.CText(subject) != IR.CText(*spelling[0])) { return 0 }
        subject = spelling
        bits: u64 = 0
        skip: usize = 0
        if right.text[0] == #char "-" {
            negative = 1 - negative
            skip = 1
        }
        if right.text[0] == #char "+" { skip = 1 }
        digits := cast(*u8)(cast(usize)right.text + skip)
        if CZirIntegerLiteral(digits, *bits) == 0 { return 0 }
        arm_value: u64 = bits
        if negative == 1 { arm_value = cast(u64)0 - bits }
        arm := AssemblyCase.{value = arm_value, open = at, close = close, block = -1}
        if Push(program, cast(*RawVector)arms, size_of(AssemblyCase),
                cast(*void)*arm) == false { return 0 }
        <<next = close + 1
        at = close + 1
        if at >= end || source.stmts[at].is_else == 0 { break }
    }
    return arms.count
}

// Where a lowered arm ended and the bindings live when it does.
AssemblyArm :: struct {
    block: s32
    bindings: *AssemblyBinding
}

// Lower one `if` chain. Its `else if` links and `else` are walked as one
// chain, so a case list of any length nests no deeper than a single `if`;
// every arm that falls through meets the others in one join block.
AssemblyIf :: (program: *AssemblyProgram, function: *AssemblyFunction, index: s32,
               end: s32, depth: s32) -> s32 {
    if depth > 256 {
        Fail(program, function.source.span, "branch nesting budget exhausted")
        return end
    }
    span := function.source.stmts[index].span
    count := function.bindings.count
    before := Snapshot(program, function, count)
    arms: Vector(AssemblyArm)
    next: s32 = index
    // A case list of eight or more integer values is a binary search.
    listed: Vector(AssemblyCase)
    otherwise_at: s32 = -1
    after: s32 = index
    subject: s32 = -1
    subject_type: s32 = 0
    if CaseList(program, function, index, end, *listed, *otherwise_at, *after) >= 8 {
        first := *function.source.exprs[function.source.stmts[index].expr_root]
        subject = Expression(program, function, first.left, 0)
        if program.failed != 0 { return end }
        subject_type = function.values.data[subject]
        shape := TypeAt(program, subject_type)
        cases := listed.data
        if shape.kind == LirTypeKind.Integer {
            // Each value as the subject's type holds it, then in order.
            arm: s32 = 0
            while arm < listed.count {
                if shape.bits < 64 {
                    cases[arm].value = cases[arm].value &
                        ((cast(u64)1 << cast(u64)shape.bits) - cast(u64)1)
                }
                if shape.is_signed == true && shape.bits < 64 &&
                   (cases[arm].value >> cast(u64)(shape.bits - 1)) != cast(u64)0 {
                    cases[arm].value = cases[arm].value |
                        ~((cast(u64)1 << cast(u64)shape.bits) - cast(u64)1)
                }
                arm += 1
            }
            case_signed = shape.is_signed
            SortCases(cases, listed.count)
            arm = 1
            while arm < listed.count {
                if cases[arm].value == cases[arm - 1].value { subject = -1 }
                arm += 1
            }
        } else {
            subject = -1
        }
    }
    if subject >= 0 && listed.count >= 8 {
        cases := listed.data
        arm: s32 = 0
        while arm < listed.count {
            cases[arm].block = Block(program, function, before, count)
            arm += 1
        }
        otherwise := Block(program, function, before, count)
        if program.failed != 0 { return end }
        Dispatch(program, function, subject, subject_type, cases, 0, listed.count,
                 otherwise, before, count, span)
        arm = 0
        while arm < listed.count && program.failed == 0 {
            Enter(function, cases[arm].block, before, count)
            Sequence(program, function, cases[arm].open + 1, cases[arm].close, depth + 1)
            reached := AssemblyArm.{block = function.current,
                                    bindings = Snapshot(program, function, count)}
            if Push(program, cast(*RawVector)*arms, size_of(AssemblyArm),
                    cast(*void)*reached) == false { return end }
            arm += 1
        }
        if program.failed != 0 { return end }
        Enter(function, otherwise, before, count)
        if otherwise_at >= 0 {
            Sequence(program, function, otherwise_at + 1,
                     Close(program, function.source, otherwise_at, end), depth + 1)
        }
        rest := AssemblyArm.{block = function.current,
                             bindings = Snapshot(program, function, count)}
        if program.failed != 0 ||
           Push(program, cast(*RawVector)*arms, size_of(AssemblyArm),
                cast(*void)*rest) == false { return end }
        next = after
    } else {
        while true {
            statement := *function.source.stmts[next]
            close := Close(program, function.source, next, end)
            conditional: bool = false
            if next == index || statement.expr_root >= 0 { conditional = true }
            no: s32 = -1
            if conditional == true {
                condition := Expression(program, function, statement.expr_root, 0)
                yes := Block(program, function, before, count)
                no = Block(program, function, before, count)
                if program.failed != 0 { return end }
                Branch(program, function, condition, yes, no, count, statement.span)
                Enter(function, yes, before, count)
            }
            Sequence(program, function, next + 1, close, depth + 1)
            arm := AssemblyArm.{block = function.current,
                                bindings = Snapshot(program, function, count)}
            if program.failed != 0 ||
               Push(program, cast(*RawVector)*arms, size_of(AssemblyArm),
                    cast(*void)*arm) == false { return end }
            next = close + 1
            if conditional == false { break }
            Enter(function, no, before, count)
            if next >= end || function.source.stmts[next].is_else == 0 {
                // No `else`: the untaken edge falls through as it stands.
                rest := AssemblyArm.{block = function.current,
                                     bindings = Snapshot(program, function, count)}
                if program.failed != 0 ||
                   Push(program, cast(*RawVector)*arms, size_of(AssemblyArm),
                        cast(*void)*rest) == false { return end }
                break
            }
        }
    }
    reached := arms.data
    live: s32 = 0
    arm: s32 = 0
    while arm < arms.count {
        if reached[arm].block >= 0 { live += 1 }
        arm += 1
    }
    if live == 0 {
        function.current = -1
        return next
    }
    join := Block(program, function, before, count)
    if program.failed != 0 { return end }
    arm = 0
    while arm < arms.count {
        if reached[arm].block >= 0 {
            function.current = reached[arm].block
            if count > 0 {
                memcpy(cast(*void)function.bindings.data, cast(*void)reached[arm].bindings,
                       cast(usize)count * size_of(AssemblyBinding))
            }
            Jump(program, function, join, count, span)
        }
        arm += 1
    }
    Enter(function, join, before, count)
    return next
}

// Whether code in block `block` from instruction `from` on calls a
// procedure or resizes heap storage.
BlockBarrier :: (function: *AssemblyFunction, block: s32, from: s32) -> s32 {
    source := BlockAt(function, block)
    at: s32 = from
    while at < source.instructions.count {
        op := source.instructions.data[at].op
        if op == LirOp.Call || op == LirOp.CallIndirect || op == LirOp.HostCall ||
           op == LirOp.Resize { return 1 }
        at += 1
    }
    return 0
}

// Whether anything emitted since the address was derived calls a procedure
// or resizes heap storage: the current block after its `end` instruction,
// or any block made since `blocks`.
EmittedBarrier :: (function: *AssemblyFunction, block: s32, end: s32,
                   blocks: s32) -> s32 {
    if block >= 0 && BlockBarrier(function, block, end) == 1 { return 1 }
    index: s32 = blocks
    while index < function.blocks.count {
        if index != block && BlockBarrier(function, index, 0) == 1 { return 1 }
        index += 1
    }
    return 0
}

// An assignment's destination is reached before its value is computed, so
// a bad index fails first. When the value calls a procedure, the address is
// derived again from the same operands for the store, so each derivation is
// used only beside where it is made: the engine then keeps no lasting table
// entry for it, however many places a loop stores to. Only address
// derivations are repeated; nothing is loaded again.
Rederive :: (program: *AssemblyProgram, function: *AssemblyFunction, block: s32,
            value: s32, depth: s32, span: IR.ZirSourceSpan) -> s32 {
    if block < 0 || depth > 8 || program.failed != 0 { return value }
    source := BlockAt(function, block)
    at: s32 = source.instructions.count - 1
    while at >= 0 {
        found := source.instructions.data[at]
        if found.result == value {
            if (found.op != LirOp.FieldAddress && found.op != LirOp.ElementAddress) ||
               found.operands.count < 1 || found.operands.count > 3 { return value }
            operands: [3]s32
            view := cast(*SliceParts)(*found.operands)
            memcpy(cast(*void)*operands, view.data,
                   cast(usize)view.length * size_of(s32))
            operands[0] = Rederive(program, function, block, operands[0], depth + 1, span)
            return Indexed(program, function, found.op, function.values.data[value],
                           *operands[0], cast(s32)view.length, found.immediate, span)
        }
        at -= 1
    }
    return value
}

// Lower the statement range [begin, end) into the current function.
Sequence :: (program: *AssemblyProgram, function: *AssemblyFunction, begin: s32,
             end: s32, depth: s32) {
    if depth > 256 {
        Fail(program, function.source.span, "statement nesting budget exhausted")
        return
    }
    outer_bindings := function.bindings.count
    index: s32 = begin
    while index < end && program.failed == 0 && function.current >= 0 {
        statement := *function.source.stmts[index]
        if Spend(program, statement.span) == 0 { return }
        // An `#asm` block is lowered from its ordinary body, like a
        // procedure with `#asm` variants. A `#parallel` loop runs its
        // iterations in order: the checker proved them independent, so any
        // order gives the same result.
        if statement.is_gpu != 0 {
            Fail(program, statement.span, "GPU statements are not lowered yet")
            break
        }
        if statement.kind == ZirStmtKind.DECL {
            declared := Type(program, function, statement.type, statement.span)
            value: s32 = -1
            if statement.expr_root >= 0 {
                value = ExpressionFor(program, function, statement.expr_root, declared, 0)
            } else {
                value = Zero(program, function, declared, statement.span, 0)
            }
            value = Convert(program, function, value, declared, statement.span)
            binding := AssemblyBinding.{name = Text(program, statement.name),
                                        type = declared, value = value, storage_type = -1}
            Push(program, cast(*RawVector)*function.bindings, size_of(AssemblyBinding),
                 cast(*void)*binding)
            addressed: bool = false
            if index < function.addressed_count && function.addressed[index] != 0 {
                addressed = true
            }
            if addressed == true || KeptInStorage(program, declared) == 1 {
                PromoteBinding(program, function, function.bindings.count - 1,
                               statement.span)
            }
        } else if statement.kind == ZirStmtKind.ASSIGN {
            if statement.lhs_root < 0 || statement.lhs_root >= function.source.expr_count {
                Fail(program, statement.span, "invalid checked assignment destination")
                break
            }
            previous: s32 = -1
            // `whole.member = value` on a union assigns the whole union with
            // the member's bytes replaced.
            place: s32 = statement.lhs_root
            written := *function.source.exprs[place]
            union_member: s32 = -1
            if written.kind == ZirExprKind.MEMBER && written.left >= 0 &&
               written.left < function.source.expr_count {
                union_member = UnionMember(program, function,
                    function.source.exprs[written.left].type, written.name, statement.span)
            }
            if program.failed != 0 { break }
            if union_member >= 0 { place = written.left }
            identity := Type(program, function, function.source.exprs[place].type,
                             statement.span)
            address: s32 = -1
            destination: *AssemblyLocalPlace = null
            if Addressable(program, function, place, 0) == 1 {
                address = Address(program, function, place, 0)
            } else {
                destination = CaptureLocal(program, function, place, 0)
            }
            if program.failed != 0 { break }
            stored: s32 = -1
            if destination != null && destination.storage != 0 { stored = destination.value }
            if address >= 0 { stored = address }
            if IR.CText(*statement.assignment_op[0]) != "=" {
                if address >= 0 || (destination != null && destination.storage != 0) {
                    previous = Emit(program, function, LirOp.Load, identity,
                                    *stored, 1, -1, statement.span)
                } else {
                    previous = destination.value
                }
            }
            address_block := function.current
            address_end: s32 = 0
            if address_block >= 0 {
                address_end = BlockAt(function, address_block).instructions.count
            }
            blocks_before := function.blocks.count
            wanted: s32 = identity
            if union_member >= 0 { wanted = union_member }
            value := ExpressionFor(program, function, statement.expr_root, wanted, 0)
            if address >= 0 && program.failed == 0 &&
               EmittedBarrier(function, address_block, address_end, blocks_before) == 1 {
                address = Rederive(program, function, address_block, address, 0, statement.span)
                if destination != null && destination.storage != 0 { stored = destination.value }
                if address >= 0 { stored = address }
            }
            if union_member >= 0 && program.failed == 0 {
                old: s32 = -1
                if address >= 0 || (destination != null && destination.storage != 0) {
                    old = Emit(program, function, LirOp.Load, identity,
                               *stored, 1, -1, statement.span)
                } else {
                    old = destination.value
                }
                value = Convert(program, function, value, union_member, statement.span)
                // `cell.member op= x` reads the member, combines, and writes
                // it back.
                if IR.CText(*statement.assignment_op[0]) != "=" {
                    operator_text: [4]u8
                    memcpy(cast(*void)*operator_text, cast(*void)*statement.assignment_op[0],
                           size_of([4]u8))
                    length := strlen(*operator_text[0])
                    if length != 0 { operator_text[length - 1] = 0 }
                    op := Binary(*operator_text[0])
                    if op == LirOp.Invalid {
                        Fail(program, statement.span, "unsupported compound assignment")
                        break
                    }
                    combine: [2]s32
                    combine[0] = UnionRead(program, function, old, union_member, statement.span)
                    combine[1] = value
                    value = Emit(program, function, op, union_member, *combine[0], 2, -1,
                                 statement.span)
                }
                value = UnionWrite(program, function, old, value, identity, union_member,
                                   statement.span)
            }
            if union_member < 0 && IR.CText(*statement.assignment_op[0]) != "=" {
                operator_text: [4]u8
                memcpy(cast(*void)*operator_text, cast(*void)*statement.assignment_op[0],
                       size_of([4]u8))
                length := strlen(*operator_text[0])
                if length != 0 { operator_text[length - 1] = 0 }
                op := Binary(*operator_text[0])
                if op == LirOp.Invalid {
                    Fail(program, statement.span, "unsupported compound assignment")
                    break
                }
                if op != LirOp.ShiftLeft && op != LirOp.ShiftRight {
                    value = Convert(program, function, value, identity, statement.span)
                }
                combine: [2]s32
                combine[0] = previous
                combine[1] = value
                value = Emit(program, function, op, identity, *combine[0], 2, -1, statement.span)
            }
            if address >= 0 {
                value = Convert(program, function, value, identity, statement.span)
                // An owned global, or a member of one, can be assigned while
                // it holds storage; the old value is dropped once the new one
                // is made, as the other targets do. The checker requires a
                // local to be empty first.
                base := place
                while base >= 0 && base < function.source.expr_count &&
                      (function.source.exprs[base].kind == ZirExprKind.MEMBER ||
                       function.source.exprs[base].kind == ZirExprKind.INDEX) {
                    base = function.source.exprs[base].left
                }
                global_base: bool = false
                if base >= 0 && base < function.source.expr_count &&
                   function.source.exprs[base].kind == ZirExprKind.IDENT &&
                   function.source.exprs[base].is_global_value != 0 { global_base = true }
                if IR.CText(*statement.assignment_op[0]) == "=" &&
                   TypeOwned(program, identity, 0) == true && global_base == true {
                    old := Emit(program, function, LirOp.Load, identity, *address, 1, -1,
                                statement.span)
                    DropValue(program, function, old, identity, statement.span, 0)
                }
                store: [2]s32
                store[0] = address
                store[1] = value
                Emit(program, function, LirOp.Store, 0, *store[0], 2, -1, statement.span)
            } else {
                StoreCaptured(program, function, destination, value, statement.span)
            }
        } else if statement.kind == ZirStmtKind.EXPR || statement.kind == ZirStmtKind.UNUSED {
            // A checked UNUSED statement may carry no expression at all; the
            // C emitter skips it, and so does this backend.
            if statement.expr_root >= 0 {
                value := Expression(program, function, statement.expr_root, 0)
                // A fresh owned result nobody keeps is dropped at once.
                if program.failed == 0 && value >= 0 && function.current >= 0 &&
                   statement.expr_root < function.source.expr_count &&
                   function.source.exprs[statement.expr_root].kind == ZirExprKind.CALL {
                    DropValue(program, function, value, function.values.data[value],
                              statement.span, 0)
                }
            }
        } else if statement.kind == ZirStmtKind.RETURN {
            value: s32 = -1
            if function.result.result != 0 {
                raw := ExpressionFor(program, function, statement.expr_root,
                                     function.result.result, 0)
                value = Convert(program, function, raw, function.result.result, statement.span)
            }
            DropBindings(program, function, 0, statement.span)
            returned: [1]s32
            returned[0] = value
            return_count: s32 = 0
            if function.result.result != 0 { return_count = 1 }
            Emit(program, function, LirOp.Return, 0, *returned[0], return_count, -1,
                 statement.span)
            function.current = -1
        } else if statement.kind == ZirStmtKind.IF {
            index = AssemblyIf(program, function, index, end, depth) - 1
        } else if statement.kind == ZirStmtKind.WHILE {
            close := Close(program, function.source, index, end)
            constant: s32 = -1
            if statement.expr_root >= 0 && statement.expr_root < function.source.expr_count {
                condition := *function.source.exprs[statement.expr_root]
                if condition.kind == ZirExprKind.IDENT && IR.CText(condition.name) == "true" {
                    constant = 1
                }
                if condition.kind == ZirExprKind.IDENT && IR.CText(condition.name) == "false" {
                    constant = 0
                }
            }
            if constant == 0 {
                // An endless-but-empty condition never runs: skip its body.
                index = close + 1
                continue
            }
            count := function.bindings.count
            before := Snapshot(program, function, count)
            header := Block(program, function, before, count)
            body := Block(program, function, before, count)
            exit: s32 = -1
            if constant != 1 { exit = Block(program, function, before, count) }
            if program.failed != 0 { break }
            Jump(program, function, header, count, statement.span)
            Enter(function, header, before, count)
            Emit(program, function, LirOp.Fuel, 0, null, 0, -1, statement.span)
            condition := Expression(program, function, statement.expr_root, 0)
            if constant == 1 {
                Jump(program, function, body, count, statement.span)
            } else {
                Branch(program, function, condition, body, exit, count, statement.span)
            }
            loop := AssemblyLoop.{header = header, exit = exit, bindings = count,
                                  identity = statement.loop_id, parent = function.loop}
            function.loop = *loop
            Enter(function, body, before, count)
            Sequence(program, function, index + 1, close, depth + 1)
            if function.current >= 0 {
                Jump(program, function, header, count, statement.span)
            }
            function.loop = loop.parent
            if loop.exit >= 0 {
                Enter(function, loop.exit, before, count)
            } else {
                function.current = -1
            }
            index = close
        } else if statement.kind == ZirStmtKind.BREAK || statement.kind == ZirStmtKind.CONTINUE {
            loop := function.loop
            while loop != null && statement.target_id != 0 &&
                  loop.identity != statement.target_id {
                loop = loop.parent
            }
            if loop == null {
                Fail(program, statement.span, "invalid checked loop-control target")
                break
            }
            if statement.kind == ZirStmtKind.BREAK && loop.exit < 0 {
                loop.exit = Block(program, function, function.bindings.data, loop.bindings)
            }
            if program.failed != 0 { break }
            DropBindings(program, function, loop.bindings, statement.span)
            target: s32 = loop.header
            if statement.kind == ZirStmtKind.BREAK { target = loop.exit }
            Jump(program, function, target, loop.bindings, statement.span)
        } else if statement.kind == ZirStmtKind.BLOCK_OPEN {
            close := Close(program, function.source, index, end)
            if statement.assembly_text != null && statement.assembly_text[0] != 0 && !function.checking {
                LocalAssembly(program, function, index, close, depth)
            } else { Sequence(program, function, index + 1, close, depth + 1) }
            index = close
        } else if statement.kind == ZirStmtKind.UNREACHABLE {
            Emit(program, function, LirOp.Unreachable, 0, null, 0, -1, statement.span)
            function.current = -1
        } else {
            Fail(program, statement.span,
                 "statement is outside the initial direct scalar backend")
        }
        index += 1
    }
    if end > begin {
        DropBindings(program, function, outer_bindings,
                     function.source.stmts[end - 1].span)
    }
    function.bindings.count = outer_bindings
}


FunctionVariants :: (program: *AssemblyProgram, function: *AssemblyFunction,
    source: *IR.ZirFunction, statement: s32, cursor: *u8, span: IR.ZirSourceSpan) -> bool {
    if cursor == null || cursor[0] == 0 { return true }
    variants: [LIR.LirAssemblyVariantLimit]LIR.LirAssemblyVariant
    count: s32 = 0
    while program.failed == 0 {
        checked: CheckedAssemblyVariant
        status := AssemblyVariantNext(function.module, source, statement, *cursor, *checked)
        if status == 0 { break }
        if status < 0 || count == LIR.LirAssemblyVariantLimit {
            unused Fail(program, span, "invalid checked assembly variant")
            return false
        }
        architecture: *u8
        os: *u8
        abi: *u8
        features: u64
        if !AssemblyVariantSelector(checked.target, span, *architecture, *os, *abi, *features) {
            unused Fail(program, span, "invalid checked assembly selector")
            return false
        }
        operand_count := checked.outputs + checked.inputs
        operands := cast(*LIR.LirAssemblyOperand)Allocate(program, cast(usize)operand_count,
            size_of(LIR.LirAssemblyOperand))
        if operand_count > 0 && operands == null { return false }
        for index: cast(s32)0..operand_count - 1 {
            operand := checked.operands[index]
            operands[index] = .{alias = Owned(Text(program, operand.alias)),
                constraint = Owned(Text(program, operand.constraint))}
        }
        options := Owned(Text(program, checked.options))
        function.result.assembly_required = options == "target-only" || options == "volatile;target-only"
        variant := LIR.LirAssemblyVariant.{architecture = Owned(Text(program, architecture)),
            os = Owned(Text(program, os)), abi = Owned(Text(program, abi)),
            features = features, template = Owned(Text(program, checked.text)),
            clobbers = Owned(Text(program, checked.clobbers)), outputs = checked.outputs,
            volatile = options == "volatile" || options == "volatile;target-only"}
        parts := cast(*SliceParts)*variant.operands
        parts.data = cast(*void)operands
        parts.length = cast(s64)operand_count
        variants[count] = variant
        count += 1
    }
    if program.failed != 0 { return false }
    stored := Allocate(program, cast(usize)count, size_of(LIR.LirAssemblyVariant))
    if stored == null { return count == 0 }
    memcpy(stored, cast(*void)*variants[0], cast(usize)count * size_of(LIR.LirAssemblyVariant))
    parts := cast(*SliceParts)*function.result.variants
    parts.data = stored
    parts.length = cast(s64)count
    return true
}

// The local assembly call reports whether it ran a specialization. Its
// portable body returns false and leaves the caller's locals untouched. The
// original portable block stays in the caller, so its lexical storage and
// cleanup have exactly the same lifetime as an ordinary block's.
LocalAssembly :: (program: *AssemblyProgram, function: *AssemblyFunction, index: s32, close: s32, depth: s32) {
    statement := *function.source.stmts[index]
    span := statement.span
    variants := statement.assembly_text
    cursor := variants
    first: CheckedAssemblyVariant
    if AssemblyVariantNext(function.module, function.source, index, *cursor, *first) != 1 {
        unused Fail(program, span, "invalid checked local assembly bindings")
        return
    }
    operands := first.outputs + first.inputs
    bindings: [LIR.LirAssemblyOperandLimit]s32
    inputs: [2 * LIR.LirAssemblyOperandLimit]s32
    fields := cast(*s32)Allocate(program, cast(usize)(first.outputs + 1), size_of(s32))
    gate := cast(*AssemblyFunction)Allocate(program, 1, size_of(AssemblyFunction))
    if program.failed != 0 || gate == null || fields == null { return }
    gate.module = function.module
    gate.result.assembly_gate = true
    if !FunctionVariants(program, gate, function.source, index, variants, span) { return }
    parameters := first.inputs
    for operand: cast(s32)0..operands - 1 {
        if LirAssemblyGateAddressed(gate.result.variants, cast(s64)operand) { parameters += 1 }
    }
    types := cast(*s32)Allocate(program, cast(usize)parameters, size_of(s32))
    if parameters > 0 && types == null { return }
    for operand: cast(s32)0..operands - 1 {
        binding := Binding(function, first.operands[operand].binding)
        if binding < 0 {
            unused Fail(program, span, "assembly operand is outside the lowered scope")
            return
        }
        bindings[operand] = binding
        local := function.bindings.data[binding]
        if operand < first.outputs { fields[operand] = local.type }
        else {
            input := operand - first.outputs
            inputs[input] = local.value
            if local.storage_type >= 0 {
                inputs[input] = Emit(program, function, LirOp.Load, local.type, *local.value, 1, -1, span)
            }
            types[input] = local.type
        }
    }
    address := first.inputs
    for operand: cast(s32)0..operands - 1 {
        if !LirAssemblyGateAddressed(gate.result.variants, cast(s64)operand) { continue }
        local := function.bindings.data[bindings[operand]]
        if local.storage_type < 0 {
            unused Fail(program, span, "local assembly memory operand has no caller storage")
            return
        }
        types[address] = local.storage_type
        inputs[address] = local.value
        address += 1
    }
    for parameter: cast(s32)0..parameters - 1 {
        argument := AssemblyBinding.{type = types[parameter], storage_type = -1}
        unused Push(program, cast(*RawVector)*gate.bindings, size_of(AssemblyBinding), cast(*void)*argument)
    }
    fields[first.outputs] = 1 // success flag
    result: s32 = 1
    if first.outputs != 0 {
        result = program.types.count
        if !PushLirType(program, *program.types, .{kind = .Record,
            fields = S32Items(fields, cast(s64)(first.outputs + 1))}) { return }
    }
    symbol := program.functions.count
    name: [32]u8
    unused snprintf(*name[0], size_of([32]u8), SVC.Keep("$asm.%d"), symbol)
    gate.result.module = function.result.module
    gate.result.name = Owned(Text(program, *name[0]))
    gate.result.parameters = S32Items(types, cast(s64)parameters)
    gate.result.result = result
    gate.result.origin = Origin(program, span)
    gate.result.entry = Block(program, gate, gate.bindings.data, parameters)
    gate.current = gate.result.entry
    if program.failed != 0 { return }
    Emit(program, gate, LirOp.Fuel, 0, null, 0, -1, span)
    portable := Zero(program, gate, result, span, 0)
    Emit(program, gate, LirOp.Return, 0, *portable, 1, -1, span)
    if !PushFunctionPtr(program, *program.functions, gate) { return }

    returned := Emit(program, function, LirOp.Call, result, *inputs[0], parameters, symbol, span)
    matched := returned
    if first.outputs != 0 {
        matched = Indexed(program, function, LirOp.Extract, 1, *returned, 1, cast(u64)first.outputs, span)
    }
    count := function.bindings.count
    before := Snapshot(program, function, count)
    assembly := Block(program, function, before, count)
    fallback := Block(program, function, before, count)
    join := Block(program, function, before, count)
    if program.failed != 0 { return }
    Branch(program, function, matched, assembly, fallback, count, span)
    Enter(function, assembly, before, count)
    for operand: cast(s32)0..first.outputs - 1 {
        binding := *function.bindings.data[bindings[operand]]
        value := Indexed(program, function, LirOp.Extract, binding.type, *returned, 1, cast(u64)operand, span)
        if binding.storage_type >= 0 {
            store: [2]s32 = .[binding.value, value]
            Emit(program, function, LirOp.Store, 0, *store[0], 2, -1, span)
        } else { binding.value = value }
    }
    Jump(program, function, join, count, span)
    Enter(function, fallback, before, count)
    Sequence(program, function, index + 1, close, depth + 1)
    if function.current >= 0 { Jump(program, function, join, count, span) }
    Enter(function, join, before, count)
}

// Find or create the lowered form of one checked function.
Function :: (program: *AssemblyProgram, module: *IR.ZirModule,
             source: *IR.ZirFunction) -> s32 {
    index: s32 = 0
    while index < program.functions.count {
        known := program.functions.data[index]
        if known.source == source && known.module == module { return index }
        index += 1
    }
    // A host_api declaration becomes a bodiless capability signature; its
    // callers lower ordinary arguments into an explicit host.call.
    host: bool = false
    if source.is_extern != 0 && source.extern_kind == ZirExternKind.HOST { host = true }
    concrete: bool = true
    if host == false && (source.checked == 0 || source.is_extern != 0) { concrete = false }
    if concrete == false || source.is_template != 0 {
        return Fail(program, source.span, "direct lowering requires a concrete checked function without non-host foreign services")
    }
    function := cast(*AssemblyFunction)Allocate(program, 1, size_of(AssemblyFunction))
    if function == null { return -1 }
    function.module = module
    function.source = source
    function.current = -1
    function.result.module = Name(program, *program.modules, *module.name[0])
    chosen := *source.name[0]
    if host == true && source.extern_symbol[0] != 0 { chosen = *source.extern_symbol[0] }
    name := Text(program, chosen)
    function.result.name = Owned(name)
    if host == true {
        function.result.calling = LirCalling.Host
        function.result.external = true
    }
    function.result.result = Type(program, function, *source.return_type[0], source.span)
    function.result.origin = Origin(program, source.span)
    parameters := CParametersOf(FunctionArgs(source))
    types := cast(*s32)Allocate(program, cast(usize)parameters.count, size_of(s32))
    index = 0
    while index < parameters.count && program.failed == 0 {
        parameter := ParameterAt(parameters, index)
        types[index] = Type(program, function, parameter.value_type, source.span)
        binding := AssemblyBinding.{name = Text(program, parameter.binding_name),
                                    type = types[index], value = -1, storage_type = -1}
        Push(program, cast(*RawVector)*function.bindings, size_of(AssemblyBinding),
             cast(*void)*binding)
        index += 1
    }
    parameter_parts := cast(*SliceParts)(*function.result.parameters)
    parameter_parts.data = cast(*void)types
    parameter_parts.length = cast(s64)parameters.count
    if !host && !FunctionVariants(program, function, source, -1, source.assembly_text, source.span) { return -1 }
    FindAddressed(program, function)
    identity := program.functions.count
    if Push(program, cast(*RawVector)*program.functions, size_of(*AssemblyFunction),
            cast(*void)*function) == false { return -1 }
    return identity
}

// A `#foreign host_api` declaration is a checked module import, not a
// function. Its signature-only function record is created once per import.
HostFunction :: (program: *AssemblyProgram, module: *IR.ZirModule, asked: *u8,
                 span: IR.ZirSourceSpan) -> s32 {
    import: *IR.ZirImport = null
    owner: *IR.ZirModule = null
    if ResolveQualifiedHostImportAt(module, asked, SVC.SpanPath(span), *owner, *import) < 0 {
        return Fail(program, span, "ambiguous imported host capability")
    }
    if owner == null { owner = module }
    index: s32 = 0
    while index < module.import_count && import == null {
        candidate := module.imports[index]
        if candidate.kind == ZirImportKind.EXTERN &&
           candidate.extern_kind == ZirExternKind.HOST &&
           IR.CText(*candidate.name[0]) == IR.CText(asked) {
            import = *module.imports[index]
        }
        index += 1
    }
    if import == null { return -1 }
    index = 0
    while index < program.functions.count {
        if program.functions.data[index].import == import { return index }
        index += 1
    }
    if memcmp(cast(*void)*import.target[0], cast(*void)SVC.Keep("ziran:"), 6) == 0 {
        provider_module: *IR.ZirModule = null
        provider: *IR.ZirFunction = null
        provider_name := *import.name[0]
        if import.extern_symbol[0] != 0 { provider_name = *import.extern_symbol[0] }
        module_index: s32 = 0
        while program.source != null && module_index < program.source.module_count {
            candidate_module := program.source.modules[module_index]
            if IR.CText(*candidate_module.name[0]) !=
               IR.CText(cast(*u8)(cast(usize)*import.target[0] + 6)) {
                module_index += 1
                continue
            }
            if provider_module != null {
                return Fail(program, span, "bound host provider module is ambiguous")
            }
            provider_module = *program.source.modules[module_index]
            module_index += 1
        }
        function_index: s32 = 0
        while provider_module != null && function_index < provider_module.function_count {
            candidate_function := provider_module.functions[function_index]
            if !IR.HostProviderVisible(*candidate_function) ||
               IR.CText(*candidate_function.name[0]) != IR.CText(provider_name) {
                function_index += 1
                continue
            }
            if provider != null {
                return Fail(program, span, "bound host provider procedure is ambiguous")
            }
            provider = *provider_module.functions[function_index]
            function_index += 1
        }
        if provider == null {
            return Fail(program, span, "bound host provider procedure is missing")
        }
        return Function(program, provider_module, provider)
    }
    if import.is_varargs != 0 {
        return Fail(program, span, "variadic host capabilities are not lowered")
    }
    signature := cast(*IR.ZirFunction)Allocate(program, 1, size_of(IR.ZirFunction))
    if signature == null { return -1 }
    // Whole arrays: both fields are fixed text of the same size in the
    // import and the signature.
    memcpy(cast(*void)*signature.name, cast(*void)*import.name[0],
           cast(usize)import.name.count)
    memcpy(cast(*void)*signature.return_type, cast(*void)*import.return_type[0],
           cast(usize)import.return_type.count)
    chosen := *import.name[0]
    if import.extern_symbol[0] != 0 { chosen = *import.extern_symbol[0] }
    memcpy(cast(*void)*signature.extern_symbol, cast(*void)chosen,
           strlen(chosen) + cast(usize)1)
    signature.args_text = SVC.KeepParameters(Owned(*import.args[0]))
    signature.is_extern = 1
    signature.extern_kind = ZirExternKind.HOST
    signature.span = import.span
    identity := Function(program, owner, signature)
    if identity >= 0 {
        program.functions.data[identity].import = import
    }
    return identity
}

// Lower one runtime module's initializers after its dependencies.
StartupModule :: (program: *AssemblyProgram, source: *IR.ZirProgram,
                  module_index: s32, state: *u8) -> s32 {
    module := *source.modules[module_index]
    if state[module_index] == 2 { return 1 }
    if state[module_index] == 1 {
        Fail(program, module.span, "cyclic runtime module initialization dependency")
        return 0
    }
    state[module_index] = 1
    import_index: s32 = 0
    while import_index < module.import_count {
        dependency := module.imports[import_index].resolved_module
        if dependency != null && CModuleNeedsStartup(dependency) == 1 {
            dependency_index: s32 = -1
            index: s32 = 0
            while index < source.module_count {
                if dependency == *source.modules[index] {
                    dependency_index = index
                    break
                }
                index += 1
            }
            if dependency_index < 0 {
                Fail(program, module.imports[import_index].span,
                     "runtime initializer dependency is outside the checked program")
                return 0
            }
            if StartupModule(program, source, dependency_index, state) == 0 { return 0 }
        }
        import_index += 1
    }
    function_index: s32 = 0
    while function_index < module.function_count {
        function := *module.functions[function_index]
        if function.is_global_initializer != 0 {
            identity := Function(program, module, *module.functions[function_index])
            if identity < 0 { return 0 }
            if Push(program, cast(*RawVector)*program.initializers, size_of(s32),
                    cast(*void)*identity) == false { return 0 }
        }
        function_index += 1
    }
    state[module_index] = 2
    return 1
}

StartupOwner :: (program: *AssemblyProgram, module: *IR.ZirModule, state: *u8) {
    offset := cast(usize)module - cast(usize)program.source.modules
    if offset % size_of(IR.ZirModule) != 0 ||
       offset / size_of(IR.ZirModule) >= cast(usize)program.source.module_count {
        Fail(program, module.span, "runtime initializer owner is outside the checked program")
        return
    }
    index := cast(s32)(offset / size_of(IR.ZirModule))
    if state[index] == 0 { StartupModule(program, program.source, index, state) }
}

DispatchModule :: "__zx_module_dispatch"

DispatchHost :: (program: *AssemblyProgram, module: *IR.ZirModule, span: IR.ZirSourceSpan,
                 name: *u8, spelling: *u8, result: s32, parameter: s32) -> s32 {
    host := cast(*AssemblyFunction)Allocate(program, 1, size_of(AssemblyFunction))
    if host == null { return -1 }
    host.module = module
    host.dispatch_type = spelling
    host.result = LIR.LirFunction.{
        module = Name(program, *program.modules, SVC.Keep(DispatchModule)),
        name = Owned(Text(program, name)), result = result, calling = LirCalling.Host,
        external = true, entry = -1, origin = Origin(program, span)}
    if parameter != 0 {
        types := cast(*s32)Allocate(program, 1, size_of(s32))
        if types == null { return -1 }
        <<types = parameter
        host.result.parameters = S32Items(types, 1)
    }
    identity := program.functions.count
    if PushFunctionPtr(program, *program.functions, host) { return identity }
    return -1
}

BuildDispatch :: (program: *AssemblyProgram, roots: *AssemblyExportRoot, count: s32) {
    entry := cast(*AssemblyFunction)Allocate(program, 1, size_of(AssemblyFunction))
    if entry == null { return }
    span := roots[0].function.span
    entry.result.module = Name(program, *program.modules, SVC.Keep(DispatchModule))
    entry.result.name = DispatchModule
    entry.result.origin = Origin(program, span)
    if !PushFunctionPtr(program, *program.functions, entry) { return }
    entry.result.entry = Block(program, entry, null, 0)
    if program.failed != 0 { return }
    Enter(entry, entry.result.entry, null, 0)
    Emit(program, entry, LirOp.Fuel, 0, null, 0, -1, span)
    select := DispatchHost(program, roots[0].module, span, SVC.Keep("select"), SVC.Keep("s32"), 6, 0)
    selected := Emit(program, entry, LirOp.HostCall, 6, null, 0, select, span)
    ordinal: s32 = 0
    while ordinal < count && program.failed == 0 {
        root := roots[ordinal]
        export_span := root.function.span
        called := Function(program, root.module, root.function)
        if called < 0 { return }
        signature := program.functions.data[called].result
        yes := Block(program, entry, null, 0)
        no := Block(program, entry, null, 0)
        matches := s32.[selected, Constant(program, entry, 6, cast(u64)ordinal, export_span)]
        match := Emit(program, entry, LirOp.Equal, 1, matches.data, 2, -1, export_span)
        Branch(program, entry, match, yes, no, 0, export_span)
        if program.failed != 0 { return }
        Enter(entry, yes, null, 0)
        parameters := CParametersOf(FunctionArgs(root.function))
        arguments := cast(*s32)Allocate(program, cast(usize)parameters.count, size_of(s32))
        if parameters.count > 0 && arguments == null { return }
        name: [48]u8
        index: s32 = 0
        while index < parameters.count && program.failed == 0 {
            parameter := ParameterAt(parameters, index)
            snprintf(*name[0], size_of([48]u8), SVC.Keep("arg_%d_%d"), ordinal, index)
            type := signature.parameters[index]
            host := DispatchHost(program, root.module, export_span, *name[0], parameter.value_type, type, 0)
            arguments[index] = Emit(program, entry, LirOp.HostCall, type, null, 0, host, export_span)
            index += 1
        }
        value := Emit(program, entry, LirOp.Call, signature.result, arguments, parameters.count, called, export_span)
        snprintf(*name[0], size_of([48]u8), SVC.Keep("result_%d"), ordinal)
        spelling := ifx signature.result != 0 then *root.function.return_type[0] else SVC.Keep("void")
        host := DispatchHost(program, root.module, export_span, *name[0], spelling, 0, signature.result)
        Emit(program, entry, LirOp.HostCall, 0, *value, ifx signature.result != 0 then 1 else 0, host, export_span)
        Emit(program, entry, LirOp.Return, 0, null, 0, -1, export_span)
        if program.failed != 0 { return }
        Enter(entry, no, null, 0)
        ordinal += 1
    }
    // A dispatcher can be invoked with an out-of-range ordinal by an embedder.
    Emit(program, entry, LirOp.Trap, 0, null, 0, -1, span)
}

LowerBody :: (program: *AssemblyProgram, builder: *AssemblyFunction) {
    count := builder.bindings.count
    entry_parameters := Snapshot(program, builder, count)
    entry := Block(program, builder, entry_parameters, count)
    if program.failed != 0 { return }
    builder.result.entry = entry
    Enter(builder, entry, entry_parameters, count)
    Emit(program, builder, LirOp.Fuel, 0, null, 0, -1, builder.source.span)
    if builder.result.assembly_required {
        Emit(program, builder, LirOp.Unreachable, 0, null, 0, -1, builder.source.stmts[0].span)
        return
    }
    parameter: s32 = 0
    while parameter < count && program.failed == 0 {
        binding := *builder.bindings.data[parameter]
        source_binding := builder.source.stmt_count + parameter
        addressed: bool = false
        if source_binding < builder.addressed_count &&
           builder.addressed[source_binding] != 0 { addressed = true }
        if addressed == true || KeptInStorage(program, binding.type) == 1 {
            PromoteBinding(program, builder, parameter, builder.source.span)
        }
        parameter += 1
    }
    if builder.initializes != 0 {
        symbol := builder.initializes - 1
        global := *program.globals.data[symbol]
        global_type := global.result.type
        root := *builder.source.exprs[builder.initializer_root]
        builder.literal_at = builder.initializer_root + 1
        builder.literal_type = global_type
        raw: s32 = -1
        if root.kind == ZirExprKind.COMPOUND {
            raw = Compound(program, builder,
                           *builder.source.exprs[builder.initializer_root],
                           global_type, 0)
        } else {
            raw = Expression(program, builder, builder.initializer_root, 0)
        }
        value := Convert(program, builder, raw, global_type, builder.source.span)
        operands: [2]s32
        operands[0] = Emit(program, builder, LirOp.GlobalAddress,
                           PointerType(program, global_type, builder.source.span),
                           null, 0, symbol, builder.source.span)
        operands[1] = value
        Emit(program, builder, LirOp.Store, 0, *operands[0], 2, -1, builder.source.span)
    }
    Sequence(program, builder, 0, builder.source.stmt_count, 0)
    if builder.current >= 0 && program.failed == 0 {
        if builder.result.result != 0 {
            Fail(program, builder.source.span,
                 "scalar procedure falls through without a return")
        } else {
            DropBindings(program, builder, 0, builder.source.span)
            Emit(program, builder, LirOp.Return, 0, null, 0, -1, builder.source.span)
        }
    }
}

LowerProgram :: (source: *IR.ZirProgram, module_name: *u8, function_name: *u8,
                 roots: *AssemblyExportRoot, root_count: s32) -> *AssemblyProgram {
    program := cast(*AssemblyProgram)calloc(1, size_of(AssemblyProgram))
    if program == null {
        DiagnosticOutOfMemory()
        return null
    }
    program.work = 16000000
    program.source = source
    void_type := LIR.LirType.{kind = LirTypeKind.Void}
    bool_type := LIR.LirType.{kind = LirTypeKind.Bool, bits = 1}
    Push(program, cast(*RawVector)*program.types, size_of(LIR.LirType), cast(*void)*void_type)
    Push(program, cast(*RawVector)*program.types, size_of(LIR.LirType), cast(*void)*bool_type)
    index: s32 = 0
    while index < 8 {
        integer_bits: s32 = 8 << (index / 2)
        integer_signed: bool = false
        if index % 2 == 0 { integer_signed = true }
        integer := LIR.LirType.{kind = LirTypeKind.Integer, bits = integer_bits,
                                is_signed = integer_signed}
        Push(program, cast(*RawVector)*program.types, size_of(LIR.LirType),
             cast(*void)*integer)
        index += 1
    }
    module: *IR.ZirModule = null
    function: *IR.ZirFunction = null
    index = 0
    while roots == null && index < source.module_count {
        candidate := source.modules[index]
        if IR.CText(*candidate.name[0]) == IR.CText(module_name) {
            if module != null {
                Fail(program, candidate.span, "ambiguous entry module")
                break
            }
            module = *source.modules[index]
        }
        index += 1
    }
    if module != null {
        index = 0
        while index < module.function_count {
            if IR.CText(*module.functions[index].name[0]) == IR.CText(function_name) {
                function = *module.functions[index]
            }
            index += 1
        }
    }
    if roots != null {
        BuildDispatch(program, roots, root_count)
    } else if function == null {
        missing: IR.ZirSourceSpan
        Fail(program, missing, "entry procedure was not found")
    } else if program.failed == 0 {
        Function(program, module, function)
    }
    // The entry module's globals are the program's exported state, so each
    // is lowered even when no reached code names it. A runtime initializer
    // is already a startup procedure; what is left is constant.
    index = 0
    while module != null && index < module.global_count && program.failed == 0 {
        GlobalSymbol(program, module, *module.globals[index], module.globals[index].span)
        index += 1
    }
    startup_state := cast(*u8)Allocate(program, cast(usize)source.module_count, cast(usize)1)
    if roots == null && program.failed == 0 {
        index = 0
        while index < source.module_count {
            if CModuleNeedsStartup(*source.modules[index]) == 1 {
                if StartupModule(program, source, index, startup_state) == 0 { break }
            }
            index += 1
        }
    }
    index = 0
    startup_global: s32 = 0
    while index < program.functions.count && program.failed == 0 {
        builder := program.functions.data[index]
        if builder.result.external == true {
            builder.result.entry = -1
            index += 1
            continue
        }
        if builder.source != null {
            if roots != null { StartupOwner(program, builder.module, startup_state) }
            if program.failed != 0 { break }
            LowerBody(program, builder)
        }
        if roots != null {
            while startup_global < program.globals.count && program.failed == 0 {
                global := *program.globals.data[startup_global]
                if global.source != null { StartupOwner(program, global.module, startup_state) }
                startup_global += 1
            }
        }
        blocks := cast(*LIR.LirBlock)Allocate(program, cast(usize)builder.blocks.count,
                                              size_of(LIR.LirBlock))
        if program.failed != 0 { break }
        block: s32 = 0
        while block < builder.blocks.count {
            body := BlockAt(builder, block)
            built := LIR.LirBlock.{parameters = SliceOf(body.parameters),
                                   instructions = LirInstructionItems(body.instructions.data,
                                                                      cast(s64)body.instructions.count)}
            memcpy(cast(*void)*blocks[block], cast(*void)*built, size_of(LIR.LirBlock))
            block += 1
        }
        block_parts := cast(*SliceParts)(*builder.result.blocks)
        block_parts.data = cast(*void)blocks
        block_parts.length = cast(s64)builder.blocks.count
        value_parts := cast(*SliceParts)(*builder.result.values)
        value_parts.data = cast(*void)builder.values.data
        value_parts.length = cast(s64)builder.values.count
        index += 1
    }
    functions := cast(*LIR.LirFunction)Allocate(program, cast(usize)program.functions.count,
                                                size_of(LIR.LirFunction))
    globals := cast(*LIR.LirGlobal)Allocate(program, cast(usize)program.globals.count,
                                            size_of(LIR.LirGlobal))
    // Constant initializers run first, so module startup code and other
    // initializers read initialized globals.
    initializers: Vector(s32)
    index = 0
    while index < program.constant_initializers.count {
        value := program.constant_initializers.data[index]
        Push(program, cast(*RawVector)*initializers, size_of(s32), cast(*void)*value)
        index += 1
    }
    index = 0
    while index < program.initializers.count {
        value := program.initializers.data[index]
        Push(program, cast(*RawVector)*initializers, size_of(s32), cast(*void)*value)
        index += 1
    }
    if program.failed == 0 {
        index = 0
        while index < program.functions.count {
            built := program.functions.data[index].result
            memcpy(cast(*void)*functions[index], cast(*void)*built, size_of(LIR.LirFunction))
            index += 1
        }
        index = 0
        while index < program.globals.count {
            built := program.globals.data[index].result
            memcpy(cast(*void)*globals[index], cast(*void)*built, size_of(LIR.LirGlobal))
            index += 1
        }
        program.result.version = LIR.LirVersion
        program.result.checks = program.source.checks != 0
        module_parts := cast(*SliceParts)(*program.result.modules)
        module_parts.data = cast(*void)program.modules.data
        module_parts.length = cast(s64)program.modules.count
        source_parts := cast(*SliceParts)(*program.result.sources)
        source_parts.data = cast(*void)program.sources.data
        source_parts.length = cast(s64)program.sources.count
        type_parts := cast(*SliceParts)(*program.result.types)
        type_parts.data = cast(*void)program.types.data
        type_parts.length = cast(s64)program.types.count
        constant_parts := cast(*SliceParts)(*program.result.constants)
        constant_parts.data = cast(*void)program.constants.data
        constant_parts.length = cast(s64)program.constants.count
        global_parts := cast(*SliceParts)(*program.result.globals)
        global_parts.data = cast(*void)globals
        global_parts.length = cast(s64)program.globals.count
        function_parts := cast(*SliceParts)(*program.result.functions)
        function_parts.data = cast(*void)functions
        function_parts.length = cast(s64)program.functions.count
        origin_parts := cast(*SliceParts)(*program.result.origins)
        origin_parts.data = cast(*void)program.origins.data
        origin_parts.length = cast(s64)program.origins.count
        initializer_parts := cast(*SliceParts)(*program.result.initializers)
        initializer_parts.data = cast(*void)initializers.data
        initializer_parts.length = cast(s64)initializers.count
        program.result.entry = 0
    }
    if program.failed != 0 {
        FreeProgram(program)
        return null
    }
    return program
}

#scope_export

#program_export "AssemblyLower"
Lower :: (source: *IR.ZirProgram, module_name: *u8, function_name: *u8) -> *AssemblyProgram {
    return LowerProgram(source, module_name, function_name, null, 0)
}

#program_export "AssemblyLowerModule"
LowerModule :: (source: *IR.ZirProgram, roots: *AssemblyExportRoot, count: s32) -> *AssemblyProgram {
    if roots == null || count <= 0 { return null }
    return LowerProgram(source, null, null, roots, count)
}

#program_export "AssemblyView"
View :: (program: *AssemblyProgram) -> *LIR.LirProgram {
    return *program.result
}

#program_export "AssemblyFree"
FreeProgram :: (program: *AssemblyProgram) {
    if program == null { return }
    index: s32 = 0
    while index < program.probes.count {
        probe := program.probes.data[index]
        free(cast(*void)probe.exprs)
        index += 1
    }
    allocation := program.allocations
    while allocation != null {
        next := allocation.next
        free(cast(*void)allocation)
        allocation = next
    }
    free(cast(*void)program.interface)
    free(cast(*void)program)
}

#scope_file

// Growable host-interface text; plain heap blocks the module frees itself.
InterfaceText :: struct {
    data: *u8
    length: usize
    capacity: usize
    failed: s32
    // The type that could not be described, when one could not.
    type: [IR.ZIR_NAME_MAX]u8
}

InterfaceNode :: struct {
    module: *IR.ZirModule
    spelling: *u8
    id: s32
    line: InterfaceText
}

// Signed decimal into a caller buffer, NUL-terminated.
NumberBytes :: (buffer: *u8, value: s64) -> *u8 {
    negative: bool = false
    remaining := value
    if remaining < 0 {
        negative = true
        remaining = 0 - remaining
    }
    digits: [20]u8
    at: s32 = 20
    if remaining == 0 {
        at = 19
        digits[19] = 48
    }
    while remaining > 0 {
        at -= 1
        digits[at] = cast(u8)(48 + remaining % 10)
        remaining /= 10
    }
    count: s32 = 0
    if negative == true {
        buffer[0] = 45
        count = 1
    }
    while at < 20 {
        buffer[count] = digits[at]
        count += 1
        at += 1
    }
    buffer[count] = 0
    return buffer
}

PutTab :: (text: *InterfaceText) {
    piece: [2]u8
    piece[0] = 9
    piece[1] = 0
    InterfacePut(text, *piece[0])
}

PutNewline :: (text: *InterfaceText) {
    piece: [2]u8
    piece[0] = 10
    piece[1] = 0
    InterfacePut(text, *piece[0])
}

InterfacePut :: (text: *InterfaceText, part: *u8) {
    length := strlen(part)
    if text.failed != 0 { return }
    if text.length + length + 1 > text.capacity {
        capacity: usize = 256
        if text.capacity != 0 { capacity = text.capacity }
        while capacity < text.length + length + 1 { capacity *= 2 }
        grown := realloc(cast(*void)text.data, capacity)
        if grown == null {
            text.failed = 1
            return
        }
        text.data = cast(*u8)grown
        text.capacity = capacity
    }
    memcpy(cast(*void)(cast(usize)text.data + text.length), cast(*void)part, length + 1)
    text.length += length
}

// Declare text with its tabs and line ends as spaces.
InterfaceSpelling :: (text: *InterfaceText, part: *u8) {
    piece: [2]u8
    piece[1] = 0
    at := part
    while at[0] != 0 && text.failed == 0 {
        character := at[0]
        if character == 9 || character == 10 || character == 13 { character = 32 }
        piece[0] = character
        InterfacePut(text, *piece[0])
        at = cast(*u8)(cast(usize)at + 1)
    }
}

InterfaceField :: (text: *InterfaceText, part: *u8) {
    PutTab(text)
    InterfaceSpelling(text, part)
}

InterfaceReject :: (text: *InterfaceText, spelling: *u8) {
    if text.failed != 0 { return }
    text.failed = 1
    length := strlen(spelling)
    if length > cast(usize)127 { length = cast(usize)127 }
    memcpy(cast(*void)*text.type, cast(*void)spelling, length)
    text.type[length] = 0
}

ClassText :: (class_id: s32) -> *u8 {
    if class_id == 1 { return SVC.Keep("array") }
    if class_id == 2 { return SVC.Keep("slice") }
    if class_id == 3 { return SVC.Keep("string") }
    if class_id == 4 { return SVC.Keep("pointer") }
    if class_id == 5 { return SVC.Keep("procedure") }
    if class_id == 6 { return SVC.Keep("record") }
    return SVC.Keep("scalar")
}

// Host values identify nominal types by their defining module, independent
// of the import alias used by the foreign declaration. Containers retain
// their shape and apply the same identity to their element type.
InterfaceTypeName :: (program: *AssemblyProgram, module: *IR.ZirModule,
                      spelling: *u8, depth: s32) -> *u8 {
    if depth > 64 { return spelling }
    spelled := IR.CText(spelling)
    element: [IR.ZIR_NAME_MAX]u8
    count: s32 = 0
    prefix: *u8 = null
    if CArrayElementType(spelling, *element[0], cast(usize)IR.ZIR_NAME_MAX, *count) == 1 ||
       CSliceElementType(spelling, *element[0], cast(usize)IR.ZIR_NAME_MAX) == 1 {
        close: usize = 0
        while spelling[close] != 0 && spelling[close] != 93 { close += 1 }
        prefix = cast(*u8)Allocate(program, close + 2, 1)
        if prefix == null { return spelling }
        memcpy(cast(*void)prefix, cast(*void)spelling, close + 1)
        prefix[close + 1] = 0
    } else if spelled.count > 0 && spelled[0] == cast(u8)42 {
        prefix = SVC.Keep("*")
        length := strlen(spelling)
        if length >= cast(usize)IR.ZIR_NAME_MAX { return spelling }
        memcpy(cast(*void)*element[0], cast(*void)(cast(usize)spelling + 1), length)
    }
    text: InterfaceText
    if prefix != null {
        InterfacePut(*text, prefix)
        InterfacePut(*text, InterfaceTypeName(program, module, *element[0], depth + 1))
    } else {
        owner := module
        record := CFindType(module, spelling, *owner)
        if record == null { return spelling }
        InterfacePut(*text, *owner.name[0])
        InterfacePut(*text, SVC.Keep("."))
        InterfacePut(*text, *record.name[0])
    }
    if text.failed != 0 {
        program.failed = 1
        free(cast(*void)text.data)
        return spelling
    }
    result := Text(program, text.data)
    free(cast(*void)text.data)
    return result
}

// interface_node: one host-interface node, deduplicated by module and
// spelling. The id is taken before children are described, so a type that
// reaches itself finds its own node.
DescribeNode :: (program: *AssemblyProgram, text: *InterfaceText,
                 nodes: *Vector(InterfaceNode), module: *IR.ZirModule,
                 spelling: *u8, depth: s32) -> s32 {
    if text.failed != 0 { return -1 }
    known := nodes.data
    index: s32 = 0
    while index < nodes.count {
        held := *known[index]
        if held.module == module && strcmp(held.spelling, spelling) == 0 { return held.id }
        index += 1
    }
    if depth > 64 {
        InterfaceReject(text, spelling)
        return -1
    }
    id := nodes.count
    reserved: InterfaceNode
    reserved.module = module
    reserved.spelling = Text(program, spelling)
    reserved.id = id
    if program.failed != 0 ||
       Push(program, cast(*RawVector)nodes, size_of(InterfaceNode), cast(*void)*reserved) == false {
        text.failed = 1
        return -1
    }
    element: [IR.ZIR_NAME_MAX]u8
    count: s32 = 0
    child: s32 = -1
    class_id: s32 = 0
    vector: ZirVector
    owner := module
    record: *IR.ZirType = null
    if CVectorType(spelling, *vector) == 1 {
        class_id = 1
        child = DescribeNode(program, text, nodes, module, vector.lane, depth + 1)
    } else if CArrayElementType(spelling, *element[0], cast(usize)IR.ZIR_NAME_MAX, *count) == 1 {
        class_id = 1
        child = DescribeNode(program, text, nodes, module, *element[0], depth + 1)
    } else if CSliceElementType(spelling, *element[0], cast(usize)IR.ZIR_NAME_MAX) == 1 {
        class_id = 2
        child = DescribeNode(program, text, nodes, module, *element[0], depth + 1)
    } else {
        spelled := IR.CText(spelling)
        if spelled == "string" {
            class_id = 3
        } else if spelled.count > 0 && spelled[0] == cast(u8)42 {
            class_id = 4
        } else if spelled.count > 0 && spelled[0] == cast(u8)40 {
            class_id = 5
        } else if ScalarWidth(spelling) == 0 && spelled != "bool" && spelled != "float32" &&
                  spelled != "float64" {
            found := CFindType(module, spelling, *owner)
            if found != null && found.is_enum == 0 && found.is_union == 0 {
                record = found
                if found.is_procedure_type != 0 { class_id = 5 } else { class_id = 6 }
            }
        }
    }
    if record != null && record.is_procedure_type != 0 { record = null }
    fields: Vector(s32)
    if record != null {
        cursor: usize = 0
        field: IR.ZirTypeField
        status: s32 = 1
        while status == 1 && text.failed == 0 {
            status = CTypeNextField(record, *cursor, *field)
            if status == 1 {
                node := DescribeNode(program, text, nodes, owner, *field.type[0], depth + 1)
                PushS32(program, *fields, node)
            }
        }
        if status < 0 { InterfaceReject(text, spelling) }
    }
    if text.failed != 0 || program.failed != 0 {
        text.failed = 1
        return -1
    }
    line: InterfaceText
    number: [24]u8
    InterfacePut(*line, SVC.Keep("node"))
    PutTab(*line)
    InterfacePut(*line, NumberBytes(*number[0], cast(s64)id))
    PutTab(*line)
    InterfacePut(*line, ClassText(class_id))
    PutTab(*line)
    InterfacePut(*line, InterfaceTypeName(program, module, spelling, 0))
    if child >= 0 {
        PutTab(*line)
        InterfacePut(*line, NumberBytes(*number[0], cast(s64)child))
    }
    if record != null {
        cursor: usize = 0
        field: IR.ZirTypeField
        field_items := SliceOf(fields)
        field_index: s32 = 0
        while field_index < fields.count && CTypeNextField(record, *cursor, *field) == 1 {
            PutTab(*line)
            InterfacePut(*line, *field.name[0])
            PutTab(*line)
            InterfacePut(*line, NumberBytes(*number[0], cast(s64)field_items[field_index]))
            field_index += 1
        }
    }
    PutNewline(*line)
    stored := *nodes.data[id]
    stored.line = line
    if line.failed != 0 { text.failed = 1 }
    return id
}

#scope_export

#program_export "AssemblyHostInterface"
HostInterface :: (program: *AssemblyProgram, length: *usize) -> *u8 {
    <<length = cast(usize)0
    if program == null || program.failed != 0 { return null }
    if program.interface != null {
        <<length = program.interface_length
        return program.interface
    }
    text: InterfaceText
    nodes: Vector(InterfaceNode)
    functions := program.functions.data
    hosts: InterfaceText
    // The declaration being described, for a diagnostic.
    span: IR.ZirSourceSpan
    index: s32 = 0
    number: [24]u8
    while index < program.functions.count && text.failed == 0 {
        function := functions[index]
        if !function.result.external || (function.dispatch_type == null &&
           (function.source == null || function.source.is_extern == 0 ||
            function.source.extern_kind != ZirExternKind.HOST)) {
            index += 1
            continue
        }
        source := function.source
        spelling := SVC.Keep("void")
        parameters: *ZirParameters = null
        if source != null {
            span = source.span
            spelling = *source.return_type[0]
            parameters = CParametersOf(FunctionArgs(source))
        } else if function.result.result != 0 {
            spelling = function.dispatch_type
        }
        result: s32 = -1
        if spelling[0] != cast(u8)0 && IR.CText(spelling) != "void" {
            result = DescribeNode(program, *text, *nodes, function.module, spelling, 0)
        }
        InterfacePut(*hosts, SVC.Keep("host"))
        PutTab(*hosts)
        InterfacePut(*hosts, NumberBytes(*number[0], cast(s64)index))
        PutTab(*hosts)
        InterfacePut(*hosts, NumberBytes(*number[0], cast(s64)result))
        at: s32 = 0
        while at < cast(s32)function.result.parameters.count && text.failed == 0 {
            parameter_type := function.dispatch_type
            if parameters != null { parameter_type = ParameterAt(parameters, at).value_type }
            node := DescribeNode(program, *text, *nodes, function.module,
                                 parameter_type, 0)
            PutTab(*hosts)
            InterfacePut(*hosts, NumberBytes(*number[0], cast(s64)node))
            at += 1
        }
        PutNewline(*hosts)
        // The declaration as written, which two builds must share to be
        // swapped for each other.
        module := function.module
        declared: *IR.ZirImport = null
        at = 0
        while source != null && at < module.import_count && declared == null {
            candidate := *module.imports[at]
            if strcmp(*candidate.name[0], *source.name[0]) == 0 { declared = candidate }
            at += 1
        }
        varargs_flag: s32 = 0
        reads_flag: s32 = 0
        if declared != null && declared.is_varargs != 0 { varargs_flag = 1 }
        if declared != null && declared.reads_arguments != 0 { reads_flag = 1 }
        InterfacePut(*hosts, SVC.Keep("abi"))
        PutTab(*hosts)
        InterfacePut(*hosts, NumberBytes(*number[0], cast(s64)index))
        PutTab(*hosts)
        InterfacePut(*hosts, NumberBytes(*number[0], cast(s64)varargs_flag))
        PutTab(*hosts)
        InterfacePut(*hosts, NumberBytes(*number[0], cast(s64)reads_flag))
        if declared != null {
            InterfaceField(*hosts, *declared.signature[0])
            InterfaceField(*hosts, *declared.args[0])
            InterfaceField(*hosts, *declared.return_type[0])
        } else if source != null {
            InterfaceField(*hosts, SVC.Keep(""))
            InterfaceField(*hosts, FunctionArgs(source))
            InterfaceField(*hosts, spelling)
        } else {
            PutTab(*hosts)
            PutTab(*hosts)
            if function.result.parameters.count != 0 {
                InterfacePut(*hosts, SVC.Keep("value: "))
                InterfaceSpelling(*hosts, function.dispatch_type)
            }
            InterfaceField(*hosts, spelling)
        }
        PutNewline(*hosts)
        index += 1
    }
    // Module globals; string bytes have no declaration.
    globals := program.globals.data
    index = 0
    while index < program.globals.count && text.failed == 0 {
        global := *globals[index]
        if global.source == null { index += 1; continue }
        span = global.source.span
        node := DescribeNode(program, *text, *nodes, global.module,
                             *global.source.type[0], 0)
        InterfacePut(*hosts, SVC.Keep("global"))
        PutTab(*hosts)
        InterfacePut(*hosts, NumberBytes(*number[0], cast(s64)index))
        PutTab(*hosts)
        InterfacePut(*hosts, NumberBytes(*number[0], cast(s64)node))
        PutNewline(*hosts)
        index += 1
    }
    if program.functions.count > 0 {
        entry := functions[0]
        if entry.source != null {
            InterfacePut(*hosts, SVC.Keep("entry"))
            InterfaceField(*hosts, FunctionArgs(entry.source))
            InterfaceField(*hosts, *entry.source.return_type[0])
            PutNewline(*hosts)
        } else {
            InterfacePut(*hosts, SVC.Keep("entry\t\tvoid\n"))
        }
    }
    described := nodes.data
    index = 0
    while index < nodes.count {
        held := *described[index]
        if held.line.data != null { InterfacePut(*text, held.line.data) }
        free(cast(*void)held.line.data)
        index += 1
    }
    if hosts.data != null { InterfacePut(*text, hosts.data) }
    free(cast(*void)hosts.data)
    if text.failed != 0 || hosts.failed != 0 || program.failed != 0 {
        if text.type[0] != cast(u8)0 {
            Diagnostic(span, SVC.Keep("assembly.container"),
                       SVC.Keep("the host interface cannot describe type %s"),
                       *text.type[0])
        }
        if text.type[0] == cast(u8)0 && program.failed == 0 {
            DiagnosticOutOfMemory()
        }
        free(cast(*void)text.data)
        program.failed = 1
        return null
    }
    program.interface = text.data
    program.interface_length = text.length
    <<length = text.length
    return text.data
}

#scope_file

// assembly_print_string: quoted host text with escapes for the printer.
PrintString :: (output: *void, value: string) {
    parts := cast(*TextParts)(*value)
    bytes := parts.data
    count := parts.length
    fputc_raw(34, output)
    index: usize = 0
    while index < count {
        byte := bytes[index]
        if byte == cast(u8)34 || byte == cast(u8)92 {
            fputc_raw(92, output)
            fputc_raw(cast(s32)byte, output)
        } else if byte < cast(u8)32 || byte >= cast(u8)127 {
            fputc_raw(92, output)
            fputc_raw(120, output)
            wide := cast(s32)byte
            fputc_raw(HexDigit(wide / 16), output)
            fputc_raw(HexDigit(wide % 16), output)
        } else {
            fputc_raw(cast(s32)byte, output)
        }
        index += 1
    }
    fputc_raw(34, output)
}

HexDigit :: (digit: s32) -> s32 {
    if digit < 10 { return 48 + digit }
    return 87 + digit
}

PrintHexByte :: (output: *void, value: u8) {
    wide := cast(s32)value
    fputc_raw(HexDigit(wide / 16), output)
    fputc_raw(HexDigit(wide % 16), output)
}

PrintText :: (output: *void, text: *u8) {
    fwrite_raw(cast(*void)text, cast(usize)1, strlen(text), output)
}

PrintSigned :: (output: *void, value: s64) {
    buffer: [24]u8
    digits := NumberBytes(*buffer[0], value)
    fwrite_raw(cast(*void)digits, cast(usize)1, strlen(digits), output)
}

PrintHex64 :: (output: *void, value: u64) {
    shift: s32 = 60
    while shift >= 0 {
        digit := cast(s32)((value >> cast(u64)shift) & cast(u64)15)
        fputc_raw(HexDigit(digit), output)
        shift -= 4
    }
}

#scope_export

#program_export "AssemblyPrintLir"
PrintLir :: (view: *LIR.LirProgram, output: *void) -> s32 {
    PrintText(output, SVC.Keep("lir "))
    PrintSigned(output, cast(s64)view.version)
    PrintText(output, SVC.Keep(" entry @"))
    PrintSigned(output, cast(s64)view.entry)
    if view.checks { PrintText(output, SVC.Keep(" checks")) }
    fputc_raw(10, output)
    index: s64 = 0
    while index < view.modules.count {
        PrintText(output, SVC.Keep("module m"))
        PrintSigned(output, index)
        fputc_raw(32, output)
        PrintString(output, view.modules[index])
        fputc_raw(10, output)
        index += 1
    }
    index = 0
    while index < view.sources.count {
        PrintText(output, SVC.Keep("source s"))
        PrintSigned(output, index)
        fputc_raw(32, output)
        PrintString(output, view.sources[index])
        fputc_raw(10, output)
        index += 1
    }
    index = 0
    while index < view.types.count {
        ty := *view.types[index]
        signed_flag: s32 = 0
        native_flag: s32 = 0
        if ty.is_signed == true { signed_flag = 1 }
        if ty.native_width == true { native_flag = 1 }
        PrintText(output, SVC.Keep("type t"))
        PrintSigned(output, index)
        PrintText(output, SVC.Keep(" kind="))
        PrintSigned(output, cast(s64)cast(s32)ty.kind)
        PrintText(output, SVC.Keep(" bits="))
        PrintSigned(output, cast(s64)ty.bits)
        PrintText(output, SVC.Keep(" signed="))
        PrintSigned(output, cast(s64)signed_flag)
        PrintText(output, SVC.Keep(" native="))
        PrintSigned(output, cast(s64)native_flag)
        PrintText(output, SVC.Keep(" element=t"))
        PrintSigned(output, cast(s64)ty.element)
        PrintText(output, SVC.Keep(" count="))
        PrintSigned(output, ty.count)
        PrintText(output, SVC.Keep(" result=t"))
        PrintSigned(output, cast(s64)ty.result)
        PrintText(output, SVC.Keep(" fields=("))
        field: s64 = 0
        while field < ty.fields.count {
            if field > 0 { fputc_raw(44, output) }
            fputc_raw(116, output)
            PrintSigned(output, cast(s64)ty.fields[field])
            field += 1
        }
        PrintText(output, SVC.Keep(") parameters=("))
        parameter: s64 = 0
        while parameter < ty.parameters.count {
            if parameter > 0 { fputc_raw(44, output) }
            fputc_raw(116, output)
            PrintSigned(output, cast(s64)ty.parameters[parameter])
            parameter += 1
        }
        PrintText(output, SVC.Keep(")\n"))
        index += 1
    }
    index = 0
    while index < view.constants.count {
        constant := *view.constants[index]
        PrintText(output, SVC.Keep("constant c"))
        PrintSigned(output, index)
        PrintText(output, SVC.Keep(":t"))
        PrintSigned(output, cast(s64)constant.type)
        PrintText(output, SVC.Keep(" = 0x"))
        PrintHex64(output, constant.bits)
        PrintText(output, SVC.Keep(" bytes="))
        offset: s64 = 0
        while offset < constant.bytes.count {
            PrintHexByte(output, constant.bytes[offset])
            offset += 1
        }
        fputc_raw(10, output)
        index += 1
    }
    index = 0
    while index < view.globals.count {
        global := *view.globals[index]
        writable_flag: s32 = 0
        if global.writable == true { writable_flag = 1 }
        PrintText(output, SVC.Keep("global g"))
        PrintSigned(output, index)
        PrintText(output, SVC.Keep(":t"))
        PrintSigned(output, cast(s64)global.type)
        PrintText(output, SVC.Keep(" module=m"))
        PrintSigned(output, cast(s64)global.module)
        PrintText(output, SVC.Keep(" constant=c"))
        PrintSigned(output, cast(s64)global.constant)
        PrintText(output, SVC.Keep(" writable="))
        PrintSigned(output, cast(s64)writable_flag)
        PrintText(output, SVC.Keep(" name="))
        PrintString(output, global.name)
        fputc_raw(10, output)
        index += 1
    }
    index = 0
    while index < view.origins.count {
        origin := *view.origins[index]
        PrintText(output, SVC.Keep("origin o"))
        PrintSigned(output, index)
        PrintText(output, SVC.Keep(" source=s"))
        PrintSigned(output, cast(s64)origin.file)
        PrintText(output, SVC.Keep(" line="))
        PrintSigned(output, cast(s64)origin.line)
        PrintText(output, SVC.Keep(" column="))
        PrintSigned(output, cast(s64)origin.column)
        PrintText(output, SVC.Keep(" end_line="))
        PrintSigned(output, cast(s64)origin.end_line)
        PrintText(output, SVC.Keep(" end_column="))
        PrintSigned(output, cast(s64)origin.end_column)
        PrintText(output, SVC.Keep(" begin="))
        PrintSigned(output, origin.begin)
        PrintText(output, SVC.Keep(" end="))
        PrintSigned(output, origin.end)
        PrintText(output, SVC.Keep(" parent=o"))
        PrintSigned(output, cast(s64)origin.parent)
        fputc_raw(10, output)
        index += 1
    }
    function: s64 = 0
    while function < view.functions.count {
        body := *view.functions[function]
        external_flag: s32 = 0
        variadic_flag: s32 = 0
        if body.external == true { external_flag = 1 }
        if body.variadic == true { variadic_flag = 1 }
        PrintText(output, SVC.Keep("function @"))
        PrintSigned(output, function)
        PrintText(output, SVC.Keep(" module=m"))
        PrintSigned(output, cast(s64)body.module)
        PrintText(output, SVC.Keep(" name="))
        PrintString(output, body.name)
        PrintText(output, SVC.Keep(" result=t"))
        PrintSigned(output, cast(s64)body.result)
        PrintText(output, SVC.Keep(" entry=b"))
        PrintSigned(output, cast(s64)body.entry)
        PrintText(output, SVC.Keep(" calling="))
        PrintSigned(output, cast(s64)cast(s32)body.calling)
        PrintText(output, SVC.Keep(" external="))
        PrintSigned(output, cast(s64)external_flag)
        PrintText(output, SVC.Keep(" variadic="))
        PrintSigned(output, cast(s64)variadic_flag)
        PrintText(output, SVC.Keep(" origin=o"))
        PrintSigned(output, cast(s64)body.origin)
        PrintText(output, SVC.Keep(" parameters=("))
        parameter: s64 = 0
        while parameter < body.parameters.count {
            if parameter > 0 { fputc_raw(44, output) }
            fputc_raw(116, output)
            PrintSigned(output, cast(s64)body.parameters[parameter])
            parameter += 1
        }
        PrintText(output, SVC.Keep(") values=("))
        value: s64 = 0
        while value < body.values.count {
            if value > 0 { fputc_raw(44, output) }
            PrintText(output, SVC.Keep("v"))
            PrintSigned(output, value)
            PrintText(output, SVC.Keep(":t"))
            PrintSigned(output, cast(s64)body.values[value])
            value += 1
        }
        PrintText(output, SVC.Keep(")\n"))
        for variant, ordinal: body.variants {
            PrintText(output, SVC.Keep("  assembly "))
            PrintSigned(output, ordinal)
            if body.assembly_required { PrintText(output, SVC.Keep(" target-only")) }
            if body.assembly_gate { PrintText(output, SVC.Keep(" local")) }
            if variant.volatile { PrintText(output, SVC.Keep(" volatile")) }
            PrintText(output, SVC.Keep(" arch="))
            PrintString(output, variant.architecture)
            PrintText(output, SVC.Keep(" os="))
            PrintString(output, variant.os)
            PrintText(output, SVC.Keep(" abi="))
            PrintString(output, variant.abi)
            PrintText(output, SVC.Keep(" features=0x"))
            PrintHex64(output, variant.features)
            PrintText(output, SVC.Keep(" outputs="))
            PrintSigned(output, cast(s64)variant.outputs)
            PrintText(output, SVC.Keep(" clobbers="))
            PrintString(output, variant.clobbers)
            PrintText(output, SVC.Keep(" operands=("))
            for operand, index: variant.operands {
                if index != 0 { fputc_raw(44, output) }
                PrintString(output, operand.alias)
                fputc_raw(58, output)
                PrintString(output, operand.constraint)
            }
            PrintText(output, SVC.Keep(") template="))
            PrintString(output, variant.template)
            fputc_raw(10, output)
        }
        block: s64 = 0
        while block < body.blocks.count {
            bp := *body.blocks[block]
            PrintText(output, SVC.Keep("  b"))
            PrintSigned(output, block)
            fputc_raw(40, output)
            block_parameter: s64 = 0
            while block_parameter < bp.parameters.count {
                if block_parameter > 0 {
                    fputc_raw(44, output)
                    fputc_raw(32, output)
                }
                held_parameter := bp.parameters[block_parameter]
                PrintText(output, SVC.Keep("v"))
                PrintSigned(output, cast(s64)held_parameter)
                PrintText(output, SVC.Keep(":t"))
                PrintSigned(output, cast(s64)body.values[held_parameter])
                block_parameter += 1
            }
            PrintText(output, SVC.Keep("):\n"))
            instruction: s64 = 0
            while instruction < bp.instructions.count {
                ip := *bp.instructions[instruction]
                PrintText(output, SVC.Keep("    i"))
                PrintSigned(output, instruction)
                fputc_raw(32, output)
                if ip.result >= 0 {
                    PrintText(output, SVC.Keep("v"))
                    PrintSigned(output, cast(s64)ip.result)
                    PrintText(output, SVC.Keep(":t"))
                    PrintSigned(output, cast(s64)body.values[ip.result])
                    PrintText(output, SVC.Keep(" = "))
                }
                opname := LIR.LirOpName(ip.op)
                op_parts := cast(*TextParts)(*opname)
                fwrite_raw(cast(*void)op_parts.data, cast(usize)1,
                           cast(usize)op_parts.length, output)
                operand: s64 = 0
                while operand < ip.operands.count {
                    PrintText(output, SVC.Keep(" v"))
                    PrintSigned(output, cast(s64)ip.operands[operand])
                    operand += 1
                }
                if ip.symbol >= 0 {
                    PrintText(output, SVC.Keep(" symbol="))
                    PrintSigned(output, cast(s64)ip.symbol)
                }
                PrintText(output, SVC.Keep(" immediate="))
                PrintSigned(output, cast(s64)ip.immediate)
                PrintText(output, SVC.Keep(" alignment="))
                PrintSigned(output, cast(s64)ip.alignment)
                edge: s64 = 0
                while edge < ip.edges.count {
                    held_edge := *ip.edges[edge]
                    PrintText(output, SVC.Keep(" -> b"))
                    PrintSigned(output, cast(s64)held_edge.block)
                    fputc_raw(40, output)
                    argument: s64 = 0
                    while argument < held_edge.arguments.count {
                        if argument > 0 { fputc_raw(44, output) }
                        PrintText(output, SVC.Keep("v"))
                        PrintSigned(output, cast(s64)held_edge.arguments[argument])
                        argument += 1
                    }
                    fputc_raw(41, output)
                    edge += 1
                }
                PrintText(output, SVC.Keep(" effect="))
                PrintSigned(output, cast(s64)ip.effect)
                PrintText(output, SVC.Keep(" origin=o"))
                PrintSigned(output, cast(s64)ip.origin)
                if ip.checked { PrintText(output, SVC.Keep(" checked")) }
                fputc_raw(10, output)
                instruction += 1
            }
            block += 1
        }
        function += 1
    }
    if ferror_raw(output) == 0 { return 1 }
    return 0
}
