// ZIR -> LIR lowering: the portable engine's scalar programs. This module
// ports cmd/zi2zx/zir_asm_lower.c: one checked ZIR program becomes a
// LirProgram of scalar values, blocks and instructions that the verified-ZX
// writers and the native pipeline consume. Callers keep an AssemblyProgram
// alive while they read its view and free it with Free.
//
// The lowering allocates every buffer from a program-lifetime arena: values
// borrowed by early-taken slices (block parameters, instruction operands,
// constant bytes) must stay live even after their builder vector grows on.
// Only HostInterface text uses plain heap blocks it frees itself.
using IR :: #import "compiler_ir"
using LIR :: #import "compiler_lowered_ir"
using SVC :: #import "compiler_services"

#scope_file

libc :: #system_library "libc";
compiler :: #system_library "ziran";

calloc :: (count: usize, size: usize) -> *void #foreign libc "calloc";
realloc :: (memory: *void, size: usize) -> *void #foreign libc "realloc";
free :: (memory: *void) #foreign libc "free";
memcpy :: (destination: *void, source: *void, count: usize) -> *void #foreign libc "memcpy";
memmove :: (destination: *void, source: *void, count: usize) -> *void #foreign libc "memmove";
strlen :: (text: *u8) -> usize #foreign libc "strlen";
strcmp :: (left: *u8, right: *u8) -> s32 #foreign libc "strcmp";
snprintf :: (buffer: *u8, size: usize, format: *u8, args: ..any) -> s32 #foreign libc "snprintf";
memcmp :: (left: *void, right: *void, count: usize) -> s32 #foreign libc "memcmp";
strrchr :: (text: *u8, character: s32) -> *u8 #foreign libc "strrchr";
strchr :: (text: *u8, character: s32) -> *u8 #foreign libc "strchr";
fwrite_raw :: (data: *void, size: usize, count: usize, stream: *void) -> usize #foreign libc "fwrite";
fputc_raw :: (character: s32, stream: *void) -> s32 #foreign libc "fputc";
ferror_raw :: (stream: *void) -> s32 #foreign libc "ferror";

