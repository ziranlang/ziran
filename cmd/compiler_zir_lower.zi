SimdShape :: enum s32 {
    Binary; Unary; Compare; Select; Shift; ShiftLanes; ByteShift; Align; Make; Splat;
    Zero; Lane; WithLane; Load; Store; Gather; WidenHalf; Widen; Narrow; MulWide;
    Madd; MaddSat; AddPairs; Sad; Reduce; AllZero; ByteShuffle; Shuffle; Reinterpret;
    Convert; Half; Combine; Count
}

SimdOp :: struct {
    id: s32
    name: *u8
    snake: *u8
