    items: [2560]u8
}

PersistencePost0 :: (p: *usize) -> usize { old := p[0]; p[0] = p[0] + 1; return old }

PersistenceSet1 :: (p: *u8, value: u8) -> u8 { p[0] = value; return value }

PersistencePost2 :: (p: **u8) -> *u8 { old := p[0]; p[0] = cast(*u8)(cast(usize)p[0] + size_of(u8)); return old }

PersistencePost3 :: (p: *s32) -> s32 { old := p[0]; p[0] = p[0] + 1; return old }

PersistenceSet4 :: (p: *u32, value: u32) -> u32 { p[0] = value; return value }

PersistenceSet5 :: (p: *u64, value: u64) -> u64 { p[0] = value; return value }

PersistenceSet6 :: (p: *s32, value: s32) -> s32 { p[0] = value; return value }

PersistencePost7 :: (p: *u32) -> u32 { old := p[0]; p[0] = p[0] + 1; return old }

PersistencePre8 :: (p: *u32) -> u32 { old := p[0]; p[0] = p[0] + 1; return p[0] }

PersistenceSet9 :: (p: **u8, value: *u8) -> *u8 { p[0] = value; return value }

PersistencePost10 :: (p: *s64) -> s64 { old := p[0]; p[0] = p[0] + 1; return old }

PersistenceSet11 :: (p: *IR.ZirModule, value: IR.ZirModule) -> IR.ZirModule { p[0] = value; return value }


#scope_file
canonical_check_frame: u8;
CheckCanonicalPrograms_in_context :: (programs: **IR.ZirProgram, count: s32, input_paths: **u8) -> s32 {
    buffers := cast(*CheckCanonicalProgramsBuffers)ParserScratchTake(*canonical_check_frame, size_of(CheckCanonicalProgramsBuffers))
    defer ParserScratchRelease(*canonical_check_frame, cast(*void)buffers)
    return CheckCanonicalPrograms_with_buffers(programs, count, input_paths, buffers)
}


#scope_file
read_bytes :: (reader: *Reader, output: *void, count: usize) -> s32 {
    to: *u8 = cast(*u8)(output)
    while check_loop_1 := (count > cast(usize)(0)) {
        if ((reader).start_local == (reader).end_local) {
            if (count >= cast(usize)(65536)) {
                return cast(s32)(fread(cast(*void)(to), cast(usize)(1), count, (reader).in) == count)
            }
            (reader).start_local = cast(usize)(0)
            (reader).end_local = fread(cast(*void)((reader).block), cast(usize)(1), cast(usize)(65536), (reader).in)
            if ((reader).end_local == cast(usize)(0)) {
                return 0
            }
        }
        amount: usize = ((reader).end_local - (reader).start_local)
        if (amount > count) {
            amount = count
        }
        memcpy(cast(*void)(to), cast(*void)(cast(*u8)(cast(usize)((reader).block) + cast(usize)((reader).start_local) * size_of(u8))), amount)
        (reader).start_local += amount
        to = cast(*u8)(cast(usize)(to) + cast(usize)(amount) * size_of(u8))
        count -= amount
    }
    return 1
}


#scope_file
read_byte :: (reader: *Reader, byte: *u8) -> s32 {
    if ((reader).start_local == (reader).end_local) {
        (reader).start_local = cast(usize)(0)
        (reader).end_local = fread(cast(*void)((reader).block), cast(usize)(1), cast(usize)(65536), (reader).in)
        if ((reader).end_local == cast(usize)(0)) {
            return 0
        }
    }
    PersistenceSet1(byte, ((reader).block)[PersistencePost0(*((reader).start_local))])
    return 1
}


#scope_file
flush_writer :: (writer: *Writer) -> s32 {
    used: usize = (writer).used
    (writer).used = cast(usize)(0)
    if ((used > ((cast(usize)-1) - (writer).bytes)) || ((used != cast(usize)(0)) && (fwrite(cast(*void)((writer).block), cast(usize)(1), used, (writer).out) != used))) {
        return 0
    }
    (writer).bytes += used
    return 1
}


#scope_file
write_bytes :: (writer: *Writer, data: *void, count: usize) -> s32 {
    if ((writer).measure != 0) {
        if (count > ((cast(usize)-1) - (writer).bytes)) {
            return 0
        }
        (writer).bytes += count
        return 1
    }
    if (count > (cast(usize)(65536) - (writer).used)) {
        if !(flush_writer(writer) != 0) {
            return 0
        }
        if (count >= cast(usize)(65536)) {
            if ((count > ((cast(usize)-1) - (writer).bytes)) || (fwrite(data, cast(usize)(1), count, (writer).out) != count)) {
                return 0
            }
            (writer).bytes += count
            return 1
        }
    }
    memcpy(cast(*void)(cast(*u8)(cast(usize)((writer).block) + cast(usize)((writer).used) * size_of(u8))), data, count)
    (writer).used += count
    return 1
}


#scope_file
describe_import_fields :: (input: *void, output: *Field) -> usize {
    record := cast(*IR.ZirImport)input
    output[0] = serial_field(input, cast(*void)*record.kind, size_of(type_of(record.kind)), .Integer)
    output[1] = serial_field(input, cast(*void)*record.extern_kind, size_of(type_of(record.extern_kind)), .Integer)
    output[2] = serial_field(input, cast(*void)*record.is_public, size_of(type_of(record.is_public)), .Integer)
    output[3] = serial_field(input, cast(*void)*record.is_file_private, size_of(type_of(record.is_file_private)), .Integer)
    output[4] = serial_field(input, cast(*void)*record.name, size_of(type_of(record.name)), .String)
    output[5] = serial_field(input, cast(*void)*record.target, size_of(type_of(record.target)), .String)
    output[6] = serial_field(input, cast(*void)*record.extern_symbol, size_of(type_of(record.extern_symbol)), .String)
    output[7] = serial_field(input, cast(*void)*record.signature, size_of(type_of(record.signature)), .String)
    output[8] = serial_field(input, cast(*void)*record.args, size_of(type_of(record.args)), .String)
    output[9] = serial_field(input, cast(*void)*record.return_type, size_of(type_of(record.return_type)), .String)
    output[10] = serial_field(input, cast(*void)*record.must_use, size_of(type_of(record.must_use)), .Integer)
    output[11] = serial_field(input, cast(*void)*record.is_varargs, size_of(type_of(record.is_varargs)), .Integer)
    output[12] = serial_field(input, cast(*void)*record.go_results, size_of(type_of(record.go_results)), .Integer)
    output[13] = serial_field(input, cast(*void)*record.go_field, size_of(type_of(record.go_field)), .Integer)
    output[14] = serial_field(input, cast(*void)*record.go_defer, size_of(type_of(record.go_defer)), .Integer)
    output[15] = serial_field(input, cast(*void)*record.go_variadic, size_of(type_of(record.go_variadic)), .Integer)
    output[16] = serial_field(input, cast(*void)*record.reads_arguments, size_of(type_of(record.reads_arguments)), .Integer)
    output[17] = serial_field(input, cast(*void)*record.parameters, IR.ZIR_TEXT_MAX, .Text)
    output[18] = serial_field(input, cast(*void)*record.is_using, size_of(type_of(record.is_using)), .Integer)
    output[19] = serial_field(input, cast(*void)*record.required, size_of(type_of(record.required)), .Integer)
    output[20] = serial_field(input, cast(*void)*record.span, size_of(type_of(record.span)), .Span)
    return 21
}


#scope_file
describe_statement_fields :: (input: *void, output: *Field) -> usize {
    record := cast(*IR.ZirStmt)input
    output[0] = serial_field(input, cast(*void)*record.kind, size_of(type_of(record.kind)), .StatementKind)
    output[1] = serial_field(input, cast(*void)*record.text, IR.ZIR_TEXT_MAX, .StatementText)
    output[2] = serial_field(input, cast(*void)*record.assembly_text, IR.ZIR_TEXT_MAX, .AssemblyText)
    output[3] = serial_field(input, cast(*void)*record.is_else, size_of(type_of(record.is_else)), .Integer)
    output[4] = serial_field(input, cast(*void)*record.is_using, size_of(type_of(record.is_using)), .Integer)
    output[5] = serial_field(input, cast(*void)*record.loop_id, size_of(type_of(record.loop_id)), .Integer)
    output[6] = serial_field(input, cast(*void)*record.target_id, size_of(type_of(record.target_id)), .Integer)
    output[7] = serial_field(input, cast(*void)*record.for_form, size_of(type_of(record.for_form)), .Integer)
    output[8] = serial_field(input, cast(*void)*record.for_step, size_of(type_of(record.for_step)), .Integer)
    output[9] = serial_field(input, cast(*void)*record.expr_root, size_of(type_of(record.expr_root)), .Integer)
    output[10] = serial_field(input, cast(*void)*record.lhs_root, size_of(type_of(record.lhs_root)), .Integer)
    output[11] = serial_field(input, cast(*void)*record.name, IR.ZIR_NAME_MAX, .StatementName)
    output[12] = serial_field(input, cast(*void)*record.type, IR.ZIR_NAME_MAX, .Name)
    output[13] = serial_field(input, cast(*void)*record.assignment_op, size_of(type_of(record.assignment_op)), .String)
    output[14] = serial_field(input, cast(*void)*record.is_parallel, size_of(type_of(record.is_parallel)), .Integer)
    output[15] = serial_field(input, cast(*void)*record.is_gpu, size_of(type_of(record.is_gpu)), .Integer)
    output[16] = serial_field(input, cast(*void)*record.checks, size_of(type_of(record.checks)), .Integer)
    output[17] = serial_field(input, cast(*void)*record.span, size_of(type_of(record.span)), .Span)
    return 18
}


#scope_file
describe_expression_fields :: (input: *void, output: *Field) -> usize {
    record := cast(*IR.ZirExpr)input
    output[0] = serial_field(input, cast(*void)*record.kind, size_of(type_of(record.kind)), .Integer)
    output[1] = serial_field(input, cast(*void)*record.is_function_value, size_of(type_of(record.is_function_value)), .Integer)
    output[2] = serial_field(input, cast(*void)*record.is_this, size_of(type_of(record.is_this)), .Integer)
    output[3] = serial_field(input, cast(*void)*record.checked, size_of(type_of(record.checked)), .Integer)
    output[4] = serial_field(input, cast(*void)*record.slot_type, IR.ZIR_NAME_MAX, .Name)
    output[5] = serial_field(input, cast(*void)*record.name, IR.ZIR_NAME_MAX, .Name)
    output[6] = serial_field(input, cast(*void)*record.argument_name, IR.ZIR_NAME_MAX, .Name)
    output[7] = serial_field(input, cast(*void)*record.argument_index, size_of(type_of(record.argument_index)), .Integer)
    output[8] = serial_field(input, cast(*void)*record.op, size_of(type_of(record.op)), .String)
    output[9] = serial_field(input, cast(*void)*record.left, size_of(type_of(record.left)), .Integer)
    output[10] = serial_field(input, cast(*void)*record.right, size_of(type_of(record.right)), .Integer)
    output[11] = serial_field(input, cast(*void)*record.first_child, size_of(type_of(record.first_child)), .Integer)
    output[12] = serial_field(input, cast(*void)*record.next_sibling, size_of(type_of(record.next_sibling)), .Integer)
    output[13] = serial_field(input, cast(*void)*record.third, size_of(type_of(record.third)), .Integer)
    output[14] = serial_field(input, cast(*void)*record.type, IR.ZIR_NAME_MAX, .Name)
    output[15] = serial_field(input, cast(*void)*record.span, size_of(type_of(record.span)), .Span)
    output[16] = serial_field(input, cast(*void)*record.text, IR.ZIR_TEXT_MAX, .ExpressionText)
    return 17
}


#scope_file
describe_function_fields :: (input: *void, output: *Field) -> usize {
    record := cast(*IR.ZirFunction)input
    output[0] = serial_field(input, cast(*void)*record.name, size_of(type_of(record.name)), .String)
