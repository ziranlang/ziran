#scope_export
CheckCanonicalPrograms :: (programs: **IR.ZirProgram, count: s32, input_paths: **u8) -> s32 {
    previous: *u8 = CompilerContextSelect((ifx (((count > 0) && (programs != null)) && ((programs)[0] != null)) then ((programs)[0]).context else CompilerContextCurrent()))
    result: s32 = CheckCanonicalPrograms_in_context(programs, count, input_paths)
    CompilerContextSelect(previous)
    return result
}


#scope_export
ProgramRead :: (in: *void, path: *u8) -> *IR.ZirProgram {
    memory: *void = CompilerMemoryPause()
    previous: *u8 = CompilerContextCurrent()
    owner: *u8 = (ifx (previous != null) then previous else CompilerContextOpen())
    if !(owner != null) {
        CompilerMemoryResume(memory)
        DiagnosticOutOfMemory()
        return null
    }
    CompilerContextSelect(owner)
    program: *IR.ZirProgram = ProgramRead_in_context(in, path)
    if ((program != null) && !((program).context_retained != 0)) {
        CompilerContextRetain(owner)
        (program).context_retained = 1
    }
    if ((program != null) && !(previous != null)) {
        (program).owns_context = 1
    }
    CompilerContextSelect(previous)
    if (!(program != null) && !(previous != null)) {
        CompilerContextClose(owner)
    }
    CompilerMemoryResume(memory)
    return program
}


