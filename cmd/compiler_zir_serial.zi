// Read and write the versioned checked IR format and verify canonical saved inputs.
IR :: #import "compiler_ir"
using Parser :: #import "compiler_parse_types"
Expr :: #import "compiler_parse"
Check :: #import "compiler_check_types"

#scope_file
ZIR_FORMAT_VERSION :: 66

compiler :: #system_library "ziran";
libc :: #system_library "libc";

CheckPrograms :: (programs: **IR.ZirProgram, count: s32) -> s32 #foreign compiler "CheckPrograms";
CompilerCalloc :: (count: usize, size: usize) -> *void #foreign compiler "CompilerCalloc";
CompilerContextClose :: (context_local: *u8) -> s32 #foreign compiler "CompilerContextClose";
CompilerContextCurrent :: () -> *u8 #foreign compiler "CompilerContextCurrent";
CompilerContextOpen :: () -> *u8 #foreign compiler "CompilerContextOpen";
CompilerContextRetain :: (context_local: *u8) #foreign compiler "CompilerContextRetain";
CompilerContextSelect :: (context_local: *u8) -> *u8 #foreign compiler "CompilerContextSelect";
CompilerFclose :: (file: *void) -> s32 #foreign compiler "CompilerFclose";
CompilerFileSeek :: (file: *void, offset: s64, origin: s32) -> s32 #foreign compiler "CompilerFileSeek";
CompilerFopen :: (path: *u8, mode: *u8) -> *void #foreign compiler "CompilerFopen";
CompilerFree :: (pointer: *void) #foreign compiler "CompilerFree";
CompilerMalloc :: (size: usize) -> *void #foreign compiler "CompilerMalloc";
CompilerMemoryPause :: () -> *void #foreign compiler "CompilerMemoryPause";
CompilerMemoryResume :: (memory: *void) #foreign compiler "CompilerMemoryResume";
CompilerMemoryStreams :: () -> s32 #foreign compiler "CompilerMemoryStreams";
CompilerOpenMemoryOutput :: (data: **u8, size: *usize) -> *void #foreign compiler "CompilerOpenMemoryOutput";
CompilerRealloc :: (pointer: *void, size: usize) -> *void #foreign compiler "CompilerRealloc";
Diagnostic :: (span: IR.ZirSourceSpan, code: *u8, format: *u8, varargs: ..any) #foreign compiler "Diagnostic";
DiagnosticOutOfMemory :: () #foreign compiler "DiagnosticOutOfMemory";
ExecutablePath :: (output: *u8, capacity: usize) -> s32 #foreign compiler "ExecutablePath";
ExprSavedCursorLength :: (cursor: *Expr.ExprStatementCursor, text: *void, line: s32) -> usize #foreign compiler "ExprSavedCursorLength";
ExprSavedSourceOffset :: (cursor: *Expr.ExprStatementCursor, text: *void, base: IR.ZirSourceSpan, span: IR.ZirSourceSpan) -> s64 #foreign compiler "ExprSavedSourceOffset";
ExpressionOwners :: (fn: *IR.ZirFunction) -> *s32 #foreign compiler "ExpressionOwners";
GoForeignTargetValid :: (target: *u8) -> s32 #foreign compiler "GoForeignTargetValid";
KeepText :: (text: *u8) -> *u8 #foreign compiler "KeepText";
MapTypeParts :: (module: *IR.ZirModule, name: *u8, key: *u8, key_size: usize, value: *u8, value_size: usize) -> s32 #foreign compiler "MapTypeParts";
PrepareNativeNames :: (programs: **IR.ZirProgram, count: s32) -> s32 #foreign compiler "PrepareNativeNames";
ProfileEnd :: (phase: *u8, started: u64) #foreign compiler "ProfileEnd";
ProfileStart :: () -> u64 #foreign compiler "ProfileStart";
ProgramFree :: (program: *IR.ZirProgram) #foreign compiler "ProgramFree";
ProgramNew :: () -> *IR.ZirProgram #foreign compiler "ProgramNew";
SavedParametersValid :: (module: *IR.ZirModule) -> s32 #foreign compiler "SavedParametersValid";
SourceFile :: (path: *u8) -> s32 #foreign compiler "SourceFile";
Span :: (path: *u8, line: s32, column: s32) -> IR.ZirSourceSpan #foreign compiler "Span";
SpanPath :: (span: IR.ZirSourceSpan) -> *u8 #foreign compiler "SpanPath";
SymbolLookupsChanged :: () #foreign compiler "SymbolLookupsChanged";
VecElementType :: (module: *IR.ZirModule, type: *u8, element: *u8, element_size: usize) -> s32 #foreign compiler "VecElementType";
copy_text :: (dst: *u8, dst_size: usize, src: *u8) #foreign compiler "copy_text";
ferror :: (__stream: *void) -> s32 #foreign libc "ferror";
fflush :: (__stream: *void) -> s32 #foreign libc "fflush";
fgetc :: (__stream: *void) -> s32 #foreign libc "fgetc";
fread :: (__ptr: *void, __size: usize, __n: usize, __stream: *void) -> usize #foreign libc "fread";
fwrite :: (__ptr: *void, __size: usize, __n: usize, __s: *void) -> usize #foreign libc "fwrite";
getenv :: (__name: *u8) -> *u8 #foreign libc "getenv";
memchr :: (__s: *void, __c: s32, __n: usize) -> *void #foreign libc "memchr";
memcmp :: (__s1: *void, __s2: *void, __n: usize) -> s32 #foreign libc "memcmp";
memcpy :: (__dest: *void, __src: *void, __n: usize) -> *void #foreign libc "memcpy";
parse_file :: (path: *u8, root: *u8) -> *IR.ZirProgram #foreign compiler "parse_file";
skip_ws :: (s: *u8) -> *u8 #foreign compiler "skip_ws";
snprintf :: (__s: *u8, __maxlen: usize, __format: *u8, varargs: ..any) -> s32 #foreign libc "snprintf";
split_top_level :: (s: *u8, parts: *u8, max: s32, part_size: usize) -> s32 #foreign compiler "split_top_level";
strchr :: (__s: *u8, __c: s32) -> *u8 #foreign libc "strchr";
strcmp :: (__s1: *u8, __s2: *u8) -> s32 #foreign libc "strcmp";
strlen :: (__s: *u8) -> usize #foreign libc "strlen";
strncmp :: (__s1: *u8, __s2: *u8, __n: usize) -> s32 #foreign libc "strncmp";
strnlen :: (__string: *u8, __maxlen: usize) -> usize #foreign libc "strnlen";
tmpfile :: () -> *void #foreign libc "tmpfile";
top_level_assignment :: (s: *u8) -> *u8 #foreign compiler "top_level_assignment";
trim_in_place :: (s: *u8) -> *u8 #foreign compiler "trim_in_place";
isalnum :: (byte: s32) -> s32 #foreign libc "isalnum";
isalpha :: (byte: s32) -> s32 #foreign libc "isalpha";
isdigit :: (byte: s32) -> s32 #foreign libc "isdigit";
isspace :: (byte: s32) -> s32 #foreign libc "isspace";

DescribeFields :: #type (record: *void, output: *Field) -> usize #c_call;

ParserArray8192_u8 :: struct {
    items: [8192]u8
}

CheckCanonicalProgramsBuffers :: struct {
    left: ParserArray8192_u8
    right: ParserArray8192_u8
}

FieldKind :: enum s32 { String; Text; Name; Integer; StatementKind; StatementName; StatementText; FunctionAssembly; AssemblyText; ExpressionText; Unsigned64; Span }

Field :: struct {
    offset: usize
    size: usize
    kind: FieldKind
}

serial_field :: (record: *void, member: *void, size: usize, kind: FieldKind) -> Field {
    return .{offset = cast(usize)member - cast(usize)record, size = size, kind = kind}
}

ParserAnonymous3 :: union {
    name: *u8
    assembly_text: *u8
}

ParserArray1024_u8 :: struct {
    items: [1024]u8
}

Reader :: struct {
    in: *void
    path: *u8
    problem: *u8
    budget: usize
    block: *u8
    start_local: usize
    end_local: usize
    last_file: s32
    last_path: ParserArray1024_u8
    strings: *SerialString
    string_count: u32
    string_capacity: u32
    last_line: s32
    has_span: s32
    context_local: *u8
    function: *IR.ZirFunction
    last_owner: s32
    last_bias: s64
    cursor: Expr.ExprStatementCursor
}

SavedModuleShape :: struct {
    function_count: s32
    type_count: s32
    type_names: *ParserArray128_u8
}

SerialString :: struct {
    text: *u8
    length: u32
    kept: *u8
}

Writer :: struct {
    out: *void
    block: *u8
    used: usize
    bytes: usize
    measure: s32
    strings: *SerialString
    string_count: u32
    string_capacity: u32
    slots: *u32
    slot_count: u32
    addresses: *usize
    address_strings: *u32
    address_count: u32
    address_slot_count: u32
    charged: usize
    problem: *u8
    last_line: s32
    last_path: *u8
    has_span: s32
    function: *IR.ZirFunction
    owners: *s32
    last_owner: s32
    last_bias: s64
    cursor: Expr.ExprStatementCursor
}

