    output[4] = serial_field(input, cast(*void)*record.return_type, size_of(type_of(record.return_type)), .String)
    output[5] = serial_field(input, cast(*void)*record.must_use, size_of(type_of(record.must_use)), .Integer)
    output[6] = serial_field(input, cast(*void)*record.is_conversion, size_of(type_of(record.is_conversion)), .Integer)
    output[7] = serial_field(input, cast(*void)*record.go_method, size_of(type_of(record.go_method)), .String)
    output[8] = serial_field(input, cast(*void)*record.go_method_results, size_of(type_of(record.go_method_results)), .Integer)
    output[9] = serial_field(input, cast(*void)*record.effect_class, size_of(type_of(record.effect_class)), .String)
    output[10] = serial_field(input, cast(*void)*record.exported, size_of(type_of(record.exported)), .Integer)
    output[11] = serial_field(input, cast(*void)*record.export_symbol, size_of(type_of(record.export_symbol)), .String)
    output[12] = serial_field(input, cast(*void)*record.is_extern, size_of(type_of(record.is_extern)), .Integer)
    output[13] = serial_field(input, cast(*void)*record.extern_kind, size_of(type_of(record.extern_kind)), .Integer)
    output[14] = serial_field(input, cast(*void)*record.is_public, size_of(type_of(record.is_public)), .Integer)
    output[15] = serial_field(input, cast(*void)*record.is_file_private, size_of(type_of(record.is_file_private)), .Integer)
    output[16] = serial_field(input, cast(*void)*record.is_template, size_of(type_of(record.is_template)), .Integer)
    output[17] = serial_field(input, cast(*void)*record.is_specialization, size_of(type_of(record.is_specialization)), .Integer)
    output[18] = serial_field(input, cast(*void)*record.is_global_initializer, size_of(type_of(record.is_global_initializer)), .Integer)
    output[19] = serial_field(input, cast(*void)*record.template_param, size_of(type_of(record.template_param)), .String)
    output[20] = serial_field(input, cast(*void)*record.specialization_type, size_of(type_of(record.specialization_type)), .String)
    output[21] = serial_field(input, cast(*void)*record.overload_name, size_of(type_of(record.overload_name)), .String)
    output[22] = serial_field(input, cast(*void)*record.checked, size_of(type_of(record.checked)), .Integer)
    output[23] = serial_field(input, cast(*void)*record.uses_host, size_of(type_of(record.uses_host)), .Integer)
    output[24] = serial_field(input, cast(*void)*record.extern_target, size_of(type_of(record.extern_target)), .String)
    output[25] = serial_field(input, cast(*void)*record.extern_symbol, size_of(type_of(record.extern_symbol)), .String)
    output[26] = serial_field(input, cast(*void)*record.inlining, size_of(type_of(record.inlining)), .Integer)
    output[27] = serial_field(input, cast(*void)*record.simd_target, size_of(type_of(record.simd_target)), .Integer)
    output[28] = serial_field(input, cast(*void)*record.span, size_of(type_of(record.span)), .Span)
    output[29] = serial_field(input, cast(*void)*record.assembly_text, IR.ZIR_TEXT_MAX, .FunctionAssembly)
