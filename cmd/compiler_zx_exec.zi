// Revision-28 executable ZX behind the embedding API (zir_host_exec.h and
// zir_exec_console.h): a bundle is read, verified and planned once, and each
// instance runs it on the portable instruction engine with its host
// capabilities and platform console services bound. It is generated with
// the engine and compiled under the engine's private names, so its calls
// reach the engine libziran carries while its own entry points keep their C
// names.
//
// This file holds the console services and the shared declarations;
// compiler_zx_exec_bundle.zi reads bundles, compiler_zx_exec_hosts.zi
// translates host calls and compiler_zx_exec_instance.zi runs instances.
Exec :: #import "compiler_exec"
LIR :: #import "compiler_lowered_ir"
Link :: #import "compiler_exec_link"
Serial :: #import "compiler_exec_serial"
Assets :: #import "compiler_bundle"
Debug :: #import "compiler_exec_debug"

// Shared with the loaded files, so declared at module scope.
libc :: #system_library "libc";
compiler :: #system_library "ziran";

malloc :: (size: usize) -> *u8 #foreign libc "malloc";
calloc :: (count: usize, size: usize) -> *u8 #foreign libc "calloc";
realloc :: (memory: *u8, size: usize) -> *u8 #foreign libc "realloc";
free :: (memory: *u8) #foreign libc "free";
strcmp :: (a: *u8, b: *u8) -> s32 #foreign libc "strcmp";
strncmp :: (a: *u8, b: *u8, count: usize) -> s32 #foreign libc "strncmp";
strchr :: (s: *u8, c: s32) -> *u8 #foreign libc "strchr";
strrchr :: (s: *u8, c: s32) -> *u8 #foreign libc "strrchr";
memchr :: (data: *u8, c: s32, count: usize) -> *u8 #foreign libc "memchr";
// C long is pointer-sized on every target, wasm32 included.
strtol :: (s: *u8, end: **u8, base: s32) -> isize #foreign libc "strtol";
snprintf :: (out: *u8, size: usize, format: *u8, args: ..any) -> s32 #foreign libc "snprintf";
fflush :: (file: *void) -> s32 #foreign libc "fflush";
memcpy :: (dst: *u8, src: *u8, count: usize) -> *u8 #foreign libc "memcpy";
memset :: (dst: *u8, value: s32, count: usize) -> *u8 #foreign libc "memset";
memcmp :: (a: *u8, b: *u8, count: usize) -> s32 #foreign libc "memcmp";
strlen :: (s: *u8) -> usize #foreign libc "strlen";
fwrite :: (data: *u8, size: usize, count: usize, file: *void) -> usize #foreign libc "fwrite";
isatty :: (descriptor: s32) -> s32 #foreign libc "isatty";
StandardOutput :: () -> *void #foreign compiler "CompilerStandardOutput";
StandardError :: () -> *void #foreign compiler "CompilerStandardError";
FormatPrintFloat :: (value: float64, single: s32, out: *u8, capacity: usize) #foreign compiler "FormatPrintFloat";
Diagnostic :: (span: ZirSourceSpan, code: *u8, fmt: *u8, args: ..any) #foreign compiler "Diagnostic";
Span :: (path: *u8, line: s32, column: s32) -> ZirSourceSpan #foreign compiler "Span";
ZxRunControlRequested :: (control: *ZxRunControl) -> s32 #foreign compiler "ZxRunControlRequested";
// The instance whose host call this thread is running (zir_atomics.c).
ThreadEngine :: () -> *void #foreign compiler "S15ThreadEngine";
SetThreadEngine :: (engine: *void) #foreign compiler "S15SetThreadEngine";
Sha256Begin :: (hash: *Sha256) #foreign compiler "Sha256Begin";
Sha256Add :: (hash: *Sha256, data: *u8, size: usize) #foreign compiler "Sha256Add";
Sha256End :: (hash: *Sha256, digest: *u8) #foreign compiler "Sha256End";

ZirSourceSpan :: struct {
    context: *u8
    file: s32
    line: s32
    column: s32
    end_line: s32
    end_column: s32
}
NoSpan :: () -> ZirSourceSpan {
    span: ZirSourceSpan
    return span
}

Sha256 :: struct {
    state: [8]u32
    length: u64
    block: [64]u8
    used: usize
}

// include/ziran_host.h's records and callbacks, field for field.
HostKind :: enum s32 { Void; Integer; Unsigned; Real; String; Record; Slice; Pointer; Array; BorrowedSlice }

HostValue :: struct {
    kind: HostKind
    type: *u8
    integer: s64
    bits: u64
    real: float64
    data: *u8
    length: usize
    fields: *HostField
    field_count: usize
    elements: *HostValue
    pointer: *void
}

HostField :: struct {
    name: *u8
    value: HostValue
}

HostBinding :: struct {
    module: *u8
    function: *u8
    call: *void
    context: *void
}

BundleCapabilityAbi :: struct {
    module: *u8
    function: *u8
    signature: *u8
    arguments: *u8
    return_type: *u8
    variable_arguments: s32
    reads_arguments: s32
}

ZxRunControl :: struct { requested: s32 }

BundleImageRelease :: #type (context: *void, data: *u8, size: usize) #c_call;
BundleReadAt :: #type (context: *void, offset: u64, output: *void, size: usize) -> usize #c_call;
BundleShrink :: #type (storage: *void, size: usize) -> *void #c_call;

// ziran_host.h's ZxRunStatus.
RUN_ERROR :: 0
RUN_OK :: 1
RUN_CANCELLED :: 2

Advance :: (text: *u8, count: usize) -> *u8 { return cast(*u8)(cast(usize)text + count) }
PtrDistance :: (end: *u8, start: *u8) -> usize { return cast(usize)end - cast(usize)start }
Same :: (a: *u8, b: *u8) -> bool { return strcmp(a, b) == 0 }
SizeMax :: () -> usize {
    zero: usize = 0
    return zero - 1
}
TextOf :: (data: *u8, length: usize) -> string {
    result: string
    view := cast(*StaticText)(*result)
    view.data = data
    view.length = length
    return result
}
// The words of a std/vec Vec, for the facade's in-place rewrites of the
// reader's and the plan's storage, as the engine's C callers see them.
RawVec :: struct {
    data: *u8
    count: s64
    capacity: s64
}
RawOf :: (vector: *void) -> *RawVec { return cast(*RawVec)vector }

// The words of a slice ([]T): zir_slice.h uses int64_t for length, unlike
// String which uses size_t.
RawSlice :: struct {
    data: *u8
    length: s64
}

BytesOf :: (data: *u8, length: s64) -> []u8 {
    result: []u8
    view := cast(*RawSlice)(*result)
    view.data = data
    view.length = length
    return result
}

StaticText :: struct { data: *u8; length: usize }
CStr :: (s: string) -> *u8 { return (cast(*StaticText)(*s)).data }
TextData :: (s: *string) -> *u8 { return (cast(*StaticText)s).data }

// A module or function name of the program is TEXT.
NameIs :: (name: string, text: string) -> bool {
    return name.count == text.count && memcmp(TextData(*name), CStr(text), cast(usize)text.count) == 0
}

ConsoleWriteHook :: #type (context: *void, descriptor: s32, bytes: *u8, size: usize) -> s32 #c_call;

// zir_exec_console.h's ZX_SERVICE_ names.
SERVICE_NONE :: 0
SERVICE_PRINT_BYTES :: 1
SERVICE_PRINT_SIGNED :: 2
SERVICE_PRINT_UNSIGNED :: 3
SERVICE_PRINT_BOOL :: 4
SERVICE_PRINT_FLOAT32 :: 5
SERVICE_PRINT_FLOAT64 :: 6

#scope_export

// Standard output a run gathers so that it reaches stdio in one write. It
// goes out when the console is flushed, before anything goes to standard
// error, and when it fills; a terminal or a custom sink gets each write at
// once. The layout is zir_exec_console.h's ZxConsole.
ZxConsole :: struct {
    used: usize
    direct: s32
    write: ConsoleWriteHook
    context: *void
    data: [4096]u8
}

// The platform console service a host function of PROGRAM stands for.
#program_export
ZxPlatformService :: (program: *LIR.LirProgram, function: s64) -> s32 {
    if function < 0 || function >= program.functions.count { return SERVICE_NONE }
    declared := *program.functions[function]
    if !declared.external || declared.module < 0 || cast(s64)declared.module >= program.modules.count ||
       !NameIs(program.modules[declared.module], "ziran.platform") { return SERVICE_NONE }
    name := declared.name
    if NameIs(name, "ziran.platform.write_all") { return SERVICE_PRINT_BYTES }
    if NameIs(name, "ziran.print.signed") { return SERVICE_PRINT_SIGNED }
    if NameIs(name, "ziran.print.unsigned") { return SERVICE_PRINT_UNSIGNED }
    if NameIs(name, "ziran.print.bool") { return SERVICE_PRINT_BOOL }
    if NameIs(name, "ziran.print.float32") { return SERVICE_PRINT_FLOAT32 }
    if NameIs(name, "ziran.print.float64") { return SERVICE_PRINT_FLOAT64 }
    return SERVICE_NONE
}

// Hands what CONSOLE holds to standard output: 0 when that failed.
#program_export
ZxConsoleFlush :: (console: *ZxConsole) -> s32 {
    if console == null || console.used == 0 { return 1 }
    used := console.used
    console.used = 0
    return ifx fwrite(*console.data[0], 1, used, StandardOutput()) == used then 1 else 0
}

#program_export
ZxConsoleOpen :: (console: *ZxConsole) {
    unused memset(cast(*u8)console, 0, size_of(ZxConsole))
    console.direct = isatty(1)
}

#program_export
ZxConsoleWrite :: (console: *ZxConsole, bytes: *u8, size: usize) -> s32 {
    return ifx ConsoleOut(console, bytes, size) then 1 else 0
}

#program_export
ZxBindConsole :: (instance: *Exec.LirExecInstance, program: *LIR.LirProgram, console: *ZxConsole) -> Exec.LirExecProblem {
    if console != null { ZxConsoleOpen(console) }
    context := cast(*void)console
    for index: cast(s64)0..program.functions.count - 1 {
        service := ZxPlatformService(program, index)
        function := cast(s32)index
        bound := Exec.LirExecProblem.None
        if service == SERVICE_PRINT_BYTES { bound = Exec.LirExecBindPlatformWrite(instance, function, ConsolePlatformWrite, context) }
        if service == SERVICE_PRINT_SIGNED { bound = Exec.LirExecBindHost(instance, function, PrintSigned, context) }
        if service == SERVICE_PRINT_UNSIGNED { bound = Exec.LirExecBindHost(instance, function, PrintUnsigned, context) }
        if service == SERVICE_PRINT_BOOL { bound = Exec.LirExecBindHost(instance, function, PrintBool, context) }
        if service == SERVICE_PRINT_FLOAT32 { bound = Exec.LirExecBindHost(instance, function, PrintFloat32, context) }
        if service == SERVICE_PRINT_FLOAT64 { bound = Exec.LirExecBindHost(instance, function, PrintFloat64, context) }
        if bound != .None { return bound }
    }
    return .None
}

// What a failed run's problem means to the program's reader, or null.
#program_export
ZxExecProblemText :: (problem: Exec.LirExecProblem) -> *u8 {
    if problem == .Pointer { return CStr("an index or address is out of bounds or no longer valid") }
    if problem == .Unreachable { return CStr("unreachable code executed") }
    if problem == .FrameLimit { return CStr("nested calls filled the stack") }
    if problem == .DivideByZero { return CStr("integer division by zero") }
    if problem == .InvalidShift { return CStr("shift count out of range") }
    if problem == .InvalidConversion { return CStr("conversion out of range") }
    if problem == .Trap { return CStr("the program trapped") }
    if problem == .Host { return CStr("a host call failed") }
    if problem == .FuelLimit { return CStr("the step limit ran out") }
    if problem == .ValueLimit || problem == .AddressLimit || problem == .ValueBytes || problem == .Allocation {
        return CStr("the program ran out of value storage")
    }
    return null
}

#scope_file

// Standard output through CONSOLE: a custom sink or a terminal gets each
// write at once, anything else is gathered.
ConsoleOut :: (console: *ZxConsole, bytes: *u8, size: usize) -> bool {
    if size == 0 { return true }
    if console != null && cast(*void)console.write != null { return console.write(console.context, 1, bytes, size) != 0 }
    if console == null || console.direct != 0 { return fwrite(bytes, 1, size, StandardOutput()) == size }
    if size > 4096 - console.used {
        if ZxConsoleFlush(console) == 0 { return false }
        if size > 4096 { return fwrite(bytes, 1, size, StandardOutput()) == size }
    }
    unused memcpy(*console.data[console.used], bytes, size)
    console.used += size
    return true
}

// ziran.platform.write_all: standard output, or standard error after what
// standard output holds, as when every print went straight to stdio.
ConsolePlatformWrite :: (context: *void, descriptor: u64, bytes: []u8) -> bool {
    console := cast(*ZxConsole)context
    data: *u8 = ifx bytes.count > 0 then *bytes[0] else null
    size := cast(usize)bytes.count
    if descriptor == 1 { return ConsoleOut(console, data, size) }
    if descriptor != 2 { return false }
    if console != null && cast(*void)console.write != null { return size == 0 || console.write(console.context, 2, data, size) != 0 }
    if ZxConsoleFlush(console) == 0 { return false }
    return size == 0 || fwrite(data, 1, size, StandardError()) == size
}

// The decimal digits of VALUE at TEXT; their count.
FormatUnsigned :: (text: *u8, value: u64) -> usize {
    digits: [20]u8
    count: usize = 0
    rest := value
    while true {
        digits[count] = cast(u8)(cast(u64)#char "0" + rest % 10)
        count += 1
        rest /= 10
        if rest == 0 { break }
    }
    at: usize = 0
    while at < count {
        text[at] = digits[count - 1 - at]
        at += 1
    }
    return count
}

PrintText :: (context: *void, text: *u8, length: usize, result: *u64) -> bool {
    <<result = 0
    return ConsoleOut(cast(*ZxConsole)context, text, length)
}

PrintSigned :: (context: *void, function: s32, arguments: []u64, result: *u64) -> bool {
    <<result = 0
    if arguments.count != 1 { return false }
    text: [64]u8
    length: usize = 0
    magnitude := arguments[0]
    if cast(s64)arguments[0] < 0 {
        text[0] = #char "-"
        length = 1
        magnitude = ~magnitude + 1
    }
    length += FormatUnsigned(*text[length], magnitude)
    return PrintText(context, *text[0], length, result)
}

PrintUnsigned :: (context: *void, function: s32, arguments: []u64, result: *u64) -> bool {
    <<result = 0
    if arguments.count != 1 { return false }
    text: [64]u8
    return PrintText(context, *text[0], FormatUnsigned(*text[0], arguments[0]), result)
}

PrintBool :: (context: *void, function: s32, arguments: []u64, result: *u64) -> bool {
    <<result = 0
    if arguments.count != 1 { return false }
    word := ifx arguments[0] != 0 then "true" else "false"
    return PrintText(context, CStr(word), cast(usize)word.count, result)
}

PrintFloat32 :: (context: *void, function: s32, arguments: []u64, result: *u64) -> bool {
    <<result = 0
    if arguments.count != 1 { return false }
    bits := cast(u32)arguments[0]
    value: float32 = 0
    unused memcpy(cast(*u8)*value, cast(*u8)*bits, 4)
    text: [64]u8
    FormatPrintFloat(cast(float64)value, 1, *text[0], 64)
    return PrintText(context, *text[0], strlen(*text[0]), result)
}

PrintFloat64 :: (context: *void, function: s32, arguments: []u64, result: *u64) -> bool {
    <<result = 0
    if arguments.count != 1 { return false }
    bits := arguments[0]
    value: float64 = 0
    unused memcpy(cast(*u8)*value, cast(*u8)*bits, 8)
    text: [64]u8
    FormatPrintFloat(value, 0, *text[0], 64)
    return PrintText(context, *text[0], strlen(*text[0]), result)
}

#load "compiler_zx_exec_bundle.zi";
#load "compiler_zx_exec_hosts.zi";
#load "compiler_zx_exec_instance.zi";
#load "compiler_zx_exec_wasm.zi";
