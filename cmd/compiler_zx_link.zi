// Entry linking for the C, Go and native backends: copies the checked
// program, prunes it to what the entry reaches, and binds declared host
// capabilities to Ziran providers.
//
// This file holds host binding, the private program copy and the public
// entry points. compiler_zx_link_prune.zi removes dead statements and unused
// record fields; compiler_zx_link_reach.zi decides what an entry keeps.
IR :: #import "compiler_ir"

#load "compiler_zx_link_prune.zi";
#load "compiler_zx_link_reach.zi";

libc :: #system_library "libc";
compiler :: #system_library "ziran";

malloc :: (size: usize) -> *u8 #foreign libc "malloc";
calloc :: (count: usize, size: usize) -> *u8 #foreign libc "calloc";
realloc :: (memory: *u8, size: usize) -> *u8 #foreign libc "realloc";
free :: (memory: *u8) #foreign libc "free";
exit :: (status: s32) #foreign libc "exit";
memcpy :: (dst: *u8, src: *u8, count: usize) -> *u8 #foreign libc "memcpy";
memset :: (dst: *u8, value: s32, count: usize) -> *u8 #foreign libc "memset";
memchr :: (s: *u8, c: s32, n: usize) -> *u8 #foreign libc "memchr";
strlen :: (s: *u8) -> usize #foreign libc "strlen";
strcmp :: (a: *u8, b: *u8) -> s32 #foreign libc "strcmp";
strncmp :: (a: *u8, b: *u8, n: usize) -> s32 #foreign libc "strncmp";
strchr :: (s: *u8, c: s32) -> *u8 #foreign libc "strchr";
strrchr :: (s: *u8, c: s32) -> *u8 #foreign libc "strrchr";
strstr :: (s: *u8, needle: *u8) -> *u8 #foreign libc "strstr";
strcpy :: (dst: *u8, src: *u8) -> *u8 #foreign libc "strcpy";
snprintf :: (out: *u8, size: usize, fmt: *u8, args: ..any) -> s32 #foreign libc "snprintf";
getenv :: (name: *u8) -> *u8 #foreign libc "getenv";
Order :: #type (left: *void, right: *void) -> s32 #c_call;
qsort :: (base: *u8, count: usize, size: usize, order: Order) #foreign libc "qsort";
bsearch :: (key: *u8, base: *u8, count: usize, size: usize, order: Order) -> *u8 #foreign libc "bsearch";

AllocateOrExit :: (size: usize) -> *u8 #foreign compiler "AllocateOrExit";
Diagnostic :: (span: IR.ZirSourceSpan, code: *u8, fmt: *u8, args: ..any) #foreign compiler "Diagnostic";
DiagnosticOutOfMemory :: () #foreign compiler "DiagnosticOutOfMemory";
Span :: (path: *u8, line: s32, column: s32) -> IR.ZirSourceSpan #foreign compiler "Span";
SpanPath :: (span: IR.ZirSourceSpan) -> *u8 #foreign compiler "SpanPath";
KeepName :: (text: *u8) -> *u8 #foreign compiler "KeepName";
KeepParameters :: (text: *u8) -> *u8 #foreign compiler "KeepParameters";
skip_ws :: (s: *u8) -> *u8 #foreign compiler "skip_ws";
trim_in_place :: (s: *u8) -> *u8 #foreign compiler "trim_in_place";
copy_text :: (dst: *u8, size: usize, src: *u8) #foreign compiler "copy_text";
split_top_level :: (s: *u8, parts: *u8, max: s32, part_size: usize) -> s32 #foreign compiler "split_top_level";
CompilerContextSelect :: (context: *u8) -> *u8 #foreign compiler "CompilerContextSelect";
ProgramNew :: () -> *IR.ZirProgram #foreign compiler "ProgramNew";
ProgramFree :: (program: *IR.ZirProgram) #foreign compiler "ProgramFree";
ProgramInheritContexts :: (target: *IR.ZirProgram, source: *IR.ZirProgram) -> s32 #foreign compiler "ProgramInheritContexts";
LinkImports :: (programs: **IR.ZirProgram, count: s32) -> s32 #foreign compiler "LinkImports";
CheckLawGates :: (programs: **IR.ZirProgram, count: s32) -> s32 #foreign compiler "CheckLawGates";
CheckPrograms :: (programs: **IR.ZirProgram, count: s32) -> s32 #foreign compiler "CheckPrograms";
SymbolLookupsChanged :: () #foreign compiler "SymbolLookupsChanged";
PackageMapLoad :: (path: *u8) -> *u8 #foreign compiler "PackageMapLoad";
PackageMapFree :: (map: *u8) #foreign compiler "PackageMapFree";
PackageDependencyModule :: (map: *u8, owner: *u8, qualified: *u8, identity: *u8, size: usize) -> s32 #foreign compiler "PackageDependencyModule";
FindType :: (module: *IR.ZirModule, name: *u8, owner: **IR.ZirModule) -> *IR.ZirType #foreign compiler "FindType";
BuiltinType :: (name: *u8) -> *IR.ZirType #foreign compiler "BuiltinType";
TypeNextField :: (record: *IR.ZirType, offset: *usize, field: *IR.ZirTypeField) -> s32 #foreign compiler "TypeNextField";
ResolveFunction :: (module: *IR.ZirModule, name: *u8, owner: **IR.ZirModule, fn: **IR.ZirFunction) -> s32 #foreign compiler "ResolveFunction";
ResolveGlobalAt :: (module: *IR.ZirModule, name: *u8, path: *u8, owner: **IR.ZirModule, global: **IR.ZirGlobal) -> s32 #foreign compiler "ResolveGlobalAt";
ParseExprTyped :: (fn: *IR.ZirFunction, module: *IR.ZirModule, text: *u8, span: IR.ZirSourceSpan, expected: *u8) -> s32 #foreign compiler "CompilerParseExprTyped";
MapPrimitiveName :: (name: *u8) -> s32 #foreign compiler "MapPrimitiveName";
BitBuiltin :: (name: *u8) -> s32 #foreign compiler "BitBuiltin";
SimdOpChecked :: (name: *u8) -> *u8 #foreign compiler "SimdOpChecked";
ArrayElementType :: (type: *u8, element: *u8, size: usize, capacity: *s32) -> s32 #foreign compiler "ArrayElementType";
SliceElementType :: (type: *u8, element: *u8, size: usize) -> s32 #foreign compiler "SliceElementType";
VecElementType :: (module: *IR.ZirModule, type: *u8, element: *u8, size: usize) -> s32 #foreign compiler "VecElementType";
same_type_application :: (target_owner: *IR.ZirModule, target: *IR.ZirType, source_owner: *IR.ZirModule, source: *IR.ZirType) -> s32 #foreign compiler "same_type_application";
ModuleNeedsStartup :: (module: *IR.ZirModule) -> s32 #foreign compiler "ModuleNeedsStartup";
FindVisibleLaw :: (module: *IR.ZirModule, name: *u8, owner: **IR.ZirModule) -> *IR.ZirLaw #foreign compiler "FindVisibleLaw";
TargetProcedureTypeSupported :: (target: *u8, c_call: s32) -> s32 #foreign compiler "TargetProcedureTypeSupported";

Parameter :: struct {
    text: *u8
    name: *u8
    type: *u8
    binding_name: *u8
    value_type: *u8
    default_value: *u8
    is_using: s32
}
Parameters :: struct {
    count: s32
    items: [1]Parameter
}
ParametersOf :: (text: *u8) -> *Parameters #foreign compiler "ParametersOf";

ParameterAt :: (parameters: *Parameters, index: s32) -> *Parameter {
    return cast(*Parameter)(cast(usize)(*parameters.items[0]) + cast(usize)index * size_of(Parameter))
}

StaticText :: struct { data: *u8; length: usize }
CStr :: (s: string) -> *u8 { return (cast(*StaticText)(*s)).data }
PtrAdd :: (p: *u8, n: usize) -> *u8 { return cast(*u8)(cast(usize)p + n) }
PtrSub :: (p: *u8, n: usize) -> *u8 { return cast(*u8)(cast(usize)p - n) }
// Bytes from FROM up to TO, which lies at or after it.
Distance :: (from: *u8, to: *u8) -> usize { return cast(usize)to - cast(usize)from }
Same :: (a: *u8, b: *u8) -> bool { return strcmp(a, b) == 0 }
IsAlpha :: (c: u8) -> bool { return (c >= #char "a" && c <= #char "z") || (c >= #char "A" && c <= #char "Z") }
IsDigit :: (c: u8) -> bool { return c >= #char "0" && c <= #char "9" }
IsAlnum :: (c: u8) -> bool { return IsAlpha(c) || IsDigit(c) }
IsSpace :: (c: u8) -> bool { return c == #char " " || (c >= 9 && c <= 13) }
// Bytes a size is counted in, never zero, as calloc and malloc get them.
AtLeastOne :: (count: s32) -> usize { return ifx count > 0 then cast(usize)count else 1 }

FunctionArgs :: (fn: *IR.ZirFunction) -> *u8 { return ifx fn.args_text != null then fn.args_text else CStr("") }
ModuleAt :: (program: *IR.ZirProgram, index: s32) -> *IR.ZirModule { return *program.modules[index] }
FunctionAt :: (module: *IR.ZirModule, index: s32) -> *IR.ZirFunction { return *module.functions[index] }
TypeAt :: (module: *IR.ZirModule, index: s32) -> *IR.ZirType { return *module.types[index] }
ImportAt :: (module: *IR.ZirModule, index: s32) -> *IR.ZirImport { return *module.imports[index] }
GlobalAt :: (module: *IR.ZirModule, index: s32) -> *IR.ZirGlobal { return *module.globals[index] }
DefineAt :: (module: *IR.ZirModule, index: s32) -> *IR.ZirDefine { return *module.defines[index] }
LawAt :: (module: *IR.ZirModule, index: s32) -> *IR.ZirLaw { return *module.laws[index] }
ProofAt :: (module: *IR.ZirModule, index: s32) -> *IR.ZirProof { return *module.proofs[index] }
StatementAt :: (fn: *IR.ZirFunction, index: s32) -> *IR.ZirStmt { return *fn.stmts[index] }
ExprAt :: (fn: *IR.ZirFunction, index: s32) -> *IR.ZirExpr { return *fn.exprs[index] }

CommandSpan :: () -> IR.ZirSourceSpan { return Span(CStr("<command>"), 1, 1) }

// Whether a host import still waits for a provider: no `ziran:` target yet.
BoundToZiran :: (target: *u8) -> bool { return strncmp(target, CStr("ziran:"), 6) == 0 }

IsHostCapability :: (imported: *IR.ZirImport) -> bool {
    return imported.kind == .EXTERN && imported.extern_kind == .HOST
}

SplitBindingName :: (text: *u8, module: *u8, function: *u8) -> bool {
    separator: *u8 = null
    if text != null { separator = strrchr(text, #char ":") }
    if separator == null || separator == text || separator[1] == 0 { return false }
    length := Distance(text, separator)
    rest := PtrAdd(separator, 1)
    if length >= IR.ZIR_NAME_MAX || strlen(rest) >= IR.ZIR_NAME_MAX { return false }
    memcpy(module, text, length)
    module[length] = 0
    strcpy(function, rest)
    return true
}

// A binding may name a module by its import path, such as
// kryon/raster_text:RasterText, when a project supplies the package map.
ResolveBindingModule :: (module: *u8) -> bool {
    if strchr(module, #char "/") == null { return true }
    path := getenv(CStr("ZIRAN_PACKAGE_MAP"))
    if path == null || path[0] == 0 {
        Diagnostic(CommandSpan(), CStr("host.bind"), CStr("host binding %s names a package module; run it with --project"), module)
        return false
    }
    map := PackageMapLoad(path)
    identity: [IR.ZIR_NAME_MAX]u8
    found := map != null && PackageDependencyModule(map, CStr("root"), module, *identity[0], IR.ZIR_NAME_MAX) != 0
    PackageMapFree(map)
    if !found {
        Diagnostic(CommandSpan(), CStr("host.bind"), CStr("host binding names %s, which no direct dependency has"), module)
        return false
    }
    snprintf(module, IR.ZIR_NAME_MAX, CStr("%s"), *identity[0])
    return true
}

// Binds MATCHED, a host capability, to FUNCTION of PROVIDER_MODULE.
BindImport :: (matched: *IR.ZirImport, provider_module: *u8, function: *u8) {
    snprintf(*matched.target[0], IR.ZIR_PATH_MAX, CStr("ziran:%s"), provider_module)
    snprintf(*matched.extern_symbol[0], IR.ZIR_NAME_MAX, CStr("%s"), function)
}

// Bind one declared host capability to an exported Ziran implementation.
#program_export
BindHostProvider :: (program: *IR.ZirProgram, spec: *u8) -> s32 {
    equals := strchr(spec, #char "=")
    source: [256]u8
    provider: [256]u8
    source_module: [IR.ZIR_NAME_MAX]u8
    source_function: [IR.ZIR_NAME_MAX]u8
    provider_module: [IR.ZIR_NAME_MAX]u8
    provider_function: [IR.ZIR_NAME_MAX]u8
    matched: *IR.ZirImport = null
    implementation: *IR.ZirFunction = null
    if equals == null || Distance(spec, equals) >= 256 || strlen(PtrAdd(equals, 1)) >= 256 {
        Diagnostic(CommandSpan(), CStr("host.bind"), CStr("invalid host binding: %s"), spec)
        return 0
    }
    memcpy(*source[0], spec, Distance(spec, equals))
    source[Distance(spec, equals)] = 0
    strcpy(*provider[0], PtrAdd(equals, 1))
    if !SplitBindingName(*source[0], *source_module[0], *source_function[0]) ||
       !SplitBindingName(*provider[0], *provider_module[0], *provider_function[0]) {
        Diagnostic(CommandSpan(), CStr("host.bind"), CStr("invalid host binding: %s"), spec)
        return 0
    }
    if !ResolveBindingModule(*source_module[0]) || !ResolveBindingModule(*provider_module[0]) { return 0 }
    for m: 0..program.module_count - 1 {
        module := ModuleAt(program, m)
        if Same(*module.name[0], *source_module[0]) {
            for i: 0..module.import_count - 1 {
                imported := ImportAt(module, i)
                if IsHostCapability(imported) && Same(*imported.name[0], *source_function[0]) {
                    if matched != null {
                        Diagnostic(imported.span, CStr("host.bind"), CStr("ambiguous host capability: %s"), *source[0])
                        return 0
                    }
                    matched = imported
                }
            }
        }
        if Same(*module.name[0], *provider_module[0]) {
            for i: 0..module.function_count - 1 {
                function := FunctionAt(module, i)
                if Same(*function.name[0], *provider_function[0]) && function.exported != 0 && function.is_extern == 0 {
                    if implementation != null {
                        Diagnostic(function.span, CStr("host.bind"), CStr("ambiguous Ziran provider: %s"), *provider[0])
                        return 0
                    }
                    implementation = function
                }
            }
        }
    }
    if matched == null {
        Diagnostic(CommandSpan(), CStr("host.bind"), CStr("host capability is missing: %s; module %s declares no host capability %s"),
                   spec, *source_module[0], *source_function[0])
        return 0
    }
    if implementation == null {
        Diagnostic(CommandSpan(), CStr("host.bind"), CStr("exported Ziran provider is missing: %s; no module %s exports %s"),
                   spec, *provider_module[0], *provider_function[0])
        return 0
    }
    if BoundToZiran(*matched.target[0]) {
        BoundTwice(program, matched, *source[0], *provider_module[0], *provider_function[0])
        return 0
    }
    BindImport(matched, *provider_module[0], *provider_function[0])
    return 1
}

// The source file of the module named NAME in PROGRAM, or "?".
ModuleFile :: (program: *IR.ZirProgram, name: *u8) -> *u8 {
    for m: 0..program.module_count - 1 {
        module := ModuleAt(program, m)
        if Same(*module.name[0], name) { return *module.source_path[0] }
    }
    return CStr("?")
}

// Reports a second binding of CAPABILITY, already bound to a Ziran
// provider, naming both providers and their files.
BoundTwice :: (program: *IR.ZirProgram, matched: *IR.ZirImport, capability: *u8, module: *u8, function: *u8) {
    bound := PtrAdd(*matched.target[0], 6)
    Diagnostic(CommandSpan(), CStr("host.bind"),
               CStr("host capability %s is already bound by %s:%s (%s); %s:%s (%s) also provides it"),
               capability, bound, *matched.extern_symbol[0], ModuleFile(program, bound),
               module, function, ModuleFile(program, module))
}

// Binds every host capability no --bind has claimed to the exported Ziran
// function of the same name in the provider module, as a C program links a
// host's exported symbols by name. One Ziran host module, such as Kryon's
// pixmap backend, then serves every target.
#program_export
BindHostModule :: (program: *IR.ZirProgram, spec: *u8) -> s32 {
    provider_module: [IR.ZIR_NAME_MAX]u8
    provider: *IR.ZirModule = null
    if strlen(spec) >= IR.ZIR_NAME_MAX || spec[0] == 0 {
        Diagnostic(CommandSpan(), CStr("host.bind"), CStr("invalid host provider module: %s"), spec)
        return 0
    }
    strcpy(*provider_module[0], spec)
    if !ResolveBindingModule(*provider_module[0]) { return 0 }
    for m: 0..program.module_count - 1 {
        candidate := ModuleAt(program, m)
        if Same(*candidate.name[0], *provider_module[0]) { provider = candidate }
    }
    if provider == null {
        Diagnostic(CommandSpan(), CStr("host.bind"), CStr("host provider module %s is not in the program"), spec)
        return 0
    }
    for m: 0..program.module_count - 1 {
        module := ModuleAt(program, m)
        for i: 0..module.import_count - 1 {
            imported := ImportAt(module, i)
            if !IsHostCapability(imported) || BoundToZiran(*imported.target[0]) { continue }
            for f: 0..provider.function_count - 1 {
                function := FunctionAt(provider, f)
                if function.exported != 0 && function.is_extern == 0 && Same(*function.name[0], *imported.name[0]) {
                    BindImport(imported, *provider_module[0], *function.name[0])
                    break
                }
            }
        }
    }
    return 1
}

ModuleNameOrder :: (left: *void, right: *void) -> s32 {
    a := cast(*IR.ZirModule)left
    b := cast(*IR.ZirModule)right
    return strcmp(*a.name[0], *b.name[0])
}

// A copy of COUNT records of SIZE bytes, or null when the copy is empty
// (FAILED is set when memory runs out).
CopyRecords :: (source: *u8, count: s32, size: usize, failed: *bool) -> *u8 {
    if count <= 0 { return null }
    copy := malloc(cast(usize)count * size)
    if copy == null {
        <<failed = true
        return null
    }
    memcpy(copy, source, cast(usize)count * size)
    return copy
}

CopyFunction :: (target: *IR.ZirFunction, source: *IR.ZirFunction) -> bool {
    <<target = <<source
    target.stmts = null
    target.exprs = null
    // These private arrays contain only the live nodes, not the source's
    // spare storage. Later checking/lowering can append to either array.
    target.stmt_cap = source.stmt_count
    target.expr_cap = source.expr_count
    failed := false
    target.stmts = cast(*IR.ZirStmt)CopyRecords(cast(*u8)source.stmts, source.stmt_count, size_of(IR.ZirStmt), *failed)
    if failed { return false }
    target.exprs = cast(*IR.ZirExpr)CopyRecords(cast(*u8)source.exprs, source.expr_count, size_of(IR.ZirExpr), *failed)
    return !failed
}

// The entry linker works on a private checked graph. Its source may also be
// used for a different entry, so pruning must never change that graph.
CopyLaws :: (to: *IR.ZirModule, from: *IR.ZirModule) -> bool {
    if from.law_count != 0 {
        to.laws = cast(*IR.ZirLaw)calloc(cast(usize)from.law_count, size_of(IR.ZirLaw))
        if to.laws == null { return false }
        to.law_count = from.law_count
        to.law_cap = from.law_count
        for l: 0..from.law_count - 1 {
            law := LawAt(to, l)
            original := LawAt(from, l)
            <<law = <<original
            law.claim = null
            law.proof = null
            if original.claim != null {
                law.claim = cast(*IR.ZirFunction)calloc(1, size_of(IR.ZirFunction))
                if law.claim == null || !CopyFunction(law.claim, original.claim) { return false }
            }
        }
    }
    if from.law_waiver_count != 0 {
        failed := false
        to.law_waivers = cast(*IR.ZirLawWaiver)CopyRecords(cast(*u8)from.law_waivers, from.law_waiver_count, size_of(IR.ZirLawWaiver), *failed)
        if failed { return false }
        to.law_waiver_count = from.law_waiver_count
        to.law_waiver_cap = from.law_waiver_count
    }
    if from.proof_count != 0 {
        to.proofs = cast(*IR.ZirProof)calloc(cast(usize)from.proof_count, size_of(IR.ZirProof))
        if to.proofs == null { return false }
        to.proof_count = from.proof_count
        to.proof_cap = from.proof_count
        for p: 0..from.proof_count - 1 {
            proof := ProofAt(to, p)
            original := ProofAt(from, p)
            <<proof = <<original
            proof.steps = null
            proof.owner = null
            memset(cast(*u8)*proof.terms, 0, size_of(IR.ZirFunction))
            if !CopyFunction(*proof.terms, *original.terms) { return false }
            if proof.step_count != 0 {
                failed := false
                proof.steps = cast(*IR.ZirProofStep)CopyRecords(cast(*u8)original.steps, proof.step_count, size_of(IR.ZirProofStep), *failed)
                if failed { return false }
            }
        }
    }
    return true
}

// A module record that shares FROM's identity and owns no declarations yet.
ClearModuleCopy :: (to: *IR.ZirModule, from: *IR.ZirModule, context: *u8) {
    <<to = <<from
    to.context = context
    to.bundle_library = null
    to.bundle_shared_functions = 0
    to.globals = null
    to.global_count = 0
    to.global_cap = 0
    to.defines = null
    to.define_count = 0
    to.define_cap = 0
    to.asserts = null
    to.assert_count = 0
    to.assert_cap = 0
    to.usings = null
    to.using_count = 0
    to.using_cap = 0
    to.types = null
    to.type_count = 0
    to.type_cap = 0
    to.imports = null
    to.import_count = 0
    to.import_cap = 0
    SymbolLookupsChanged()
    to.functions = null
    to.function_count = 0
    to.function_cap = 0
    to.laws = null
    to.law_count = 0
    to.law_cap = 0
    to.law_waivers = null
    to.law_waiver_count = 0
    to.law_waiver_cap = 0
    to.proofs = null
    to.proof_count = 0
    to.proof_cap = 0
    to.parameters = null
    to.parameter_count = 0
    to.parameter_cap = 0
}

CopyModule :: (to: *IR.ZirModule, from: *IR.ZirModule, context: *u8) -> bool {
    ClearModuleCopy(to, from, context)
    if !CopyLaws(to, from) { return false }
    failed := false
    to.globals = cast(*IR.ZirGlobal)CopyRecords(cast(*u8)from.globals, from.global_count, size_of(IR.ZirGlobal), *failed)
    if failed { return false }
    if from.global_count > 0 {
        to.global_count = from.global_count
        to.global_cap = from.global_count
    }
    to.defines = cast(*IR.ZirDefine)CopyRecords(cast(*u8)from.defines, from.define_count, size_of(IR.ZirDefine), *failed)
    if failed { return false }
    if from.define_count > 0 {
        to.define_count = from.define_count
        to.define_cap = from.define_count
    }
    to.asserts = cast(*IR.ZirAssert)CopyRecords(cast(*u8)from.asserts, from.assert_count, size_of(IR.ZirAssert), *failed)
    if failed { return false }
    if from.assert_count > 0 {
        to.assert_count = from.assert_count
        to.assert_cap = from.assert_count
    }
    to.types = cast(*IR.ZirType)CopyRecords(cast(*u8)from.types, from.type_count, size_of(IR.ZirType), *failed)
    if failed { return false }
    if from.type_count > 0 {
        to.type_count = from.type_count
        to.type_cap = from.type_count
    }
    to.imports = cast(*IR.ZirImport)CopyRecords(cast(*u8)from.imports, from.import_count, size_of(IR.ZirImport), *failed)
    if failed { return false }
    if from.import_count > 0 {
        to.import_count = from.import_count
        to.import_cap = from.import_count
    }
    to.parameters = cast(*IR.ZirModuleParameter)CopyRecords(cast(*u8)from.parameters, from.parameter_count, size_of(IR.ZirModuleParameter), *failed)
    if failed { return false }
    if from.parameter_count > 0 {
        to.parameter_count = from.parameter_count
        to.parameter_cap = from.parameter_count
    }
    if from.function_count > 0 {
        to.functions = cast(*IR.ZirFunction)calloc(cast(usize)from.function_count, size_of(IR.ZirFunction))
        if to.functions == null { return false }
        to.function_count = from.function_count
        to.function_cap = from.function_count
        for f: 0..from.function_count - 1 {
            if !CopyFunction(FunctionAt(to, f), FunctionAt(from, f)) { return false }
        }
    }
    return true
}

CopyProgram :: (source: *IR.ZirProgram) -> *IR.ZirProgram {
    result := ProgramNew()
    if result == null { return null }
    result.modules = cast(*IR.ZirModule)calloc(AtLeastOne(source.module_count), size_of(IR.ZirModule))
    copied := result.modules != null && ProgramInheritContexts(result, source) != 0
    if copied {
        result.module_count = source.module_count
        result.module_cap = source.module_count
        for m: 0..source.module_count - 1 {
            if copied { copied = CopyModule(ModuleAt(result, m), ModuleAt(source, m), result.context) }
        }
    }
    if copied { copied = LinkImports(*result, 1) != 0 }
    if copied { copied = CheckLawGates(*result, 1) != 0 }
    if !copied {
        ProgramFree(result)
        return null
    }
    return result
}

// NATIVE is 1 for C and native links and 2 for Go, whose interfaces also
// keep the methods of every reachable receiver record.
LinkNative :: (program: *IR.ZirProgram, entry_module: *u8, entry_function: *u8, native: s32) -> *IR.ZirProgram {
    optimized := CopyProgram(program)
    if optimized == null { return null }
    for m: 0..optimized.module_count - 1 {
        module := ModuleAt(optimized, m)
        for f: 0..module.function_count - 1 {
            if !PruneFunction(FunctionAt(module, f)) {
                ProgramFree(optimized)
                return null
            }
        }
    }
    linked := LinkCheckedEntry(optimized, entry_module, entry_function, native)
    ProgramFree(optimized)
    return linked
}

ProgramContext :: (program: *IR.ZirProgram) -> *u8 { return ifx program != null then program.context else null }

// Native entry pruning also retains exported implementations of host effects.
#program_export
NativeLink :: (program: *IR.ZirProgram, entry_module: *u8, entry_function: *u8) -> *IR.ZirProgram {
    previous := CompilerContextSelect(ProgramContext(program))
    linked := LinkNative(program, entry_module, entry_function, 1)
    CompilerContextSelect(previous)
    return linked
}

// Go entry pruning also retains methods of reachable receiver records.
#program_export
NativeGoLink :: (program: *IR.ZirProgram, entry_module: *u8, entry_function: *u8) -> *IR.ZirProgram {
    previous := CompilerContextSelect(ProgramContext(program))
    linked := LinkNative(program, entry_module, entry_function, 2)
    CompilerContextSelect(previous)
    return linked
}

// Whether a call or function value in FUNCTION names WANTED.
FunctionUses :: (module: *IR.ZirModule, function: *IR.ZirFunction, wanted: *IR.ZirFunction) -> bool {
    for e: 0..function.expr_count - 1 {
        expression := ExprAt(function, e)
        direct_call := expression.kind == .CALL && expression.slot_type[0] == 0
        if !direct_call && expression.is_function_value == 0 { continue }
        owner: *IR.ZirModule = null
        callee: *IR.ZirFunction = null
        if ResolveFunction(module, expression.name, *owner, *callee) == 1 && callee == wanted { return true }
    }
    return false
}

// True when code in a linked program calls FUNCTION directly or takes it as
// a value, in a procedure body or a global initializer.
#program_export
ProgramUsesFunction :: (program: *IR.ZirProgram, function: *IR.ZirFunction) -> s32 {
    previous := CompilerContextSelect(program.context)
    used := false
    for m: 0..program.module_count - 1 {
        if used { break }
        module := ModuleAt(program, m)
        for f: 0..module.function_count - 1 {
            candidate := FunctionAt(module, f)
            if candidate.is_template == 0 && FunctionUses(module, candidate, function) {
                used = true
                break
            }
        }
        // An initializer that runs out of memory counts as a use.
        for g: 0..module.global_count - 1 {
            if used { break }
            nowhere: s32 = 0
            no_keep: **u8 = null
            used = MarkGlobalFunctions(program, module, GlobalAt(module, g), no_keep, *nowhere, null, function) != 0
        }
    }
    CompilerContextSelect(previous)
    return ifx used then 1 else 0
}
