// Shared diagnostic transport for the native commands implemented in Ziran.
#import "std/file_linux"

#scope_file
json_format: bool = false;

#scope_export
SetFormat :: (format: string) -> bool {
    if format == "json" { json_format = true; return true }
    if format == "text" || format == "" { json_format = false; return true }
    return false
}

IsJson :: () -> bool { return json_format }

WriteText :: (value: string, error: bool) {
    stream: FileHandle = .{fd=1, valid=true}
    if error { stream.fd = 2 }
    bytes: [4096]u8
    index: s64 = 0
    while index < cast(s64)value.count {
        count: s64 = cast(s64)value.count - index
        if count > 4096 { count = 4096 }
        for offset: 0..count - 1 { bytes[offset] = value[index + offset] }
        written := Write(stream, bytes[0:count])
        if written <= 0 { return }
        index += written
    }
}

Utf8Length :: (value: string, at: s64) -> s64 {
    first := value[at]
    length: s64 = 0
    if first >= 194 && first <= 223 { length = 2 }
    if first >= 224 && first <= 239 { length = 3 }
    if first >= 240 && first <= 244 { length = 4 }
    if length == 0 || length > cast(s64)value.count - at { return 0 }
    for offset: 1..length - 1 {
        if value[at + offset] < 128 || value[at + offset] > 191 { return 0 }
    }
    if (first == 224 && value[at + 1] < 160) ||
       (first == 237 && value[at + 1] >= 160) ||
       (first == 240 && value[at + 1] < 144) ||
       (first == 244 && value[at + 1] >= 144) { return 0 }
    return length
}

Quote :: (value: string, error: bool) {
    WriteText("\"", error)
    index: s64 = 0
    while index < cast(s64)value.count {
        byte := value[index]
        if byte == 34 || byte == 92 {
            WriteText("\\", error)
            WriteText(value[index:index + 1], error)
        } else if byte == 10 { WriteText("\\n", error) }
        else if byte == 13 { WriteText("\\r", error) }
        else if byte == 9 { WriteText("\\t", error) }
        else if byte >= 128 && Utf8Length(value, index) > 0 {
            length := Utf8Length(value, index)
            WriteText(value[index:index + length], error)
            index += length - 1
        } else if byte < 32 || byte >= 128 {
            alphabet := "0123456789abcdef"
            high := cast(s32)(byte >> cast(u8)4)
            low := cast(s32)(byte & cast(u8)15)
            WriteText("\\u00", error)
            WriteText(alphabet[high:high + 1], error)
            WriteText(alphabet[low:low + 1], error)
        } else { WriteText(value[index:index + 1], error) }
        index += 1
    }
    WriteText("\"", error)
}

// Budgets apply before escaping (at most six JSON bytes per input byte).
// Slice only at a validated UTF-8 boundary. Invalid bytes remain escaped.
Bounded :: (value: string, limit: s64) -> string {
    index: s64 = 0
    while index < cast(s64)value.count && index < limit {
        length := Utf8Length(value, index)
        if length == 0 { length = 1 }
        if length > limit - index { break }
        index += length
    }
    return value[0:index]
}

Emit :: (code: string, message: string, path: string) {
    bounded_message := Bounded(message, 2048)
    WriteText("{\"schema_version\":2,\"severity\":\"error\",\"code\":", true)
    Quote(Bounded(code, 128), true)
    WriteText(",\"message\":", true)
    Quote(bounded_message, true)
    WriteText(",\"path\":", true)
    if path.count > 1024 { WriteText("null", true) }
    else { Quote(path, true) }
    WriteText(",\"line\":0,\"column\":0,\"end_line\":0,\"end_column\":0,\"semantic_id\":null,\"cause\":null,\"document\":null,\"related_graph\":{\"nodes\":[],\"edges\":[]},\"alternatives\":[],\"truncation\":{\"message\":", true)
    if bounded_message.count < message.count { WriteText("true", true) }
    else { WriteText("false", true) }
    WriteText(",\"metadata\":", true)
    if code.count > 128 || path.count > 1024 { WriteText("true", true) }
    else { WriteText("false", true) }
    WriteText("}}\n", true)
}
