#import "package_common"
#import "package_manifest"
#import "package_lock"
#import "package_map"
#import "package_add"
#import "package_guide"
#import "package_capabilities"
#import "package_features"
#import "package_explain"
#import "package_options"
#import "package_compile_commands"
#import "package_template"
#import "package_python"
#import "file_linux"

// `ziran compile-commands [--compiler CC] [--include DIR] [-o FILE] DIR`
// describes the generated C in DIR to editors. The include directory
// defaults to the pinned toolchain's under --project, otherwise to the one
// beside this launcher.
PkgCompileCommands :: (arguments: []string, project: bool, locked: *PkgLock,
    launcher: string) -> s32 {
    compiler: string = PkgGetenv("CC")
    if compiler.count == 0 { compiler = "cc" }
    include: string = ""
    output: string = ""
    generated: string = ""
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if (part == "--compiler" || part == "--include" || part == "-o") &&
           index + 1 < cast(s32)arguments.count {
            if part == "--compiler" { compiler = arguments[index + 1] }
            if part == "--include" { include = arguments[index + 1] }
            if part == "-o" { output = arguments[index + 1] }
            index += 2
        } else if generated.count == 0 && part.count > 0 && part[0] != cast(u8)45 {
            generated = part
            index += 1
        } else {
            return PkgFail("usage: ziran compile-commands [--compiler CC] [--include DIR] [-o FILE] GENERATED_DIR")
        }
    }
    if generated.count == 0 {
        return PkgFail("usage: ziran compile-commands [--compiler CC] [--include DIR] [-o FILE] GENERATED_DIR")
    }
    if include.count == 0 {
        if project { include = PkgJoin(locked.tool_path, "/include") }
        else {
            // build/bin/ziran, or a variant build such as build/sanitize/bin.
            include = PkgJoin(PkgLauncherDirectory(launcher), "/../../include")
            if !PathExists(PkgJoin(include, "/zir_string.h")) {
                include = PkgJoin(PkgLauncherDirectory(launcher), "/../../../include")
            }
        }
    }
    if !PathExists(PkgJoin(include, "/zir_string.h")) {
        return PkgFail("cannot find Ziran's include directory; pass --include DIR")
    }
    if output.count == 0 { output = PkgJoin(generated, "/compile_commands.json") }
    problem: string = WriteCompileCommands(include, compiler, generated, output)
    if problem.count > 0 { return PkgFail(problem) }
    return 0
}

PkgHasArgument :: (arguments: []string, expected: string) -> bool {
    index: s32 = 0
    while index < cast(s32)arguments.count {
        if arguments[index] == expected { return true }
        index += 1
    }
    return false
}

// A variant launcher built by this pinned compiler uses its own sibling
// tools. This keeps sanitizer and other variant builds together instead of
// rebuilding the default toolchain while independent checks are running.
PkgToolDirectory :: (launcher: string, tool_path: string, tool: string) -> string {
    tool_root := PkgJoin(PkgCanonical(tool_path), "/")
    own := PkgCanonical(launcher)
    directory := PkgLauncherDirectory(launcher)
    if tool_root.count > 1 && own.count > tool_root.count &&
       own[0:tool_root.count] == tool_root &&
       PathExists(PkgJoin3(directory, "/", tool)) {
        return directory
    }
    return PkgJoin(tool_path, "/build/bin")
}

PkgPrepareSubmodules :: (directory: string, offline: bool) -> bool {
    args: [7]string
    args[0] = "git"
    args[1] = "-C"
    args[2] = directory
    args[3] = "submodule"
    args[4] = "status"
    args[5] = "--recursive"
    result: PkgProcessResult = PkgCaptureRaw(args[0:6], "")
    if result.code != 0 { return false }
    at: s64 = 0
    while at < cast(s64)result.text.count {
        if result.text[at] != cast(u8)32 {
            if offline { return false }
            args[4] = "update"
            args[5] = "--init"
            args[6] = "--recursive"
            updated: PkgProcessResult = PkgCapture(args[:], "")
            return updated.code == 0
        }
        while at < cast(s64)result.text.count &&
            result.text[at] != cast(u8)10 { at += 1 }
        at += 1
    }
    return true
}

// Shows each direct dependency, where it comes from, and the import path of
// every module it exports:
//
//   kryon  git@github.com:kryonlabs/kryon.git  master  0123456789ab
//     #import "kryon/Widgets"    src/ui/Widgets/module.zi
PkgList :: (locked: *PkgLock, current: *PkgManifest, selector: string) -> s32 {
    found: bool = false
    index: s32 = 0
    while index < current.dependency_count {
        dependency: *PkgDependency = *current.dependencies[index]
        index += 1
        if selector.count > 0 && !PkgFoldEqual(dependency.alias, selector) {
            continue
        }
        found = true
        target: s32 = PkgFindById(locked, PkgEdgeValue(*locked.root_edges[0],
            locked.root_edge_count, dependency.alias))
        if target < 0 { return PkgFail("package is not locked; run ziran lock") }
        item: *PkgLocked = *locked.packages[target]
        PkgPrint(PkgJoin3(dependency.alias, "  ", dependency.git), false)
        PkgPrint(PkgJoin3("  ", dependency.ref, "  "), false)
        PkgPrint(item.commit[0:12], false)
        PkgPrint(PkgJoin3("\n  checkout ", item.path, "\n"), false)
        if item.source {
            PkgPrint("  source checkout; no Ziran modules\n", false)
            continue
        }
        exported: s32 = 0
        while exported < item.manifest.export_count {
            name: PkgNamedValue = item.manifest.exports[exported]
            line: string = PkgJoin3("  #import \"", dependency.alias, "/")
            line = PkgJoin3(line, name.name, "\"")
            while line.count < 36 { line = PkgJoin(line, " ") }
            PkgPrint(PkgJoin3(line, " ", name.value), false)
            PkgPrint("\n", false)
            exported += 1
        }
    }
    if selector.count > 0 && !found { return PkgFail("no dependency with that name") }
    if selector.count == 0 {
        PkgPrint(PkgJoin3("std  ", locked.tool_path, "/std\n"), false)
        PkgPrint("  #import \"std/NAME\"               the standard library\n", false)
    }
    return 0
}

PkgDispatch :: (command: string, arguments: []string, project: bool,
    root: string, locked: *PkgLock, current: *PkgManifest,
    launcher: string, extra_names: []string, extra_values: []string) -> s32 {
    executable: string = ""
    check: bool = command == "check"
    bundle: bool = command == "bundle" || command == "run"
    build: bool = command == "build"
    if check || command == "ir" { executable = "zi2zir" }
    else if command == "api" { executable = "zi-api" }
    else if command == "inspect" { executable = "zi-inspect" }
    else if command == "fmt" { executable = "zi-fmt" }
    else if bundle { executable = "zi2zib" }
    else if build {
        target: string = ""
        index: s32 = 0
        while index < cast(s32)arguments.count {
            if arguments[index] == "--target=c" ||
               arguments[index] == "--target=cpp" ||
               arguments[index] == "--target=go" ||
               arguments[index] == "--target=rust" ||
               arguments[index] == "--target=py" ||
               arguments[index] == "--target=plan9-c" {
                target = arguments[index]
            }
            index += 1
        }
        if target == "--target=c" { executable = "zi2c" }
        else if target == "--target=cpp" { executable = "zi2cpp" }
        else if target == "--target=go" { executable = "zi2go" }
        else if target == "--target=rust" { executable = "zi2rust" }
        else if target == "--target=py" { executable = "zi2py" }
        else if target == "--target=plan9-c" { executable = "zi2c" }
        else { return PkgFail("build needs --target=c|cpp|go|rust|py|plan9-c") }
    }
    if executable.count == 0 { return PkgFail("unknown Ziran command") }
    tool_directory: string = PkgLauncherDirectory(launcher)
    if project { tool_directory = PkgToolDirectory(launcher, locked.tool_path, executable) }
    if tool_directory.count == 0 { return PkgFail("cannot find Ziran binaries") }
    binary: string = PkgJoin3(tool_directory, "/", executable)
    names: [8]string
    values: [8]string
    names[0] = "ZIRAN_PACKAGE_MAP"
    values[0] = ""
    environment: s32 = 1
    while environment - 1 < cast(s32)extra_names.count && environment < 8 {
        names[environment] = extra_names[environment - 1]
        values[environment] = extra_values[environment - 1]
        environment += 1
    }
    if project {
        if !PathExists(binary) {
            make_args: [5]string
            make_args[0] = "make"
            make_args[1] = "-C"
            make_args[2] = locked.tool_path
            make_args[3] = "all"
            // The pinned launcher is build/bin/ziran whatever BUILD_DIR the
            // calling make passed down, such as the sanitizer build's.
            make_args[4] = "BUILD_DIR=build"
            empty: [0]string
            if PkgRunToStderr(make_args[:], "") != 0 {
                return PkgFail("cannot build pinned Ziran compiler")
            }
        }
        values[0] = PkgWriteMap(root, locked, current)
        if values[0].count == 0 { return PkgFail("cannot build project import map") }
    }
    child: [260]string
    count: s32 = 0
    child[count] = binary
    count += 1
    if check { child[count] = "--check-only"; count += 1 }
    // `ziran build -o DIR` owns DIR: generated files from an earlier build
    // that this one does not write are removed so they cannot be linked.
    if build && executable != "zi2rust" {
        child[count] = "--prune-stale"
        count += 1
    }
    if bundle { child[count] = command; count += 1 }
    // `ziran run --project FILE.zib` runs a bundle with the pinned toolchain
    // that built it; a bundle takes no source root.
    if project && command != "run" && !PkgHasArgument(arguments, "--root") {
        child[count] = "--root"
        count += 1
        child[count] = PkgJoin3(root, "/", current.roots[0])
        count += 1
    }
    has_source: bool = false
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if build && part == "--target=plan9-c" {
            if count >= 259 { return PkgFail("too many arguments") }
            child[count] = "--plan9"
            count += 1
        } else if !(build && (part == "--target=c" || part == "--target=cpp" ||
                   part == "--target=go" || part == "--target=rust" ||
                   part == "--target=py")) {
            if count >= 259 { return PkgFail("too many arguments") }
            child[count] = part
            count += 1
            if PkgEndsWith(part, ".zi") || PkgEndsWith(part, ".zir") {
                has_source = true
            }
        }
        index += 1
    }
    if project && !has_source &&
       (check || command == "ir" || command == "api" || build || command == "bundle") {
        entry: string = PkgJoin3(root, "/", current.entry)
        // A library has no app entry; checking it checks what it exports.
        if !PathExists(entry) && current.export_count > 0 &&
           (check || command == "ir" || command == "api") {
            index = 0
            while index < current.export_count && count < 259 {
                child[count] = PkgJoin3(root, "/", current.exports[index].value)
                seen: bool = false
                earlier: s32 = 0
                while earlier < index {
                    if current.exports[earlier].value == current.exports[index].value {
                        seen = true
                    }
                    earlier += 1
                }
                if !seen { count += 1 }
                index += 1
            }
        } else {
            child[count] = entry
            count += 1
        }
    }
    return PkgRun(child[0:count], "", names[0:environment], values[0:environment])
}

// True when an argument before `--` names a source, saved IR, or bundle
// file: the command then works on that file, not on the project's program.
PkgHasSource :: (arguments: []string) -> bool {
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if part == "--" { return false }
        if PkgEndsWith(part, ".zi") || PkgEndsWith(part, ".zir") ||
           PkgEndsWith(part, ".zib") { return true }
        index += 1
    }
    return false
}

PkgHasBundle :: (arguments: []string) -> bool {
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if part == "--" { return false }
        if PkgEndsWith(part, ".zib") { return true }
        index += 1
    }
    return false
}

PkgHasTarget :: (arguments: []string) -> bool {
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if part == "--" { return false }
        if part.count >= 8 && part[0:8] == "--target" { return true }
        index += 1
    }
    return false
}

// The module a source path defines: src/main.zi is main.
PkgModuleName :: (path: string) -> string {
    start: s64 = cast(s64)path.count
    while start > 0 && path[start - 1] != cast(u8)47 { start -= 1 }
    name: string = path[start:]
    if PkgEndsWith(name, ".zi") { name = name[0:cast(s64)name.count - 3] }
    return name
}

// `ziran build` in a project without a tool: the entry module's main
// becomes build/NAME through C. [package] links adds -l libraries.
PkgNativeBuild :: (root: string, locked: *PkgLock, current: *PkgManifest,
    launcher: string) -> string {
    module: string = PkgModuleName(current.entry)
    if !PathExists(PkgJoin3(root, "/", current.entry)) {
        PkgFail(PkgJoin3("the package entry ", current.entry, " does not exist"))
        return ""
    }
    generated: string = PkgJoin(root, "/build/generated/c")
    if !PkgMkdirs(generated) {
        PkgFail("cannot create build/generated/c")
        return ""
    }
    libraries: string = PkgGetenv("LDLIBS")
    index: s32 = 0
    while index < current.link_count {
        if libraries.count > 0 { libraries = PkgJoin(libraries, " ") }
        libraries = PkgJoin3(libraries, "-l", current.links[index])
        index += 1
    }
    arguments: [6]string
    arguments[0] = "--target=c"
    arguments[1] = "--exe"
    arguments[2] = "--entry"
    arguments[3] = PkgJoin(module, ":main")
    arguments[4] = "-o"
    arguments[5] = generated
    names: [1]string
    values: [1]string
    names[0] = "LDLIBS"
    values[0] = libraries
    if PkgDispatch("build", arguments[:], true, root, locked, current,
        launcher, names[:], values[:]) != 0 { return "" }
    program: string = PkgJoin3(root, "/build/", current.name)
    // A rename replaces the program in one step, so a running copy keeps
    // its own file.
    if !RenamePath(PkgJoin3(generated, "/", module), program) {
        PkgFail("cannot move the built program to build/")
        return ""
    }
    return program
}

// `ziran install` for a project without a tool copies its program to
// PREFIX/bin/BIN. The copy replaces the old file in one step.
PkgNativeInstall :: (root: string, locked: *PkgLock, current: *PkgManifest,
    launcher: string, prefix: string, bin: string) -> s32 {
    program: string = PkgNativeBuild(root, locked, current, launcher)
    if program.count == 0 { return 2 }
    directory: string = PkgJoin(prefix, "/bin")
    if !PkgMkdirs(directory) { return PkgFail(PkgJoin("cannot create ", directory)) }
    target: string = PkgJoin3(directory, "/", bin)
    staged: string = PkgJoin(target, ".ziran-new")
    copy: [5]string
    copy[0] = "cp"
    copy[1] = "-f"
    copy[2] = "--"
    copy[3] = program
    copy[4] = staged
    empty: [0]string
    if PkgRun(copy[:], "", empty[:], empty[:]) != 0 || !RenamePath(staged, target) {
        return PkgFail(PkgJoin("cannot install ", target))
    }
    PkgPrint(PkgJoin3("installed ", target, "\n"), false)
    return 0
}

// Arguments after the first `--` go to the program as they are; the others
// are the command's own.
PkgAfterSeparator :: (arguments: []string) -> s32 {
    index: s32 = 0
    while index < cast(s32)arguments.count {
        if arguments[index] == "--" { return index + 1 }
        index += 1
    }
    return cast(s32)arguments.count
}

// Runs a dependency's project tool from the project root with the resolved
// [tool.ALIAS] options. The tool is rebuilt when its sources changed, so a
// local override never runs a stale binary.
PkgRunTool :: (root: string, locked: *PkgLock, current: *PkgManifest,
    selector: string, arguments: []string, extra_names: []string,
    extra_values: []string) -> s32 {
    selected: s32 = PkgSelect(locked, selector)
    if selected < 0 { return PkgFail("package is not locked") }
    item: *PkgLocked = *locked.packages[selected]
    relative: string = PkgJoin("", item.manifest.project_tool)
    if relative.count == 0 || relative[0] == cast(u8)47 {
        return PkgFail("package has no project tool")
    }
    at: s64 = 0
    while at + 1 < cast(s64)relative.count {
        if relative[at] == cast(u8)46 &&
           relative[at + 1] == cast(u8)46 { return PkgFail("invalid project tool") }
        at += 1
    }
    alias: string = item.name
    index: s32 = 0
    while index < current.dependency_count {
        if PkgFoldEqual(current.dependencies[index].alias, selector) {
            alias = current.dependencies[index].alias
        }
        index += 1
    }
    options: string = PkgResolveOptions(root, alias, item.path)
    if options.count == 0 { return 2 }
    make_args: [7]string
    make_args[0] = "make"
    make_args[1] = "--silent"
    make_args[2] = "--no-print-directory"
    make_args[3] = "-C"
    make_args[4] = item.path
    make_args[5] = relative
    make_args[6] = PkgJoin("ZIRAN_DIR=", locked.tool_path)
    empty: [0]string
    if PkgRunToStderr(make_args[:], "") != 0 {
        return PkgFail("cannot build package tool")
    }
    names: [16]string
    values: [16]string
    names[0] = "ZIRAN_PROJECT_ROOT"
    names[1] = "ZIRAN_PACKAGE_ROOT"
    names[2] = "ZIRAN_PACKAGE_ID"
    names[3] = "ZIRAN_TOOLCHAIN_ROOT"
    names[4] = "ZIRAN_TOOL_OPTIONS"
    names[5] = "ZIRAN_PROJECT_NAME"
    names[6] = "ZIRAN_PROJECT_ENTRY"
    values[0] = root
    values[1] = item.path
    values[2] = item.id
    values[3] = locked.tool_path
    values[4] = options
    values[5] = current.name
    values[6] = current.entry
    count: s32 = 7
    index = 0
    while index < cast(s32)extra_names.count && count < 16 {
        names[count] = extra_names[index]
        values[count] = extra_values[index]
        count += 1
        index += 1
    }
    child: [257]string
    child[0] = PkgJoin3(item.path, "/", relative)
    index = 0
    while index < cast(s32)arguments.count && index < 256 {
        child[index + 1] = arguments[index]
        index += 1
    }
    return PkgRun(child[0:index + 1], root, names[0:count], values[0:count])
}

#program_export
PackageMain :: (launcher: string, arguments: []string) -> s32 {
    if arguments.count == 0 || arguments[0] == "help" ||
       arguments[0] == "--help" || arguments[0] == "-h" {
        PkgPrint("usage: ziran version|guide|features|capabilities|explain|api|new|init|lock|update|fetch|add|pkg|tool|install|check|ir|build|bundle|run|fmt|inspect|compile-commands ...\n", false)
        PkgPrint("project commands: --project [--locked] [--offline]\n", false)
        PkgPrint("in a project, run, build, check, and install without a file work on its program\n", false)
        PkgPrint("scripts: ziran run --target=py [--python PATH] [--no-cache] FILE.zi -- ARGS\n", false)
        PkgPrint("new to Ziran? run ziran guide\n", false)
        return 0
    }
    command: string = arguments[0]
    if command == "new" || command == "init" {
        return Template(launcher, command, arguments[1:])
    }
    if command == "guide" { return Guide(arguments[1:]) }
    if command == "features" { return Features(arguments[1:]) }
    if command == "capabilities" { return Capabilities(arguments[1:]) }
    if command == "explain" { return Explain(arguments[1:]) }
    if command == "add" { return Add(launcher, arguments[1:]) }
    separator: s32 = PkgAfterSeparator(arguments)
    if command == "run" && PkgHasArgument(arguments[0:PythonArgumentEnd(arguments)], "--target=py") {
        separator = PythonArgumentEnd(arguments)
    }
    flags: []string = arguments[0:separator]
    root: string = ""
    // `ziran run`, `build`, and `check` without a file, inside a project,
    // work on the project's own program; with a file they resolve its
    // imports through the project. An explicit --root or --module-path
    // asks for a standalone command.
    lifecycle: bool = (command == "run" || command == "build" ||
        command == "check" || command == "install") &&
        !PkgHasSource(flags[1:])
    implied: bool = false
    if (command == "run" || command == "build" || command == "check") &&
        !PkgHasArgument(flags, "--project") &&
        !PkgHasArgument(flags, "--root") &&
        !PkgHasArgument(flags, "--module-path") &&
        !PkgHasBundle(flags[1:]) {
        root = PkgProjectRoot()
        implied = root.count > 0
    }
    if command == "lock" || command == "update" || command == "fetch" ||
       command == "tool" || command == "install" || command == "pkg" ||
       PkgHasArgument(flags, "--project") {
        root = PkgProjectRoot()
        if root.count == 0 { return PkgFail("no ziran.toml found") }
    }
    if command == "lock" {
        if PkgResolveLock(root, "") { return 0 }
        return PkgFail("cannot resolve project lock")
    }
    if command == "update" {
        if arguments.count > 2 { return PkgFail("usage: ziran update [PACKAGE]") }
        refresh: string = "*"
        if arguments.count == 2 { refresh = arguments[1] }
        if PkgResolveLock(root, refresh) { return 0 }
        return PkgFail("cannot update project lock")
    }
    project: bool = PkgHasArgument(flags, "--project") || implied
    locked_mode: bool = PkgHasArgument(flags, "--locked")
    offline: bool = PkgHasArgument(flags, "--offline")
    filtered: [256]string
    count: s32 = 0
    index: s32 = 1
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if index >= separator ||
           (part != "--project" && part != "--locked" && part != "--offline") {
            if count >= 256 { return PkgFail("too many arguments") }
            filtered[count] = part
            count += 1
        }
        index += 1
    }
    if project && PkgHasArgument(flags, "--module-path") {
        return PkgFail("--module-path is for standalone commands")
    }
    locked: *PkgLock = null
    current: *PkgManifest = null
    if project || command == "fetch" || command == "pkg" || command == "tool" ||
       command == "install" {
        locked = PkgNewLock()
        current = PkgNewManifest()
        if locked == null || current == null ||
           !PkgReadLock(PkgJoin(root, "/ziran.lock"), locked) {
            return PkgFail("cannot read ziran.lock; run ziran lock")
        }
        if !PkgCheckoutGraph(root, locked, offline, locked_mode, current) {
            return PkgFail("cannot fetch locked packages")
        }
        // A project runs with its pinned toolchain's own launcher, so an
        // installed ziran of any age writes the import map the lock expects.
        // A launcher built inside the pinned toolchain's own tree, such as
        // the sanitizer build under build/sanitize, is that toolchain.
        pinned: string = PkgJoin(locked.tool_path, "/build/bin/ziran")
        tool_root: string = PkgJoin(PkgCanonical(locked.tool_path), "/")
        own: string = PkgCanonical(launcher)
        inside: bool = tool_root.count > 1 && own.count > tool_root.count &&
            own[0:tool_root.count] == tool_root
        if PkgGetenv("ZIRAN_PINNED_LAUNCHER") != "1" && !inside &&
           own != PkgCanonical(pinned) {
            if !PathExists(pinned) {
                make_args: [5]string
                make_args[0] = "make"
                make_args[1] = "-C"
                make_args[2] = locked.tool_path
                make_args[3] = "all"
                // The pinned launcher is build/bin/ziran whatever BUILD_DIR the
                // calling make passed down, such as the sanitizer build's.
                make_args[4] = "BUILD_DIR=build"
                none: [0]string
                if PkgRunToStderr(make_args[:], "") != 0 {
                    return PkgFail("cannot build pinned Ziran compiler")
                }
            }
            forwarded: [257]string
            forwarded[0] = pinned
            index = 0
            while index < cast(s32)arguments.count && index < 256 {
                forwarded[index + 1] = arguments[index]
                index += 1
            }
            names: [1]string
            values: [1]string
            names[0] = "ZIRAN_PINNED_LAUNCHER"
            values[0] = "1"
            return PkgRun(forwarded[0:index + 1], "", names[:], values[:])
        }
    }
    if command == "fetch" { return 0 }
    if command == "compile-commands" {
        return PkgCompileCommands(filtered[0:count], project, locked, launcher)
    }
    if command == "pkg" && count >= 1 && filtered[0] == "list" {
        if count > 2 { return PkgFail("usage: ziran pkg list [PACKAGE]") }
        selector: string = ""
        if count == 2 { selector = filtered[1] }
        return PkgList(locked, current, selector)
    }
    if command == "pkg" {
        if count < 2 || count > 3 || filtered[0] != "path" ||
           (count == 3 && filtered[2] != "--submodules") {
            return PkgFail("usage: ziran pkg path PACKAGE [--submodules] | ziran pkg list [PACKAGE]")
        }
        if filtered[1] == "ziran" {
            if count == 3 { return PkgFail("Ziran has no package submodules") }
            PkgPrint(locked.tool_path, false)
            PkgPrint("\n", false)
            return 0
        }
        selected: s32 = PkgSelect(locked, filtered[1])
        if selected < 0 { return PkgFail("package is not locked") }
        if count == 3 && !PkgPrepareSubmodules(locked.packages[selected].path,
            offline) { return PkgFail("package submodules are missing") }
        PkgPrint(locked.packages[selected].path, false)
        PkgPrint("\n", false)
        return 0
    }
    if command == "tool" {
        if count < 2 { return PkgFail("usage: ziran tool PACKAGE COMMAND") }
        empty: [0]string
        return PkgRunTool(root, locked, current, filtered[0], filtered[1:count],
            empty[:], empty[:])
    }
    if current != null && current.problem.count > 0 {
        return PkgFail(current.problem)
    }
    // A project whose [package] tool is set, such as a Kryon application,
    // hands its program's run, build, check, and install to that tool.
    whole: bool = lifecycle && current != null && !PkgHasTarget(flags[1:])
    if whole && current.tool.count > 0 && command != "install" {
        passed: [257]string
        passed[0] = command
        index = 0
        while index < count {
            passed[index + 1] = filtered[index]
            index += 1
        }
        empty: [0]string
        return PkgRunTool(root, locked, current, current.tool,
            passed[0:count + 1], empty[:], empty[:])
    }
    if whole && (command == "build" || command == "run") {
        if command == "build" && count > 0 { return PkgFail("usage: ziran build") }
        program: string = PkgNativeBuild(root, locked, current, launcher)
        if program.count == 0 { return 2 }
        if command == "build" { return 0 }
        run: [257]string
        run[0] = program
        run_count: s32 = 1
        skipped: bool = false
        index = 0
        while index < count && run_count < 256 {
            if filtered[index] == "--" && !skipped { skipped = true }
            else {
                run[run_count] = filtered[index]
                run_count += 1
            }
            index += 1
        }
        empty: [0]string
        return PkgRun(run[0:run_count], "", empty[:], empty[:])
    }
    if command == "install" {
        prefix: string = PkgJoin(PkgGetenv("HOME"), "/.local")
        passed: [257]string
        passed[0] = "install"
        passed_count: s32 = 1
        index = 0
        while index < count {
            part: string = filtered[index]
            if part == "--prefix" {
                if index + 1 >= count { return PkgFail("--prefix needs a directory") }
                prefix = filtered[index + 1]
                index += 1
            } else if part.count > 9 && part[0:9] == "--prefix=" {
                prefix = part[9:]
            } else {
                passed[passed_count] = part
                passed_count += 1
            }
            index += 1
        }
        if prefix.count == 0 || prefix == "/.local" {
            return PkgFail("set HOME or pass --prefix")
        }
        if prefix[0] != cast(u8)47 { prefix = PkgJoin3(PkgCwd(), "/", prefix) }
        bin: string = current.install_bin
        if bin.count == 0 { bin = current.name }
        if current.tool.count == 0 {
            if passed_count > 1 { return PkgFail("usage: ziran install [--prefix DIR]") }
            return PkgNativeInstall(root, locked, current, launcher, prefix, bin)
        }
        names: [2]string
        values: [2]string
        names[0] = "ZIRAN_INSTALL_PREFIX"
        names[1] = "ZIRAN_INSTALL_BIN"
        values[0] = prefix
        values[1] = bin
        return PkgRunTool(root, locked, current, current.tool,
            passed[0:passed_count], names[:], values[:])
    }
    empty: [0]string
    if command == "run" && PkgHasArgument(flags, "--target=py") {
        binary := PkgJoin(PkgLauncherDirectory(launcher), "/zi2py")
        program_root := ""
        program_file := ""
        map := ""
        libraries := PkgGetenv("LDLIBS")
        search: [65]string
        searches: s64 = 0
        if project {
            binary = PkgJoin(PkgToolDirectory(launcher, locked.tool_path, "zi2py"), "/zi2py")
            if !PathExists(binary) {
                make_args: [5]string = .["make", "-C", locked.tool_path, "all", "BUILD_DIR=build"]
                if PkgRunToStderr(make_args[:], "") != 0 { return PkgFail("cannot build pinned Ziran compiler") }
            }
            program_root = PkgJoin3(root, "/", current.roots[0])
            if !PkgHasSource(flags[1:]) { program_file = PkgJoin3(root, "/", current.entry) }
            map = PkgWriteMap(root, locked, current)
            if map.count == 0 { return PkgFail("cannot build project import map") }
            index = 0
            while index < locked.count {
                if !locked.packages[index].source {
                    search[searches] = locked.packages[index].path
                    searches += 1
                }
                index += 1
            }
            index = 0
            while index < current.link_count {
                libraries = PkgJoin3(libraries, " -l", current.links[index])
                index += 1
            }
        }
        standard := PkgGetenv("ZIRAN_STD")
        if standard.count == 0 {
            standard = PkgJoin(ParentDirectory(binary), "/../../std")
            if !DirectoryExists(standard) { standard = PkgJoin(ParentDirectory(binary), "/../../../std") }
        }
        if DirectoryExists(standard) { search[searches] = standard; searches += 1 }
        return PythonRun(filtered[0:count], binary, root, program_root, program_file,
            search[0:searches], map, libraries, PkgCacheRoot())
    }
    return PkgDispatch(command, filtered[0:count], project, root, locked,
        current, launcher, empty[:], empty[:])
}
