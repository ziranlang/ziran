VersionText :: #import "version"

#if CPU == .ARM64 {
    PkgHostNativeTarget :: "aarch64"
} else {
    // The current direct native registry has no 32-bit compiler-host CPU row;
    // unsupported hosts therefore reach zx2native's explicit target gap.
    PkgHostNativeTarget :: "x86_64"
}

// Package commands can resolve the same new pin concurrently. Serialize the
// complete compiler build, then recheck the requested binary while locked.
// Even an existing launcher may have appeared before another build finished.
PkgEnsureToolBinary :: (tool_root: string, binary: string) -> bool {
    directory := PkgJoin(tool_root, "/build")
    if !PkgMkdirs(directory) { unused PkgFail("cannot create pinned compiler build directory"); return false }
    lock := PkgLockEntry(PkgJoin(directory, "/.package-build.lock"))
    if !lock.valid { unused PkgFail("cannot lock pinned compiler build"); return false }
    defer PkgUnlockEntry(lock)
    if PathExists(binary) { return true }
    // BUILD_DIR belongs to this pin, regardless of the caller's make settings.
    arguments := string.["make", "-C", tool_root, "all", "BUILD_DIR=build"]
    if PkgRunToStderr(arguments[:], "") != 0 || !PathExists(binary) {
        unused PkgFail("cannot build pinned Ziran compiler")
        return false
    }
    return true
}

// `ziran compile-commands [--compiler CC] [--include DIR] [-o FILE] DIR`
// describes the generated C in DIR to editors. The include directory
// defaults to the pinned toolchain's under --project, otherwise to the one
// beside this launcher.
PkgCompileCommands :: (arguments: []string, project: bool, locked: *PkgLock,
    launcher: string) -> s32 {
    compiler: string = PkgGetenv("CC")
    if compiler.count == 0 { compiler = "cc" }
    include: string = ""
    output: string = ""
    generated: string = ""
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if (part == "--compiler" || part == "--include" || part == "-o") &&
           index + 1 < cast(s32)arguments.count {
            if part == "--compiler" { compiler = arguments[index + 1] }
            if part == "--include" { include = arguments[index + 1] }
            if part == "-o" { output = arguments[index + 1] }
            index += 2
        } else if generated.count == 0 && part.count > 0 && part[0] != cast(u8)45 {
            generated = part
            index += 1
        } else {
            return PkgFail("usage: ziran compile-commands [--compiler CC] [--include DIR] [-o FILE] GENERATED_DIR")
        }
    }
    if generated.count == 0 {
        return PkgFail("usage: ziran compile-commands [--compiler CC] [--include DIR] [-o FILE] GENERATED_DIR")
    }
    if include.count == 0 {
        if project { include = PkgJoin(locked.tool_path, "/include") }
        else {
            // build/bin/ziran, or a variant build such as build/sanitize/bin.
            include = PkgJoin(PkgLauncherDirectory(launcher), "/../../include")
            if !PathExists(PkgJoin(include, "/zir_string.h")) {
                include = PkgJoin(PkgLauncherDirectory(launcher), "/../../../include")
            }
        }
    }
    if !PathExists(PkgJoin(include, "/zir_string.h")) {
        return PkgFail("cannot find Ziran's include directory; pass --include DIR")
    }
    if output.count == 0 { output = PkgJoin(generated, "/compile_commands.json") }
    problem: string = WriteCompileCommands(include, compiler, generated, output)
    if problem.count > 0 { return PkgFail(problem) }
    return 0
}

PkgHasArgument :: (arguments: []string, expected: string) -> bool {
    index: s32 = 0
    while index < cast(s32)arguments.count {
        if arguments[index] == expected { return true }
        index += 1
    }
    return false
}

// A variant launcher built by this pinned compiler uses its own sibling
// tools. This keeps sanitizer and other variant builds together instead of
// rebuilding the default toolchain while independent checks are running.
PkgToolDirectory :: (launcher: string, tool_path: string, tool: string) -> string {
    tool_root := PkgJoin(PkgCanonical(tool_path), "/")
    own := PkgCanonical(launcher)
    directory := PkgLauncherDirectory(launcher)
    if tool_root.count > 1 && own.count > tool_root.count &&
       own[0:tool_root.count] == tool_root &&
       PathExists(PkgJoin3(directory, "/", tool)) {
        return directory
    }
    return PkgJoin(tool_path, "/build/bin")
}

PkgPrepareSubmodules :: (directory: string, offline: bool) -> bool {
    args: [7]string
    args[0] = "git"
    args[1] = "-C"
    args[2] = directory
    args[3] = "submodule"
    args[4] = "status"
    args[5] = "--recursive"
    result: PkgProcessResult = PkgCaptureRaw(args[0:6], "")
    if result.code != 0 { return false }
    at: s64 = 0
    while at < cast(s64)result.text.count {
        if result.text[at] != cast(u8)32 {
            if offline { return false }
            args[4] = "update"
            args[5] = "--init"
            args[6] = "--recursive"
            updated: PkgProcessResult = PkgCapture(args[:], "")
            return updated.code == 0
        }
        while at < cast(s64)result.text.count &&
            result.text[at] != cast(u8)10 { at += 1 }
        at += 1
    }
    return true
}

// Shows each direct dependency, where it comes from, and the import path of
// every module it exports:
//
//   kryon  git@github.com:kryonlabs/kryon.git  master  0123456789ab
//     #import "kryon/Widgets"    src/ui/Widgets/module.zi
PkgList :: (locked: *PkgLock, current: *PkgManifest, selector: string) -> s32 {
    found: bool = false
    index: s32 = 0
    while index < current.dependency_count {
        dependency: *PkgDependency = *current.dependencies[index]
        index += 1
        if selector.count > 0 && !PkgFoldEqual(dependency.alias, selector) {
            continue
        }
        found = true
        target: s32 = PkgFindById(locked, PkgEdgeValue(*locked.root_edges[0],
            locked.root_edge_count, dependency.alias))
        if target < 0 { return PkgFail("package is not locked; run ziran lock") }
        item: *PkgLocked = *locked.packages[target]
        PkgPrint(PkgJoin3(dependency.alias, "  ", dependency.git), false)
        PkgPrint(PkgJoin3("  ", dependency.ref, "  "), false)
        PkgPrint(item.commit[0:12], false)
        if item.checked {
            PkgPrint("\n  checked package archive\n", false)
        } else {
            PkgPrint(PkgJoin3("\n  checkout ", item.path, "\n"), false)
        }
        if item.source {
            PkgPrint("  source checkout; no Ziran modules\n", false)
            continue
        }
        exported: s32 = 0
        while exported < item.manifest.export_count {
            name: PkgNamedValue = item.manifest.exports[exported]
            line: string = PkgJoin3("  #import \"", dependency.alias, "/")
            line = PkgJoin3(line, name.name, "\"")
            while line.count < 36 { line = PkgJoin(line, " ") }
            PkgPrint(PkgJoin3(line, " ", name.value), false)
            PkgPrint("\n", false)
            exported += 1
        }
    }
    if selector.count > 0 && !found { return PkgFail("no dependency with that name") }
    if selector.count == 0 {
        PkgPrint(PkgJoin3("std  ", locked.tool_path, "/std\n"), false)
        PkgPrint("  #import \"std/NAME\"               the standard library\n", false)
    }
    return 0
}

// Resolve all selectors before stdout; checkout and forwarding remain shared.
PkgPaths :: (locked: *PkgLock, selectors: []string, submodules: bool,
    offline: bool) -> s32 {
    if selectors.count == 0 { return PkgFail("usage: ziran pkg paths PACKAGE... [--submodules]") }
    paths := PkgStrings(selectors.count)
    if paths.count != selectors.count { return PkgFail("cannot allocate package paths") }
    index: s32 = 0
    while index < cast(s32)selectors.count {
        selector := selectors[index]
        if selector == "ziran" {
            if submodules { return PkgFail("Ziran has no package submodules") }
            paths[index] = locked.tool_path
        } else {
            selected := PkgSelect(locked, selector)
            if selected < 0 { return PkgFail("package is not locked") }
            paths[index] = locked.packages[selected].path
        }
        index += 1
    }
    if submodules {
        for path: paths {
            if !PkgPrepareSubmodules(path, offline) { return PkgFail("package submodules are missing") }
        }
    }
    PkgPrint("[", false)
    index = 0
    while index < cast(s32)selectors.count {
        if index > 0 { PkgPrint(",", false) }
        PkgPrint("{", false)
        PkgJsonString("selector")
        PkgPrint(":", false)
        PkgJsonString(selectors[index])
        PkgPrint(",", false)
        PkgJsonString("path")
        PkgPrint(":", false)
        PkgJsonString(paths[index])
        PkgPrint("}", false)
        index += 1
    }
    PkgPrint("]\n", false)
    return 0
}

// Whether OPTION of `ziran api` takes the next argument as its value.
ApiOptionValue :: (option: string) -> bool {
    valued := string.["--target", "--target-os", "--target-cpu", "--module", "--symbol", "--max-symbols",
        "--max-bytes", "--root", "--module-path", "--define"]
    for name: valued { if option == name { return true } }
    return false
}

// Native invocations link the caller's LDLIBS and the root manifest's links.
// Dependency links travel in the checked module sidecar and are credited only
// when their modules are included, for both build and native script run.
PkgNativeLibraries :: (current: *PkgManifest) -> string {
    libraries: string = PkgGetenv("LDLIBS")
    if current != null {
        index: s32 = 0
        while index < current.link_count {
            if libraries.count > 0 { libraries = PkgJoin(libraries, " ") }
            libraries = PkgJoin3(libraries, "-l", current.links[index])
            index += 1
        }
    }
    return libraries
}

PkgDispatch :: (command: string, arguments: []string, project: bool,
    root: string, locked: *PkgLock, current: *PkgManifest,
    launcher: string, extra_names: []string, extra_values: []string,
    current_toolchain: bool = false) -> s32 {
    executable: string = ""
    check: bool = command == "check"
    bundle: bool = command == "bundle" || command == "run"
    // `ziran bundle --library` is zi2zx's library conversion; it takes the
    // project's exported modules instead of the app entry.
    library: bool = command == "bundle" && PkgHasArgument(arguments, "--library")
    transport: bool = command == "compact" || command == "expand"
    build: bool = command == "build"
    zx_inspect: bool = command == "inspect" && PkgHasBundle(arguments)
    wasm_build: bool = false
    native_build: bool = false
    zx_build: bool = false
    if check || command == "ir" { executable = "zi2zir" }
    else if command == "api" { executable = "zi-api" }
    else if command == "inspect" { executable = ifx zx_inspect then "zi2zx" else "zi-inspect" }
    else if command == "fmt" { executable = "zi-fmt" }
    else if command == "edit" || transport { executable = "zi-edit" }
    else if bundle { executable = "zi2zx" }
    else if build {
        target: string = ""
        index: s32 = 0
        while index < cast(s32)arguments.count {
            if arguments[index].count > 9 && arguments[index][0:9] == "--target=" {
                target = arguments[index]
            }
            index += 1
        }
        if target == "--target=c" { executable = "zi2c" }
        else if target == "--target=go" { executable = "zi2go" }
        else if target == "--target=wasm" { executable = "zi2zx"; wasm_build = true }
        else if target == "--target=zx" { executable = "zi2zx"; zx_build = true }
        else if target.count == 0 && !project { executable = "zi2zx"; native_build = true }
        else { return PkgFail("build target must be c, go, wasm, or zx") }
    }
    if executable.count == 0 { return PkgFail("unknown Ziran command") }
    tool_directory: string = PkgLauncherDirectory(launcher)
    if project && !current_toolchain { tool_directory = PkgToolDirectory(launcher, locked.tool_path, executable) }
    if tool_directory.count == 0 { return PkgFail("cannot find Ziran binaries") }
    binary: string = PkgJoin3(tool_directory, "/", executable)
    names: [8]string
    values: [8]string
    names[0] = "ZIRAN_PACKAGE_MAP"
    values[0] = ""
    // The tool names the driver that chose it when it rejects a file another
    // toolchain wrote.
    names[1] = "ZIRAN_DRIVER"
    values[1] = PkgCanonical(launcher)
    environment: s32 = 2
    while environment - 2 < cast(s32)extra_names.count && environment < 8 {
        names[environment] = extra_names[environment - 2]
        values[environment] = extra_values[environment - 2]
        environment += 1
    }
    if project {
        if current_toolchain {
            if !PathExists(binary) { return PkgFail("cannot find zi-api beside the current Ziran launcher") }
        } else if !PkgEnsureToolBinary(locked.tool_path, binary) { return 2 }
        values[0] = PkgWriteMap(root, locked, current)
        if values[0].count == 0 {
            if pkg_failure_reported { return 2 }
            return PkgFail("cannot build project import map")
        }
    }
    // Every project build, including an explicit source/--exe build, links
    // the caller's LDLIBS plus the root manifest's native libraries. A
    // dependency's links travel in the sidecar file instead: the native link
    // adds them only for the dependencies whose modules the build includes.
    if project && build {
        libraries := PkgNativeLibraries(current)
        if libraries.count > 0 {
            if environment >= 8 { return PkgFail("too many build environment values") }
            names[environment] = "LDLIBS"
            values[environment] = libraries
            environment += 1
        }
        links_file := PkgWriteLinksFile(root, locked)
        if links_file.count > 0 {
            if environment >= 8 { return PkgFail("too many build environment values") }
            names[environment] = "ZIRAN_PACKAGE_LINKS"
            values[environment] = links_file
            environment += 1
        }
    }
    extra: s64 = 0
    if current != null { extra = current.export_count }
    child := PkgStrings(arguments.count + extra + 10)
    if child.count != arguments.count + extra + 10 { return PkgFail("cannot allocate arguments") }
    count: s32 = 0
    child[count] = binary
    count += 1
    if zx_inspect {
        child[count] = "-o"
        child[count + 1] = "-"
        count += 2
        if !PkgHasArgument(arguments, "--emit") {
            child[count] = "--emit"
            child[count + 1] = "lir"
            count += 2
        }
    }
    if check { child[count] = "--check-only"; count += 1 }
    // `ziran build -o DIR` owns DIR: generated files from an earlier build
    // that this one does not write are removed so they cannot be linked.
    // C and Go own output directories. Wasm is deliberately two format
    // conversions below: source/ZIR -> verified ZX -> WebAssembly.
    if build && !wasm_build && !native_build && !zx_build {
        child[count] = "--prune-stale"
        count += 1
    }
    if wasm_build {
        child[count] = "--target"
        count += 1
        child[count] = "wasm"
        count += 1
    }
    // `zi2zx run` is a real subcommand. `ziran bundle` is the high-level
    // spelling for zi2zx's default source/ZIR -> ZX conversion, so it does
    // not forward a removed `bundle` subcommand.
    if command == "run" || transport { child[count] = command; count += 1 }
    // `ziran run --project FILE.zx` runs a bundle with the pinned toolchain
    // that built it; a bundle takes no source root.
    if project && command != "run" && !transport && !zx_inspect && !PkgHasArgument(arguments, "--root") {
        child[count] = "--root"
        count += 1
        child[count] = PkgJoin3(root, "/", current.roots[0])
        count += 1
    }
    // `ziran check FILE.zi` outside a project checks FILE's folder as the
    // root, as `ziran build FILE.zi` does.
    if check && !project && !PkgHasArgument(arguments, "--root") {
        for part: arguments {
            if PkgCompilerInput(part) {
                child[count] = "--root"
                child[count + 1] = ParentDirectory(part)
                count += 2
                break
            }
        }
    }
    has_source: bool = false
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if !(build && (part == "--target=c" || part == "--target=go" ||
                       part == "--target=wasm" || part == "--target=zx")) {
            child[count] = part
            count += 1
            if PkgCompilerInput(part) {
                has_source = true
            }
        }
        index += 1
    }
    if project && !has_source &&
       (check || command == "ir" || command == "api" || build || command == "bundle") {
        entry: string = PkgJoin3(root, "/", current.entry)
        // A library has no app entry; checking it checks what it exports. A
        // ZX library build loads those same exported modules, while zi2zx
        // names the roots from --export.
        library_inputs: bool = library && !PkgHasArgument(arguments, "--entry")
        load_exports: bool = current.export_count > 0 &&
            (library_inputs || (!PathExists(entry) && (check || command == "ir" || command == "api")))
        if load_exports {
            index = 0
            while index < current.export_count {
                child[count] = PkgJoin3(root, "/", current.exports[index].value)
                seen: bool = false
                earlier: s32 = 0
                while earlier < index {
                    if current.exports[earlier].value == current.exports[index].value {
                        seen = true
                    }
                    earlier += 1
                }
                if !seen { count += 1 }
                index += 1
            }
        } else if library_inputs {
            if !PathExists(entry) {
                return PkgFail("a ZX library build needs [exports] sources or file arguments")
            }
            child[count] = entry
            count += 1
        } else if !library {
            // zi2zx refuses --library together with --entry, and adding the
            // app entry here would put a second error in front of that one.
            child[count] = entry
            count += 1
        }
    }
    if command == "run" && !has_source {
        return PkgRunBundle(child[0:count], arguments,
            names[0:environment], values[0:environment])
    }
    if wasm_build || native_build {
        output: string = ""
        output_index: s32 = -1
        source: string = ""
        index = 0
        while index + 1 < count {
            if child[index] == "-o" { output = child[index + 1]; output_index = index + 1 }
            index += 1
        }
        if native_build {
            for part: arguments {
                if PkgCompilerInput(part) { source = part }
            }
            if source.count == 0 { return PkgFail("native build needs a source file") }
            add_output := output.count == 0
            add_root := !PkgHasArgument(arguments, "--root")
            add_entry := !PkgHasArgument(arguments, "--entry")
            if add_output { output = PkgModuleName(source) }
            extra_options: s32 = 0
            if add_root { extra_options += 2 }
            if add_entry { extra_options += 2 }
            if add_output { extra_options += 2 }
            // zi2zx options precede its first input. Insert inferred native
            // options there so `ziran build FILE.zi` remains a complete form.
            insertion: s32 = count
            index = 1
            while index < count {
                if PkgCompilerInput(child[index]) {
                    insertion = index
                    break
                }
                index += 1
            }
            cursor := count
            while cursor > insertion {
                child[cursor + extra_options - 1] = child[cursor - 1]
                cursor -= 1
            }
            if output_index >= insertion { output_index += extra_options }
            position := insertion
            if add_root { child[position] = "--root"; child[position + 1] = ParentDirectory(source); position += 2 }
            if add_entry { child[position] = "--entry"; child[position + 1] = PkgJoin(PkgModuleName(source), ":main"); position += 2 }
            if add_output { child[position] = "-o"; child[position + 1] = output; output_index = position + 1 }
            count += extra_options
        }
        if output.count == 0 || output == "-" {
            if native_build { return PkgFail("native build needs -o FILE") }
            return PkgFail("WebAssembly build needs -o FILE")
        }
        verified := PkgTemporarySibling(output, ".zx")
        if verified.count == 0 { return PkgFail("cannot name temporary verified ZX output") }
        child[output_index] = verified
        code := PkgRun(child[0:count], "", names[0:environment], values[0:environment])
        if code == 0 && wasm_build {
            wasm_tool := PkgJoin3(tool_directory, "/", "zx2wasm")
            wasm: [4]string = .[wasm_tool, "-o", output, verified]
            code = PkgRun(wasm[:], "", names[0:environment], values[0:environment])
        }
        if code == 0 && native_build {
            native_tool := PkgJoin3(tool_directory, "/", "zx2native")
            native: [11]string = .[native_tool, "--target", PkgHostNativeTarget,
                "--platform", "linux", "--emit", "elf", "-o", output]
            native_count: s32 = 9
            // The mode reaches the encoder too: its own verification of the
            // program the allocator just built is optional in a quickest build.
            if PkgHasArgument(arguments, "--quickest") { native[native_count] = "--quickest"; native_count += 1 }
            else if PkgHasArgument(arguments, "--thorough") { native[native_count] = "--thorough"; native_count += 1 }
            native[native_count] = verified
            native_count += 1
            code = PkgRun(native[0:native_count], "", names[0:environment], values[0:environment])
            if code == 0 {
                learn_entry := ""
                index = 0
                while index + 1 < count {
                    if child[index] == "--entry" { learn_entry = child[index + 1] }
                    index += 1
                }
                LearnRecord(tool_directory, verified, output, PkgHostNativeTarget, source, learn_entry,
                    names[0:environment], values[0:environment])
            }
        }
        unused RemoveFile(verified)
        return code
    }
    return PkgRun(child[0:count], "", names[0:environment], values[0:environment])
}

// True when an argument before `--` names a source, saved IR, or bundle
// file: the command then works on that file, not on the project's program.
PkgHasSource :: (arguments: []string) -> bool {
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if part == "--" { return false }
        if PkgCompilerInput(part) ||
           PkgEndsWith(part, ".zx") { return true }
        index += 1
    }
    return false
}

PkgHasBundle :: (arguments: []string) -> bool {
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if part == "--" { return false }
        if PkgEndsWith(part, ".zx") { return true }
        index += 1
    }
    return false
}

PkgHasTarget :: (arguments: []string) -> bool {
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if part == "--" { return false }
        if part.count >= 8 && part[0:8] == "--target" { return true }
        index += 1
    }
    return false
}

// The module a source path defines: src/main.zi is main.
PkgModuleName :: (path: string) -> string {
    start: s64 = cast(s64)path.count
    while start > 0 && path[start - 1] != cast(u8)47 { start -= 1 }
    name: string = path[start:]
    name = PkgSourceStem(name)
    return name
}

// `ziran build` in a project without a tool: the entry module's main
// becomes build/NAME through C. [package] links adds -l libraries.
PkgNativeBuild :: (root: string, locked: *PkgLock, current: *PkgManifest,
    launcher: string) -> string {
    module: string = PkgModuleName(current.entry)
    if !PathExists(PkgJoin3(root, "/", current.entry)) {
        PkgFail(PkgJoin3("the package entry ", current.entry, " does not exist"))
        return ""
    }
    generated: string = PkgJoin(root, "/build/generated/c")
    if !PkgMkdirs(generated) {
        PkgFail("cannot create build/generated/c")
        return ""
    }
    arguments: [6]string
    arguments[0] = "--target=c"
    arguments[1] = "--exe"
    arguments[2] = "--entry"
    arguments[3] = PkgJoin(module, ":main")
    arguments[4] = "-o"
    arguments[5] = generated
    empty: [0]string
    if PkgDispatch("build", arguments[:], true, root, locked, current,
        launcher, empty[:], empty[:]) != 0 { return "" }
    program: string = PkgJoin3(root, "/build/", current.name)
    // A rename replaces the program in one step, so a running copy keeps
    // its own file.
    if !RenamePath(PkgJoin3(generated, "/", module), program) {
        PkgFail("cannot move the built program to build/")
        return ""
    }
    return program
}

// `ziran install` for a project without a tool copies its program to
// PREFIX/bin/BIN. The copy replaces the old file in one step.
PkgNativeInstall :: (root: string, locked: *PkgLock, current: *PkgManifest,
    launcher: string, prefix: string, bin: string) -> s32 {
    program: string = PkgNativeBuild(root, locked, current, launcher)
    if program.count == 0 { return 2 }
    directory: string = PkgJoin(prefix, "/bin")
    if !PkgMkdirs(directory) { return PkgFail(PkgJoin("cannot create ", directory)) }
    target: string = PkgJoin3(directory, "/", bin)
    staged: string = PkgJoin(target, ".ziran-new")
    copy: [5]string
    copy[0] = "cp"
    copy[1] = "-f"
    copy[2] = "--"
    copy[3] = program
    copy[4] = staged
    empty: [0]string
    if PkgRun(copy[:], "", empty[:], empty[:]) != 0 || !RenamePath(staged, target) {
        return PkgFail(PkgJoin("cannot install ", target))
    }
    PkgPrint(PkgJoin3("installed ", target, "\n"), false)
    return 0
}

// Arguments after the first `--` go to the program as they are; the others
// are the command's own.
PkgAfterSeparator :: (arguments: []string) -> s32 {
    index: s32 = 0
    while index < cast(s32)arguments.count {
        if arguments[index] == "--" { return index + 1 }
        index += 1
    }
    return cast(s32)arguments.count
}

// Runs a dependency's project tool from the project root with the resolved
// [tool.ALIAS] options. The tool is rebuilt when its sources changed, so a
// local override never runs a stale binary.
PkgRunTool :: (root: string, locked: *PkgLock, current: *PkgManifest,
    selector: string, arguments: []string, extra_names: []string,
    extra_values: []string) -> s32 {
    selected: s32 = PkgSelect(locked, selector)
    if selected < 0 { return PkgFail("package is not locked") }
    alias: string = locked.packages[selected].name
    index: s32 = 0
    while index < current.dependency_count {
        if PkgFoldEqual(current.dependencies[index].alias, selector) {
            alias = current.dependencies[index].alias
        }
        index += 1
    }
    return PkgRunSelectedTool(root, locked, current, selected, alias,
        arguments, extra_names, extra_values)
}

PkgRunSelectedTool :: (root: string, locked: *PkgLock, current: *PkgManifest,
    selected: s32, alias: string, arguments: []string, extra_names: []string,
    extra_values: []string) -> s32 {
    options := PkgResolveOptions(root, alias, locked.packages[selected].path)
    if options.count == 0 { return 2 }
    return PkgRunSelectedToolOptions(root, locked, current, selected, alias,
        arguments, extra_names, extra_values, options)
}

PkgRunSelectedToolOptions :: (root: string, locked: *PkgLock, current: *PkgManifest,
    selected: s32, alias: string, arguments: []string, extra_names: []string,
    extra_values: []string, options: string) -> s32 {
    item: *PkgLocked = *locked.packages[selected]
    relative: string = PkgJoin("", item.manifest.project_tool)
    if relative.count == 0 || relative[0] == cast(u8)47 {
        return PkgFail("package has no project tool")
    }
    at: s64 = 0
    while at + 1 < cast(s64)relative.count {
        if relative[at] == cast(u8)46 &&
           relative[at + 1] == cast(u8)46 { return PkgFail("invalid project tool") }
        at += 1
    }
    index: s32 = 0
    make_args: [8]string
    make_args[0] = "make"
    make_args[1] = "--silent"
    make_args[2] = "--no-print-directory"
    make_args[3] = "-C"
    make_args[4] = item.path
    make_args[5] = relative
    make_args[6] = PkgJoin("ZIRAN_DIR=", locked.tool_path)
    make_args[7] = "-j1"
    empty: [0]string
    if PkgRunToStderr(make_args[:], "") != 0 {
        return PkgFail("cannot build package tool")
    }
    names: [16]string
    values: [16]string
    names[0] = "ZIRAN_PROJECT_ROOT"
    names[1] = "ZIRAN_PACKAGE_ROOT"
    names[2] = "ZIRAN_PACKAGE_ID"
    names[3] = "ZIRAN_TOOLCHAIN_ROOT"
    names[4] = "ZIRAN_TOOL_OPTIONS"
    names[5] = "ZIRAN_PROJECT_NAME"
    names[6] = "ZIRAN_PROJECT_ENTRY"
    names[7] = "ZIRAN_PROJECT_LINKS"
    values[0] = root
    values[1] = item.path
    values[2] = item.id
    values[3] = locked.tool_path
    values[4] = options
    values[5] = current.name
    values[6] = current.entry
    libraries: string = ""
    index = 0
    while index < current.link_count {
        if index > 0 { libraries = PkgJoin(libraries, " ") }
        libraries = PkgJoin(libraries, current.links[index])
        index += 1
    }
    values[7] = libraries
    count: s32 = 8
    index = 0
    while index < cast(s32)extra_names.count && count < 16 {
        names[count] = extra_names[index]
        values[count] = extra_values[index]
        count += 1
        index += 1
    }
    child := PkgStrings(arguments.count + 8)
    if child.count != arguments.count + 8 { return PkgFail("cannot allocate arguments") }
    child[0] = PkgJoin3(item.path, "/", relative)
    index = 0
    while index < cast(s32)arguments.count {
        child[index + 1] = arguments[index]
        index += 1
    }
    if PkgHasArgument(extra_names, "ZIRAN_ARTIFACT_OUTPUT") {
        result := PkgCaptureEnv(child[0:index + 1], root, names[0:count], values[0:count])
        if result.text.count > 0 { PkgPrint(PkgJoin(result.text, "\n"), true) }
        return result.code
    }
    return PkgRun(child[0:index + 1], root, names[0:count], values[0:count])
}

// Checks each project --module-path FOLDER and records it, canonical, as a
// generated module root of CURRENT. Packages come from ziran.lock, so the
// NAME=DIR spelling is refused, and a folder inside a locked package or the
// toolchain cannot become the project's.
// The length of BASE when PATH is BASE or inside it, else -1.
PkgPathWithin :: (path: string, base: string) -> s64 {
    if base.count == 0 { return -1 }
    if path == base || (path.count > base.count && path[0:base.count] == base &&
        path[base.count] == cast(u8)47) { return cast(s64)base.count }
    return -1
}

PkgGeneratedRoots :: (root: string, locked: *PkgLock, current: *PkgManifest, folders: []string) -> bool {
    current.generated_count = 0
    current.generated = PkgStrings(folders.count)
    if current.generated.count != folders.count { return false }
    for folder: folders {
        at: s64 = 0
        while at < cast(s64)folder.count && folder[at] != cast(u8)61 &&
            folder[at] != cast(u8)47 { at += 1 }
        if at > 0 && at < cast(s64)folder.count && folder[at] == cast(u8)61 {
            unused PkgFail(PkgJoin3("in a project, packages come from ziran.lock; --module-path takes a folder of the project's own modules, not ",
                folder, ""))
            return false
        }
        path: string = PkgCanonical(folder)
        if path.count == 0 || !DirectoryExists(path) {
            unused PkgFail(PkgJoin("--module-path folder does not exist: ", folder))
            return false
        }
        // The compiler gives a file to the package with the longest path
        // holding it; the folder must belong to the project, not a package.
        // A project inside a package's own checkout, like that package's
        // in-repo example, keeps its build folders there without the
        // package counting as foreign.
        owner: string = ""
        best: s64 = PkgPathWithin(path, PkgCanonical(root))
        index: s32 = -1
        while index < locked.count {
            base: string = locked.tool_path
            name: string = "the Ziran toolchain"
            foreign: bool = true
            if index >= 0 {
                base = locked.packages[index].path
                name = PkgJoin("locked package ", locked.packages[index].name)
                foreign = PkgPathWithin(PkgCanonical(root), PkgCanonical(base)) < 0
            }
            index += 1
            length: s64 = PkgPathWithin(path, PkgCanonical(base))
            if foreign && length > best { best = length; owner = name }
        }
        if owner.count > 0 {
            unused PkgFail(PkgJoin3(PkgJoin3("--module-path folder ", folder, " is inside "),
                owner, "; a project adds only its own modules"))
            return false
        }
        current.generated[current.generated_count] = path
        current.generated_count += 1
    }
    return true
}

// `ziran test [options] FILE.zi ...` runs every test program the way
// `ziran run --target=c` does and prints one PASS or FAIL line per file. A
// program passes when its entry returns 0; a compile error fails its file.
// The options go to every run, so one root or entry serves a whole folder.
// The status is 1 when any file fails, which stops make and CI on a red
// test, and every file runs even after a failure.
Test :: (launcher: string, arguments: []string) -> s32 {
    usage := "usage: ziran test [--project] [--locked] [--offline] [--root DIR] [--module-path DIR] [--entry module:function] [--define NAME[=VALUE]] [--checks] [--no-cache] [--diagnostics=text|json] FILE.zi|FILE.ts|FILE.tsx|FILE.zir ...\n"
    shared := PkgStrings(cast(s64)arguments.count)
    files := PkgStrings(cast(s64)arguments.count)
    if shared.count != cast(s64)arguments.count || files.count != cast(s64)arguments.count {
        return PkgFail("cannot allocate arguments")
    }
    shared_count: s64 = 0
    file_count: s64 = 0
    index: s64 = 0
    while index < cast(s64)arguments.count {
        part: string = arguments[index]
        if PkgCompilerInput(part) {
            files[file_count] = part
            file_count += 1
        } else if part == "--root" || part == "--module-path" || part == "--entry" || part == "--define" {
            if index + 1 >= cast(s64)arguments.count { return PkgFail(PkgJoin(part, " needs a value")) }
            shared[shared_count] = part
            shared[shared_count + 1] = arguments[index + 1]
            shared_count += 2
            index += 1
        } else if part == "--project" || part == "--locked" || part == "--offline" || part == "--checks" ||
            part == "--no-cache" || part == "--target=c" || part == "--diagnostics=text" || part == "--diagnostics=json" {
            shared[shared_count] = part
            shared_count += 1
        } else if part == "--help" || part == "-h" {
            PkgPrint(usage, false)
            return 0
        } else {
            return PkgFail(PkgJoin3("unknown test argument: ", part, PkgJoin("\n", usage)))
        }
        index += 1
    }
    if file_count == 0 { return PkgFail(usage) }
    run := PkgStrings(shared_count + 3)
    if run.count != shared_count + 3 { return PkgFail("cannot allocate arguments") }
    run[0] = "run"
    run[1] = "--target=c"
    at: s64 = 0
    while at < shared_count {
        run[2 + at] = shared[at]
        at += 1
    }
    failed: s64 = 0
    at = 0
    while at < file_count {
        file: string = files[at]
        run[2 + shared_count] = file
        // A failure reported for an earlier file must not silence this one's.
        pkg_failure_reported = false
        code := PackageMain(launcher, run[0:shared_count + 3])
        if code == 0 {
            PkgPrint(PkgJoin("PASS ", PkgJoin(file, "\n")), false)
        } else {
            failed += 1
            PkgPrint(PkgJoin3("FAIL ", file, PkgJoin3(" (exit ", PkgDecimal(code), ")\n")), false)
        }
        at += 1
    }
    summary := PkgJoin3("ziran test: ", PkgDecimal(cast(s32)(file_count - failed)),
        PkgJoin3(" passed, ", PkgDecimal(cast(s32)failed), " failed\n"))
    PkgPrint(summary, false)
    if failed > 0 { return 1 }
    return 0
}

// One usage line per command. `ziran COMMAND --help` prints it and does
// nothing else; "" means the command is unknown.
PkgUsage :: (command: string) -> string {
    if command == "version" { return "usage: ziran version\n" }
    if command == "guide" { return "usage: ziran guide\n" }
    if command == "std" { return "usage: ziran std --list [--json]\n" }
    if command == "features" { return "usage: ziran features [--json] [--id FEATURE_ID]\n" }
    if command == "capabilities" { return "usage: ziran capabilities [--target=c|go|zx] [--json]\n" }
    if command == "explain" { return "usage: ziran explain CODE [--json] | ziran explain --list [--json]\n" }
    if command == "learn" { return LearnUsage() }
    if command == "api" {
        return "usage: ziran api [--json] [--diagnostics=text|json] [--target c|go|zx] [--target-os OS] [--target-cpu CPU] [--module NAME] [--symbol NAME|ID] [--imports-only] [--max-symbols N] [--max-bytes N] [--module-path DIR] [--define NAME] [--project [--current-toolchain] | --root DIR] file.zi|file.ts|file.tsx|file.zir ...\n"
    }
    if command == "new" {
        return "usage: ziran new DIR [--template SOURCE[:NAME]] [--ref REF] [--name NAME] [--overrides FILE]\n"
    }
    if command == "init" {
        return "usage: ziran init [--template SOURCE[:NAME]] [--ref REF] [--name NAME] [--overrides FILE]\n"
    }
    if command == "lock" { return "usage: ziran lock [--offline]\n" }
    if command == "update" { return "usage: ziran update [PACKAGE]\n" }
    if command == "fetch" { return "usage: ziran fetch [--locked] [--offline]\n" }
    if command == "add" {
        return "usage: ziran add URL|OWNER/REPO [--name NAME] [--ref REF] [--source] [--offline]\n"
    }
    if command == "pkg" {
        return "usage: ziran pkg path PACKAGE [--submodules] | ziran pkg paths PACKAGE... [--submodules] | ziran pkg list [PACKAGE] | ziran pkg zx --help | ziran pkg artifact PACKAGE:ARTIFACT --platform OS-ARCH-ABI [--option Alias:key=value]...\n"
    }
    if command == "tool" { return "usage: ziran tool PACKAGE COMMAND [ARGS]\n" }
    if command == "install" { return "usage: ziran install [--prefix DIR] [--locked] [--offline]\n" }
    if command == "check" {
        return "usage: ziran check [--project] [--lint] [--root DIR] [--entry module:function] [--module-path DIR] [file.zi|file.ts|file.tsx|file.zir ...]\n"
    }
    if command == "ir" {
        return "usage: ziran ir [--root DIR] [--entry module:function] [--module-path DIR] [-o FILE.zir] [file.zi|file.ts|file.tsx|file.zir ...]\n"
    }
    if command == "build" {
        return "usage: ziran build [--target=c|go|wasm|zx] [--thorough|--quickest] [--emit-main|--exe --entry module:function] [--root DIR] [--module-path DIR] [-o FILE|DIR] [file.zi|file.ts|file.tsx|file.zir ...]; in a project: ziran build\n"
    }
    if command == "bundle" {
        return "usage: ziran bundle --entry module:function [--zx-lock FILE] [--thorough|--quickest] [--root DIR] [--module-path DIR] [--bind CALLER:CAPABILITY=PROVIDER:FUNCTION] [-o FILE] [file.zi|file.ts|file.tsx|file.zir ...]\n       ziran bundle --library NAME --export module:function [--thorough|--quickest] [--require-module IFACE=NAME] [--import CALLER:FUNCTION=IFACE:EXPORT] [--root DIR] [--module-path DIR] [-o FILE] [file.zi|file.ts|file.tsx|file.zir ...]\n"
    }
    if command == "run" {
        return "usage: ziran run [--zx-lock FILE] [--offline] FILE.zx | ziran run [--target=c [--no-cache] [--thorough|--quickest]] [--root DIR] [--entry module:function] [FILE.zi|FILE.ts|FILE.tsx [-- ARGS]]; in a project: ziran run [-- ARGS]\n"
    }
    if command == "fmt" { return "usage: ziran fmt [--check] FILE.zi ...\n" }
    if command == "test" {
        return "usage: ziran test [--project] [--locked] [--offline] [--root DIR] [--module-path DIR] [--entry module:function] [--define NAME[=VALUE]] [--checks] [--no-cache] [--diagnostics=text|json] FILE.zi|FILE.ts|FILE.tsx|FILE.zir ...\n"
    }
    if command == "serve" { return "usage: ziran serve\n" }
    if command == "inspect" {
        return "usage: ziran inspect [--hex] FILE.zir | ziran inspect [--emit lir|linkage] FILE.zx\n"
    }
    if command == "compile-commands" {
        return "usage: ziran compile-commands [--compiler CC] [--include DIR] [-o FILE] GENERATED_DIR\n"
    }
    if command == "edit" {
        return "usage: ziran edit --root DIR [--module-path DIR] [--apply] request.json\n"
    }
    if command == "compact" || command == "expand" {
        return "usage: ziran compact|expand [--map FILE.json] INPUT\n"
    }
    return ""
}

// Where a command's own flags end. Arguments after `--` belong to the
// program or script it runs, `run` hands everything after its source file to
// that script, and `tool` hands everything after PACKAGE to the tool.
PkgFlagsEnd :: (command: string, arguments: []string) -> s32 {
    end: s32 = PkgAfterSeparator(arguments)
    if command == "run" {
        script: s32 = ScriptArgumentEnd(arguments)
        if script < end { end = script }
    }
    if command == "tool" && end > 2 { end = 2 }
    return end
}

// `ziran serve`: one foreground process for a series of ordinary commands.
// Each line is a command line without the leading `ziran`, run in this
// process; the greeting and prompt go to standard error so a piped session's
// standard output is only the commands' own. `Exit` (or the end of input)
// leaves. It is never a daemon: it owns the terminal until it returns, and
// repeated commands reuse the compiler's caches.
serve_system :: #system_library "libc";
ServeReadRaw :: (descriptor: s32, output: *u8, count: usize) -> isize #foreign serve_system "read";
#if #defined(__APPLE__) {
    ServeErrno :: () -> *s32 #foreign serve_system "__error";
} else {
    ServeErrno :: () -> *s32 #foreign serve_system "__errno_location";
}
serve_launcher: string;

ServeWords :: (line: []u8, words: *Vec(string)) -> bool {
    at: s64 = 0
    while at < line.count {
        while at < line.count && (line[at] == #char " " || line[at] == #char "\t") { at += 1 }
        if at >= line.count { return true }
        begin := at
        while at < line.count && line[at] != #char " " && line[at] != #char "\t" { at += 1 }
        if !VecPush(<<words, TextFromBytes(line[begin:at])) { return false }
    }
    return true
}

Serve :: (launcher: string, arguments: []string) -> s32 {
    if arguments.count != 0 { return PkgFail("usage: ziran serve") }
    serve_launcher = launcher
    PkgPrint("ziran serve: enter a command, or Exit to leave\n", true)
    buffer: [4096]u8
    used: s64 = 0
    at: s64 = 0
    eof: bool = false
    line: Vec(u8)
    defer VecFree(line)
    words: Vec(string)
    defer VecFree(words)
    while true {
        PkgPrint("ziran> ", true)
        unused VecResize(line, 0)
        complete: bool = false
        while !complete && !eof {
            if at >= used {
                count := ServeReadRaw(0, *buffer[0], cast(usize)4096)
                if count < 0 {
                    if <<ServeErrno() == 4 { continue }
                    eof = true
                    break
                }
                if count == 0 { eof = true; break }
                at = 0
                used = cast(s64)count
            }
            byte := buffer[at]
            at += 1
            if byte == #char "\n" { complete = true }
            else if byte != #char "\r" {
                if !VecPush(line, byte) { return PkgFail("cannot allocate the command line") }
            }
        }
        if line.count == 0 {
            if eof { break }
            continue
        }
        unused VecResize(words, 0)
        if !ServeWords(line[:], *words) { return PkgFail("cannot allocate the command arguments") }
        if words.count == 0 {
            if eof { break }
            continue
        }
        if words[0] == "Exit" || words[0] == "exit" { break }
        if words[0] == "serve" { PkgPrint("serve: already in a serve session\n", true) }
        else if (words[0] == "version" || words[0] == "--version") && words.count == 1 {
            PkgPrint("ziran ", false)
            PkgPrint(VersionText.Version, false)
            PkgPrint("\n", false)
        }
        else {
            pkg_failure_reported = false
            unused PackageMain(serve_launcher, VecSlice(words, 0, words.count))
        }
        if eof { break }
    }
    return 0
}

#program_export
PackageMain :: (launcher: string, arguments: []string) -> s32 {
    // Source execution also supports #!/usr/bin/env ziran. Normalize before
    // parsing so every word after the filename belongs to the script.
    if arguments.count > 0 && PkgAuthoredSource(arguments[0]) {
        script: Vec(string)
        defer VecFree(script)
        if !VecPush(script, "run") || !VecPush(script, "--target=c") { return 2 }
        for argument: arguments {
            if !VecPush(script, argument) { return 2 }
        }
        return PackageMain(launcher, VecSlice(script, 0, script.count))
    }
    PkgSetDiagnosticFormat(arguments)
    if arguments.count == 0 || arguments[0] == "help" ||
       arguments[0] == "--help" || arguments[0] == "-h" {
        PkgPrint("usage: ziran version|guide|std|features|capabilities|explain|learn|api|new|init|lock|update|fetch|add|pkg|tool|install|check|test|serve|ir|build|bundle|run|fmt|inspect|compile-commands ...\n", false)
        PkgPrint("project commands: --project [--locked] [--offline]\n", false)
        PkgPrint("in a project, run, build, check, and install without a file work on its program\n", false)
        PkgPrint("scripts: ziran FILE.zi|FILE.ts|FILE.tsx [ARGS] | ziran run --target=c [--no-cache] FILE.zi|FILE.ts|FILE.tsx -- ARGS\n", false)
        PkgPrint("new to Ziran? run ziran guide\n", false)
        return 0
    }
    command: string = arguments[0]
    package_zx := command == "pkg" && arguments.count >= 3 && arguments[1] == "zx"
    pack_dev := package_zx && arguments[2] == "pack-dev"
    pack_checked := pack_dev || (package_zx && arguments[2] == "pack-ir")
    // A binary-only consumer need not have a project or check out its sources.
    if !pack_checked && command == "pkg" && arguments.count >= 2 && arguments[1] == "zx" {
        return PkgZx(launcher, arguments[2:])
    }
    // Asking for help never runs the command, whatever it would change.
    own_flags: []string = arguments[1:PkgFlagsEnd(command, arguments)]
    if PkgHasArgument(own_flags, "--help") || PkgHasArgument(own_flags, "-h") {
        if pack_checked {
            PkgPrint(PkgZxUsage(), false)
            return 0
        }
        usage: string = PkgUsage(command)
        if usage.count > 0 {
            PkgPrint(usage, false)
            return 0
        }
    }
    if command == "bundle" || command == "run" {
        for at: 1..own_flags.count {
            if arguments[at] == "--zx-lock" {
                expanded := PkgZxLockedArguments(launcher, arguments, at, own_flags.count + 1)
                if expanded.count == 0 { return 2 }
                return PackageMain(launcher, expanded)
            }
        }
    }
    if command == "new" || command == "init" {
        return Template(launcher, command, arguments[1:])
    }
    if command == "guide" { return Guide(arguments[1:]) }
    if command == "std" { return StdModules(launcher, arguments[1:]) }
    if command == "version" && arguments.count == 2 && arguments[1] == "--identity" {
        identity := PkgRuntimeIdentity(PkgJoin(PkgLauncherDirectory(launcher), "/zi2zx"))
        if identity == "" { return PkgFail("cannot identify this toolchain's zx runner") }
        print("%\n", identity)
        return 0
    }
    if command == "features" { return Features(arguments[1:]) }
    if command == "capabilities" { return Capabilities(arguments[1:]) }
    if command == "explain" { return Explain(arguments[1:]) }
    if command == "serve" { return Serve(launcher, arguments[1:]) }
    if command == "test" { return Test(launcher, arguments[1:]) }
    if command == "learn" { return Learn(arguments[1:], launcher) }
    if command == "add" { return Add(launcher, arguments[1:]) }
    separator: s32 = PkgAfterSeparator(arguments)
    script_flags: []string = arguments[0:ScriptArgumentEnd(arguments)]
    if command == "run" && PkgHasArgument(script_flags, "--target=c") {
        separator = ScriptArgumentEnd(arguments)
    }
    flags: []string = arguments[0:separator]
    root: string = ""
    // `ziran run`, `build`, and `check` without a file, inside a project,
    // work on the project's own program; with a file they resolve its
    // imports through the project. An explicit --root or --module-path
    // asks for a standalone command.
    lifecycle: bool = (command == "run" || command == "build" ||
        command == "check" || command == "install") &&
        !PkgHasSource(flags[1:])
    implied: bool = false
    if (command == "run" || command == "build" || command == "check" || command == "api") &&
        !PkgHasArgument(flags, "--project") &&
        !PkgHasArgument(flags, "--root") &&
        !PkgHasArgument(flags, "--module-path") &&
        !PkgHasBundle(flags[1:]) {
        root = PkgProjectRoot()
        implied = root.count > 0
    }
    if command == "lock" || command == "update" || command == "fetch" ||
       command == "tool" || command == "install" || command == "pkg" ||
       PkgHasArgument(flags, "--project") {
        root = PkgProjectRoot()
        if root.count == 0 { return PkgFail("no ziran.toml found") }
    }
    if command == "lock" {
        if arguments.count > 2 || (arguments.count == 2 && arguments[1] != "--offline") {
            return PkgFail("usage: ziran lock [--offline]")
        }
        return PkgResolveZxLock(launcher, root, "", arguments.count == 2)
    }
    if command == "update" {
        if arguments.count > 2 { return PkgFail("usage: ziran update [PACKAGE]") }
        refresh: string = "*"
        if arguments.count == 2 { refresh = arguments[1] }
        return PkgResolveZxLock(launcher, root, refresh, false)
    }
    project: bool = PkgHasArgument(flags, "--project") || implied
    current_toolchain: bool = PkgHasArgument(flags, "--current-toolchain")
    if current_toolchain && (command != "api" || !project) {
        return PkgFail("--current-toolchain requires ziran api --project")
    }
    locked_mode: bool = PkgHasArgument(flags, "--locked")
    offline: bool = PkgHasArgument(flags, "--offline")
    if pack_dev && locked_mode { return PkgFail("pack-dev cannot be used with --locked") }
    // `ziran api kit/button` names a module the way an import does; it
    // becomes --module, which takes one more slot than the argument.
    filtered := PkgStrings(arguments.count * 2)
    if filtered.count != arguments.count * 2 { return PkgFail("cannot allocate arguments") }
    count: s32 = 0
    // In a project, --module-path DIR adds a folder of the root package's
    // own modules, such as one a build step generates.
    generated := PkgStrings(arguments.count)
    if generated.count != arguments.count { return PkgFail("cannot allocate arguments") }
    generated_count: s32 = 0
    index: s32 = 1
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if project && index < separator && part == "--module-path" {
            if index + 1 >= separator { return PkgFail("--module-path needs a folder") }
            generated[generated_count] = arguments[index + 1]
            generated_count += 1
            index += 2
            continue
        }
        if command == "api" && index < separator && part.count > 0 && part[0] != #char "-" &&
           !PkgCompilerInput(part) && !ApiOptionValue(arguments[index - 1]) {
            filtered[count] = "--module"
            count += 1
        }
        if index >= separator ||
           (part != "--project" && part != "--locked" && part != "--offline" && part != "--current-toolchain") {
            filtered[count] = part
            count += 1
        }
        index += 1
    }
    locked: *PkgLock = null
    current: *PkgManifest = null
    checked_pins: PkgCheckedPins
    defer PkgReleaseCheckedPins(*checked_pins)
    if project || command == "fetch" || command == "pkg" || command == "tool" ||
       command == "install" {
        locked = PkgNewLock()
        current = PkgNewManifest()
        if locked == null || current == null ||
           !PkgReadLock(PkgJoin(root, "/ziran.lock"), locked) {
            return PkgFail("cannot read ziran.lock; run ziran lock")
        }
        selection := PkgCheckedSelection.{call = PkgSelectChecked, context = cast(*void)(*checked_pins)}
        checked: *PkgCheckedSelection = null
        compile := command == "build" || command == "run" || command == "check"
        target := PkgHasTarget(flags[1:])
        if compile && lifecycle && !target { checked_pins.lifecycle_manifest = current }
        if command == "bundle" || (compile && !target) ||
            (compile && PkgHasArgument(flags, "--target=c")) ||
            (command == "build" && PkgHasArgument(flags, "--target=zx")) ||
            pack_checked || (command == "pkg" && count >= 1 && filtered[0] == "list") {
            if !PkgReadCheckedPins(root, launcher, locked, *checked_pins) {
                if pkg_failure_reported { return 2 }
                return PkgFail("invalid checked packages in ziran.zx.lock")
            }
            if command == "bundle" || compile || pack_dev {
                development := PkgGetenv("ZIRAN_DEV_ZX_DIR")
                if development != "" {
                    if locked_mode { return PkgFail("ZIRAN_DEV_ZX_DIR cannot be used with --locked") }
                    checked_pins.development_directory = PkgCanonical(development)
                    if !DirectoryExists(checked_pins.development_directory) {
                        return PkgFail("ZIRAN_DEV_ZX_DIR must name a directory")
                    }
                }
            }
            if checked_pins.count != 0 || checked_pins.development_directory != "" { checked = *selection }
        }
        if !PkgCheckoutGraph(root, locked, offline, locked_mode, current, checked) {
            if pkg_failure_reported { return 2 }
            return PkgFail("cannot fetch locked packages")
        }
        if checked_pins.tool_identity != "" &&
            checked_pins.tool_identity != PkgLockId(locked.tool_url, locked.tool_commit, false) {
            return PkgFail("toolchain override differs from the checked package toolchain")
        }
        // A project runs with its pinned toolchain's own launcher, so an
        // installed ziran of any age writes the import map the lock expects.
        // A launcher built inside the pinned toolchain's own tree, such as
        // the sanitizer build under build/sanitize, is that toolchain.
        pinned: string = PkgJoin(locked.tool_path, "/build/bin/ziran")
        tool_root: string = PkgJoin(PkgCanonical(locked.tool_path), "/")
        own: string = PkgCanonical(launcher)
        inside: bool = tool_root.count > 1 && own.count > tool_root.count &&
            own[0:tool_root.count] == tool_root
        if !current_toolchain && PkgGetenv("ZIRAN_PINNED_LAUNCHER") != "1" && !inside &&
           own != PkgCanonical(pinned) {
            if !PkgEnsureToolBinary(locked.tool_path, pinned) { return 2 }
            forwarded := PkgStrings(arguments.count + 1)
            if forwarded.count != arguments.count + 1 { return PkgFail("cannot allocate arguments") }
            forwarded[0] = pinned
            index = 0
            while index < cast(s32)arguments.count {
                forwarded[index + 1] = arguments[index]
                index += 1
            }
            names: [1]string
            values: [1]string
            // "forwarded" marks the hand-off for tools without stopping a
            // ziran that a tool runs from reaching the pinned launcher too;
            // only "1" turns forwarding off.
            names[0] = "ZIRAN_PINNED_LAUNCHER"
            values[0] = "forwarded"
            return PkgRun(forwarded[0:index + 1], "", names[:], values[:])
        }
    }
    if pack_checked {
        directory := PkgToolDirectory(launcher, locked.tool_path, "zi2zir")
        if directory == "" { return PkgFail("cannot find the pinned Ziran compiler") }
        return PkgPackChecked(root, PkgJoin(directory, "/zi2zir"), locked, current, filtered[2:count], pack_dev, locked_mode)
    }
    if command == "fetch" { return 0 }
    if command == "compile-commands" {
        return PkgCompileCommands(filtered[0:count], project, locked, launcher)
    }
    if command == "pkg" && count >= 1 && filtered[0] == "artifact" {
        if count < 4 || filtered[2] != "--platform" || (count - 4) % 2 != 0 {
            return PkgFail("usage: ziran pkg artifact PACKAGE:ARTIFACT --platform OS-ARCH-ABI [--option Alias:key=value]...")
        }
        overrides: [256]string
        option_count: s32 = 0
        for at: 4..count - 1 {
            if (at - 4) % 2 == 0 {
                if filtered[at] != "--option" { return PkgFail("expected --option Alias:key=value") }
            } else {
                overrides[option_count] = filtered[at]
                option_count += 1
            }
        }
        selection := filtered[1]
        colon: s64 = 0
        while colon < cast(s64)selection.count && selection[colon] != cast(u8)58 { colon += 1 }
        if colon == 0 || colon >= cast(s64)selection.count - 1 {
            return PkgFail("artifact selection needs PACKAGE:ARTIFACT")
        }
        return PkgBuildArtifactResolved(root, selection[0:colon], selection[colon + 1:],
            filtered[3], locked, current, launcher, overrides[0:option_count])
    }
    if command == "pkg" && count >= 1 && filtered[0] == "list" {
        if count > 2 { return PkgFail("usage: ziran pkg list [PACKAGE]") }
        selector: string = ""
        if count == 2 { selector = filtered[1] }
        return PkgList(locked, current, selector)
    }
    if command == "pkg" && count >= 1 && filtered[0] == "paths" {
        end := count
        submodules := count > 1 && filtered[count - 1] == "--submodules"
        if submodules { end -= 1 }
        return PkgPaths(locked, filtered[1:end], submodules, offline)
    }
    if command == "pkg" {
        if count < 2 || count > 3 || filtered[0] != "path" ||
           (count == 3 && filtered[2] != "--submodules") {
            return PkgFail("usage: ziran pkg path PACKAGE [--submodules] | ziran pkg paths PACKAGE... [--submodules] | ziran pkg list [PACKAGE]")
        }
        if filtered[1] == "ziran" {
            if count == 3 { return PkgFail("Ziran has no package submodules") }
            PkgPrint(locked.tool_path, false)
            PkgPrint("\n", false)
            return 0
        }
        selected: s32 = PkgSelect(locked, filtered[1])
        if selected < 0 { return PkgFail("package is not locked") }
        if count == 3 && !PkgPrepareSubmodules(locked.packages[selected].path,
            offline) { return PkgFail("package submodules are missing") }
        PkgPrint(locked.packages[selected].path, false)
        PkgPrint("\n", false)
        return 0
    }
    if command == "tool" {
        if count < 2 { return PkgFail("usage: ziran tool PACKAGE COMMAND") }
        empty: [0]string
        return PkgRunTool(root, locked, current, filtered[0], filtered[1:count],
            empty[:], empty[:])
    }
    if current != null && current.problem.count > 0 {
        return PkgFail(current.problem)
    }
    if generated_count > 0 &&
        !PkgGeneratedRoots(root, locked, current, generated[0:generated_count]) { return 2 }
    // A project whose [package] tool is set, such as a Kryon application,
    // hands its program's run, build, check, and install to that tool.
    whole: bool = lifecycle && current != null && !PkgHasTarget(flags[1:])
    if whole && current.tool.count > 0 && command != "install" {
        passed := PkgStrings(cast(s64)count + 2 * generated_count + 1)
        if passed.count != cast(s64)count + 2 * generated_count + 1 { return 2 }
        passed[0] = command
        passed_count: s32 = 1
        // The tool runs the project's commands, so it gets the folders too.
        for folder: generated[0:generated_count] {
            passed[passed_count] = "--module-path"
            passed[passed_count + 1] = folder
            passed_count += 2
        }
        index = 0
        while index < count {
            passed[passed_count] = filtered[index]
            passed_count += 1
            index += 1
        }
        empty: [0]string
        return PkgRunTool(root, locked, current, current.tool,
            passed[0:passed_count], empty[:], empty[:])
    }
    if whole && (command == "build" || command == "run") {
        if command == "build" && count > 0 { return PkgFail("usage: ziran build") }
        program: string = PkgNativeBuild(root, locked, current, launcher)
        if program.count == 0 { return 2 }
        if command == "build" { return 0 }
        run := PkgStrings(cast(s64)count + 1)
        if run.count != cast(s64)count + 1 { return PkgFail("cannot allocate arguments") }
        run[0] = program
        run_count: s32 = 1
        skipped: bool = false
        index = 0
        while index < count {
            if filtered[index] == "--" && !skipped { skipped = true }
            else {
                run[run_count] = filtered[index]
                run_count += 1
            }
            index += 1
        }
        empty: [0]string
        return PkgRun(run[0:run_count], "", empty[:], empty[:])
    }
    if command == "install" {
        prefix: string = PkgJoin(PkgGetenv("HOME"), "/.local")
        passed := PkgStrings(cast(s64)count + 1)
        if passed.count != cast(s64)count + 1 { return 2 }
        passed[0] = "install"
        passed_count: s32 = 1
        index = 0
        while index < count {
            part: string = filtered[index]
            if part == "--prefix" {
                if index + 1 >= count { return PkgFail("--prefix needs a directory") }
                prefix = filtered[index + 1]
                index += 1
            } else if part.count > 9 && part[0:9] == "--prefix=" {
                prefix = part[9:]
            } else {
                passed[passed_count] = part
                passed_count += 1
            }
            index += 1
        }
        if prefix.count == 0 || prefix == "/.local" {
            return PkgFail("set HOME or pass --prefix")
        }
        if prefix[0] != cast(u8)47 { prefix = PkgJoin3(PkgCwd(), "/", prefix) }
        bin: string = current.install_bin
        if bin.count == 0 { bin = current.name }
        if current.tool.count == 0 {
            if passed_count > 1 { return PkgFail("usage: ziran install [--prefix DIR]") }
            return PkgNativeInstall(root, locked, current, launcher, prefix, bin)
        }
        names: [2]string
        values: [2]string
        names[0] = "ZIRAN_INSTALL_PREFIX"
        names[1] = "ZIRAN_INSTALL_BIN"
        values[0] = prefix
        values[1] = bin
        return PkgRunTool(root, locked, current, current.tool,
            passed[0:passed_count], names[:], values[:])
    }
    empty: [0]string
    if command == "run" && PkgHasArgument(flags, "--target=c") {
        compiler := "zi2c"
        binary := PkgJoin3(PkgLauncherDirectory(launcher), "/", compiler)
        program_root := ""
        program_file := ""
        map := ""
        libraries := PkgGetenv("LDLIBS")
        links_file := ""
        search_count: s64 = 1
        if current != null { search_count += current.root_count }
        if locked != null { search_count += locked.count }
        search := PkgStrings(search_count)
        if search.count != search_count { return 2 }
        searches: s64 = 0
        if project {
            binary = PkgJoin3(PkgToolDirectory(launcher, locked.tool_path, compiler), "/", compiler)
            if !PkgEnsureToolBinary(locked.tool_path, binary) { return 2 }
            program_root = PkgJoin3(root, "/", current.roots[0])
            if !PkgHasSource(flags[1:]) { program_file = PkgJoin3(root, "/", current.entry) }
            map = PkgWriteMap(root, locked, current)
            if map.count == 0 {
                if pkg_failure_reported { return 2 }
                return PkgFail("cannot build project import map")
            }
            index = 0
            while index < locked.count {
                if !locked.packages[index].source {
                    search[searches] = locked.packages[index].path
                    searches += 1
                }
                index += 1
            }
            libraries = PkgNativeLibraries(current)
            links_file = PkgWriteLinksFile(root, locked)
        }
        standard := PkgGetenv("ZIRAN_STD")
        if standard.count == 0 {
            standard = PkgJoin(ParentDirectory(binary), "/../../std")
            if !DirectoryExists(standard) { standard = PkgJoin(ParentDirectory(binary), "/../../../std") }
        }
        if DirectoryExists(standard) {
            search[searches] = standard; searches += 1
        }
        return ScriptRun(filtered[0:count], binary, root, program_root, program_file,
            search[0:searches], map, libraries, links_file, PkgCacheRoot())
    }
    // `ziran api kryon/button` names a dependency by its alias; the API tool
    // knows modules by their dependency-name namespace.
    if command == "api" && project && locked != null {
        for at: 1..count - 1 {
            if filtered[at - 1] != "--module" { continue }
            selector := filtered[at]
            slash: s64 = 0
            while slash < selector.count && selector[slash] != #char "/" { slash += 1 }
            if slash == 0 || slash >= selector.count { continue }
            id := PkgEdgeValue(*locked.root_edges[0], locked.root_edge_count, selector[0:slash])
            if id == "" { continue }
            entry := PkgFindById(locked, id)
            if entry < 0 { continue }
            filtered[at] = PkgJoin(PkgModulePrefix(*locked.packages[entry]), selector[slash:])
            // The tool's messages name the module as it was written.
            spelling_name: [1]string = .{"ZIRAN_API_MODULE"}
            spelling_value: [1]string = .{selector}
            return PkgDispatch(command, filtered[0:count], project, root, locked,
                current, launcher, spelling_name[:], spelling_value[:], current_toolchain)
        }
    }
    return PkgDispatch(command, filtered[0:count], project, root, locked,
        current, launcher, empty[:], empty[:], current_toolchain)
}

// Native platform and ABI are independent of the compiler's c/go backend.
PkgArtifactTarget :: (target: string) -> bool {
    if !PkgPackageName(target) || target[0] == cast(u8)45 ||
        target[target.count - 1] == cast(u8)45 { return false }
    parts: s32 = 0
    previous: u8 = 0
    for ch: target {
        if ch == cast(u8)45 {
            if previous == ch { return false }
            parts += 1
        }
        previous = ch
    }
    return parts >= 2
}

// The checked-out content at PATH as a git tree id, committed or not: a
// commit that records files already in place, such as another lane
// committing to a local override during the build, leaves it unchanged,
// while any change to the files does not. A private copy of the index
// keeps the checkout's own index untouched and its stat cache fast.
PkgArtifactContent :: (path: string) -> string {
    locate: [6]string = .["git", "-C", path, "rev-parse", "--path-format=absolute", "--git-path"]
    where: [7]string = .[locate[0], locate[1], locate[2], locate[3], locate[4], locate[5], "index"]
    index := PkgCapture(where[:], "")
    if index.code != 0 || index.text.count == 0 { return PkgGitHead(path) }
    copy := PkgTemporarySibling(index.text, ".snapshot")
    if copy.count == 0 { return PkgGitHead(path) }
    defer { unused RemoveFile(copy) }
    if PathExists(index.text) && !CopyFileNew(index.text, copy) { return PkgGitHead(path) }
    names: [1]string = .["GIT_INDEX_FILE"]
    values: [1]string = .[copy]
    add: [6]string = .["git", "-C", path, "add", "-A", "--ignore-errors"]
    tree: [4]string = .["git", "-C", path, "write-tree"]
    if PkgCaptureEnv(add[:], "", names[:], values[:]).code != 0 { return PkgGitHead(path) }
    written := PkgCaptureEnv(tree[:], "", names[:], values[:])
    if written.code != 0 || written.text.count == 0 { return PkgGitHead(path) }
    return written.text
}

PkgArtifactGraphKey :: (locked: *PkgLock, state: *string, reusable: *bool) {
    PkgArtifactMix(state, locked.tool_commit)
    for i: -1..locked.count - 1 {
        path := locked.tool_path
        if i >= 0 {
            path = locked.packages[i].path
            PkgArtifactMix(state, locked.packages[i].id)
            PkgArtifactMix(state, locked.packages[i].commit)
        }
        PkgArtifactMix(state, PkgArtifactContent(path))
        args: [6]string = .["git", "-C", path, "status", "--porcelain", "--untracked-files=all"]
        status := PkgCapture(args[:], "")
        if status.code != 0 || status.text.count > 0 { <<reusable = false }
    }
}

// Resolve invocation selectors against package identities, including root aliases.
PkgArtifactOptionColon :: (entry: string) -> s64 {
    at: s64 = 0
    while at < cast(s64)entry.count && entry[at] != cast(u8)58 { at += 1 }
    return at
}

PkgArtifactAlias :: (locked: *PkgLock, selected: s32, preferred: string) -> string {
    for i: 0..locked.root_edge_count - 1 {
        if locked.root_edges[i].value == locked.packages[selected].id &&
            PkgFoldEqual(locked.root_edges[i].name, preferred) { return PkgJoin("", locked.root_edges[i].name) }
    }
    for i: 0..locked.root_edge_count - 1 {
        if locked.root_edges[i].value == locked.packages[selected].id { return PkgJoin("", locked.root_edges[i].name) }
    }
    return PkgJoin("", locked.packages[selected].name)
}

PkgArtifactOptions :: (root: string, locked: *PkgLock, selected: s32,
    alias: string, overrides: []string) -> string {
    values: [256]string
    count: s32 = 0
    for entry: overrides {
        colon := PkgArtifactOptionColon(entry)
        if PkgSelect(locked, entry[0:colon]) == selected {
            values[count] = entry[colon + 1:]
            count += 1
        }
    }
    return PkgResolveOptionsWithOverrides(root, alias, locked.packages[selected].path, values[0:count])
}

PkgArtifactVisit :: (root: string, locked: *PkgLock, current: *PkgManifest,
    selected: s32, alias: string, artifact: string, target: string,
    launcher: string, stack: []string, depth: s32, overrides: []string, validate: bool) -> string {
    if selected < 0 || selected >= locked.count { PkgFail("artifact package is not locked"); return "" }
    item: *PkgLocked = *locked.packages[selected]
    identity := PkgJoin3(item.id, ":", artifact)
    if depth >= 64 { PkgFail("artifact dependency cycle or depth limit"); return "" }
    for i: 0..depth - 1 {
        if stack[i] == identity { PkgFail("artifact dependency cycle"); return "" }
    }
    stack[depth] = identity
    recipe: PkgArtifactRecipe
    if item.source || !PkgArtifactRead(PkgJoin(item.path, "/ziran.toml"), artifact, *recipe) {
        PkgFail("unknown or invalid artifact recipe"); return ""
    }
    options := PkgArtifactOptions(root, locked, selected, alias, overrides)
    if options.count == 0 { return "" }
    if validate {
        for request: recipe.requires[0:recipe.require_count] {
            colon := PkgArtifactOptionColon(request)
            if colon == 0 || colon >= cast(s64)request.count - 1 { PkgFail("invalid artifact dependency selection"); return "" }
            child := selected
            if request[0:colon] != "self" {
                child = PkgFindById(locked, PkgEdgeValue(*item.edges[0], item.edge_count, request[0:colon]))
            }
            if child < 0 { PkgFail("artifact package is not locked"); return "" }
            if PkgArtifactVisit(root, locked, current, child, PkgArtifactAlias(locked, child, alias),
                request[colon + 1:], target, launcher, stack, depth + 1, overrides, true).count == 0 { return "" }
        }
        return options
    }
    state := PkgDigest("ziran-artifact-v1")
    PkgArtifactMix(*state, identity)
    PkgArtifactMix(*state, target)
    PkgArtifactMix(*state, PkgRead(options).text)
    reusable := true
    PkgArtifactGraphKey(locked, *state, *reusable)
    graph_before := state
    PkgArtifactMix(*state, PkgArtifactHashFile(launcher))
    compiler := PkgJoin(locked.tool_path, "/build/bin/zi2c")
    if PathExists(compiler) { PkgArtifactMix(*state, PkgArtifactHashFile(compiler)) }
    cc := PkgGetenv("CC")
    if cc.count == 0 { cc = "cc" }
    cc_args: [2]string = .[cc, "--version"]
    version := PkgCapture(cc_args[:], "")
    if version.code != 0 { PkgFail("cannot identify artifact compiler (CC must be one executable)"); return "" }
    PkgArtifactMix(*state, cc)
    PkgArtifactMix(*state, version.text)
    locate: [2]string = .["which", cc]
    location := PkgCapture(locate[:], "")
    if location.code != 0 { PkgFail("cannot locate artifact compiler"); return "" }
    compiler_hash := PkgArtifactHashFile(PkgTrim(location.text))
    if compiler_hash.count == 0 { PkgFail("cannot hash artifact compiler"); return "" }
    PkgArtifactMix(*state, compiler_hash)
    // The entire recipe declaration and relevant native build environment.
    recipe_hash := PkgArtifactHashFile(PkgJoin(item.path, "/ziran.toml"))
    PkgArtifactMix(*state, recipe_hash)
    flags: [16]string = .["PATH", "CFLAGS", "CPPFLAGS", "CXX", "CXXFLAGS", "LDFLAGS", "LDLIBS", "AR", "LD", "RANLIB", "PKG_CONFIG", "PKG_CONFIG_PATH", "PKG_CONFIG_LIBDIR", "SYSROOT", "SDKROOT", "MACOSX_DEPLOYMENT_TARGET"]
    for flag: flags { PkgArtifactMix(*state, PkgGetenv(flag)) }
    input_hashes: [PKG_ARTIFACT_INPUT_LIMIT]string
    for i: 0..recipe.input_count - 1 {
        path := PkgJoin3(item.path, "/", recipe.inputs[i])
        if !PkgArtifactInside(item.path, path) || DirectoryExists(path) {
            PkgFail("artifact input must be a file inside its package"); return ""
        }
        hash := PkgArtifactHashFile(path)
        if hash.count == 0 { PkgFail("cannot hash artifact input"); return "" }
        input_hashes[i] = hash
        PkgArtifactMix(*state, hash)
    }
    dependencies := ""
    for i: 0..recipe.require_count - 1 {
        request := recipe.requires[i]
        colon: s64 = 0
        while colon < cast(s64)request.count && request[colon] != cast(u8)58 { colon += 1 }
        if colon == 0 || colon == cast(s64)request.count { PkgFail("invalid artifact dependency selection"); return "" }
        dependency := request[0:colon]
        child := selected
        child_alias := alias
        if dependency != "self" {
            child = PkgFindById(locked, PkgEdgeValue(*item.edges[0], item.edge_count, dependency))
            if child >= 0 { child_alias = PkgArtifactAlias(locked, child, dependency) }
        }
        descriptor := PkgArtifactVisit(root, locked, current, child, child_alias,
            request[colon + 1:], target, launcher, stack, depth + 1, overrides, false)
        if descriptor.count == 0 { return "" }
        PkgArtifactMix(*state, PkgArtifactHashFile(descriptor))
        PkgArtifactMix(*state, descriptor)
        dependencies = PkgJoin3(dependencies, request, "\t")
        dependencies = PkgJoin3(dependencies, descriptor, "\n")
    }
    metadata := PkgJoin3("schema\t1\npackage\t", item.id, "\nartifact\t")
    metadata = PkgJoin3(metadata, artifact, "\nplatform\t")
    metadata = PkgJoin3(metadata, target, "\nkey\t")
    metadata = PkgJoin3(metadata, state, "\n")
    transaction := PkgArtifactBegin(PkgJoin(PkgCacheRoot(), "/artifacts"), state,
        metadata, *recipe, reusable)
    if !transaction.valid { PkgFail("cannot stage artifact"); return "" }
    if transaction.hit { return PkgJoin(transaction.directory, "/artifact.tsv") }
    dependency_file := PkgJoin(transaction.stage, "/dependencies.tsv")
    if !PkgWrite(dependency_file, dependencies) { PkgArtifactRemove(transaction.stage); return "" }
    names: [5]string = .["ZIRAN_ARTIFACT_OUTPUT", "ZIRAN_ARTIFACT_TARGET", "ZIRAN_ARTIFACT_DEPENDENCIES", "MAKEFLAGS", "CMAKE_BUILD_PARALLEL_LEVEL"]
    values: [5]string = .[transaction.stage, target, dependency_file, "-j1", "1"]
    args: [6]string = .["artifact", artifact, "--platform", target, "--output", transaction.stage]
    code := PkgRunSelectedToolOptions(root, locked, current, selected, alias, args[:], names[:], values[:], options)
    // Refuse publication if recipe inputs changed while the provider ran,
    // and say that this, not the provider, is why nothing was published.
    changed := ""
    for i: 0..recipe.input_count - 1 {
        if PkgArtifactHashFile(PkgJoin3(item.path, "/", recipe.inputs[i])) != input_hashes[i] {
            code = 2
            if changed == "" { changed = PkgJoin("recipe input ", recipe.inputs[i]) }
        }
    }
    graph_after := PkgDigest("ziran-artifact-v1")
    PkgArtifactMix(*graph_after, identity)
    PkgArtifactMix(*graph_after, target)
    PkgArtifactMix(*graph_after, PkgRead(options).text)
    after_reusable := true
    PkgArtifactGraphKey(locked, *graph_after, *after_reusable)
    if recipe_hash != PkgArtifactHashFile(PkgJoin(item.path, "/ziran.toml")) {
        code = 2
        if changed == "" { changed = "the package's ziran.toml" }
    }
    if graph_after != graph_before || (reusable && !after_reusable) {
        code = 2
        if changed == "" { changed = "the source of a package in its dependency graph, such as a local override being edited or committed," }
    }
    if !PkgArtifactFinish(*transaction, *recipe, code) {
        if changed != "" {
            PkgFail(PkgJoin3("artifact not published: ", changed, " changed while the provider ran; run the command again when the sources are still"))
            return ""
        }
        PkgFail("artifact provider failed or omitted a declared output"); return ""
    }
    return PkgJoin(transaction.directory, "/artifact.tsv")
}

PkgBuildArtifactResolved :: (project: string, package: string, artifact: string,
    target: string, locked: *PkgLock, current: *PkgManifest, launcher: string, overrides: []string) -> s32 {
    if !PkgArtifactTarget(target) { return PkgFail("artifact --platform needs an explicit OS-ARCH-ABI target") }
    if overrides.count > 256 { return PkgFail("too many artifact options") }
    for i: 0..cast(s64)overrides.count - 1 {
        entry := overrides[i]
        colon := PkgArtifactOptionColon(entry)
        if colon == 0 || colon >= cast(s64)entry.count - 1 || !PkgPackageName(entry[0:colon]) {
            return PkgFail("--option needs Alias:key=value")
        }
        selected := PkgSelect(locked, entry[0:colon])
        if selected < 0 { return PkgFail("--option package is not locked or is ambiguous") }
        equal := colon + 1
        while equal < cast(s64)entry.count && entry[equal] != cast(u8)61 { equal += 1 }
        for j: 0..i - 1 {
            prior := overrides[j]
            split := PkgArtifactOptionColon(prior)
            end := split + 1
            while end < cast(s64)prior.count && prior[end] != cast(u8)61 { end += 1 }
            if PkgSelect(locked, prior[0:split]) == selected && prior[split + 1:end] == entry[colon + 1:equal] {
                return PkgFail("duplicate artifact option")
            }
        }
    }
    // Validate every supplied package and the complete prerequisite graph before
    // compiler identification, cache lookup or any provider invocation.
    for entry: overrides {
        selected := PkgSelect(locked, entry[0:PkgArtifactOptionColon(entry)])
        if PkgArtifactOptions(project, locked, selected, PkgArtifactAlias(locked, selected, entry[0:PkgArtifactOptionColon(entry)]), overrides).count == 0 { return 2 }
    }
    selected := PkgSelect(locked, package)
    if selected < 0 { return PkgFail("artifact package is not locked") }
    alias := PkgArtifactAlias(locked, selected, package)
    stack: [64]string
    if PkgArtifactVisit(project, locked, current, selected, alias, artifact, target,
        launcher, stack[:], 0, overrides, true).count == 0 { return 2 }
    descriptor := PkgArtifactVisit(project, locked, current, PkgSelect(locked, package),
        alias, artifact, target, launcher, stack[:], 0, overrides, false)
    if descriptor.count == 0 { return 2 }
    PkgPrint(PkgJoin(descriptor, "\n"), false)
    return 0
}

// Programmatic entry uses the same lock/override resolver as package commands.
PkgBuildArtifact :: (project: string, package: string, artifact: string,
    target: string) -> s32 {
    empty: [0]string
    return PkgBuildArtifactWithOptions(project, package, artifact, target, empty[:])
}

PkgBuildArtifactWithOptions :: (project: string, package: string, artifact: string,
    target: string, overrides: []string) -> s32 {
    locked := PkgNewLock()
    current := PkgNewManifest()
    if !PkgReadLock(PkgJoin(project, "/ziran.lock"), locked) { return PkgFail("cannot read ziran.lock; run ziran lock") }
    if !PkgCheckoutGraph(project, locked, false, false, current) { return PkgFail("cannot resolve artifact package graph") }
    return PkgBuildArtifactResolved(project, package, artifact, target, locked,
        current, PkgJoin(locked.tool_path, "/build/bin/ziran"), overrides)
}
