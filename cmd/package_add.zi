#import "package_common"
#import "package_manifest"
#import "package_source"
#import "byte_text_linux"
#import "text"

PkgValidRef :: (value: string) -> bool {
    if value.count == 0 || value[0] == cast(u8)45 || value[0] == cast(u8)47 {
        return false
    }
    index: s64 = 0
    while index < cast(s64)value.count {
        ch: u8 = value[index]
        if !(PkgSourceLetter(ch) || ch == cast(u8)45 || ch == cast(u8)95 ||
             ch == cast(u8)46 || ch == cast(u8)47) { return false }
        index += 1
    }
    return true
}

// A repository name becomes an import prefix: kryon-ui -> kryon_ui.
PkgAliasFromRepository :: (repository: string) -> string {
    memory: *u8 = PkgAlloc(cast(u64)repository.count + 1)
    if memory == null { return "" }
    bytes: []u8 = BytesFromPointer(memory, cast(u64)repository.count + 1)
    index: s64 = 0
    while index < cast(s64)repository.count {
        ch: u8 = LowerASCII(repository[index])
        if ch == cast(u8)45 || ch == cast(u8)46 { ch = cast(u8)95 }
        bytes[index] = ch
        index += 1
    }
    return TextFromBytes(bytes[0:index])
}

PkgAddUsage :: () -> s32 {
    return PkgFail("usage: ziran add URL|OWNER/REPO [--name NAME] [--ref REF] [--source]")
}

// `ziran add` accepts any spelling of a Git repository:
//
//   ziran add https://github.com/kryonlabs/plot.git
//   ziran add git@github.com:kryonlabs/plot.git
//   ziran add codeberg.org/owner/repo
//   ziran add kryonlabs/plot            (GitHub)
//
// The dependency is named after the repository unless --name says
// otherwise, and its modules are imported as NAME/Module.
#program_export
Add :: (launcher: string, arguments: []string) -> s32 {
    if arguments.count < 1 { return PkgAddUsage() }
    requested: string = arguments[0]
    alias: string = ""
    url: string = ""
    reference: string = "master"
    source: bool = false
    index: s32 = 1
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if (part == "--git" || part == "--name" || part == "--ref") &&
           index + 1 >= cast(s32)arguments.count {
            return PkgAddUsage()
        }
        if part == "--git" {
            // The older spelling: ziran add NAME --git URL.
            alias = requested
            url = arguments[index + 1]
            index += 2
        } else if part == "--name" {
            alias = arguments[index + 1]
            index += 2
        } else if part == "--ref" {
            reference = arguments[index + 1]
            index += 2
        } else if part == "--source" {
            source = true
            index += 1
        } else {
            return PkgAddUsage()
        }
    }
    if url.count == 0 { url = PkgExpandSource(requested) }
    if !PkgGitURL(url) {
        return PkgFail(PkgJoin3("ziran add: not a Git repository URL: ", url,
            "\nuse https://HOST/OWNER/REPO.git, git@HOST:OWNER/REPO.git, or OWNER/REPO"))
    }
    if alias.count == 0 { alias = PkgAliasFromRepository(PkgRepositoryName(url)) }
    if !PkgIdentifier(alias) {
        return PkgFail(PkgJoin3("ziran add: ", alias,
            " cannot name a dependency; pass --name NAME"))
    }
    if !PkgValidRef(reference) { return PkgFail("ziran add: invalid ref") }
    root: string = PkgProjectRoot()
    if root.count == 0 { return PkgFail("ziran add: no ziran.toml found") }
    manifest_path: string = PkgJoin(root, "/ziran.toml")
    original: PkgReadResult = PkgRead(manifest_path)
    current: *PkgManifest = PkgNewManifest()
    if !original.valid || current == null ||
       !PkgParseManifest(manifest_path, current) {
        return PkgFail("ziran add: cannot read ziran.toml")
    }
    index = 0
    while index < current.dependency_count {
        dependency: *PkgDependency = *current.dependencies[index]
        if PkgSameSource(dependency.git, url) {
            return PkgFail(PkgJoin3("ziran add: repository is already the dependency ",
                dependency.alias, ""))
        }
        if PkgFoldEqual(dependency.alias, alias) {
            return PkgFail(PkgJoin3("ziran add: dependency ", dependency.alias,
                " already exists; pass --name NAME"))
        }
        index += 1
    }
    declaration: string = PkgJoin3("\n[dependencies.", alias, "]\ngit = \"")
    declaration = PkgJoin3(declaration, url, "\"\nref = \"")
    declaration = PkgJoin3(declaration, reference, "\"\n")
    if source { declaration = PkgJoin(declaration, "source = true\n") }
    if !PkgWrite(manifest_path, PkgJoin(original.text, declaration)) {
        return PkgFail("ziran add: cannot update ziran.toml")
    }
    command: [2]string
    command[0] = launcher
    command[1] = "lock"
    locked: PkgProcessResult = PkgCapture(command[:], root)
    if locked.code != 0 {
        PkgWrite(manifest_path, original.text)
        PkgPrint(locked.text, true)
        PkgPrint("\n", true)
        return PkgFail("ziran add: lock failed; ziran.toml restored")
    }
    PkgPrint(PkgJoin3("added ", alias, " from "), false)
    PkgPrint(PkgJoin3(url, " at ", reference), false)
    PkgPrint("\n", false)
    if source { return 0 }
    shown: [4]string
    shown[0] = launcher
    shown[1] = "pkg"
    shown[2] = "list"
    shown[3] = alias
    listed: PkgProcessResult = PkgCapture(shown[:], root)
    if listed.code == 0 {
        PkgPrint(listed.text, false)
        PkgPrint("\n", false)
    }
    return 0
}
