#import "package_common"

#scope_file
NUMERIC_CONFORMANCE_IDS: string = "numeric.compile.div_min.s32\nnumeric.compile.div_min.s64\nnumeric.compile.cast_wrap.u8\nnumeric.compile.wrap_add.u8\nnumeric.compile.wrap_add.s8\nnumeric.shift.left.u8\nnumeric.shift.left.u16\nnumeric.shift.right.arithmetic.s8\nnumeric.shift.right.arithmetic.s16\nnumeric.float.cast.u16\nnumeric.float.cast.s8\nnumeric.float.divide.zero.f64\nnumeric.float.compare.nan\nnumeric.float.divide.zero.f32\nnumeric.wrap.add.u8\nnumeric.wrap.add.s8\nnumeric.wrap.sub.u8\nnumeric.wrap.mul.s8\nnumeric.wrap.add.s32\nnumeric.div_min.s32\nnumeric.rem_min.s32\nnumeric.div_min.s64\nnumeric.rem_min.s64\nnumeric.cast.width_pairs.all\nnumeric.mixed.add.u16_to_u8\nnumeric.mixed.add.u8_to_u16\nnumeric.bitwise.and.u8\nnumeric.bitwise.or.u8\nnumeric.bitwise.xor.u8\nnumeric.shift.reject.width\nnumeric.shift.reject.negative";

PkgPrintNumericIdList :: () -> void {
    PkgPrint("[", false)
    at: s32 = 0
    first: bool = true
    while at < cast(s32)NUMERIC_CONFORMANCE_IDS.count {
        end: s32 = at
        while end < cast(s32)NUMERIC_CONFORMANCE_IDS.count &&
              NUMERIC_CONFORMANCE_IDS[end] != cast(u8)10 { end += 1 }
        if end > at {
            if !first { PkgPrint(",", false) }
            PkgPrint("\"", false)
            PkgPrint(NUMERIC_CONFORMANCE_IDS[at:end], false)
            PkgPrint("\"", false)
            first = false
        }
        if end >= cast(s32)NUMERIC_CONFORMANCE_IDS.count { break }
        at = end + 1
    }
    PkgPrint("]", false)
}

PkgPrintNumericConformance :: (target: string) -> void {
    PkgPrint("\"numeric_conformance\":{\"schema_version\":1,\"stability\":\"stable-id\",\"targets\":[", false)
    if target.count == 0 {
        PkgPrint("\"c\",\"cpp\",\"go\",\"rust\",\"py\",\"zib\"", false)
    } else if target != "plan9-c" {
        PkgPrint("\"", false)
        PkgPrint(target, false)
        PkgPrint("\"", false)
    }
    PkgPrint("],\"ids\":", false)
    if target != "plan9-c" { PkgPrintNumericIdList() }
    else { PkgPrint("[]", false) }
    PkgPrint("}", false)
}

#scope_export
Capabilities :: (arguments: []string) -> s32 {
    target: string = ""
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if part == "--json" {
            index += 1
            continue
        }
        if target.count > 0 {
            return PkgFail("capabilities accepts one target")
        }
        if part == "--target=c" { target = "c" }
        else if part == "--target=cpp" { target = "cpp" }
        else if part == "--target=go" { target = "go" }
        else if part == "--target=rust" { target = "rust" }
        else if part == "--target=py" { target = "py" }
        else if part == "--target=zib" { target = "zib" }
        else if part == "--target=plan9-c" { target = "plan9-c" }
        else {
            return PkgFail(
                "usage: ziran capabilities [--target=c|cpp|go|rust|py|zib|plan9-c] [--json]")
        }
        index += 1
    }
    PkgPrint("{\"schema_version\":1,", false)
    if target.count == 0 {
        PkgPrint("\"targets\":[\"c\",\"cpp\",\"go\",\"rust\",\"py\",\"zib\",\"plan9-c\"],", false)
        PkgPrint("\"parallel_execution\":{\"c\":\"threads\",\"cpp\":\"threads\",\"go\":\"serial\",\"rust\":\"serial\",\"py\":\"serial\",\"zib\":\"serial\",\"plan9-c\":\"serial\"},", false)
        PkgPrint("\"text_view_mutable_bytes\":{\"c\":\"borrowed\",\"cpp\":\"borrowed\",\"go\":\"snapshot\",\"rust\":\"borrowed\",\"py\":\"snapshot\",\"zib\":\"snapshot\",\"plan9-c\":\"borrowed\"},", false)
    } else {
        PkgPrint("\"target\":\"", false)
        PkgPrint(target, false)
        PkgPrint("\",", false)
        if target == "plan9-c" {
            PkgPrint("\"parallel_execution\":\"serial\",", false)
            PkgPrint("\"text_view_mutable_bytes\":\"borrowed\",", false)
            PkgPrint("\"target_contract\":\"experimental-post-pass\",", false)
            PkgPrint("\"native_os\":\"plan9\",", false)
            PkgPrint("\"native_libc\":\"plan9\",", false)
            PkgPrint("\"architecture\":\"386\",", false)
            PkgPrint("\"dialect\":\"plan9-c88\",", false)
        } else if target == "c" || target == "cpp" {
            PkgPrint("\"parallel_execution\":\"threads\",", false)
            PkgPrint("\"text_view_mutable_bytes\":\"borrowed\",", false)
        } else if target == "rust" {
            PkgPrint("\"parallel_execution\":\"serial\",", false)
            PkgPrint("\"text_view_mutable_bytes\":\"borrowed\",", false)
        } else {
            PkgPrint("\"parallel_execution\":\"serial\",", false)
            PkgPrint("\"text_view_mutable_bytes\":\"snapshot\",", false)
        }
    }
    PkgPrint("\"source_and_saved_ir\":true,", false)
    PkgPrint("\"gpu_execution\":\"cpu_fallback\",", false)
    PkgPrint("\"automatic_vec_drop\":true,", false)
    PkgPrint("\"aggregate_vec_transfer\":true,", false)
    PkgPrintNumericConformance(target)
    PkgPrint(",", false)
    PkgPrint("\"text_view_local_mutation_check\":true,", false)
    PkgPrint("\"diagnostics_json\":\"partial\"}\n", false)
    return 0
}
