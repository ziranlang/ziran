#import "package_common"

PkgTargetSupport :: struct {
    target: string
    status: string
    limit: string
}

PkgFeature :: struct {
    id: string
    status: string
    syntax: string
    limits: string
    accepted_example: string
    rejected_example: string
    rejection: string
    evidence: string
    targets: [6]PkgTargetSupport
}


PkgPrintTargetSupport :: (item: PkgTargetSupport) -> void {
    PkgPrint("{\"target\":", false)
    PkgJsonString(item.target)
    PkgPrint(",\"status\":", false)
    PkgJsonString(item.status)
    PkgPrint(",\"limit\":", false)
    PkgJsonString(item.limit)
    PkgPrint("}", false)
}

PkgPrintFeature :: (item: PkgFeature, include_braces: bool) -> void {
    if include_braces { PkgPrint("{", false) }
    PkgPrint("\"id\":", false)
    PkgJsonString(item.id)
    PkgPrint(",\"status\":", false)
    PkgJsonString(item.status)
    PkgPrint(",\"syntax\":", false)
    PkgJsonString(item.syntax)
    PkgPrint(",\"target_support\":[", false)
    target_index: s32 = 0
    while target_index < cast(s32)item.targets.count {
        if target_index != 0 { PkgPrint(",", false) }
        PkgPrintTargetSupport(item.targets[target_index])
        target_index += 1
    }
    PkgPrint("],\"limits\":", false)
    PkgJsonString(item.limits)
    PkgPrint(",\"accepted_example\":", false)
    PkgJsonString(item.accepted_example)
    PkgPrint(",\"rejected_example\":", false)
    PkgJsonString(item.rejected_example)
    PkgPrint(",\"rejection\":", false)
    PkgJsonString(item.rejection)
    PkgPrint(",\"evidence\":[", false)
    evidence_at: s32 = 0
    evidence_first: bool = true
    while evidence_at < cast(s32)item.evidence.count {
        evidence_end: s32 = evidence_at
        while evidence_end < cast(s32)item.evidence.count &&
        item.evidence[evidence_end] != cast(u8)10 { evidence_end += 1 }
        if evidence_end > evidence_at {
            if !evidence_first { PkgPrint(",", false) }
            PkgJsonString(item.evidence[evidence_at:evidence_end])
            evidence_first = false
        }
        if evidence_end >= cast(s32)item.evidence.count { break }
        evidence_at = evidence_end + 1
    }
    PkgPrint("]", false)
    if include_braces { PkgPrint("}", false) }
}

PkgPrintFeatureList :: (items: []PkgFeature, json: bool) -> void {
    if json {
        PkgPrint("{\"schema_version\":1,\"stability\":\"stable-id\",\"features\":[", false)
        index: s32 = 0
        while index < cast(s32)items.count {
            if index != 0 { PkgPrint(",", false) }
            PkgPrintFeature(items[index], true)
            index += 1
        }
        PkgPrint("]}\n", false)
        return
    }
    index: s32 = 0
    while index < cast(s32)items.count {
        item: PkgFeature = items[index]
        PkgPrint("id: ", false)
        PkgPrint(item.id, false)
        PkgPrint("\nstatus: ", false)
        PkgPrint(item.status, false)
        PkgPrint("\nsyntax: ", false)
        PkgPrint(item.syntax, false)
        PkgPrint("\nlimits: ", false)
        PkgPrint(item.limits, false)
        PkgPrint("\ntargets:", false)
        target_index: s32 = 0
        while target_index < cast(s32)item.targets.count {
            target: PkgTargetSupport = item.targets[target_index]
            PkgPrint(" ", false)
            PkgPrint(target.target, false)
            PkgPrint("=", false)
            PkgPrint(target.status, false)
            target_index += 1
        }
        PkgPrint("\nevidence:", false)
        PkgPrint(item.evidence, false)
        PkgPrint("\naccepted example:\n", false)
        PkgPrint(item.accepted_example, false)
        PkgPrint("rejected example:\n", false)
        PkgPrint(item.rejected_example, false)
        PkgPrint("rejection: ", false)
        PkgPrint(item.rejection, false)
        PkgPrint("\n\n", false)
        index += 1
    }
}

#scope_export
Features :: (arguments: []string) -> s32 {
    numeric_targets: [6]PkgTargetSupport = .[
    .{target = "c", status = "supported", limit = ""},
    .{target = "cpp", status = "supported", limit = ""},
    .{target = "go", status = "supported", limit = ""},
    .{target = "rust", status = "experimental", limit = "The initial Rust backend is not covered by the numeric differential matrix."},
    .{target = "zib", status = "supported", limit = ""},
    .{target = "plan9-c", status = "experimental", limit = "Not covered by the numeric differential matrix."}
    ]
    record_targets: [6]PkgTargetSupport = .[
    .{target = "c", status = "supported", limit = ""},
    .{target = "cpp", status = "supported", limit = ""},
    .{target = "go", status = "supported", limit = ""},
    .{target = "rust", status = "unsupported", limit = "The initial Rust backend does not lower owned Vec storage."},
    .{target = "zib", status = "supported", limit = ""},
    .{target = "plan9-c", status = "experimental", limit = "Not covered by the aggregate-ownership differential matrix."}
    ]
    view_targets: [6]PkgTargetSupport = .[
    .{target = "c", status = "supported", limit = "Mutable backing bytes are observed as a borrow."},
    .{target = "cpp", status = "supported", limit = "Mutable backing bytes are observed as a borrow."},
    .{target = "go", status = "supported", limit = "Mutable backing bytes are snapshotted."},
    .{target = "rust", status = "supported", limit = "Mutable backing bytes are observed as a borrow."},
    .{target = "zib", status = "supported", limit = "Mutable backing bytes are snapshotted."},
    .{target = "plan9-c", status = "experimental", limit = "Borrow behavior is inherited from the C post-pass and is not covered by the differential matrix."}
    ]
    assert_targets: [6]PkgTargetSupport = .[
    .{target = "c", status = "supported", limit = ""},
    .{target = "cpp", status = "supported", limit = ""},
    .{target = "go", status = "supported", limit = ""},
    .{target = "rust", status = "supported", limit = "Checked before native output."},
    .{target = "zib", status = "supported", limit = ""},
    .{target = "plan9-c", status = "supported", limit = "Checked before native output."}
    ]
    features: [4]PkgFeature = .[
    .{
        id = "compile.assertions",
        status = "implemented",
        syntax = "#assert CONSTANT_EXPRESSION",
        limits = "The condition must be compile-time constant and effect-free.",
        accepted_example = "VALUE :: #run 41 + 1\n#assert VALUE == 42\n#program_export\nAnswer :: () -> s32 { return VALUE }\n",
        rejected_example = "#assert 0\n#program_export\nAnswer :: () -> s32 { return 0 }\n",
        rejection = "A false compile-time assertion fails checking.",
        evidence = "tests/compile_run.sh\ntests/compile_time.sh\ncheck.assert\n",
        targets = assert_targets
    },
    .{
        id = "numeric.integer-width-conformance",
        status = "implemented",
        syntax = "s8, u8, s16, u16, s32, u32, s64, u64, float32, float64, and cast(T) expressions",
        limits = "The stable differential matrix covers the published IDs below; broader operator and mixed-width combinations remain to be added.",
        accepted_example = "#program_export\nAnswer :: () -> s32 {\n    value: s32 = 2147483647\n    return value + 1\n}\n",
        rejected_example = "Answer :: () -> f64 { return 1.0 }\n",
        rejection = "Legacy f64 spelling is rejected; write float64.",
        evidence = "tests/numeric_semantics.sh\ntests/numeric_conformance.json\nnumeric.wrap.add.s32\n",
        targets = numeric_targets
    },
    .{
        id = "ownership.local-text-view-mutation-check",
        status = "implemented",
        syntax = "TextView(bytes[:]) and lexical release at view scope close",
        limits = "Unknown heap aliases and host-backed views still need a complete lifetime model. Native and portable targets disagree when checked mutation restrictions are bypassed.",
        accepted_example = "Check :: () -> s32 {\n    bytes: [1]u8 = .[97]\n    {\n        text := TextView(bytes[:])\n        if text.count != 1 { return 1 }\n    }\n    bytes[0] = cast(u8)98\n    return cast(s32)bytes[0]\n}\n",
        rejected_example = "Check :: () -> s32 {\n    bytes: [1]u8\n    text := TextView(bytes[:])\n    bytes[0] = cast(u8)98\n    return cast(s32)text[0]\n}\n",
        rejection = "Mutable backing storage cannot be changed while a view of it is live.",
        evidence = "tests/text_view_mutation.sh\ntests/aggregate_view_lifetime.sh\ntests/rust_backend.sh\ntests/capabilities.sh\n",
        targets = view_targets
    },
    .{
        id = "ownership.record-vec-field-move",
        status = "implemented",
        syntax = "record.field Vec moves from local aggregate paths",
        limits = "Indexed fields, pointer-backed fields, global storage, and repeated moves in one expression remain rejected.",
        accepted_example = "#import \"vec\"\nInner :: struct { items: Vec(s32); other: Vec(s32); }\nCheck :: () -> s32 {\n    value: Inner\n    VecPush(value.items, 1)\n    VecPush(value.other, 2)\n    moved := value.items\n    return moved[0] + value.other[0]\n}\n",
        rejected_example = "#import \"vec\"\nInner :: struct { items: Vec(s32); }\nBox :: struct { inners: [2]Inner; }\nCheck :: () -> s32 {\n    value: Box\n    VecPush(value.inners[0].items, 1)\n    moved := value.inners[0].items\n    return moved[0]\n}\n",
        rejection = "Indexed aggregate fields do not yet have a precise per-element ownership transfer.",
        evidence = "tests/aggregate_vec_safety.sh\ntests/vec_move_expression.sh\ntests/capabilities.sh\n",
        targets = record_targets
    },
    ]

    json: bool = false
    id: string = ""
    positional: s32 = 0
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if part == "--json" { json = true }
        else if part == "--id" {
            index += 1
            if index >= cast(s32)arguments.count || arguments[index].count == 0 {
                return PkgFail("usage: ziran features [--json] [--id FEATURE_ID]")
            }
            if id.count != 0 {
                return PkgFail("features accepts one ID")
            }
            id = arguments[index]
        } else {
            if positional != 0 || id.count != 0 {
                return PkgFail("usage: ziran features [--json] [--id FEATURE_ID]")
            }
            id = part
            positional += 1
        }
        index += 1
    }
    if positional != 0 && id.count == 0 {
        return PkgFail("usage: ziran features [--json] [--id FEATURE_ID]")
    }
    if id.count == 0 {
        PkgPrintFeatureList(features[:], json)
        return 0
    }
    selected: s32 = -1
    index = 0
    while index < cast(s32)features.count {
        if features[index].id == id { selected = index; break }
        index += 1
    }
    if selected < 0 {
        PkgPrint("ziran: unknown feature ID: ", true)
        PkgPrint(id, true)
        PkgPrint("\nRun ziran features for known IDs.\n", true)
        return 2
    }
    if json {
        PkgPrint("{\"schema_version\":1,\"stability\":\"stable-id\",\"feature\":", false)
        PkgPrintFeature(features[selected], true)
        PkgPrint("}\n", false)
    } else {
        PkgPrintFeatureList(features[selected:selected + 1], false)
    }
    return 0
}
