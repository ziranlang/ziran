#import "package_common"

PkgTargetSupport :: struct {
    target: string
    status: string
    limit: string
}

PkgFeature :: struct {
    id: string
    status: string
    syntax: string
    limits: string
    accepted_example: string
    rejected_example: string
    rejection: string
    evidence: string
    targets: [7]PkgTargetSupport
}


PkgPrintTargetSupport :: (item: PkgTargetSupport) -> void {
    PkgPrint("{\"target\":", false)
    PkgJsonString(item.target)
    PkgPrint(",\"status\":", false)
    PkgJsonString(item.status)
    PkgPrint(",\"limit\":", false)
    PkgJsonString(item.limit)
    PkgPrint("}", false)
}

PkgPrintFeature :: (item: PkgFeature, include_braces: bool) -> void {
    if include_braces { PkgPrint("{", false) }
    PkgPrint("\"id\":", false)
    PkgJsonString(item.id)
    PkgPrint(",\"status\":", false)
    PkgJsonString(item.status)
    PkgPrint(",\"syntax\":", false)
    PkgJsonString(item.syntax)
    PkgPrint(",\"target_support\":[", false)
    target_index: s32 = 0
    while target_index < cast(s32)item.targets.count {
        if target_index != 0 { PkgPrint(",", false) }
        PkgPrintTargetSupport(item.targets[target_index])
        target_index += 1
    }
    PkgPrint("],\"limits\":", false)
    PkgJsonString(item.limits)
    PkgPrint(",\"accepted_example\":", false)
    PkgJsonString(item.accepted_example)
    PkgPrint(",\"rejected_example\":", false)
    PkgJsonString(item.rejected_example)
    PkgPrint(",\"rejection\":", false)
    PkgJsonString(item.rejection)
    PkgPrint(",\"evidence\":[", false)
    evidence_at: s32 = 0
    evidence_first: bool = true
    while evidence_at < cast(s32)item.evidence.count {
        evidence_end: s32 = evidence_at
        while evidence_end < cast(s32)item.evidence.count &&
        item.evidence[evidence_end] != cast(u8)10 { evidence_end += 1 }
        if evidence_end > evidence_at {
            if !evidence_first { PkgPrint(",", false) }
            PkgJsonString(item.evidence[evidence_at:evidence_end])
            evidence_first = false
        }
        if evidence_end >= cast(s32)item.evidence.count { break }
        evidence_at = evidence_end + 1
    }
    PkgPrint("]", false)
    if include_braces { PkgPrint("}", false) }
}

PkgPrintFeatureList :: (items: []PkgFeature, json: bool) -> void {
    if json {
        PkgPrint("{\"schema_version\":1,\"stability\":\"stable-id\",\"features\":[", false)
        index: s32 = 0
        while index < cast(s32)items.count {
            if index != 0 { PkgPrint(",", false) }
            PkgPrintFeature(items[index], true)
            index += 1
        }
        PkgPrint("]}\n", false)
        return
    }
    index: s32 = 0
    while index < cast(s32)items.count {
        item: PkgFeature = items[index]
        PkgPrint("id: ", false)
        PkgPrint(item.id, false)
        PkgPrint("\nstatus: ", false)
        PkgPrint(item.status, false)
        PkgPrint("\nsyntax: ", false)
        PkgPrint(item.syntax, false)
        PkgPrint("\nlimits: ", false)
        PkgPrint(item.limits, false)
        PkgPrint("\ntargets:", false)
        target_index: s32 = 0
        while target_index < cast(s32)item.targets.count {
            target: PkgTargetSupport = item.targets[target_index]
            PkgPrint(" ", false)
            PkgPrint(target.target, false)
            PkgPrint("=", false)
            PkgPrint(target.status, false)
            target_index += 1
        }
        PkgPrint("\nevidence:", false)
        PkgPrint(item.evidence, false)
        PkgPrint("\naccepted example:\n", false)
        PkgPrint(item.accepted_example, false)
        PkgPrint("rejected example:\n", false)
        PkgPrint(item.rejected_example, false)
        PkgPrint("rejection: ", false)
        PkgPrint(item.rejection, false)
        PkgPrint("\n\n", false)
        index += 1
    }
}

#scope_export
Features :: (arguments: []string) -> s32 {
    numeric_targets: [7]PkgTargetSupport = .[
    .{target = "c", status = "supported", limit = ""},
    .{target = "cpp", status = "supported", limit = ""},
    .{target = "go", status = "supported", limit = ""},
    .{target = "rust", status = "supported", limit = ""},
    .{target = "py", status = "supported", limit = ""},
    .{target = "zib", status = "supported", limit = ""},
    .{target = "plan9-c", status = "experimental", limit = "Not covered by the numeric differential matrix."}
    ]
    record_targets: [7]PkgTargetSupport = .[
    .{target = "c", status = "supported", limit = ""},
    .{target = "cpp", status = "supported", limit = ""},
    .{target = "go", status = "supported", limit = ""},
    .{target = "rust", status = "supported", limit = ""},
    .{target = "py", status = "supported", limit = ""},
    .{target = "zib", status = "supported", limit = ""},
    .{target = "plan9-c", status = "experimental", limit = "Not covered by the aggregate-ownership differential matrix."}
    ]
    view_targets: [7]PkgTargetSupport = .[
    .{target = "c", status = "supported", limit = "Mutable backing bytes are observed as a borrow."},
    .{target = "cpp", status = "supported", limit = "Mutable backing bytes are observed as a borrow."},
    .{target = "go", status = "supported", limit = "Mutable backing bytes are snapshotted."},
    .{target = "rust", status = "supported", limit = "Mutable backing bytes are observed as a borrow."},
    .{target = "py", status = "supported", limit = "Mutable backing bytes are snapshotted."},
    .{target = "zib", status = "supported", limit = "Mutable backing bytes are snapshotted."},
    .{target = "plan9-c", status = "experimental", limit = "Borrow behavior is inherited from the C post-pass and is not covered by the differential matrix."}
    ]
    module_targets: [7]PkgTargetSupport = .[
    .{target = "c", status = "supported", limit = ""},
    .{target = "cpp", status = "supported", limit = ""},
    .{target = "go", status = "supported", limit = ""},
    .{target = "rust", status = "supported", limit = ""},
    .{target = "py", status = "supported", limit = ""},
    .{target = "zib", status = "supported", limit = ""},
    .{target = "plan9-c", status = "experimental", limit = "Named imports are inherited from the C post-pass and are not covered by the multi-target differential matrix."}
    ]
    print_targets: [7]PkgTargetSupport = .[
    .{target = "c", status = "supported", limit = ""},
    .{target = "cpp", status = "supported", limit = ""},
    .{target = "go", status = "supported", limit = ""},
    .{target = "rust", status = "supported", limit = ""},
    .{target = "py", status = "supported", limit = ""},
    .{target = "zib", status = "supported", limit = ""},
    .{target = "plan9-c", status = "supported", limit = "tests/print.sh builds it with plan9port when installed, otherwise through a host libc shim."}
    ]
    assert_targets: [7]PkgTargetSupport = .[
    .{target = "c", status = "supported", limit = ""},
    .{target = "cpp", status = "supported", limit = ""},
    .{target = "go", status = "supported", limit = ""},
    .{target = "rust", status = "supported", limit = "Checked before native output."},
    .{target = "py", status = "supported", limit = "Checked before native output."},
    .{target = "zib", status = "supported", limit = ""},
    .{target = "plan9-c", status = "supported", limit = "Checked before native output."}
    ]
    base_features: [5]PkgFeature = .[
    .{
        id = "compile.assertions",
        status = "implemented",
        syntax = "#assert CONSTANT_EXPRESSION",
        limits = "The condition must be compile-time constant and effect-free.",
        accepted_example = "VALUE :: #run 41 + 1\n#assert VALUE == 42\n#program_export\nAnswer :: () -> s32 { return VALUE }\n",
        rejected_example = "#assert 0\n#program_export\nAnswer :: () -> s32 { return 0 }\n",
        rejection = "A false compile-time assertion fails checking.",
        evidence = "tests/compile_run.sh\ntests/compile_time.sh\ncheck.assert\n",
        targets = assert_targets
    },
    .{
        id = "modules.named-imports",
        status = "implemented",
        syntax = "Alias :: #import \"module\" and explicit Alias.symbol access",
        limits = "The alias exposes public declarations; it does not re-export a dependency's private names or make every transitive import visible.",
        accepted_example = "Text :: #import \"text\";\n#program_export\nAnswer :: () -> s32 {\n    if Text.LowerASCII(cast(u8)65) != cast(u8)97 { return 1 }\n    return 0\n}\n",
        rejected_example = "Text :: #import <text>;\nAnswer :: () -> s32 { return 0 }\n",
        rejection = "Jai imports require a quoted module or file name.",
        evidence = "tests/module_paths.sh\ntests/named_imports.sh\nparse.syntax\n",
        targets = module_targets
    },
    .{
        id = "numeric.integer-width-conformance",
        status = "implemented",
        syntax = "s8, u8, s16, u16, s32, u32, s64, u64, float32, float64, and cast(T) expressions",
        limits = "The stable differential matrix covers the published IDs below; broader operator and mixed-width combinations remain to be added.",
        accepted_example = "#program_export\nAnswer :: () -> s32 {\n    value: s32 = 2147483647\n    return value + 1\n}\n",
        rejected_example = "Answer :: () -> f64 { return 1.0 }\n",
        rejection = "Legacy f64 spelling is rejected; write float64.",
        evidence = "tests/numeric_semantics.sh\ntests/numeric_conformance.json\nnumeric.wrap.add.s32\n",
        targets = numeric_targets
    },
    .{
        id = "ownership.local-text-view-mutation-check",
        status = "implemented",
        syntax = "TextView(bytes[:]) and lexical release at view scope close",
        limits = "Unknown heap aliases and host-backed views still need a complete lifetime model. Native and portable targets disagree when checked mutation restrictions are bypassed.",
        accepted_example = "Check :: () -> s32 {\n    bytes: [1]u8 = .[97]\n    {\n        text := TextView(bytes[:])\n        if text.count != 1 { return 1 }\n    }\n    bytes[0] = cast(u8)98\n    return cast(s32)bytes[0]\n}\n",
        rejected_example = "Check :: () -> s32 {\n    bytes: [1]u8\n    text := TextView(bytes[:])\n    bytes[0] = cast(u8)98\n    return cast(s32)text[0]\n}\n",
        rejection = "Mutable backing storage cannot be changed while a view of it is live.",
        evidence = "tests/text_view_mutation.sh\ntests/aggregate_view_lifetime.sh\ntests/rust_backend.sh\ntests/py_backend.sh\ntests/capabilities.sh\n",
        targets = view_targets
    },
    .{
        id = "ownership.record-vec-field-move",
        status = "implemented",
        syntax = "record.field Vec moves from local aggregate paths",
        limits = "Indexed fields, pointer-backed fields, global storage, and repeated moves in one expression remain rejected.",
        accepted_example = "#import \"vec\"\nInner :: struct { items: Vec(s32); other: Vec(s32); }\nCheck :: () -> s32 {\n    value: Inner\n    VecPush(value.items, 1)\n    VecPush(value.other, 2)\n    moved := value.items\n    return moved[0] + value.other[0]\n}\n",
        rejected_example = "#import \"vec\"\nInner :: struct { items: Vec(s32); }\nBox :: struct { inners: [2]Inner; }\nCheck :: () -> s32 {\n    value: Box\n    VecPush(value.inners[0].items, 1)\n    moved := value.inners[0].items\n    return moved[0]\n}\n",
        rejection = "Indexed aggregate fields do not yet have a precise per-element ownership transfer.",
        evidence = "tests/aggregate_vec_safety.sh\ntests/vec_move_expression.sh\ntests/rust_backend.sh\ntests/py_backend.sh\ntests/capabilities.sh\n",
        targets = record_targets
    },
    ]
    print_accepted: string = "#program_export\nAnswer :: () -> s32 {\n    print(\"count=% percent=%%\\n\", 3)\n    return 0\n}\n"
    print_rejected: string = "#program_export\nAnswer :: () -> s32 {\n    format := \"count=%\\n\"\n    print(format, 3)\n    return 0\n}\n"
    output_feature: PkgFeature
    output_feature.id = "io.print"
    output_feature.status = "implemented"
    output_feature.syntax = "print(LITERAL_FORMAT, arguments...)"
    output_feature.limits = "The format must be a string literal. Each % consumes one integer, float, bool, string, enum, record, or fixed-array argument; an enum prints as its member name and a record as {x = 1, y = 2}, with strings quoted, fixed arrays up to 16 elements, and Vecs and slices by count; %% prints one percent. Arguments are evaluated left to right before output, and floats use the shortest decimal that round-trips to the same value."
    output_feature.accepted_example = print_accepted
    output_feature.rejected_example = print_rejected
    output_feature.rejection = "print requires a string literal format."
    output_feature.evidence = "tests/print.sh\ntests/print_enums.sh\n"
    output_feature.targets = print_targets
    law_feature: PkgFeature
    law_feature.id = "compile.laws"
    law_feature.status = "implemented"
    law_feature.syntax = "#law NAME theorem bindings => condition; #proof NAME { steps; }"
    law_feature.limits = "The kernel checks booleans, fixed-width modular integers, enum equality, and acyclic pure scalar procedures. Unsupported code and exhausted budgets are unknown. custom checks one example; forall checks a finite domain."
    law_feature.accepted_example = "#law Zero theorem x: s32 => x + 0 == x;\n#proof Zero { ring; }\n#program_export\nAnswer :: () -> s32 { return 42 }\n"
    law_feature.rejected_example = "#law False theorem x: s32 => x + 1 == x;\n#proof False { ring; }\n#program_export\nAnswer :: () -> s32 { return 0 }\n"
    law_feature.rejection = "An invalid certificate fails checking and cannot be waived."
    law_feature.evidence = "tests/laws.sh\ntests/proofs.sh\ntests/law_integers.sh\nproofs/Scalar.lean\n"
    law_feature.targets = assert_targets
    widening_feature: PkgFeature
    widening_feature.id = "numeric.implicit-widening"
    widening_feature.status = "implemented"
    widening_feature.syntax = "a narrower value where a wider type is expected, or mixed in a binary operator"
    widening_feature.limits = "Only lossless conversions are implicit: a wider integer of the same signedness, an unsigned integer in a wider signed type, and float32 in float64. The checker inserts an explicit cast, so every target sees the same conversion."
    widening_feature.accepted_example = "#program_export\nAnswer :: () -> s64 {\n    small: s32 = 40\n    big: s64 = small\n    return big + small\n}\n"
    widening_feature.rejected_example = "Narrow :: (x: s64) -> s32 { return x }\n"
    widening_feature.rejection = "Narrowing, sign changes, and integer-to-float conversions need an explicit cast."
    widening_feature.evidence = "tests/implicit_widening.sh\n"
    widening_feature.targets = numeric_targets
    contract_targets: [7]PkgTargetSupport = .[
        .{target = "c", status = "supported", limit = ""},
        .{target = "cpp", status = "supported", limit = ""},
        .{target = "go", status = "supported", limit = ""},
        .{target = "rust", status = "supported", limit = ""},
        .{target = "py", status = "supported", limit = ""},
        .{target = "zib", status = "supported", limit = ""},
        .{target = "plan9-c", status = "experimental", limit = "Not covered by these source/saved IR differential tests."},
    ]
    parallel_targets: [7]PkgTargetSupport = .[
        .{target = "c", status = "supported", limit = "Forward CPU regions execute on threads."},
        .{target = "cpp", status = "supported", limit = "Forward CPU regions execute on threads."},
        .{target = "go", status = "supported", limit = "CPU regions execute serially with a downgrade marker."},
        .{target = "rust", status = "supported", limit = "CPU regions execute serially with a downgrade marker."},
        .{target = "py", status = "supported", limit = "CPU regions execute serially with a downgrade marker."},
        .{target = "zib", status = "supported", limit = "CPU regions execute serially with a downgrade marker."},
        .{target = "plan9-c", status = "experimental", limit = "CPU regions execute serially with a downgrade marker."},
    ]
    gpu_targets: [7]PkgTargetSupport = .[
        .{target = "c", status = "supported", limit = "CPU fallback only; no GPU device backend."},
        .{target = "cpp", status = "supported", limit = "CPU fallback only; no GPU device backend."},
        .{target = "go", status = "supported", limit = "CPU fallback only; no GPU device backend."},
        .{target = "rust", status = "supported", limit = "CPU fallback only; no GPU device backend."},
        .{target = "py", status = "supported", limit = "CPU fallback only; no GPU device backend."},
        .{target = "zib", status = "supported", limit = "CPU fallback only; no GPU device backend."},
        .{target = "plan9-c", status = "experimental", limit = "CPU fallback only; no GPU device backend."},
    ]
    contracts: [7]PkgFeature = .[
        .{
            id = "compile.run",
            syntax = "#run PURE_EXPRESSION",
            limits = "Compile-time execution is bounded and effect-free. Supported scalars, strings, records, and arrays can be evaluated; general metaprogramming and runtime effects remain unsupported.",
            accepted_example = "Double :: (value: s64) -> s64 { return value * 2 }\nVALUE :: #run Double(21);\n#program_export\nAnswer :: () -> s64 { return VALUE }\n",
            rejected_example = "counter: s64;\nTouch :: () -> s64 { counter += 1; return counter }\nVALUE :: #run Touch();\n",
            rejection = "Compile-time calls cannot mutate runtime storage.",
            evidence = "tests/compile_run.sh\ntests/compile_values.sh\n",
            status = "implemented",
            targets = assert_targets
        },
        .{
            id = "execution.cpu-parallel",
            syntax = "#parallel for RANGE { BODY }",
            limits = "Forward regions use CPU threads on C/C++. Other targets and reverse regions run serially with a downgrade marker. Iterations may write only iteration-local storage; reductions and nested regions are unsupported.",
            accepted_example = "Square :: (value: s64) -> s64 { return value * value }\n#program_export\nAnswer :: () -> s64 {\n    #parallel for 0..3 {\n        local := Square(it)\n    }\n    return 42\n}\n",
            rejected_example = "shared: s64;\nAnswer :: () {\n    #parallel for 0..3 {\n        shared += it\n    }\n}\n",
            rejection = "Parallel iterations cannot mutate shared storage.",
            evidence = "tests/parallel.sh\n",
            status = "implemented",
            targets = parallel_targets
        },
        .{
            id = "execution.gpu-fallback",
            syntax = "#parallel_gpu for RANGE { BODY }",
            limits = "GPU-safe regions are checked, but execute on the CPU with an explicit downgrade marker. No GPU device backend exists. Pointer storage, pointer-bearing calls, and allocator-backed Vec mutation are rejected.",
            accepted_example = "Square :: (value: s64) -> s64 { return value * value }\n#program_export\nAnswer :: () -> s64 {\n    #parallel_gpu for 0..3 {\n        local := Square(it)\n    }\n    return 42\n}\n",
            rejected_example = "shared: s64;\nAnswer :: () {\n    #parallel_gpu for 0..3 {\n        shared += it\n    }\n}\n",
            rejection = "GPU fallback retains the checked parallel-region effect rules.",
            evidence = "tests/gpu.sh\ntests/capabilities.sh\n",
            status = "implemented",
            targets = gpu_targets
        },
        .{
            id = "memory.heap-allocation",
            syntax = "New(T) and free(pointer)",
            limits = "New allocates a zeroed value and free ignores null. Types holding owned Vec storage are rejected. Native callers must release allocations once and preserve pointer lifetimes; Python and the portable VM reject direct reads after free and double frees.",
            accepted_example = "#program_export\nAnswer :: () -> s32 {\n    pointer := New(s32)\n    if <<pointer != 0 { return 1 }\n    <<pointer = 42\n    value := <<pointer\n    free(pointer)\n    return value\n}\n",
            rejected_example = "#import \"vec\"\nHolder :: struct { items: Vec(s32); }\nAnswer :: () { pointer := New(Holder); free(pointer) }\n",
            rejection = "Heap allocation cannot bypass owned Vec cleanup.",
            evidence = "tests/heap_new.sh\n",
            status = "implemented",
            targets = contract_targets
        },
        .{
            id = "ownership.automatic-vec-cleanup",
            syntax = "Vec(T) scope cleanup and moves",
            limits = "Locals, parameters, and Vec fields in records/fixed arrays are dropped on scope exit. Moves invalidate their source. Globals are shared storage; indexed and pointer-backed field moves still have restrictions.",
            accepted_example = "#import \"vec\"\n#program_export\nAnswer :: () -> s32 {\n    values: Vec(s32)\n    VecPush(values, 42)\n    return values[0]\n}\n",
            rejected_example = "#import \"vec\"\nAnswer :: () -> s32 {\n    values: Vec(s32)\n    VecPush(values, 42)\n    moved := values\n    return values[0]\n}\n",
            rejection = "Owned values cannot be read after moving.",
            evidence = "tests/vec.sh\ntests/vec_move_expression.sh\ntests/aggregate_vec_safety.sh\n",
            status = "implemented",
            targets = contract_targets
        },
        .{
            id = "procedures.defaults",
            syntax = "Procedure :: (value: Type = expression, inferred := expression) -> Result",
            limits = "Named procedures expand omitted defaults in declaration scope. Explicit arguments run before omitted defaults. Defaults on procedure-type parameters remain unsupported; generic defaults retain documented specialization limits.",
            accepted_example = "Offset :: (base: s32 = 40, extra: s32 = 2) -> s32 { return base + extra }\n#program_export\nAnswer :: () -> s32 { return Offset() }\n",
            rejected_example = "Required :: (value: s32) -> s32 { return value }\nAnswer :: () -> s32 { return Required() }\n",
            rejection = "Required parameters without defaults cannot be omitted.",
            evidence = "tests/default_arguments.sh\ntests/default_bounds.sh\n",
            status = "implemented",
            targets = contract_targets
        },
        .{
            id = "procedures.values",
            syntax = "Callback :: #type (value: Type) -> Result; named capture-free procedure values",
            limits = "Named procedures can be passed, stored, returned, and called through checked procedure types. Local procedures cannot capture enclosing locals. Polymorphic procedures as values and defaults on procedure-type parameters remain unsupported; native callback ABI support depends on the target.",
            accepted_example = "Callback :: #type (value: s32) -> s32;\nIncrement :: (value: s32) -> s32 { return value + 1 }\nApply :: (callback: Callback) -> s32 { return callback(41) }\n#program_export\nAnswer :: () -> s32 { return Apply(Increment) }\n",
            rejected_example = "Callback :: #type (value: s32) -> s32;\nWrong :: (value: bool) -> s32 { return 0 }\nApply :: (callback: Callback) -> s32 { return callback(41) }\nAnswer :: () -> s32 { return Apply(Wrong) }\n",
            rejection = "Procedure values must match their checked parameter and result signature.",
            evidence = "tests/slots.sh\ntests/stored_slots.sh\ntests/slot_field_values.sh\n",
            status = "implemented",
            targets = contract_targets
        },
    ]
    features: [15]PkgFeature = .[
        base_features[0], law_feature, contracts[0], contracts[1], contracts[2],
        output_feature, contracts[3], base_features[1], widening_feature,
        base_features[2], contracts[4], base_features[3], base_features[4],
        contracts[5], contracts[6]
    ]

    json: bool = false
    id: string = ""
    positional: s32 = 0
    index: s32 = 0
    while index < cast(s32)arguments.count {
        part: string = arguments[index]
        if part == "--json" { json = true }
        else if part == "--id" {
            index += 1
            if index >= cast(s32)arguments.count || arguments[index].count == 0 {
                return PkgFail("usage: ziran features [--json] [--id FEATURE_ID]")
            }
            if id.count != 0 {
                return PkgFail("features accepts one ID")
            }
            id = arguments[index]
        } else {
            if positional != 0 || id.count != 0 {
                return PkgFail("usage: ziran features [--json] [--id FEATURE_ID]")
            }
            id = part
            positional += 1
        }
        index += 1
    }
    if positional != 0 && id.count == 0 {
        return PkgFail("usage: ziran features [--json] [--id FEATURE_ID]")
    }
    if id.count == 0 {
        PkgPrintFeatureList(features[:], json)
        return 0
    }
    selected: s32 = -1
    index = 0
    while index < cast(s32)features.count {
        if features[index].id == id { selected = index; break }
        index += 1
    }
    if selected < 0 {
        return PkgFail(PkgJoin3("unknown feature ID: ", id,
            "\nRun ziran features for known IDs."))
    }
    if json {
        PkgPrint("{\"schema_version\":1,\"stability\":\"stable-id\",\"feature\":", false)
        PkgPrintFeature(features[selected], true)
        PkgPrint("}\n", false)
    } else {
        PkgPrintFeatureList(features[selected:selected + 1], false)
    }
    return 0
}
