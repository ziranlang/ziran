#import "package_common"
#import "file"
#import "file_tree_linux"
#import "sort"

Guide :: (arguments: []string) -> s32 {
    if arguments.count != 0 { return PkgFail("usage: ziran guide") }
    PkgPrint("Ziran guide (this compiler)\n\n", false)
    PkgPrint("Language by example, mistakes from C/Go/Rust/JS, std signatures:\n", false)
    PkgPrint("  docs/REFERENCE.md (https://ziran-lang.org/llms.txt).\n", false)
    PkgPrint("  ziran std --list names every standard module and its purpose.\n\n", false)
    PkgPrint("Start a project: ziran new hello, then cd hello && ziran run.\n", false)
    PkgPrint("  ziran new NAME --template lib|OWNER/REPO[:TEMPLATE] picks a template;\n", false)
    PkgPrint("  ziran init --template SOURCE adds one to the current project.\n", false)
    PkgPrint("  In a project, ziran run|build|check|install work on its program.\n\n", false)
    PkgPrint("Edit loop: format, check, run tests, then build each target you ship.\n", false)
    PkgPrint("  ziran fmt src/main.zi\n", false)
    PkgPrint("  ziran check --diagnostics=json --root src src/main.zi\n", false)
    PkgPrint("  ziran test --root tests tests/main_cases.zi runs test programs; exit 0 passes.\n", false)
    PkgPrint("  ziran ir --root src -o build/ir src/main.zi\n", false)
    PkgPrint("  ziran build --target=c --root src -o build/out src/main.zi\n", false)
    PkgPrint("  Replace c with go for the Go target.\n", false)
    PkgPrint("  ziran bundle --root src --entry main:Answer -o build/app.zx src/main.zi\n", false)
    PkgPrint("  ziran run build/app.zx\n", false)
    PkgPrint("  ziran run --target=c scripts/task.zi -- ARGUMENTS runs a cached native script.\n", false)
    PkgPrint("  --no-cache forces compilation.\n", false)
    PkgPrint("  For a ziran.toml project: ziran lock, then ziran check --project --locked.\n\n", false)
    PkgPrint("  ziran features --id compile.assertions --json reports tested syntax.\n\n", false)
    PkgPrint("  ziran capabilities --target=go --json reports target limits.\n\n", false)
    PkgPrint("  ziran api --json --root src src/main.zi lists checked public APIs.\n\n", false)
    PkgPrint("Laws: custom checks one example; forall checks a finite domain.\n", false)
    PkgPrint("  #law AddZero theorem x: s32 => Add(x, 0) == x;\n", false)
    PkgPrint("  #proof AddZero { unfold Add; ring; }\n", false)
    PkgPrint("Keep obligations in LAWS.zi and import them from PROOF.zi;\n", false)
    PkgPrint("  ziran check --root src src/PROOF.zi checks the reachable certificates.\n", false)
    PkgPrint("Scalar proofs support bool, fixed-width integers, enums, and pure acyclic calls.\n", false)
    PkgPrint("Unknown results need an explicit waiver; invalid proofs fail checking.\n", false)
    PkgPrint("See docs/LAWS.md for proof steps and evidence.\n\n", false)
    PkgPrint("  ziran explain check.type explains a diagnostic code.\n", false)
    PkgPrint("  ziran explain --list --json enumerates every registered code.\n\n", false)
    PkgPrint("Source shape:\n", false)
    PkgPrint("  #program_export\n", false)
    PkgPrint("  Answer :: () -> s32 {\n", false)
    PkgPrint("      value: s32 = 42\n", false)
    PkgPrint("      return value\n", false)
    PkgPrint("  }\n\n", false)
    PkgPrint("Declarations use name: Type, inferred locals use name :", false)
    PkgPrint("= expression,\n", false)
    PkgPrint("and procedures use Name :: (name: Type) -> ReturnType { ... }.\n", false)
    PkgPrint("Common types: bool, s8/s16/s32/s64, u8/u16/u32/u64,\n", false)
    PkgPrint("float32/float64, string, [N]T arrays, []T slices, *T pointers.\n", false)
    PkgPrint("Use #import \"module\" for modules; std/vec.zi supplies Vec(T).\n", false)
    PkgPrint("Project dependencies are Git repositories: ziran add URL, then\n", false)
    PkgPrint("#import \"NAME/Module\" (ziran pkg list shows them) and #import \"std/text\".\n\n", false)
    PkgPrint("Current boundaries:\n", false)
    PkgPrint("  C, Go, and portable .zx are output paths.\n", false)
    PkgPrint("  Direct owned Vec locals and parameters drop at scope exit.\n", false)
    PkgPrint("  Aggregates containing Vec cannot be copied, passed, or returned.\n", false)
    PkgPrint("  TextView of mutable backing bytes has target-dependent aliasing.\n", false)
    PkgPrint("  GPU selections report an explicit device Gap.\n\n", false)
    PkgPrint("See docs/IMPLEMENTATION_STATUS.md and docs/OWNED_VALUES.md for details.\n", false)
    return 0
}

// ziran std --list [--json]: every standard module with the first sentence
// of its leading comment, read from the std folder this toolchain uses.
StdModules :: (launcher: string, arguments: []string) -> s32 {
    json := false
    listed := false
    for argument: arguments {
        if argument == "--json" { json = true }
        else if argument == "--list" { listed = true }
        else { return PkgFail("usage: ziran std --list [--json]") }
    }
    if !listed { return PkgFail("usage: ziran std --list [--json]") }
    directory := StdDirectory(launcher)
    if directory.count == 0 { return PkgFail("cannot find the standard library; set ZIRAN_STD") }
    names: Vec(string)
    if !ListDirectory(directory, *names) { return PkgFail(PkgJoin("cannot list ", directory)) }
    modules: Vec(string)
    for name: names {
        if PkgEndsWith(name, ".zi") { VecPush(modules, name[0:name.count - 3]) }
    }
    SortText(modules[:])
    if json { PkgPrint("{\"schema_version\":1,\"modules\":[", false) }
    for module, index: modules {
        text, ok := ReadEntireFile(PkgJoin(PkgJoin(directory, "/"), PkgJoin(module, ".zi")))
        purpose := ifx ok then ModulePurpose(directory, text) else ""
        if json {
            if index > 0 { PkgPrint(",", false) }
            PkgPrint("{\"name\":", false); PkgJsonString(PkgJoin("std/", module))
            PkgPrint(",\"purpose\":", false); PkgJsonString(purpose)
            PkgPrint("}", false)
        } else {
            line: Vec(u8)
            BuilderPrint(*line, "std/%", module)
            while line.count < 28 { BuilderAppend(line, " ") }
            BuilderPrint(*line, "%\n", purpose)
            PkgPrint(BuilderFinish(line), false)
        }
    }
    if json { PkgPrint("]}\n", false) }
    return 0
}

#scope_file
// ZIRAN_STD, or std beside the build directory holding this launcher, as
// `make` and `make install-user` lay it out.
StdDirectory :: (launcher: string) -> string {
    configured := PkgGetenv("ZIRAN_STD")
    if configured.count > 0 { return configured }
    binaries := PkgLauncherDirectory(launcher)
    candidates := string.["/../../std", "/../../../std", "/../std"]
    for candidate: candidates {
        directory := PkgJoin(binaries, candidate)
        if DirectoryExists(directory) { return directory }
    }
    return ""
}

// A module's summary: the first sentence of its leading comment, past any
// imports; for a module that only forwards to a platform module, that
// module's summary; else the names it declares.
ModulePurpose :: (directory: string, text: string) -> string {
    out: Vec(u8)
    forward := ""
    at: s64 = 0
    while at < text.count {
        end := at
        while end < text.count && text[end] != #char "\n" { end += 1 }
        line := text[at:end]
        at = end + 1
        if line.count >= 2 && line[0] == #char "/" && line[1] == #char "/" {
            words := ifx line.count > 2 && line[2] == #char " " then line[3:] else line[2:]
            if out.count > 0 { BuilderAppend(out, " ") }
            stop := SentenceEnd(words)
            if stop >= 0 {
                BuilderAppend(out, words[0:stop + 1])
                return BuilderFinish(out)
            }
            BuilderAppend(out, words)
            continue
        }
        if out.count > 0 { break }
        if line.count == 0 || line[0] == #char "#" { continue }
        if TextAfter(line, "using Platform :: #import \"") != "" { forward = TextAfter(line, "using Platform :: #import \""); continue }
        if PkgContains(line, "#import") || PkgContains(line, "#system_library") || PkgContains(line, "#load") { continue }
        break
    }
    if out.count > 0 { return BuilderFinish(out) }
    if forward != "" {
        name := forward[0:PkgIndexOf(forward, "\"")]
        target, ok := ReadEntireFile(PkgJoin(PkgJoin(directory, "/"), PkgJoin(name, ".zi")))
        purpose := ifx ok then ModulePurpose(directory, target) else ""
        line: Vec(u8)
        BuilderPrint(*line, "This platform's std/%", name)
        if purpose != "" { BuilderPrint(*line, ": %", purpose) } else { BuilderAppend(line, ".") }
        return BuilderFinish(line)
    }
    return DeclaredNames(text)
}

// "Declares A, B and C." from the first public declarations in TEXT.
DeclaredNames :: (text: string) -> string {
    names: [4]string
    count: s64 = 0
    at: s64 = 0
    private := false
    while at < text.count && count < 4 {
        end := at
        while end < text.count && text[end] != #char "\n" { end += 1 }
        line := text[at:end]
        at = end + 1
        // Platform branches indent their declarations once.
        indent: s64 = 0
        while indent < 4 && indent < line.count && line[indent] == #char " " { indent += 1 }
        line = line[indent:]
        if PkgStartsWithText(line, "#scope_file") { private = true }
        if PkgStartsWithText(line, "#scope_export") { private = false }
        if private || line.count == 0 || line[0] < #char "A" || line[0] > #char "Z" { continue }
        colons := PkgIndexOf(line, " ::")
        if colons <= 0 { continue }
        name := line[0:colons]
        repeated := false
        for known: names[0:count] { repeated = repeated || known == name }
        if !repeated { names[count] = name; count += 1 }
    }
    if count == 0 { return "" }
    out: Vec(u8)
    BuilderAppend(out, "Declares ")
    for name, index: names[0:count] {
        if index > 0 { BuilderAppend(out, ifx index == count - 1 then " and " else ", ") }
        BuilderAppend(out, name)
    }
    BuilderAppend(out, ".")
    return BuilderFinish(out)
}

// The text after PREFIX when LINE starts with it, else "".
TextAfter :: (line: string, prefix: string) -> string {
    if line.count < prefix.count || line[0:prefix.count] != prefix { return "" }
    return line[prefix.count:]
}

PkgStartsWithText :: (line: string, prefix: string) -> bool { return TextAfter(line, prefix).count > 0 || line == prefix }

PkgIndexOf :: (text: string, needle: string) -> s64 {
    if needle.count > text.count { return -1 }
    for at: 0..text.count - needle.count {
        if text[at:at + needle.count] == needle { return at }
    }
    return -1
}

PkgContains :: (text: string, needle: string) -> bool { return PkgIndexOf(text, needle) >= 0 }

// The index of the period that ends the first sentence in TEXT, or -1.
SentenceEnd :: (text: string) -> s64 {
    for index: 0..text.count - 1 {
        if text[index] == #char "." && (index + 1 == text.count || text[index + 1] == #char " ") { return index }
    }
    return -1
}
