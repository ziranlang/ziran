#import "package_common"

Guide :: (arguments: []string) -> s32 {
    if arguments.count != 0 { return PkgFail("usage: ziran guide") }
    PkgPrint("Ziran guide (this compiler)\n\n", false)
    PkgPrint("Edit loop: format, check, run tests, then build each target you ship.\n", false)
    PkgPrint("  ziran fmt src/main.zi\n", false)
    PkgPrint("  ziran check --diagnostics=json --root src src/main.zi\n", false)
    PkgPrint("  ziran ir --root src -o build/ir src/main.zi\n", false)
    PkgPrint("  ziran build --target=c --root src -o build/out src/main.zi\n", false)
    PkgPrint("  Replace c with cpp, go, rust, or plan9-c for those targets.\n", false)
    PkgPrint("  ziran bundle --root src --entry main:Answer -o build/app.zib src/main.zi\n", false)
    PkgPrint("  ziran run build/app.zib\n", false)
    PkgPrint("  For a ziran.toml project: ziran lock, then ziran check --project --locked.\n\n", false)
    PkgPrint("  ziran features --id compile.assertions --json reports tested syntax.\n\n", false)
    PkgPrint("  ziran capabilities --target=go --json reports target limits.\n\n", false)
    PkgPrint("  ziran api --json --root src src/main.zi lists checked public APIs.\n\n", false)
    PkgPrint("  ziran explain check.type explains a diagnostic code.\n", false)
    PkgPrint("  ziran explain --list --json enumerates every registered code.\n\n", false)
    PkgPrint("Source shape:\n", false)
    PkgPrint("  #program_export\n", false)
    PkgPrint("  Answer :: () -> s32 {\n", false)
    PkgPrint("      value: s32 = 42\n", false)
    PkgPrint("      return value\n", false)
    PkgPrint("  }\n\n", false)
    PkgPrint("Declarations use name: Type, inferred locals use name :", false)
    PkgPrint("= expression,\n", false)
    PkgPrint("and procedures use Name :: (name: Type) -> ReturnType { ... }.\n", false)
    PkgPrint("Common types: bool, s8/s16/s32/s64, u8/u16/u32/u64,\n", false)
    PkgPrint("float32/float64, string, [N]T arrays, []T slices, *T pointers.\n", false)
    PkgPrint("Use #import \"module\" for modules; std/vec.zi supplies Vec(T).\n\n", false)
    PkgPrint("Current boundaries:\n", false)
    PkgPrint("  C, C++, Go, experimental Rust, portable .zib, and experimental plan9-c are output paths.\n", false)
    PkgPrint("  Direct owned Vec locals and parameters drop at scope exit.\n", false)
    PkgPrint("  Aggregates containing Vec cannot be copied, passed, or returned.\n", false)
    PkgPrint("  TextView of mutable backing bytes has target-dependent aliasing.\n", false)
    PkgPrint("  GPU annotations currently use a CPU fallback.\n\n", false)
    PkgPrint("See docs/IMPLEMENTATION_STATUS.md and docs/OWNED_VALUES.md for details.\n", false)
    return 0
}
