// Offline promotion of C-teacher proposals. The input is evidence, never code:
// only closed, independently tested rule families can enter the source table.
#import "package_common"
#import "compiler_learning_policy"
#import "compiler_learning_fixture"
#import "std/json_document"
#import "std/process_run_linux"
#import "std/text_tools"
#import "std/vec"

#scope_file
USAGE :: "usage: ziran learn verify --candidates FILE --repo DIR --output FILE";
Field :: (document: *JsonDocument, node: s32, name: string) -> string {
    return TextDetach(JsonString(document, JsonMember(document, node, name)))
}
DigestFile :: (path: string) -> string {
    file := PkgReadLimited(path, 268435456)
    return ifx file.valid then PkgDigest(file.text) else ""
}
Identity :: (tools: string) -> string {
    names := string.["ziran", "zi2c", "zi2zx", "zx2native"]
    text: Vec(u8)
    for name: names {
        digest := DigestFile(PkgJoin3(tools, "/", name))
        if digest.count != 64 { return "" }
        BuilderAppend(text, digest)
    }
    return PkgDigest(BuilderFinish(text))
}
Run :: (arguments: []string, repo: string) -> PkgProcessResult {
    names := string.["ZIRAN_LEARN", "DISPLAY", "WAYLAND_DISPLAY"]
    values := string.["off", "", ""]
    return PkgCaptureEnv(arguments, repo, names[:], values[:])
}
Succeeded :: (arguments: []string, repo: string) -> bool {
    result := Run(arguments, repo)
    if result.code == 0 { return true }
    PkgPrint(PkgJoin3("learning verification failed: ", result.text, "\n"), true)
    return false
}
RunFixture :: (executable: string, repo: string, output: string) -> bool {
    command := string.["build-queue", "--", executable]
    environment := string.["ZIRAN_LEARN=off", "DISPLAY", "WAYLAND_DISPLAY"]
    options := ProcessOptions.{arguments = command[:], directory = repo,
        environment = environment[:], output_path = output, merge_error = true}
    run: ProcessRun
    return RunProcess(options, *run) && run.code == 0
}

// Canonical order and fixed text make output independent of proposal ordering,
// wall time, corpus traversal, environment and the location of this checkout.
LearnTeacherTable :: (power: bool, scaled: bool, evidence: string, fixture: string) -> string {
    parts := string.["// Generated by ziran learn verify; review and check in before use.\n",
        "// Preconditions: integer modulo width, dead flags, no memory effects.\n",
        "LearningTableVersion :: 1\nLearningVerifierVersion :: 1\nLearningTableTarget :: \"x86_64\"\n",
        PkgJoin3("LearningTableEvidence :: \"", evidence, "\"\n"),
        PkgJoin3("LearningTableFixture :: \"", fixture, "\"\n"),
        PkgJoin3("LearningMultiplyPower :: ", ifx power then "1" else "0", "\n"),
        PkgJoin3("LearningMultiplyScaledAdd :: ", ifx scaled then "1" else "0", "\n"),
        "LearningLeafOperations :: 0\nLearningUnrollFactor :: 1\nLearningBlockLayout :: 1\nLearningAllocation :: 0\n"]
    return TextDetach(TextJoin(parts[:], ""))
}

#scope_export
LearnTeacher :: (arguments: []string, launcher: string) -> s32 {
    candidates: string; repo: string; output: string
    index: s64 = 1
    while index < cast(s64)arguments.count {
        if index + 1 >= cast(s64)arguments.count { return PkgFail(USAGE) }
        flag := arguments[index]; value := arguments[index + 1]
        if flag == "--candidates" && candidates.count == 0 { candidates = value }
        else if flag == "--repo" && repo.count == 0 { repo = value }
        else if flag == "--output" && output.count == 0 { output = value }
        else { return PkgFail(USAGE) }
        index += 2
    }
    if candidates.count == 0 || repo.count == 0 || output.count == 0 { return PkgFail(USAGE) }
    read := PkgReadLimited(candidates, 16777216)
    document: JsonDocument
    defer JsonReset(*document)
    if !read.valid || !JsonRead(*document, read.text) { return PkgFail("cannot read teacher proposals") }
    version, valid := JsonInteger(*document, JsonMember(*document, document.root, "schema_version"))
    if !valid || version != 1 { return PkgFail("unsupported teacher proposal schema") }
    artifact_keys := string.["native_sha256", "zx_sha256", "c_sha256"]
    for key: artifact_keys {
        digest := Field(*document, document.root, key)
        if digest.count != 64 { return PkgFail("proposal lacks artifact identity") }
        for byte: digest { if !(byte >= 48 && byte <= 57 || byte >= 97 && byte <= 102) { return PkgFail("invalid artifact digest") } }
    }
    proposals := JsonMember(*document, document.root, "candidates")
    if JsonKindOf(*document, proposals) != .Array || JsonCount(*document, proposals) == 0 { return PkgFail("no teacher proposals") }
    power: bool; scaled: bool
    node := JsonFirst(*document, proposals)
    while node >= 0 {
        factor, known := JsonInteger(*document, JsonMember(*document, node, "factor"))
        rule := LearningRuleForFactor(factor)
        if !known || rule == .None || Field(*document, node, "rule") != "x86-multiply-constant" ||
            Field(*document, node, "precondition") != "integer-modulo-width; flags-dead; no-memory" ||
            Field(*document, node, "native").count == 0 || Field(*document, node, "teacher").count == 0 {
            return PkgFail("unsupported rewrite or precondition; table unchanged")
        }
        if rule == .MultiplyPower { power = true } else { scaled = true }
        node = JsonNext(*document, node)
    }
    if power && !LearningCheckFamily(.MultiplyPower) || scaled && !LearningCheckFamily(.MultiplyScaledAdd) {
        return PkgFail("rewrite semantic preflight disagrees; table unchanged")
    }
    tools := PkgLauncherDirectory(launcher)
    identity := Identity(tools)
    if identity.count == 0 { return PkgFail("cannot identify verifier tools") }
    work := PkgJoin(repo, "/build/learn-teacher")
    if !PkgMkdirs(work) { return PkgFail("cannot create teacher verification directory") }
    source := LearningFixtureSource()
    fixture := PkgJoin(work, "/teacher_fixture.zi")
    reference_directory := PkgJoin(work, "/reference")
    reference := PkgJoin(reference_directory, "/teacher_fixture")
    native := PkgJoin(work, "/native")
    zx := PkgJoin(work, "/fixture.zx")
    std := PkgJoin(repo, "/std")
    if !PkgWriteAtomic(fixture, source) { return PkgFail("cannot write parity fixture") }
    c_command := string.["build-queue", "--", PkgJoin(tools, "/zi2c"), "--exe", "--entry", "teacher_fixture:main", "--root", work,
        "--module-path", std, "-o", reference_directory, fixture]
    zx_command := string.["build-queue", "--", PkgJoin(tools, "/zi2zx"), "--root", work,
        "--module-path", std, "--entry", "teacher_fixture:main", "-o", zx, fixture]
    native_command := string.["build-queue", "--", PkgJoin(tools, "/zx2native"), "-o", native, zx]
    if !Succeeded(c_command[:], repo) || !Succeeded(zx_command[:], repo) || !Succeeded(native_command[:], repo) { return 1 }
    c_output := PkgJoin(work, "/reference.stdout")
    native_output := PkgJoin(work, "/native.stdout")
    if !RunFixture(reference, repo, c_output) || !RunFixture(native, repo, native_output) {
        return PkgFail("C/native differential fixture failed; table unchanged")
    }
    expected := PkgReadLimited(c_output, 16777216)
    actual := PkgReadLimited(native_output, 16777216)
    lines: s64
    for byte: expected.text { if byte == 10 { lines += 1 } }
    if !expected.valid || !actual.valid || lines != 70210 || expected.text != actual.text {
        return PkgFail("C/native disagreement; table unchanged")
    }
    parity := string.["build-queue", "--", "make", "-j1", "check", "CHECK_FILTER=zx_lowered_parity"]
    if !Succeeded(parity[:], repo) { return 1 }
    if Identity(tools) != identity { return PkgFail("verifier compiler changed; table unchanged") }
    table := LearnTeacherTable(power, scaled, PkgDigest(read.text), PkgDigest(source))
    certificate: JsonDocument
    defer JsonReset(*certificate)
    root := JsonNewObject(*certificate)
    JsonSet(*certificate, root, "schema_version", JsonNewInteger(*certificate, 1))
    JsonSet(*certificate, root, "compiler_identity", JsonNewStringCopy(*certificate, identity))
    JsonSet(*certificate, root, "evidence_sha256", JsonNewStringCopy(*certificate, PkgDigest(read.text)))
    JsonSet(*certificate, root, "fixture_sha256", JsonNewStringCopy(*certificate, PkgDigest(source)))
    JsonSet(*certificate, root, "parity_list_sha256", JsonNewStringCopy(*certificate, DigestFile(PkgJoin(repo, "/tests/zx_parity_list.zi"))))
    JsonSet(*certificate, root, "table_sha256", JsonNewStringCopy(*certificate, PkgDigest(table)))
    JsonSet(*certificate, root, "verified", JsonNewBool(*certificate, true))
    if !PkgWriteAtomic(PkgJoin(output, ".verification.json"), TextDetach(JsonWrite(*certificate, root, JsonPythonStyle(2)))) {
        return PkgFail("cannot save verification certificate; table unchanged")
    }
    if !PkgWriteAtomic(output, table) { return PkgFail("cannot save verified source table") }
    PkgPrint("Verified teacher rules: 34 factors, 17 boundary and 2048 random inputs at eight widths, plus retained parity fixtures. Review and check in the deterministic table before rebuilding.\n", false)
    return 0
}
