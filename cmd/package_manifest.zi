#import "package_common"
#import "package_source"
#import "file_linux"
Toml :: #import "toml_document"

#scope_export
PkgNamedValue :: struct {
    name: string
    value: string
}

PkgDependency :: struct {
    alias: string
    git: string
    ref: string
    source: bool
    aliases: [24]PkgNamedValue
    alias_count: s32
}

PkgManifest :: struct {
    name: string
    entry: string
    roots: []string
    root_count: s32
    bridges: [16]string
    bridge_count: s32
    // Folders a project command's --module-path adds to this root package,
    // such as modules a build step writes; never part of ziran.toml.
    generated: []string
    generated_count: s32
    tool_git: string
    tool_ref: string
    project_tool: string
    // [package] tool: the dependency whose project tool runs, builds, checks,
    // and installs this package, such as Kryon for a windowed application.
    tool: string
    install_bin: string
    // [package] links: system libraries a native build links with -l.
    links: [16]string
    link_count: s32
    // [templates] NAME = "DIRECTORY": project templates for ziran new and init.
    templates: [32]PkgNamedValue
    template_count: s32
    // A setting that parses but is no longer accepted, reported by commands
    // that use this manifest as the project.
    problem: string
    dependencies: [24]PkgDependency
    dependency_count: s32
    exports: [4096]PkgNamedValue
    export_count: s32
    valid: bool
}

PkgOverrides :: struct {
    values: [32]PkgNamedValue
    count: s32
    valid: bool
}

PkgNewManifest :: () -> *PkgManifest {
    result := cast(*PkgManifest)(PkgAllocZero(cast(u64)size_of(PkgManifest)))
    if result != null {
        result.roots = PkgStrings(1)
        if result.roots.count != 1 { return null }
    }
    return result
}

PkgNewOverrides :: () -> *PkgOverrides {
    return cast(*PkgOverrides)(PkgAllocZero(cast(u64)size_of(PkgOverrides)))
}

PkgIdentifier :: (value: string) -> bool {
    if value.count == 0 { return false }
    index: s64 = 0
    while index < cast(s64)value.count {
        ch: u8 = value[index]
        if !((ch >= cast(u8)65 && ch <= cast(u8)90) ||
             (ch >= cast(u8)97 && ch <= cast(u8)122) ||
             ch == cast(u8)95 ||
             (index > 0 && ch >= cast(u8)48 && ch <= cast(u8)57)) {
            return false
        }
        index += 1
    }
    return true
}

PkgPackageName :: (value: string) -> bool {
    if value.count == 0 { return false }
    index: s64 = 0
    while index < cast(s64)value.count {
        ch: u8 = value[index]
        if !((ch >= cast(u8)65 && ch <= cast(u8)90) ||
             (ch >= cast(u8)97 && ch <= cast(u8)122) ||
             (ch >= cast(u8)48 && ch <= cast(u8)57) ||
             ch == cast(u8)95 || ch == cast(u8)45) { return false }
        index += 1
    }
    return true
}

// A system linker name, not a package identifier or a compiler option.
// Versioned Unix libraries use dots; C++ library names may also use '+'.
PkgSystemLibraryName :: (value: string) -> bool {
    if value.count == 0 { return false }
    index: s64 = 0
    while index < cast(s64)value.count {
        ch: u8 = value[index]
        if !((ch >= cast(u8)65 && ch <= cast(u8)90) ||
             (ch >= cast(u8)97 && ch <= cast(u8)122) ||
             (ch >= cast(u8)48 && ch <= cast(u8)57) ||
             ch == cast(u8)95 || (index > 0 &&
             (ch == cast(u8)45 || ch == cast(u8)46 || ch == cast(u8)43))) { return false }
        index += 1
    }
    return true
}

// A path inside the package: relative, without empty, '.', or '..' parts.
PkgRelativePath :: (value: string) -> bool {
    if value.count == 0 || value[0] == cast(u8)47 { return false }
    start: s64 = 0
    index: s64 = 0
    while index <= cast(s64)value.count {
        if index == cast(s64)value.count || value[index] == cast(u8)47 {
            part: string = value[start:index]
            if part.count == 0 || part == "." || part == ".." { return false }
            start = index + 1
        }
        index += 1
    }
    return true
}

// Value helpers share the public TOML grammar with the whole manifest reader.
PkgTomlText :: (value: string) -> string {
    document: Toml.TomlDocument
    if !Toml.TomlRead(*document, PkgJoin("value = ", value), 16777216) { return "" }
    return Toml.TomlString(*document, Toml.TomlMember(*document, document.root, "value"))
}

PkgStripComment :: (line: string) -> string {
    quoted: bool = false
    index: s64 = 0
    while index < cast(s64)line.count {
        if line[index] == cast(u8)34 { quoted = !quoted }
        if line[index] == cast(u8)35 && !quoted { return PkgTrim(line[0:index]) }
        index += 1
    }
    return PkgTrim(line)
}

PkgTomlArray :: (raw: string, values: []string) -> s32 {
    document: Toml.TomlDocument
    if !Toml.TomlRead(*document, PkgJoin("value = ", raw), 16777216) { return -1 }
    return PkgStringList(*document, Toml.TomlMember(*document, document.root, "value"), values)
}

PkgStringList :: (document: *Toml.TomlDocument, node: s32, values: []string) -> s32 {
    if Toml.TomlKindOf(document, node) != Toml.TomlKind.Array || Toml.TomlCount(document, node) > values.count { return -1 }
    count: s32 = 0
    child := Toml.TomlFirst(document, node)
    while child >= 0 {
        if Toml.TomlKindOf(document, child) != Toml.TomlKind.String { return -1 }
        values[count] = Toml.TomlString(document, child)
        if values[count].count == 0 { return -1 }
        count += 1
        child = Toml.TomlNext(document, child)
    }
    return count
}

PkgParseManifest :: (path: string, output: *PkgManifest) -> bool {
    output.valid = false
    output.name = ""
    output.tool_git = ""
    output.project_tool = ""
    output.tool = ""
    output.install_bin = ""
    output.problem = ""
    output.bridge_count = 0
    output.link_count = 0
    output.template_count = 0
    output.dependency_count = 0
    output.export_count = 0
    content: PkgReadResult = PkgRead(path)
    if !content.valid { return false }
    document: Toml.TomlDocument
    // Package manifests may contain large export maps; callers of the public
    // parser choose their own bound (the context planner uses its 256 KiB default).
    if !Toml.TomlRead(*document, content.text, 16777216) { return false }
    output.entry = "src/app.zi"
    output.roots = PkgStrings(1)
    if output.roots.count != 1 { return false }
    output.roots[0] = "src"
    output.root_count = 1
    output.tool_ref = "master"
    section := Toml.TomlFirst(*document, document.root)
    while section >= 0 {
        name := Toml.TomlKey(*document, section)
        if (name == "package" || name == "toolchain" || name == "tool" || name == "install" ||
            name == "templates" || name == "exports" || name == "dependencies") &&
            Toml.TomlKindOf(*document, section) != Toml.TomlKind.Table { return false }
        child := Toml.TomlFirst(*document, section)
        while child >= 0 {
            key := Toml.TomlKey(*document, child)
            value := Toml.TomlString(*document, child)
            kind := Toml.TomlKindOf(*document, child)
            if name == "package" {
                if key == "name" || key == "entry" || key == "tool" {
                    if kind != Toml.TomlKind.String { return false }
                    if key == "name" { output.name = value }
                    if key == "entry" { output.entry = value }
                    if key == "tool" {
                        if !PkgIdentifier(value) { return false }
                        output.tool = value
                    }
                }
                if key == "module_roots" {
                    root_count := Toml.TomlCount(*document, child)
                    output.roots = PkgStrings(cast(s64)root_count)
                    if Toml.TomlKindOf(*document, child) != Toml.TomlKind.Array ||
                       output.roots.count != root_count {
                        unused PkgFail("ziran.toml module_roots must be an array of non-empty strings")
                        return false
                    }
                    output.root_count = PkgStringList(*document, child, output.roots)
                    if output.root_count < 0 {
                        unused PkgFail("ziran.toml module_roots must be an array of non-empty strings")
                        return false
                    }
                }
                if key == "bridge_modules" {
                    output.bridge_count = PkgStringList(*document, child, output.bridges[:])
                    if output.bridge_count < 0 { return false }
                }
                if key == "links" {
                    output.link_count = PkgStringList(*document, child, output.links[:])
                    if output.link_count < 0 { return false }
                }
            } else if name == "toolchain" {
                if key == "git" || key == "ref" {
                    if kind != Toml.TomlKind.String { return false }
                    if key == "git" { output.tool_git = value }
                    if key == "ref" { output.tool_ref = value }
                }
            } else if name == "tool" && key == "project" {
                if kind != Toml.TomlKind.String { return false }
                output.project_tool = value
            } else if name == "install" {
                if key == "tool" {
                    output.problem = PkgJoin3("[install] tool moved: write tool = \"", value, "\" under [package]")
                }
                if key == "bin" {
                    if kind != Toml.TomlKind.String { return false }
                    output.install_bin = value
                }
            } else if name == "templates" {
                if output.template_count >= 32 || !PkgPackageName(key) || !PkgRelativePath(value) { return false }
                output.templates[output.template_count].name = key
                output.templates[output.template_count].value = value
                output.template_count += 1
            } else if name == "exports" {
                if output.export_count >= 4096 || !PkgIdentifier(key) || value.count == 0 { return false }
                output.exports[output.export_count].name = key
                output.exports[output.export_count].value = value
                output.export_count += 1
            } else if name == "dependencies" {
                if output.dependency_count >= 24 || !PkgIdentifier(key) || kind != Toml.TomlKind.Table { return false }
                duplicate: s32 = 0
                while duplicate < output.dependency_count {
                    if PkgFoldEqual(output.dependencies[duplicate].alias, key) { return false }
                    duplicate += 1
                }
                dep := *output.dependencies[output.dependency_count]
                dep.alias = key
                dep.git = ""
                dep.ref = "master"
                dep.source = false
                dep.alias_count = 0
                output.dependency_count += 1
                field := Toml.TomlFirst(*document, child)
                while field >= 0 {
                    field_name := Toml.TomlKey(*document, field)
                    if field_name == "git" || field_name == "ref" {
                        if Toml.TomlKindOf(*document, field) != Toml.TomlKind.String { return false }
                        if field_name == "git" { dep.git = Toml.TomlString(*document, field) }
                        if field_name == "ref" { dep.ref = Toml.TomlString(*document, field) }
                    }
                    if field_name == "source" {
                        truth, ok := Toml.TomlBool(*document, field)
                        if !ok { return false }
                        dep.source = truth
                    }
                    if field_name == "module_aliases" {
                        if Toml.TomlKindOf(*document, field) != Toml.TomlKind.Table { return false }
                        alias := Toml.TomlFirst(*document, field)
                        while alias >= 0 {
                            from := Toml.TomlKey(*document, alias)
                            to := Toml.TomlString(*document, alias)
                            if dep.alias_count >= 24 || !PkgIdentifier(from) || !PkgIdentifier(to) { return false }
                            dep.aliases[dep.alias_count].name = from
                            dep.aliases[dep.alias_count].value = to
                            dep.alias_count += 1
                            alias = Toml.TomlNext(*document, alias)
                        }
                    }
                    field = Toml.TomlNext(*document, field)
                }
            }
            child = Toml.TomlNext(*document, child)
        }
        section = Toml.TomlNext(*document, section)
    }
    if !PkgPackageName(output.name) { return false }
    if output.install_bin.count > 0 && !PkgPackageName(output.install_bin) {
        return false
    }
    index: s32 = 0
    while index < output.link_count {
        if !PkgSystemLibraryName(output.links[index]) { return false }
        index += 1
    }
    index = 0
    while index < output.dependency_count {
        if !PkgGitURL(output.dependencies[index].git) ||
            output.dependencies[index].ref.count == 0 ||
            (output.dependencies[index].source &&
                output.dependencies[index].alias_count > 0) { return false }
        index += 1
    }
    output.valid = true
    return true
}

PkgParseOverrides :: (path: string, output: *PkgOverrides) -> bool {
    output.valid = false
    output.count = 0
    if !PathExists(path) { output.valid = true; return true }
    content: PkgReadResult = PkgRead(path)
    if !content.valid { return false }
    document: Toml.TomlDocument
    if !Toml.TomlRead(*document, content.text, 16777216) { return false }
    table := Toml.TomlMember(*document, document.root, "overrides")
    if table >= 0 && Toml.TomlKindOf(*document, table) != Toml.TomlKind.Table { return false }
    child := Toml.TomlFirst(*document, table)
    while child >= 0 {
        key := Toml.TomlKey(*document, child)
        value := Toml.TomlString(*document, child)
        if output.count >= 32 || !PkgIdentifier(key) || value.count == 0 { return false }
        output.values[output.count].name = key
        output.values[output.count].value = value
        output.count += 1
        child = Toml.TomlNext(*document, child)
    }
    output.valid = true
    return true
}

PkgFindOverride :: (overrides: *PkgOverrides, name: string, root: string) -> string {
    index: s32 = 0
    while index < overrides.count {
        if PkgFoldEqual(overrides.values[index].name, name) {
            path: string = overrides.values[index].value
            if path[0] != cast(u8)47 { path = PkgJoin3(root, "/", path) }
            return PkgCanonical(path)
        }
        index += 1
    }
    return ""
}

PkgAliasName :: (dependency: *PkgDependency, exported: string) -> string {
    index: s32 = 0
    while index < dependency.alias_count {
        if dependency.aliases[index].name == exported {
            return PkgJoin("", dependency.aliases[index].value)
        }
        index += 1
    }
    return exported
}
