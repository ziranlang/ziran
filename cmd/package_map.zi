#import "package_common"
#import "package_manifest"
#import "package_lock"
#import "byte_text_linux"

libc :: #system_library "libc";
PkgGraphSizeRaw :: () -> u64 #foreign libc "ziran_package_graph_size";

PkgModule :: struct {
    name: string
    path: string
}

PkgModuleSet :: struct {
    items: [512]PkgModule
    count: s32
}

PkgModuleGraph :: struct {
    sets: [66]PkgModuleSet
}

PkgModuleByPath :: (set: *PkgModuleSet, path: string) -> string {
    index: s32 = 0
    while index < set.count {
        if set.items[index].path == path { return PkgJoin("", set.items[index].name) }
        index += 1
    }
    return ""
}

PkgHasModule :: (set: *PkgModuleSet, name: string) -> bool {
    index: s32 = 0
    while index < set.count {
        if set.items[index].name == name { return true }
        index += 1
    }
    return false
}

PkgScanModules :: (directory: string, manifest: *PkgManifest,
    output: *PkgModuleSet) -> bool {
    base: string = PkgCanonical(directory)
    if base.count == 0 { return false }
    root_index: s32 = 0
    while root_index < manifest.root_count {
        source_root: string = PkgCanonical(PkgJoin3(base, "/",
            manifest.roots[root_index]))
        if source_root.count == 0 ||
            !(source_root == base || (source_root.count > base.count &&
                source_root[0:cast(s64)base.count] == base &&
                source_root[cast(s64)base.count] == cast(u8)47)) {
            return false
        }
        args: [8]string
        args[0] = "find"
        args[1] = source_root
        args[2] = "-maxdepth"
        args[3] = "2"
        args[4] = "-type"
        args[5] = "f"
        args[6] = "-name"
        args[7] = "*.zi"
        result: PkgProcessResult = PkgCapture(args[:], "")
        if result.code != 0 { return false }
        at: s64 = 0
        while at < cast(s64)result.text.count {
            end: s64 = at
            while end < cast(s64)result.text.count &&
                result.text[end] != cast(u8)10 { end += 1 }
            path: string = result.text[at:end]
            at = end + 1
            if path.count <= source_root.count + 1 ||
               path[0:cast(s64)source_root.count] != source_root { continue }
            relative: string = path[cast(s64)source_root.count + 1:]
            slash: s64 = -1
            index: s64 = 0
            while index < cast(s64)relative.count {
                if relative[index] == cast(u8)47 {
                    if slash >= 0 { slash = -2; break }
                    slash = index
                }
                index += 1
            }
            name: string = ""
            if slash == -1 && PkgEndsWith(relative, ".zi") {
                name = relative[0:cast(s64)relative.count - 3]
            } else if slash > 0 && relative[slash + 1:] == "module.zi" {
                name = relative[0:slash]
            }
            if name.count == 0 { continue }
            if !PkgIdentifier(name) || PkgHasModule(output, name) ||
                output.count >= 512 { return false }
            output.items[output.count].name = name
            output.items[output.count].path = path
            output.count += 1
        }
        root_index += 1
    }
    return true
}

PkgAppendModuleSet :: (builder: *PkgBuilder, id: string, directory: string,
    set: *PkgModuleSet) -> void {
    PkgAppend(builder, PkgJoin3("P\t", id, "\t"))
    PkgAppend(builder, directory)
    PkgAppend(builder, "\n")
    index: s32 = 0
    while index < set.count {
        PkgAppend(builder, PkgJoin3("M\t", id, "\t"))
        PkgAppend(builder, set.items[index].name)
        PkgAppend(builder, "\t")
        PkgAppend(builder, set.items[index].path)
        PkgAppend(builder, "\n")
        index += 1
    }
}

PkgFindExport :: (manifest: *PkgManifest, name: string) -> bool {
    index: s32 = 0
    while index < manifest.export_count {
        if manifest.exports[index].name == name { return true }
        index += 1
    }
    return false
}

PkgAddExports :: (builder: *PkgBuilder, locked: *PkgLock,
    graph: *PkgModuleGraph, owner: s32, current: *PkgManifest,
    root: string) -> bool {
    owner_manifest: *PkgManifest = current
    owner_id: string = "root"
    owner_directory: string = root
    edge_count: s32 = locked.root_edge_count
    if owner >= 0 {
        owner_manifest = *locked.packages[owner].manifest
        owner_id = locked.packages[owner].id
        owner_directory = locked.packages[owner].path
        edge_count = locked.packages[owner].edge_count
    }
    visible: [512]string
    visible_count: s32 = 0
    index: s32 = 0
    while index < owner_manifest.dependency_count {
        dep: *PkgDependency = *owner_manifest.dependencies[index]
        target_id: string = ""
        if owner < 0 {
            target_id = PkgEdgeValue(*locked.root_edges[0], edge_count, dep.alias)
        } else {
            target_id = PkgEdgeValue(*locked.packages[owner].edges[0],
                edge_count, dep.alias)
        }
        target: s32 = PkgFindById(locked, target_id)
        if target < 0 { return false }
        target_manifest: *PkgManifest = *locked.packages[target].manifest
        alias_index: s32 = 0
        while alias_index < dep.alias_count {
            if !PkgFindExport(target_manifest, dep.aliases[alias_index].name) {
                return false
            }
            alias_index += 1
        }
        export_index: s32 = 0
        while export_index < target_manifest.export_count {
            exported: PkgNamedValue = target_manifest.exports[export_index]
            source: string = PkgCanonical(PkgJoin3(
                locked.packages[target].path, "/", exported.value))
            internal: string = PkgModuleByPath(*graph.sets[target + 1], source)
            if internal.count == 0 { return false }
            name: string = PkgAliasName(dep, exported.name)
            if PkgHasModule(*graph.sets[owner + 1], name) {
                PkgFail(PkgJoin3("module ", name,
                    " conflicts with dependency; set module_aliases"))
                return false
            }
            alias_index = 0
            while alias_index < visible_count {
                if visible[alias_index] == name {
                    PkgFail(PkgJoin3("module ", name,
                        " is exported by both dependencies; set module_aliases"))
                    return false
                }
                alias_index += 1
            }
            if visible_count >= 512 { return false }
            visible[visible_count] = name
            visible_count += 1
            PkgAppend(builder, PkgJoin3("D\t", owner_id, "\t"))
            PkgAppend(builder, name)
            PkgAppend(builder, "\t")
            PkgAppend(builder, target_id)
            PkgAppend(builder, "\t")
            PkgAppend(builder, internal)
            PkgAppend(builder, "\n")
            export_index += 1
        }
        index += 1
    }
    return true
}

PkgWriteMap :: (root: string, locked: *PkgLock, current: *PkgManifest) -> string {
    graph: *PkgModuleGraph = cast(*PkgModuleGraph)(PkgAllocZero(PkgGraphSizeRaw()))
    memory: *u8 = PkgAlloc(4194304)
    if graph == null || memory == null { return "" }
    builder: PkgBuilder
    builder.bytes = BytesFromPointer(memory, 4194304)
    builder.valid = true
    if !PkgScanModules(root, current, *graph.sets[0]) { return "" }
    PkgAppendModuleSet(*builder, "root", root, *graph.sets[0])
    index: s32 = 0
    while index < locked.count {
        item: *PkgLocked = *locked.packages[index]
        if !PkgScanModules(item.path, *item.manifest, *graph.sets[index + 1]) {
            return ""
        }
        PkgAppendModuleSet(*builder, item.id, item.path, *graph.sets[index + 1])
        index += 1
    }
    standard: *PkgManifest = PkgNewManifest()
    if standard == null { return "" }
    standard.roots[0] = "std"
    standard.root_count = 1
    if !PkgScanModules(locked.tool_path, standard, *graph.sets[locked.count + 1]) {
        return ""
    }
    PkgAppendModuleSet(*builder, "std", locked.tool_path,
        *graph.sets[locked.count + 1])
    if !PkgAddExports(*builder, locked, graph, -1, current, root) { return "" }
    index = 0
    while index < locked.count {
        if !PkgAddExports(*builder, locked, graph, index, current, root) {
            return ""
        }
        index += 1
    }
    index = 0
    while index < current.bridge_count {
        name: string = current.bridges[index]
        if !PkgHasModule(*graph.sets[0], name) { return "" }
        direct: s32 = 0
        while direct < locked.root_edge_count {
            target: s32 = PkgFindById(locked,
                locked.root_edges[direct].value)
            if target < 0 || PkgHasModule(*graph.sets[target + 1], name) {
                return ""
            }
            if locked.packages[target].source {
                direct += 1
                continue
            }
            PkgAppend(*builder, PkgJoin3("D\t", locked.packages[target].id,
                "\t"))
            PkgAppend(*builder, name)
            PkgAppend(*builder, "\troot\t")
            PkgAppend(*builder, name)
            PkgAppend(*builder, "\n")
            direct += 1
        }
        index += 1
    }
    if !builder.valid { return "" }
    directory: string = PkgJoin(root, "/build/.ziran")
    if !PkgMkdirs(directory) { return "" }
    path: string = PkgJoin(directory, "/module-map.tsv")
    if !PkgWrite(path, TextFromBytes(builder.bytes[0:builder.at])) { return "" }
    return path
}
