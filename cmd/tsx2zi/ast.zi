// Flat AST: nodes live in one pool and refer to each other by index. Each
// child list is a chain: the head sits in `a` and siblings link through
// `next`, so `a` to `d` stay free for per-kind semantic children. Type
// references are nodes too (NAMED, ARRAY_T, primitive kinds).

#scope_module

N_PROGRAM :: 1;
N_IMPORT :: 17;
N_IMPORTNAME :: 18;
N_FN :: 2;
N_PARAM :: 3;
N_INTERFACE :: 4;
N_TYPEALIAS :: 5;
N_FIELD :: 6;
N_VAR :: 7;
N_ASSIGN :: 8;
N_COMPOUND :: 9;
N_IF :: 10;
N_RETURN :: 11;
N_EXPRSTMT :: 12;
N_BLOCK :: 13;
N_FOROF :: 14;
N_BREAK :: 15;
N_CONTINUE :: 16;
N_NUM :: 20;
N_STR :: 21;
N_BOOL :: 22;
N_IDENT :: 23;
N_MEMBER :: 24;
N_CALL :: 25;
N_BINARY :: 26;
N_UNARY :: 27;
N_RECORD :: 28;
N_RECORDFIELD :: 29;
N_ARROW :: 30;
N_ARRAY :: 31;
N_SPREAD :: 32;
N_USESTATE :: 33;
N_FOR :: 34;
N_WHILE :: 35;
N_TERNARY :: 36;
N_INDEX :: 37;
N_POSTFIX :: 38;
N_JSX :: 40;
N_JSXPROP :: 41;
N_JSXCHILD_TEXT :: 42;
N_JSXCHILD_EXPR :: 43;
N_JSXCHILD_COND :: 44;
N_JSXCHILD_LIST :: 45;
N_TREF_NAMED :: 50;
N_TREF_ARRAY :: 51;
N_TREF_PRIM :: 52;
N_TREF_VOID :: 53;

Node :: struct {
    kind: s32;
    line: s32;
    col: s32;
    start: s64;
    len: s64;
    a: s32;
    b: s32;
    c: s32;
    d: s32;
    next: s32;
    num: s64;
    is_float: bool;
    x: s64;
    y: s64;
}

Ast :: struct {
    nodes: Vec(Node);
}

AstNew :: (ast: *Ast) {
    placeholder: Node;
    placeholder.kind = 0;
    placeholder.line = 0;
    placeholder.col = 0;
    placeholder.start = 0;
    placeholder.len = 0;
    placeholder.a = -1;
    placeholder.b = -1;
    placeholder.c = -1;
    placeholder.d = -1;
    placeholder.next = -1;
    placeholder.num = 0;
    placeholder.is_float = false;
    placeholder.x = -1;
    placeholder.y = -1;
    VecPush(ast.nodes, placeholder);
}

AstAdd :: (ast: *Ast, node: Node) -> s32 {
    VecPush(ast.nodes, node);
    return cast(s32)ast.nodes.count - 1;
}

AstNewNode :: (ast: *Ast, kind: s32, line: s32, col: s32) -> s32 {
    node: Node;
    node.kind = kind;
    node.line = line;
    node.col = col;
    node.start = 0;
    node.len = 0;
    node.a = -1;
    node.b = -1;
    node.c = -1;
    node.d = -1;
    node.next = -1;
    node.num = 0;
    node.is_float = false;
    node.x = -1;
    node.y = -1;
    return AstAdd(ast, node);
}

// Append CHILD to PARENT's child chain, keeping source order: the chain
// head is the first child and each node links to the next through `b`.
AstLink :: (ast: *Ast, parent: s32, child: s32) {
    child_node := ast.nodes[child];
    child_node.next = -1;
    ast.nodes[child] = child_node;
    head := ast.nodes[parent].a;
    if head < 0 {
        parent_node := ast.nodes[parent];
        parent_node.a = child;
        ast.nodes[parent] = parent_node;
        return;
    }
    tail := head;
    next := ast.nodes[tail].next;
    while next >= 0 {
        tail = next;
        next = ast.nodes[tail].next;
    }
    tail_node := ast.nodes[tail];
    tail_node.next = child;
    ast.nodes[tail] = tail_node;
}
