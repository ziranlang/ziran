// Source-mapped diagnostics: every error carries the input file, line and
// column so the CLI always points at authoring code, never generated code.
// Message bytes live in one owned pool so Diag stays a plain struct and can
// live in a Vec.

Diag :: struct {
    line: s32;
    col: s32;
    msg_start: s64;
    msg_len: s64;
}

Diags :: struct {
    file: string;
    pool: Vec(u8);
    items: Vec(Diag);
    failed: bool;
}

DiagsInit :: (d: *Diags, file: string) {
    VecClear(d.pool);
    VecClear(d.items);
    d.file = file;
    d.failed = false;
}

DiagsAppend :: (d: *Diags, line: s32, col: s32, text: string) {
    item: Diag;
    item.line = line;
    item.col = col;
    item.msg_start = d.pool.count;
    item.msg_len = text.count;
    walk: s64 = 0;
    while walk < text.count {
        VecPush(d.pool, text[walk]);
        walk += 1;
    }
    VecPush(d.items, item);
    d.failed = true;
}

DiagText :: (d: *Diags, item: Diag) -> string {
    return TextView(d.pool[item.msg_start:item.msg_start + item.msg_len]);
}

DiagsPrint :: (d: *Diags) {
    for d.items {
        print("%:%:%: error: %\n", d.file, it.line, it.col, DiagText(d, it));
    }
}

// Two-part message builder for parser and checker diagnostics.
Join :: (a: string, b: string) -> string {
    out: Vec(u8);
    BuilderAppend(out, a);
    BuilderAppend(out, b);
    return BuilderFinish(out);
}
