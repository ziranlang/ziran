// TSX -> Ziran emitter: walks the AST exactly the way the checker did and
// writes ordinary checked Ziran. Every identifier resolves through the same
// scope rules, so generated code declares only what the checker approved.
// String state lives in adapter field buffers, arrays rebuild in place, and
// owned temporaries always bind before use, so the output passes the Ziran
// ownership checker without extra author rules.

#scope_module

EmitCtx :: struct {
    c: *CheckResult;
    src: string;
    ast: *Ast;
    out: Vec(u8);
    map_lines: Vec(s32);
    map_srcs: Vec(s32);
    gen_line: s32;
    indent: s32;
    scope: Scope;
    part: s64;
    comp: s32;
    ui_prefix: string;
    tmp_counter: s64;
    diags: *Diags;
}

EmitInit :: (e: *EmitCtx, c: *CheckResult, src: string, ast: *Ast, diags: *Diags) {
    VecClear(e.out);
    VecClear(e.map_lines);
    VecClear(e.map_srcs);
    e.c = c;
    e.src = src;
    e.ast = ast;
    e.diags = diags;
    e.gen_line = 0;
    e.indent = 0;
    e.part = 0;
    e.comp = -1;
    e.ui_prefix = "";
    e.tmp_counter = 0;
    ScopeInit(*e.scope);
}

AppendText :: (e: *EmitCtx, text: string) {
    i: s64 = 0;
    while i < text.count {
        VecPush(e.out, text[i]);
        i += 1;
    }
}

AppendPad :: (e: *EmitCtx) {
    i: s32 = 0;
    while i < e.indent {
        AppendText(e, "    ");
        i += 1;
    }
}

LineEnd :: (e: *EmitCtx) {
    VecPush(e.out, cast(u8)10);
    e.gen_line += 1;
}

RecordMap :: (e: *EmitCtx, node: s32) {
    n := e.ast.nodes[node];
    VecPush(e.map_lines, e.gen_line + 1);
    VecPush(e.map_srcs, n.line);
    VecPush(e.map_srcs, n.col);
}

EmitLine :: (e: *EmitCtx, text: string) {
    AppendPad(e);
    AppendText(e, text);
    LineEnd(e);
}

EmitMapped :: (e: *EmitCtx, node: s32, text: string) {
    RecordMap(e, node);
    AppendPad(e);
    AppendText(e, text);
    LineEnd(e);
}

AppendNumber :: (e: *EmitCtx, value: s64) {
    out: Vec(u8);
    BuilderPrint(*out, "%", value);
    AppendText(e, BuilderFinish(out));
}

Build2 :: (a: string, b: string) -> string {
    out: Vec(u8);
    BuilderAppend(out, a);
    BuilderAppend(out, b);
    return BuilderFinish(out);
}

Build3 :: (a: string, b: string, c: string) -> string {
    out: Vec(u8);
    BuilderAppend(out, a);
    BuilderAppend(out, b);
    BuilderAppend(out, c);
    return BuilderFinish(out);
}

Build4 :: (a: string, b: string, c: string, d: string) -> string {
    out: Vec(u8);
    BuilderAppend(out, a);
    BuilderAppend(out, b);
    BuilderAppend(out, c);
    BuilderAppend(out, d);
    return BuilderFinish(out);
}

Build5 :: (a: string, b: string, c: string, d: string, f: string) -> string {
    out: Vec(u8);
    BuilderAppend(out, a);
    BuilderAppend(out, b);
    BuilderAppend(out, c);
    BuilderAppend(out, d);
    BuilderAppend(out, f);
    return BuilderFinish(out);
}

BuildNI :: (a: string, n: s64, b: string) -> string {
    out: Vec(u8);
    BuilderAppend(out, a);
    BuilderPrint(*out, "%", n);
    BuilderAppend(out, b);
    return BuilderFinish(out);
}

BuildN :: (a: string, n: s64) -> string {
    out: Vec(u8);
    BuilderAppend(out, a);
    BuilderPrint(*out, "%", n);
    return BuilderFinish(out);
}

BuildIN :: (n: s64, a: string) -> string {
    out: Vec(u8);
    BuilderPrint(*out, "%", n);
    BuilderAppend(out, a);
    return BuilderFinish(out);
}

EscapeText :: (text: string) -> string {
    out: Vec(u8);
    i: s64 = 0;
    while i < text.count {
        b := text[i];
        if b == cast(u8)34 { BuilderAppend(out, "\\\"") }
        else if b == cast(u8)92 { BuilderAppend(out, "\\\\") }
        else if b == cast(u8)10 { BuilderAppend(out, "\\n") }
        else if b == cast(u8)9 { BuilderAppend(out, "\\t") }
        else if b == cast(u8)13 { BuilderAppend(out, "\\r") }
        else { VecPush(out, b) }
        i += 1;
    }
    return BuilderFinish(out);
}

RawSpan :: (e: *EmitCtx, node: s32) -> string {
    n := e.ast.nodes[node];
    return TextView(e.src[n.start:n.start + n.len]);
}

// JSX text spans hold raw source; collapse whitespace the way the lexer
// pool did: trimmed ends, space and tab runs between words become one
// space, and newline-separated words join directly.
TrimSpan :: (e: *EmitCtx, node: s32) -> string {
    n := e.ast.nodes[node];
    start := n.start;
    end := n.start + n.len;
    while start < end && (e.src[start] == cast(u8)32 || e.src[start] == cast(u8)10 || e.src[start] == cast(u8)9 || e.src[start] == cast(u8)13) { start += 1 }
    while end > start && (e.src[end - 1] == cast(u8)32 || e.src[end - 1] == cast(u8)10 || e.src[end - 1] == cast(u8)9 || e.src[end - 1] == cast(u8)13) { end -= 1 }
    if end <= start { return "" }
    out: Vec(u8);
    pending := false;
    meaningful := false;
    i := start;
    while i < end {
        b := e.src[i];
        if b == cast(u8)10 { pending = false; i += 1; continue }
        if b == cast(u8)32 || b == cast(u8)9 { pending = true; i += 1; continue }
        if pending && meaningful { VecPush(out, cast(u8)32) }
        pending = false;
        meaningful = true;
        VecPush(out, b);
        i += 1;
    }
    return BuilderFinish(out);
}

// ---- type words -------------------------------------------------------

RecordName :: (c: *CheckResult, index: s32) -> string {
    if index < 0 || index >= c.records.count { return "Record" }
    return TextView(c.src[c.records[index].name.start:c.records[index].name.start + c.records[index].name.len]);
}

// Word for a scalar or record used as an array element or bare value.
ElemWord :: (c: *CheckResult, t: s32) -> string {
    base := BaseType(t);
    if base == TY_F64 { return "float64" }
    if base == TY_BOOL { return "bool" }
    if base == TY_STRING { return "Text" }
    if base == TY_RECORD { return RecordName(c, RecordIndex(t)) }
    if base == TY_ARRAY { return Build2("[]", ElemWord(c, ArrayElem(t))) }
    return "s64";
}

// Struct/interface fields: TSX strings own their bytes.
ValueWord :: (c: *CheckResult, t: s32) -> string {
    if BaseType(t) == TY_STRING { return "Text" }
    return ElemWord(c, t);
}

// Function parameters borrow strings and arrays.
ParamWord :: (c: *CheckResult, t: s32) -> string {
    base := BaseType(t);
    if base == TY_STRING { return "string" }
    if base == TY_RECORD { return Build2("*", RecordName(c, RecordIndex(t))) }
    if base == TY_ARRAY { return Build2("[]", ElemWord(c, ArrayElem(t))) }
    return ElemWord(c, t);
}

// Function results own strings and arrays.
RetWord :: (c: *CheckResult, t: s32) -> string {
    base := BaseType(t);
    if base == TY_VOID { return "" }
    if base == TY_STRING { return "Text" }
    if base == TY_ARRAY { return Build3("Vec(", ElemWord(c, ArrayElem(t)), ")") }
    return ElemWord(c, t);
}

// True for array elements that own storage and must rebuild, never copy.
ElemIsOwned :: (t: s32) -> bool {
    base := BaseType(t);
    return base == TY_RECORD || base == TY_ARRAY || base == TY_STRING;
}

// ---- scope helpers ----------------------------------------------------

ScopeHasName :: (e: *EmitCtx, text: string) -> bool {
    i: s64 = 0;
    while i < e.scope.locals.count {
        if RangeMatches(e.src, e.scope.locals[i].name, text) { return true }
        i += 1;
    }
    return false;
}

ScopeFindInfo :: (e: *EmitCtx, text: string) -> s32 {
    i: s64 = e.scope.locals.count - 1;
    while i >= 0 {
        if RangeMatches(e.src, e.scope.locals[i].name, text) { return cast(s32)i }
        i -= 1;
    }
    return -1;
}

FreshName :: (e: *EmitCtx, base: string) -> string {
    if !ScopeHasName(e, base) { return base }
    n: s32 = 2;
    while true {
        candidate := BuildNI(base, n, "");
        if !ScopeHasName(e, candidate) { return candidate }
        n += 1;
    }
    return base;
}

StateName :: (e: *EmitCtx, field: StateField) -> string {
    return Build2("state.", RangeText(e.src, field.name));
}

StateFieldName :: (e: *EmitCtx, field: StateField) -> string {
    return Build3("state.", RangeText(e.src, field.name), "_f");
}

TmpName :: (e: *EmitCtx) -> string {
    e.tmp_counter += 1;
    return BuildNI("t2z_tmp_", e.tmp_counter, "");
}

// A JSX prop by name; -1 when absent.
JsxProp :: (e: *EmitCtx, node: s32, text: string) -> s32 {
    n := e.ast.nodes[node];
    prop := n.a;
    while prop >= 0 {
        pnode := e.ast.nodes[prop];
        if pnode.kind == N_JSXPROP && RangeMatches(e.src, MakeRange(pnode), text) { return prop }
        prop = pnode.next;
    }
    return -1;
}

// ---- expressions -------------------------------------------------------

// Flatten an OP_ADD chain whose result is a string into source-order terms.
CollectTerms :: (e: *EmitCtx, node: s32, terms: *Vec(s32)) {
    n := e.ast.nodes[node];
    if n.kind == N_BINARY && n.num == OP_ADD {
        lt := e.c.node_types[n.a];
        rt := e.c.node_types[n.b];
        if lt == TY_STRING || rt == TY_STRING {
            CollectTerms(e, n.a, terms);
            CollectTerms(e, n.b, terms);
            return;
        }
    }
    VecPush(<<terms, node);
}

// One concat term rendered as a string value; numbers and booleans format
// through helpers so "a" + 1 keeps TS semantics.
EmitStrTerm :: (e: *EmitCtx, node: s32) -> string {
    t := e.c.node_types[node];
    if t == TY_F64 { return Build2(Build2("t2z_NumF(", EmitExprVal(e, node)), ")") }
    if t == TY_BOOL { return Build2(Build2("t2z_Bool(", EmitExprVal(e, node)), ")") }
    if t == TY_S64 { return Build2(Build2("t2z_Num(", EmitExprVal(e, node)), ")") }
    return EmitExprStr(e, node);
}

// Join concat terms through t2z_Str2/3/4 calls; four terms per call and
// balanced nesting keep argument lists small.
StrChain :: (e: *EmitCtx, terms: []s32, start: s32) -> string {
    remaining := terms.count - start;
    if remaining == 1 { return EmitStrTerm(e, terms[start]) }
    arity: s32 = cast(s32)(remaining);
    if arity > 4 { arity = 4 }
    head: Vec(u8);
    BuilderAppend(head, BuildNI("t2z_Str", arity, ""));
    BuilderAppend(head, "(");
    i := start;
    while i < start + arity {
        if i > start { BuilderAppend(head, ", ") }
        BuilderAppend(head, EmitStrTerm(e, terms[i]));
        i += 1;
    }
    BuilderAppend(head, ")");
    if remaining > arity {
        rest := StrChain(e, terms, start + arity);
        BuilderAppend(head, Build2(", ", rest));
        wrapped: Vec(u8);
        BuilderAppend(wrapped, "t2z_Str2(");
        BuilderAppend(wrapped, BuilderFinish(head));
        BuilderAppend(wrapped, ")");
        return BuilderFinish(wrapped);
    }
    return BuilderFinish(head);
}

// Render a string expression that lends its value: literals stay bare,
// owned places read through TextView, state strings read the field buffer.
EmitExprStr :: (e: *EmitCtx, node: s32) -> string {
    n := e.ast.nodes[node];
    if n.kind == N_STR {
        return Build3("\"", EscapeText(e.src[n.start:n.start + n.len]), "\"");
    }
    if n.kind == N_BINARY && n.num == OP_ADD {
        terms: Vec(s32);
        CollectTerms(e, node, *terms);
        return StrChain(e, terms[:], 0);
    }
    if n.kind == N_TERNARY {
        cond := EmitExprVal(e, n.a);
        then_s := EmitExprStr(e, n.b);
        else_s := EmitExprStr(e, n.c);
        return Build2(Build5("ifx ", cond, " then ", then_s, " else "), else_s);
    }
    if n.kind == N_IDENT { return EmitStrPlace(e, node) }
    if n.kind == N_MEMBER {
        base := EmitPlace(e, n.a);
        name := RawSpan(e, node);
        return Build2(Build4("TextView(", base, ".", name), ")");
    }
    if n.kind == N_INDEX {
        base := EmitPlace(e, n.a);
        idx := EmitExprVal(e, n.b);
        return Build2(Build4("TextView(", base, "[", idx), "])");
    }
    if n.kind == N_CALL { return EmitCallExpr(e, node) }
    return EmitExprVal(e, node);
}

// A string read from a place: state fields read the adapter buffer, plain
// Text locals borrow through TextView, borrowed parameters stay bare.
EmitStrPlace :: (e: *EmitCtx, node: s32) -> string {
    n := e.ast.nodes[node];
    text := RawSpan(e, node);
    idx := ScopeFindInfo(e, text);
    if idx < 0 { return text }
    local := e.scope.locals[idx];
    if local.kind == LOCAL_STATE_VALUE {
        f := e.c.state_fields[local.state_index];
        if BaseType(f.type) == TY_STRING {
            return Build3(e.ui_prefix, ".FieldText(*", Build2(StateFieldName(e, f), ")"));
        }
        return text;
    }
    if BaseType(local.type) == TY_STRING {
        if local.kind == LOCAL_PARAM || local.kind == LOCAL_ARROW {
            if local.owned_view { return Build2(Build2("TextView(<<", text), ")") }
            return text;
        }
        if local.kind == LOCAL_LOOP {
            if local.owned_view { return Build2(Build2("TextView(<<", text), ")") }
            return text;
        }
        if local.kind == LOCAL_VAR { return Build2(Build2("TextView(", text), ")") }
    }
    return text;
}

// A writable or readable place path: state roots name the state parameter,
// members and indexes chain on.
EmitPlace :: (e: *EmitCtx, node: s32) -> string {
    n := e.ast.nodes[node];
    if n.kind == N_IDENT {
        text := RawSpan(e, node);
        idx := ScopeFindInfo(e, text);
        if idx >= 0 {
            local := e.scope.locals[idx];
            if local.kind == LOCAL_STATE_VALUE {
                f := e.c.state_fields[local.state_index];
                if BaseType(f.type) == TY_STRING { return StateFieldName(e, f) }
                return StateName(e, f);
            }
        }
        return text;
    }
    if n.kind == N_MEMBER {
        base := EmitPlace(e, n.a);
        return Build3(base, ".", RawSpan(e, node));
    }
    if n.kind == N_INDEX {
        base := EmitPlace(e, n.a);
        idx := EmitExprVal(e, n.b);
        return Build4(base, "[", idx, "]");
    }
    return EmitExprVal(e, node);
}

OpWord :: (op: s64) -> string {
    if op == OP_ADD { return "+" }
    if op == OP_SUB { return "-" }
    if op == OP_MUL { return "*" }
    if op == OP_DIV { return "/" }
    if op == OP_MOD { return "%" }
    if op == OP_EQ { return "==" }
    if op == OP_NE { return "!=" }
    if op == OP_LT { return "<" }
    if op == OP_GT { return ">" }
    if op == OP_LE { return "<=" }
    if op == OP_GE { return ">=" }
    if op == OP_AND { return "&&" }
    if op == OP_OR { return "||" }
    return "+";
}

// Value expressions: numbers, booleans, records and calls. Record values
// surface as places; callers wrap them with * when a pointer is needed.
EmitExprVal :: (e: *EmitCtx, node: s32) -> string {
    n := e.ast.nodes[node];
    if n.kind == N_NUM { return RawSpan(e, node) }
    if n.kind == N_BOOL {
        if n.num == 1 { return "true" }
        return "false";
    }
    if n.kind == N_UNARY {
        inner := EmitExprVal(e, n.a);
        if n.num == 33 { return Build3("!(", inner, ")") }
        return Build3("(0 - ", inner, ")");
    }
    if n.kind == N_BINARY {
        a := EmitExprVal(e, n.a);
        b := EmitExprVal(e, n.b);
        return Build3(Build5("(", a, " ", OpWord(n.num), " "), b, ")");
    }
    if n.kind == N_TERNARY {
        t := e.c.node_types[node];
        cond := EmitExprVal(e, n.a);
        if BaseType(t) == TY_RECORD {
            rec := RecordIndex(t);
            then_s := EmitRecordExpr(e, n.b, rec);
            else_s := EmitRecordExpr(e, n.c, rec);
            return Build2(Build5("ifx ", cond, " then ", then_s, " else "), else_s);
        }
        then_s := EmitExprVal(e, n.b);
        else_s := EmitExprVal(e, n.c);
        return Build2(Build5("ifx ", cond, " then ", then_s, " else "), else_s);
    }
    if n.kind == N_IDENT || n.kind == N_MEMBER || n.kind == N_INDEX {
        return EmitPlace(e, node);
    }
    if n.kind == N_CALL { return EmitCallExpr(e, node) }
    if n.kind == N_RECORD {
        return EmitRecordExpr(e, node, RecordIndex(e.c.node_types[node]));
    }
    return "0";
}

// A record literal expression. Fields convert by type: strings own a copy,
// nested records emit named literals, arrays are rejected by the checker.
EmitRecordExpr :: (e: *EmitCtx, node: s32, rec: s32) -> string {
    out: Vec(u8);
    if rec < 0 || rec >= e.c.records.count {
        BuilderAppend(out, "Record.{}")
        return BuilderFinish(out);
    }
    BuilderAppend(out, RecordName(e.c, rec));
    BuilderAppend(out, ".{");
    n := e.ast.nodes[node];
    field := n.a;
    first := true;
    while field >= 0 {
        fnode := e.ast.nodes[field];
        fname := RawSpan(e, field);
        ft := RecordFieldType(e.c, rec, e.src, fname);
        if !first { BuilderAppend(out, ", ") }
        first = false;
        BuilderAppend(out, Build2(".", fname));
        BuilderAppend(out, " = ");
        v := fnode.a;
        if BaseType(ft) == TY_STRING {
            BuilderAppend(out, Build2(Build2("TextCopy(", EmitExprStr(e, v)), ")"));
        } else if BaseType(ft) == TY_RECORD {
            BuilderAppend(out, EmitRecordExpr(e, v, RecordIndex(ft)));
        } else {
            BuilderAppend(out, EmitExprVal(e, v));
        }
        field = fnode.next;
    }
    BuilderAppend(out, "}");
    return BuilderFinish(out);
}

// A fresh copy of a record reached through a pointer, used when owned array
// elements must be rebuilt without moving the source.
RecordFreshPtr :: (e: *EmitCtx, rec: s32, ptr: string) -> string {
    out: Vec(u8);
    BuilderAppend(out, RecordName(e.c, rec));
    BuilderAppend(out, ".{");
    if rec < 0 || rec >= e.c.records.count {
        BuilderAppend(out, "}");
        return BuilderFinish(out);
    }
    info := e.c.records[rec];
    i: s32 = 0;
    first := true;
    while i < info.fields_count {
        f := e.c.fields[info.fields_from + i];
        fname := RangeText(e.src, f.name);
        ft := f.type;
        if !first { BuilderAppend(out, ", ") }
        first = false;
        BuilderAppend(out, Build2(".", fname));
        BuilderAppend(out, " = ");
        path := Build2(ptr, Build2(".", fname));
        if BaseType(ft) == TY_STRING {
            BuilderAppend(out, Build2(Build2("TextCopy(TextView(", path), "))"));
        } else if BaseType(ft) == TY_RECORD {
            BuilderAppend(out, RecordFreshPtr(e, RecordIndex(ft), path));
        } else {
            BuilderAppend(out, path);
        }
        i += 1;
    }
    BuilderAppend(out, "}");
    return BuilderFinish(out);
}

// A function call: state setters, print, console.log and author functions.
EmitCallExpr :: (e: *EmitCtx, node: s32) -> string {
    n := e.ast.nodes[node];
    callee := n.a;
    cn := e.ast.nodes[callee];
    if cn.kind == N_IDENT {
        text := RawSpan(e, callee);
        idx := ScopeFindInfo(e, text);
        if idx >= 0 {
            local := e.scope.locals[idx];
            if local.kind == LOCAL_STATE_SETTER { return EmitSetterText(e, node) }
            return "0";
        }
        if text == "print" { return EmitPrint(e, n.b) }
        fn_idx := FindFunction(e.c, e.src, cn.start, cn.len);
        if fn_idx >= 0 {
            fn := e.c.functions[fn_idx];
            out: Vec(u8);
            BuilderAppend(out, RangeText(e.src, fn.name));
            BuilderAppend(out, "(");
            BuilderAppend(out, EmitCallArgs(e, n.b, fn.params_from, fn.params_count));
            BuilderAppend(out, ")");
            return BuilderFinish(out);
        }
        return "0";
    }
    if cn.kind == N_MEMBER {
        base_text := RawSpan(e, cn.a);
        name := RawSpan(e, callee);
        if base_text == "console" && name == "log" { return EmitPrint(e, n.b) }
    }
    return "0";
}

// Call arguments converted by parameter type: strings lend, records pass a
// pointer to the value the author passes; arrays lend a slice view.
EmitCallArgs :: (e: *EmitCtx, args_head: s32, params_from: s32, params_count: s32) -> string {
    out: Vec(u8);
    it := args_head;
    i: s32 = 0;
    while it >= 0 {
        expected: s32 = TY_UNKNOWN;
        if params_count > 0 && i < params_count {
            expected = e.c.params[params_from + i].type;
        }
        if i > 0 { BuilderAppend(out, ", ") }
        BuilderAppend(out, EmitArgText(e, it, expected));
        it = e.ast.nodes[it].next;
        i += 1;
    }
    return BuilderFinish(out);
}

EmitArgText :: (e: *EmitCtx, arg: s32, expected: s32) -> string {
    base := BaseType(expected);
    if base == TY_STRING { return EmitExprStr(e, arg) }
    if base == TY_RECORD { return Build2("*", EmitPlace(e, arg)) }
    if base == TY_ARRAY { return Build2(EmitPlace(e, arg), "[:]") }
    return EmitExprVal(e, arg);
}

// print/console.log: one % per argument and a trailing newline. Strings
// lend, booleans format through the helper, numbers print directly.
EmitPrint :: (e: *EmitCtx, args_head: s32) -> string {
    fmt: Vec(u8);
    args: Vec(u8);
    it := args_head;
    i: s32 = 0;
    while it >= 0 {
        BuilderAppend(fmt, "%");
        if i > 0 { BuilderAppend(args, ", ") }
        t := e.c.node_types[it];
        if BaseType(t) == TY_STRING {
            BuilderAppend(args, EmitExprStr(e, it));
        } else if BaseType(t) == TY_BOOL {
            BuilderAppend(args, Build2(Build2("t2z_Bool(", EmitExprVal(e, it)), ")"));
        } else {
            BuilderAppend(args, EmitExprVal(e, it));
        }
        it = e.ast.nodes[it].next;
        i += 1;
    }
    BuilderAppend(fmt, "\\n");
    out: Vec(u8);
    BuilderAppend(out, "print(\"");
    BuilderAppend(out, BuilderFinish(fmt));
    BuilderAppend(out, "\"");
    if i > 0 {
        BuilderAppend(out, ", ");
        BuilderAppend(out, BuilderFinish(args));
    }
    BuilderAppend(out, ")");
    return BuilderFinish(out);
}

// A state setter call as statement text; array and record setters emit
// whole rebuild blocks through EmitSetterStmt instead.
EmitSetterText :: (e: *EmitCtx, node: s32) -> string {
    n := e.ast.nodes[node];
    text := RawSpan(e, n.a);
    idx := ScopeFindInfo(e, text);
    if idx < 0 { return "0" }
    local := e.scope.locals[idx];
    if local.kind != LOCAL_STATE_SETTER { return "0" }
    f := e.c.state_fields[local.state_index];
    arg := n.b;
    if BaseType(f.type) == TY_STRING {
        return Build3(Build4(e.ui_prefix, ".FieldSet(*", StateFieldName(e, f), ", "), EmitArgText(e, arg, f.type), ")");
    }
    if BaseType(f.type) == TY_ARRAY || BaseType(f.type) == TY_RECORD { return "" }
    return Build2(Build2(StateName(e, f), " = "), EmitExprVal(e, arg));
}



// ---- statements --------------------------------------------------------

// One array element push. Strings own a copy, records emit fresh literals,
// scalars move straight in.
EmitSinglePush :: (e: *EmitCtx, item: s32, place: string, elem: s32) {
    if BaseType(elem) == TY_STRING {
        EmitMapped(e, item, Build5("VecPush(", place, ", TextCopy(", EmitExprStr(e, item), "));"));
    } else if BaseType(elem) == TY_RECORD {
        EmitMapped(e, item, Build5("VecPush(", place, ", ", EmitRecordExpr(e, item, RecordIndex(elem)), "));"));
    } else {
        EmitMapped(e, item, Build5("VecPush(", place, ", ", EmitExprVal(e, item), "));"));
    }
}

// Push every element of an N_ARRAY literal into a place. A leading spread
// copies another array element by element first.
EmitPushElements :: (e: *EmitCtx, arg: s32, place: string, elem: s32) {
    n := e.ast.nodes[arg];
    item := n.a;
    while item >= 0 {
        it := e.ast.nodes[item];
        if it.kind == N_SPREAD {
            src := EmitPlace(e, it.a);
            i := FreshName(e, "i");
            EmitMapped(e, item, Build2(i, " := 0;"));
            EmitMapped(e, item, Build5("while ", i, " < ", src, ".count {"));
            e.indent += 1;
            if BaseType(elem) == TY_STRING {
                EmitLine(e, Build5("VecPush(", place, ", TextCopy(TextView(", Build3(src, "[", i), "])));"));
            } else if BaseType(elem) == TY_RECORD {
                EmitLine(e, Build5("VecPush(", place, Build3(", t2z_Fresh", RecordName(e.c, RecordIndex(elem)), "(*"), Build4(src, "[", i, "]"), "));"));
            } else {
                EmitLine(e, Build5("VecPush(", place, ", ", Build3(src, "[", i), "));"));
            }
            e.indent -= 1;
            EmitMapped(e, item, Build2(i, " += 1;"));
            EmitMapped(e, item, "}");
            item = it.next;
            continue;
        }
        EmitSinglePush(e, item, place, elem);
        item = it.next;
    }
}

// Replace the owned array contents of a place in place, never moving or leaking
// the vector: shrink, then push fresh elements; a leading spread pops the
// old elements aside through a temporary and restores them.
EmitArrayValue :: (e: *EmitCtx, arg: s32, place: string, elem: s32) {
    n := e.ast.nodes[arg];
    if n.kind == N_ARRAY {
        spread_first := false;
        if n.a >= 0 && e.ast.nodes[n.a].kind == N_SPREAD { spread_first = true }
        if spread_first {
            tmp := FreshName(e, TmpName(e));
            EmitMapped(e, arg, Build5(tmp, ": Vec(", ElemWord(e.c, elem), ");", ""));
            EmitMapped(e, arg, Build5("while ", place, ".count > 0", " {", ""));
            e.indent += 1;
            p := FreshName(e, "p");
            EmitLine(e, Build5(p, " := VecPop(", place, ");", ""));
            EmitLine(e, Build3("if ", p, ".has_value {"));
            e.indent += 1;
            EmitLine(e, Build5("VecPush(", tmp, ", ", Build2(p, ".value"), ");"));
            e.indent -= 1;
            EmitLine(e, "}");
            e.indent -= 1;
            EmitLine(e, "}");
            EmitLine(e, Build5("while ", tmp, ".count > 0", " {", ""));
            e.indent += 1;
            q := FreshName(e, "q");
            EmitLine(e, Build5(q, " := VecPop(", tmp, ");", ""));
            EmitLine(e, Build3("if ", q, ".has_value {"));
            e.indent += 1;
            EmitLine(e, Build5("VecPush(", place, ", ", Build2(q, ".value"), ");"));
            e.indent -= 1;
            EmitLine(e, "}");
            e.indent -= 1;
            EmitLine(e, "}");
            item := e.ast.nodes[n.a].next;
            while item >= 0 {
                EmitSinglePush(e, item, place, elem);
                item = e.ast.nodes[item].next;
            }
            return;
        }
        EmitMapped(e, arg, Build5("VecResize(", place, ", 0", ");", ""));
        EmitPushElements(e, arg, place, elem);
        return;
    }
    if n.kind == N_IDENT || n.kind == N_MEMBER || n.kind == N_INDEX {
        src := EmitPlace(e, arg);
        items_t := e.c.node_types[arg];
        el := elem;
        if BaseType(items_t) == TY_ARRAY { el = ArrayElem(items_t) }
        EmitMapped(e, arg, Build5("VecResize(", place, ", 0", ");", ""));
        i := FreshName(e, "i");
        EmitMapped(e, arg, Build2(i, " := 0;"));
        EmitMapped(e, arg, Build5("while ", i, " < ", src, ".count {"));
        e.indent += 1;
        src_elem := Build3(src, "[", i);
        if BaseType(el) == TY_STRING {
            EmitLine(e, Build5("VecPush(", place, ", TextCopy(TextView(", src_elem, "])));"));
        } else if BaseType(el) == TY_RECORD {
            EmitLine(e, Build5("VecPush(", place, Build3(", t2z_Fresh", RecordName(e.c, RecordIndex(el)), "(*"), Build2(src_elem, "]"), "));"));
        } else {
            EmitLine(e, Build5("VecPush(", place, ", ", Build2(src_elem, "]"), ");"));
        }
        e.indent -= 1;
        EmitMapped(e, arg, Build2(i, " += 1;"));
        EmitMapped(e, arg, "}");
        return;
    }
    EmitMapped(e, arg, Build5("VecResize(", place, ", 0", ");", ""));
}

// Record assignment: a place source copies field-wise through the helper;
// a literal, call or conditional builds a temporary first, then copies.
EmitRecordValue :: (e: *EmitCtx, arg: s32, place: string, rec: s32) {
    n := e.ast.nodes[arg];
    if n.kind == N_IDENT || n.kind == N_MEMBER || n.kind == N_INDEX {
        src := EmitPlace(e, arg);
        EmitMapped(e, arg, Build5("t2z_Copy", RecordName(e.c, rec), Build3("(*", place, ", *"), src, ");"));
        return;
    }
    tmp := FreshName(e, TmpName(e));
    EmitMapped(e, arg, Build5(tmp, ": ", RecordName(e.c, rec), " = ", Build2(EmitExprVal(e, arg), ";")));
    EmitMapped(e, arg, Build5("t2z_Copy", RecordName(e.c, rec), Build3("(*", place, ", *"), tmp, ");"));
}

// A state setter call statement. Strings and scalars emit one line; arrays
// rebuild in place; records copy through a temporary.
EmitSetterStmt :: (e: *EmitCtx, node: s32) {
    n := e.ast.nodes[node];
    text := RawSpan(e, n.a);
    idx := ScopeFindInfo(e, text);
    if idx < 0 { return }
    local := e.scope.locals[idx];
    if local.kind != LOCAL_STATE_SETTER { return }
    f := e.c.state_fields[local.state_index];
    arg := n.b;
    if arg < 0 { return }
    t := f.type;
    if BaseType(t) == TY_STRING {
        EmitMapped(e, arg, Build5(Build2(e.ui_prefix, ".FieldSet(*"), StateFieldName(e, f), ", ", EmitArgText(e, arg, t), ");"));
    } else if BaseType(t) == TY_ARRAY {
        EmitArrayValue(e, arg, StateName(e, f), ArrayElem(t));
    } else if BaseType(t) == TY_RECORD {
        EmitRecordValue(e, arg, StateName(e, f), RecordIndex(t));
    } else {
        EmitMapped(e, arg, Build5(StateName(e, f), " = ", EmitExprVal(e, arg), ";", ""));
    }
}

// Assignment to a local, a record field or state. Strings mutate their
// buffer in place: state fields go through the adapter, other Text places
// clear and refill their own bytes.
EmitAssign :: (e: *EmitCtx, node: s32) {
    n := e.ast.nodes[node];
    target := n.a;
    rhs := n.b;
    t := e.c.node_types[target];
    place := EmitPlace(e, target);
    if BaseType(t) == TY_STRING {
        tnode := e.ast.nodes[target];
        if tnode.kind == N_IDENT {
            idx := ScopeFindInfo(e, RawSpan(e, target));
            if idx >= 0 && e.scope.locals[idx].kind == LOCAL_STATE_VALUE {
                local := e.scope.locals[idx];
                f := e.c.state_fields[local.state_index];
                if BaseType(f.type) == TY_STRING {
                    EmitMapped(e, node, Build5(Build2(e.ui_prefix, ".FieldSet(*"), StateFieldName(e, f), ", ", EmitArgText(e, rhs, f.type), "));"));
                    return;
                }
            }
        }
        EmitMapped(e, node, Build5("VecClear(", place, ".bytes", ");", ""));
        EmitMapped(e, node, Build5("BuilderAppend(", place, ".bytes, ", EmitExprStr(e, rhs), "));"));
        return;
    }
    if BaseType(t) == TY_ARRAY {
        EmitArrayValue(e, rhs, place, cast(s32)(ArrayElem(t)));
        return;
    }
    if BaseType(t) == TY_RECORD {
        EmitRecordValue(e, rhs, place, RecordIndex(t));
        return;
    }
    if n.kind == N_COMPOUND {
        op := "+";
        if n.num == OP_SUB { op = "-" }
        EmitMapped(e, node, Build5(place, " = ", Build3(place, Build2(" ", op), " "), EmitExprVal(e, rhs), ";"));
        return;
    }
    EmitMapped(e, node, Build5(place, " = ", EmitExprVal(e, rhs), ";", ""));
}

// A local variable declaration. Types come from the checker walk itself so
// the emitter never re-infers: annotation first, otherwise the initializer
// checked type.
EmitVarDecl :: (e: *EmitCtx, node: s32) {
    n := e.ast.nodes[node];
    name := RawSpan(e, node);
    t := e.c.node_types[n.b];
    if n.a >= 0 { t = TypeFromRef(e.c, e.ast, n.a) }
    init := n.b;
    if BaseType(t) == TY_STRING {
        EmitMapped(e, node, Build5(name, ": Text = TextCopy(", EmitExprStr(e, init), ");", ""));
    } else if BaseType(t) == TY_ARRAY {
        elem := ArrayElem(t);
        EmitMapped(e, node, Build5(name, ": Vec(", ElemWord(e.c, elem), ");", ""));
        inn := e.ast.nodes[init];
        if inn.kind == N_ARRAY {
            EmitPushElements(e, init, name, elem);
        } else if inn.kind == N_IDENT || inn.kind == N_MEMBER || inn.kind == N_INDEX {
            src := EmitPlace(e, init);
            i := FreshName(e, "i");
            EmitMapped(e, init, Build2(i, " := 0;"));
            EmitMapped(e, init, Build5("while ", i, " < ", src, ".count {"));
            e.indent += 1;
            src_elem := Build3(src, "[", i);
            if BaseType(elem) == TY_STRING {
                EmitLine(e, Build5("VecPush(", name, ", TextCopy(TextView(", src_elem, "])));"));
            } else if BaseType(elem) == TY_RECORD {
                EmitLine(e, Build5("VecPush(", name, Build3(", t2z_Fresh", RecordName(e.c, RecordIndex(elem)), "(*"), Build2(src_elem, "]"), "));"));
            } else {
                EmitLine(e, Build5("VecPush(", name, ", ", Build2(src_elem, "]"), ");"));
            }
            e.indent -= 1;
            EmitMapped(e, init, Build2(i, " += 1;"));
            EmitMapped(e, init, "}");
        } else {
            EmitMapped(e, init, Build5("VecResize(", name, ", 0", ");", ""));
        }
    } else if BaseType(t) == TY_RECORD {
        inn := e.ast.nodes[init];
        if inn.kind == N_IDENT || inn.kind == N_MEMBER || inn.kind == N_INDEX {
            EmitMapped(e, node, Build5(name, ": ", RecordName(e.c, RecordIndex(t)), ";", ""));
            EmitMapped(e, init, Build5(Build2("t2z_Copy", RecordName(e.c, RecordIndex(t))), Build3("(*", name, ", *"), EmitPlace(e, init), ");", ""));
        } else {
            EmitMapped(e, node, Build5(name, ": ", RecordName(e.c, RecordIndex(t)), " = ", Build2(EmitExprVal(e, init), ";")));
        }
    } else {
        word := ElemWord(e.c, t);
        EmitMapped(e, node, Build5(name, ": ", word, " = ", Build2(EmitExprVal(e, init), ";")));
    }
    ScopePush(*e.scope, MakeRange(n), t, LOCAL_VAR, -1);
}

// Statements inside a control-flow block body: a nested block contributes
// its statements only, because the braces are already open.
EmitStmtBody :: (e: *EmitCtx, stmt: s32) {
    if stmt < 0 { return }
    n := e.ast.nodes[stmt];
    if n.kind == N_BLOCK {
        e.indent += 1;
        child := n.a;
        while child >= 0 {
            EmitStmt(e, child);
            child = e.ast.nodes[child].next;
        }
        e.indent -= 1;
        return;
    }
    e.indent += 1;
    EmitStmt(e, stmt);
    e.indent -= 1;
}

// The root identifier kind of a place chain, for move-versus-copy picks.
RootInfo :: (e: *EmitCtx, node: s32) -> s32 {
    n := e.ast.nodes[node];
    if n.kind == N_IDENT {
        idx := ScopeFindInfo(e, RawSpan(e, node));
        if idx >= 0 { return e.scope.locals[idx].kind }
        return -1;
    }
    if n.kind == N_MEMBER || n.kind == N_INDEX { return RootInfo(e, n.a) }
    return -1;
}

// A return statement. Components draw JSX inline; string results own a
// copy; state records and arrays copy out through a temporary.
EmitReturn :: (e: *EmitCtx, node: s32) {
    n := e.ast.nodes[node];
    v := n.a;
    if v < 0 {
        EmitMapped(e, node, "return;");
        return;
    }
    vn := e.ast.nodes[v];
    if e.comp >= 0 && vn.kind == N_JSX {
        EmitJsx(e, v, "ctx");
        return;
    }
    t := e.c.node_types[v];
    if BaseType(t) == TY_STRING {
        if vn.kind == N_CALL || (vn.kind == N_BINARY && vn.num == OP_ADD) {
            EmitMapped(e, node, Build2("return ", Build2(EmitExprStr(e, v), ";")));
        } else {
            EmitMapped(e, node, Build2("return TextCopy(", Build2(EmitExprStr(e, v), "));")));
            }
            return;
        }
        if BaseType(t) == TY_ARRAY {
            root := RootInfo(e, v);
            if vn.kind == N_CALL && root != LOCAL_STATE_VALUE {
                EmitMapped(e, node, Build2("return ", Build2(EmitExprVal(e, v), ";")));
                return;
            }
            if root == LOCAL_STATE_VALUE {
                elem := ArrayElem(t);
                tmp := FreshName(e, TmpName(e));
                EmitMapped(e, node, Build5(tmp, ": Vec(", ElemWord(e.c, elem), ");", ""));
                src := EmitPlace(e, v);
                i := FreshName(e, "i");
                EmitLine(e, Build2(i, " := 0;"));
                EmitLine(e, Build5("while ", i, " < ", src, ".count {"));
                e.indent += 1;
                src_elem := Build3(src, "[", i);
                if BaseType(elem) == TY_STRING {
                    EmitLine(e, Build5("VecPush(", tmp, ", TextCopy(TextView(", src_elem, "])));"));
                } else if BaseType(elem) == TY_RECORD {
                    EmitLine(e, Build5("VecPush(", tmp, Build3(", t2z_Fresh", RecordName(e.c, RecordIndex(elem)), "(*"), Build2(src_elem, "]"), "));"));
                } else {
                    EmitLine(e, Build5("VecPush(", tmp, ", ", Build2(src_elem, "]"), ");"));
                }
                e.indent -= 1;
                EmitLine(e, Build2(i, " += 1;"));
                EmitLine(e, "}");
                EmitMapped(e, node, Build2("return ", Build2(tmp, ";")));
                return;
            }
            EmitMapped(e, node, Build2("return ", Build2(EmitPlace(e, v), ";")));
            return;
        }
        if BaseType(t) == TY_RECORD {
            root := RootInfo(e, v);
            if vn.kind == N_IDENT && root != LOCAL_STATE_VALUE {
                EmitMapped(e, node, Build2("return ", Build2(EmitPlace(e, v), ";")));
                return;
            }
            if root == LOCAL_STATE_VALUE {
                tmp := FreshName(e, TmpName(e));
                EmitMapped(e, node, Build5(tmp, ": ", RecordName(e.c, RecordIndex(t)), ";", ""));
                EmitLine(e, Build5(Build2("t2z_Copy", RecordName(e.c, RecordIndex(t))), Build3("(*", tmp, ", *"), EmitPlace(e, v), ");", ""));
                EmitMapped(e, node, Build2("return ", Build2(tmp, ";")));
                return;
            }
            tmp := FreshName(e, TmpName(e));
            EmitMapped(e, node, Build5(tmp, ": ", RecordName(e.c, RecordIndex(t)), " = ", Build2(EmitExprVal(e, v), ";")));
            EmitMapped(e, node, Build2("return ", Build2(tmp, ";")));
            return;
        }
        EmitMapped(e, node, Build2("return ", Build2(EmitExprVal(e, v), ";")));
    }

    // Whether a for-of iterates owned storage (state arrays, locals, fresh
    // results) or a borrowed parameter slice.
    ItemsOwned :: (e: *EmitCtx, items: s32) -> bool {
        n := e.ast.nodes[items];
        if n.kind == N_IDENT {
            idx := ScopeFindInfo(e, RawSpan(e, items));
            if idx >= 0 {
                kind := e.scope.locals[idx].kind;
                if kind == LOCAL_STATE_VALUE { return true }
                if kind == LOCAL_VAR { return true }
                return false;
            }
            return false;
        }
        if n.kind == N_CALL { return true }
        if n.kind == N_MEMBER || n.kind == N_INDEX {
            return RootInfo(e, items) == LOCAL_STATE_VALUE;
        }
        return false;
    }

    EmitForOf :: (e: *EmitCtx, node: s32) {
        n := e.ast.nodes[node];
        items := n.a;
        body := n.b;
        name := RawSpan(e, node);
        it_type := e.c.node_types[items];
        elem: s32 = TY_UNKNOWN;
        if BaseType(it_type) == TY_ARRAY { elem = cast(s32)(ArrayElem(it_type)) }
        place := EmitPlace(e, items);
        owned := ItemsOwned(e, items);
        scalar := BaseType(elem) != TY_STRING && BaseType(elem) != TY_RECORD && BaseType(elem) != TY_ARRAY;
        if owned || !scalar {
            EmitMapped(e, node, Build2("for * ", Build2(place, " {")));
            if scalar {
                EmitMapped(e, node, Build2(name, " := <<it;"));
                ScopePush(*e.scope, MakeRange(n), elem, LOCAL_LOOP, -1);
            } else {
                EmitMapped(e, node, Build2(name, " := it;"));
                ScopePush(*e.scope, MakeRange(n), elem, LOCAL_LOOP, -1);
                last := e.scope.locals[e.scope.locals.count - 1];
                last.owned_view = true;
                e.scope.locals[e.scope.locals.count - 1] = last;
            }
            EmitStmtBody(e, body);
            ScopePopTo(*e.scope, e.scope.locals.count - 1);
            EmitLine(e, "}");
            return;
        }
        EmitMapped(e, node, Build2("for ", Build2(place, " {")));
        EmitMapped(e, node, Build2(name, " := it;"));
        ScopePush(*e.scope, MakeRange(n), elem, LOCAL_LOOP, -1);
        EmitStmtBody(e, body);
        ScopePopTo(*e.scope, e.scope.locals.count - 1);
        EmitLine(e, "}");
    }

    // A classic for loop becomes a block with a while inside, so init, update
    // and body keep their exact TS execution order.
    EmitFor :: (e: *EmitCtx, node: s32) {
        n := e.ast.nodes[node];
        mark := e.scope.locals.count;
        EmitMapped(e, node, "{");
        e.indent += 1;
        if n.a >= 0 { EmitStmt(e, n.a) }
        cond := "true";
        if n.b >= 0 { cond = EmitExprVal(e, n.b) }
        EmitLine(e, Build2("while ", Build2(cond, " {")));
        e.indent += 1;
        if n.d >= 0 { EmitStmt(e, n.d) }
        if n.c >= 0 { EmitStmt(e, n.c) }
        e.indent -= 1;
        EmitLine(e, "}");
        e.indent -= 1;
        EmitLine(e, "}");
        ScopePopTo(*e.scope, mark);
    }

    EmitIf :: (e: *EmitCtx, node: s32) {
        n := e.ast.nodes[node];
        EmitMapped(e, node, Build2("if ", Build2(EmitExprVal(e, n.a), " {")));
        EmitStmtBody(e, n.b);
        if n.c >= 0 {
            EmitLine(e, "} else {");
            EmitStmtBody(e, n.c);
        }
        EmitLine(e, "}");
    }

    EmitWhile :: (e: *EmitCtx, node: s32) {
        n := e.ast.nodes[node];
        EmitMapped(e, node, Build2("while ", Build2(EmitExprVal(e, n.a), " {")));
        EmitStmtBody(e, n.b);
        EmitLine(e, "}");
    }

    // The statement dispatcher; mirrors the checker WalkStmt one-to-one,
    // including scope push and pop points.
    EmitStmt :: (e: *EmitCtx, stmt: s32) {
        if stmt < 0 { return }
        n := e.ast.nodes[stmt];
        if n.kind == N_BLOCK {
            mark := e.scope.locals.count;
            EmitLine(e, "{");
            e.indent += 1;
            child := n.a;
            while child >= 0 {
                EmitStmt(e, child);
                child = e.ast.nodes[child].next;
            }
            e.indent -= 1;
            EmitLine(e, "}");
            ScopePopTo(*e.scope, mark);
            return;
        }
        if n.kind == N_VAR { EmitVarDecl(e, stmt); return }
        if n.kind == N_USESTATE { return }
        if n.kind == N_ASSIGN || n.kind == N_COMPOUND { EmitAssign(e, stmt); return }
        if n.kind == N_POSTFIX {
            place := EmitPlace(e, n.a);
            op := "+";
            if n.num == 2 { op = "-" }
            EmitMapped(e, stmt, Build5(place, " = ", Build3(place, Build2(" ", op), " "), "1;", ""));
            return;
        }
        if n.kind == N_IF { EmitIf(e, stmt); return }
        if n.kind == N_WHILE { EmitWhile(e, stmt); return }
        if n.kind == N_FOROF { EmitForOf(e, stmt); return }
        if n.kind == N_FOR { EmitFor(e, stmt); return }
        if n.kind == N_RETURN { EmitReturn(e, stmt); return }
        if n.kind == N_EXPRSTMT {
            if n.a < 0 { return }
            en := e.ast.nodes[n.a];
            if en.kind == N_CALL {
                callee := e.ast.nodes[en.a];
                if callee.kind == N_IDENT {
                    idx := ScopeFindInfo(e, RawSpan(e, en.a));
                    if idx >= 0 && e.scope.locals[idx].kind == LOCAL_STATE_SETTER {
                        EmitSetterStmt(e, n.a);
                        return;
                    }
                }
                EmitMapped(e, stmt, Build2(EmitCallExpr(e, n.a), ";"));
                return;
            }
            if en.kind == N_POSTFIX {
                place := EmitPlace(e, en.a);
                op := "+";
                if en.num == 2 { op = "-" }
                EmitMapped(e, stmt, Build5(place, " = ", Build3(place, Build2(" ", op), " "), "1;", ""));
                return;
            }
            EmitMapped(e, stmt, Build2(EmitExprVal(e, n.a), ";"));
            return;
        }
        if n.kind == N_BREAK { EmitMapped(e, stmt, "break;"); return }
        if n.kind == N_CONTINUE { EmitMapped(e, stmt, "continue;"); return }
    }

    // ---- JSX ---------------------------------------------------------------

    // Arrow-handler scope helper: pushes the arrow parameters, emits an
    // optional binding line, then the body statements.
    EmitHandler :: (e: *EmitCtx, arrow: s32, bind_name: string, bind_line: string, bind_type: s32, kctx: string) {
        if arrow < 0 { return }
        an := e.ast.nodes[arrow];
        mark := e.scope.locals.count;
        p := an.a;
        while p >= 0 {
            pn := e.ast.nodes[p];
            pt: s32 = TY_UNKNOWN;
            if pn.a >= 0 { pt = TypeFromRef(e.c, e.ast, pn.a) }
            ScopePush(*e.scope, MakeRange(pn), pt, LOCAL_ARROW, -1);
            p = pn.next;
        }
        if bind_line != "" {
            EmitMapped(e, arrow, bind_line);
            unused bind_name;
            unused bind_type;
        }
        EmitArrowBody(e, an.b, kctx);
        ScopePopTo(*e.scope, mark);
    }

    // Arrow body: statements plus the JSX a return draws.
    EmitArrowBody :: (e: *EmitCtx, body: s32, kctx: string) {
        if body < 0 { return }
        n := e.ast.nodes[body];
        if n.kind == N_BLOCK {
            stmt := n.a;
            while stmt >= 0 {
                sn := e.ast.nodes[stmt];
                if sn.kind == N_RETURN && sn.a >= 0 && e.ast.nodes[sn.a].kind == N_JSX {
                    EmitMapped(e, stmt, "");
                    EmitJsx(e, sn.a, kctx);
                } else if sn.kind == N_RETURN && sn.a >= 0 {
                    // Widget wiring ignores arrow results: emit the value
                    // as a plain statement, state setters included.
                    vn := e.ast.nodes[sn.a];
                    handled := false;
                    if vn.kind == N_CALL {
                        callee := e.ast.nodes[vn.a];
                        if callee.kind == N_IDENT {
                            idx := ScopeFindInfo(e, RawSpan(e, vn.a));
                            if idx >= 0 && e.scope.locals[idx].kind == LOCAL_STATE_SETTER {
                                EmitSetterStmt(e, sn.a);
                                handled = true;
                            }
                        }
                    }
                    if !handled { EmitMapped(e, stmt, Build2(EmitExprVal(e, sn.a), ";")) }
                } else {
                    EmitStmt(e, stmt);
                }
                stmt = sn.next;
            }
            return;
        }
        EmitStmt(e, body);
    }

    // A JSX child expression rendered as text content.
    EmitChildString :: (e: *EmitCtx, inner: s32) -> string {
        t := e.c.node_types[inner];
        if BaseType(t) == TY_STRING { return EmitExprStr(e, inner) }
        if BaseType(t) == TY_BOOL { return Build2(Build2("t2z_Bool(", EmitExprVal(e, inner)), ")") }
        if t == TY_F64 { return Build2(Build2("t2z_NumF(", EmitExprVal(e, inner)), ")") }
        return Build2(Build2("t2z_Num(", EmitExprVal(e, inner)), ")");
    }

    // Keyed subtrees: an explicit key mixes a hash into a fresh context copy so
    // this element and everything below it keep stable widget identity.
    EmitKeyedContext :: (e: *EmitCtx, node: s32, kctx: string, prefix: string) -> string {
        key_prop := JsxProp(e, node, "key");
        if key_prop < 0 { return kctx }
        kn := e.ast.nodes[key_prop];
        kv := kn.a;
        if kv < 0 { return kctx }
        newname := FreshName(e, "kx");
        kvn := e.ast.nodes[kv];
        EmitMapped(e, key_prop, Build5(newname, " := ", kctx, ";", ""));
        mix: Vec(u8);
        BuilderAppend(mix, newname);
        BuilderAppend(mix, ".key_base = ");
        BuilderAppend(mix, prefix);
        BuilderAppend(mix, ".MixKey(");
        BuilderAppend(mix, newname);
        BuilderAppend(mix, ".key_base, ");
        BuilderAppend(mix, prefix);
        BuilderAppend(mix, ".HashText(");
        if kvn.kind == N_STR {
            BuilderAppend(mix, Build3("\"", EscapeText(e.src[kvn.start:kvn.start + kvn.len]), "\""));
        } else if BaseType(e.c.node_types[kv]) == TY_STRING {
            BuilderAppend(mix, Build3("TextView(", EmitExprVal(e, kv), ")"))
        } else {
            BuilderAppend(mix, Build3("cast(u64)(", EmitExprVal(e, kv), ")"));
        }
        BuilderAppend(mix, "));");
        EmitMapped(e, key_prop, BuilderFinish(mix));
        ScopePush(*e.scope, MakeRange(kvn), TY_UNKNOWN, LOCAL_VAR, -1);
        return newname;
    }

    // Gap prop for Column and Row.
    GapText :: (e: *EmitCtx, node: s32) -> string {
        gap := JsxProp(e, node, "gap");
        if gap < 0 { return "" }
        gn := e.ast.nodes[gap];
        return Build2(", .gap = cast(s32)(", Build2(EmitExprVal(e, gn.a), ")"));
    }

    // Text for a Text/Heading element: the text prop or one trimmed text child.
    ElementText :: (e: *EmitCtx, node: s32) -> string {
        text_prop := JsxProp(e, node, "text");
        if text_prop >= 0 {
            tn := e.ast.nodes[text_prop];
            return EmitExprStr(e, tn.a);
        }
        n := e.ast.nodes[node];
        child := n.a;
        while child >= 0 {
            cn := e.ast.nodes[child];
            if cn.kind == N_JSXCHILD_TEXT {
                trimmed := TrimSpan(e, child);
                if trimmed.count > 0 {
                    return Build3("\"", EscapeText(trimmed), "\"");
                }
            }
            child = cn.next;
        }
        return "\"\"";
    }

    // Props for the element Props literal, after the part number.
    PropsTail :: (e: *EmitCtx, node: s32, part: s64, extra: string) -> string {
        out: Vec(u8);
        BuilderAppend(out, BuildNI(".part = ", part, ""));
        BuilderAppend(out, extra);
        BuilderAppend(out, " }");
        return BuilderFinish(out);
    }

    // Draw one JSX element. Ui primitives map one call each; containers get a
    // deferred End; handlers run inside the widget if block; components draw as
    // Name_Draw with a fresh key context and their slot of the parent state.
    EmitJsx :: (e: *EmitCtx, node: s32, kctx: string) {
        n := e.ast.nodes[node];
        tag := RawSpan(e, node);
        if tag.count == 0 { return }
        dot_at: s64 = -1;
        i: s64 = 0;
        while i < tag.count {
            if tag[i] == cast(u8)46 { dot_at = i }
            i += 1;
        }
        e.part += 1;
        part := e.part;
        if dot_at >= 0 {
            prefix := TextView(tag[0:dot_at]);
            suffix := TextView(tag[dot_at + 1:tag.count]);
            my_k := EmitKeyedContext(e, node, kctx, prefix);
            if suffix == "Column" || suffix == "Row" {
                extra := GapText(e, node);
                props := PropsTail(e, node, part, extra);
                EmitMapped(e, node, Build2(Build5("if ", prefix, ".", suffix, "("), Build2(Build3(my_k, ", ", prefix), Build5(".", suffix, "Props.{", props, ") {"))));
                e.indent += 1;
                EmitLine(e, Build2("defer { ", Build3(prefix, ".End(", Build2(my_k, "); }"))));
                EmitJsxChildren(e, node, my_k, true);
                e.indent -= 1;
                EmitLine(e, "}");
                return;
            }
            if suffix == "Text" || suffix == "Heading" {
                heading := "";
                if suffix == "Heading" { heading = ", .heading = true" }
                text_prop := JsxProp(e, node, "text");
                structural := false;
                text := "\"\"";
                if text_prop >= 0 {
                    tn := e.ast.nodes[text_prop];
                    text = EmitExprStr(e, tn.a);
                } else {
                    child := n.a;
                    while child >= 0 {
                        cn := e.ast.nodes[child];
                        if cn.kind == N_JSXCHILD_TEXT {
                            piece := TrimSpan(e, child);
                            if piece.count > 0 {
                                text = Build5("t2z_Str2(", text, ", ", Build3("\"", EscapeText(piece), "\""), ")");
                            }
                        } else if cn.kind == N_JSXCHILD_EXPR {
                            inner := cn.a;
                            if inner >= 0 && e.ast.nodes[inner].kind == N_JSX {
                                structural = true;
                            } else if inner >= 0 {
                                text = Build5("t2z_Str2(", text, ", ", EmitChildString(e, inner), ")");
                            }
                        } else if cn.kind == N_JSX || cn.kind == N_JSXCHILD_COND || cn.kind == N_JSXCHILD_LIST {
                            structural = true;
                        }
                        child = cn.next;
                    }
                }
                props := PropsTail(e, node, part, Build2(", .text = ", Build2(text, heading)));
                EmitMapped(e, node, Build2(Build5(prefix, ".Text(", my_k, ", ", prefix), Build3(".TextProps.{", props, ");")));
                if structural {
                    EmitJsxChildren(e, node, my_k, false);
                }
                return;
            }
            if suffix == "Separator" {
                props := PropsTail(e, node, part, "");
                EmitMapped(e, node, Build2(Build5(prefix, ".Separator(", my_k, ", ", prefix), Build3(".SeparatorProps.{", props, ");")));
                return;
            }
            if suffix == "Button" {
                text_prop := JsxProp(e, node, "text");
                text := "\"\"";
                if text_prop >= 0 {
                    tn := e.ast.nodes[text_prop];
                    text = EmitExprStr(e, tn.a);
                }
                props := PropsTail(e, node, part, Build2(", .text = ", text));
                EmitMapped(e, node, Build2(Build5("if ", prefix, ".Button(", my_k, ", "), Build2(Build3(prefix, ".ButtonProps.{", props), ") {")));
                e.indent += 1;
                click := JsxProp(e, node, "onClick");
                arrow: s32 = -1;
                if click >= 0 { arrow = cast(s32)(e.ast.nodes[click].a) }
                if arrow >= 0 { EmitHandler(e, arrow, "", "", TY_UNKNOWN, my_k) }
                e.indent -= 1;
                EmitLine(e, "}");
                return;
            }
            if suffix == "Checkbox" {
                checked := JsxProp(e, node, "checked");
                checked_text := "false";
                if checked >= 0 {
                    cn := e.ast.nodes[checked];
                    checked_text = EmitExprVal(e, cn.a);
                }
                props := PropsTail(e, node, part, Build2(", .checked = ", checked_text));
                cb := BuildNI("cb_", part, "");
                EmitMapped(e, node, Build2(Build5(cb, " := ", prefix, ".Checkbox(", my_k), Build2(Build2(", ", prefix), Build3(".CheckboxProps.{", props, ");"))));
                change := JsxProp(e, node, "onChange");
                arrow: s32 = -1;
                if change >= 0 { arrow = cast(s32)(e.ast.nodes[change].a) }
                if arrow >= 0 {
                    EmitLine(e, Build3("if ", cb, ".changed {"));
                    e.indent += 1;
                    an := e.ast.nodes[arrow];
                    bind := "";
                    bind_name := "";
                    pn := an.a;
                    if pn >= 0 {
                        bind_name = RawSpan(e, pn);
                        bind = Build5(bind_name, " := ", cb, ".checked;", "");
                    }
                    EmitHandler(e, arrow, bind_name, bind, TY_BOOL, my_k);
                    e.indent -= 1;
                    EmitLine(e, "}");
                }
                return;
            }
            if suffix == "Input" {
                value := JsxProp(e, node, "value");
                field_name := "";
                if value >= 0 {
                    vn := e.ast.nodes[value];
                    if vn.a >= 0 {
                        vnode := e.ast.nodes[vn.a];
                        if vnode.kind == N_IDENT {
                            idx := ScopeFindInfo(e, RawSpan(e, vn.a));
                            if idx >= 0 && e.scope.locals[idx].kind == LOCAL_STATE_VALUE {
                                f := e.c.state_fields[e.scope.locals[idx].state_index];
                                field_name = StateFieldName(e, f);
                            }
                        }
                    }
                }
                placeholder := "";
                ph := JsxProp(e, node, "placeholder");
                if ph >= 0 {
                    pn2 := e.ast.nodes[ph];
                    placeholder = Build2(", .placeholder = ", EmitExprStr(e, pn2.a));
                }
                props := PropsTail(e, node, part, Build2(Build2(", .field = *", field_name), placeholder));
                input := BuildNI("in_", part, "");
                EmitMapped(e, node, Build2(Build5(input, " := ", prefix, ".Input(", my_k), Build2(Build2(", ", prefix), Build3(".InputProps.{", props, ");"))));
                change := JsxProp(e, node, "onChange");
                arrow: s32 = -1;
                if change >= 0 { arrow = cast(s32)(e.ast.nodes[change].a) }
                if arrow >= 0 && field_name.count > 0 {
                    EmitLine(e, Build3("if ", input, ".committed {"));
                    e.indent += 1;
                    an := e.ast.nodes[arrow];
                    bind := "";
                    bind_name := "";
                    pn3 := an.a;
                    if pn3 >= 0 {
                        bind_name = RawSpan(e, pn3);
                        bind = Build5(bind_name, " := ", prefix, ".FieldText(*", Build2(field_name, ");"));
                }
                EmitHandler(e, arrow, bind_name, bind, TY_STRING, my_k);
                e.indent -= 1;
                EmitLine(e, "}");
            }
            return;
        }
        return;
    }
    if CharIsUpper(tag[0]) {
        comp := FindComponent(e.c, e.src, n.start, n.len);
        if comp < 0 { return }
        comp_info := e.c.components[comp];
        fn_node := e.ast.nodes[comp_info.node];
        my_k := EmitKeyedContext(e, node, kctx, e.ui_prefix);
        cctx := FreshName(e, BuildNI("c_", part, ""));
        EmitMapped(e, node, Build5(cctx, " := ", my_k, ";", ""));
        EmitMapped(e, node, Build5(cctx, ".key_base = ", e.ui_prefix, Build3(".MixKey(", cctx, ".key_base, cast(u64)("), Build2(BuildNI("", part, ""), "));")));
        args := ComponentArgs(e, node, comp);
        draw := Build4(RangeText(e.src, comp_info.name), "_Draw(", cctx, ", ");
        EmitMapped(e, node, Build2(draw, Build4("*state.child_", RangeText(e.src, comp_info.name), args, "));")));
        return;
    }
}

// ---- JSX children ------------------------------------------------------

// Draw the children of a JSX element. Inline mode draws raw text and expression
// children as their own Text widgets (containers); folded mode skips them
// because the parent already concatenated them into its text prop.
EmitJsxChildren :: (e: *EmitCtx, node: s32, kctx: string, inline: bool) {
    n := e.ast.nodes[node];
    child := n.a;
    while child >= 0 {
        cn := e.ast.nodes[child];
        draw := false;
        if cn.kind == N_JSX { draw = true }
        else if cn.kind == N_JSXCHILD_TEXT { draw = inline }
        else if cn.kind == N_JSXCHILD_EXPR {
            inner := cn.a;
            if inner >= 0 && e.ast.nodes[inner].kind == N_JSX { draw = true }
            else { draw = inline && inner >= 0 }
        } else if cn.kind == N_JSXCHILD_COND { draw = true }
        else if cn.kind == N_JSXCHILD_LIST { draw = true }
        if draw {
            if cn.kind == N_JSX {
                EmitJsx(e, child, kctx);
            } else if cn.kind == N_JSXCHILD_TEXT || cn.kind == N_JSXCHILD_EXPR {
                EmitTextChild(e, child, kctx);
            } else if cn.kind == N_JSXCHILD_COND {
                EmitConditionalChild(e, child, kctx);
            } else {
                EmitListChild(e, child, kctx);
            }
        }
        child = cn.next;
    }
}

// One raw text or expression child drawn as its own Text widget.
EmitTextChild :: (e: *EmitCtx, child: s32, kctx: string) {
    cn := e.ast.nodes[child];
    text := "\"\"";
    if cn.kind == N_JSXCHILD_TEXT {
        trimmed := TrimSpan(e, child);
        if trimmed.count > 0 { text = Build3("\"", EscapeText(trimmed), "\"") }
    } else {
        inner := cn.a;
        if inner >= 0 { text = EmitChildString(e, inner) }
    }
    e.part += 1;
    head := Build5(e.ui_prefix, ".Text(", kctx, ", ", Build2(e.ui_prefix, ".TextProps.{"));
    tail := BuildNI(".part = ", e.part, "");
    EmitMapped(e, child, Build2(head, Build4(tail, ", .text = ", text, " });")));
}

// A conditional child: the branch elements draw under a plain if.
EmitConditionalChild :: (e: *EmitCtx, child: s32, kctx: string) {
    cn := e.ast.nodes[child];
    EmitMapped(e, child, Build2("if ", Build2(EmitExprVal(e, cn.a), " {")));
    e.indent += 1;
    if cn.b >= 0 { EmitJsx(e, cn.b, kctx) }
    e.indent -= 1;
    EmitLine(e, "} else {");
    e.indent += 1;
    if cn.c >= 0 { EmitJsx(e, cn.c, kctx) }
    e.indent -= 1;
    EmitLine(e, "}");
}

// A list child: items.map((item, index) => ...) becomes a for loop whose
// body draws the arrow returned element once per item.
EmitListChild :: (e: *EmitCtx, child: s32, kctx: string) {
    cn := e.ast.nodes[child];
    items := cn.a;
    arrow := cn.b;
    if arrow < 0 { return }
    an := e.ast.nodes[arrow];
    place := EmitPlace(e, items);
    items_t := e.c.node_types[items];
    elem: s32 = TY_UNKNOWN;
    if BaseType(items_t) == TY_ARRAY { elem = cast(s32)(ArrayElem(items_t)) }
    owned := ItemsOwned(e, items);
    scalar := BaseType(elem) != TY_STRING && BaseType(elem) != TY_RECORD && BaseType(elem) != TY_ARRAY;
    p0 := an.a;
    p1: s32 = -1;
    if p0 >= 0 { p1 = cast(s32)(e.ast.nodes[p0].next) }
    p0name := "";
    p1name := "";
    if p0 >= 0 { p0name = RawSpan(e, p0) }
    if p1 >= 0 { p1name = RawSpan(e, p1) }
    idx_name := "";
    if p1 >= 0 {
        idx_name = FreshName(e, "idx");
        EmitMapped(e, child, Build2(idx_name, " := 0;"));
    }
    mark := e.scope.locals.count;
    if owned || !scalar {
        EmitMapped(e, child, Build2("for * ", Build2(place, " {")));
        e.indent += 1;
        if scalar {
            EmitMapped(e, child, Build2(p0name, " := <<it;"));
            ScopePush(*e.scope, MakeRange(e.ast.nodes[p0]), elem, LOCAL_ARROW, -1);
        } else {
            EmitMapped(e, child, Build2(p0name, " := it;"));
            ScopePush(*e.scope, MakeRange(e.ast.nodes[p0]), elem, LOCAL_ARROW, -1);
            last := e.scope.locals[e.scope.locals.count - 1];
            last.owned_view = true;
            e.scope.locals[e.scope.locals.count - 1] = last;
        }
        if p1 >= 0 {
            EmitMapped(e, child, Build4(p1name, " := ", idx_name, ";"));
            ScopePush(*e.scope, MakeRange(e.ast.nodes[p1]), TY_S64, LOCAL_ARROW, -1);
        }
        EmitArrowBody(e, an.b, kctx);
        if idx_name.count > 0 { EmitLine(e, Build2(idx_name, " += 1;")) }
        e.indent -= 1;
        EmitLine(e, "}");
    } else {
        EmitMapped(e, child, Build2("for ", Build2(place, " {")));
        e.indent += 1;
        EmitMapped(e, child, Build2(p0name, " := it;"));
        ScopePush(*e.scope, MakeRange(e.ast.nodes[p0]), elem, LOCAL_ARROW, -1);
        if p1 >= 0 {
            EmitMapped(e, child, Build4(p1name, " := ", idx_name, ";"));
            ScopePush(*e.scope, MakeRange(e.ast.nodes[p1]), TY_S64, LOCAL_ARROW, -1);
        }
        EmitArrowBody(e, an.b, kctx);
        if idx_name.count > 0 { EmitLine(e, Build2(idx_name, " += 1;")) }
        e.indent -= 1;
        EmitLine(e, "}");
    }
    ScopePopTo(*e.scope, mark);
}

// Call arguments for a component draw: every parameter prop value in
// order, each borrowing or passing a pointer by its checked type.
ComponentArgs :: (e: *EmitCtx, node: s32, comp: s32) -> string {
    out: Vec(u8);
    comp_info := e.c.components[comp];
    fn_node := e.ast.nodes[comp_info.node];
    param := fn_node.a;
    while param >= 0 {
        pn := e.ast.nodes[param];
        pname := RawSpan(e, param);
        ptype: s32 = TY_UNKNOWN;
        if pn.a >= 0 { ptype = TypeFromRef(e.c, e.ast, pn.a) }
        prop := JsxProp(e, node, pname);
        if prop >= 0 {
            pvn := e.ast.nodes[prop];
            BuilderAppend(out, Build2(", ", EmitArgText(e, pvn.a, ptype)));
        }
        param = pn.next;
    }
    return BuilderFinish(out);
}

// The UI alias: the prefix of the first dotted JSX tag in the program.
PrefixScan :: (e: *EmitCtx, node: s32) {
    if node < 0 { return }
    if e.ui_prefix.count > 0 { return }
    n := e.ast.nodes[node];
    if n.kind == N_JSX {
        tag := RawSpan(e, node);
        i: s64 = 0;
        while i < tag.count {
            if tag[i] == cast(u8)46 {
                e.ui_prefix = TextView(tag[0:i]);
                return;
            }
            i += 1;
        }
    }
    PrefixScan(e, n.a);
    PrefixScan(e, n.b);
    PrefixScan(e, n.c);
    PrefixScan(e, n.d);
    PrefixScan(e, n.next);
}

// ---- interface structs ---------------------------------------------------

EmitRecordStructs :: (e: *EmitCtx) {
    done: Vec(s32);
    i: s32 = 0;
    while i < e.c.records.count { VecPush(done, 0); i += 1 }
    i = 0;
    while i < e.c.records.count {
        EmitRecordStruct(e, i, done[:]);
        i += 1;
    }
}

// One interface struct plus its field-wise copy helpers; nested interfaces
// emit first so every referenced type exists.
EmitRecordStruct :: (e: *EmitCtx, rec: s32, done: []s32) {
    if done[rec] == 1 { return }
    done[rec] = 1;
    info := e.c.records[rec];
    name := RecordName(e.c, rec);
    i: s32 = 0;
    while i < info.fields_count {
        f := e.c.fields[info.fields_from + i];
        if BaseType(f.type) == TY_RECORD { EmitRecordStruct(e, RecordIndex(f.type), done) }
        i += 1;
    }
    EmitMapped(e, info.node, Build4(name, " :: struct {", "", ""));
    e.indent += 1;
    i = 0;
    while i < info.fields_count {
        f := e.c.fields[info.fields_from + i];
        EmitMapped(e, info.node, Build4(RangeText(e.src, f.name), ": ", ValueWord(e.c, f.type), ";"));
        i += 1;
    }
    e.indent -= 1;
    EmitLine(e, "}");
    EmitMapped(e, info.node, Build5("t2z_Copy", name, " :: (dst: *", name, Build2(", src: *", Build2(name, ") {"))));
    e.indent += 1;
    i = 0;
    while i < info.fields_count {
        f := e.c.fields[info.fields_from + i];
        fname := RangeText(e.src, f.name);
        ft := f.type;
        if BaseType(ft) == TY_STRING {
            tmp := FreshName(e, "t2z_cp");
            EmitLine(e, Build5(tmp, " := TextCopy(TextView(src.", fname, "));", ""));
            EmitLine(e, Build5("VecClear(dst.", fname, ".bytes);", "", ""));
            EmitLine(e, Build5("BuilderAppend(dst.", fname, ".bytes, TextView(", tmp, "));"));
        } else if BaseType(ft) == TY_RECORD {
            EmitLine(e, Build5("t2z_Copy", RecordName(e.c, RecordIndex(ft)), "(*dst.", Build2(fname, ", *src."), Build2(fname, ");")));
        } else {
            EmitLine(e, Build5("dst.", fname, " = src.", fname, ";"));
        }
        i += 1;
    }
    e.indent -= 1;
    EmitLine(e, "}");
    EmitMapped(e, info.node, Build5("t2z_Fresh", name, " :: (src: *", name, Build2(") -> ", Build2(name, " {"))));
    e.indent += 1;
    EmitLine(e, Build5("out: ", name, ";", "", ""));
    EmitLine(e, Build5("t2z_Copy", name, "(*out, src);", "", ""));
    EmitLine(e, "return out;");
    e.indent -= 1;
    EmitLine(e, "}");
}

// ---- component state structs ---------------------------------------------

EmitStateStructs :: (e: *EmitCtx) {
    done: Vec(s32);
    i: s32 = 0;
    while i < e.c.components.count { VecPush(done, 0); i += 1 }
    i = 0;
    while i < e.c.components.count {
        EmitStateStruct(e, i, done[:]);
        i += 1;
    }
}

// The components a component draws, in first-use order, itself excluded.
ComponentChildren :: (e: *EmitCtx, comp: s32) -> Vec(s32) {
    info := e.c.components[comp];
    fn_node := e.ast.nodes[info.node];
    scratch: Vec(s32);
    ScanComponentTags(e, fn_node.b, *scratch, comp);
    result: Vec(s32);
    i: s64 = 0;
    while i < scratch.count {
        item := scratch[i];
        seen := false;
        j: s64 = 0;
        while j < result.count {
            if result[j] == item { seen = true }
            j += 1;
        }
        if !seen { VecPush(result, item) }
        i += 1;
    }
    return result;
}

ScanComponentTags :: (e: *EmitCtx, node: s32, out: *Vec(s32), self: s32) {
    if node < 0 { return }
    n := e.ast.nodes[node];
    if n.kind == N_JSX {
        tag := RawSpan(e, node);
        dotted := false;
        i: s64 = 0;
        while i < tag.count {
            if tag[i] == cast(u8)46 { dotted = true }
            i += 1;
        }
        if !dotted && tag.count > 0 && CharIsUpper(tag[0]) {
            comp := FindComponent(e.c, e.src, n.start, n.len);
            if comp >= 0 && comp != self {
                VecPush(<<out, comp)
            }
        }
    }
    ScanComponentTags(e, n.a, out, self);
    ScanComponentTags(e, n.b, out, self);
    ScanComponentTags(e, n.c, out, self);
    ScanComponentTags(e, n.d, out, self);
    ScanComponentTags(e, n.next, out, self);
}

// One state struct, children first so nested state types exist. Strings
// live only in adapter field buffers; everything else is plain storage.
EmitStateStruct :: (e: *EmitCtx, comp: s32, done: []s32) {
    if done[comp] == 1 { return }
    done[comp] = 1;
    children := ComponentChildren(e, comp);
    j: s64 = 0;
    while j < children.count {
        EmitStateStruct(e, children[j], done);
        j += 1;
    }
    info := e.c.components[comp];
    name := RangeText(e.src, info.name);
    EmitMapped(e, info.node, Build4(name, "_State :: struct {", "", ""));
    e.indent += 1;
    i: s32 = 0;
    while i < info.fields_count {
        f := e.c.state_fields[info.fields_from + i];
        fname := RangeText(e.src, f.name);
        t := f.type;
        if BaseType(t) == TY_STRING {
            EmitMapped(e, info.node, Build4(Build3(fname, "_f: ", e.ui_prefix), ".Field;", "", ""));
        } else if BaseType(t) == TY_ARRAY {
            EmitMapped(e, info.node, Build5(fname, ": Vec(", ElemWord(e.c, ArrayElem(t)), ");", ""));
        } else if BaseType(t) == TY_RECORD {
            EmitMapped(e, info.node, Build5(fname, ": ", RecordName(e.c, RecordIndex(t)), ";", ""));
        } else {
            EmitMapped(e, info.node, Build5(fname, ": ", ElemWord(e.c, t), ";", ""));
        }
        i += 1;
    }
    j = 0;
    while j < children.count {
        cname := RangeText(e.src, e.c.components[children[j]].name);
        EmitMapped(e, info.node, Build5("child_", cname, ": ", Build2(cname, "_State;"), ""));
        j += 1;
    }
    e.indent -= 1;
    EmitLine(e, "}");
}

// ---- component draws ------------------------------------------------------

// One component draw function: seeds state on the first frame, then draws
// the body JSX exactly once per call.
EmitComponentDraw :: (e: *EmitCtx, comp: s32) {
    info := e.c.components[comp];
    fn_node := e.ast.nodes[info.node];
    name := RangeText(e.src, info.name);
    e.comp = comp;
    sig: Vec(u8);
    BuilderAppend(sig, name);
    BuilderAppend(sig, Build4("_Draw :: (ctx: ", e.ui_prefix, ".Context, state: *", ""));
    BuilderAppend(sig, name);
    BuilderAppend(sig, "_State");
    param := fn_node.a;
    while param >= 0 {
        pn := e.ast.nodes[param];
        pt: s32 = TY_UNKNOWN;
        if pn.a >= 0 { pt = TypeFromRef(e.c, e.ast, pn.a) }
        BuilderAppend(sig, Build4(", ", RawSpan(e, param), ": ", ParamWord(e.c, pt)));
        param = pn.next;
    }
    BuilderAppend(sig, ") {");
    EmitMapped(e, info.node, BuilderFinish(sig));
    e.indent += 1;
    if info.fields_count > 0 {
        EmitLine(e, "if ctx.first {");
        e.indent += 1;
        i: s32 = 0;
        while i < info.fields_count {
            f := e.c.state_fields[info.fields_from + i];
            if f.init >= 0 {
                fname := RangeText(e.src, f.name);
                t := f.type;
                if BaseType(t) == TY_STRING {
                    EmitMapped(e, f.init, Build5(Build2(e.ui_prefix, ".FieldSeed(*state."), Build2(fname, "_f"), ", ", EmitExprStr(e, f.init), ");"));
                } else if BaseType(t) == TY_ARRAY {
                    EmitArrayValue(e, f.init, Build2("state.", fname), ArrayElem(t));
                } else if BaseType(t) == TY_RECORD {
                    EmitRecordValue(e, f.init, Build2("state.", fname), RecordIndex(t));
                } else {
                    EmitMapped(e, f.init, Build5("state.", Build2(fname, " = "), EmitExprVal(e, f.init), ";", ""));
                }
            }
            i += 1;
        }
        e.indent -= 1;
        EmitLine(e, "}");
    }
    mark := e.scope.locals.count;
    fi: s32 = 0;
    while fi < info.fields_count {
        f := e.c.state_fields[info.fields_from + fi];
        ScopePush(*e.scope, f.name, f.type, LOCAL_STATE_VALUE, info.fields_from + fi);
        ScopePush(*e.scope, f.setter, TY_VOID, LOCAL_STATE_SETTER, info.fields_from + fi);
        fi += 1;
    }
    param = fn_node.a;
    while param >= 0 {
        pn := e.ast.nodes[param];
        pt: s32 = TY_UNKNOWN;
        if pn.a >= 0 { pt = TypeFromRef(e.c, e.ast, pn.a) }
        ScopePush(*e.scope, MakeRange(pn), pt, LOCAL_PARAM, -1);
        param = pn.next;
    }
    e.part = 0;
    EmitArrowBody(e, fn_node.b, "ctx");
    ScopePopTo(*e.scope, mark);
    e.indent -= 1;
    EmitLine(e, "}");
    e.comp = -1;
}

// ---- functions and the program --------------------------------------------

// One author function. main moves under an internal name and gains the
// exported argc/argv wrapper the toolchain expects.
EmitFunction :: (e: *EmitCtx, fn_index: s32) {
    fn := e.c.functions[fn_index];
    fn_node := e.ast.nodes[fn.node];
    name := RangeText(e.src, fn.name);
    ret := RetWord(e.c, fn.ret);
    e.comp = -1;
    mark := e.scope.locals.count;
    params: Vec(u8);
    i: s32 = 0;
    while i < fn.params_count {
        p := e.c.params[fn.params_from + i];
        ScopePush(*e.scope, p.name, p.type, LOCAL_PARAM, -1);
        if i > 0 { BuilderAppend(params, ", ") }
        BuilderAppend(params, Build3(RangeText(e.src, p.name), ": ", ParamWord(e.c, p.type)));
        i += 1;
    }
    params_text := BuilderFinish(params);
    e.part = 0;
    if name == "main" {
        head: Vec(u8);
        BuilderAppend(head, "t2z_main :: (");
        BuilderAppend(head, params_text);
        BuilderAppend(head, ")");
        if ret.count > 0 { BuilderAppend(head, Build2(" -> ", ret)) }
        BuilderAppend(head, " {");
        EmitMapped(e, fn.node, BuilderFinish(head));
        e.indent += 1;
        EmitStmtBody(e, fn_node.b);
        e.indent -= 1;
        EmitLine(e, "}");
        EmitMapped(e, fn.node, "#program_export");
        EmitMapped(e, fn.node, "main :: (argc: s32, argv: **u8) -> s32 {");
        e.indent += 1;
        EmitLine(e, "unused argc;");
        EmitLine(e, "unused argv;");
        if ret.count > 0 {
            EmitMapped(e, fn.node, "v := t2z_main();");
            EmitMapped(e, fn.node, "return cast(s32)(v);");
        } else {
            EmitMapped(e, fn.node, "t2z_main();");
            EmitMapped(e, fn.node, "return 0;");
        }
        e.indent -= 1;
        EmitLine(e, "}");
    } else {
        head: Vec(u8);
        BuilderAppend(head, name);
        BuilderAppend(head, " :: (");
        BuilderAppend(head, params_text);
        BuilderAppend(head, ")");
        if ret.count > 0 { BuilderAppend(head, Build2(" -> ", ret)) }
        BuilderAppend(head, " {");
        EmitMapped(e, fn.node, BuilderFinish(head));
        e.indent += 1;
        EmitStmtBody(e, fn_node.b);
        e.indent -= 1;
        EmitLine(e, "}");
    }
    ScopePopTo(*e.scope, mark);
}

// The whole generated file: imports, text helpers, interface structs with
// copy helpers, state structs, then functions and draws in source order.
EmitRun :: (e: *EmitCtx, program: s32) -> string {
    PrefixScan(e, program);
    if e.ui_prefix.count == 0 { e.ui_prefix = "Ui" }
    AppendText(e, "// Generated by tsx2zi from a .tsx source. Edit the source, not this file.");
    LineEnd(e);
    AppendText(e, "// The sibling sourcemap JSON maps each listed generated line to TSX line and column.");
    LineEnd(e);
    prog := e.ast.nodes[program];
    decl := prog.a;
    while decl >= 0 {
        n := e.ast.nodes[decl];
        if n.kind == N_IMPORT {
            names := n.a;
            alias := "";
            if names >= 0 { alias = RawSpan(e, names) }
            spec := TextView(e.src[n.start:n.start + n.len]);
            EmitMapped(e, decl, Build5(alias, " :: #import \"", spec, "\";", ""));
        }
        decl = n.next;
    }
    EmitLine(e, "t2z_Str2 :: (a: string, b: string) -> Text {");
    e.indent += 1;
    EmitLine(e, "out: Vec(u8)");
    EmitLine(e, "BuilderAppend(out, a)");
    EmitLine(e, "BuilderAppend(out, b)");
    EmitLine(e, "return BuilderFinish(out)");
    e.indent -= 1;
    EmitLine(e, "}");
    EmitLine(e, "t2z_Str3 :: (a: string, b: string, c: string) -> Text {");
    e.indent += 1;
    EmitLine(e, "out: Vec(u8)");
    EmitLine(e, "BuilderAppend(out, a)");
    EmitLine(e, "BuilderAppend(out, b)");
    EmitLine(e, "BuilderAppend(out, c)");
    EmitLine(e, "return BuilderFinish(out)");
    e.indent -= 1;
    EmitLine(e, "}");
    EmitLine(e, "t2z_Str4 :: (a: string, b: string, c: string, d: string) -> Text {");
    e.indent += 1;
    EmitLine(e, "out: Vec(u8)");
    EmitLine(e, "BuilderAppend(out, a)");
    EmitLine(e, "BuilderAppend(out, b)");
    EmitLine(e, "BuilderAppend(out, c)");
    EmitLine(e, "BuilderAppend(out, d)");
    EmitLine(e, "return BuilderFinish(out)");
    e.indent -= 1;
    EmitLine(e, "}");
    EmitLine(e, "t2z_Num :: (v: s64) -> Text {");
    e.indent += 1;
    EmitLine(e, "out: Vec(u8)");
    EmitLine(e, "BuilderPrint(*out, \"%\", v)");
    EmitLine(e, "return BuilderFinish(out)");
    e.indent -= 1;
    EmitLine(e, "}");
    EmitLine(e, "t2z_NumF :: (v: float64) -> Text {");
    e.indent += 1;
    EmitLine(e, "out: Vec(u8)");
    EmitLine(e, "BuilderPrint(*out, \"%\", v)");
    EmitLine(e, "return BuilderFinish(out)");
    e.indent -= 1;
    EmitLine(e, "}");
    EmitLine(e, "t2z_Bool :: (v: bool) -> Text {");
    e.indent += 1;
    EmitLine(e, "if v { return TextCopy(\"true\") }");
    EmitLine(e, "return TextCopy(\"false\")");
    e.indent -= 1;
    EmitLine(e, "}");
    EmitRecordStructs(e);
    EmitStateStructs(e);
    decl = prog.a;
    while decl >= 0 {
        n := e.ast.nodes[decl];
        if n.kind == N_FN {
            ci := FindComponent(e.c, e.src, n.start, n.len);
            fi := FindFunction(e.c, e.src, n.start, n.len);
            if ci >= 0 {
                EmitComponentDraw(e, ci);
            } else if fi >= 0 {
                EmitFunction(e, fi);
            }
        }
        decl = n.next;
    }
    return TextView(e.out[:]);
}

// Sourcemap JSON: one [generated_line, tsx_line, tsx_column] triple per
// mapped generated line.
MapsJson :: (e: *EmitCtx) -> string {
    out: Vec(u8);
    BuilderAppend(out, "[");
    i: s64 = 0;
    while i < e.map_lines.count {
        if i > 0 { BuilderAppend(out, ", ") }
        BuilderAppend(out, "[");
        BuilderPrint(*out, "%", e.map_lines[i]);
        BuilderAppend(out, ", ");
        BuilderPrint(*out, "%", e.map_srcs[i * 2]);
        BuilderAppend(out, ", ");
        BuilderPrint(*out, "%", e.map_srcs[i * 2 + 1]);
        BuilderAppend(out, "]");
        i += 1;
    }
    BuilderAppend(out, "]");
    return BuilderFinish(out);
}
