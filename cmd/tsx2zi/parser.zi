// Recursive-descent parser for the supported TS/TSX subset. JSX elements are
// parsed only in JSX-allowed expression modes; object literals parse only
// where an expression (not a statement block) is expected.

#scope_module

MODE_PLAIN :: 0;
MODE_OBJ :: 1;
MODE_JSX :: 2;

OP_ADD :: 43;
OP_SUB :: 45;
OP_MUL :: 42;
OP_DIV :: 47;
OP_MOD :: 37;
OP_EQ :: 101;
OP_NE :: 102;
OP_LT :: 60;
OP_GT :: 62;
OP_LE :: 130;
OP_GE :: 131;
OP_AND :: 132;
OP_OR :: 133;

P_NUM :: 1;
P_F64 :: 2;
P_BOOL :: 3;
P_STR :: 4;
P_VOID :: 5;

Parser :: struct {
    lx: *Lexer;
    ast: *Ast;
    diags: *Diags;
    failed: bool;
    skip_start: s64;
    skip_end: s64;
}

ParserInit :: (p: *Parser, lx: *Lexer, ast: *Ast, diags: *Diags) {
    p.lx = lx;
    p.ast = ast;
    p.diags = diags;
    p.failed = false;
    p.skip_start = -1;
    p.skip_end = -1;
}

Cur :: (p: *Parser) -> Token {
    return p.lx.tok;
}

Advance :: (p: *Parser) -> Token {
    return LexNext(p.lx);
}

Fail :: (p: *Parser, tok: Token, text: string) {
    if p.failed { return }
    DiagsAppend(p.diags, tok.line, tok.col, text);
    p.failed = true;
}

FailHere :: (p: *Parser, text: string) {
    Fail(p, p.lx.tok, text);
}

Check :: (p: *Parser, kind: s32, what: string) -> bool {
    if p.lx.tok.kind != kind {
        FailHere(p, Join("expected ", what));
        return false;
    }
    return true;
}

Eat :: (p: *Parser, kind: s32) -> bool {
    if p.lx.tok.kind == kind {
        unused Advance(p);
        return true;
    }
    return false;
}

IdentText :: (src: string, tok: Token) -> string {
    return TextView(src[tok.start:tok.start + tok.len]);
}


MakeNode :: (p: *Parser, kind: s32, tok: Token) -> s32 {
    return AstNewNode(p.ast, kind, tok.line, tok.col);
}

// Speculative lookahead: type arguments never contain string literals, so
// the token pool stays untouched across a mark and rewind.
ScanTypeArgsCall :: (lx: *Lexer) -> bool {
    mark := LexMark(lx);
    if lx.tok.kind != T_LT { LexRewind(lx, mark); return false }
    // The current '<' opens the outermost group. Type arguments may only
    // contain names, dots, brackets, commas and nested generics, so a
    // comparison like a < b && c > (d) never matches.
    depth: s32 = 1;
    matched := false;
    while !matched {
        tok := LexNext(lx);
        if tok.kind == T_LT { depth += 1; continue }
        if tok.kind == T_GT {
            depth -= 1;
            if depth == 0 {
                after := LexNext(lx);
                matched = after.kind == T_LPAREN;
                break;
            }
            continue;
        }
        if tok.kind != T_IDENT && tok.kind != T_DOT && tok.kind != T_LBRACKET && tok.kind != T_RBRACKET && tok.kind != T_COMMA {
            break;
        }
    }
    LexRewind(lx, mark);
    return matched;
}

SkipTypeArgs :: (p: *Parser) -> bool {
    if p.lx.tok.kind != T_LT { return false }
    depth: s32 = 0;
    p.skip_start = p.lx.tok.start;
    p.skip_end = -1;
    while true {
        if p.lx.tok.kind == T_LT { depth += 1 }
        else if p.lx.tok.kind == T_GT {
            depth -= 1;
            if depth == 0 {
                p.skip_end = p.lx.tok.start + p.lx.tok.len;
                unused Advance(p);
                return true;
            }
        }
        else if p.lx.tok.kind == T_EOF {
            FailHere(p, "unterminated type arguments");
            return false;
        }
        p.skip_end = p.lx.tok.start + p.lx.tok.len;
        unused Advance(p);
    }
}

ParseProgram :: (p: *Parser) -> s32 {
    first := Cur(p);
    program := MakeNode(p, N_PROGRAM, first);
    while Cur(p).kind != T_EOF {
        decl := ParseTopDecl(p);
        if decl < 0 { break }
        AstLink(p.ast, program, decl);
    }
    return program;
}

ParseTopDecl :: (p: *Parser) -> s32 {
    tok := Cur(p);
    exported := false;
    if tok.kind == T_KW_EXPORT {
        unused Advance(p);
        exported = true;
        tok = Cur(p);
    }
    if tok.kind == T_KW_IMPORT { return ParseImport(p) }
    if tok.kind == T_KW_INTERFACE { return ParseInterface(p, exported) }
    if tok.kind == T_KW_TYPE { return ParseTypealias(p, exported) }
    if tok.kind == T_KW_FUNCTION { return ParseFunction(p, exported) }
    FailHere(p, "expected an import, interface, type alias or function");
    return -1;
}

ParseImport :: (p: *Parser) -> s32 {
    tok := Cur(p);
    node := MakeNode(p, N_IMPORT, tok);
    unused Advance(p);
    if !Check(p, T_LBRACE, "'{'") { return -1 }
    unused Advance(p);
    while Cur(p).kind != T_RBRACE {
        name_tok := Cur(p);
        if name_tok.kind != T_IDENT {
            FailHere(p, "expected an imported name");
            return -1;
        }
        name := MakeNode(p, N_IMPORTNAME, name_tok);
        p.ast.nodes[name].start = name_tok.start;
        p.ast.nodes[name].len = name_tok.len;
        AstLink(p.ast, node, name);
        unused Advance(p);
        if !Eat(p, T_COMMA) { break }
    }
    if !Check(p, T_RBRACE, "'}'") { return -1 }
    unused Advance(p);
    if !Check(p, T_KW_FROM, "from") { return -1 }
    unused Advance(p);
    if !Check(p, T_STR, "a module path string") { return -1 }
    spec := Cur(p);
    p.ast.nodes[node].start = spec.start;
    p.ast.nodes[node].len = spec.len;
    unused Advance(p);
    unused Eat(p, T_SEMI);
    return node;
}

ParseInterface :: (p: *Parser, exported: bool) -> s32 {
    tok := Cur(p);
    node := MakeNode(p, N_INTERFACE, tok);
    if exported { p.ast.nodes[node].d = 1 }
    unused Advance(p);
    if !Check(p, T_IDENT, "an interface name") { return -1 }
    p.ast.nodes[node].start = Cur(p).start;
    p.ast.nodes[node].len = Cur(p).len;
    unused Advance(p);
    if !Check(p, T_LBRACE, "'{'") { return -1 }
    unused Advance(p);
    while Cur(p).kind != T_RBRACE {
        field_tok := Cur(p);
        if field_tok.kind != T_IDENT {
            FailHere(p, "expected a field name");
            return -1;
        }
        field := MakeNode(p, N_FIELD, field_tok);
        p.ast.nodes[field].start = field_tok.start;
        p.ast.nodes[field].len = field_tok.len;
        unused Advance(p);
        if !Check(p, T_COLON, "':'") { return -1 }
        unused Advance(p);
        field_type := ParseType(p);
        if field_type < 0 { return -1 }
        p.ast.nodes[field].a = field_type;
        AstLink(p.ast, node, field);
        unused Eat(p, T_SEMI);
        unused Eat(p, T_COMMA);
    }
    if !Check(p, T_RBRACE, "'}'") { return -1 }
    unused Advance(p);
    return node;
}

ParseTypealias :: (p: *Parser, exported: bool) -> s32 {
    tok := Cur(p);
    node := MakeNode(p, N_TYPEALIAS, tok);
    if exported { p.ast.nodes[node].d = 1 }
    unused Advance(p);
    if !Check(p, T_IDENT, "a type name") { return -1 }
    p.ast.nodes[node].start = Cur(p).start;
    p.ast.nodes[node].len = Cur(p).len;
    unused Advance(p);
    if !Check(p, T_ASSIGN, "=") { return -1 }
    unused Advance(p);
    target := ParseType(p);
    if target < 0 { return -1 }
    p.ast.nodes[node].a = target;
    unused Eat(p, T_SEMI);
    return node;
}

ParseType :: (p: *Parser) -> s32 {
    tok := Cur(p);
    node: s32 = -1;
    if tok.kind == T_IDENT {
        text := IdentText(p.lx.src, tok);
        if text == "number" {
            node = MakeNode(p, N_TREF_PRIM, tok);
            p.ast.nodes[node].num = P_NUM;
        } else if text == "f64" {
            node = MakeNode(p, N_TREF_PRIM, tok);
            p.ast.nodes[node].num = P_F64;
        } else if text == "boolean" {
            node = MakeNode(p, N_TREF_PRIM, tok);
            p.ast.nodes[node].num = P_BOOL;
        } else if text == "string" {
            node = MakeNode(p, N_TREF_PRIM, tok);
            p.ast.nodes[node].num = P_STR;
        } else if text == "void" {
            node = MakeNode(p, N_TREF_VOID, tok);
        } else if text == "Array" {
            unused Advance(p);
            if !Check(p, T_LT, "'<'") { return -1 }
            unused Advance(p);
            element := ParseType(p);
            if element < 0 { return -1 }
            if !Check(p, T_GT, "'>'") { return -1 }
            unused Advance(p);
            array := AstNewNode(p.ast, N_TREF_ARRAY, tok.line, tok.col);
            AstLink(p.ast, array, element);
            return array;
        } else {
            node = MakeNode(p, N_TREF_NAMED, tok);
            p.ast.nodes[node].start = tok.start;
            p.ast.nodes[node].len = tok.len;
        }
        unused Advance(p);
    } else {
        FailHere(p, "expected a type");
        return -1;
    }
    while Eat(p, T_LBRACKET) {
        if !Check(p, T_RBRACKET, "']'") { return -1 }
        unused Advance(p);
        array := AstNewNode(p.ast, N_TREF_ARRAY, tok.line, tok.col);
        AstLink(p.ast, array, node);
        node = array;
    }
    return node;
}

ParseFunction :: (p: *Parser, exported: bool) -> s32 {
    tok := Cur(p);
    node := MakeNode(p, N_FN, tok);
    if exported { p.ast.nodes[node].d = p.ast.nodes[node].d | 1 }
    unused Advance(p);
    if !Check(p, T_IDENT, "a function name") { return -1 }
    p.ast.nodes[node].start = Cur(p).start;
    p.ast.nodes[node].len = Cur(p).len;
    unused Advance(p);
    if !Check(p, T_LPAREN, "'('") { return -1 }
    unused Advance(p);
    while Cur(p).kind != T_RPAREN {
        param_tok := Cur(p);
        if param_tok.kind != T_IDENT {
            FailHere(p, "expected a parameter name");
            return -1;
        }
        param := MakeNode(p, N_PARAM, param_tok);
        p.ast.nodes[param].start = param_tok.start;
        p.ast.nodes[param].len = param_tok.len;
        unused Advance(p);
        if !Check(p, T_COLON, "':' (parameters need type annotations)") { return -1 }
        unused Advance(p);
        param_type := ParseType(p);
        if param_type < 0 { return -1 }
        p.ast.nodes[param].a = param_type;
        AstLink(p.ast, node, param);
        if !Eat(p, T_COMMA) { break }
    }
    if !Check(p, T_RPAREN, "')'") { return -1 }
    unused Advance(p);
    if Eat(p, T_COLON) {
        ret := ParseType(p);
        if ret < 0 { return -1 }
        p.ast.nodes[node].c = ret;
    }
    body := ParseBlock(p);
    if body < 0 { return -1 }
    p.ast.nodes[node].b = body;
    return node;
}

ParseBlock :: (p: *Parser) -> s32 {
    tok := Cur(p);
    node := MakeNode(p, N_BLOCK, tok);
    if !Check(p, T_LBRACE, "'{'") { return -1 }
    unused Advance(p);
    while Cur(p).kind != T_RBRACE && Cur(p).kind != T_EOF {
        stmt := ParseStatement(p);
        if stmt < 0 { return -1 }
        AstLink(p.ast, node, stmt);
    }
    if !Check(p, T_RBRACE, "'}'") { return -1 }
    unused Advance(p);
    return node;
}

ParseStatement :: (p: *Parser) -> s32 {
    tok := Cur(p);
    if tok.kind == T_KW_CONST || tok.kind == T_KW_LET { return ParseVarDecl(p) }
    if tok.kind == T_KW_RETURN {
        node := MakeNode(p, N_RETURN, tok);
        unused Advance(p);
        if Cur(p).kind != T_SEMI && Cur(p).kind != T_RBRACE && Cur(p).kind != T_EOF {
            value := ParseExpression(p, MODE_JSX);
            if value < 0 { return -1 }
            p.ast.nodes[node].a = value;
        }
        unused Eat(p, T_SEMI);
        return node;
    }
    if tok.kind == T_KW_IF {
        node := MakeNode(p, N_IF, tok);
        unused Advance(p);
        if !Check(p, T_LPAREN, "'('") { return -1 }
        unused Advance(p);
        cond := ParseExpression(p, MODE_PLAIN);
        if cond < 0 { return -1 }
        p.ast.nodes[node].a = cond;
        if !Check(p, T_RPAREN, "')'") { return -1 }
        unused Advance(p);
        then_stmt := ParseStatement(p);
        if then_stmt < 0 { return -1 }
        p.ast.nodes[node].b = then_stmt;
        if Eat(p, T_KW_ELSE) {
            other := ParseStatement(p);
            if other < 0 { return -1 }
            p.ast.nodes[node].c = other;
        }
        return node;
    }
    if tok.kind == T_KW_FOR { return ParseFor(p) }
    if tok.kind == T_KW_WHILE {
        node := MakeNode(p, N_WHILE, tok);
        unused Advance(p);
        if !Check(p, T_LPAREN, "'('") { return -1 }
        unused Advance(p);
        cond := ParseExpression(p, MODE_PLAIN);
        if cond < 0 { return -1 }
        p.ast.nodes[node].a = cond;
        if !Check(p, T_RPAREN, "')'") { return -1 }
        unused Advance(p);
        body := ParseStatement(p);
        if body < 0 { return -1 }
        p.ast.nodes[node].b = body;
        return node;
    }
    if tok.kind == T_KW_BREAK {
        node := MakeNode(p, N_BREAK, tok);
        unused Advance(p);
        unused Eat(p, T_SEMI);
        return node;
    }
    if tok.kind == T_KW_CONTINUE {
        node := MakeNode(p, N_CONTINUE, tok);
        unused Advance(p);
        unused Eat(p, T_SEMI);
        return node;
    }
    if tok.kind == T_LBRACE { return ParseBlock(p) }
    value := ParseExpression(p, MODE_PLAIN);
    if value < 0 { return -1 }
    tok = Cur(p);
    if tok.kind == T_ASSIGN || tok.kind == T_PLUSASSIGN || tok.kind == T_MINUSASSIGN {
        value_node := p.ast.nodes[value];
        if value_node.kind != N_IDENT && value_node.kind != N_MEMBER && value_node.kind != N_INDEX {
            Fail(p, tok, "assignment target must be a variable, field or element");
            return -1;
        }
        return ParseAssignTail(p, tok, value);
    }
    stmt := AstNewNode(p.ast, N_EXPRSTMT, tok.line, tok.col);
    p.ast.nodes[stmt].a = value;
    unused Eat(p, T_SEMI);
    return stmt;
}

ParseAssignTail :: (p: *Parser, op_tok: Token, target: s32) -> s32 {
    kind: s32 = N_ASSIGN;
    op: s64 = 0;
    if op_tok.kind == T_PLUSASSIGN { kind = N_COMPOUND; op = OP_ADD }
    if op_tok.kind == T_MINUSASSIGN { kind = N_COMPOUND; op = OP_SUB }
    node := AstNewNode(p.ast, kind, op_tok.line, op_tok.col);
    p.ast.nodes[node].a = target;
    p.ast.nodes[node].num = op;
    unused Advance(p);
    rhs := ParseExpression(p, MODE_OBJ);
    if rhs < 0 { return -1 }
    p.ast.nodes[node].b = rhs;
    unused Eat(p, T_SEMI);
    return node;
}

ParseVarDecl :: (p: *Parser) -> s32 {
    tok := Cur(p);
    unused Advance(p);
    if Cur(p).kind == T_LBRACKET {
        return ParseUseState(p, tok);
    }
    name_tok := Cur(p);
    if !Check(p, T_IDENT, "a variable name") { return -1 }
    node := MakeNode(p, N_VAR, tok);
    p.ast.nodes[node].start = name_tok.start;
    p.ast.nodes[node].len = name_tok.len;
    if tok.kind == T_KW_CONST { p.ast.nodes[node].num = 1 }
    unused Advance(p);
    if Eat(p, T_COLON) {
        var_type := ParseType(p);
        if var_type < 0 { return -1 }
        p.ast.nodes[node].a = var_type;
    }
    if !Check(p, T_ASSIGN, "= (variables need initializers)") { return -1 }
    unused Advance(p);
    init := ParseExpression(p, MODE_OBJ);
    if init < 0 { return -1 }
    p.ast.nodes[node].b = init;
    unused Eat(p, T_SEMI);
    return node;
}

ParseUseState :: (p: *Parser, kw: Token) -> s32 {
    node := MakeNode(p, N_USESTATE, kw);
    if !Check(p, T_LBRACKET, "'['") { return -1 }
    unused Advance(p);
    value_tok := Cur(p);
    if !Check(p, T_IDENT, "a state variable name") { return -1 }
    p.ast.nodes[node].start = value_tok.start;
    p.ast.nodes[node].len = value_tok.len;
    unused Advance(p);
    if !Check(p, T_COMMA, "','") { return -1 }
    unused Advance(p);
    setter_tok := Cur(p);
    if !Check(p, T_IDENT, "a setter name") { return -1 }
    p.ast.nodes[node].x = setter_tok.start;
    p.ast.nodes[node].y = setter_tok.len;
    unused Advance(p);
    if !Check(p, T_RBRACKET, "']'") { return -1 }
    unused Advance(p);
    if !Check(p, T_ASSIGN, "=") { return -1 }
    unused Advance(p);
    call := ParseExpression(p, MODE_OBJ);
    if call < 0 { return -1 }
    p.ast.nodes[node].a = call;
    unused Eat(p, T_SEMI);
    return node;
}

ParseFor :: (p: *Parser) -> s32 {
    tok := Cur(p);
    unused Advance(p);
    if !Check(p, T_LPAREN, "'('") { return -1 }
    unused Advance(p);
    if Cur(p).kind == T_KW_CONST || Cur(p).kind == T_KW_LET {
        decl_tok := Cur(p);
        unused Advance(p);
        name_tok := Cur(p);
        if !Check(p, T_IDENT, "a loop variable name") { return -1 }
        if Cur(p).kind == T_KW_OF {
            node := AstNewNode(p.ast, N_FOROF, decl_tok.line, decl_tok.col);
            p.ast.nodes[node].start = name_tok.start;
            p.ast.nodes[node].len = name_tok.len;
            unused Advance(p);
            unused Advance(p);
            items := ParseExpression(p, MODE_PLAIN);
            if items < 0 { return -1 }
            p.ast.nodes[node].a = items;
            if !Check(p, T_RPAREN, "')'") { return -1 }
            unused Advance(p);
            body := ParseStatement(p);
            if body < 0 { return -1 }
            p.ast.nodes[node].b = body;
            return node;
        }
        init := MakeNode(p, N_VAR, decl_tok);
        p.ast.nodes[init].start = name_tok.start;
        p.ast.nodes[init].len = name_tok.len;
        unused Advance(p);
        if Eat(p, T_COLON) {
            var_type := ParseType(p);
            if var_type < 0 { return -1 }
            p.ast.nodes[init].a = var_type;
        }
        if !Check(p, T_ASSIGN, "= (classic for loops declare a counter)") { return -1 }
        unused Advance(p);
        value := ParseExpression(p, MODE_OBJ);
        if value < 0 { return -1 }
        p.ast.nodes[init].b = value;
        return ParseForTail(p, tok, init);
    }
    if Cur(p).kind == T_SEMI {
        empty := AstNewNode(p.ast, N_EXPRSTMT, tok.line, tok.col);
        p.ast.nodes[empty].a = -1;
        return ParseForTail(p, tok, empty);
    }
    init := ParseSimpleStatement(p);
    if init < 0 { return -1 }
    return ParseForTail(p, tok, init);
}

ParseForTail :: (p: *Parser, for_tok: Token, init: s32) -> s32 {
    node := AstNewNode(p.ast, N_FOR, for_tok.line, for_tok.col);
    p.ast.nodes[node].a = init;
    if !Check(p, T_SEMI, "';'") { return -1 }
    unused Advance(p);
    if Cur(p).kind != T_SEMI {
        cond := ParseExpression(p, MODE_PLAIN);
        if cond < 0 { return -1 }
        p.ast.nodes[node].b = cond;
    }
    if !Check(p, T_SEMI, "';'") { return -1 }
    unused Advance(p);
    if Cur(p).kind != T_RPAREN {
        update := ParseSimpleStatement(p);
        if update < 0 { return -1 }
        p.ast.nodes[node].c = update;
    }
    if !Check(p, T_RPAREN, "')'") { return -1 }
    unused Advance(p);
    body := ParseStatement(p);
    if body < 0 { return -1 }
    p.ast.nodes[node].d = body;
    return node;
}

// A for-header statement: a declaration, an assignment, an increment or a
// plain expression. No trailing semicolon is consumed.
ParseSimpleStatement :: (p: *Parser) -> s32 {
    tok := Cur(p);
    if tok.kind == T_KW_CONST || tok.kind == T_KW_LET {
        unused Advance(p);
        name_tok := Cur(p);
        if !Check(p, T_IDENT, "a variable name") { return -1 }
        node := MakeNode(p, N_VAR, tok);
        p.ast.nodes[node].start = name_tok.start;
        p.ast.nodes[node].len = name_tok.len;
        if tok.kind == T_KW_CONST { p.ast.nodes[node].num = 1 }
        unused Advance(p);
        if Eat(p, T_COLON) {
            var_type := ParseType(p);
            if var_type < 0 { return -1 }
            p.ast.nodes[node].a = var_type;
        }
        if !Check(p, T_ASSIGN, "=") { return -1 }
        unused Advance(p);
        init := ParseExpression(p, MODE_OBJ);
        if init < 0 { return -1 }
        p.ast.nodes[node].b = init;
        return node;
    }
    value := ParseExpression(p, MODE_PLAIN);
    if value < 0 { return -1 }
    tok = Cur(p);
    if tok.kind == T_ASSIGN || tok.kind == T_PLUSASSIGN || tok.kind == T_MINUSASSIGN {
        value_node := p.ast.nodes[value];
        if value_node.kind != N_IDENT && value_node.kind != N_MEMBER && value_node.kind != N_INDEX {
            Fail(p, tok, "assignment target must be a variable, field or element");
            return -1;
        }
        return ParseAssignTail(p, tok, value);
    }
    if tok.kind == T_PLUSPLUS || tok.kind == T_MINUSMINUS {
        node := AstNewNode(p.ast, N_POSTFIX, tok.line, tok.col);
        p.ast.nodes[node].a = value;
        if tok.kind == T_MINUSMINUS { p.ast.nodes[node].num = 2 } else { p.ast.nodes[node].num = 1 }
        unused Advance(p);
        return node;
    }
    stmt := AstNewNode(p.ast, N_EXPRSTMT, tok.line, tok.col);
    p.ast.nodes[stmt].a = value;
    return stmt;
}

ParseExpression :: (p: *Parser, mode: s32) -> s32 {
    value := ParseOr(p, mode);
    if value < 0 { return -1 }
    if Cur(p).kind == T_QUESTION {
        tok := Cur(p);
        node := AstNewNode(p.ast, N_TERNARY, tok.line, tok.col);
        p.ast.nodes[node].a = value;
        unused Advance(p);
        then_value := ParseExpression(p, mode);
        if then_value < 0 { return -1 }
        p.ast.nodes[node].b = then_value;
        if !Check(p, T_COLON, "':'") { return -1 }
        unused Advance(p);
        other := ParseExpression(p, mode);
        if other < 0 { return -1 }
        p.ast.nodes[node].c = other;
        return node;
    }
    return value;
}

ParseOr :: (p: *Parser, mode: s32) -> s32 {
    left := ParseAnd(p, mode);
    if left < 0 { return -1 }
    while Cur(p).kind == T_OROR {
        tok := Cur(p);
        node := AstNewNode(p.ast, N_BINARY, tok.line, tok.col);
        p.ast.nodes[node].num = OP_OR;
        unused Advance(p);
        right := ParseAnd(p, mode);
        if right < 0 { return -1 }
        p.ast.nodes[node].a = left;
        p.ast.nodes[node].b = right;
        left = node;
    }
    return left;
}

ParseAnd :: (p: *Parser, mode: s32) -> s32 {
    left := ParseEquality(p, mode);
    if left < 0 { return -1 }
    while Cur(p).kind == T_ANDAND {
        tok := Cur(p);
        node := AstNewNode(p.ast, N_BINARY, tok.line, tok.col);
        p.ast.nodes[node].num = OP_AND;
        unused Advance(p);
        right := ParseEquality(p, mode);
        if right < 0 { return -1 }
        p.ast.nodes[node].a = left;
        p.ast.nodes[node].b = right;
        left = node;
    }
    return left;
}

ParseEquality :: (p: *Parser, mode: s32) -> s32 {
    left := ParseRelational(p, mode);
    if left < 0 { return -1 }
    while Cur(p).kind == T_EQ || Cur(p).kind == T_NE {
        tok := Cur(p);
        node := AstNewNode(p.ast, N_BINARY, tok.line, tok.col);
        if tok.kind == T_EQ { p.ast.nodes[node].num = OP_EQ } else { p.ast.nodes[node].num = OP_NE }
        unused Advance(p);
        right := ParseRelational(p, mode);
        if right < 0 { return -1 }
        p.ast.nodes[node].a = left;
        p.ast.nodes[node].b = right;
        left = node;
    }
    return left;
}

ParseRelational :: (p: *Parser, mode: s32) -> s32 {
    left := ParseAdditive(p, mode);
    if left < 0 { return -1 }
    while Cur(p).kind == T_LT || Cur(p).kind == T_GT || Cur(p).kind == T_LE || Cur(p).kind == T_GE {
        tok := Cur(p);
        node := AstNewNode(p.ast, N_BINARY, tok.line, tok.col);
        if tok.kind == T_LT { p.ast.nodes[node].num = OP_LT }
        else if tok.kind == T_GT { p.ast.nodes[node].num = OP_GT }
        else if tok.kind == T_LE { p.ast.nodes[node].num = OP_LE }
        else { p.ast.nodes[node].num = OP_GE }
        unused Advance(p);
        right := ParseAdditive(p, mode);
        if right < 0 { return -1 }
        p.ast.nodes[node].a = left;
        p.ast.nodes[node].b = right;
        left = node;
    }
    return left;
}

ParseAdditive :: (p: *Parser, mode: s32) -> s32 {
    left := ParseMultiplicative(p, mode);
    if left < 0 { return -1 }
    while Cur(p).kind == T_PLUS || Cur(p).kind == T_MINUS {
        tok := Cur(p);
        node := AstNewNode(p.ast, N_BINARY, tok.line, tok.col);
        if tok.kind == T_PLUS { p.ast.nodes[node].num = OP_ADD } else { p.ast.nodes[node].num = OP_SUB }
        unused Advance(p);
        right := ParseMultiplicative(p, mode);
        if right < 0 { return -1 }
        p.ast.nodes[node].a = left;
        p.ast.nodes[node].b = right;
        left = node;
    }
    return left;
}

ParseMultiplicative :: (p: *Parser, mode: s32) -> s32 {
    left := ParseUnary(p, mode);
    if left < 0 { return -1 }
    while Cur(p).kind == T_STAR || Cur(p).kind == T_SLASH || Cur(p).kind == T_PERCENT {
        tok := Cur(p);
        node := AstNewNode(p.ast, N_BINARY, tok.line, tok.col);
        if tok.kind == T_STAR { p.ast.nodes[node].num = OP_MUL }
        else if tok.kind == T_SLASH { p.ast.nodes[node].num = OP_DIV }
        else { p.ast.nodes[node].num = OP_MOD }
        unused Advance(p);
        right := ParseUnary(p, mode);
        if right < 0 { return -1 }
        p.ast.nodes[node].a = left;
        p.ast.nodes[node].b = right;
        left = node;
    }
    return left;
}

ParseUnary :: (p: *Parser, mode: s32) -> s32 {
    tok := Cur(p);
    if tok.kind == T_BANG {
        node := AstNewNode(p.ast, N_UNARY, tok.line, tok.col);
        p.ast.nodes[node].num = cast(s64)33;
        unused Advance(p);
        operand := ParseUnary(p, mode);
        if operand < 0 { return -1 }
        p.ast.nodes[node].a = operand;
        return node;
    }
    if tok.kind == T_MINUS {
        node := AstNewNode(p.ast, N_UNARY, tok.line, tok.col);
        p.ast.nodes[node].num = cast(s64)45;
        unused Advance(p);
        operand := ParseUnary(p, mode);
        if operand < 0 { return -1 }
        p.ast.nodes[node].a = operand;
        return node;
    }
    return ParsePostfix(p, mode);
}

ParsePostfix :: (p: *Parser, mode: s32) -> s32 {
    value := ParsePrimary(p, mode);
    if value < 0 { return -1 }
    while true {
        tok := Cur(p);
        if tok.kind == T_DOT {
            unused Advance(p);
            name_tok := Cur(p);
            if !Check(p, T_IDENT, "a member name") { return -1 }
            node := AstNewNode(p.ast, N_MEMBER, tok.line, tok.col);
            p.ast.nodes[node].a = value;
            p.ast.nodes[node].start = name_tok.start;
            p.ast.nodes[node].len = name_tok.len;
            unused Advance(p);
            value = node;
            continue;
        }
        if tok.kind == T_LPAREN {
            value = ParseCallTail(p, tok, value);
            if value < 0 { return -1 }
            continue;
        }
        if tok.kind == T_LBRACKET {
            unused Advance(p);
            index := ParseExpression(p, MODE_PLAIN);
            if index < 0 { return -1 }
            if !Check(p, T_RBRACKET, "']'") { return -1 }
            unused Advance(p);
            node := AstNewNode(p.ast, N_INDEX, tok.line, tok.col);
            p.ast.nodes[node].a = value;
            p.ast.nodes[node].b = index;
            value = node;
            continue;
        }
        if tok.kind == T_PLUSPLUS || tok.kind == T_MINUSMINUS {
            node := AstNewNode(p.ast, N_POSTFIX, tok.line, tok.col);
            p.ast.nodes[node].a = value;
            if tok.kind == T_MINUSMINUS { p.ast.nodes[node].num = 2 } else { p.ast.nodes[node].num = 1 }
            unused Advance(p);
            value = node;
            continue;
        }
        break;
    }
    return value;
}

ParseCallTail :: (p: *Parser, open: Token, callee: s32) -> s32 {
    node := AstNewNode(p.ast, N_CALL, open.line, open.col);
    p.ast.nodes[node].a = callee;
    unused Advance(p);
    args: s32 = -1;
    tail: s32 = -1;
    while Cur(p).kind != T_RPAREN {
        arg := ParseArgument(p);
        if arg < 0 { return -1 }
        if args < 0 { args = arg } else { p.ast.nodes[tail].next = arg }
        tail = arg;
        if !Eat(p, T_COMMA) { break }
    }
    p.ast.nodes[node].b = args;
    if !Check(p, T_RPAREN, "')'") { return -1 }
    unused Advance(p);
    return node;
}

ParseArgument :: (p: *Parser) -> s32 {
    tok := Cur(p);
    if tok.kind == T_DOTDOTDOT {
        node := AstNewNode(p.ast, N_SPREAD, tok.line, tok.col);
        unused Advance(p);
        value := ParseExpression(p, MODE_OBJ);
        if value < 0 { return -1 }
        p.ast.nodes[node].a = value;
        return node;
    }
    return ParseExpression(p, MODE_OBJ);
}

ParsePrimary :: (p: *Parser, mode: s32) -> s32 {
    tok := Cur(p);
    if tok.kind == T_NUM {
        node := MakeNode(p, N_NUM, tok);
        p.ast.nodes[node].num = tok.num;
        p.ast.nodes[node].is_float = tok.is_float;
        p.ast.nodes[node].start = tok.start;
        p.ast.nodes[node].len = tok.len;
        unused Advance(p);
        return node;
    }
    if tok.kind == T_STR {
        node := MakeNode(p, N_STR, tok);
        p.ast.nodes[node].start = tok.start;
        p.ast.nodes[node].len = tok.len;
        unused Advance(p);
        return node;
    }
    if tok.kind == T_KW_TRUE || tok.kind == T_KW_FALSE {
        node := MakeNode(p, N_BOOL, tok);
        if tok.kind == T_KW_TRUE { p.ast.nodes[node].num = 1 }
        unused Advance(p);
        return node;
    }
    if tok.kind == T_LPAREN {
        if LooksLikeArrow(p.lx) {
            return ParseArrow(p);
        }
        unused Advance(p);
        inner := ParseExpression(p, MODE_JSX);
        if inner < 0 { return -1 }
        if !Check(p, T_RPAREN, "')'") { return -1 }
        unused Advance(p);
        return inner;
    }
    if tok.kind == T_LBRACKET {
        node := MakeNode(p, N_ARRAY, tok);
        unused Advance(p);
        while Cur(p).kind != T_RBRACKET {
            element := ParseArgument(p);
            if element < 0 { return -1 }
            AstLink(p.ast, node, element);
            if !Eat(p, T_COMMA) { break }
        }
        if !Check(p, T_RBRACKET, "']'") { return -1 }
        unused Advance(p);
        return node;
    }
    if tok.kind == T_LBRACE {
        if mode == MODE_PLAIN {
            FailHere(p, "object literals are not allowed here");
            return -1;
        }
        return ParseRecord(p);
    }
    if tok.kind == T_LT && mode == MODE_JSX {
        ahead := LexPeekNext(p.lx);
        if ahead.kind == T_IDENT {
            return ParseJsx(p);
        }
    }
    if tok.kind == T_IDENT {
        node := MakeNode(p, N_IDENT, tok);
        p.ast.nodes[node].start = tok.start;
        p.ast.nodes[node].len = tok.len;
        unused Advance(p);
        // useState<Note[]>([]) style type arguments: skipped; the initial
        // value determines the state type.
        if Cur(p).kind == T_LT && ScanTypeArgsCall(p.lx) {
            if !SkipTypeArgs(p) { return -1 }
            if Cur(p).kind == T_LPAREN {
                call := ParseCallTail(p, Cur(p), node);
                if call < 0 { return -1 }
                marked := p.ast.nodes[call];
                marked.x = p.skip_start;
                marked.y = p.skip_end;
                p.ast.nodes[call] = marked;
                return call;
            }
        }
        return node;
    }
    if tok.kind == T_KW_FUNCTION {
        FailHere(p, "nested function expressions are not supported; use a top-level function or an inline arrow");
        return -1;
    }
    FailHere(p, "expected an expression");
    return -1;
}

ParseRecord :: (p: *Parser) -> s32 {
    tok := Cur(p);
    node := MakeNode(p, N_RECORD, tok);
    unused Advance(p);
    while Cur(p).kind != T_RBRACE {
        field_tok := Cur(p);
        if field_tok.kind != T_IDENT {
            FailHere(p, "expected a field name");
            return -1;
        }
        field := MakeNode(p, N_RECORDFIELD, field_tok);
        p.ast.nodes[field].start = field_tok.start;
        p.ast.nodes[field].len = field_tok.len;
        unused Advance(p);
        if !Check(p, T_COLON, "':'") { return -1 }
        unused Advance(p);
        value := ParseExpression(p, MODE_OBJ);
        if value < 0 { return -1 }
        p.ast.nodes[field].a = value;
        AstLink(p.ast, node, field);
        if !Eat(p, T_COMMA) { break }
    }
    if !Check(p, T_RBRACE, "'}'") { return -1 }
    unused Advance(p);
    return node;
}

ParseArrow :: (p: *Parser) -> s32 {
    tok := Cur(p);
    node := MakeNode(p, N_ARROW, tok);
    if !Check(p, T_LPAREN, "'('") { return -1 }
    unused Advance(p);
    while Cur(p).kind != T_RPAREN {
        param_tok := Cur(p);
        if param_tok.kind != T_IDENT {
            FailHere(p, "expected a parameter name");
            return -1;
        }
        param := MakeNode(p, N_PARAM, param_tok);
        p.ast.nodes[param].start = param_tok.start;
        p.ast.nodes[param].len = param_tok.len;
        unused Advance(p);
        if Eat(p, T_COLON) {
            param_type := ParseType(p);
            if param_type < 0 { return -1 }
            p.ast.nodes[param].a = param_type;
        }
        AstLink(p.ast, node, param);
        if !Eat(p, T_COMMA) { break }
    }
    if !Check(p, T_RPAREN, "')'") { return -1 }
    unused Advance(p);
    if !Check(p, T_ARROWFN, "=>") { return -1 }
    unused Advance(p);
    if Cur(p).kind == T_LBRACE {
        body := ParseBlock(p);
        if body < 0 { return -1 }
        p.ast.nodes[node].b = body;
    } else {
        body := AstNewNode(p.ast, N_BLOCK, tok.line, tok.col);
        inner: s32 = -1;
        if Cur(p).kind == T_LT {
            ahead := LexPeekNext(p.lx);
            if ahead.kind == T_IDENT {
                inner = ParseJsx(p);
            } else {
                inner = ParseExpression(p, MODE_PLAIN);
            }
        } else {
            inner = ParseExpression(p, MODE_PLAIN);
        }
        if inner < 0 { return -1 }
        stmt := AstNewNode(p.ast, N_RETURN, tok.line, tok.col);
        AstLink(p.ast, stmt, inner);
        AstLink(p.ast, body, stmt);
        p.ast.nodes[node].b = body;
    }
    return node;
}

// A {…} JSX child: cond && <el/>, cond ? <a/> : <b/>, items.map((x) => <el/>),
// or a plain expression.
ParseJsxBraceChild :: (p: *Parser) -> s32 {
    tok := Cur(p);
    unused Advance(p);
    if Eat(p, T_RBRACE) {
        FailHere(p, "empty JSX expression child");
        return -1;
    }
    value := ParseExpression(p, MODE_JSX);
    if value < 0 { return -1 }
    if !Check(p, T_RBRACE, "'}'") { return -1 }
    unused Advance(p);
    value_node := p.ast.nodes[value];
    if value_node.kind == N_JSX {
        child := AstNewNode(p.ast, N_JSXCHILD_EXPR, tok.line, tok.col);
        AstLink(p.ast, child, value);
        return child;
    }
    if value_node.kind == N_TERNARY {
        then_node := p.ast.nodes[value_node.b];
        other_node := p.ast.nodes[value_node.c];
        if then_node.kind == N_JSX && other_node.kind == N_JSX {
            child := AstNewNode(p.ast, N_JSXCHILD_COND, tok.line, tok.col);
            p.ast.nodes[child].a = value_node.a;
            p.ast.nodes[child].b = value_node.b;
            p.ast.nodes[child].c = value_node.c;
            return child;
        }
    }
    if value_node.kind == N_BINARY && value_node.num == OP_AND {
        rhs := p.ast.nodes[value_node.b];
        if rhs.kind == N_JSX {
            child := AstNewNode(p.ast, N_JSXCHILD_COND, tok.line, tok.col);
            p.ast.nodes[child].a = value_node.a;
            p.ast.nodes[child].b = value_node.b;
            return child;
        }
    }
    if value_node.kind == N_CALL {
        callee := p.ast.nodes[value_node.a];
        if callee.kind == N_MEMBER {
            name := p.lx.src[callee.start:callee.start + callee.len];
            if name.count == 3 && name[0] == cast(u8)109 && name[1] == cast(u8)97 && name[2] == cast(u8)112 {
                args := value_node.b;
                if args >= 0 {
                    arg_node := p.ast.nodes[args];
                    if arg_node.kind == N_ARROW {
                        child := AstNewNode(p.ast, N_JSXCHILD_LIST, tok.line, tok.col);
                        p.ast.nodes[child].a = callee.a;
                        p.ast.nodes[child].b = args;
                        return child;
                    }
                }
            }
        }
    }
    child := AstNewNode(p.ast, N_JSXCHILD_EXPR, tok.line, tok.col);
    AstLink(p.ast, child, value);
    return child;
}

// JSX element. The current token is '<'; the next one names the element.
ParseJsx :: (p: *Parser) -> s32 {
    open := Cur(p);
    node := MakeNode(p, N_JSX, open);
    unused Advance(p);
    tag_tok := Cur(p);
    if !Check(p, T_IDENT, "an element name") { return -1 }
    p.ast.nodes[node].start = tag_tok.start;
    p.ast.nodes[node].len = tag_tok.len;
    unused Advance(p);
    while Eat(p, T_DOT) {
        part := Cur(p);
        if !Check(p, T_IDENT, "an element name after '.'") { return -1 }
        p.ast.nodes[node].len = part.start + part.len - p.ast.nodes[node].start;
        unused Advance(p);
    }
    while Cur(p).kind != T_GT && Cur(p).kind != T_SLASH {
        prop_tok := Cur(p);
        if prop_tok.kind != T_IDENT {
            FailHere(p, "expected an attribute name");
            return -1;
        }
        prop := MakeNode(p, N_JSXPROP, prop_tok);
        p.ast.nodes[prop].start = prop_tok.start;
        p.ast.nodes[prop].len = prop_tok.len;
        unused Advance(p);
        if Eat(p, T_ASSIGN) {
            if Cur(p).kind == T_STR {
                value := MakeNode(p, N_STR, Cur(p));
                p.ast.nodes[value].start = Cur(p).start;
                p.ast.nodes[value].len = Cur(p).len;
                unused Advance(p);
                AstLink(p.ast, prop, value);
            } else if Cur(p).kind == T_LBRACE {
                unused Advance(p);
                if Cur(p).kind == T_LPAREN && LooksLikeArrow(p.lx) {
                    value := ParseArrow(p);
                    if value < 0 { return -1 }
                    AstLink(p.ast, prop, value);
                } else {
                    value := ParseExpression(p, MODE_OBJ);
                    if value < 0 { return -1 }
                    AstLink(p.ast, prop, value);
                }
                if !Check(p, T_RBRACE, "'}'") { return -1 }
                unused Advance(p);
            } else {
                FailHere(p, "expected a string or {expression} attribute value");
                return -1;
            }
        } else {
            flag := MakeNode(p, N_BOOL, prop_tok);
            p.ast.nodes[flag].num = 1;
            AstLink(p.ast, prop, flag);
        }
        value_node := p.ast.nodes[prop].a;
        if value_node >= 0 && p.ast.nodes[value_node].kind == N_ARROW {
            marked := p.ast.nodes[prop];
            marked.num = 1;
            p.ast.nodes[prop] = marked;
        }
        AstLink(p.ast, node, prop);
    }
    if Eat(p, T_SLASH) {
        if !Check(p, T_GT, "'>'") { return -1 }
        unused Advance(p);
        return node;
    }
    if !Check(p, T_GT, "'>'") { return -1 }
    unused Advance(p);
    while true {
        tok := Cur(p);
        if tok.kind == T_EOF {
            FailHere(p, "unterminated element: missing closing tag");
            return -1;
        }
        if tok.kind == T_LT {
            ahead := LexPeekNext(p.lx);
            if ahead.kind == T_SLASH {
                unused Advance(p);
                unused Advance(p);
                if !Check(p, T_IDENT, "a closing tag name") { return -1 }
                unused Advance(p);
                while Eat(p, T_DOT) {
                    if !Check(p, T_IDENT, "a closing tag name") { return -1 }
                    unused Advance(p);
                }
                if !Check(p, T_GT, "'>'") { return -1 }
                unused Advance(p);
                break;
            }
            if ahead.kind == T_IDENT {
                child := ParseJsx(p);
                if child < 0 { return -1 }
                AstLink(p.ast, node, child);
                continue;
            }
            FailHere(p, "unexpected '<' in element children");
            return -1;
        }
        if tok.kind == T_LBRACE {
            child := ParseJsxBraceChild(p);
            if child < 0 { return -1 }
            AstLink(p.ast, node, child);
            continue;
        }
        // The generic lexer consumed raw text as a normal token; step
        // back to the byte just past the previous token and read the whole
        // run as JSX text instead.
        lx := p.lx;
        lx.pos = lx.pre_pos;
        lx.line = lx.pre_line;
        lx.col = lx.pre_col;
        lx.has_ahead = false;
        text := LexJsxText(lx);
        lx.tok = LexNext(lx);
        if text.str_len > 0 {
            child := MakeNode(p, N_JSXCHILD_TEXT, text);
            p.ast.nodes[child].start = text.start;
            p.ast.nodes[child].len = text.len;
            AstLink(p.ast, node, child);
        }
    }
    return node;
}
