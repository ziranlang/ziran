// zi2go - .zi -> native Go. Uses the shared Ziran frontend and the generated
// Go backend; the C services behind the entry points are the linked modules.

IR :: #import "compiler_ir"
CLI :: #import "compiler_cli"

libc :: #system_library "libc";
compiler :: #system_library "ziran";

CStr :: (s: string) -> *u8 { return (cast(*StaticText)(*s)).data }
StaticText :: struct { data: *u8; count: usize }

TARGET_GO :: 1

Diagnostic :: (span: IR.ZirSourceSpan, code: *u8, format: *u8, arguments: ..any) #foreign compiler "Diagnostic";
Span :: (path: *u8, line: s32, column: s32) -> IR.ZirSourceSpan #foreign compiler "Span";
SetFormatArguments :: (argc: s32, argv: **u8) #foreign compiler "SetDiagnosticFormatFromArguments";
DiagnosticOutOfMemory :: () #foreign compiler "DiagnosticOutOfMemory";
DiagnosticEnsureFailureReported :: (status: s32, command: *u8) -> s32 #foreign compiler "DiagnosticEnsureFailureReported";
ProgramsLoad :: (set: *IR.ProgramSet, root: *u8, module_paths: **u8, module_path_count: s32,
                 inputs: **u8, input_count: s32) -> s32 #foreign compiler "ProgramsLoad";
ProgramsFree :: (set: *IR.ProgramSet) #foreign compiler "ProgramsFree";
CheckCanonical :: (programs: **IR.ZirProgram, count: s32, paths: **u8) -> s32 #foreign compiler "CheckCanonicalPrograms";
CheckCapabilities :: (program: *IR.ZirProgram, target: *u8) -> s32 #foreign compiler "CheckTargetCapabilities";
LinkImports :: (programs: **IR.ZirProgram, count: s32) -> s32 #foreign compiler "LinkImports";
BindProvider :: (program: *IR.ZirProgram, binding: *u8) -> s32 #foreign compiler "BindHostProvider";
BindModule :: (program: *IR.ZirProgram, module: *u8) -> s32 #foreign compiler "BindHostModule";
NativeGoLink :: (program: *IR.ZirProgram, module: *u8, function: *u8) -> *IR.ZirProgram #foreign compiler "NativeGoLink";
ProgramFree :: (program: *IR.ZirProgram) #foreign compiler "ProgramFree";
GoLower :: (programs: **IR.ZirProgram, count: s32, root: *u8, output: *u8, package: *u8, no_main: s32) -> s32 #foreign compiler "go_lower";
EmitUseMinifiedOutput :: (enabled: s32) #foreign compiler "EmitUseMinifiedOutput";
NativeGoFunctionName :: (programs: **IR.ZirProgram, count: s32, module: *IR.ZirModule,
                         function: *IR.ZirFunction, out: *u8, size: usize) #foreign compiler "NativeGoFunctionName";
GeneratedOutputRecord :: (path: *u8) #foreign compiler "GeneratedOutputRecord";
GeneratedOutputPrune :: (out_dir: *u8, marker: *u8) -> s32 #foreign compiler "GeneratedOutputPrune";
CompilerContextOpen :: () -> *void #foreign compiler "CompilerContextOpen";
CompilerContextSelect :: (context: *void) -> *void #foreign compiler "CompilerContextSelect";
CompilerContextClose :: (context: *void) -> s32 #foreign compiler "CompilerContextClose";

strcmp :: (left: *u8, right: *u8) -> s32 #foreign libc "strcmp";
snprintf :: (output: *u8, capacity: usize, format: *u8, arguments: ..any) -> s32 #foreign libc "snprintf";
fprintf :: (file: *void, format: *u8, arguments: ..any) -> s32 #foreign libc "fprintf";
fopen :: (path: *u8, mode: *u8) -> *void #foreign libc "fopen";
fclose :: (file: *void) -> s32 #foreign libc "fclose";
free :: (memory: *void) #foreign libc "free";

Usage :: () {
    span: IR.ZirSourceSpan = .{}
    Diagnostic(span, CStr("command.arguments"), CStr("usage: zi2go [--no-main] [--prune-stale] [--exe] [--minify] [--checks] [--pkg NAME] [--entry module:function] [--bind module:function=module:function] [--bind-host module] [--diagnostics=text|json] [--module-path DIR] [--target-os linux|windows|macos|android|web|none] [--target-cpu x64|arm64|wasm32|none] --root DIR -o DIR file.zi|file.zir ..."))
}

EntryReturnSupported :: (function: *IR.ZirFunction) -> s32 {
    text := cast(*u8)*function.return_type
    if strcmp(text, CStr("void")) == 0 || strcmp(text, CStr("s32")) == 0 ||
       strcmp(text, CStr("s64")) == 0 || strcmp(text, CStr("integer")) == 0 ||
       strcmp(text, CStr("bool")) == 0 { return 1 }
    return 0
}

WriteEntry :: (entry_module: *u8, entry_function: *u8, linked: *IR.ZirProgram, out_dir: *u8) -> s32 {
    module: *IR.ZirModule = null
    function: *IR.ZirFunction = null
    m: s32 = 0
    while m < linked.module_count {
        candidate := *linked.modules[cast(usize)m]
        if strcmp(cast(*u8)*candidate.name, entry_module) == 0 {
            f: s32 = 0
            while f < candidate.function_count {
                if strcmp(cast(*u8)*candidate.functions[cast(usize)f].name, entry_function) == 0 {
                    module = candidate
                    function = *candidate.functions[cast(usize)f]
                }
                f += 1
            }
        }
        m += 1
    }
    if function == null {
        Diagnostic(Span(CStr("<command>"), 1, 1), CStr("zir_go.exe"), CStr("executable entry is missing"))
        return 1
    }
    args := function.args_text
    if args == null { args = CStr("") }
    if args[0] != 0 || EntryReturnSupported(function) == 0 {
        Diagnostic(function.span, CStr("zir_go.exe"),
                   CStr("executable entry must take no arguments and return void, bool, or an integer"))
        return 1
    }
    symbol: [IR.ZIR_NAME_MAX * 2]u8
    path: [1024]u8
    NativeGoFunctionName(*linked, 1, module, function, *symbol[0], cast(usize)symbol.count)
    unused snprintf(*path[0], cast(usize)path.count, CStr("%s/ziran_entry.go"), out_dir)
    GeneratedOutputRecord(*path[0])
    file := fopen(*path[0], CStr("wb"))
    if file == null {
        Diagnostic(Span(*path[0], 1, 1), CStr("zir_go.exe"), CStr("cannot write Go executable entry"))
        return 1
    }
    unused fprintf(file, CStr("// Code generated by zi2go from %s. DO NOT EDIT.\n"),
                   cast(*u8)*module.source_path)
    result_type := cast(*u8)*function.return_type
    if result_type[0] == 0 || strcmp(result_type, CStr("void")) == 0 {
        unused fprintf(file, CStr("package main\nfunc main() { %s() }\n"), *symbol[0])
    } else if strcmp(result_type, CStr("bool")) == 0 {
        unused fprintf(file, CStr("package main\nimport \"os\"\nfunc main() { if %s() { os.Exit(1) } }\n"),
                       *symbol[0])
    } else {
        unused fprintf(file, CStr("package main\nimport \"os\"\nfunc main() { os.Exit(int(%s())) }\n"),
                       *symbol[0])
    }
    if fclose(file) != 0 { return 1 }
    return 0
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    root: *u8 = null
    out_dir: *u8 = null
    pkg: *u8 = CStr("ziran")
    entry: *u8 = null
    entry_module: [IR.ZIR_NAME_MAX]u8
    entry_function: [IR.ZIR_NAME_MAX]u8
    no_main: s32 = 0
    executable: s32 = 0
    minify: s32 = 0
    checks: s32 = 0
    prune_stale: s32 = 0
    result: s32 = 1
    first_file: s32 = 0
    target_os_name: *u8 = null
    target_cpu_name: *u8 = null
    command_context: *void = null
    previous_context: *void = null
    defer {
        CompilerContextSelect(previous_context)
        if command_context != null && CompilerContextClose(command_context) == 0 {
            Diagnostic(IR.ZirSourceSpan.{cast(*u8)(null), 0, 0, 0, 0, 0},
                       CStr("compiler.context"), CStr("compiler operation retained live programs"))
            result = 1
        }
    }
    set: IR.ProgramSet = .{}
    defer { ProgramsFree(*set) }
    merged: IR.ZirProgram = .{}
    defer { free(cast(*void)merged.modules) }
    linked: *IR.ZirProgram = null
    defer { ProgramFree(linked) }
    module_paths := CLI.CommandModulePaths(argc)
    if module_paths == null { return 1 }
    module_path_count: s32 = 0
    bindings: [64]*u8
    binding_count: s32 = 0
    host_modules: [16]*u8
    host_module_count: s32 = 0
    target_os: s32 = 0

    SetFormatArguments(argc, argv)
    CLI.CommandLowerPriority()
    options: [14]CLI.CommandOption = .{
        .{name = CStr("--root"), value = *root},
        .{name = CStr("--module-path"), value = module_paths, count = *module_path_count, capacity = argc},
        .{name = CStr("--target-os"), value = *target_os_name},
        .{name = CStr("--target-cpu"), value = *target_cpu_name},
        .{name = CStr("-o"), value = *out_dir},
        .{name = CStr("--pkg"), value = *pkg},
        .{name = CStr("--entry"), value = *entry},
        .{name = CStr("--bind"), value = cast(**u8)*bindings, count = *binding_count, capacity = 64},
        .{name = CStr("--bind-host"), value = cast(**u8)*host_modules, count = *host_module_count, capacity = 16},
        .{name = CStr("--prune-stale"), flag = *prune_stale},
        .{name = CStr("--no-main"), flag = *no_main},
        .{name = CStr("--exe"), flag = *executable},
        .{name = CStr("--minify"), flag = *minify},
        .{name = CStr("--checks"), flag = *checks},
    }
    first_file = CLI.ReadCommandOptions(argc, argv, *options[0], cast(usize)options.count)
    if first_file < 0 {
        Usage()
        return 1
    }
    if root == null || out_dir == null || first_file == 0 ||
       (entry != null && CLI.SplitEntry(entry, *entry_module[0], *entry_function[0]) == 0) ||
       ((binding_count > 0 || host_module_count > 0) && entry == null) ||
       (executable != 0 && (entry == null || strcmp(pkg, CStr("main")) != 0 || no_main != 0)) {
        Usage()
        return 1
    }
    EmitUseMinifiedOutput(minify)
    if CLI.CommandConfigureTarget(TARGET_GO, target_os_name, target_cpu_name, *target_os) == 0 {
        Usage()
        return 1
    }
    command_context = CompilerContextOpen()
    if command_context == null {
        DiagnosticOutOfMemory()
        return 1
    }
    previous_context = CompilerContextSelect(command_context)
    inputs := cast(**u8)(cast(usize)argv + cast(usize)first_file * size_of(*u8))
    if ProgramsLoad(*set, root, module_paths, module_path_count, inputs, argc - first_file) == 0 {
        return 1
    }
    if checks != 0 { CLI.CommandEnableChecks(*set) }
    file_count := set.count
    progs := set.programs
    if CheckCanonical(progs, file_count, set.paths) == 0 { return result }
    if entry != null {
        if CLI.CommandMergePrograms(*set, *merged) == 0 { return result }
        merged_ptr := *merged
        if LinkImports(*merged_ptr, 1) == 0 { return result }
        b: s32 = 0
        while b < binding_count {
            if BindProvider(*merged, bindings[cast(usize)b]) == 0 { return result }
            b += 1
        }
        b = 0
        while b < host_module_count {
            if BindModule(*merged, host_modules[cast(usize)b]) == 0 { return result }
            b += 1
        }
        linked = NativeGoLink(*merged, *entry_module[0], *entry_function[0])
        if linked == null { return result }
        if CheckCapabilities(linked, CStr("go")) == 0 { return result }
        result = ifx (GoLower(*linked, 1, root, out_dir, pkg, no_main) != 0) then 1 else 0
        if result == 0 && executable != 0 {
            if WriteEntry(*entry_module[0], *entry_function[0], linked, out_dir) != 0 { result = 1 }
        }
    } else {
        i: s32 = 0
        while i < file_count {
            if CheckCapabilities(progs[cast(usize)i], CStr("go")) == 0 { return result }
            i += 1
        }
        result = ifx (GoLower(progs, file_count, root, out_dir, pkg, no_main) != 0) then 1 else 0
    }
    if result == 0 && prune_stale != 0 &&
       GeneratedOutputPrune(out_dir, CStr("// Code generated by zi2go from ")) != 0 {
        Diagnostic(IR.ZirSourceSpan.{cast(*u8)(null), 0, 0, 0, 0, 0}, CStr("zir.output"),
                   CStr("cannot remove stale generated files in %s"), out_dir)
        result = 1
    }
    return DiagnosticEnsureFailureReported(result, CStr("zi2go"))
}
