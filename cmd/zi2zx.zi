// zi2zx - Ziran source to revision-29 executable ZX, the portable ZX viewer
// (`--emit lir|linkage`) and `run`. The frontend, checker, linker and the
// lowering/engine assembly set keep their C entry points; this file holds the
// command decisions, the library linkage text and the run preflight.

IR :: #import "compiler_ir"
CLI :: #import "compiler_cli"
Lowered :: #import "compiler_lowered_ir"
Exec :: #import "compiler_exec"
Opt :: #import "compiler_opt"
Lowering :: #import "compiler_zir_lower"
ZxRun :: #import "compiler_zx_run"
ExecLink :: #import "compiler_exec_link"
Host :: #import "compiler_host_api"
BundleMod :: #import "compiler_bundle"
Check :: #import "compiler_check_types"

libc :: #system_library "libc";
compiler :: #system_library "ziran";

CStr :: (s: string) -> *u8 { return (cast(*StaticText)(*s)).data }
Raw :: (s: string) -> *u8 { return (cast(*StaticText)(*s)).data }
StaticText :: struct { data: *u8; count: usize }

LINK_EXPORT :: 0
LINK_REQUIRE :: 1
LINK_IMPORT :: 2

TARGET_ZX :: 3
TARGET_WASM :: 2
OS_NONE :: 0
OS_WEB :: 5
CPU_NONE :: 0
CPU_WASM32 :: 3

Diagnostic :: (span: IR.ZirSourceSpan, code: *u8, format: *u8, arguments: ..any) #foreign compiler "Diagnostic";
LirVerifyPassesSet :: (enabled: s32) #foreign compiler "LirVerifyPassesSet";
MachineVerifySelfBuiltSet :: (enabled: s32) #foreign compiler "MachineVerifySelfBuiltSet";
Span :: (path: *u8, line: s32, column: s32) -> IR.ZirSourceSpan #foreign compiler "Span";
SetFormat :: (format: *u8) -> s32 #foreign compiler "SetDiagnosticFormat";
SetFormatArguments :: (argc: s32, argv: **u8) #foreign compiler "SetDiagnosticFormatFromArguments";
EnsureFailureReported :: (status: s32, command: *u8) -> s32 #foreign compiler "DiagnosticEnsureFailureReported";
ProgramsLoadWithDefines :: (set: *IR.ProgramSet, root: *u8, module_paths: **u8, module_path_count: s32,
                            defines: **u8, define_count: s32, inputs: **u8, input_count: s32) -> s32 #foreign compiler "ProgramsLoadWithDefines";
ProgramsFree :: (set: *IR.ProgramSet) #foreign compiler "ProgramsFree";
CheckCanonicalPrograms :: (programs: **IR.ZirProgram, count: s32, paths: **u8) -> s32 #foreign compiler "CheckCanonicalPrograms";
LinkImports :: (programs: **IR.ZirProgram, count: s32) -> s32 #foreign compiler "LinkImports";
BindHostProvider :: (program: *IR.ZirProgram, binding: *u8) -> s32 #foreign compiler "BindHostProvider";
BindHostModule :: (program: *IR.ZirProgram, module: *u8) -> s32 #foreign compiler "BindHostModule";
CompilerConfigureTarget :: (backend: s32, os: s32, cpu: s32) #foreign compiler "CompilerConfigureTarget";
ParametersOf :: (text: *u8) -> *Check.ZirParameters #foreign compiler "ParametersOf";
SymbolLookupsChanged :: () #foreign compiler "SymbolLookupsChanged";
AssemblyPrintLir :: (program: *Lowered.LirProgram, output: *void) -> s32 #foreign compiler "AssemblyPrintLir";
GeneratedOutputOpen :: (path: *u8, temporary: *u8, size: usize) -> *void #foreign compiler "GeneratedOutputOpen";
GeneratedOutputReplace :: (temporary: *u8, path: *u8) -> s32 #foreign compiler "GeneratedOutputReplace";
ZxAssetsCollectRaw :: (assets: *BundleMod.ZxAssets, spec: *u8) -> s32 #foreign compiler "ZxAssetsCollect";
ZxAssetsFreeRaw :: (assets: *BundleMod.ZxAssets) #foreign compiler "ZxAssetsFree";
RunBundleRaw :: (bundle: *void, path: *u8, roots: **u8, root_count: usize,
                 images: *ZxRun.ZxRunModuleImage, image_count: usize,
                 options: *RunOptions, result: *s64, has_result: *s32) -> s32 #foreign compiler "ZxExecRunBundle";
ClearError :: () #foreign compiler "ZiranCommandClearError";
LastError :: () -> s32 #foreign compiler "ZiranCommandLastError";
ErrorText :: (error: s32) -> *u8 #foreign compiler "ZiranCommandErrorText";

strlen :: (text: *u8) -> usize #foreign libc "strlen";
strcmp :: (left: *u8, right: *u8) -> s32 #foreign libc "strcmp";
strncmp :: (left: *u8, right: *u8, count: usize) -> s32 #foreign libc "strncmp";
strchr :: (text: *u8, byte: s32) -> *u8 #foreign libc "strchr";
strrchr :: (text: *u8, byte: s32) -> *u8 #foreign libc "strrchr";
snprintf :: (output: *u8, capacity: usize, format: *u8, arguments: ..any) -> s32 #foreign libc "snprintf";
fprintf :: (file: *void, format: *u8, arguments: ..any) -> s32 #foreign libc "fprintf";
printf :: (format: *u8, arguments: ..any) -> s32 #foreign libc "printf";
fputc :: (byte: s32, file: *void) -> s32 #foreign libc "fputc";
fputs :: (text: *u8, file: *void) -> s32 #foreign libc "fputs";
ferror :: (file: *void) -> s32 #foreign libc "ferror";
fflush :: (file: *void) -> s32 #foreign libc "fflush";
fwrite :: (bytes: *void, size: usize, count: usize, file: *void) -> usize #foreign libc "fwrite";
fread :: (output: *void, size: usize, count: usize, file: *void) -> usize #foreign libc "fread";
fopen :: (path: *u8, mode: *u8) -> *void #foreign libc "fopen";
tmpfile :: () -> *void #foreign libc "tmpfile";
rewind :: (file: *void) #foreign libc "rewind";
fclose :: (file: *void) -> s32 #foreign libc "fclose";
ftell :: (file: *void) -> isize #foreign libc "ftell";
remove :: (path: *u8) -> s32 #foreign libc "remove";
malloc :: (size: usize) -> *void #foreign libc "malloc";
calloc :: (count: usize, size: usize) -> *void #foreign libc "calloc";
free :: (memory: *void) #foreign libc "free";
memcpy :: (output: *void, input: *void, count: usize) -> *void #foreign libc "memcpy";
memcmp :: (left: *void, right: *void, count: usize) -> s32 #foreign libc "memcmp";
strtoull :: (text: *u8, end: **u8, base: s32) -> u64 #foreign libc "strtoull";
StandardOutput :: () -> *void #foreign compiler "CompilerStandardOutput";

NoSpan :: () -> IR.ZirSourceSpan {
    span: IR.ZirSourceSpan = .{}
    return span
}

Usage :: () {
    Diagnostic(NoSpan(), CStr("command.arguments"),
            CStr("usage: zi2zx [--module-path DIR] [--define NAME] [--asset-dir NAME=DIR] [--retain module:function] [--bind module:function=module:function] [--bind-host module] --root DIR --entry module:function [--target zx|wasm] [--opt] [--debug] [--checks] [--thorough|--quickest] [--emit zx|lir|opt-report] -o FILE file.zi|file.ts|file.tsx|file.zir ...\n       zi2zx --library NAME --export module:function [--export module:function ...] [ZX build options] -o FILE file.zi|file.ts|file.tsx|file.zir ...\n       ZX module options: [--require-module INTERFACE=NAME] [--import module:function=INTERFACE:EXPORT]\n       zi2zx [--emit zx|lir|linkage] -o FILE file.zx\n       zi2zx run [--backend native|engine] [--module-root DIR | --module-image NAME=SHA256=FILE]... file.zx\n       zi2zx run [--backend native|engine] [--module-root DIR]... [ZX build options] [--root DIR] [--entry module:function] file.zi ...\nrun defaults to native code on Linux x86-64 and on AArch64 and ARMv7 under Linux or Android.\nOther hosts default to the portable instruction engine. A backend that cannot run a bundle\nreports an error before initialization. An incompatible target-only bundle is rejected.\n"))
}

RunOptions :: struct { backend: s32; max_steps: s32; unbounded: s32 }

LinkRecord :: struct {
    kind: s32
    name: [4]*u8
    storage: *u8
    length: usize
}

LinkName :: (name: *u8, length: usize, logical: s32) -> s32 {
    start: usize = 0
    separator: u8 = #char "."
    if logical != 0 { separator = #char "/" }
    i: usize = 0
    while i <= length {
        if i == length || name[i] == separator {
            segment := i - start
            if segment == 0 || (logical != 0 &&
               ((segment == 1 && name[start] == #char ".") ||
                (segment == 2 && name[start] == #char "." && name[start + 1] == #char "."))) {
                return 0
            }
            start = i + 1
            i += 1
            continue
        }
        c := name[i]
        allowed := (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) ||
            c == 95 || c == 45 || (logical != 0 && c == #char ".")
        if !allowed { return 0 }
        i += 1
    }
    return 1
}

ParseLinkRecord :: (record: *LinkRecord, kind: s32, text: *u8) -> s32 {
    record.kind = kind
    record.length = strlen(text)
    storage := cast(*u8)malloc(record.length + 1)
    if storage == null { return 0 }
    unused memcpy(cast(*void)storage, cast(*void)text, record.length + 1)
    field := storage
    separator: *u8 = CStr("=")
    if kind == LINK_EXPORT { separator = CStr(":") }
    if kind == LINK_IMPORT { separator = CStr(":=:") }
    index: s32 = 0
    while true {
        end: *u8 = null
        if separator[0] != 0 { end = strchr(field, cast(s32)separator[0]) }
        else { end = cast(*u8)(cast(usize)storage + record.length) }
        logical: s32 = 0
        if kind == LINK_REQUIRE && index == 1 { logical = 1 }
        if end == null || LinkName(field, cast(usize)(cast(usize)end - cast(usize)field), logical) == 0 {
            free(cast(*void)storage)
            return 0
        }
        end[0] = 0
        record.name[cast(usize)index] = field
        if separator[0] == 0 { break }
        separator = cast(*u8)(cast(usize)separator + 1)
        field = cast(*u8)(cast(usize)end + 1)
        index += 1
    }
    record.storage = storage
    return 1
}

CompareLink :: (left: *LinkRecord, right: *LinkRecord) -> s32 {
    if left.kind != right.kind { return left.kind - right.kind }
    if left.kind == LINK_EXPORT { return strcmp(left.name[1], right.name[1]) }
    first := strcmp(left.name[0], right.name[0])
    if first != 0 || left.kind == LINK_REQUIRE { return first }
    return strcmp(left.name[1], right.name[1])
}

LinkSourceModule :: (program: *IR.ZirProgram, name: *u8) -> *IR.ZirModule {
    found: *IR.ZirModule = null
    i: s32 = 0
    while i < program.module_count {
        module := *program.modules[cast(usize)i]
        if strcmp(cast(*u8)*module.name, name) == 0 {
            if found != null { return null }
            found = module
        }
        i += 1
    }
    return found
}

LinkExport :: (module: *IR.ZirModule, name: *u8) -> *IR.ZirFunction {
    if module == null { return null }
    found: *IR.ZirFunction = null
    i: s32 = 0
    while i < module.function_count {
        function := *module.functions[cast(usize)i]
        if strcmp(cast(*u8)*function.name, name) == 0 {
            if found != null || function.checked == 0 || function.is_extern != 0 ||
               function.is_template != 0 || function.is_global_initializer != 0 {
                return null
            }
            found = function
        }
        i += 1
    }
    return found
}

LinkImport :: (module: *IR.ZirModule, name: *u8) -> *IR.ZirImport {
    if module == null { return null }
    found: *IR.ZirImport = null
    i: s32 = 0
    while i < module.import_count {
        declaration := *module.imports[cast(usize)i]
        if declaration.kind == IR.ZirImportKind.EXTERN && strcmp(cast(*u8)*declaration.name, name) == 0 {
            extern_symbol := cast(*u8)*declaration.extern_symbol
            if found != null || declaration.extern_kind != IR.ZirExternKind.HOST || declaration.is_varargs != 0 ||
               strncmp(cast(*u8)*declaration.target, CStr("ziran:"), 6) == 0 ||
               (extern_symbol[0] != 0 && strcmp(extern_symbol, name) != 0) {
                return null
            }
            found = declaration
        }
        i += 1
    }
    return found
}

LinkHasRequirement :: (records: *LinkRecord, count: s32, interface: *u8) -> s32 {
    i: s32 = 0
    while i < count {
        record := records[cast(usize)i]
        if record.kind == LINK_REQUIRE && strcmp(record.name[0], interface) == 0 { return 1 }
        i += 1
    }
    return 0
}

PrepareModuleLink :: (program: *IR.ZirProgram, library: *u8, records: *LinkRecord, count: s32,
                      build: *ZxRun.ZxModuleBuild, text: **u8) -> s32 {
    if count == 0 { return 1 }
    i: s32 = 0
    while i < program.module_count {
        if strcmp(cast(*u8)*program.modules[cast(usize)i].name, CStr("__zx_module_dispatch")) == 0 {
            Diagnostic(program.modules[cast(usize)i].span, CStr("zx.module"),
                       CStr("reserved module name: __zx_module_dispatch"))
            return 0
        }
        i += 1
    }
    // qsort by the comparator, then detect duplicate keys.
    insert: s32 = 1
    while insert < count {
        item := records[cast(usize)insert]
        j := insert
        while j > 0 && CompareLink(*records[cast(usize)(j - 1)], *item) > 0 {
            records[cast(usize)j] = records[cast(usize)(j - 1)]
            j -= 1
        }
        records[cast(usize)j] = item
        insert += 1
    }
    export_count: s32 = 0
    import_count: s32 = 0
    capacity: usize = 1
    if library != null { capacity = strlen(library) + 9 }
    i = 0
    while i < count {
        if i > 0 && CompareLink(*records[cast(usize)(i - 1)], *records[cast(usize)i]) == 0 {
            record := records[cast(usize)i]
            option: *u8 = CStr("--require-module")
            if record.kind == LINK_EXPORT { option = CStr("--export") }
            if record.kind == LINK_IMPORT { option = CStr("--import") }
            middle: *u8 = CStr("")
            if record.kind != LINK_EXPORT { middle = record.name[0] }
            second: *u8 = CStr("")
            if record.kind != LINK_REQUIRE { second = record.name[1] }
            colon: *u8 = CStr("")
            if record.kind == LINK_IMPORT { colon = CStr(":") }
            Diagnostic(Span(CStr("<command>"), 1, 1), CStr("zx.module"), CStr("duplicate %s key: %s%s%s"),
                       option, middle, colon, second)
            return 0
        }
        record := records[cast(usize)i]
        if record.kind == LINK_EXPORT { export_count += 1 }
        if record.kind == LINK_IMPORT { import_count += 1 }
        capacity += record.length + 10
        i += 1
    }
    if export_count > 0 {
        build.exports = cast(*Lowering.AssemblyExportRoot)calloc(cast(usize)export_count,
                                                                 size_of(Lowering.AssemblyExportRoot))
        if build.exports == null { return 0 }
    }
    if import_count > 0 {
        build.imports = cast(*ZxRun.ZxImportRoot)calloc(cast(usize)import_count,
                                                       size_of(ZxRun.ZxImportRoot))
        if build.imports == null { return 0 }
    }
    memory := cast(*u8)malloc(capacity)
    if memory == null { return 0 }
    <<text = memory
    offset: usize = 0
    if library != null {
        offset = cast(usize)snprintf(memory, capacity, CStr("module\t%s\n"), library)
    }
    i = 0
    while i < count {
        record := records[cast(usize)i]
        line := cast(*u8)(cast(usize)memory + offset)
        remaining := capacity - offset
        if record.kind == LINK_REQUIRE {
            offset += cast(usize)snprintf(line, remaining, CStr("require\t%s\t%s\n"),
                                          record.name[0], record.name[1])
            i += 1
            continue
        }
        module := LinkSourceModule(program, record.name[0])
        if record.kind == LINK_EXPORT {
            function := LinkExport(module, record.name[1])
            if function == null {
                Diagnostic(Span(CStr("<command>"), 1, 1), CStr("zx.module-export"),
                           CStr("expected one concrete export root: %s:%s"), record.name[0], record.name[1])
                return 0
            }
            build.exports[cast(usize)build.export_count] = .{module = module, function = function}
            build.export_count += 1
            offset += cast(usize)snprintf(line, remaining, CStr("export\t%s\n"), record.name[1])
            i += 1
            continue
        }
        if LinkHasRequirement(records, count, record.name[2]) == 0 {
            Diagnostic(Span(CStr("<command>"), 1, 1), CStr("zx.module-import"),
                       CStr("import interface has no --require-module: %s"), record.name[2])
            return 0
        }
        declaration := LinkImport(module, record.name[1])
        if declaration == null {
            Diagnostic(Span(CStr("<command>"), 1, 1), CStr("zx.module-import"),
                       CStr("expected one unbound, fixed-signature host_api declaration with matching symbol: %s:%s"),
                       record.name[0], record.name[1])
            return 0
        }
        parameters := ParametersOf(cast(*u8)*declaration.args)
        if parameters == null || parameters.count == 0 ||
           parameters.items.items[0].value_type == null ||
           strcmp(parameters.items.items[0].value_type, CStr("u64")) != 0 {
            Diagnostic(declaration.span, CStr("zx.module-import"),
                       CStr("module import must take a u64 handle as its first parameter"))
            return 0
        }
        build.imports[cast(usize)build.import_count] = .{module = record.name[0], function = record.name[1]}
        build.import_count += 1
        offset += cast(usize)snprintf(line, remaining, CStr("import\t%s\t%s\t%s\t%s\n"),
            record.name[0], record.name[1], record.name[2], record.name[3])
        i += 1
    }
    build.linkage = TextView(IR.CBuffer(memory, offset))
    return 1
}

OptPass :: (stream: *void, name: *u8, counters: *Opt.LirOptPassCounters) {
    unused fprintf(stream, CStr("{\"name\":\"%s\",\"runs\":%lld,\"instructions\":%lld,\"values\":%lld,\"blocks\":%lld,\"constants\":%lld}"),
        name, counters.runs, counters.instructions, counters.values, counters.blocks, counters.constants)
}

OptReport :: (stream: *void, result: *Opt.LirOptResult) -> s32 {
    counters := *result.counters
    unused fprintf(stream, CStr("{\"version\":1,\"work\":%lld,\"scratch_bytes\":%lld,\"input\":{\"functions\":%lld,\"blocks\":%lld,\"values\":%lld,\"instructions\":%lld},"),
        result.work, result.scratch_bytes,
        counters.input_functions, counters.input_blocks, counters.input_values, counters.input_instructions)
    unused fprintf(stream, CStr("\"output\":{\"functions\":%lld,\"blocks\":%lld,\"values\":%lld,\"instructions\":%lld},\"passes\":["),
        counters.output_functions, counters.output_blocks, counters.output_values, counters.output_instructions)
    OptPass(stream, CStr("fold"), *counters.fold)
    unused fputc(#char ",", stream)
    OptPass(stream, CStr("copy"), *counters.copy)
    unused fputc(#char ",", stream)
    OptPass(stream, CStr("cse"), *counters.cse)
    unused fputc(#char ",", stream)
    OptPass(stream, CStr("cfg"), *counters.cfg)
    unused fputc(#char ",", stream)
    OptPass(stream, CStr("dead"), *counters.dead)
    unused fputs(CStr("]}\n"), stream)
    return ifx ferror(stream) != 0 then 0 else 1
}

/* `zi2zx` writes revision-29 executable ZX to its -o file. `zi2zx run FILE.zi`
 * writes it to INTO instead, with FILE's folder as the default root and its
 * main as the default entry. */
BuildTo :: (argc: s32, argv: **u8, into: *void) -> s32 {
    root: *u8 = null
    output: *u8 = null
    entry: *u8 = null
    library: *u8 = null
    emit: *u8 = CStr("zx")
    compile_target: *u8 = CStr("zx")
    optimize: s32 = 0
    debug: s32 = 0
    checks: s32 = 0
    first_file: s32 = -1
    result: s32 = 1
    entry_module: [IR.ZIR_NAME_MAX]u8
    entry_function: [IR.ZIR_NAME_MAX]u8
    set: IR.ProgramSet = .{}
    merged: IR.ZirProgram = .{}
    link: ZxRun.ZxModuleBuild = .{}
    linkage: *u8 = null
    assets: BundleMod.ZxAssets = .{}
    views: *BundleMod.Asset = null
    bytes: *u8 = null
    lower: ZxRun.ZxLowerOwner = .{}
    target: *void = null
    temporary: [IR.ZIR_PATH_MAX]u8
    module_paths := CLI.CommandModulePaths(argc)
    if module_paths == null { return 1 }
    module_path_count: s32 = 0
    defines: [65]*u8
    define_count: s32 = 0
    bindings: [64]*u8
    binding_count: s32 = 0
    host_modules: [16]*u8
    host_module_count: s32 = 0
    retained: [64]*u8
    retained_count: s32 = 0
    records: *LinkRecord = null
    record_count: s32 = 0
    export_count: s32 = 0
    defer { if target != null && target != into && target != StandardOutput() { unused fclose(target) } }
    defer { if temporary[0] != 0 { unused remove(*temporary[0]) } }
    defer { ZxRun.LowerFree(*lower) }
    defer { free(cast(*void)linkage) }
    defer { free(cast(*void)link.imports) }
    defer { free(cast(*void)link.exports) }
    defer {
        record_index: s32 = 0
        while record_index < record_count {
            free(cast(*void)records[cast(usize)record_index].storage)
            record_index += 1
        }
        free(cast(*void)records)
    }
    defer { free(cast(*void)bytes) }
    defer { free(cast(*void)views) }
    defer { ZxAssetsFreeRaw(*assets) }
    defer { SymbolLookupsChanged() }
    defer { free(cast(*void)merged.modules) }
    defer { ProgramsFree(*set) }

    index: s32 = 0
    while index < argc {
        argument := argv[cast(usize)index]
        kind: s32 = LINK_EXPORT
        matched: s32 = 0
        while kind <= LINK_IMPORT {
            option: *u8 = CStr("--require-module")
            if kind == LINK_EXPORT { option = CStr("--export") }
            if kind == LINK_IMPORT { option = CStr("--import") }
            if strcmp(argument, option) == 0 { matched = 1; break }
            kind += 1
        }
        if matched != 0 {
            if records == null { records = cast(*LinkRecord)calloc(cast(usize)argc, size_of(LinkRecord)) }
            if records == null { return result }
            if index + 1 == argc || ParseLinkRecord(*records[cast(usize)record_count], kind, argv[cast(usize)(index + 1)]) == 0 {
                missing: *u8 = CStr("<missing>")
                if index + 1 < argc { missing = argv[cast(usize)(index + 1)] }
                Diagnostic(Span(CStr("<command>"), 1, 1), CStr("zx.module"),
                           CStr("invalid %s value: %s"), argument, missing)
                return result
            }
            record_count += 1
            if kind == LINK_EXPORT { export_count += 1 }
            index += 2
            continue
        }
        if strcmp(argument, CStr("--root")) == 0 && index + 1 < argc {
            index += 1
            root = argv[cast(usize)index]
        } else if strcmp(argument, CStr("--library")) == 0 {
            if library != null || index + 1 == argc ||
               LinkName(argv[cast(usize)(index + 1)], strlen(argv[cast(usize)(index + 1)]), 1) == 0 {
                Diagnostic(Span(CStr("<command>"), 1, 1), CStr("zx.module"), CStr("expected one valid --library name"))
                return result
            }
            index += 1
            library = argv[cast(usize)index]
        } else if (strcmp(argument, CStr("--module-path")) == 0 || strcmp(argument, CStr("-I")) == 0) && index + 1 < argc {
            index += 1
            module_paths[cast(usize)module_path_count] = argv[cast(usize)index]
            module_path_count += 1
        } else if strcmp(argument, CStr("--define")) == 0 && index + 1 < argc &&
                  define_count < 64 && CLI.ValidDefine(argv[cast(usize)(index + 1)]) != 0 {
            index += 1
            defines[cast(usize)define_count] = argv[cast(usize)index]
            define_count += 1
        } else if strcmp(argument, CStr("--asset-dir")) == 0 && index + 1 < argc {
            index += 1
            if ZxAssetsCollectRaw(*assets, argv[cast(usize)index]) == 0 {
                Diagnostic(Span(CStr("<command>"), 1, 1), CStr("zx.assets"),
                           CStr("cannot bundle assets: %s"), argv[cast(usize)index])
                return result
            }
        } else if strcmp(argument, CStr("--bind")) == 0 && index + 1 < argc && binding_count < 64 {
            index += 1
            bindings[cast(usize)binding_count] = argv[cast(usize)index]
            binding_count += 1
        } else if strcmp(argument, CStr("--bind-host")) == 0 && index + 1 < argc && host_module_count < 16 {
            index += 1
            host_modules[cast(usize)host_module_count] = argv[cast(usize)index]
            host_module_count += 1
        } else if strcmp(argument, CStr("--retain")) == 0 && index + 1 < argc && retained_count < 64 {
            index += 1
            retained[cast(usize)retained_count] = argv[cast(usize)index]
            retained_count += 1
        } else if strcmp(argument, CStr("--entry")) == 0 && index + 1 < argc {
            index += 1
            entry = argv[cast(usize)index]
        } else if strcmp(argument, CStr("--emit")) == 0 && index + 1 < argc {
            index += 1
            emit = argv[cast(usize)index]
        } else if strcmp(argument, CStr("--target")) == 0 && index + 1 < argc {
            index += 1
            compile_target = argv[cast(usize)index]
        } else if strncmp(argument, CStr("--target="), 9) == 0 {
            compile_target = cast(*u8)(cast(usize)argument + 9)
        } else if strcmp(argument, CStr("--opt")) == 0 {
            optimize = 1
        } else if strcmp(argument, CStr("--debug")) == 0 {
            debug = 1
        } else if strcmp(argument, CStr("--checks")) == 0 {
            checks = 1
        } else if strcmp(argument, CStr("--thorough")) == 0 {
            checks = 1
            LirVerifyPassesSet(1)
            MachineVerifySelfBuiltSet(1)
        } else if strcmp(argument, CStr("--quickest")) == 0 {
            LirVerifyPassesSet(0)
            MachineVerifySelfBuiltSet(0)
        } else if strcmp(argument, CStr("-o")) == 0 && index + 1 < argc {
            index += 1
            output = argv[cast(usize)index]
        } else if strncmp(argument, CStr("--diagnostics="), 14) == 0 {
            if SetFormat(cast(*u8)(cast(usize)argument + 14)) == 0 { return result }
        } else if argument[0] == #char "-" {
            Usage()
            return result
        } else {
            first_file = index
            break
        }
        index += 1
    }
    default_root: [IR.ZIR_PATH_MAX]u8
    default_entry: [IR.ZIR_NAME_MAX * 2]u8
    if (into != null || library != null) && first_file >= 0 {
        source := argv[cast(usize)first_file]
        slash := strrchr(source, #char "/")
        stem := source
        if slash != null { stem = cast(*u8)(cast(usize)slash + 1) }
        dot := strrchr(stem, #char ".")
        if root == null {
            length: s32 = 1
            if slash != null { length = cast(s32)(cast(usize)slash - cast(usize)source) }
            from: *u8 = CStr(".")
            if slash != null { from = source }
            if length == 0 { length = 1 }
            unused snprintf(*default_root[0], cast(usize)default_root.count, CStr("%.*s"), length, from)
            root = *default_root[0]
        }
        if into != null && entry == null {
            length: usize = strlen(stem)
            if dot != null { length = cast(usize)(cast(usize)dot - cast(usize)stem) }
            unused snprintf(*default_entry[0], cast(usize)default_entry.count, CStr("%.*s:main"),
                            cast(s32)length, stem)
            entry = *default_entry[0]
        }
    }
    if (library == null && export_count > 0) ||
       (library != null && (into != null || entry != null || retained_count != 0 || export_count == 0)) {
        Diagnostic(Span(CStr("<command>"), 1, 1), CStr("zx.module"),
                   CStr("--library requires --export roots and cannot be combined with run, --entry or --retain"))
        return result
    }
    emit_ok := strcmp(emit, CStr("zx")) == 0 || strcmp(emit, CStr("lir")) == 0 ||
        strcmp(emit, CStr("opt-report")) == 0
    target_ok := strcmp(compile_target, CStr("zx")) == 0 || strcmp(compile_target, CStr("wasm")) == 0
    into_ok := into == null || (strcmp(emit, CStr("zx")) == 0 && optimize == 0)
    entry_ok := library != null || CLI.SplitEntry(entry, *entry_module[0], *entry_function[0]) != 0
    if root == null || (output == null) == (into == null) || first_file < 0 || !emit_ok || !target_ok ||
       (strcmp(emit, CStr("opt-report")) == 0 && optimize == 0) || !into_ok || !entry_ok {
        Usage()
        return result
    }
    if strcmp(compile_target, CStr("wasm")) == 0 {
        CompilerConfigureTarget(TARGET_WASM, OS_WEB, CPU_WASM32)
    } else {
        CompilerConfigureTarget(TARGET_ZX, OS_NONE, CPU_NONE)
    }
    inputs := cast(**u8)(cast(usize)argv + cast(usize)first_file * size_of(*u8))
    if ProgramsLoadWithDefines(*set, root, module_paths, module_path_count,
                               cast(**u8)*defines, define_count, inputs, argc - first_file) == 0 {
        return result
    }
    if CheckCanonicalPrograms(set.programs, set.count, cast(**u8)set.paths) == 0 ||
       CLI.CommandMergePrograms(*set, *merged) == 0 || merged.module_count == 0 { return result }
    merged.checks = checks
    if checks != 0 { CLI.CommandEnableChecks(*set) }
    merged_ptr := *merged
    if LinkImports(*merged_ptr, 1) == 0 { return result }
    if CLI.CommandRetainFunctions(*merged, cast(**u8)*retained, retained_count, CStr("zx.entry")) == 0 { return result }
    b: s32 = 0
    while b < binding_count {
        if BindHostProvider(*merged, bindings[cast(usize)b]) == 0 { return result }
        b += 1
    }
    b = 0
    while b < host_module_count {
        if BindHostModule(*merged, host_modules[cast(usize)b]) == 0 { return result }
        b += 1
    }
    if PrepareModuleLink(*merged, library, records, record_count, *link, *linkage) == 0 {
        return result
    }
    /* The assets as the writer takes them, borrowing their bytes. */
    views = cast(*BundleMod.Asset)calloc(assets.count + 1, size_of(BundleMod.Asset))
    if views == null { return result }
    a: usize = 0
    while a < assets.count {
        item := assets.items[a]
        views[a].name = IR.CText(item.name)
        views[a].data = TextView(IR.CBuffer(item.data, cast(usize)item.size))
        a += 1
    }
    asset_slice := SliceOf(views, cast(s64)assets.count)
    size: usize = 0
    listing := strcmp(emit, CStr("lir")) == 0
    reporting := strcmp(emit, CStr("opt-report")) == 0
    if !listing && !reporting {
        bytes = ZxRun.ExecBuild(*merged, *entry_module[0], *entry_function[0], *link,
                                asset_slice, debug, *size)
        if bytes == null { return result }
    } else if ZxRun.LowerBuild(*merged, *entry_module[0], *entry_function[0], *link,
                               optimize, *lower) == 0 {
        return result
    }
    if into != null { target = into }
    else if strcmp(output, CStr("-")) == 0 { target = StandardOutput() }
    else { target = GeneratedOutputOpen(output, *temporary[0], cast(usize)temporary.count) }
    if target == null {
        label: *u8 = CStr("<memory>")
        if output != null { label = output }
        Diagnostic(Span(label, 1, 1), CStr("zx.output"), CStr("cannot create output"))
        return result
    }
    written: s32 = 0
    if reporting {
        written = OptReport(target, ZxRun.LowerOptimization(*lower))
    } else if listing {
        written = AssemblyPrintLir(ZxRun.LowerView(*lower), target)
    } else {
        written = cast(s32)(fwrite(cast(*void)bytes, 1, size, target) == size)
    }
    if into == null && target != StandardOutput() {
        if fclose(target) != 0 { written = 0 }
        target = null
        if written != 0 && GeneratedOutputReplace(*temporary[0], output) == 0 {
            temporary[0] = 0
        } else {
            written = 0
        }
    } else if target == StandardOutput() && fflush(StandardOutput()) != 0 {
        written = 0
    }
    if written == 0 {
        label: *u8 = CStr("<memory>")
        if output != null { label = output }
        Diagnostic(Span(label, 1, 1), CStr("zx.output"), CStr("cannot finish output"))
        return result
    }
    return 0
}

IsSource :: (path: *u8) -> s32 {
    length := strlen(path)
    if length > 3 && strcmp(cast(*u8)(cast(usize)path + length - 3), CStr(".zi")) == 0 { return 1 }
    if length > 4 && strcmp(cast(*u8)(cast(usize)path + length - 4), CStr(".zir")) == 0 { return 1 }
    if length > 3 && strcmp(cast(*u8)(cast(usize)path + length - 3), CStr(".ts")) == 0 { return 1 }
    if length > 4 && strcmp(cast(*u8)(cast(usize)path + length - 4), CStr(".tsx")) == 0 { return 1 }
    return 0
}

IsZx :: (path: *u8) -> s32 {
    length := strlen(path)
    if length > 3 && strcmp(cast(*u8)(cast(usize)path + length - 3), CStr(".zx")) == 0 { return 1 }
    return 0
}

ReadZx :: (path: *u8, size: *usize) -> *u8 {
    bytes := CLI.CommandReadBounded(path, 268435456, size)
    if bytes == null {
        Diagnostic(NoSpan(), CStr("zx.input"), CStr("cannot read bounded verified ZX input: %s"), path)
    }
    return bytes
}

InspectZx :: (argc: s32, argv: **u8) -> s32 {
    emit: *u8 = CStr("zx")
    output: *u8 = null
    input: *u8 = null
    index: s32 = 0
    while index < argc {
        argument := argv[cast(usize)index]
        if strcmp(argument, CStr("--emit")) == 0 && index + 1 < argc {
            index += 1
            emit = argv[cast(usize)index]
        } else if strcmp(argument, CStr("-o")) == 0 && index + 1 < argc {
            index += 1
            output = argv[cast(usize)index]
        } else if strncmp(argument, CStr("--diagnostics="), 14) == 0 {
            if SetFormat(cast(*u8)(cast(usize)argument + 14)) == 0 { return 1 }
        } else if argument[0] == #char "-" || input != null {
            Usage()
            return 1
        } else {
            input = argument
        }
        index += 1
    }
    emit_ok := strcmp(emit, CStr("zx")) == 0 || strcmp(emit, CStr("lir")) == 0 ||
        strcmp(emit, CStr("linkage")) == 0
    if input == null || output == null || IsZx(input) == 0 || !emit_ok {
        Usage()
        return 1
    }
    size: usize = 0
    bytes := ReadZx(input, *size)
    if bytes == null { return 1 }
    owner: ExecLink.ZxExecOwner = .{}
    read := ExecLink.ZxExecRead(*owner, TextView(IR.CBuffer(bytes, size)), Lowered.LirDefaultLimits())
    if read.problem != ExecLink.ZxExecProblem.None {
        problem := ExecLink.ZxExecProblemName(read.problem)
        Diagnostic(NoSpan(), CStr("zx.container"),
            CStr("executable ZX rejected: problem=%.*s codec=%d offset=%lld verifier=%d"),
            cast(s32)problem.count, Raw(problem), read.codec, read.offset, read.diagnostic.problem)
        free(cast(*void)bytes)
        return 1
    }
    temporary: [IR.ZIR_PATH_MAX]u8
    target: *void = null
    if strcmp(output, CStr("-")) == 0 { target = StandardOutput() }
    else { target = GeneratedOutputOpen(output, *temporary[0], cast(usize)temporary.count) }
    status: s32 = 1
    written: s32 = 0
    if target == null {
        Diagnostic(NoSpan(), CStr("zx.output"), CStr("cannot create output: %s"), output)
    } else {
        if strcmp(emit, CStr("lir")) == 0 {
            program := ExecLink.ZxExecReadProgram(*owner)
            written = AssemblyPrintLir(*program, target)
        } else if strcmp(emit, CStr("linkage")) == 0 {
            linkage := ExecLink.ZxExecReadModuleLinkage(*owner)
            written = ifx linkage.count == 0 then 1 else cast(s32)(fwrite(cast(*void)Raw(linkage), 1, cast(usize)linkage.count, target) == cast(usize)linkage.count)
        } else {
            written = cast(s32)(fwrite(cast(*void)bytes, 1, size, target) == size)
        }
        if target == StandardOutput() {
            if fflush(StandardOutput()) != 0 { written = 0 }
        } else {
            if fclose(target) != 0 { written = 0 }
            target = null
            if written != 0 && GeneratedOutputReplace(*temporary[0], output) == 0 {
                temporary[0] = 0
            } else {
                written = 0
            }
        }
        if written == 0 {
            Diagnostic(NoSpan(), CStr("zx.output"), CStr("cannot finish output: %s"), output)
        } else {
            status = 0
        }
    }
    if target != null && target != StandardOutput() { unused fclose(target) }
    if temporary[0] != 0 { unused remove(*temporary[0]) }
    ExecLink.ZxExecReadFree(*owner)
    free(cast(*void)bytes)
    return status
}

/* Source runs as a bundle built here in memory. */
OpenSource :: (argc: s32, argv: **u8) -> *Host.Bundle {
    memory := tmpfile()
    bundle: *Host.Bundle = null
    if memory == null {
        Diagnostic(Span(CStr("<command>"), 1, 1), CStr("zx.output"), CStr("cannot create a temporary bundle"))
        return null
    }
    if BuildTo(argc, argv, memory) == 0 && fflush(memory) == 0 {
        size := ftell(memory)
        data: *u8 = null
        if size > 0 { data = cast(*u8)malloc(cast(usize)size) }
        rewind(memory)
        if data != null && fread(cast(*void)data, 1, cast(usize)size, memory) == cast(usize)size {
            bundle = Host.BundleOpenBytes(data, cast(usize)size)
        }
        free(cast(*void)data)
    }
    unused fclose(memory)
    return bundle
}

RunLimit :: (text: *u8, value: *s64) -> s32 {
    end: *u8 = null
    ClearError()
    parsed := strtoull(text, *end, 10)
    if LastError() != 0 || end == text || end[0] != 0 || parsed > 9223372036854775807 {
        return 0
    }
    <<value = cast(s64)parsed
    return 1
}

RunDebugImage :: (path: *u8, limits: Exec.LirExecLimits, heap_report: s32) -> s32 {
    size: usize = 0
    bytes := ReadZx(path, *size)
    if bytes == null { return 1 }
    owner: ExecLink.ZxExecOwner = .{}
    read := ExecLink.ZxExecRead(*owner, TextView(IR.CBuffer(bytes, size)), Lowered.LirDefaultLimits())
    status: s32 = 1
    if read.problem != ExecLink.ZxExecProblem.None {
        problem := ExecLink.ZxExecProblemName(read.problem)
        Diagnostic(NoSpan(), CStr("zx.container"),
            CStr("executable ZX rejected: problem=%.*s codec=%d offset=%lld verifier=%d"),
            cast(s32)problem.count, Raw(problem), read.codec, read.offset, read.diagnostic.problem)
    } else if ExecLink.ZxExecReadModuleLinkage(*owner).count != 0 {
        Diagnostic(NoSpan(), CStr("zx.module-run"),
                   CStr("module-linked ZX requires normal execution with --backend engine or --backend native"))
    } else {
        program := ExecLink.ZxExecReadProgram(*owner)
        status = ZxRun.RunProgram(*program, limits, heap_report)
    }
    ExecLink.ZxExecReadFree(*owner)
    free(cast(*void)bytes)
    return status
}

RunCommand :: (argc: s32, argv: **u8) -> s32 {
    roots: **u8 = null
    root_count: usize = 0
    images: *ZxRun.ZxRunModuleImage = null
    image_count: usize = 0
    bundle: *Host.Bundle = null
    status: s32 = 1
    dispatch_host: s32 = 0
    debug_engine: s32 = 0
    heap_report: s32 = 0
    explicit_backend: bool = false
    fuel_given: bool = false
    native_steps: s32 = 0
    // The platform policy chooses the default before the bundle is loaded.
    backend: s32 = Host.POLICY_AUTO
    if AutoPlatformBackend() >= 3 { backend = Host.POLICY_NATIVE }
    limits := Exec.LirExecDefaultLimits()
    while argc > 0 && strncmp(argv[0], CStr("--"), 2) == 0 {
        argument := argv[0]
        if strcmp(argument, CStr("--host-dispatch")) == 0 {
            dispatch_host = 1
        } else if strcmp(argument, CStr("--backend")) == 0 && argc > 1 {
            if strcmp(argv[1], CStr("native")) == 0 { backend = Host.POLICY_NATIVE }
            else if strcmp(argv[1], CStr("engine")) == 0 { backend = Host.POLICY_ENGINE }
            else { Usage(); return status }
            explicit_backend = true
            argc -= 1
            argv = cast(**u8)(cast(usize)argv + size_of(*u8))
        } else if strcmp(argument, CStr("--module-root")) == 0 {
            if argc < 2 || argv[1][0] == 0 || strncmp(argv[1], CStr("--"), 2) == 0 { Usage(); return status }
            if roots == null { roots = cast(**u8)calloc(cast(usize)argc, size_of(*u8)) }
            if roots == null { return status }
            roots[root_count] = argv[1]
            root_count += 1
            argc -= 1
            argv = cast(**u8)(cast(usize)argv + size_of(*u8))
        } else if strcmp(argument, CStr("--module-image")) == 0 {
            if argc < 2 { Usage(); return status }
            if images == null { images = cast(*ZxRun.ZxRunModuleImage)calloc(cast(usize)argc, size_of(ZxRun.ZxRunModuleImage)) }
            if images == null { return status }
            image := *images[cast(usize)image_count]
            if ZxRun.RunModuleImageParse(argv[1], image) == 0 { Usage(); return status }
            i: usize = 0
            while i < image_count {
                if images[i].name_length == image.name_length &&
                   memcmp(cast(*void)images[i].name, cast(*void)image.name, image.name_length) == 0 {
                    Usage()
                    return status
                }
                i += 1
            }
            image_count += 1
            argc -= 1
            argv = cast(**u8)(cast(usize)argv + size_of(*u8))
        } else if strcmp(argument, CStr("--heap-report")) == 0 {
            heap_report = 1
            debug_engine = 1
        } else if (strcmp(argument, CStr("--work")) == 0 || strcmp(argument, CStr("--fuel")) == 0 ||
                   strcmp(argument, CStr("--frames")) == 0 || strcmp(argument, CStr("--addresses")) == 0) && argc > 1 {
            value: s64 = 0
            if RunLimit(argv[1], *value) == 0 { Usage(); return status }
            if strcmp(argument, CStr("--work")) == 0 { limits.work = value }
            else if strcmp(argument, CStr("--fuel")) == 0 { limits.fuel = value; fuel_given = true }
            else if strcmp(argument, CStr("--addresses")) == 0 { limits.addresses = value }
            else { limits.frames = value }
            if strcmp(argument, CStr("--fuel")) != 0 { debug_engine = 1 }
            argc -= 1
            argv = cast(**u8)(cast(usize)argv + size_of(*u8))
        } else if strncmp(argument, CStr("--diagnostics="), 14) != 0 {
            break
        } else if SetFormat(cast(*u8)(cast(usize)argument + 14)) == 0 {
            Usage()
            return status
        }
        argc -= 1
        argv = cast(**u8)(cast(usize)argv + size_of(*u8))
    }
    source: s32 = 0
    i: s32 = 0
    while i < argc {
        source |= IsSource(argv[cast(usize)i])
        i += 1
    }
    if source == 0 && argc != 1 { Usage(); return status }
    if explicit_backend && backend == Host.POLICY_NATIVE {
        if debug_engine != 0 || (fuel_given && (limits.fuel < 1 || limits.fuel > 2147483647)) {
            Diagnostic(NoSpan(), CStr("zx.native-limits"),
                CStr("explicit native execution accepts --fuel from 1 to 2147483647; --work, --frames, --addresses and --heap-report require the engine"))
            free(cast(*void)roots)
            free(cast(*void)images)
            return status
        }
        if fuel_given { native_steps = cast(s32)limits.fuel }
    } else if fuel_given { debug_engine = 1 }
    if image_count != 0 && (source != 0 || dispatch_host != 0 || debug_engine != 0 || root_count != 0) {
        Usage()
        return status
    }
    if debug_engine != 0 {
        if source != 0 || dispatch_host != 0 || root_count != 0 { Usage(); return status }
        status = RunDebugImage(argv[0], limits, heap_report)
        free(cast(*void)roots)
        free(cast(*void)images)
        return status
    }
    if source != 0 { bundle = OpenSource(argc, argv) }
    else { bundle = Host.BundleOpen(argv[0]) }
    if bundle == null {
        free(cast(*void)roots)
        free(cast(*void)images)
        return status
    }
    /* Discover the platform provider before running application code. */
    if dispatch_host != 0 && source == 0 && Host.ZxModuleProgramHasExternalHosts(bundle) != 0 {
        status = 3
        Host.BundleClose(bundle)
        free(cast(*void)roots)
        free(cast(*void)images)
        return status
    }
    result_value: s64 = 0
    has_result: s32 = 0
    /* Native preflight finishes before any initializer runs. */
    if backend == Host.POLICY_NATIVE {
        problem := Host.BundleNativeProblem(bundle)
        if problem[0] != 0 {
            Diagnostic(NoSpan(), CStr("zx.native"), CStr("%s"), problem)
            Host.BundleClose(bundle)
            free(cast(*void)roots)
            free(cast(*void)images)
            return status
        }
    }
    options: RunOptions = .{backend = backend, max_steps = native_steps}
    path: *u8 = null
    if source == 0 { path = argv[0] }
    ok := RunBundleRaw(cast(*void)bundle, path, roots, root_count, images, image_count,
                       *options, *result_value, *has_result)
    if ok != 0 && has_result != 0 {
        if Host.BundleEntryReturnType(bundle)[0] == #char "u" {
            unused printf(CStr("%llu\n"), result_value)
        } else {
            unused printf(CStr("%lld\n"), result_value)
        }
    }
    status = ifx ok != 0 then 0 else 1
    Host.BundleClose(bundle)
    free(cast(*void)roots)
    free(cast(*void)images)
    return status
}

AutoPlatformBackend :: () -> s32 #foreign compiler "BundleAutoPlatformBackend";

SliceDescriptor :: struct { data: *void; count: s64 }

SliceOf :: (data: *BundleMod.Asset, count: s64) -> []BundleMod.Asset {
    result: []BundleMod.Asset
    descriptor := cast(*SliceDescriptor)(*result)
    descriptor.data = cast(*void)data
    descriptor.count = count
    return result
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    SetFormatArguments(argc, argv)
    if argc > 1 && strcmp(argv[1], CStr("run")) == 0 {
        return RunCommand(argc - 2, cast(**u8)(cast(usize)argv + 2 * size_of(*u8)))
    }
    if argc <= 1 || strcmp(argv[1], CStr("bundle")) == 0 {
        Usage()
        return 1
    }
    CLI.CommandLowerPriority()
    // `zi2zx run` returns the program's own status; the other commands fail
    // only with a diagnostic.
    // `zi2zx -o FILE.zx` writes an input; only a trailing .zx that is not
    // -o's value asks to inspect one.
    if IsZx(argv[cast(usize)(argc - 1)]) != 0 && (argc < 3 || strcmp(argv[cast(usize)(argc - 2)], CStr("-o")) != 0) {
        return EnsureFailureReported(InspectZx(argc - 1, cast(**u8)(cast(usize)argv + size_of(*u8))), CStr("zi2zx"))
    }
    return EnsureFailureReported(BuildTo(argc - 1, cast(**u8)(cast(usize)argv + size_of(*u8)), null), CStr("zi2zx"))
}
