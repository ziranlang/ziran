// zx, the ZX Runner: runs any portable .zx program, as Linux runs an ELF
// file. `zx FILE.zx [ARGUMENT...]`.
//
// The runner knows no library: a bundle carries all of its own code and
// imports only host capabilities, which the runner answers itself
// (zx_runner_capabilities). A capability it lacks is an error naming it,
// never a hand-off to another program. The header is checked first, so a
// wrong file, or one made by an older or newer Ziran, gets a plain
// explanation. Started without a terminal, as from a file manager, the
// runner shows any failure in a dialog as well.
#import "std/bundle_host"
#import "std/byte_text_linux"
#import "std/c_string"
#import "std/environment_linux"
#import "std/file"
#import "std/file_linux"
#import "std/stdio_linux"
#import "std/text_tools"
#import "zx_runner_capabilities"
Native :: #import "std/guest_host";
#import "zx_runner_dialog"
#import "zx_runner_header"
using Vectors :: #import "std/vec"

#scope_file
libc :: #system_library "libc";
TerminalRaw :: (fd: s32) -> s32 #foreign libc "isatty";
ProcessIdRaw :: () -> s32 #foreign libc "getpid";
DuplicateRaw :: (fd: s32) -> s32 #foreign libc "dup";
ReplaceRaw :: (source: s32, destination: s32) -> s32 #foreign libc "dup2";
OpenRaw :: (path: *u8, flags: s32, mode: ..any) -> s32 #foreign libc "open";
CloseRaw :: (fd: s32) -> s32 #foreign libc "close";
WRITE_TRUNCATE_CREATE :: 577;
STANDARD_ERROR :: 2;
// More missing capabilities than this are counted, not listed.
LISTED_GAPS :: 6;

// Says what went wrong on standard error and, when nobody is watching a
// terminal, in a dialog.
Fail :: (message: string, attended: bool, code: s32) -> s32 {
    line: Vec(u8)
    BuilderPrint(*line, "zx: %\n", message)
    text: Text = BuilderFinish(line)
    unused PrintError(TextView(text))
    if !attended { ShowError(message) }
    return code
}

// A private file that holds the engine's standard error while unattended.
ErrorLogPath :: () -> Text {
    directory := EnvironmentText("XDG_RUNTIME_DIR")
    if directory == "" || directory[0] != #char "/" { directory = "/tmp" }
    path: Vec(u8)
    BuilderPrint(*path, "%/zx-runner-%.log", directory, ProcessIdRaw())
    return BuilderFinish(path)
}

// The last lines of a program's error output, short enough for a dialog.
Tail :: (text: string, limit: s64) -> string {
    if text.count <= limit { return text }
    start := text.count - limit
    while start < text.count && text[start] != #char "\n" { start += 1 }
    if start >= text.count - 1 { return text[text.count - limit:] }
    return text[start + 1:]
}

// Binds every capability the bundle imports and returns how many this
// runner lacks, listing them in missing.
Bind :: (bundle: *void, state: *Native.State, bindings: *Vec(HostBinding), missing: *Vec(u8)) -> s64 {
    gaps: s64 = 0
    count := BundleCapabilities(bundle)
    index: u64 = 0
    while index < count {
        module := BundleCapabilityModuleName(bundle, index)
        function := BundleCapabilityFunctionName(bundle, index)
        if RunnerProvides(TextFromCString(module), TextFromCString(function)) {
            VecPush(<<bindings, HostBinding.{module = module, function = function, call = RunnerCall, context = cast(*void)state})
        } else {
            gaps += 1
            if gaps <= LISTED_GAPS {
                BuilderPrint(missing, "%", ifx gaps == 1 then " " else ", ")
                BuilderPrint(missing, "%:%", TextFromCString(module), TextFromCString(function))
            }
        }
        index += 1
    }
    if gaps > LISTED_GAPS { BuilderPrint(missing, " and % more", gaps - LISTED_GAPS) }
    return gaps
}

// Runs the bound bundle natively and returns its exit status, or -1 when it
// could not start or stopped with an error.
Run :: (bundle: *void, bindings: []HostBinding) -> s32 {
    first: *HostBinding
    if bindings.count > 0 { first = *bindings[0] }
    options := BundleInstanceOptions.{backend = .Native, max_steps = 0}
    instance := InstantiateBundleWithOptions(bundle, first, cast(u64)bindings.count, *options)
    if instance == null { return -1 }
    value: s64
    has_value: s32
    finished := RunBundleInstance(instance, *value, *has_value)
    CloseBundleInstance(instance)
    if finished == 0 { return -1 }
    if has_value == 0 { return 0 }
    return cast(s32)(value & 255)
}

// What the dialog says about a run that failed while unattended.
Report :: (path: string, status: s32, detail: string) -> Text {
    report: Vec(u8)
    if status < 0 && detail == "" {
        BuilderPrint(*report, "% stopped with an error.", path)
    } else if status < 0 {
        BuilderPrint(*report, "% stopped with an error:\n\n%", path, detail)
    } else if detail == "" {
        BuilderPrint(*report, "% stopped with exit status %.", path, status)
    } else {
        BuilderPrint(*report, "% stopped with exit status %:\n\n%", path, status, detail)
    }
    return BuilderFinish(report)
}

#scope_export
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    attended := TerminalRaw(STANDARD_ERROR) == 1
    if argc < 2 {
        return Fail("usage: zx FILE.zx [ARGUMENT...]: open a .zx program with ZX Runner", attended, 2)
    }
    path := TextFromCString(argv[1])
    header := ReadZxHeader(path)
    if header.kind != .Runnable {
        problem: Text = ZxHeaderMessage(path, header)
        return Fail(TextView(problem), attended, 1)
    }
    bundle := OpenBundle(argv[1])
    if bundle == null {
        damaged: Vec(u8)
        BuilderPrint(*damaged, "% is damaged: it has a ZX header but its program cannot be read", path)
        message: Text = BuilderFinish(damaged)
        return Fail(TextView(message), attended, 1)
    }
    defer CloseBundle(bundle)
    // The bundle sees its own path as argument 0, then the arguments after it.
    state := Native.State.{bundle = bundle, argc = argc - 1, argv = *argv[1]}
    bindings: Vec(HostBinding)
    defer VecFree(bindings)
    missing: Vec(u8)
    if Bind(bundle, *state, *bindings, *missing) > 0 {
        gap: Vec(u8)
        BuilderPrint(*gap, "% needs capabilities this ZX Runner does not provide:%", path, TextFromBytes(VecSlice(missing, 0, missing.count)))
        message: Text = BuilderFinish(gap)
        return Fail(TextView(message), attended, 1)
    }
    native := GetBundleNativeProblem(bundle)
    if native != "" {
        unsupported: Vec(u8)
        BuilderPrint(*unsupported, "% cannot run on this computer: %", path, native)
        message: Text = BuilderFinish(unsupported)
        return Fail(TextView(message), attended, 1)
    }
    // Unattended, the engine's own diagnostics go to a file for the dialog.
    log: Text = ErrorLogPath()
    saved: s32 = -1
    if !attended {
        name: [4096]u8
        if CopyCString(TextView(log), name[:]) {
            capture := OpenRaw(*name[0], WRITE_TRUNCATE_CREATE, 384)
            if capture >= 0 {
                saved = DuplicateRaw(STANDARD_ERROR)
                unused ReplaceRaw(capture, STANDARD_ERROR)
                unused CloseRaw(capture)
            }
        }
    }
    status := Run(bundle, VecSlice(bindings, 0, bindings.count))
    if saved >= 0 {
        unused ReplaceRaw(saved, STANDARD_ERROR)
        unused CloseRaw(saved)
        errors, ok := ReadEntireFile(TextView(log))
        unused RemoveFile(TextView(log))
        if ok { unused PrintError(errors) }
        if status != 0 {
            shown: Text = Report(path, status, ifx ok then Tail(errors, 1500) else "")
            ShowError(TextView(shown))
        }
    }
    return ifx status < 0 then 1 else status
}
