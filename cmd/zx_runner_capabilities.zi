// The runner binds shared native capabilities plus its optional window host.
#import "std/bundle_host"
#import "std/byte_text_linux"
Native :: #import "std/guest_host";
// The window set needs a window host: SDL2 on a desktop, the app's EGL glue
// on Android. A runner built without one lacks guest_window.
#if #defined(ZX_ANDROID) {
    Window :: #import "zx_runner_window_android";
}
#if #defined(ZX_WINDOW) && !#defined(ZX_ANDROID) {
    Window :: #import "zx_runner_window";
}

RunnerProvides :: (module: string, function: string) -> bool {
    if Native.Provides(module, function) { return true }
    #if #defined(ZX_WINDOW) || #defined(ZX_ANDROID) {
        if module == "guest_window" {
            return function == "WindowOpenHost" || function == "WindowPresentHost" ||
                function == "WindowNextEventHost" || function == "WindowWaitHost" ||
                function == "WindowWidthHost" || function == "WindowHeightHost" ||
                function == "WindowTitleHost" || function == "WindowCursorHost" ||
                function == "WindowTextInputHost" || function == "ClipboardReadHost" ||
                function == "ClipboardWriteHost" || function == "WindowCloseHost"
        }
    }
    return false
}

#scope_file
using HostValueKind;

#if #defined(ZX_WINDOW) || #defined(ZX_ANDROID) {
WindowCall :: (state: *Native.State, function: string, arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if function == "WindowOpenHost" && count == 4 {
        opened := Window.WindowOpen(Native.Text(arguments[0]), cast(s32)Native.Whole(arguments[1]), cast(s32)Native.Whole(arguments[2]), Native.Whole(arguments[3]) != 0)
        return Native.Integer(result, ifx opened then 1 else 0)
    }
    if function == "WindowPresentHost" && count == 3 {
        shown := false
        {
            pixels := BytesFromPointer(cast(*u8)arguments[0].data, cast(u64)arguments[0].length)
            shown = Window.WindowPresent(pixels, cast(s32)Native.Whole(arguments[1]), cast(s32)Native.Whole(arguments[2]))
        }
        return Native.Integer(result, ifx shown then 1 else 0)
    }
    if function == "WindowNextEventHost" && count == 0 {
        bytes := Window.WindowNextEvent()
        if bytes.count == 0 { return Native.Borrowed(result, null, 0) }
        return Native.Borrowed(result, *bytes[0], cast(u64)bytes.count)
    }
    if function == "WindowWaitHost" && count == 1 {
        return Native.Integer(result, ifx Window.WindowWait(cast(s32)Native.Whole(arguments[0])) then 1 else 0)
    }
    if function == "WindowWidthHost" && count == 0 { width, _ := Window.WindowSize(); return Native.Integer(result, cast(s64)width) }
    if function == "WindowHeightHost" && count == 0 { _, height := Window.WindowSize(); return Native.Integer(result, cast(s64)height) }
    if function == "WindowTitleHost" && count == 1 { Window.WindowTitle(Native.Text(arguments[0])); return 1 }
    if function == "WindowCursorHost" && count == 1 { Window.WindowCursor(cast(s32)Native.Whole(arguments[0])); return 1 }
    if function == "WindowTextInputHost" && count == 1 { Window.WindowTextInput(Native.Whole(arguments[0]) != 0); return 1 }
    if function == "ClipboardReadHost" && count == 0 {
        Window.ClipboardRead(*state.answer)
        if state.answer.count == 0 { return Native.Borrowed(result, null, 0) }
        return Native.Borrowed(result, *state.answer[0], cast(u64)state.answer.count)
    }
    if function == "ClipboardWriteHost" && count == 1 {
        return Native.Integer(result, ifx Window.ClipboardWrite(Native.Text(arguments[0])) then 1 else 0)
    }
    if function == "WindowCloseHost" && count == 0 { Window.WindowClose(); return 1 }
    return 0
}
}

#scope_export
// The one host callback the runner binds for every capability it provides.
RunnerCall :: (context: *void, module_name: *u8, function_name: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    state := cast(*Native.State)context
    module := TextFromCString(module_name)
    function := TextFromCString(function_name)
    if !RunnerProvides(module, function) { return 0 }
    result.kind = cast(s32)HostVoid
    if Native.Provides(module, function) { return Native.Call(state, module, function, arguments, count, result) }
    #if #defined(ZX_WINDOW) || #defined(ZX_ANDROID) {
        if module == "guest_window" { return WindowCall(state, function, arguments, count, result) }
    }
    return 0
}
