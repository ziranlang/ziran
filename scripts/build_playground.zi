#!/usr/bin/env -S ziran run --target=c
// Build the website's checker and VM with Emscripten. Generated assets stay
// out of Git; the website workflow builds them before publishing.
// ziran run --target=c scripts/build_playground.zi [--emcc PATH]
#import "std/byte_text_linux"
#import "std/environment_linux"
#import "std/file_tree_linux"
#import "std/process_run_linux"
#import "std/text_tools"
using Vectors :: #import "std/vec"

#scope_file
Concat :: (left: string, right: string) -> string {
    parts: [2]string = .[left, right]
    return TextJoin(parts[:], "")
}

// A word for make's command line, which hands CC and AR to the shell.
Quote :: (value: string) -> string {
    parts: [3]string = .["'", TextReplace(value, "'", "'\\''"), "'"]
    return TextJoin(parts[:], "")
}

FindOnPath :: (name: string) -> string {
    directories := TextSplit(EnvironmentText("PATH"), ":")
    for directory: VecSlice(directories, 0, directories.count) {
        candidate := JoinPath(directory, name)
        if IsFile(candidate) { return candidate }
    }
    return ""
}

Run :: (command: []string, repo: string, environment: []string) -> bool {
    run: ProcessRun
    options: ProcessOptions
    options.arguments = command
    options.directory = repo
    options.environment = environment
    if RunProcess(options, *run) && run.code == 0 { return true }
    print("% failed: exit %\n", TextJoin(command, " "), run.code)
    return false
}

#scope_export
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    emcc := ""
    output_directory := ""
    embeds: Vec(string)
    index: s32 = 1
    while index < argc {
        option := TextFromCString(argv[index])
        if index + 1 >= argc { print("% needs a value\n", option); return 2 }
        value := TextFromCString(argv[index + 1])
        if option == "--emcc" { emcc = value }
        else if option == "--output-dir" { output_directory = value }
        else if option == "--embed-file" { VecPush(embeds, value) }
        else { print("unknown argument: %\n", option); return 2 }
        index += 2
    }
    if emcc == "" { emcc = FindOnPath("emcc") }
    if emcc == "" { print("emcc is required; activate the Emscripten SDK first\n"); return 2 }
    emcc = ResolvePath(emcc)
    if emcc == "" { print("cannot find emcc\n"); return 2 }
    emar := JoinPath(PathParent(emcc), "emar")
    repo := PathParent(PathParent(EnvironmentText("ZIRAN_SCRIPT_FILE")))
    if output_directory == "" { output_directory = JoinPath(repo, "site/assets") }
    if !CreateDirectories(output_directory) { print("%: cannot create\n", output_directory); return 1 }
    assets := ResolvePath(output_directory)
    build := JoinPath(repo, "build/playground64")

    environment: Vec(string)
    VecPush(environment, "EM_FROZEN_CACHE")
    if EnvironmentText("EM_CACHE") == "" {
        VecPush(environment, Concat("EM_CACHE=", JoinPath(repo, "build/emscripten-cache")))
    }
    settings := VecSlice(environment, 0, environment.count)

    // Keep C's 64-bit long, then lower addressing for wasm32 browsers.
    make: [8]string = .["make", "BUILD_DIR=build/playground64",
        Concat(Concat("CC=", Quote(emcc)), " -sMEMORY64=2"), Concat("AR=", Quote(emar)),
        "OBJCOPY=true", "CFLAGS=-O2",
        "FRAMEFLAGS=-Wframe-larger-than=16384", "build/playground64/libziran.a"]
    if !Run(make[:], repo, settings) { return 1 }
    command: Vec(string)
    fixed: [20]string = .[emcc, "-O2", "-std=c11", "-D_GNU_SOURCE", "-Iinclude", "-Icmd/zir",
        "web/playground.c", "web/bundle.c", JoinPath(build, "libziran.a"), "-lm",
        "-sMEMORY64=2", "-sMODULARIZE=1", "-sEXPORT_NAME=createPlayground",
        "-sEXPORTED_FUNCTIONS=_RunSource,_BuildBundle", "-sEXPORTED_RUNTIME_METHODS=FS,ccall",
        "-sENVIRONMENT=worker,node", "-sALLOW_MEMORY_GROWTH=1", "-sMAXIMUM_MEMORY=536870912",
        "-sSTACK_SIZE=8388608", "--embed-file"]
    for part: fixed { VecPush(command, part) }
    VecPush(command, "std@/std")
    for embed: VecSlice(embeds, 0, embeds.count) { VecPush(command, "--embed-file"); VecPush(command, embed) }
    VecPush(command, "-o"); VecPush(command, JoinPath(assets, "playground-runtime.js"))
    if !Run(VecSlice(command, 0, command.count), repo, settings) { return 1 }
    return 0
}
