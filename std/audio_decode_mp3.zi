// MPEG audio for std/audio: MP3 (MPEG-1, 2 and 2.5 Layer III) and Layers
// I and II, decoded as it plays by std/audio_mp3 over dr_mp3 at the stream's own
// rate. Importing this module is what adds the format; native programs link
// audio's libziran_mp3.a (make's $(MP3_A)) and -lm.
Mixer :: #import "std/audio";
Mp3 :: #import "std/audio_mp3";
Mpeg :: #import "std/audio_mpeg";
Types :: #import "std/audio_types";

#scope_file
libc :: #system_library "c";
Allocate :: (count: usize, size: usize) -> *void #foreign libc "calloc";
Free :: (value: *void) #foreign libc "free";

State :: struct { decoder: Mp3.Mp3Decoder; }

// Every frame of the stream checks out, tags aside.
Probe :: (bytes: []u8) -> bool {
    info: Mpeg.Mp3Info
    return Mpeg.Mp3Inspect(bytes, *info) == Types.OK
}

Read :: (argument: *void, output: []float32, frames: s64) -> s64 {
    state := cast(*State)argument
    made: s64
    channels := cast(s64)state.decoder.info.channels
    if Mp3.Mp3DecoderRead(*state.decoder, output[0:frames * channels], *made) != Types.OK { return -1 }
    return made
}

Rewind :: (argument: *void) -> bool {
    return Mp3.Mp3DecoderRewind(*(cast(*State)argument).decoder) == Types.OK
}

Seek :: (argument: *void, frame: s64) -> bool {
    return Mp3.Mp3DecoderSeek(*(cast(*State)argument).decoder, frame) == Types.OK
}

Close :: (argument: *void) {
    state := cast(*State)argument
    Mp3.Mp3DecoderClose(*state.decoder)
    Free(argument)
}

Open :: (bytes: []u8, source: *Mixer.AudioSource) -> bool {
    state := cast(*State)Allocate(1, size_of(State))
    if state == null { return false }
    if Mp3.Mp3DecoderOpen(*state.decoder, bytes, Mpeg.Mp3MaxStreamFrames) != Types.OK {
        Free(cast(*void)state)
        return false
    }
    info := state.decoder.info
    source.* = .{.state = cast(*void)state, .read = Read, .rewind = Rewind, .close = Close, .seek = Seek,
        .rate = info.rate, .channels = info.channels, .frames = info.frames}
    return true
}

registered: bool = Mixer.AudioUseDecoder(Probe, Open);
