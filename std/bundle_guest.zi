// A portable coordinator may use these capabilities when its host grants
// child execution. Handles are local to one caller and zero means no child.
// A host chooses all child bindings and owns the child until Close or caller
// teardown. A bundle cannot supply a native binding or callback.
host_api :: #system_library "host_api";

OpenChildBundleHost :: (bytes: string, identity: string) -> u64 #foreign host_api;
RestartChildBundleHost :: (child: u64) -> bool #foreign host_api;
CloseChildBundleHost :: (child: u64) -> bool #foreign host_api;
ChildBundleAssetCountHost :: (child: u64) -> u64 #foreign host_api;
ChildBundleAssetNameHost :: (child: u64, index: u64) -> string #foreign host_api;
ChildBundleAssetDataHost :: (child: u64, index: u64) -> string #foreign host_api;

#program_export
Open :: (bytes: string, identity: string) -> u64 {
    return OpenChildBundleHost(bytes, identity)
}

#program_export
Restart :: (child: u64) -> bool { return RestartChildBundleHost(child) }

#program_export
Close :: (child: u64) -> bool { return CloseChildBundleHost(child) }

#program_export
AssetCount :: (child: u64) -> u64 { return ChildBundleAssetCountHost(child) }

#program_export
AssetName :: (child: u64, index: u64) -> string {
    return ChildBundleAssetNameHost(child, index)
}

#program_export
AssetData :: (child: u64, index: u64) -> string {
    return ChildBundleAssetDataHost(child, index)
}
