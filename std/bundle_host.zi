// Native C ABI for embedding a portable Ziran bundle. The runtime owns the
// bundle and instance; callers own binding contexts and borrowed result data.
#scope_export
runtime :: #system_library "ziran";

HostValueKind :: enum {
    HostVoid :: 0
    HostInteger :: 1
    HostUnsigned :: 2
    HostReal :: 3
    HostString :: 4
    HostRecord :: 5
    HostSlice :: 6
    HostPointer :: 7
    HostArray :: 8
}

HostValue :: struct {
    kind: s32
    type_name: *u8
    integer: s64
    bits: u64
    real: float64
    data: *u8
    length: usize
    fields: *HostField
    field_count: usize
    elements: *HostValue
    pointer: *void
}

HostField :: struct {
    name: *u8
    value: HostValue
}

HostCall :: #type (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 #c_call;

HostBinding :: struct {
    module: *u8
    function: *u8
    call: HostCall
    context: *void
}

#scope_file
RawBundleOpen :: (path: *u8) -> *void #foreign runtime "BundleOpen";
RawBundleOpenBytes :: (data: *u8, size: usize) -> *void #foreign runtime "BundleOpenBytes";
RawBundleOpenWithLibraries :: (path: *u8, libraries: **void,
    count: usize) -> *void #foreign runtime "BundleOpenWithLibraries";
RawBundleOpenBytesWithLibraries :: (data: *u8, size: usize,
    libraries: **void, count: usize) -> *void #foreign runtime "BundleOpenBytesWithLibraries";
RawBundleClose :: (bundle: *void) #foreign runtime "BundleClose";
RawBundleCapabilityCount :: (bundle: *void) -> usize #foreign runtime "BundleCapabilityCount";
RawBundleCapabilityModule :: (bundle: *void, index: usize) -> *u8 #foreign runtime "BundleCapabilityModule";
RawBundleCapabilityFunction :: (bundle: *void, index: usize) -> *u8 #foreign runtime "BundleCapabilityFunction";
RawBundleAssetCount :: (bundle: *void) -> usize #foreign runtime "BundleAssetCount";
RawBundleAssetName :: (bundle: *void, index: usize) -> *u8 #foreign runtime "BundleAssetName";
RawBundleAssetData :: (bundle: *void, index: usize) -> *u8 #foreign runtime "BundleAssetData";
RawBundleAssetSize :: (bundle: *void, index: usize) -> usize #foreign runtime "BundleAssetSize";
RawBundleInstantiate :: (bundle: *void, bindings: *HostBinding,
    count: usize) -> *void #foreign runtime "BundleInstantiate";
RawBundleInstanceRun :: (instance: *void, result: *s64,
    has_result: *s32) -> s32 #foreign runtime "BundleInstanceRun";
RawBundleInstanceClose :: (instance: *void) #foreign runtime "BundleInstanceClose";
RawBundleInstanceLimitSteps :: (instance: *void, max_steps: s32) #foreign runtime "BundleInstanceLimitSteps";
RawBundleInstanceMatchFieldsByName :: (instance: *void, enabled: s32) #foreign runtime "BundleInstanceMatchFieldsByName";

#scope_export
#program_export
OpenBundle :: (path: *u8) -> *void { return RawBundleOpen(path) }

#program_export
OpenBundleWithLibraries :: (path: *u8, libraries: **void,
    count: u64) -> *void {
    if count > 64 {
        return null
    }
    return RawBundleOpenWithLibraries(path, libraries, cast(usize)count)
}

#program_export
OpenBundleBytesWithLibraries :: (data: *u8, size: u64,
    libraries: **void, count: u64) -> *void {
    narrowed := cast(usize)size
    if cast(u64)narrowed != size || count > 64 {
        return null
    }
    return RawBundleOpenBytesWithLibraries(data, narrowed, libraries, cast(usize)count)
}

#program_export
OpenBundleBytes :: (data: *u8, size: u64) -> *void {
    narrowed := cast(usize)size
    if cast(u64)narrowed != size {
        return null
    }
    return RawBundleOpenBytes(data, narrowed)
}

#program_export
CloseBundle :: (bundle: *void) { RawBundleClose(bundle) }

// Borrowed names remain valid until CloseBundle. A host can bind the exact
// package-qualified names in a downloaded program without knowing its lock.
#program_export
BundleCapabilities :: (bundle: *void) -> u64 {
    return cast(u64)RawBundleCapabilityCount(bundle)
}

#program_export
BundleCapabilityModuleName :: (bundle: *void, index: u64) -> *u8 {
    narrowed := cast(usize)index
    if cast(u64)narrowed != index {
        return null
    }
    return RawBundleCapabilityModule(bundle, narrowed)
}

#program_export
BundleCapabilityFunctionName :: (bundle: *void, index: u64) -> *u8 {
    narrowed := cast(usize)index
    if cast(u64)narrowed != index {
        return null
    }
    return RawBundleCapabilityFunction(bundle, narrowed)
}

#program_export
BundleAssets :: (bundle: *void) -> u64 { return cast(u64)RawBundleAssetCount(bundle) }

#program_export
BundleAssetPath :: (bundle: *void, index: u64) -> *u8 {
    narrowed := cast(usize)index
    if cast(u64)narrowed != index {
        return null
    }
    return RawBundleAssetName(bundle, narrowed)
}

#program_export
BundleAssetBytes :: (bundle: *void, index: u64) -> *u8 {
    narrowed := cast(usize)index
    if cast(u64)narrowed != index {
        return null
    }
    return RawBundleAssetData(bundle, narrowed)
}

#program_export
BundleAssetLength :: (bundle: *void, index: u64) -> u64 {
    narrowed := cast(usize)index
    if cast(u64)narrowed != index {
        return 0
    }
    return cast(u64)RawBundleAssetSize(bundle, narrowed)
}

#program_export
InstantiateBundle :: (bundle: *void, bindings: *HostBinding,
    count: u64) -> *void {
    narrowed := cast(usize)count
    if cast(u64)narrowed != count {
        return null
    }
    return RawBundleInstantiate(bundle, bindings, narrowed)
}

#program_export
RunBundleInstance :: (instance: *void, result: *s64,
    has_result: *s32) -> s32 {
    return RawBundleInstanceRun(instance, result, has_result)
}

#program_export
CloseBundleInstance :: (instance: *void) { RawBundleInstanceClose(instance) }

#program_export
LimitBundleSteps :: (instance: *void, max_steps: s32) {
    RawBundleInstanceLimitSteps(instance, max_steps)
}

// Records returned to the instance match fields by name, so a bundle built
// against an older or newer record layout still runs.
#program_export
MatchBundleFieldsByName :: (instance: *void, enabled: bool) {
    RawBundleInstanceMatchFieldsByName(instance, ifx enabled then 1 else 0)
}
