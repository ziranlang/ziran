// An owned native callable. The compiler supplies typed capture storage,
// an invoke trampoline and deterministic cleanup for a concrete Signature.
// Raw procedure types keep their ordinary function-pointer ABI.
Owned :: struct($Signature: Type) {
    signature: Signature;
}

// A borrowed native callable. Its environment belongs to the calling scope;
// callees may invoke or forward it, but cannot retain it.
Scoped :: struct($Signature: Type) {
    signature: Signature;
}
