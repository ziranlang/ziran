using Types :: #import "date_time_types";

host_api :: #system_library "host_api";

LocalNowHost :: () -> LocalDateTime #foreign host_api;
UnixNowHost :: () -> s64 #foreign host_api;

#program_export
LocalNow :: () -> LocalDateTime {
    return LocalNowHost()
}

#program_export
UnixNow :: () -> s64 {
    return UnixNowHost()
}
