#import "date_time_types"

// time_t and long are the size of a pointer on Linux and Android, so 32-bit
// on armeabi-v7a; 64-bit fields read the clock as garbage there. Keep
// libc's struct tm layout private and copy each reentrant reading.
#scope_file
libc :: #system_library "libc";
TimeRaw :: (result: *isize) -> isize #foreign libc "time";
LocalTimeRaw :: (seconds: *isize, fields: *TimeFields) -> *TimeFields #foreign libc "localtime_r";
UtcTimeRaw :: (seconds: *isize, fields: *TimeFields) -> *TimeFields #foreign libc "gmtime_r";
ClockValue :: struct { seconds: isize; nanoseconds: isize; }
ClockGetTimeRaw :: (clock: s32, value: *ClockValue) -> s32 #foreign libc "clock_gettime";

TimeFields :: struct {
    second: s32
    minute: s32
    hour: s32
    day: s32
    month: s32
    year: s32
    weekday: s32
    day_of_year: s32
    daylight_saving: s32
    utc_offset: isize
    timezone: *u8
}

Reading :: (fields: *TimeFields) -> LocalDateTime {
    result: LocalDateTime
    if fields == null { return result }
    result.year = fields.year + 1900
    result.month = fields.month + 1
    result.day = fields.day
    result.day_of_year = fields.day_of_year
    result.hour = fields.hour
    result.minute = fields.minute
    result.second = fields.second
    result.valid = true
    return result
}

#scope_export
// Keep these clock providers module-qualified: a native host may also
// import date_time, which exports UnixNow and LocalNow for its callers.
UnixNow :: () -> s64 {
    return cast(s64)TimeRaw(null)
}

#program_export
UnixMilliseconds :: () -> s64 {
    value: ClockValue
    if ClockGetTimeRaw(0, *value) != 0 { return -1 }
    seconds := cast(s64)value.seconds
    nanoseconds := cast(s64)value.nanoseconds
    if seconds < 0 || seconds > 9223372036854775 || nanoseconds < 0 || nanoseconds > 999999999 { return -1 }
    return seconds * 1000 + nanoseconds / 1000000
}

#program_export
LocalAt :: (seconds: s64) -> LocalDateTime {
    fields: TimeFields
    value := cast(isize)seconds
    // A 32-bit time_t cannot name every second.
    if cast(s64)value != seconds {
        return LocalDateTime.{}
    }
    return Reading(LocalTimeRaw(*value, *fields))
}

#program_export
UtcAt :: (seconds: s64) -> LocalDateTime {
    fields: TimeFields
    value := cast(isize)seconds
    // A 32-bit time_t cannot name every second.
    if cast(s64)value != seconds {
        return LocalDateTime.{}
    }
    return Reading(UtcTimeRaw(*value, *fields))
}

LocalNow :: () -> LocalDateTime { return LocalAt(UnixNow()) }
