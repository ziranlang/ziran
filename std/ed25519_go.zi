// Ed25519 keys and signatures retain Go's native types and validation behavior.
#import "go_types"
go_ed25519 :: #system_library "go:crypto/ed25519";
go_random :: #system_library "go:crypto/rand";
go_io :: #system_library "go:io";
PublicKey :: #type #foreign go_ed25519 "PublicKey";
PrivateKey :: #type #foreign go_ed25519 "PrivateKey";
KeyPairResult :: struct {
    publicKey: PublicKey
    privateKey: PrivateKey
    error: Error
}

#scope_file
RandomSource :: #type #foreign go_io "Reader";
ReaderRaw :: () -> RandomSource #go_field #foreign go_random "Reader";
GenerateRaw :: (source: RandomSource) -> KeyPairResult #go_results #foreign go_ed25519 "GenerateKey";
FromSeedRaw :: (seed: []u8) -> PrivateKey #foreign go_ed25519 "NewKeyFromSeed";
SignRaw :: (key: PrivateKey, message: []u8) -> []u8 #foreign go_ed25519 "Sign";
VerifyRaw :: (key: PublicKey, message: []u8, signature: []u8) -> bool #foreign go_ed25519 "Verify";
EqualRaw :: (key: PublicKey, other: PublicKey) -> bool #foreign go_ed25519 "PublicKey.Equal";

#scope_export
GenerateKey :: () -> KeyPairResult {
    return GenerateRaw(ReaderRaw())
}
NewKeyFromSeed :: (seed: []u8) -> PrivateKey {
    return FromSeedRaw(seed)
}
Sign :: (key: PrivateKey, message: []u8) -> []u8 {
    return SignRaw(key, message)
}
Verify :: (key: PublicKey, message: []u8, signature: []u8) -> bool {
    return VerifyRaw(key, message, signature)
}
Equal :: (key: PublicKey, other: PublicKey) -> bool {
    return EqualRaw(key, other)
}
