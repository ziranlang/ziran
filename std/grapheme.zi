// Unicode 17.0 extended grapheme clusters (UAX #29, GB3–GB13).
// Byte offsets remain suitable for slices and wire protocols. A cluster is
// a user-perceived character; this module needs no font, display or host.
U :: #import "std/utf8";
Data :: #import "grapheme_data";

IsControl :: (property: s32) -> bool {
    return property == 1 || property == 2 || property == 3
}

// Streaming segmentation also supports callers reading segmented or borrowed
// text without joining it into an allocation.
State :: struct {
    active: bool
    valid: bool
    previous: s32
    regional: s32
    pictographic: bool
    joined_pictographic: bool
    consonant: bool
    linker: bool
}
Step :: struct { state: State; boundary: bool; }

Push :: (state: State, scalar: u32, valid: bool) -> Step {
    result: Step
    flags := Data.Property(scalar)
    current := flags & 255
    previous := state.previous
    join: bool
    if state.active && state.valid && valid {
        if previous == 1 && current == 2 { join = true }
        else if IsControl(previous) || IsControl(current) { join = false }
        else if previous == 9 && (current == 9 || current == 10 || current == 12 || current == 13) { join = true }
        else if (previous == 12 || previous == 10) && (current == 10 || current == 11) { join = true }
        else if (previous == 13 || previous == 11) && current == 11 { join = true }
        else if current == 4 || current == 5 || current == 8 || previous == 7 { join = true }
        else if (flags & 512) != 0 && state.consonant && state.linker { join = true }
        else if (flags & 256) != 0 && previous == 5 && state.joined_pictographic { join = true }
        else if previous == 6 && current == 6 && state.regional % 2 == 1 { join = true }
    }
    result.boundary = state.active && !join
    if !join { state = State.{} }
    state.joined_pictographic = current == 5 && state.pictographic
    if (flags & 256) != 0 { state.pictographic = true }
    else if current != 4 { state.pictographic = false }
    if (flags & 512) != 0 { state.consonant = true; state.linker = false }
    else if (flags & 2048) != 0 { state.linker = state.consonant }
    else if (flags & 1024) == 0 { state.consonant = false; state.linker = false }
    if current == 6 { state.regional += 1 } else { state.regional = 0 }
    state.previous = current
    state.active = true
    state.valid = valid
    result.state = state
    return result
}

// at must be a cluster boundary. Invalid UTF-8 bytes form individual clusters
// and reset context. Clamped endpoints always make progress.
#program_export "GraphemeNext"
Next :: (value: string, at: s32) -> s32 {
    if at < 0 { at = 0 }
    length := cast(s32)value.count
    if at >= length { return length }
    state: State
    cursor := at
    while cursor < length {
        point := U.Decode(value, cursor)
        step := Push(state, point.value, point.valid)
        if step.boundary { return cursor }
        state = step.state
        cursor = point.after
    }
    return length
}

// Finds the preceding cluster start, including when at is inside a cluster.
Previous :: (value: string, at: s32) -> s32 {
    if at <= 0 { return 0 }
    if at > cast(s32)value.count { at = cast(s32)value.count }
    cursor: s32 = 0
    while cursor < at {
        after := Next(value, cursor)
        if after >= at { return cursor }
        cursor = after
    }
    return cursor
}

// Snap a borrowed byte offset down to a complete grapheme boundary.
Boundary :: (value: string, at: s32) -> s32 {
    if at <= 0 { return 0 }
    if at >= cast(s32)value.count { return cast(s32)value.count }
    cursor: s32 = 0
    while cursor < at {
        after := Next(value, cursor)
        if after > at { return cursor }
        cursor = after
    }
    return cursor
}

#program_export "GraphemeCount"
Count :: (value: string) -> s32 {
    cursor: s32 = 0
    count: s32 = 0
    while cursor < cast(s32)value.count { cursor = Next(value, cursor); count += 1 }
    return count
}
