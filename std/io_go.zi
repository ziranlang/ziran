// Native Go stream interfaces retain resource ownership and error identity.
#import "go_types"
go_io :: #system_library "go:io";
Reader :: #type #foreign go_io "Reader";
ReadCloser :: #type #foreign go_io "ReadCloser";
Writer :: #type #foreign go_io "Writer";
ReadAllResult :: struct {
    value: []u8
    error: Error
}

#scope_file
ReadAllRaw :: (reader: Reader) -> ReadAllResult #go_results #foreign go_io "ReadAll";
CloseRaw :: (reader: ReadCloser) -> Error #foreign go_io "ReadCloser.Close";

#scope_export
ReadAll :: (reader: Reader) -> ReadAllResult {
    return ReadAllRaw(reader)
}
Close :: (reader: ReadCloser) -> Error {
    return CloseRaw(reader)
}
