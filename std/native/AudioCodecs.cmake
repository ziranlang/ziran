# Native MP3 implementation for std/audio_mp3. No UI or audio package needed.
include_guard(GLOBAL)
function(ziran_audio_mp3)
    if(TARGET ziran_mp3)
        return()
    endif()
    set(dr_mp3_dir "${CMAKE_CURRENT_BINARY_DIR}/dr_mp3")
    file(MAKE_DIRECTORY "${dr_mp3_dir}")
    set(dr_mp3_ref f12e197fd462e4c22873fbd70d11b1d2f2c1dc3c)
    foreach(file IN ITEMS dr_mp3.h LICENSE)
        if(file STREQUAL "dr_mp3.h")
            set(hash 7a6cc38b0afdb55cfc9eec991d9169d67beb8fd910be2995121510cdaa99c356)
        else()
            set(hash dd1c647e6f767f8ff4b2dfae0fed314726600a01e0cf1ef556afddd5fa96ff15)
        endif()
        if(EXISTS "${dr_mp3_dir}/${file}")
            file(SHA256 "${dr_mp3_dir}/${file}" actual)
        else()
            set(actual "")
        endif()
        if(NOT actual STREQUAL hash)
            file(DOWNLOAD "https://raw.githubusercontent.com/mackron/dr_libs/${dr_mp3_ref}/${file}"
                "${dr_mp3_dir}/${file}" EXPECTED_HASH SHA256=${hash} TLS_VERIFY ON)
        endif()
    endforeach()
    add_library(ziran_mp3 STATIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ziran_mp3.c")
    target_include_directories(ziran_mp3 PRIVATE "${dr_mp3_dir}")
    target_compile_options(ziran_mp3 PRIVATE -ffunction-sections -fdata-sections)
    set_target_properties(ziran_mp3 PROPERTIES POSITION_INDEPENDENT_CODE ON C_STANDARD 99)
endfunction()
