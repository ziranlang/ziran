// Pillow's separable resampling of 8-bit RGBA as allocation-free row
// kernels, with x86-64 (std/simd, SSE2 to AVX2), NEON (AArch64 and ARMv7)
// and WebAssembly SIMD128 versions that make the same bytes.
//
//     axis: ResampleAxis
//     ResampleAxisInto(*axis, 640, 853, RESAMPLE_LANCZOS)  // weights once
//     ResampleRowHorizontal(*axis, source_row, target_row) // then every row
//
// ResamplePlan resizes a whole premultiplied picture in two passes with
// scratch it owns, so resizing again to the same size never allocates; its
// passes split into row ranges for worker threads.
//
// Weights are Pillow's 22-bit fixed point, each pass rounds to bytes and
// the arithmetic is on the stored (premultiplied) bytes, not linear light,
// as in Pillow. The scalar loops are the reference; the fastest kernels
// this CPU has are chosen once. An axis whose sums could leave 32 bits,
// which Pillow's filters never produce, uses the scalar loops. Pointer
// kernels need a native target; std/image keeps the portable resizes.
using Vectors :: #import "vec"
#import "math"
Simd :: #import "simd"

RESAMPLE_BOX :: 0
RESAMPLE_LANCZOS :: 1
RESAMPLE_BICUBIC :: 2

RESAMPLE_SCALAR :: 0
RESAMPLE_SSE2 :: 1
RESAMPLE_AVX2 :: 2
RESAMPLE_NEON :: 3
RESAMPLE_SIMD128 :: 4

// Weights from INPUT source positions to OUTPUT positions along one axis.
ResampleAxis :: struct {
    input: s32
    output: s32
    // Weights kept per output position, and u32 words per packed entry.
    size: s32
    entry: s32
    // Every partial sum fits in 32 bits, so the vector kernels are exact.
    exact: bool
    // First source position and tap count of each output position.
    bounds: Vec(s32)
    weights: Vec(s32)
    // Each output: first position, count, then per pair of taps the 16-bit
    // low halves of both weights and their high halves.
    packed: Vec(u32)
    scratch: Vec(float64)
}

// Both passes of one resize and the rows between them.
ResamplePlan :: struct {
    horizontal: ResampleAxis
    vertical: ResampleAxis
    source_width: s32
    source_height: s32
    width: s32
    height: s32
    horizontal_pass: bool
    vertical_pass: bool
    // Source rows the horizontal pass makes, from first_row.
    first_row: s32
    rows: s32
    // The horizontal pass's rows when the vertical pass reads them.
    intermediate: Vec(u8)
}

#scope_file
ROUND :: 2097152
LIMIT :: 1069547520

resample_forced: s32 = -1;

Truncate :: (value: float64) -> s32 { return cast(s32)value }

Sinc :: (x: float64) -> float64 {
    if x == 0.0 { return 1.0 }
    angle := x * 3.14159265358979323846
    return Sin(angle) / angle
}

// std/image's filters, evaluated in the same order.
Filter :: (filter: s32, x: float64) -> float64 {
    if filter == RESAMPLE_LANCZOS {
        if x >= -3.0 && x < 3.0 { return Sinc(x) * Sinc(x / 3.0) }
        return 0.0
    }
    if filter == RESAMPLE_BICUBIC {
        distance := ifx x < 0.0 then -x else x
        if distance < 1.0 { return ((1.5 * distance - 2.5) * distance) * distance + 1.0 }
        if distance < 2.0 { return (((distance - 5.0) * distance + 8.0) * distance - 4.0) * -0.5 }
        return 0.0
    }
    if x > -0.5 && x <= 0.5 { return 1.0 }
    return 0.0
}

Clip32 :: (value: s32) -> u8 {
    if value >= LIMIT { return 255 }
    if value <= 0 { return 0 }
    return cast(u8)(value >> 22)
}

Clip64 :: (value: s64) -> u8 {
    if value >= cast(s64)LIMIT { return 255 }
    if value <= 0 { return 0 }
    return cast(u8)(value >> 22)
}

// The low 16 bits of WEIGHT as a signed half; the rest is the high half.
LowHalf :: (weight: s32) -> s32 {
    bits := weight & 65535
    return ifx bits >= 32768 then bits - 65536 else bits
}
HighHalf :: (weight: s32) -> s32 { return (weight - LowHalf(weight)) / 65536 }
PackHalves :: (first: s32, second: s32) -> u32 {
    return cast(u32)(first & 65535) | (cast(u32)(second & 65535) << 16)
}

// Reference loops. Partial sums of an exact axis stay inside 32 bits.
HorizontalScalar :: (axis: *ResampleAxis, source: *u8, target: *u8) {
    size := cast(s64)axis.size
    bounds := *axis.bounds[0]
    weights := *axis.weights[0]
    for x: cast(s64)0..cast(s64)axis.output - 1 {
        low := cast(s64)bounds[x * 2]
        count := cast(s64)bounds[x * 2 + 1]
        row := x * size
        at := low * 4
        to := x * 4
        if axis.exact {
            r: s32 = ROUND; g: s32 = ROUND; b: s32 = ROUND; a: s32 = ROUND
            for k: cast(s64)0..count - 1 {
                w := weights[row + k]
                r += cast(s32)source[at] * w
                g += cast(s32)source[at + 1] * w
                b += cast(s32)source[at + 2] * w
                a += cast(s32)source[at + 3] * w
                at += 4
            }
            target[to] = Clip32(r); target[to + 1] = Clip32(g)
            target[to + 2] = Clip32(b); target[to + 3] = Clip32(a)
        } else {
            r: s64 = ROUND; g: s64 = ROUND; b: s64 = ROUND; a: s64 = ROUND
            for k: cast(s64)0..count - 1 {
                w := cast(s64)weights[row + k]
                r += cast(s64)source[at] * w
                g += cast(s64)source[at + 1] * w
                b += cast(s64)source[at + 2] * w
                a += cast(s64)source[at + 3] * w
                at += 4
            }
            target[to] = Clip64(r); target[to + 1] = Clip64(g)
            target[to + 2] = Clip64(b); target[to + 3] = Clip64(a)
        }
    }
}

// Bytes [START, END) of one output row from COUNT rows STRIDE bytes apart,
// in blocks so each source row is read in order.
VerticalScalar :: (rows: *u8, stride: s64, weights: *s32, count: s64, exact: bool,
    target: *u8, start: s64, end: s64) {
    if !exact {
        for i: start..end - 1 {
            sum: s64 = ROUND
            at := i
            for k: cast(s64)0..count - 1 {
                sum += cast(s64)rows[at] * cast(s64)weights[k]
                at += stride
            }
            target[i] = Clip64(sum)
        }
        return
    }
    sums: [64]s32
    block := start
    while block < end {
        n := end - block
        if n > 64 { n = 64 }
        for i: cast(s64)0..n - 1 { sums[i] = ROUND }
        for k: cast(s64)0..count - 1 {
            w := weights[k]
            at := k * stride + block
            for i: cast(s64)0..n - 1 { sums[i] += cast(s32)rows[at + i] * w }
        }
        for i: cast(s64)0..n - 1 { target[block + i] = Clip32(sums[i]) }
        block += n
    }
}

// The kernels below each implement their scalar body. A horizontal kernel
// makes a whole row; a vertical kernel makes BYTES bytes, a multiple of its
// width. Packed entries hold 16-bit weight halves for pmaddwd, whose two
// products per lane combine as low + (high << 16), exactly, modulo 2^32.
HasAvx2 :: () -> s32 #asm("x86_64+avx2", "movl $1, %[out]", "=r", "", "", "") { return 0 }
HasSse2 :: () -> s32 #asm("x86_64", "movl $1, %[out]", "=r", "", "", "") { return 0 }
HasNeon :: () -> s32 #asm("aarch64", "mov %w[out], #1", "=r", "", "", "") { return 0 }
HasArmNeon :: () -> s32 #asm("arm+neon", "mov %[out], #1", "=r", "", "", "") { return 0 }
// SIMD128 is a build option, not a CPU check: true only in a module built
// with -msimd128, which a host loads where WebAssembly.validate accepts SIMD.
HasSimd128 :: () -> s32 #asm("wasm32+simd128", "i32.const 1
        local.set %[out]", "=r", "", "", "") { return 0 }

// The x86-64 kernels, in std/simd: #target builds SSE2, SSSE3, SSE4.1 and
// AVX2 copies of each and calls the best one the CPU runs. RESAMPLE_AVX2
// takes the 256-bit kernels, which are slow without AVX2.

// Two taps of one output pixel from SOURCE + PIXEL: each 32-bit lane holds
// one channel of both taps for MulAddPairs.
HorizontalStep :: (source: *u8, pixel: s64, packed: *u32, w: s64, low: *s32x4, high: *s32x4) #inline {
    words := Simd.Reinterpret(s16x8, Simd.WidenLow(Simd.LoadLow(u8x16, source, pixel)))
    taps := Simd.InterleaveLow(words, Simd.Reinterpret(s16x8, Simd.Shuffle(Simd.Reinterpret(s32x4, words), 2, 3, 0, 1)))
    low.* = Simd.Add(low.*, Simd.MulAddPairs(taps, Simd.Reinterpret(s16x8, Simd.Splat(u32x4, packed[w]))))
    high.* = Simd.Add(high.*, Simd.MulAddPairs(taps, Simd.Reinterpret(s16x8, Simd.Splat(u32x4, packed[w + 1]))))
}

// The last tap of an odd count, its partner weight 0. After an earlier tap
// it is the high half of the 8 bytes ending there, which one load reads;
// a lone tap is read byte by byte, as nothing before it need exist.
HorizontalOdd :: (source: *u8, pixel: s64, packed: *u32, w: s64, alone: bool, low: *s32x4, high: *s32x4) #inline {
    taps := Simd.Zero(s16x8)
    if alone {
        word := cast(u32)source[pixel] | (cast(u32)source[pixel + 1] << 8) |
            (cast(u32)source[pixel + 2] << 16) | (cast(u32)source[pixel + 3] << 24)
        words := Simd.Reinterpret(s16x8, Simd.WidenLow(Simd.Reinterpret(u8x16, Simd.WithLane(Simd.Zero(u32x4), 0, word))))
        taps = Simd.InterleaveLow(words, Simd.Zero(s16x8))
    } else {
        words := Simd.Reinterpret(s16x8, Simd.WidenLow(Simd.LoadLow(u8x16, source, pixel - 4)))
        taps = Simd.InterleaveHigh(words, Simd.Zero(s16x8))
    }
    low.* = Simd.Add(low.*, Simd.MulAddPairs(taps, Simd.Reinterpret(s16x8, Simd.Splat(u32x4, packed[w]))))
    high.* = Simd.Add(high.*, Simd.MulAddPairs(taps, Simd.Reinterpret(s16x8, Simd.Splat(u32x4, packed[w + 1]))))
}

HorizontalFinish :: (target: *u8, to: s64, low: s32x4, high: s32x4) #inline {
    sum := Simd.ShiftRight(Simd.Add(low, Simd.ShiftLeft(high, 16)), 22)
    halves := Simd.Narrow(s16x8, sum, sum)
    out := Simd.Lane(Simd.Reinterpret(u32x4, Simd.Narrow(u8x16, halves, halves)), 0)
    target[to] = cast(u8)out
    target[to + 1] = cast(u8)(out >> 8)
    target[to + 2] = cast(u8)(out >> 16)
    target[to + 3] = cast(u8)(out >> 24)
}

// OUTPUT pixels of TARGET from the packed weights, ENTRY words apart:
// four taps a step, then two, then an odd last one.
HorizontalTyped :: (source: *u8, packed: *u32, entry: s64, output: s64, target: *u8) #target {
    at: s64 = 0
    x: s64 = 0
    while x < output {
        count := cast(s64)packed[at + 1]
        pixel := cast(s64)cast(s32)packed[at] * 4
        w := at + 2
        low := Simd.Splat(s32x4, ROUND)
        high := Simd.Zero(s32x4)
        quads := count / 4
        while quads > 0 {
            // The taps in order 0 2 1 3, then their bytes interleaved so each
            // 32-bit lane holds one channel of taps 0 and 1, or 2 and 3.
            spread := Simd.Reinterpret(u8x16, Simd.Shuffle(Simd.Reinterpret(u32x4, Simd.Load(u8x16, source, pixel)), 0, 2, 1, 3))
            bytes := Simd.InterleaveLow(spread, Simd.Reinterpret(u8x16, Simd.Shuffle(Simd.Reinterpret(u32x4, spread), 2, 3, 2, 3)))
            first := Simd.Reinterpret(s16x8, Simd.InterleaveLow(bytes, Simd.Zero(u8x16)))
            second := Simd.Reinterpret(s16x8, Simd.InterleaveHigh(bytes, Simd.Zero(u8x16)))
            weights := Simd.Load(u32x4, packed, w)
            low = Simd.Add(low, Simd.MulAddPairs(first, Simd.Reinterpret(s16x8, Simd.Shuffle(weights, 0, 0, 0, 0))))
            high = Simd.Add(high, Simd.MulAddPairs(first, Simd.Reinterpret(s16x8, Simd.Shuffle(weights, 1, 1, 1, 1))))
            low = Simd.Add(low, Simd.MulAddPairs(second, Simd.Reinterpret(s16x8, Simd.Shuffle(weights, 2, 2, 2, 2))))
            high = Simd.Add(high, Simd.MulAddPairs(second, Simd.Reinterpret(s16x8, Simd.Shuffle(weights, 3, 3, 3, 3))))
            pixel += 16
            w += 4
            quads -= 1
        }
        if count % 4 >= 2 {
            HorizontalStep(source, pixel, packed, w, *low, *high)
            pixel += 8
            w += 2
        }
        if count % 2 == 1 { HorizontalOdd(source, pixel, packed, w, count == 1, *low, *high) }
        HorizontalFinish(target, x * 4, low, high)
        at += entry
        x += 1
    }
}

// HorizontalTyped with 256-bit vectors, eight or four taps a step, for
// AVX2. A step's byte shuffle gives each 32-bit lane one channel of two
// neighbouring taps; each 128-bit block takes the weights of its own pair.
HorizontalTypedWide :: (source: *u8, packed: *u32, entry: s64, output: s64, target: *u8) #target {
    order := Simd.Make(u8x16, 0, 4, 1, 5, 2, 6, 3, 7, 8, 12, 9, 13, 10, 14, 11, 15)
    orders := Simd.Combine(order, order)
    at: s64 = 0
    x: s64 = 0
    while x < output {
        count := cast(s64)packed[at + 1]
        pixel := cast(s64)cast(s32)packed[at] * 4
        w := at + 2
        low := Simd.Splat(s32x4, ROUND)
        high := Simd.Zero(s32x4)
        if count >= 4 {
            // The rounding rides in the first half until the halves meet.
            low8 := Simd.Combine(low, high)
            high8 := Simd.Zero(s32x8)
            octs := count / 8
            while octs > 0 {
                bytes := Simd.ByteShuffle(Simd.Load(u8x32, source, pixel), orders)
                first := Simd.Reinterpret(s16x16, Simd.InterleaveLow(bytes, Simd.Zero(u8x32)))
                second := Simd.Reinterpret(s16x16, Simd.InterleaveHigh(bytes, Simd.Zero(u8x32)))
                weights := Simd.Load(u32x8, packed, w)
                low8 = Simd.Add(low8, Simd.MulAddPairs(first, Simd.Reinterpret(s16x16, Simd.Shuffle(weights, 0, 0, 0, 0))))
                high8 = Simd.Add(high8, Simd.MulAddPairs(first, Simd.Reinterpret(s16x16, Simd.Shuffle(weights, 1, 1, 1, 1))))
                low8 = Simd.Add(low8, Simd.MulAddPairs(second, Simd.Reinterpret(s16x16, Simd.Shuffle(weights, 2, 2, 2, 2))))
                high8 = Simd.Add(high8, Simd.MulAddPairs(second, Simd.Reinterpret(s16x16, Simd.Shuffle(weights, 3, 3, 3, 3))))
                pixel += 32
                w += 8
                octs -= 1
            }
            if count % 8 >= 4 {
                taps := Simd.Reinterpret(s16x16, Simd.Widen(Simd.ByteShuffle(Simd.Load(u8x16, source, pixel), order)))
                weights := Simd.Reinterpret(u32x8, Simd.Widen(Simd.Load(u32x4, packed, w)))
                low8 = Simd.Add(low8, Simd.MulAddPairs(taps, Simd.Reinterpret(s16x16, Simd.Shuffle(weights, 0, 0, 0, 0))))
                high8 = Simd.Add(high8, Simd.MulAddPairs(taps, Simd.Reinterpret(s16x16, Simd.Shuffle(weights, 2, 2, 2, 2))))
                pixel += 16
                w += 4
            }
            low = Simd.Add(Simd.Low(low8), Simd.High(low8))
            high = Simd.Add(Simd.Low(high8), Simd.High(high8))
        }
        if count % 4 >= 2 {
            HorizontalStep(source, pixel, packed, w, *low, *high)
            pixel += 8
            w += 2
        }
        if count % 2 == 1 { HorizontalOdd(source, pixel, packed, w, count == 1, *low, *high) }
        HorizontalFinish(target, x * 4, low, high)
        at += entry
        x += 1
    }
}

// BYTES bytes of one output row, a multiple of 16, two source rows a step;
// WIDE takes 32 bytes at a time first, for AVX2. An odd COUNT's last step
// reads its row twice, the second time with weight 0.
VerticalTyped :: (rows: *u8, stride: s64, pairs: *u32, count: s64, target: *u8, bytes: s64, wide: bool) #target {
    steps := (count + 1) / 2
    last := ifx count % 2 == 1 then cast(s64)0 else stride
    i: s64 = 0
    if wide {
        while i + 32 <= bytes {
            a0 := Simd.Splat(s32x8, ROUND)
            a1 := a0
            a2 := a0
            a3 := a0
            h0 := Simd.Zero(s32x8)
            h1 := h0
            h2 := h0
            h3 := h0
            at := i
            step: s64 = 0
            while step < steps {
                next := ifx step == steps - 1 then last else stride
                x := Simd.Load(u8x32, rows, at)
                y := Simd.Load(u8x32, rows, at + next)
                lo := Simd.InterleaveLow(x, y)
                hi := Simd.InterleaveHigh(x, y)
                wl := Simd.Reinterpret(s16x16, Simd.Splat(u32x8, pairs[step * 2]))
                wh := Simd.Reinterpret(s16x16, Simd.Splat(u32x8, pairs[step * 2 + 1]))
                v := Simd.Reinterpret(s16x16, Simd.WidenLow(lo))
                a0 = Simd.Add(a0, Simd.MulAddPairs(v, wl))
                h0 = Simd.Add(h0, Simd.MulAddPairs(v, wh))
                v = Simd.Reinterpret(s16x16, Simd.WidenHigh(lo))
                a1 = Simd.Add(a1, Simd.MulAddPairs(v, wl))
                h1 = Simd.Add(h1, Simd.MulAddPairs(v, wh))
                v = Simd.Reinterpret(s16x16, Simd.WidenLow(hi))
                a2 = Simd.Add(a2, Simd.MulAddPairs(v, wl))
                h2 = Simd.Add(h2, Simd.MulAddPairs(v, wh))
                v = Simd.Reinterpret(s16x16, Simd.WidenHigh(hi))
                a3 = Simd.Add(a3, Simd.MulAddPairs(v, wl))
                h3 = Simd.Add(h3, Simd.MulAddPairs(v, wh))
                at += stride * 2
                step += 1
            }
            r0 := Simd.ShiftRight(Simd.Add(a0, Simd.ShiftLeft(h0, 16)), 22)
            r1 := Simd.ShiftRight(Simd.Add(a1, Simd.ShiftLeft(h1, 16)), 22)
            r2 := Simd.ShiftRight(Simd.Add(a2, Simd.ShiftLeft(h2, 16)), 22)
            r3 := Simd.ShiftRight(Simd.Add(a3, Simd.ShiftLeft(h3, 16)), 22)
            Simd.Store(target, i, Simd.Narrow(u8x32, Simd.Narrow(s16x16, r0, r1), Simd.Narrow(s16x16, r2, r3)))
            i += 32
        }
    }
    while i + 16 <= bytes {
        a0 := Simd.Splat(s32x4, ROUND)
        a1 := a0
        a2 := a0
        a3 := a0
        h0 := Simd.Zero(s32x4)
        h1 := h0
        h2 := h0
        h3 := h0
        at := i
        step: s64 = 0
        while step < steps {
            next := ifx step == steps - 1 then last else stride
            x := Simd.Load(u8x16, rows, at)
            y := Simd.Load(u8x16, rows, at + next)
            lo := Simd.InterleaveLow(x, y)
            hi := Simd.InterleaveHigh(x, y)
            wl := Simd.Reinterpret(s16x8, Simd.Splat(u32x4, pairs[step * 2]))
            wh := Simd.Reinterpret(s16x8, Simd.Splat(u32x4, pairs[step * 2 + 1]))
            v := Simd.Reinterpret(s16x8, Simd.WidenLow(lo))
            a0 = Simd.Add(a0, Simd.MulAddPairs(v, wl))
            h0 = Simd.Add(h0, Simd.MulAddPairs(v, wh))
            v = Simd.Reinterpret(s16x8, Simd.WidenHigh(lo))
            a1 = Simd.Add(a1, Simd.MulAddPairs(v, wl))
            h1 = Simd.Add(h1, Simd.MulAddPairs(v, wh))
            v = Simd.Reinterpret(s16x8, Simd.WidenLow(hi))
            a2 = Simd.Add(a2, Simd.MulAddPairs(v, wl))
            h2 = Simd.Add(h2, Simd.MulAddPairs(v, wh))
            v = Simd.Reinterpret(s16x8, Simd.WidenHigh(hi))
            a3 = Simd.Add(a3, Simd.MulAddPairs(v, wl))
            h3 = Simd.Add(h3, Simd.MulAddPairs(v, wh))
            at += stride * 2
            step += 1
        }
        r0 := Simd.ShiftRight(Simd.Add(a0, Simd.ShiftLeft(h0, 16)), 22)
        r1 := Simd.ShiftRight(Simd.Add(a1, Simd.ShiftLeft(h1, 16)), 22)
        r2 := Simd.ShiftRight(Simd.Add(a2, Simd.ShiftLeft(h2, 16)), 22)
        r3 := Simd.ShiftRight(Simd.Add(a3, Simd.ShiftLeft(h3, 16)), 22)
        Simd.Store(target, i, Simd.Narrow(u8x16, Simd.Narrow(s16x8, r0, r1), Simd.Narrow(s16x8, r2, r3)))
        i += 16
    }
}

// A32 has too few registers for every argument as an operand, so the ARMv7
// kernels read theirs from one of these.
ArmRow :: struct {
    source: *u8
    bounds: *s32
    weights: *s32
    // Bytes from one output position's weights to the next.
    step: s32
    output: s32
    target: *u8
}
ArmColumns :: struct {
    rows: *u8
    stride: s32
    weights: *s32
    count: s32
    target: *u8
    bytes: s32
}

HorizontalNeon :: (source: *u8, bounds: *s32, weights: *s32, size: s64, output: s64, target: *u8, axis: *ResampleAxis) #asm("aarch64", "mov w9, #0x200000
        dup v31.4s, w9
        mov x10, %[bounds]
        mov x11, %[weights]
        mov x12, %[target]
        mov x13, %[output]
        lsl x14, %[size], #2
        cbz x13, 9f
    1:
        ldpsw x15, x16, [x10], #8
        add x15, %[source], x15, lsl #2
        mov x17, x11
        mov v16.16b, v31.16b
        movi v17.4s, #0
        lsr x9, x16, #1
        cbz x9, 3f
    2:
        ldr d0, [x15], #8
        ldr d1, [x17], #8
        uxtl v0.8h, v0.8b
        uxtl v2.4s, v0.4h
        uxtl2 v3.4s, v0.8h
        mla v16.4s, v2.4s, v1.s[0]
        mla v17.4s, v3.4s, v1.s[1]
        subs x9, x9, #1
        b.ne 2b
    3:
        tbz x16, #0, 4f
        ldr s0, [x15]
        ldr s1, [x17]
        uxtl v0.8h, v0.8b
        uxtl v2.4s, v0.4h
        mla v16.4s, v2.4s, v1.s[0]
    4:
        add v16.4s, v16.4s, v17.4s
        sshr v16.4s, v16.4s, #22
        sqxtn v16.4h, v16.4s
        sqxtun v16.8b, v16.8h
        str s16, [x12], #4
        add x11, x11, x14
        subs x13, x13, #1
        b.ne 1b
    9:",
        "", "r;r;r;r;r;r;g", "x9;x10;x11;x12;x13;x14;x15;x16;x17;v0;v1;v2;v3;v16;v17;v31;cc;memory", "volatile") {
    HorizontalScalar(axis, source, target)
}

HorizontalArm :: (row: *ArmRow, axis: *ResampleAxis) #asm("arm+neon", "ldr r1, [%[row]]
        ldr r2, [%[row], #4]
        ldr r3, [%[row], #8]
        ldr r4, [%[row], #12]
        ldr r5, [%[row], #16]
        ldr r6, [%[row], #20]
        cmp r5, #0
        beq 9f
    1:
        ldr r8, [r2], #4
        ldr r10, [r2], #4
        add r8, r1, r8, lsl #2
        mov r12, r3
        vmov.i32 q8, #0x200000
        vmov.i32 q9, #0
    2:
        cmp r10, #2
        blt 3f
        vld1.8 {d0}, [r8]!
        vld1.32 {d2}, [r12]!
        vmovl.u8 q2, d0
        vmovl.u16 q3, d4
        vmovl.u16 q10, d5
        vmla.i32 q8, q3, d2[0]
        vmla.i32 q9, q10, d2[1]
        sub r10, r10, #2
        b 2b
    3:
        cmp r10, #0
        beq 4f
        vld1.32 {d0[0]}, [r8]
        vld1.32 {d2[0]}, [r12]
        vmovl.u8 q2, d0
        vmovl.u16 q3, d4
        vmla.i32 q8, q3, d2[0]
    4:
        vadd.i32 q8, q8, q9
        vshr.s32 q8, q8, #22
        vqmovn.s32 d22, q8
        vqmovun.s16 d24, q11
        vst1.32 {d24[0]}, [r6]!
        add r3, r3, r4
        subs r5, r5, #1
        bne 1b
    9:",
        "", "r;g", "r1;r2;r3;r4;r5;r6;r8;r10;r12;lr;d0;d2;d4;d5;d6;d7;d16;d17;d18;d19;d20;d21;d22;d23;d24;cc;memory", "volatile") {
    HorizontalScalar(axis, row.source, row.target)
}

VerticalNeon :: (rows: *u8, stride: s64, weights: *s32, count: s64, target: *u8, bytes: s64) #asm("aarch64", "mov w9, #0x200000
        dup v31.4s, w9
        mov x10, #0
        cmp x10, %[bytes]
        b.ge 9f
    1:
        mov v16.16b, v31.16b
        mov v17.16b, v31.16b
        mov v18.16b, v31.16b
        mov v19.16b, v31.16b
        add x11, %[rows], x10
        mov x12, %[weights]
        mov x13, %[count]
    2:
        ldr q0, [x11]
        ld1r {v1.4s}, [x12], #4
        uxtl v2.8h, v0.8b
        uxtl2 v3.8h, v0.16b
        uxtl v4.4s, v2.4h
        uxtl2 v5.4s, v2.8h
        uxtl v6.4s, v3.4h
        uxtl2 v7.4s, v3.8h
        mla v16.4s, v4.4s, v1.4s
        mla v17.4s, v5.4s, v1.4s
        mla v18.4s, v6.4s, v1.4s
        mla v19.4s, v7.4s, v1.4s
        add x11, x11, %[stride]
        subs x13, x13, #1
        b.ne 2b
        sshr v16.4s, v16.4s, #22
        sshr v17.4s, v17.4s, #22
        sshr v18.4s, v18.4s, #22
        sshr v19.4s, v19.4s, #22
        sqxtn v20.4h, v16.4s
        sqxtn2 v20.8h, v17.4s
        sqxtn v21.4h, v18.4s
        sqxtn2 v21.8h, v19.4s
        sqxtun v22.8b, v20.8h
        sqxtun2 v22.16b, v21.8h
        str q22, [%[target], x10]
        add x10, x10, #16
        cmp x10, %[bytes]
        b.lt 1b
    9:",
        "", "r;r;r;r;r;r", "x9;x10;x11;x12;x13;v0;v1;v2;v3;v4;v5;v6;v7;v16;v17;v18;v19;v20;v21;v22;v31;cc;memory", "volatile") {
    VerticalScalar(rows, stride, weights, count, true, target, 0, bytes)
}

VerticalArm :: (columns: *ArmColumns) #asm("arm+neon", "ldr r2, [%[columns], #4]
        mov r8, #0
        ldr r1, [%[columns], #20]
        cmp r8, r1
        bge 9f
    1:
        vmov.i32 q8, #0x200000
        vmov.i32 q9, #0x200000
        vmov.i32 q10, #0x200000
        vmov.i32 q11, #0x200000
        ldr r10, [%[columns]]
        add r10, r10, r8
        ldr r12, [%[columns], #8]
        ldr lr, [%[columns], #12]
    2:
        vld1.8 {d0, d1}, [r10], r2
        vld1.32 {d2[0]}, [r12]!
        vmovl.u8 q2, d0
        vmovl.u16 q12, d4
        vmovl.u16 q13, d5
        vmla.i32 q8, q12, d2[0]
        vmla.i32 q9, q13, d2[0]
        vmovl.u8 q2, d1
        vmovl.u16 q12, d4
        vmovl.u16 q13, d5
        vmla.i32 q10, q12, d2[0]
        vmla.i32 q11, q13, d2[0]
        subs lr, lr, #1
        bne 2b
        vshr.s32 q8, q8, #22
        vshr.s32 q9, q9, #22
        vshr.s32 q10, q10, #22
        vshr.s32 q11, q11, #22
        vqmovn.s32 d24, q8
        vqmovn.s32 d25, q9
        vqmovn.s32 d26, q10
        vqmovn.s32 d27, q11
        vqmovun.s16 d0, q12
        vqmovun.s16 d1, q13
        ldr r1, [%[columns], #16]
        add r1, r1, r8
        vst1.8 {d0, d1}, [r1]
        add r8, r8, #16
        ldr r1, [%[columns], #20]
        cmp r8, r1
        blt 1b
    9:",
        "", "r", "r1;r2;r8;r10;r12;lr;d0;d1;d2;d4;d5;d16;d17;d18;d19;d20;d21;d22;d23;d24;d25;d26;d27;cc;memory", "volatile") {
    VerticalScalar(columns.rows, cast(s64)columns.stride, columns.weights, cast(s64)columns.count, true,
        columns.target, 0, cast(s64)columns.bytes)
}

// WebAssembly SIMD128. A v128 cannot be an operand, so each output keeps one
// i32x4 sum on the operand stack through typed blocks (Clang 19 or later):
// one pixel's four channels horizontally, four bytes of a row vertically.
// The counts and strides are 32-bit, like wasm32 pointers.
HorizontalSimd128 :: (source: *u8, bounds: *s32, weights: *s32, step: s32, output: s32,
    target: *u8, axis: *ResampleAxis) {
    entry: *s32 = bounds
    row: *s32 = weights
    to: *u8 = target
    left: s32 = output
    at: *u8 = source
    weight: *s32 = weights
    taps: s32 = 0
    pixel: s32 = 0
    #asm("wasm32+simd128", "local.get %[bounds]
        local.set %[entry]
        local.get %[weights]
        local.set %[row]
        local.get %[target]
        local.set %[to]
        local.get %[output]
        local.set %[left]
        block
        local.get %[left]
        i32.eqz
        br_if 0
        loop
        local.get %[source]
        local.get %[entry]
        i32.load 0:p2align=2
        i32.const 2
        i32.shl
        i32.add
        local.set %[at]
        local.get %[entry]
        i32.load 4:p2align=2
        local.set %[taps]
        local.get %[row]
        local.set %[weight]
        i32.const 2097152
        i32x4.splat
        block (v128) -> (v128)
        local.get %[taps]
        i32.const 2
        i32.lt_s
        br_if 0
        loop (v128) -> (v128)
        local.get %[at]
        v128.load64_zero 0:p2align=0
        i16x8.extend_low_i8x16_u
        i32x4.extend_low_i16x8_u
        local.get %[weight]
        v128.load32_splat 0:p2align=2
        i32x4.mul
        i32x4.add
        local.get %[at]
        v128.load32_zero 4:p2align=0
        i16x8.extend_low_i8x16_u
        i32x4.extend_low_i16x8_u
        local.get %[weight]
        v128.load32_splat 4:p2align=2
        i32x4.mul
        i32x4.add
        local.get %[at]
        i32.const 8
        i32.add
        local.set %[at]
        local.get %[weight]
        i32.const 8
        i32.add
        local.set %[weight]
        local.get %[taps]
        i32.const 2
        i32.sub
        local.tee %[taps]
        i32.const 2
        i32.ge_s
        br_if 0
        end_loop
        end_block
        block (v128) -> (v128)
        local.get %[taps]
        i32.eqz
        br_if 0
        local.get %[at]
        v128.load32_zero 0:p2align=0
        i16x8.extend_low_i8x16_u
        i32x4.extend_low_i16x8_u
        local.get %[weight]
        v128.load32_splat 0:p2align=2
        i32x4.mul
        i32x4.add
        end_block
        i32.const 22
        i32x4.shr_s
        v128.const 0, 0, 0, 0
        i16x8.narrow_i32x4_s
        v128.const 0, 0, 0, 0
        i8x16.narrow_i16x8_u
        i32x4.extract_lane 0
        local.set %[pixel]
        local.get %[to]
        local.get %[pixel]
        i32.store 0:p2align=0
        local.get %[to]
        i32.const 4
        i32.add
        local.set %[to]
        local.get %[entry]
        i32.const 8
        i32.add
        local.set %[entry]
        local.get %[row]
        local.get %[step]
        i32.add
        local.set %[row]
        local.get %[left]
        i32.const 1
        i32.sub
        local.tee %[left]
        br_if 0
        end_loop
        end_block",
        "=&r:entry;=&r:row;=&r:to;=&r:left;=&r:at;=&r:weight;=&r:taps;=&r:pixel",
        "r:source;r:bounds;r:weights;r:step;r:output;r:target", "memory", "volatile") {
        HorizontalScalar(axis, source, target)
    }
}

VerticalSimd128 :: (rows: *u8, stride: s32, weights: *s32, count: s32, target: *u8, bytes: s32) {
    offset: s32 = 0
    at: *u8 = rows
    weight: *s32 = weights
    taps: s32 = 0
    pixel: s32 = 0
    #asm("wasm32+simd128", "i32.const 0
        local.set %[offset]
        block
        local.get %[bytes]
        i32.eqz
        br_if 0
        loop
        local.get %[rows]
        local.get %[offset]
        i32.add
        local.set %[at]
        local.get %[weights]
        local.set %[weight]
        local.get %[count]
        local.set %[taps]
        i32.const 2097152
        i32x4.splat
        loop (v128) -> (v128)
        local.get %[at]
        v128.load32_zero 0:p2align=0
        i16x8.extend_low_i8x16_u
        i32x4.extend_low_i16x8_u
        local.get %[weight]
        v128.load32_splat 0:p2align=2
        i32x4.mul
        i32x4.add
        local.get %[at]
        local.get %[stride]
        i32.add
        local.set %[at]
        local.get %[weight]
        i32.const 4
        i32.add
        local.set %[weight]
        local.get %[taps]
        i32.const 1
        i32.sub
        local.tee %[taps]
        br_if 0
        end_loop
        i32.const 22
        i32x4.shr_s
        v128.const 0, 0, 0, 0
        i16x8.narrow_i32x4_s
        v128.const 0, 0, 0, 0
        i8x16.narrow_i16x8_u
        i32x4.extract_lane 0
        local.set %[pixel]
        local.get %[target]
        local.get %[offset]
        i32.add
        local.get %[pixel]
        i32.store 0:p2align=0
        local.get %[offset]
        i32.const 4
        i32.add
        local.tee %[offset]
        local.get %[bytes]
        i32.lt_u
        br_if 0
        end_loop
        end_block",
        "=&r:offset;=&r:at;=&r:weight;=&r:taps;=&r:pixel",
        "r:rows;r:stride;r:weights;r:count;r:target;r:bytes", "memory", "volatile") {
        VerticalScalar(rows, cast(s64)stride, weights, cast(s64)count, true, target, 0, cast(s64)bytes)
    }
}

Level :: () -> s32 {
    if resample_forced >= 0 { return resample_forced }
    return ResampleKernels()
}

#scope_export
// The fastest kernels this program and CPU have: RESAMPLE_AVX2,
// RESAMPLE_SSE2, RESAMPLE_NEON (AArch64, or ARMv7 with NEON),
// RESAMPLE_SIMD128 (a WebAssembly module built with -msimd128) or
// RESAMPLE_SCALAR. A build with ZIRAN_NO_ASM, a compiler without GNU
// assembly and .zx use the scalar ones.
ResampleKernels :: () -> s32 {
    if HasAvx2() != 0 { return RESAMPLE_AVX2 }
    if HasSse2() != 0 { return RESAMPLE_SSE2 }
    if HasNeon() != 0 || HasArmNeon() != 0 { return RESAMPLE_NEON }
    if HasSimd128() != 0 { return RESAMPLE_SIMD128 }
    return RESAMPLE_SCALAR
}

// For tests and benchmarks, before any rows run: use LEVEL's kernels from
// now on, or the fastest again for -1. False, changing nothing, when this
// CPU lacks them.
ResampleUseKernels :: (level: s32) -> bool {
    if level < 0 { resample_forced = -1; return true }
    available := level == RESAMPLE_SCALAR ||
        (level == RESAMPLE_SSE2 && HasSse2() != 0) ||
        (level == RESAMPLE_AVX2 && HasAvx2() != 0) ||
        (level == RESAMPLE_NEON && (HasNeon() != 0 || HasArmNeon() != 0)) ||
        (level == RESAMPLE_SIMD128 && HasSimd128() != 0)
    if available { resample_forced = level }
    return available
}

// Pillow's weights for scaling the source span [START, END) of INPUT
// positions to OUTPUT positions, as Image.resize's box does; positions
// outside the source are left out and the rest renormalized. Reusing an
// axis reuses its storage. False leaves the axis empty.
ResampleAxisBoxInto :: (axis: *ResampleAxis, input: s32, start: float64, end: float64,
    output: s32, filter: s32) -> bool {
    axis.input = 0; axis.output = 0
    if input <= 0 || output <= 0 || !(start >= 0.0) || !(end <= cast(float64)input) || !(end > start) {
        return false
    }
    scale := (end - start) / cast(float64)output
    filter_scale := ifx scale < 1.0 then 1.0 else scale
    inverse_scale := 1.0 / filter_scale
    support := (ifx filter == RESAMPLE_LANCZOS then 3.0 else
        (ifx filter == RESAMPLE_BICUBIC then 2.0 else 0.5)) * filter_scale
    if support > 1073741822.0 { return false }
    whole := Truncate(support)
    if cast(float64)whole < support { whole += 1 }
    size := whole * 2 + 1
    pairs := (size + 1) / 2
    entry := 2 + pairs * 2
    count := cast(s64)output * size
    if count > 2305843009213693951 / 4 || cast(s64)output * entry > 2305843009213693951 / 4 { return false }
    if !VecResize(axis.weights, count) || !VecResize(axis.bounds, cast(s64)output * 2) ||
        !VecResize(axis.packed, cast(s64)output * entry) || !VecResize(axis.scratch, cast(s64)size) {
        return false
    }
    exact := true
    for out: 0..output - 1 {
        center := start + (cast(float64)out + 0.5) * scale
        lower := center - support + 0.5
        upper := center + support + 0.5
        low := ifx lower < 0.0 then 0 else Truncate(lower)
        high := ifx upper > cast(float64)input then input else Truncate(upper)
        high -= low
        total := 0.0
        for at: 0..size - 1 {
            weight := 0.0
            if at < high {
                distance := cast(float64)(at + low) - center + 0.5
                weight = Filter(filter, ifx filter == RESAMPLE_BICUBIC then distance * inverse_scale else distance / filter_scale)
            }
            axis.scratch[at] = weight
            total += weight
        }
        row := cast(s64)out * size
        positive: s64 = 0
        negative: s64 = 0
        for at: 0..size - 1 {
            weight := axis.scratch[at]
            if at < high && total != 0.0 { weight = weight / total }
            scaled := weight * 4194304.0
            fixed := ifx scaled < 0.0 then Truncate(scaled - 0.5) else Truncate(scaled + 0.5)
            axis.weights[row + at] = fixed
            if fixed > 0 { positive += fixed } else { negative -= fixed }
        }
        // A span with no taps adds nothing, as in Pillow, through one
        // zero-weight tap the kernels can read.
        if high < 1 {
            low = ifx low < 0 then 0 else (ifx low >= input then input - 1 else low)
            high = 1
        }
        if cast(s64)ROUND + 255 * positive > 2147483647 || cast(s64)ROUND - 255 * negative < -2147483648 {
            exact = false
        }
        axis.bounds[cast(s64)out * 2] = low
        axis.bounds[cast(s64)out * 2 + 1] = high
        at := cast(s64)out * entry
        axis.packed[at] = cast(u32)low
        axis.packed[at + 1] = cast(u32)high
        for pair: 0..pairs - 1 {
            first := ifx pair * 2 < size then axis.weights[row + pair * 2] else 0
            second := ifx pair * 2 + 1 < size then axis.weights[row + pair * 2 + 1] else 0
            axis.packed[at + 2 + pair * 2] = PackHalves(LowHalf(first), LowHalf(second))
            axis.packed[at + 3 + pair * 2] = PackHalves(HighHalf(first), HighHalf(second))
        }
    }
    axis.input = input; axis.output = output
    axis.size = size; axis.entry = entry; axis.exact = exact
    return true
}

// Pillow's weights for scaling all INPUT positions to OUTPUT positions.
ResampleAxisInto :: (axis: *ResampleAxis, input: s32, output: s32, filter: s32) -> bool {
    return ResampleAxisBoxInto(axis, input, 0.0, cast(float64)input, output, filter)
}

// AXIS.output pixels of TARGET from AXIS.input pixels of SOURCE.
ResampleRowHorizontal :: (axis: *ResampleAxis, source: *u8, target: *u8) {
    if axis.output <= 0 || source == null || target == null { return }
    level := Level()
    if axis.exact && level == RESAMPLE_AVX2 {
        HorizontalTypedWide(source, *axis.packed[0], cast(s64)axis.entry, cast(s64)axis.output, target)
    } else if axis.exact && level == RESAMPLE_SSE2 {
        HorizontalTyped(source, *axis.packed[0], cast(s64)axis.entry, cast(s64)axis.output, target)
    } else if axis.exact && level == RESAMPLE_NEON && HasNeon() != 0 {
        HorizontalNeon(source, *axis.bounds[0], *axis.weights[0], cast(s64)axis.size, cast(s64)axis.output, target, axis)
    } else if axis.exact && level == RESAMPLE_NEON {
        row := ArmRow.{source, *axis.bounds[0], *axis.weights[0], axis.size * 4, axis.output, target}
        HorizontalArm(*row, axis)
    } else if axis.exact && level == RESAMPLE_SIMD128 {
        HorizontalSimd128(source, *axis.bounds[0], *axis.weights[0], axis.size * 4, axis.output, target, axis)
    } else {
        HorizontalScalar(axis, source, target)
    }
}

// Output row ROW of a vertical AXIS: WIDTH pixels of TARGET from the
// source rows at SOURCE, STRIDE bytes apart.
ResampleRowVertical :: (axis: *ResampleAxis, row: s32, source: *u8, stride: s64, width: s32, target: *u8) {
    if row < 0 || row >= axis.output || width <= 0 || source == null || target == null { return }
    low := cast(s64)axis.bounds[cast(s64)row * 2]
    count := cast(s64)axis.bounds[cast(s64)row * 2 + 1]
    rows := *source[low * stride]
    weights := *axis.weights[cast(s64)row * axis.size]
    pairs := *axis.packed[cast(s64)row * axis.entry + 2]
    bytes := cast(s64)width * 4
    done: s64 = 0
    if axis.exact {
        level := Level()
        if level == RESAMPLE_AVX2 || level == RESAMPLE_SSE2 {
            done = bytes - bytes % 16
            if done > 0 { VerticalTyped(rows, stride, pairs, count, target, done, level == RESAMPLE_AVX2) }
        }
        if level == RESAMPLE_NEON {
            done = bytes - bytes % 16
            if done > 0 && HasNeon() != 0 {
                VerticalNeon(rows, stride, weights, count, target, done)
            } else if done > 0 {
                columns := ArmColumns.{rows, cast(s32)stride, weights, cast(s32)count, target, cast(s32)done}
                VerticalArm(*columns)
            }
        }
        if level == RESAMPLE_SIMD128 {
            VerticalSimd128(rows, cast(s32)stride, weights, cast(s32)count, target, cast(s32)bytes)
            done = bytes
        }
    }
    if done < bytes { VerticalScalar(rows, stride, weights, count, axis.exact, target, done, bytes) }
}

// Pillow's premultiplication of COUNT RGBA pixels in place, and its inverse.
ResamplePremultiply :: (pixels: *u8, count: s64) {
    at: s64 = 0
    end := count * 4
    while at < end {
        alpha := cast(u32)pixels[at + 3]
        if alpha != 255 {
            for channel: cast(s64)0..2 {
                value := cast(u32)pixels[at + channel] * alpha + 128
                pixels[at + channel] = cast(u8)(((value >> 8) + value) >> 8)
            }
        }
        at += 4
    }
}

ResampleUnpremultiply :: (pixels: *u8, count: s64) {
    at: s64 = 0
    end := count * 4
    while at < end {
        alpha := cast(u32)pixels[at + 3]
        if alpha != 0 && alpha != 255 {
            for channel: cast(s64)0..2 {
                value := 255 * cast(u32)pixels[at + channel] / alpha
                pixels[at + channel] = cast(u8)(ifx value > 255 then 255 else value)
            }
        }
        at += 4
    }
}

// Plans resizing the box (X, Y, BOX_WIDTH, BOX_HEIGHT) of a SOURCE_WIDTH by
// SOURCE_HEIGHT picture to WIDTH by HEIGHT, passes as Pillow chooses them.
// Reusing a plan reuses its storage. False leaves no pass to run.
ResamplePlanInto :: (plan: *ResamplePlan, source_width: s32, source_height: s32,
    x: float64, y: float64, box_width: float64, box_height: float64,
    width: s32, height: s32, filter: s32) -> bool {
    plan.width = 0; plan.height = 0; plan.rows = 0
    plan.horizontal_pass = false; plan.vertical_pass = false
    if source_width <= 0 || source_height <= 0 || width <= 0 || height <= 0 ||
        cast(s64)width * height > 1073741824 || cast(s64)source_width * source_height > 1073741824 ||
        !(x >= 0.0) || !(y >= 0.0) || !(box_width > 0.0) || !(box_height > 0.0) ||
        !(x + box_width <= cast(float64)source_width) || !(y + box_height <= cast(float64)source_height) {
        return false
    }
    right := x + box_width
    bottom := y + box_height
    horizontal := width != source_width || x != 0.0 || right != cast(float64)width
    vertical := height != source_height || y != 0.0 || bottom != cast(float64)height
    if horizontal && !ResampleAxisBoxInto(*plan.horizontal, source_width, x, right, width, filter) { return false }
    if vertical && !ResampleAxisBoxInto(*plan.vertical, source_height, y, bottom, height, filter) { return false }
    plan.first_row = 0
    plan.rows = height
    if vertical {
        last := cast(s64)height - 1
        plan.first_row = plan.vertical.bounds[0]
        plan.rows = plan.vertical.bounds[last * 2] + plan.vertical.bounds[last * 2 + 1] - plan.first_row
        // The vertical pass reads the horizontal pass's rows from 0.
        if horizontal {
            for out: cast(s64)0..cast(s64)height - 1 {
                plan.vertical.bounds[out * 2] -= plan.first_row
                plan.vertical.packed[out * plan.vertical.entry] = cast(u32)plan.vertical.bounds[out * 2]
            }
            if !VecResize(plan.intermediate, cast(s64)width * plan.rows * 4) { return false }
        }
    }
    plan.source_width = source_width; plan.source_height = source_height
    plan.width = width; plan.height = height
    plan.horizontal_pass = horizontal; plan.vertical_pass = vertical
    return true
}

// Rows the first pass makes, then the second: ranges of these numbers can
// run on different threads, all first-pass rows before any second-pass row.
ResamplePlanFirstRows :: (plan: *ResamplePlan) -> s32 {
    if plan.width <= 0 { return 0 }
    if plan.horizontal_pass || !plan.vertical_pass { return plan.rows }
    return 0
}
ResamplePlanSecondRows :: (plan: *ResamplePlan) -> s32 {
    return ifx plan.width > 0 && plan.vertical_pass then plan.height else 0
}

// First-pass rows [FIRST, END) from premultiplied SOURCE (STRIDE bytes per
// row) into the plan, or into TARGET when there is no second pass.
ResamplePlanFirst :: (plan: *ResamplePlan, source: *u8, stride: s64,
    target: *u8, target_stride: s64, first: s32, end: s32) {
    limit := ResamplePlanFirstRows(plan)
    if first < 0 { first = 0 }
    if end > limit { end = limit }
    if first >= end { return }
    into := target
    into_stride := target_stride
    if plan.vertical_pass { into = *plan.intermediate[0]; into_stride = cast(s64)plan.width * 4 }
    for row: first..end - 1 {
        from := *source[(cast(s64)plan.first_row + row) * stride]
        to := *into[cast(s64)row * into_stride]
        if plan.horizontal_pass {
            ResampleRowHorizontal(*plan.horizontal, from, to)
        } else {
            for at: cast(s64)0..cast(s64)plan.width * 4 - 1 { to[at] = from[at] }
        }
    }
}

// Second-pass rows [FIRST, END) of TARGET (TARGET_STRIDE bytes per row).
ResamplePlanSecond :: (plan: *ResamplePlan, source: *u8, stride: s64,
    target: *u8, target_stride: s64, first: s32, end: s32) {
    limit := ResamplePlanSecondRows(plan)
    if first < 0 { first = 0 }
    if end > limit { end = limit }
    if first >= end { return }
    from := source
    from_stride := stride
    if plan.horizontal_pass { from = *plan.intermediate[0]; from_stride = cast(s64)plan.width * 4 }
    for row: first..end - 1 {
        ResampleRowVertical(*plan.vertical, row, from, from_stride, plan.width, *target[cast(s64)row * target_stride])
    }
}

// The whole resize on this thread: premultiplied SOURCE into TARGET.
ResamplePlanRun :: (plan: *ResamplePlan, source: *u8, stride: s64, target: *u8, target_stride: s64) {
    ResamplePlanFirst(plan, source, stride, target, target_stride, 0, ResamplePlanFirstRows(plan))
    ResamplePlanSecond(plan, source, stride, target, target_stride, 0, ResamplePlanSecondRows(plan))
}
