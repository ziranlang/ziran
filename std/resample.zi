        vpxor %%xmm7, %%xmm7, %%xmm7
        movq %[rows], %%rcx
        movq %[pairs], %%rdx
        movq %%r11, %%r8
    2:
        movq %[stride], %%r9
        cmpq $1, %%r8
        cmove %%r10, %%r9
        addq %%rcx, %%r9
        vmovdqu (%%rcx,%%rax), %%ymm8
        vmovdqu (%%r9,%%rax), %%ymm9
        vpunpckhbw %%ymm9, %%ymm8, %%ymm10
        vpunpcklbw %%ymm9, %%ymm8, %%ymm8
        vpbroadcastd (%%rdx), %%ymm12
        vpbroadcastd 4(%%rdx), %%ymm13
        vpunpcklbw %%ymm15, %%ymm8, %%ymm9
        vpmaddwd %%ymm12, %%ymm9, %%ymm11
        vpaddd %%ymm11, %%ymm0, %%ymm0
        vpmaddwd %%ymm13, %%ymm9, %%ymm9
        vpaddd %%ymm9, %%ymm4, %%ymm4
        vpunpckhbw %%ymm15, %%ymm8, %%ymm8
        vpmaddwd %%ymm12, %%ymm8, %%ymm11
        vpaddd %%ymm11, %%ymm1, %%ymm1
        vpmaddwd %%ymm13, %%ymm8, %%ymm8
        vpaddd %%ymm8, %%ymm5, %%ymm5
        vpunpcklbw %%ymm15, %%ymm10, %%ymm9
        vpmaddwd %%ymm12, %%ymm9, %%ymm11
        vpaddd %%ymm11, %%ymm2, %%ymm2
        vpmaddwd %%ymm13, %%ymm9, %%ymm9
        vpaddd %%ymm9, %%ymm6, %%ymm6
        vpunpckhbw %%ymm15, %%ymm10, %%ymm10
        vpmaddwd %%ymm12, %%ymm10, %%ymm11
        vpaddd %%ymm11, %%ymm3, %%ymm3
        vpmaddwd %%ymm13, %%ymm10, %%ymm10
        vpaddd %%ymm10, %%ymm7, %%ymm7
        leaq (%%rcx,%[stride],2), %%rcx
        addq $8, %%rdx
        decq %%r8
        jnz 2b
        vpslld $16, %%ymm4, %%ymm4
        vpaddd %%ymm4, %%ymm0, %%ymm0
        vpsrad $22, %%ymm0, %%ymm0
        vpslld $16, %%ymm5, %%ymm5
        vpaddd %%ymm5, %%ymm1, %%ymm1
        vpsrad $22, %%ymm1, %%ymm1
        vpslld $16, %%ymm6, %%ymm6
        vpaddd %%ymm6, %%ymm2, %%ymm2
        vpsrad $22, %%ymm2, %%ymm2
        vpslld $16, %%ymm7, %%ymm7
        vpaddd %%ymm7, %%ymm3, %%ymm3
        vpsrad $22, %%ymm3, %%ymm3
        vpackssdw %%ymm1, %%ymm0, %%ymm0
        vpackssdw %%ymm3, %%ymm2, %%ymm2
        vpackuswb %%ymm2, %%ymm0, %%ymm0
        movq %[target], %%r9
        vmovdqu %%ymm0, (%%r9,%%rax)
        addq $32, %%rax
        cmpq %[bytes], %%rax
        jl 1b
    9:
        vzeroupper",
        "", "r;r;r;r;r;r;g", "rax;rcx;rdx;r8;r9;r10;r11;xmm0;xmm1;xmm2;xmm3;xmm4;xmm5;xmm6;xmm7;xmm8;xmm9;xmm10;xmm11;xmm12;xmm13;xmm14;xmm15;cc;memory", "volatile") {
    VerticalScalar(rows, stride, weights, count, true, target, 0, bytes)
}

VerticalNeon :: (rows: *u8, stride: s64, weights: *s32, count: s64, target: *u8, bytes: s64) #asm("aarch64", "mov w9, #0x200000
        dup v31.4s, w9
        mov x10, #0
        cmp x10, %[bytes]
        b.ge 9f
    1:
        mov v16.16b, v31.16b
        mov v17.16b, v31.16b
        mov v18.16b, v31.16b
        mov v19.16b, v31.16b
        add x11, %[rows], x10
        mov x12, %[weights]
        mov x13, %[count]
    2:
        ldr q0, [x11]
        ld1r {v1.4s}, [x12], #4
        uxtl v2.8h, v0.8b
        uxtl2 v3.8h, v0.16b
        uxtl v4.4s, v2.4h
        uxtl2 v5.4s, v2.8h
        uxtl v6.4s, v3.4h
        uxtl2 v7.4s, v3.8h
        mla v16.4s, v4.4s, v1.4s
        mla v17.4s, v5.4s, v1.4s
        mla v18.4s, v6.4s, v1.4s
        mla v19.4s, v7.4s, v1.4s
        add x11, x11, %[stride]
        subs x13, x13, #1
        b.ne 2b
        sshr v16.4s, v16.4s, #22
        sshr v17.4s, v17.4s, #22
        sshr v18.4s, v18.4s, #22
        sshr v19.4s, v19.4s, #22
        sqxtn v20.4h, v16.4s
        sqxtn2 v20.8h, v17.4s
        sqxtn v21.4h, v18.4s
        sqxtn2 v21.8h, v19.4s
        sqxtun v22.8b, v20.8h
        sqxtun2 v22.16b, v21.8h
        str q22, [%[target], x10]
        add x10, x10, #16
        cmp x10, %[bytes]
        b.lt 1b
    9:",
        "", "r;r;r;r;r;r", "x9;x10;x11;x12;x13;v0;v1;v2;v3;v4;v5;v6;v7;v16;v17;v18;v19;v20;v21;v22;v31;cc;memory", "volatile") {
    VerticalScalar(rows, stride, weights, count, true, target, 0, bytes)
}

Level :: () -> s32 {
    if resample_forced >= 0 { return resample_forced }
    return ResampleKernels()
}

#scope_export
// The fastest kernels this program and CPU have: RESAMPLE_AVX2,
// RESAMPLE_SSE2, RESAMPLE_NEON or RESAMPLE_SCALAR. A build with
// ZIRAN_NO_ASM, a compiler without GNU assembly and .zx use the scalar ones.
ResampleKernels :: () -> s32 {
    if HasAvx2() != 0 { return RESAMPLE_AVX2 }
    if HasSse2() != 0 { return RESAMPLE_SSE2 }
    if HasNeon() != 0 { return RESAMPLE_NEON }
    return RESAMPLE_SCALAR
}

// For tests and benchmarks, before any rows run: use LEVEL's kernels from
// now on, or the fastest again for -1. False, changing nothing, when this
// CPU lacks them.
ResampleUseKernels :: (level: s32) -> bool {
    if level < 0 { resample_forced = -1; return true }
    available := level == RESAMPLE_SCALAR ||
        (level == RESAMPLE_SSE2 && HasSse2() != 0) ||
        (level == RESAMPLE_AVX2 && HasAvx2() != 0) ||
        (level == RESAMPLE_NEON && HasNeon() != 0)
    if available { resample_forced = level }
    return available
}

// Pillow's weights for scaling the source span [START, END) of INPUT
// positions to OUTPUT positions, as Image.resize's box does; positions
// outside the source are left out and the rest renormalized. Reusing an
// axis reuses its storage. False leaves the axis empty.
ResampleAxisBoxInto :: (axis: *ResampleAxis, input: s32, start: float64, end: float64,
    output: s32, filter: s32) -> bool {
    axis.input = 0; axis.output = 0
    if input <= 0 || output <= 0 || !(start >= 0.0) || !(end <= cast(float64)input) || !(end > start) {
        return false
    }
    scale := (end - start) / cast(float64)output
    filter_scale := ifx scale < 1.0 then 1.0 else scale
    inverse_scale := 1.0 / filter_scale
    support := (ifx filter == RESAMPLE_LANCZOS then 3.0 else
        (ifx filter == RESAMPLE_BICUBIC then 2.0 else 0.5)) * filter_scale
    if support > 1073741822.0 { return false }
    whole := Truncate(support)
    if cast(float64)whole < support { whole += 1 }
    size := whole * 2 + 1
    pairs := (size + 1) / 2
    entry := 2 + pairs * 2
    count := cast(s64)output * size
    if count > 2305843009213693951 / 4 || cast(s64)output * entry > 2305843009213693951 / 4 { return false }
    if !VecResize(axis.weights, count) || !VecResize(axis.bounds, cast(s64)output * 2) ||
        !VecResize(axis.packed, cast(s64)output * entry) || !VecResize(axis.scratch, cast(s64)size) {
        return false
    }
    exact := true
    for out: 0..output - 1 {
        center := start + (cast(float64)out + 0.5) * scale
        lower := center - support + 0.5
        upper := center + support + 0.5
        low := ifx lower < 0.0 then 0 else Truncate(lower)
        high := ifx upper > cast(float64)input then input else Truncate(upper)
        high -= low
        total := 0.0
        for at: 0..size - 1 {
            weight := 0.0
            if at < high {
                distance := cast(float64)(at + low) - center + 0.5
                weight = Filter(filter, ifx filter == RESAMPLE_BICUBIC then distance * inverse_scale else distance / filter_scale)
            }
            axis.scratch[at] = weight
            total += weight
        }
        row := cast(s64)out * size
        positive: s64 = 0
        negative: s64 = 0
        for at: 0..size - 1 {
            weight := axis.scratch[at]
            if at < high && total != 0.0 { weight = weight / total }
            scaled := weight * 4194304.0
            fixed := ifx scaled < 0.0 then Truncate(scaled - 0.5) else Truncate(scaled + 0.5)
            axis.weights[row + at] = fixed
            if fixed > 0 { positive += fixed } else { negative -= fixed }
        }
        // A span with no taps adds nothing, as in Pillow, through one
        // zero-weight tap the kernels can read.
        if high < 1 {
            low = ifx low < 0 then 0 else (ifx low >= input then input - 1 else low)
            high = 1
        }
        if cast(s64)ROUND + 255 * positive > 2147483647 || cast(s64)ROUND - 255 * negative < -2147483648 {
            exact = false
        }
        axis.bounds[cast(s64)out * 2] = low
        axis.bounds[cast(s64)out * 2 + 1] = high
        at := cast(s64)out * entry
        axis.packed[at] = cast(u32)low
        axis.packed[at + 1] = cast(u32)high
        for pair: 0..pairs - 1 {
            first := ifx pair * 2 < size then axis.weights[row + pair * 2] else 0
            second := ifx pair * 2 + 1 < size then axis.weights[row + pair * 2 + 1] else 0
            axis.packed[at + 2 + pair * 2] = PackHalves(LowHalf(first), LowHalf(second))
            axis.packed[at + 3 + pair * 2] = PackHalves(HighHalf(first), HighHalf(second))
        }
    }
    axis.input = input; axis.output = output
    axis.size = size; axis.entry = entry; axis.exact = exact
    return true
}

// Pillow's weights for scaling all INPUT positions to OUTPUT positions.
ResampleAxisInto :: (axis: *ResampleAxis, input: s32, output: s32, filter: s32) -> bool {
    return ResampleAxisBoxInto(axis, input, 0.0, cast(float64)input, output, filter)
}

// AXIS.output pixels of TARGET from AXIS.input pixels of SOURCE.
ResampleRowHorizontal :: (axis: *ResampleAxis, source: *u8, target: *u8) {
    if axis.output <= 0 || source == null || target == null { return }
    level := Level()
    if axis.exact && level == RESAMPLE_AVX2 {
        HorizontalAvx2(source, *axis.packed[0], cast(s64)axis.entry * 4, cast(s64)axis.output, target, axis)
    } else if axis.exact && level == RESAMPLE_SSE2 {
        HorizontalSse2(source, *axis.packed[0], cast(s64)axis.entry * 4, cast(s64)axis.output, target, axis)
    } else if axis.exact && level == RESAMPLE_NEON {
        HorizontalNeon(source, *axis.bounds[0], *axis.weights[0], cast(s64)axis.size, cast(s64)axis.output, target, axis)
    } else {
        HorizontalScalar(axis, source, target)
    }
}

// Output row ROW of a vertical AXIS: WIDTH pixels of TARGET from the
// source rows at SOURCE, STRIDE bytes apart.
ResampleRowVertical :: (axis: *ResampleAxis, row: s32, source: *u8, stride: s64, width: s32, target: *u8) {
    if row < 0 || row >= axis.output || width <= 0 || source == null || target == null { return }
    low := cast(s64)axis.bounds[cast(s64)row * 2]
    count := cast(s64)axis.bounds[cast(s64)row * 2 + 1]
    rows := *source[low * stride]
    weights := *axis.weights[cast(s64)row * axis.size]
    pairs := *axis.packed[cast(s64)row * axis.entry + 2]
    bytes := cast(s64)width * 4
    done: s64 = 0
    if axis.exact {
        level := Level()
        if level == RESAMPLE_AVX2 {
            done = bytes - bytes % 32
            if done > 0 { VerticalAvx2(rows, stride, pairs, count, target, done, weights) }
        }
        if (level == RESAMPLE_AVX2 || level == RESAMPLE_SSE2) && bytes - done >= 16 {
            chunk := (bytes - done) - (bytes - done) % 16
            VerticalSse2(*rows[done], stride, pairs, count, *target[done], chunk, weights)
            done += chunk
        }
        if level == RESAMPLE_NEON {
            done = bytes - bytes % 16
            if done > 0 { VerticalNeon(rows, stride, weights, count, target, done) }
        }
    }
    if done < bytes { VerticalScalar(rows, stride, weights, count, axis.exact, target, done, bytes) }
}

// Pillow's premultiplication of COUNT RGBA pixels in place, and its inverse.
ResamplePremultiply :: (pixels: *u8, count: s64) {
    at: s64 = 0
    end := count * 4
    while at < end {
        alpha := cast(u32)pixels[at + 3]
        if alpha != 255 {
            for channel: cast(s64)0..2 {
                value := cast(u32)pixels[at + channel] * alpha + 128
                pixels[at + channel] = cast(u8)(((value >> 8) + value) >> 8)
            }
        }
        at += 4
    }
}

ResampleUnpremultiply :: (pixels: *u8, count: s64) {
    at: s64 = 0
    end := count * 4
    while at < end {
        alpha := cast(u32)pixels[at + 3]
        if alpha != 0 && alpha != 255 {
            for channel: cast(s64)0..2 {
                value := 255 * cast(u32)pixels[at + channel] / alpha
                pixels[at + channel] = cast(u8)(ifx value > 255 then 255 else value)
            }
        }
        at += 4
    }
}

// Plans resizing the box (X, Y, BOX_WIDTH, BOX_HEIGHT) of a SOURCE_WIDTH by
// SOURCE_HEIGHT picture to WIDTH by HEIGHT, passes as Pillow chooses them.
// Reusing a plan reuses its storage. False leaves no pass to run.
ResamplePlanInto :: (plan: *ResamplePlan, source_width: s32, source_height: s32,
    x: float64, y: float64, box_width: float64, box_height: float64,
    width: s32, height: s32, filter: s32) -> bool {
    plan.width = 0; plan.height = 0; plan.rows = 0
    plan.horizontal_pass = false; plan.vertical_pass = false
    if source_width <= 0 || source_height <= 0 || width <= 0 || height <= 0 ||
        cast(s64)width * height > 1073741824 || cast(s64)source_width * source_height > 1073741824 ||
        !(x >= 0.0) || !(y >= 0.0) || !(box_width > 0.0) || !(box_height > 0.0) ||
        !(x + box_width <= cast(float64)source_width) || !(y + box_height <= cast(float64)source_height) {
        return false
    }
    right := x + box_width
    bottom := y + box_height
    horizontal := width != source_width || x != 0.0 || right != cast(float64)width
    vertical := height != source_height || y != 0.0 || bottom != cast(float64)height
    if horizontal && !ResampleAxisBoxInto(*plan.horizontal, source_width, x, right, width, filter) { return false }
    if vertical && !ResampleAxisBoxInto(*plan.vertical, source_height, y, bottom, height, filter) { return false }
    plan.first_row = 0
    plan.rows = height
    if vertical {
        last := cast(s64)height - 1
        plan.first_row = plan.vertical.bounds[0]
        plan.rows = plan.vertical.bounds[last * 2] + plan.vertical.bounds[last * 2 + 1] - plan.first_row
        // The vertical pass reads the horizontal pass's rows from 0.
        if horizontal {
            for out: cast(s64)0..cast(s64)height - 1 {
                plan.vertical.bounds[out * 2] -= plan.first_row
                plan.vertical.packed[out * plan.vertical.entry] = cast(u32)plan.vertical.bounds[out * 2]
            }
            if !VecResize(plan.intermediate, cast(s64)width * plan.rows * 4) { return false }
        }
    }
    plan.source_width = source_width; plan.source_height = source_height
    plan.width = width; plan.height = height
    plan.horizontal_pass = horizontal; plan.vertical_pass = vertical
    return true
}

// Rows the first pass makes, then the second: ranges of these numbers can
// run on different threads, all first-pass rows before any second-pass row.
ResamplePlanFirstRows :: (plan: *ResamplePlan) -> s32 {
    if plan.width <= 0 { return 0 }
    if plan.horizontal_pass || !plan.vertical_pass { return plan.rows }
    return 0
}
ResamplePlanSecondRows :: (plan: *ResamplePlan) -> s32 {
    return ifx plan.width > 0 && plan.vertical_pass then plan.height else 0
}

// First-pass rows [FIRST, END) from premultiplied SOURCE (STRIDE bytes per
// row) into the plan, or into TARGET when there is no second pass.
ResamplePlanFirst :: (plan: *ResamplePlan, source: *u8, stride: s64,
    target: *u8, target_stride: s64, first: s32, end: s32) {
    limit := ResamplePlanFirstRows(plan)
    if first < 0 { first = 0 }
    if end > limit { end = limit }
    if first >= end { return }
    into := target
    into_stride := target_stride
    if plan.vertical_pass { into = *plan.intermediate[0]; into_stride = cast(s64)plan.width * 4 }
    for row: first..end - 1 {
        from := *source[(cast(s64)plan.first_row + row) * stride]
        to := *into[cast(s64)row * into_stride]
        if plan.horizontal_pass {
            ResampleRowHorizontal(*plan.horizontal, from, to)
        } else {
            for at: cast(s64)0..cast(s64)plan.width * 4 - 1 { to[at] = from[at] }
        }
    }
}

// Second-pass rows [FIRST, END) of TARGET (TARGET_STRIDE bytes per row).
ResamplePlanSecond :: (plan: *ResamplePlan, source: *u8, stride: s64,
    target: *u8, target_stride: s64, first: s32, end: s32) {
    limit := ResamplePlanSecondRows(plan)
    if first < 0 { first = 0 }
    if end > limit { end = limit }
    if first >= end { return }
    from := source
    from_stride := stride
    if plan.horizontal_pass { from = *plan.intermediate[0]; from_stride = cast(s64)plan.width * 4 }
    for row: first..end - 1 {
        ResampleRowVertical(*plan.vertical, row, from, from_stride, plan.width, *target[cast(s64)row * target_stride])
    }
}

// The whole resize on this thread: premultiplied SOURCE into TARGET.
ResamplePlanRun :: (plan: *ResamplePlan, source: *u8, stride: s64, target: *u8, target_stride: s64) {
    ResamplePlanFirst(plan, source, stride, target, target_stride, 0, ResamplePlanFirstRows(plan))
    ResamplePlanSecond(plan, source, stride, target, target_stride, 0, ResamplePlanSecondRows(plan))
}
