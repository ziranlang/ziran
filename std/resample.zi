// Pillow's separable resampling of 8-bit RGBA as allocation-free row
// kernels, with SSE2, AVX2 and NEON versions that make the same bytes.
//
//     axis: ResampleAxis
//     ResampleAxisInto(*axis, 640, 853, RESAMPLE_LANCZOS)  // weights once
//     ResampleRowHorizontal(*axis, source_row, target_row) // then every row
//
// ResamplePlan resizes a whole premultiplied picture in two passes with
// scratch it owns, so resizing again to the same size never allocates; its
// passes split into row ranges for worker threads.
//
// Weights are Pillow's 22-bit fixed point, each pass rounds to bytes and
// the arithmetic is on the stored (premultiplied) bytes, not linear light,
// as in Pillow. The scalar loops are the reference; the fastest kernels
// this CPU has are chosen once. An axis whose sums could leave 32 bits,
// which Pillow's filters never produce, uses the scalar loops. Pointer
// kernels need a native target; std/image keeps the portable resizes.
using Vectors :: #import "vec"
#import "math"

RESAMPLE_BOX :: 0
RESAMPLE_LANCZOS :: 1
RESAMPLE_BICUBIC :: 2

RESAMPLE_SCALAR :: 0
RESAMPLE_SSE2 :: 1
RESAMPLE_AVX2 :: 2
RESAMPLE_NEON :: 3

// Weights from INPUT source positions to OUTPUT positions along one axis.
ResampleAxis :: struct {
    input: s32
    output: s32
    // Weights kept per output position, and u32 words per packed entry.
    size: s32
    entry: s32
    // Every partial sum fits in 32 bits, so the vector kernels are exact.
    exact: bool
    // First source position and tap count of each output position.
    bounds: Vec(s32)
    weights: Vec(s32)
    // Each output: first position, count, then per pair of taps the 16-bit
    // low halves of both weights and their high halves.
    packed: Vec(u32)
    scratch: Vec(float64)
}

// Both passes of one resize and the rows between them.
ResamplePlan :: struct {
    horizontal: ResampleAxis
    vertical: ResampleAxis
    source_width: s32
    source_height: s32
    width: s32
    height: s32
    horizontal_pass: bool
    vertical_pass: bool
    // Source rows the horizontal pass makes, from first_row.
    first_row: s32
    rows: s32
    // The horizontal pass's rows when the vertical pass reads them.
    intermediate: Vec(u8)
}

#scope_file
ROUND :: 2097152
LIMIT :: 1069547520

resample_forced: s32 = -1;

Truncate :: (value: float64) -> s32 { return cast(s32)value }

Sinc :: (x: float64) -> float64 {
    if x == 0.0 { return 1.0 }
    angle := x * 3.14159265358979323846
    return Sin(angle) / angle
}

// std/image's filters, evaluated in the same order.
Filter :: (filter: s32, x: float64) -> float64 {
    if filter == RESAMPLE_LANCZOS {
        if x >= -3.0 && x < 3.0 { return Sinc(x) * Sinc(x / 3.0) }
        return 0.0
    }
    if filter == RESAMPLE_BICUBIC {
        distance := ifx x < 0.0 then -x else x
        if distance < 1.0 { return ((1.5 * distance - 2.5) * distance) * distance + 1.0 }
        if distance < 2.0 { return (((distance - 5.0) * distance + 8.0) * distance - 4.0) * -0.5 }
        return 0.0
    }
    if x > -0.5 && x <= 0.5 { return 1.0 }
    return 0.0
}

Clip32 :: (value: s32) -> u8 {
    if value >= LIMIT { return 255 }
    if value <= 0 { return 0 }
    return cast(u8)(value >> 22)
}

Clip64 :: (value: s64) -> u8 {
    if value >= cast(s64)LIMIT { return 255 }
    if value <= 0 { return 0 }
    return cast(u8)(value >> 22)
}

// The low 16 bits of WEIGHT as a signed half; the rest is the high half.
LowHalf :: (weight: s32) -> s32 {
    bits := weight & 65535
    return ifx bits >= 32768 then bits - 65536 else bits
}
HighHalf :: (weight: s32) -> s32 { return (weight - LowHalf(weight)) / 65536 }
PackHalves :: (first: s32, second: s32) -> u32 {
    return cast(u32)(first & 65535) | (cast(u32)(second & 65535) << 16)
}

// Reference loops. Partial sums of an exact axis stay inside 32 bits.
HorizontalScalar :: (axis: *ResampleAxis, source: *u8, target: *u8) {
    size := cast(s64)axis.size
    bounds := *axis.bounds[0]
    weights := *axis.weights[0]
    for x: cast(s64)0..cast(s64)axis.output - 1 {
        low := cast(s64)bounds[x * 2]
        count := cast(s64)bounds[x * 2 + 1]
        row := x * size
        at := low * 4
        to := x * 4
        if axis.exact {
            r: s32 = ROUND; g: s32 = ROUND; b: s32 = ROUND; a: s32 = ROUND
            for k: cast(s64)0..count - 1 {
                w := weights[row + k]
                r += cast(s32)source[at] * w
                g += cast(s32)source[at + 1] * w
                b += cast(s32)source[at + 2] * w
                a += cast(s32)source[at + 3] * w
                at += 4
            }
            target[to] = Clip32(r); target[to + 1] = Clip32(g)
            target[to + 2] = Clip32(b); target[to + 3] = Clip32(a)
        } else {
            r: s64 = ROUND; g: s64 = ROUND; b: s64 = ROUND; a: s64 = ROUND
            for k: cast(s64)0..count - 1 {
                w := cast(s64)weights[row + k]
                r += cast(s64)source[at] * w
                g += cast(s64)source[at + 1] * w
                b += cast(s64)source[at + 2] * w
                a += cast(s64)source[at + 3] * w
                at += 4
            }
            target[to] = Clip64(r); target[to + 1] = Clip64(g)
            target[to + 2] = Clip64(b); target[to + 3] = Clip64(a)
        }
    }
}

// Bytes [START, END) of one output row from COUNT rows STRIDE bytes apart,
// in blocks so each source row is read in order.
VerticalScalar :: (rows: *u8, stride: s64, weights: *s32, count: s64, exact: bool,
    target: *u8, start: s64, end: s64) {
    if !exact {
        for i: start..end - 1 {
            sum: s64 = ROUND
            at := i
            for k: cast(s64)0..count - 1 {
                sum += cast(s64)rows[at] * cast(s64)weights[k]
                at += stride
            }
            target[i] = Clip64(sum)
        }
        return
    }
    sums: [64]s32
    block := start
    while block < end {
        n := end - block
        if n > 64 { n = 64 }
        for i: cast(s64)0..n - 1 { sums[i] = ROUND }
        for k: cast(s64)0..count - 1 {
            w := weights[k]
            at := k * stride + block
            for i: cast(s64)0..n - 1 { sums[i] += cast(s32)rows[at + i] * w }
        }
        for i: cast(s64)0..n - 1 { target[block + i] = Clip32(sums[i]) }
        block += n
    }
}

// The kernels below each implement their scalar body. A horizontal kernel
// makes a whole row; a vertical kernel makes BYTES bytes, a multiple of its
// width. Packed entries hold 16-bit weight halves for pmaddwd, whose two
// products per lane combine as low + (high << 16), exactly, modulo 2^32.
HasAvx2 :: () -> s32 #asm("x86_64+avx2", "movl $1, %[out]", "=r", "", "", "") { return 0 }
HasSse2 :: () -> s32 #asm("x86_64", "movl $1, %[out]", "=r", "", "", "") { return 0 }
HasNeon :: () -> s32 #asm("aarch64", "mov %w[out], #1", "=r", "", "", "") { return 0 }

HorizontalSse2 :: (source: *u8, packed: *u32, entry: s64, output: s64, target: *u8, axis: *ResampleAxis) #asm("x86_64", "movq %[packed], %%r10
        movq %[target], %%r11
        movq %[output], %%rax
        pxor %%xmm7, %%xmm7
        movl $2097152, %%ecx
        movd %%ecx, %%xmm6
        pshufd $0, %%xmm6, %%xmm6
        testq %%rax, %%rax
        jle 9f
    1:
        movslq (%%r10), %%rcx
        leaq (%[source],%%rcx,4), %%rcx
        movl 4(%%r10), %%r8d
        leaq 8(%%r10), %%rdx
        movdqa %%xmm6, %%xmm0
        pxor %%xmm1, %%xmm1
        movl %%r8d, %%r9d
        shrl $1, %%r9d
        jz 3f
    2:
        movq (%%rcx), %%xmm2
        punpcklbw %%xmm7, %%xmm2
        pshufd $0x4e, %%xmm2, %%xmm3
        punpcklwd %%xmm3, %%xmm2
        movd (%%rdx), %%xmm4
        pshufd $0, %%xmm4, %%xmm4
        movd 4(%%rdx), %%xmm5
        pshufd $0, %%xmm5, %%xmm5
        pmaddwd %%xmm2, %%xmm4
        paddd %%xmm4, %%xmm0
        pmaddwd %%xmm2, %%xmm5
        paddd %%xmm5, %%xmm1
        addq $8, %%rcx
        addq $8, %%rdx
        decl %%r9d
        jnz 2b
    3:
        testl $1, %%r8d
        jz 4f
        movd (%%rcx), %%xmm2
        punpcklbw %%xmm7, %%xmm2
        punpcklwd %%xmm7, %%xmm2
        movd (%%rdx), %%xmm4
        pshufd $0, %%xmm4, %%xmm4
        movd 4(%%rdx), %%xmm5
        pshufd $0, %%xmm5, %%xmm5
        pmaddwd %%xmm2, %%xmm4
        paddd %%xmm4, %%xmm0
        pmaddwd %%xmm2, %%xmm5
        paddd %%xmm5, %%xmm1
    4:
        pslld $16, %%xmm1
        paddd %%xmm1, %%xmm0
        psrad $22, %%xmm0
        packssdw %%xmm0, %%xmm0
        packuswb %%xmm0, %%xmm0
        movd %%xmm0, (%%r11)
        addq $4, %%r11
        addq %[entry], %%r10
        decq %%rax
        jnz 1b
    9:",
        "", "r;r;r;r;r;g", "rax;rcx;rdx;r8;r9;r10;r11;xmm0;xmm1;xmm2;xmm3;xmm4;xmm5;xmm6;xmm7;cc;memory", "volatile") {
    HorizontalScalar(axis, source, target)
}

HorizontalAvx2 :: (source: *u8, packed: *u32, entry: s64, output: s64, target: *u8, axis: *ResampleAxis) #asm("x86_64+avx2", "movq %[packed], %%r10
        movq %[target], %%r11
        movq %[output], %%rax
        vpxor %%xmm7, %%xmm7, %%xmm7
        movl $2097152, %%ecx
        vmovd %%ecx, %%xmm6
        vpshufd $0, %%xmm6, %%xmm6
        movl $2, %%ecx
        vmovd %%ecx, %%xmm8
        vpshufd $0, %%xmm8, %%xmm8
        vinserti128 $1, %%xmm8, %%ymm7, %%ymm8
        movl $1, %%ecx
        vmovd %%ecx, %%xmm9
        vpbroadcastd %%xmm9, %%ymm9
        vpaddd %%ymm8, %%ymm9, %%ymm9
        testq %%rax, %%rax
        jle 9f
    1:
        movslq (%%r10), %%rcx
        leaq (%[source],%%rcx,4), %%rcx
        movl 4(%%r10), %%r8d
        leaq 8(%%r10), %%rdx
        vmovdqa %%ymm6, %%ymm0
        vpxor %%xmm1, %%xmm1, %%xmm1
        movl %%r8d, %%r9d
        shrl $2, %%r9d
        jz 3f
    2:
        vpmovzxbw (%%rcx), %%ymm2
        vpshufd $0x4e, %%ymm2, %%ymm3
        vpunpcklwd %%ymm3, %%ymm2, %%ymm2
        vmovdqu (%%rdx), %%xmm4
        vpermd %%ymm4, %%ymm8, %%ymm5
        vpermd %%ymm4, %%ymm9, %%ymm4
        vpmaddwd %%ymm2, %%ymm5, %%ymm5
        vpaddd %%ymm5, %%ymm0, %%ymm0
        vpmaddwd %%ymm2, %%ymm4, %%ymm4
        vpaddd %%ymm4, %%ymm1, %%ymm1
        addq $16, %%rcx
        addq $16, %%rdx
        decl %%r9d
        jnz 2b
    3:
        testl $2, %%r8d
        jz 4f
        vmovq (%%rcx), %%xmm2
        vpunpcklbw %%xmm7, %%xmm2, %%xmm2
        vpshufd $0x4e, %%xmm2, %%xmm3
        vpunpcklwd %%xmm3, %%xmm2, %%xmm2
        vpbroadcastd (%%rdx), %%xmm4
        vpbroadcastd 4(%%rdx), %%xmm5
        vpmaddwd %%xmm2, %%xmm4, %%xmm4
        vpmaddwd %%xmm2, %%xmm5, %%xmm5
        vpaddd %%ymm4, %%ymm0, %%ymm0
        vpaddd %%ymm5, %%ymm1, %%ymm1
        addq $8, %%rcx
        addq $8, %%rdx
    4:
        testl $1, %%r8d
        jz 5f
        vmovd (%%rcx), %%xmm2
        vpunpcklbw %%xmm7, %%xmm2, %%xmm2
        vpunpcklwd %%xmm7, %%xmm2, %%xmm2
        vpbroadcastd (%%rdx), %%xmm4
        vpbroadcastd 4(%%rdx), %%xmm5
        vpmaddwd %%xmm2, %%xmm4, %%xmm4
        vpmaddwd %%xmm2, %%xmm5, %%xmm5
        vpaddd %%ymm4, %%ymm0, %%ymm0
        vpaddd %%ymm5, %%ymm1, %%ymm1
    5:
        vextracti128 $1, %%ymm0, %%xmm2
        vpaddd %%xmm2, %%xmm0, %%xmm0
        vextracti128 $1, %%ymm1, %%xmm3
        vpaddd %%xmm3, %%xmm1, %%xmm1
        vpslld $16, %%xmm1, %%xmm1
        vpaddd %%xmm1, %%xmm0, %%xmm0
        vpsrad $22, %%xmm0, %%xmm0
        vpackssdw %%xmm0, %%xmm0, %%xmm0
        vpackuswb %%xmm0, %%xmm0, %%xmm0
        vmovd %%xmm0, (%%r11)
        addq $4, %%r11
        addq %[entry], %%r10
        decq %%rax
        jnz 1b
    9:
        vzeroupper",
        "", "r;r;r;r;r;g", "rax;rcx;rdx;r8;r9;r10;r11;xmm0;xmm1;xmm2;xmm3;xmm4;xmm5;xmm6;xmm7;xmm8;xmm9;cc;memory", "volatile") {
    HorizontalScalar(axis, source, target)
}

HorizontalNeon :: (source: *u8, bounds: *s32, weights: *s32, size: s64, output: s64, target: *u8, axis: *ResampleAxis) #asm("aarch64", "mov w9, #0x200000
        dup v31.4s, w9
        mov x10, %[bounds]
        mov x11, %[weights]
        mov x12, %[target]
        mov x13, %[output]
        lsl x14, %[size], #2
        cbz x13, 9f
    1:
        ldpsw x15, x16, [x10], #8
        add x15, %[source], x15, lsl #2
        mov x17, x11
        mov v16.16b, v31.16b
        movi v17.4s, #0
        lsr x9, x16, #1
        cbz x9, 3f
    2:
        ldr d0, [x15], #8
        ldr d1, [x17], #8
        uxtl v0.8h, v0.8b
        uxtl v2.4s, v0.4h
        uxtl2 v3.4s, v0.8h
        mla v16.4s, v2.4s, v1.s[0]
        mla v17.4s, v3.4s, v1.s[1]
        subs x9, x9, #1
        b.ne 2b
    3:
        tbz x16, #0, 4f
        ldr s0, [x15]
        ldr s1, [x17]
        uxtl v0.8h, v0.8b
        uxtl v2.4s, v0.4h
        mla v16.4s, v2.4s, v1.s[0]
    4:
        add v16.4s, v16.4s, v17.4s
        sshr v16.4s, v16.4s, #22
        sqxtn v16.4h, v16.4s
        sqxtun v16.8b, v16.8h
        str s16, [x12], #4
        add x11, x11, x14
        subs x13, x13, #1
        b.ne 1b
    9:",
        "", "r;r;r;r;r;r;g", "x9;x10;x11;x12;x13;x14;x15;x16;x17;v0;v1;v2;v3;v16;v17;v31;cc;memory", "volatile") {
    HorizontalScalar(axis, source, target)
}

VerticalSse2 :: (rows: *u8, stride: s64, pairs: *u32, count: s64, target: *u8, bytes: s64, weights: *s32) #asm("x86_64", "movl $2097152, %%ecx
        movd %%ecx, %%xmm14
        pshufd $0, %%xmm14, %%xmm14
        pxor %%xmm15, %%xmm15
        movq %[count], %%r11
        addq $1, %%r11
        shrq $1, %%r11
        movq %[stride], %%r10
        testq $1, %[count]
        jz 0f
        xorl %%r10d, %%r10d
    0:
        xorl %%eax, %%eax
        cmpq %[bytes], %%rax
        jge 9f
    1:
        movdqa %%xmm14, %%xmm0
        movdqa %%xmm14, %%xmm1
        movdqa %%xmm14, %%xmm2
        movdqa %%xmm14, %%xmm3
        pxor %%xmm4, %%xmm4
        pxor %%xmm5, %%xmm5
        pxor %%xmm6, %%xmm6
        pxor %%xmm7, %%xmm7
        movq %[rows], %%rcx
        movq %[pairs], %%rdx
        movq %%r11, %%r8
    2:
        movq %[stride], %%r9
        cmpq $1, %%r8
        cmove %%r10, %%r9
        addq %%rcx, %%r9
        movdqu (%%rcx,%%rax), %%xmm8
        movdqu (%%r9,%%rax), %%xmm9
        movdqa %%xmm8, %%xmm10
        punpcklbw %%xmm9, %%xmm8
        punpckhbw %%xmm9, %%xmm10
        movd (%%rdx), %%xmm12
        pshufd $0, %%xmm12, %%xmm12
        movd 4(%%rdx), %%xmm13
        pshufd $0, %%xmm13, %%xmm13
        movdqa %%xmm8, %%xmm9
        punpcklbw %%xmm15, %%xmm9
        movdqa %%xmm9, %%xmm11
        pmaddwd %%xmm12, %%xmm9
        paddd %%xmm9, %%xmm0
        pmaddwd %%xmm13, %%xmm11
        paddd %%xmm11, %%xmm4
        punpckhbw %%xmm15, %%xmm8
        movdqa %%xmm8, %%xmm11
        pmaddwd %%xmm12, %%xmm8
        paddd %%xmm8, %%xmm1
        pmaddwd %%xmm13, %%xmm11
        paddd %%xmm11, %%xmm5
        movdqa %%xmm10, %%xmm9
        punpcklbw %%xmm15, %%xmm9
        movdqa %%xmm9, %%xmm11
        pmaddwd %%xmm12, %%xmm9
        paddd %%xmm9, %%xmm2
        pmaddwd %%xmm13, %%xmm11
        paddd %%xmm11, %%xmm6
        punpckhbw %%xmm15, %%xmm10
        movdqa %%xmm10, %%xmm11
        pmaddwd %%xmm12, %%xmm10
        paddd %%xmm10, %%xmm3
        pmaddwd %%xmm13, %%xmm11
        paddd %%xmm11, %%xmm7
        leaq (%%rcx,%[stride],2), %%rcx
        addq $8, %%rdx
        decq %%r8
        jnz 2b
        pslld $16, %%xmm4
        paddd %%xmm4, %%xmm0
        psrad $22, %%xmm0
        pslld $16, %%xmm5
        paddd %%xmm5, %%xmm1
        psrad $22, %%xmm1
        pslld $16, %%xmm6
        paddd %%xmm6, %%xmm2
        psrad $22, %%xmm2
        pslld $16, %%xmm7
        paddd %%xmm7, %%xmm3
        psrad $22, %%xmm3
        packssdw %%xmm1, %%xmm0
        packssdw %%xmm3, %%xmm2
        packuswb %%xmm2, %%xmm0
        movq %[target], %%r9
        movdqu %%xmm0, (%%r9,%%rax)
        addq $16, %%rax
        cmpq %[bytes], %%rax
        jl 1b
    9:",
        "", "r;r;r;r;r;r;g", "rax;rcx;rdx;r8;r9;r10;r11;xmm0;xmm1;xmm2;xmm3;xmm4;xmm5;xmm6;xmm7;xmm8;xmm9;xmm10;xmm11;xmm12;xmm13;xmm14;xmm15;cc;memory", "volatile") {
    VerticalScalar(rows, stride, weights, count, true, target, 0, bytes)
}

VerticalAvx2 :: (rows: *u8, stride: s64, pairs: *u32, count: s64, target: *u8, bytes: s64, weights: *s32) #asm("x86_64+avx2", "movl $2097152, %%ecx
        vmovd %%ecx, %%xmm14
        vpbroadcastd %%xmm14, %%ymm14
        vpxor %%xmm15, %%xmm15, %%xmm15
        movq %[count], %%r11
        addq $1, %%r11
        shrq $1, %%r11
        movq %[stride], %%r10
        testq $1, %[count]
        jz 0f
        xorl %%r10d, %%r10d
    0:
        xorl %%eax, %%eax
        cmpq %[bytes], %%rax
        jge 9f
    1:
        vmovdqa %%ymm14, %%ymm0
        vmovdqa %%ymm14, %%ymm1
        vmovdqa %%ymm14, %%ymm2
        vmovdqa %%ymm14, %%ymm3
