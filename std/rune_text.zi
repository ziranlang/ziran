// UTF-8 rune operations matching Limbo string semantics. Invalid UTF-8 bytes
// decode to U+FFFD with width 1 so callers always make forward progress.
RUNE_ERROR :: 65533
MAX_RUNE :: 1114111

#scope_file
IsContinuation :: (byte: u8) -> bool {
    return byte >= cast(u8)128 && byte <= cast(u8)191
}

#scope_export
DecodeRune :: (s: string, byte_offset: s64) -> (rune: s32, width: s64) {
    if byte_offset < 0 || byte_offset >= s.count { return RUNE_ERROR, 0 }
    first := s[byte_offset]
    if first < cast(u8)128 { return cast(s32)first, 1 }

    needed: s64 = 0
    codepoint: s32 = 0
    minimum: s32 = 0
    if first >= cast(u8)194 && first <= cast(u8)223 {
        needed = 1
        codepoint = cast(s32)(first & cast(u8)31)
        minimum = 128
    } else if first >= cast(u8)224 && first <= cast(u8)239 {
        needed = 2
        codepoint = cast(s32)(first & cast(u8)15)
        minimum = 2048
    } else if first >= cast(u8)240 && first <= cast(u8)244 {
        needed = 3
        codepoint = cast(s32)(first & cast(u8)7)
        minimum = 65536
    }

    if needed == 0 || byte_offset + needed >= s.count { return RUNE_ERROR, 1 }
    index: s64 = 1
    while index <= needed {
        part := s[byte_offset + index]
        if !IsContinuation(part) { return RUNE_ERROR, 1 }
        codepoint = (codepoint << 6) | cast(s32)(part & cast(u8)63)
        index += 1
    }
    if codepoint < minimum || codepoint > MAX_RUNE ||
       (codepoint >= 55296 && codepoint <= 57343) {
        return RUNE_ERROR, 1
    }
    return codepoint, needed + 1
}

EncodeRune :: (rune: s32, out: []u8) -> s64 {
    value := rune
    if value < 0 || value > MAX_RUNE || (value >= 55296 && value <= 57343) {
        value = RUNE_ERROR
    }
    if value < 128 {
        if out.count < 1 { return 0 }
        out[0] = cast(u8)value
        return 1
    }
    if value < 2048 {
        if out.count < 2 { return 0 }
        out[0] = cast(u8)(192 | (value >> 6))
        out[1] = cast(u8)(128 | (value & 63))
        return 2
    }
    if value < 65536 {
        if out.count < 3 { return 0 }
        out[0] = cast(u8)(224 | (value >> 12))
        out[1] = cast(u8)(128 | ((value >> 6) & 63))
        out[2] = cast(u8)(128 | (value & 63))
        return 3
    }
    if out.count < 4 { return 0 }
    out[0] = cast(u8)(240 | (value >> 18))
    out[1] = cast(u8)(128 | ((value >> 12) & 63))
    out[2] = cast(u8)(128 | ((value >> 6) & 63))
    out[3] = cast(u8)(128 | (value & 63))
    return 4
}

RuneCount :: (s: string) -> s64 {
    offset: s64 = 0
    count: s64 = 0
    while offset < s.count {
        _, width := DecodeRune(s, offset)
        if width <= 0 { break }
        offset += width
        count += 1
    }
    return count
}

RuneByteOffset :: (s: string, rune_index: s64) -> s64 {
    if rune_index < 0 { return -1 }
    offset: s64 = 0
    current: s64 = 0
    while current < rune_index && offset < s.count {
        _, width := DecodeRune(s, offset)
        if width <= 0 { break }
        offset += width
        current += 1
    }
    if current == rune_index { return offset }
    return -1
}

RuneAt :: (s: string, rune_index: s64) -> s32 {
    offset := RuneByteOffset(s, rune_index)
    if offset < 0 || offset >= s.count { return -1 }
    rune, width := DecodeRune(s, offset)
    if width <= 0 { return -1 }
    return rune
}

RuneSlice :: (s: string, low_rune: s64, high_rune: s64) -> string {
    low := low_rune
    if low < 0 { low = 0 }
    if high_rune <= low { return "" }
    start := RuneByteOffset(s, low)
    if start < 0 || start >= s.count { return "" }
    end := start
    steps := low
    while steps < high_rune && end < s.count {
        _, width := DecodeRune(s, end)
        if width <= 0 { break }
        end += width
        steps += 1
    }
    return s[start:end]
}
