// Go wall-clock and monotonic timestamps retain their native time.Time behavior.
go_time :: #system_library "go:time";
Time :: #type #foreign go_time "Time";
Duration :: #type #foreign go_time "Duration";

#scope_file
NowRaw :: () -> Time #foreign go_time "Now";
AfterRaw :: (value: Time, other: Time) -> bool #foreign go_time "Time.After";
AddRaw :: (value: Time, duration: Duration) -> Time #foreign go_time "Time.Add";

#scope_export
Now :: () -> Time {
    return NowRaw()
}
After :: (value: Time, other: Time) -> bool {
    return AfterRaw(value, other)
}
Add :: (value: Time, duration: Duration) -> Time {
    return AddRaw(value, duration)
}
