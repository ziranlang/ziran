// Monotonic timing and interruptible sleeps for native glibc Linux programs.
// Wall-clock time is intentionally unavailable from this module.
libc :: #system_library "libc";

// struct timespec: time_t seconds and long nanoseconds. Both are the size
// of a pointer on Linux and Android, so 32-bit on armeabi-v7a; 64-bit fields
// read the clock as garbage there.
ClockValue :: struct {
    seconds: isize
    nanoseconds: isize
}

ClockGetTimeRaw :: (clock: s32, value: *ClockValue) -> s32 #foreign libc "clock_gettime";
ClockSleepRaw :: (clock: s32, flags: s32, request: *ClockValue,
    remaining: *ClockValue) -> s32 #foreign libc "clock_nanosleep";

// Nanosecond resolution for profiling short operations. -1 reports a failed
// clock or a value outside the signed nanosecond range.
#program_export
MonotonicNanoseconds :: () -> s64 {
    value: ClockValue
    if ClockGetTimeRaw(1, *value) != 0 { return -1 }
    seconds := cast(s64)value.seconds; nanoseconds := cast(s64)value.nanoseconds
    if seconds < 0 || nanoseconds < 0 || nanoseconds > 999999999 ||
       seconds > 9223372036 ||
       (seconds == 9223372036 && nanoseconds > 854775807) { return -1 }
    return seconds * 1000000000 + nanoseconds
}

#program_export
MonotonicMilliseconds :: () -> s64 {
    value: [1]ClockValue
    if ClockGetTimeRaw(1, *value[0]) != 0 { return -1 }
    seconds := cast(s64)value[0].seconds; nanoseconds := cast(s64)value[0].nanoseconds
    if nanoseconds < 0 || nanoseconds > 999999999 {
        return -1
    }
    if seconds > 9223372036854775 || seconds < 0 {
        return -1
    }
    return seconds * 1000 + nanoseconds / 1000000
}

MakeClockValue :: (milliseconds: s64) -> ClockValue {
    value: ClockValue
    if milliseconds < 0 { return value }
    value.seconds = cast(isize)(milliseconds / 1000)
    value.nanoseconds = cast(isize)((milliseconds % 1000) * 1000000)
    return value
}

#program_export
SleepMilliseconds :: (milliseconds: s64) -> bool {
    if milliseconds < 0 || milliseconds > 86400000 { return false }
    request: [1]ClockValue
    remaining: [1]ClockValue
    request[0] = MakeClockValue(milliseconds)
    while request[0].seconds > 0 || request[0].nanoseconds > 0 {
        status: s32 = ClockSleepRaw(1, 0, *request[0], *remaining[0])
        if status == 0 { return true }
        if status != 4 { return false }
        request[0] = remaining[0]
    }
    return true
}
