PropertiesCount :: 1243;
#scope_export
Point :: (data: string, at: s32) -> u32 {
    return cast(u32)data[at] | (cast(u32)data[at+1] << 7) | (cast(u32)data[at+2] << 14)
}
Decomposition :: (point: u32) -> string {
    low: s32; high: s32 = cast(s32)DecompositionsCount
    while low < high {
        middle := low + (high-low)/2; data := Decompositions(middle/32); at := (middle%32)*10
        found := Point(data,at)
        if found == point { return data[at:at+10] }
        if found < point { low = middle+1 } else { high = middle }
    }
    return ""
}
Composition :: (a: u32, b: u32) -> u32 {
    low: s32; high: s32 = cast(s32)CompositionsCount
    while low < high {
        middle := low+(high-low)/2; data := Compositions(middle/32); at := (middle%32)*9
        left := Point(data,at); right := Point(data,at+3)
        if left == a && right == b { return Point(data,at+6) }
        if left < a || (left == a && right < b) { low = middle+1 } else { high = middle }
    }
    return 0
}
Property :: (point: u32) -> s32 {
    low: s32; high: s32 = cast(s32)PropertiesCount
    while low < high {
        middle := low+(high-low)/2; data := Properties(middle/32); at := (middle%32)*9
        if point < Point(data,at) { high = middle }
        else if point > Point(data,at+3) { low = middle+1 }
        else { return cast(s32)data[at+6] | (cast(s32)data[at+7] << 3) | (cast(s32)data[at+8] << 10) }
    }
    return 0
}
