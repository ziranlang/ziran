// Whole Ogg Vorbis streams held in memory, decoded over the platform
// libvorbisfile into signed 16-bit little-endian PCM. std/vorbis checks the
// stream's pages and length first, before the library allocates anything. Only programs that
// import this module need the library; link it with -lvorbisfile, or with
// -l:libvorbisfile.so.3 where only the runtime package is installed.
//
//     pcm: Vec(u8)
//     audio: VorbisAudio
//     if VorbisDecode(ogg_bytes, *pcm, 22050 * 60, *audio) { ... }
//
// The records below mirror the public declarations in libogg's ogg.h and
// libvorbis's codec.h and vorbisfile.h field for field, so the C compiler
// lays them out exactly as the library does. Every decode also checks a
// guard placed after its OggVorbis_File, so a library that wrote past the
// mirror fails the decode instead of passing unnoticed.
using Vectors :: #import "vec"
using Vorbis :: #import "vorbis"
using AudioTypes :: #import "audio_types"
Files :: #import "file";

// Xiph C long stays 32 bits on Win64 (LLP64). POSIX uses pointer width.

// ogg_sync_state.
OggSyncState :: struct {
    data: *u8
    storage: s32
    fill: s32
    returned: s32
    unsynced: s32
    headerbytes: s32
    bodybytes: s32
}

// ogg_stream_state.
OggStreamState :: struct {
    body_data: *u8
    #if OS == .WINDOWS || #defined(_WIN32) {
        body_storage: s32
        body_fill: s32
        body_returned: s32
    } else {
        body_storage: isize
        body_fill: isize
        body_returned: isize
    }
    lacing_vals: *s32
    granule_vals: *s64
    #if OS == .WINDOWS || #defined(_WIN32) {
        lacing_storage: s32
        lacing_fill: s32
        lacing_packet: s32
        lacing_returned: s32
    } else {
        lacing_storage: isize
        lacing_fill: isize
        lacing_packet: isize
        lacing_returned: isize
    }
    header: [282]u8
    header_fill: s32
    e_o_s: s32
    b_o_s: s32
    #if OS == .WINDOWS || #defined(_WIN32) {
        serialno: s32
        pageno: s32
    } else {
        serialno: isize
        pageno: isize
    }
    packetno: s64
    granulepos: s64
}

// oggpack_buffer.
OggPackBuffer :: struct {
    #if OS == .WINDOWS || #defined(_WIN32) {
        endbyte: s32
    } else {
        endbyte: isize
    }
    endbit: s32
    buffer: *u8
    ptr: *u8
    #if OS == .WINDOWS || #defined(_WIN32) {
        storage: s32
    } else {
        storage: isize
    }
}

// vorbis_info.
VorbisInfo :: struct {
    version: s32
    channels: s32
    #if OS == .WINDOWS || #defined(_WIN32) {
        rate: s32
        bitrate_upper: s32
        bitrate_nominal: s32
        bitrate_lower: s32
        bitrate_window: s32
    } else {
        rate: isize
        bitrate_upper: isize
        bitrate_nominal: isize
        bitrate_lower: isize
        bitrate_window: isize
    }
    codec_setup: *void
}

// vorbis_dsp_state.
VorbisDspState :: struct {
    analysisp: s32
    vi: *VorbisInfo
    pcm: **float32
    pcmret: **float32
    pcm_storage: s32
    pcm_current: s32
    pcm_returned: s32
    preextrapolate: s32
    eofflag: s32
    #if OS == .WINDOWS || #defined(_WIN32) {
        lW: s32
        W: s32
        nW: s32
        centerW: s32
    } else {
        lW: isize
        W: isize
        nW: isize
        centerW: isize
    }
    granulepos: s64
    sequence: s64
    glue_bits: s64
    time_bits: s64
    floor_bits: s64
    res_bits: s64
    backend_state: *void
}

// vorbis_block.
VorbisBlock :: struct {
    pcm: **float32
    opb: OggPackBuffer
    #if OS == .WINDOWS || #defined(_WIN32) {
        lW: s32
        W: s32
        nW: s32
    } else {
        lW: isize
        W: isize
        nW: isize
    }
    pcmend: s32
    mode: s32
    eofflag: s32
    granulepos: s64
    sequence: s64
    vd: *VorbisDspState
    localstore: *void
    #if OS == .WINDOWS || #defined(_WIN32) {
        localtop: s32
        localalloc: s32
        totaluse: s32
    } else {
        localtop: isize
        localalloc: isize
        totaluse: isize
    }
    reap: *void
    #if OS == .WINDOWS || #defined(_WIN32) {
        glue_bits: s32
        time_bits: s32
        floor_bits: s32
        res_bits: s32
    } else {
        glue_bits: isize
        time_bits: isize
        floor_bits: isize
        res_bits: isize
    }
    internal: *void
}

VorbisRead :: #type (destination: *void, size: usize, count: usize, source: *void) -> usize #c_call;
VorbisSeek :: #type (source: *void, offset: s64, whence: s32) -> s32 #c_call;
VorbisClose :: #type (source: *void) -> s32 #c_call;
#if OS == .WINDOWS || #defined(_WIN32) {
    VorbisTell :: #type (source: *void) -> s32 #c_call;
} else {
    VorbisTell :: #type (source: *void) -> isize #c_call;
}

// ov_callbacks.
VorbisCallbacks :: struct {
    read: VorbisRead
    seek: VorbisSeek
    close: VorbisClose
    tell: VorbisTell
}

// OggVorbis_File.
VorbisFile :: struct {
    datasource: *void
    seekable: s32
    offset: s64
    end: s64
    oy: OggSyncState
    links: s32
    offsets: *s64
    dataoffsets: *s64
    #if OS == .WINDOWS || #defined(_WIN32) {
        serialnos: *s32
    } else {
        serialnos: *isize
    }
    pcmlengths: *s64
    vi: *VorbisInfo
    vc: *void
    pcm_offset: s64
    ready_state: s32
    #if OS == .WINDOWS || #defined(_WIN32) {
        current_serialno: s32
    } else {
        current_serialno: isize
    }
    current_link: s32
    bittrack: float64
    samptrack: float64
    os: OggStreamState
    vd: VorbisDspState
    vb: VorbisBlock
    callbacks: VorbisCallbacks
}

#scope_file
vorbisfile :: #system_library "vorbisfile";
libc :: #system_library "libc";
#if OS == .WINDOWS || #defined(_WIN32) {
    OpenCallbacks :: (source: *void, file: *VorbisFile, initial: *u8, initial_bytes: s32,
        callbacks: VorbisCallbacks) -> s32 #foreign vorbisfile "ov_open_callbacks";
} else {
    OpenCallbacks :: (source: *void, file: *VorbisFile, initial: *u8, initial_bytes: isize,
        callbacks: VorbisCallbacks) -> s32 #foreign vorbisfile "ov_open_callbacks";
}
Clear :: (file: *VorbisFile) -> s32 #foreign vorbisfile "ov_clear";
#if OS == .WINDOWS || #defined(_WIN32) {
    Streams :: (file: *VorbisFile) -> s32 #foreign vorbisfile "ov_streams";
} else {
    Streams :: (file: *VorbisFile) -> isize #foreign vorbisfile "ov_streams";
}
Info :: (file: *VorbisFile, link: s32) -> *VorbisInfo #foreign vorbisfile "ov_info";
PcmTotal :: (file: *VorbisFile, link: s32) -> s64 #foreign vorbisfile "ov_pcm_total";
#if OS == .WINDOWS || #defined(_WIN32) {
    Read :: (file: *VorbisFile, buffer: *u8, length: s32, big_endian: s32, word: s32, signed: s32,
        stream: *s32) -> s32 #foreign vorbisfile "ov_read";
} else {
    Read :: (file: *VorbisFile, buffer: *u8, length: s32, big_endian: s32, word: s32, signed: s32,
        stream: *s32) -> isize #foreign vorbisfile "ov_read";
}
#if OS == .WINDOWS || #defined(_WIN32) {
    ReadFloat :: (file: *VorbisFile, pcm: ***float32, samples: s32, stream: *s32) -> s32 #foreign vorbisfile "ov_read_float";
} else {
    ReadFloat :: (file: *VorbisFile, pcm: ***float32, samples: s32, stream: *s32) -> isize #foreign vorbisfile "ov_read_float";
}
SeekPCM :: (file: *VorbisFile, frame: s64) -> s32 #foreign vorbisfile "ov_pcm_seek";
Allocate :: (count: usize, size: usize) -> *void #foreign libc "calloc";
Free :: (value: *void) #foreign libc "free";
CopyBytes :: (destination: *void, source: *void, count: usize) -> *void #foreign libc "memcpy";

GUARD :: 64
GUARD_BYTE :: 165
// The largest single ov_read request; the library returns at most this.
CHUNK :: 65536

Memory :: struct {
    data: *u8
    count: s64
    at: s64
}

Guarded :: struct {
    file: VorbisFile
    guard: [GUARD]u8
}

MemoryRead :: (destination: *void, size: usize, count: usize, source: *void) -> usize {
    memory := cast(*Memory)source
    if size == 0 || count == 0 { return 0 }
    left := cast(u64)(memory.count - memory.at)
    items := left / cast(u64)size
    if items > cast(u64)count { items = cast(u64)count }
    bytes := items * cast(u64)size
    if bytes > 0 { unused CopyBytes(destination, cast(*void)*memory.data[memory.at], cast(usize)bytes) }
    memory.at += cast(s64)bytes
    return cast(usize)items
}

MemorySeek :: (source: *void, offset: s64, whence: s32) -> s32 {
    memory := cast(*Memory)source
    base: s64 = 0
    if whence == 1 { base = memory.at } else if whence == 2 { base = memory.count } else if whence != 0 { return -1 }
    if (offset < 0 && offset < -base) || (offset > 0 && offset > memory.count - base) { return -1 }
    memory.at = base + offset
    return 0
}

MemoryClose :: (source: *void) -> s32 { unused source; return 0 }

#if OS == .WINDOWS || #defined(_WIN32) {
    MemoryTell :: (source: *void) -> s32 { return cast(s32)(cast(*Memory)source).at }
} else {
    MemoryTell :: (source: *void) -> isize { return cast(isize)(cast(*Memory)source).at }
}

GuardIntact :: (state: *Guarded) -> bool {
    for at: 0..GUARD - 1 {
        if state.guard[at] != cast(u8)GUARD_BYTE { return false }
    }
    return true
}

#scope_export
// Replaces OUTPUT with the decoded samples of the single Ogg Vorbis stream
// INPUT holds: interleaved, signed 16-bit little-endian. False, with OUTPUT
// empty, for anything else: an empty, damaged or truncated stream, trailing
// bytes, chained streams, a stream whose decoded length differs from its
// declared length, or one longer than MAX_FRAMES frames.
VorbisDecode :: (input: []u8, output: *Vec(u8), max_frames: s64, audio: *VorbisAudio) -> bool {
    VecClear(<<output)
    <<audio = VorbisAudio.{}
    declared: VorbisAudio
    if max_frames <= 0 || !VorbisProbe(input, *declared) || declared.frames > max_frames { return false }
    memory := Memory.{.data = *input[0], .count = input.count, .at = 0}
    state: Guarded
    for at: 0..GUARD - 1 { state.guard[at] = cast(u8)GUARD_BYTE }
    callbacks: VorbisCallbacks
    callbacks.read = MemoryRead
    callbacks.seek = MemorySeek
    callbacks.close = MemoryClose
    callbacks.tell = MemoryTell
    // A failed open has already cleared the file.
    if OpenCallbacks(cast(*void)*memory, *state.file, null, 0, callbacks) != 0 { return false }
    valid := Decode(*state.file, output, declared, audio)
    unused Clear(*state.file)
    if !GuardIntact(*state) { valid = false }
    if !valid {
        VecClear(<<output)
        <<audio = VorbisAudio.{}
    }
    return valid
}

#scope_file
// Decodes what DECLARED, the stream's probe, says it holds, and no other.
Decode :: (file: *VorbisFile, output: *Vec(u8), declared: VorbisAudio, audio: *VorbisAudio) -> bool {
    if Streams(file) != 1 { return false }
    info := Info(file, -1)
    if info == null || info.channels != declared.channels || cast(s64)info.rate != cast(s64)declared.rate { return false }
    frames := PcmTotal(file, -1)
    if frames != declared.frames || frames > (cast(s64)1 << 40) { return false }
    bytes := frames * cast(s64)info.channels * 2
    samples: Vec(u8)
    for at: cast(s64)0..bytes - 1 { VecPush(samples, cast(u8)0) }
    if !ReadAll(file, VecSlice(samples, 0, bytes)) { return false }
    <<audio = declared
    VecSwap(samples, <<output)
    return true
}

// Fills PCM exactly, then requires the stream to end there.
ReadAll :: (file: *VorbisFile, pcm: []u8) -> bool {
    at: s64 = 0
    stream: s32 = 0
    while at < pcm.count {
        request := pcm.count - at
        if request > CHUNK { request = CHUNK }
        read := cast(s64)Read(file, *pcm[at], cast(s32)request, 0, 2, 1, *stream)
        if read <= 0 || stream != 0 || read > request { return false }
        at += read
    }
    extra: [4096]u8
    return Read(file, *extra[0], 4096, 0, 2, 1, *stream) == 0
}

// Incremental state uses the same guarded libvorbisfile ABI and callbacks as
// whole-file decode. Borrowed input stays unchanged until close. Do not copy
// a live decoder or call it concurrently.
DecoderState :: struct { guarded: Guarded; memory: Memory }
#scope_export
// Single-owner state over borrowed input, or owned input opened from a file.
// Keep borrowed bytes alive and unchanged until close. No concurrent calls.
VorbisDecoder :: struct {
    state: *void
    info: VorbisAudio
    comments: VorbisComments
    position: s64
    owned: Vec(u8)
}
VorbisDecoderClose :: (decoder: *VorbisDecoder) {
    if decoder.state != null {
        state := cast(*DecoderState)decoder.state
        unused Clear(*state.guarded.file)
        Free(decoder.state)
    }
    VorbisCommentsFree(*decoder.comments); VecFree(decoder.owned)
    decoder.state = null; decoder.info = .{}; decoder.position = 0
}
VorbisDecoderOpen :: (decoder: *VorbisDecoder, input: []u8, max_frames: s64) -> s32 {
    if decoder.state != null || max_frames <= 0 || max_frames > VorbisMaxStreamFrames { return Invalid }
    audio: VorbisAudio
    comments: VorbisComments
    code := VorbisInspectComments(input, *audio, *comments)
    if code != OK { return code }
    if audio.frames > max_frames { return LimitExceeded }
    state := cast(*DecoderState)Allocate(1, size_of(DecoderState))
    if state == null { return AllocationFailed }
    state.memory = .{.data = *input[0], .count = input.count}
    for index: 0..GUARD - 1 { state.guarded.guard[index] = cast(u8)GUARD_BYTE }
    callbacks: VorbisCallbacks
    callbacks.read = MemoryRead; callbacks.seek = MemorySeek; callbacks.close = MemoryClose; callbacks.tell = MemoryTell
    file := *state.guarded.file
    if OpenCallbacks(cast(*void)*state.memory, file, null, 0, callbacks) != 0 { Free(cast(*void)state); return Malformed }
    info := Info(file, -1)
    if !GuardIntact(*state.guarded) || Streams(file) != 1 || info == null ||
        info.channels != audio.channels || cast(s64)info.rate != cast(s64)audio.rate || PcmTotal(file, -1) != audio.frames {
        unused Clear(file); Free(cast(*void)state); return Malformed
    }
    decoder.state = cast(*void)state; decoder.info = audio; decoder.position = 0
    VecSwap(decoder.comments.text, comments.text); VecSwap(decoder.comments.spans, comments.spans)
    decoder.comments.vendor = comments.vendor
    return OK
}
VorbisDecoderOpenFile :: (decoder: *VorbisDecoder, path: string, max_frames: s64) -> s32 {
    if decoder.state != null || max_frames <= 0 || max_frames > VorbisMaxStreamFrames { return Invalid }
    VecFree(decoder.owned)
    if !Files.ReadFileInto(path, *decoder.owned) { VecFree(decoder.owned); return IOFailure }
    if decoder.owned.count > MaxBytes { VecFree(decoder.owned); return LimitExceeded }
    code := VorbisDecoderOpen(decoder, decoder.owned[:], max_frames)
    if code != OK { VecFree(decoder.owned) }
    return code
}
// Fills whole interleaved frames; OK with zero frames denotes the logical end.
// Discard the output on error, then seek or close.
VorbisDecoderRead :: (decoder: *VorbisDecoder, output: []float32, frames: *s64) -> s32 {
    <<frames = 0
    if decoder.state == null || output.count <= 0 || output.count % decoder.info.channels != 0 { return Invalid }
    state := cast(*DecoderState)decoder.state
    if !GuardIntact(*state.guarded) { return Malformed }
    channels := cast(s64)decoder.info.channels
    wanted := output.count / channels
    left := decoder.info.frames - decoder.position
    if wanted > left { wanted = left }
    done: s64
    while done < wanted {
        request := wanted - done
        if request > 65536 { request = 65536 }
        planes: **float32; link: s32
        got := cast(s64)ReadFloat(*state.guarded.file, *planes, cast(s32)request, *link)
        if got <= 0 || got > request || link != 0 || !GuardIntact(*state.guarded) { return Malformed }
        for frame: 0..got - 1 {
            for channel: 0..channels - 1 { output[(done + frame) * channels + channel] = planes[channel][frame] }
        }
        done += got
    }
    decoder.position += done
    if decoder.position == decoder.info.frames {
        planes: **float32; link: s32
        if ReadFloat(*state.guarded.file, *planes, 1, *link) != 0 || !GuardIntact(*state.guarded) { return Malformed }
    }
    <<frames = done
    return OK
}
VorbisDecoderReadS16 :: (decoder: *VorbisDecoder, output: []s16, frames: *s64) -> s32 {
    <<frames = 0
    if decoder.state == null || output.count <= 0 || output.count % decoder.info.channels != 0 { return Invalid }
    channels := cast(s64)decoder.info.channels
    wanted := output.count / channels
    if wanted > decoder.info.frames - decoder.position { wanted = decoder.info.frames - decoder.position }
    scratch: [4096]float32
    done: s64
    while done < wanted {
        count := wanted - done
        if count > 4096 / channels { count = 4096 / channels }
        got: s64
        code := VorbisDecoderRead(decoder, scratch[0:count * channels], *got)
        if code != OK { return code }
        if got != count { return Malformed }
        for index: cast(s64)0..got * channels - 1 {
            value := cast(float64)scratch[index]
            output[done * channels + index] = ifx value != value then cast(s16)0 else Pcm16(value)
        }
        done += got
    }
    <<frames = done
    return OK
}
VorbisDecoderSeek :: (decoder: *VorbisDecoder, frame: s64) -> s32 {
    if decoder.state == null || frame < 0 || frame > decoder.info.frames { return Invalid }
    state := cast(*DecoderState)decoder.state
    if !GuardIntact(*state.guarded) || SeekPCM(*state.guarded.file, frame) != 0 || !GuardIntact(*state.guarded) { return Malformed }
    decoder.position = frame
    return OK
}
VorbisDecoderRewind :: (decoder: *VorbisDecoder) -> s32 { return VorbisDecoderSeek(decoder, 0) }
// Whole-file float output is unchanged on error.
VorbisDecodeFloat :: (input: []u8, max_frames: s64, output: *PCM) -> s32 {
    decoder: VorbisDecoder
    code := VorbisDecoderOpen(*decoder, input, max_frames)
    if code != OK { return code }
    defer VorbisDecoderClose(*decoder)
    if decoder.info.frames > MaxFrames { return LimitExceeded }
    samples: Vec(float32)
    count := decoder.info.frames * decoder.info.channels
    if !VecResize(samples, count) { return AllocationFailed }
    frames: s64
    code = VorbisDecoderRead(*decoder, samples[:], *frames)
    if code != OK { return code }
    output.rate = decoder.info.rate; output.channels = decoder.info.channels
    SwapSamples(output, *samples)
    return OK
}
VorbisDecodeS16 :: (input: []u8, max_frames: s64, output: *Vec(s16), info: *VorbisAudio) -> s32 {
    decoder: VorbisDecoder
    code := VorbisDecoderOpen(*decoder, input, max_frames)
    if code != OK { return code }
    defer VorbisDecoderClose(*decoder)
    if decoder.info.frames > MaxFrames { return LimitExceeded }
    samples: Vec(s16)
    count := decoder.info.frames * decoder.info.channels
    if !VecResize(samples, count) { return AllocationFailed }
    frames: s64
    code = VorbisDecoderReadS16(*decoder, samples[:], *frames)
    if code != OK { return code }
    <<info = decoder.info
    VecSwap(samples, <<output)
    return OK
}
