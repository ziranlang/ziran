using Allocated :: #import "compiler_machine_verify_allocated"
using Image :: #import "compiler_machine_image"
using Machine :: #import "compiler_machine_ir"
using Target :: #import "compiler_target"
using Vectors :: #import "std/vec"
using A64 :: #import "compiler_aarch64"

// Local tests for the direct AArch64 machine-IR encoder. Programs are built
// in the Allocated stage by hand, checked against MachineVerifyAllocated, and
// compared with exact instruction words, branch fields and relocations.

X0 :: 0
X1 :: 1
X2 :: 2
X3 :: 3
X4 :: 4
X5 :: 5
X6 :: 6
X8 :: 8
X9 :: 9
X10 :: 10
X11 :: 11
X12 :: 12
X13 :: 13
X14 :: 14
X15 :: 15
X16 :: 16

VOID :: 0
BOOL :: 1
S64 :: 2
U64 :: 3
S32 :: 4
U32 :: 5
S16 :: 6
U16 :: 7
S8 :: 8
U8 :: 9
POINTER :: 10
FUNCTION :: 11
F64 :: 12
RECORD :: 13
RECORD_POINTER :: 14

Builder :: struct {
    text: Vec(u8)
    types: Vec(MachineType)
    type_ids: Vec(s32)
    globals: Vec(MachineGlobal)
    functions: Vec(MachineFunction)
    blocks: Vec(MachineBlock)
    virtuals: Vec(MachineVirtual)
    instructions: Vec(MachineInstruction)
    operands: Vec(MachineOperand)
    edges: Vec(MachineEdge)
    stack_objects: Vec(MachineStackObject)
    relocations: Vec(MachineRelocation)
    calls: Vec(MachineCall)
    frames: Vec(MachineFrame)
    spills: Vec(MachineSpill)
    function: s32
    block: s32
    flags: s32
    entry: s32
    stage: MachineStage
    target: TargetDescription
}

Mode :: enum s32 { Verify; Validate; Measure; Encode }

Check :: (condition: bool, message: string) -> bool {
    if condition { return true }
    print("aarch64 encoder local test failed: %\n", message)
    return false
}

BuilderFree :: (b: *Builder) {
    VecFree(b.text)
    VecFree(b.types)
    VecFree(b.type_ids)
    VecFree(b.globals)
    VecFree(b.functions)
    VecFree(b.blocks)
    VecFree(b.virtuals)
    VecFree(b.instructions)
    VecFree(b.operands)
    VecFree(b.edges)
    VecFree(b.stack_objects)
    VecFree(b.relocations)
    VecFree(b.calls)
    VecFree(b.frames)
    VecFree(b.spills)
}

AddType :: (b: *Builder, kind: MachineTypeKind, class: MachineRegisterClass, bits: s32, signed: bool, size: s64) {
    alignment: s32 = 1
    if size >= 8 { alignment = 8 } else if size >= 1 { alignment = cast(s32)size }
    unused VecPush(b.types, .{kind = kind, class = class, bits = bits, is_signed = signed, size = size,
        alignment = alignment, element = -1, result = -1})
}

Setup :: (b: *Builder) {
    b.function = -1
    b.block = -1
    b.flags = -1
    b.entry = -1
    b.stage = .Allocated
    b.target = Target.TargetDescribe(.AArch64, .Linux).target
    AddType(b, .Void, .Stack, 0, false, 0)
    AddType(b, .Bool, .General, 1, false, 1)
    AddType(b, .Integer, .General, 64, true, 8)
    AddType(b, .Integer, .General, 64, false, 8)
    AddType(b, .Integer, .General, 32, true, 4)
    AddType(b, .Integer, .General, 32, false, 4)
    AddType(b, .Integer, .General, 16, true, 2)
    AddType(b, .Integer, .General, 16, false, 2)
    AddType(b, .Integer, .General, 8, true, 1)
    AddType(b, .Integer, .General, 8, false, 1)
    AddType(b, .Pointer, .General, 64, false, 8)
    AddType(b, .Function, .General, 64, false, 8)
    AddType(b, .Float, .Float, 64, false, 8)
    record_fields := cast(s32)b.type_ids.count
    unused VecPush(b.type_ids, U8)
    unused VecPush(b.type_ids, S64)
    unused VecPush(b.types, .{kind = .Record, class = .Stack, size = 16, alignment = 8,
        fields_begin = record_fields, fields_count = 2, element = -1, result = -1})
    unused VecPush(b.types, .{kind = .Pointer, class = .General, bits = 64, is_signed = false,
        size = 8, alignment = 8, element = RECORD, result = -1})
    unused VecPush(b.globals, .{type = S64, constant = -1, writable = true})
}

Begin :: (b: *Builder, name: string) -> s32 {
    id := cast(s32)b.functions.count
    offset := cast(s32)b.text.count
    for byte: name { unused VecPush(b.text, byte) }
    unused VecPush(b.functions, .{lir_function = id, name_offset = offset, name_length = cast(s32)name.count,
        block_begin = cast(s32)b.blocks.count, virtual_begin = cast(s32)b.virtuals.count,
        stack_begin = cast(s32)b.stack_objects.count, result_type = S64, calling = .Internal,
        entry = cast(s32)b.blocks.count, origin = -1})
    b.function = id
    return id
}

Parameter :: (b: *Builder, type: s32, register: s32) -> s32 {
    id := cast(s32)b.virtuals.count
    class := b.types[type].class
    unused VecPush(b.virtuals, .{class = class, type = type, fixed_register = register, stack_object = -1, origin = -1})
    function := b.functions[b.function]
    function.parameter_count += 1
    b.functions[b.function] = function
    return id
}

Value :: (b: *Builder, type: s32) -> s32 {
    id := cast(s32)b.virtuals.count
    unused VecPush(b.virtuals, .{class = b.types[type].class, type = type, fixed_register = -1,
        stack_object = -1, origin = -1})
    return id
}

FlagsValue :: (b: *Builder) -> s32 {
    id := cast(s32)b.virtuals.count
    unused VecPush(b.virtuals, .{class = .Flags, type = VOID, fixed_register = -1, stack_object = -1, origin = -1})
    return id
}

Object :: (b: *Builder, kind: MachineStackKind, size: s64, offset: s64, value: s32, type: s32) -> s32 {
    id := cast(s32)b.stack_objects.count
    alignment: s32 = 1
    if size >= 8 { alignment = 8 } else if size >= 1 { alignment = cast(s32)size }
    unused VecPush(b.stack_objects, .{function = b.function, kind = kind, size = size, alignment = alignment,
        type = type, origin = -1, offset = offset, value = value})
    return id
}

Blocks :: (b: *Builder, count: s32) -> s32 {
    first := cast(s32)b.blocks.count
    for index: 0..count - 1 {
        unused VecPush(b.blocks, .{function = b.function, lir_block = -1,
            instruction_begin = cast(s32)b.instructions.count})
    }
    return first
}

Enter :: (b: *Builder, block: s32) {
    record := b.blocks[block]
    record.instruction_begin = cast(s32)b.instructions.count
    b.blocks[block] = record
    b.block = block
    b.flags = -1
}

End :: (b: *Builder, size: s64, outgoing: s64 = 0) {
    function := b.functions[b.function]
    function.block_count = cast(s32)b.blocks.count - function.block_begin
    function.virtual_count = cast(s32)b.virtuals.count - function.virtual_begin
    function.stack_count = cast(s32)b.stack_objects.count - function.stack_begin
    b.functions[b.function] = function
    saved: u64 = 0
    for object_id: function.stack_begin..function.stack_begin + function.stack_count - 1 {
        object := b.stack_objects[object_id]
        if object.kind == .CalleeSave { saved = saved | (cast(u64)1 << cast(u64)object.value) }
    }
    unused VecPush(b.frames, .{function = b.function, size = size, alignment = 16, outgoing_size = outgoing,
        callee_saved_general = saved})
}

Open :: (b: *Builder, opcode: MachineOpcode) -> MachineInstruction {
    return .{opcode = opcode, operand_begin = cast(s32)b.operands.count, edge_begin = cast(s32)b.edges.count,
        flags_use = -1, flags_def = -1, call = -1, origin = -1}
}

Close :: (b: *Builder, instruction: MachineInstruction) -> s32 {
    instruction.operand_count = cast(s32)b.operands.count - instruction.operand_begin
    instruction.edge_count = cast(s32)b.edges.count - instruction.edge_begin
    id := cast(s32)b.instructions.count
    unused VecPush(b.instructions, instruction)
    block := b.blocks[b.block]
    block.instruction_count += 1
    b.blocks[b.block] = block
    return id
}

Operand :: (b: *Builder, operand: MachineOperand) -> s32 {
    id := cast(s32)b.operands.count
    unused VecPush(b.operands, operand)
    return id
}

Physical :: (b: *Builder, register: s32, role: MachineOperandRole, value: s32) -> s32 {
    class := MachineRegisterClass.General
    type: s32 = -1
    if value >= 0 { class = b.virtuals[value].class; type = b.virtuals[value].type }
    return Operand(b, .{kind = .Physical, role = role, class = class, id = register, type = type,
        fixed_register = -1, tied_to = -1, value = value})
}

Immediate :: (b: *Builder, value: u64) -> s32 {
    return Operand(b, .{kind = .Immediate, role = .Use, class = .General, id = -1, type = -1,
        fixed_register = -1, tied_to = -1, immediate = value, value = -1})
}

Symbol :: (b: *Builder, kind: MachineOperandKind, id: s32) -> s32 {
    return Operand(b, .{kind = kind, role = .Use, class = .General, id = id, type = -1,
        fixed_register = -1, tied_to = -1, value = -1})
}

Slot :: (b: *Builder, object: s32, role: MachineOperandRole, value: s32) -> s32 {
    class := MachineRegisterClass.Stack
    if value >= 0 { class = b.virtuals[value].class }
    return Operand(b, .{kind = .StackObject, role = role, class = class, id = object, type = -1,
        fixed_register = -1, tied_to = -1, value = value})
}

Edge :: (b: *Builder, target: s32) {
    unused VecPush(b.edges, .{target = target})
}

Constant :: (b: *Builder, register: s32, value: s32, bits: u64) -> s32 {
    instruction := Open(b, .MoveImmediate)
    unused Physical(b, register, .Define, value)
    unused Immediate(b, bits)
    return Close(b, instruction)
}

Two :: (b: *Builder, opcode: MachineOpcode, destination: s32, result: s32, source: s32, input: s32) -> s32 {
    instruction := Open(b, opcode)
    unused Physical(b, destination, .Define, result)
    unused Physical(b, source, .Use, input)
    return Close(b, instruction)
}

Three :: (b: *Builder, opcode: MachineOpcode, destination: s32, result: s32,
    left: s32, left_value: s32, right: s32, right_value: s32) -> s32 {
    instruction := Open(b, opcode)
    unused Physical(b, destination, .Define, result)
    unused Physical(b, left, .Use, left_value)
    unused Physical(b, right, .Use, right_value)
    return Close(b, instruction)
}

// AArch64 divides take three arbitrary registers and guard the divisor
// inline, so no fixed dividend or clobber operand exists.
Divide :: (b: *Builder, opcode: MachineOpcode, destination: s32, result: s32,
    left: s32, left_value: s32, right: s32, right_value: s32) -> s32 {
    instruction := Open(b, opcode)
    unused Physical(b, destination, .Define, result)
    unused Physical(b, left, .Use, left_value)
    unused Physical(b, right, .Use, right_value)
    return Close(b, instruction)
}

Store :: (b: *Builder, address: s32, pointer: s32, source: s32, value: s32) -> s32 {
    instruction := Open(b, .Store)
    unused Physical(b, address, .Use, pointer)
    unused Physical(b, source, .Use, value)
    return Close(b, instruction)
}

Compare :: (b: *Builder, left: s32, left_value: s32, right: s32, right_value: s32, condition: MachineCondition) -> s32 {
    instruction := Open(b, .Compare)
    b.flags = FlagsValue(b)
    instruction.flags_def = b.flags
    instruction.condition = condition
    unused Physical(b, left, .Use, left_value)
    unused Physical(b, right, .Use, right_value)
    return Close(b, instruction)
}

SetCondition :: (b: *Builder, destination: s32, result: s32, condition: MachineCondition) -> s32 {
    instruction := Open(b, .SetCondition)
    instruction.flags_use = b.flags
    instruction.condition = condition
    unused Physical(b, destination, .Define, result)
    return Close(b, instruction)
}

Return :: (b: *Builder, register: s32, value: s32) -> s32 {
    instruction := Open(b, .Return)
    if register >= 0 { unused Physical(b, register, .Use, value) }
    return Close(b, instruction)
}

Jump :: (b: *Builder, target: s32) -> s32 {
    instruction := Open(b, .Jump)
    Edge(b, target)
    return Close(b, instruction)
}

BranchOn :: (b: *Builder, register: s32, value: s32, taken: s32, other: s32) -> s32 {
    instruction := Open(b, .Branch)
    unused Physical(b, register, .Use, value)
    Edge(b, taken)
    Edge(b, other)
    return Close(b, instruction)
}

// A flags branch keeps its recorded condition; the encoder inverts the raw
// condition whenever the fall-through edge is the taken one.
BranchFlags :: (b: *Builder, condition: MachineCondition, taken: s32, other: s32) -> s32 {
    instruction := Open(b, .Branch)
    instruction.flags_use = b.flags
    instruction.condition = condition
    Edge(b, taken)
    Edge(b, other)
    return Close(b, instruction)
}

Fuel :: (b: *Builder, amount: u64) -> s32 {
    instruction := Open(b, .Fuel)
    b.flags = FlagsValue(b)
    instruction.flags_def = b.flags
    unused Immediate(b, amount)
    counter := Immediate(b, 0)
    id := Close(b, instruction)
    unused VecPush(b.relocations, .{instruction = id, operand = counter, kind = .FuelCounter, symbol = 0})
    return id
}

Trap :: (b: *Builder, code: u64) -> s32 {
    instruction := Open(b, .Trap)
    unused Immediate(b, code)
    return Close(b, instruction)
}

Unreachable :: (b: *Builder) -> s32 {
    return Close(b, Open(b, .Unreachable))
}

SpillTo :: (b: *Builder, object: s32, register: s32, value: s32) -> s32 {
    instruction := Open(b, .Spill)
    unused Slot(b, object, .Define, value)
    unused Physical(b, register, .Use, value)
    id := Close(b, instruction)
    unused VecPush(b.spills, .{function = b.function, instruction = id, virtual = value, stack_object = object,
        register = register, reason = .Pressure, origin = -1})
    return id
}

ReloadFrom :: (b: *Builder, register: s32, object: s32, value: s32) -> s32 {
    instruction := Open(b, .Reload)
    unused Physical(b, register, .Define, value)
    unused Slot(b, object, .Use, value)
    id := Close(b, instruction)
    unused VecPush(b.spills, .{function = b.function, instruction = id, virtual = value, stack_object = object,
        register = register, reason = .Pressure, origin = -1})
    return id
}

AddressOf :: (b: *Builder, opcode: MachineOpcode, destination: s32, result: s32, symbol: s32, addend: s64) -> s32 {
    instruction := Open(b, opcode)
    unused Physical(b, destination, .Define, result)
    operand := Symbol(b, ifx opcode == .GlobalAddress then MachineOperandKind.Global else .Function, symbol)
    id := Close(b, instruction)
    kind := ifx opcode == .GlobalAddress then MachineRelocationKind.GlobalAddress else MachineRelocationKind.FunctionAddress
    unused VecPush(b.relocations, .{instruction = id, operand = operand, kind = kind, symbol = symbol, addend = addend})
    return id
}

// A call with at most one general argument in X0; the fixed bank covers the
// whole AArch64 general register file, the float bank its usual file.
CallTo :: (b: *Builder, callee: s32, callable: s32, callable_value: s32, result: s32,
    argument_register: s32, argument: s32, relocated: bool = true, stack_bytes: s64 = 0) -> s32 {
    indirect := callee < 0
    instruction := Open(b, ifx indirect then MachineOpcode.CallIndirect else .CallDirect)
    instruction.call = cast(s32)b.calls.count
    result_operand: s32 = -1
    if result >= 0 { result_operand = Physical(b, X0, .Define, result) }
    target: s32 = -1
    if indirect { target = Physical(b, callable, .Use, callable_value) }
    else { target = Symbol(b, .Function, callee) }
    argument_begin := cast(s32)b.operands.count
    count: s32 = 0
    if argument >= 0 { unused Physical(b, argument_register, .Use, argument); count = 1 }
    id := Close(b, instruction)
    unused VecPush(b.calls, .{instruction = id, calling = .Internal, argument_begin = argument_begin,
        argument_count = count, result_operand = result_operand, stack_argument_bytes = stack_bytes,
        clobber_general = 0x3ffff, clobber_float = 0xffff00ff, clobber_vector = 0xffffffff, indirect = indirect})
    if !indirect && relocated {
        unused VecPush(b.relocations, .{instruction = id, operand = target, kind = .FunctionCall, symbol = callee})
    }
    return id
}

// The fixed byte-equality form reads x10-x13 and spends x14-x16.
BytesEqualOp :: (b: *Builder, result: s32, left: s32, left_count: s32,
    right: s32, right_count: s32) -> s32 {
    instruction := Open(b, .BytesEqual)
    unused Physical(b, X0, .Define, result)
    unused Physical(b, X10, .Use, left)
    unused Physical(b, X11, .Use, left_count)
    unused Physical(b, X12, .Use, right)
    unused Physical(b, X13, .Use, right_count)
    unused Physical(b, X14, .Define, -1)
    unused Physical(b, X15, .Define, -1)
    unused Physical(b, X16, .Define, -1)
    return Close(b, instruction)
}

// The fixed resize form runs on x10-x12, saves x1-x8 around the runtime call
// and names the helper through a zero-addend relocation.
ResizeOp :: (b: *Builder, result: s32, pointer: s32, old_count: s32, new_count: s32) -> s32 {
    instruction := Open(b, .Resize)
    unused Physical(b, X0, .Define, result)
    unused Physical(b, X10, .Use, pointer)
    unused Physical(b, X11, .Use, old_count)
    unused Physical(b, X12, .Use, new_count)
    unused Physical(b, X13, .Define, -1)
    unused Physical(b, X14, .Define, -1)
    unused Physical(b, X15, .Define, -1)
    unused Physical(b, X16, .Define, -1)
    unused Physical(b, 17, .Define, -1)
    unused Physical(b, X9, .Define, -1)
    unused Physical(b, X10, .Define, -1)
    unused Physical(b, X11, .Define, -1)
    counter := Immediate(b, 0)
    id := Close(b, instruction)
    unused VecPush(b.relocations, .{instruction = id, operand = counter, kind = .RuntimeResize, symbol = 0})
    return id
}

Apply :: (b: *Builder, mode: Mode, owner: *A64.MachineA64Owner, limits: MachineLimits) -> A64.MachineA64Result {
    program := MachineProgram.{version = MachineVersion, target = b.target, text = b.text[:], types = b.types[:],
        type_ids = b.type_ids[:],
        globals = b.globals[:], functions = b.functions[:], blocks = b.blocks[:], virtuals = b.virtuals[:],
        instructions = b.instructions[:], operands = b.operands[:], edges = b.edges[:],
        stack_objects = b.stack_objects[:], relocations = b.relocations[:], calls = b.calls[:],
        entry = b.entry, stage = b.stage, frames = b.frames[:], spills = b.spills[:],
        scratch_general = 15, scratch_float = 31}
    if mode == .Verify { return .{diagnostic = MachineVerifyAllocated(program, limits)} }
    if mode == .Validate { return .{diagnostic = A64.MachineA64Validate(program, limits)} }
    if mode == .Measure { return A64.MachineA64Measure(program, limits) }
    return .{diagnostic = A64.MachineA64Encode(program, limits, owner)}
}

Report :: (label: string, diagnostic: MachineDiagnostic) {
    print("%: problem % function % block % instruction % operand % virtual %\n", label,
        cast(s32)diagnostic.problem, diagnostic.function, diagnostic.block, diagnostic.instruction,
        diagnostic.operand, diagnostic.virtual)
}

Nibble :: (byte: u8) -> s32 {
    if byte >= 48 && byte <= 57 { return cast(s32)byte - 48 }
    if byte >= 97 && byte <= 102 { return cast(s32)byte - 87 }
    return -1
}

// Compares CODE[BEGIN:END] with space-separated lowercase hex bytes.
Bytes :: (code: []u8, begin: s64, end: s64, hex: string, message: string) -> bool {
    at := begin
    index: s64 = 0
    ok := begin >= 0 && end <= code.count && begin <= end
    while ok && index < hex.count {
        if hex[index] == 32 { index += 1; continue }
        high := Nibble(hex[index])
        low := ifx index + 1 < hex.count then Nibble(hex[index + 1]) else -1
        if high < 0 || low < 0 || at >= end || cast(s32)code[at] != high * 16 + low { ok = false; break }
        at += 1
        index += 2
    }
    if ok && at == end { return true }
    print("aarch64 encoder local test failed: % bytes (expected %, encoded", message, hex)
    if begin >= 0 && end <= code.count {
        for position: begin..end - 1 { print(" %", cast(s32)code[position]) }
    }
    print(")\n")
    return false
}

Instruction :: (image: A64.MachineA64Image, id: s32, hex: string, message: string) -> bool {
    range := image.instructions[id]
    return Bytes(image.code, range.begin, range.end, hex, message)
}

// Little-endian instruction word at CODE[AT]; the mirror decodes branch
// fields from these words instead of patched displacements.
Words :: (code: []u8, at: s64) -> u32 {
    return cast(u32)code[at] | (cast(u32)code[at + 1] << 8) |
        (cast(u32)code[at + 2] << 16) | (cast(u32)code[at + 3] << 24)
}

Fingerprint :: (image: A64.MachineA64Image) -> u64 {
    hash: u64 = 1469598103934665603
    for byte: image.code { hash = (hash ^ byte) * 1099511628211 }
    for relocation: image.relocations {
        hash = (hash ^ cast(u64)relocation.offset ^ cast(u64)relocation.kind) * 1099511628211
        hash = (hash ^ cast(u64)relocation.addend ^ cast(u64)(relocation.symbol + 1)) * 1099511628211
    }
    return hash
}

// Every function, block and instruction range is contiguous and the last
// function ends at the image end: the byte accounting is exact. A non-entry
// function costs one branch word around its body.
Accounted :: (b: *Builder, image: A64.MachineA64Image) -> bool {
    at: s64 = 0
    for function_id: cast(s64)0..b.functions.count - 1 {
        function := b.functions[function_id]
        record := image.functions[function_id]
        if record.begin != at || record.body < record.begin { return false }
        at = record.body
        if function.entry != function.block_begin { at += 4 }
        for block_id: function.block_begin..function.block_begin + function.block_count - 1 {
            block := b.blocks[block_id]
            if image.blocks[block_id] != at { return false }
            for instruction_id: block.instruction_begin..block.instruction_begin + block.instruction_count - 1 {
                range := image.instructions[instruction_id]
                if range.begin != at || range.end < range.begin { return false }
                at = range.end
            }
        }
        if record.end != at { return false }
    }
    return at == image.code.count
}

TRAP_UNREACHABLE :: "e0 ff bf 52 20 00 80 72 00 00 00 94 00 00 20 d4"
TRAP_DIVIDE :: "e0 ff bf 52 40 00 80 72 00 00 00 94 00 00 20 d4"
TRAP_SHIFT :: "e0 ff bf 52 60 00 80 72 00 00 00 94 00 00 20 d4"
TRAP_FUEL :: "e0 ff bf 52 80 00 80 72 00 00 00 94 00 00 20 d4"

Ids :: struct {
    answer: s32
    arithmetic: [10]s32
    stack: s32
    stack_ops: [6]s32
    memory: [8]s32
    branch: s32
    branch_ops: [6]s32
    branch2: s32
    branch2_ops: [3]s32
    branch_fallthrough: s32
    loop: s32
    loop_ops: [6]s32
    fuel: s32
    fuel_ops: [2]s32
    convert_ops: [3]s32
    divide: [2]s32
    unsigned_divide: [1]s32
    shift: [3]s32
    bytes_equal: s32
    resize: s32
    resize_function: s32
}

BuildBasics :: (b: *Builder, ids: *Ids) {
    Setup(b)
    ids.answer = Begin(b, "answer")
    answer_value := Value(b, S64)
    Enter(b, Blocks(b, 1))
    unused Constant(b, X0, answer_value, 42)
    unused Return(b, X0, answer_value)
    End(b, 0)

    unused Begin(b, "arithmetic")
    a := Parameter(b, S64, X0); c := Parameter(b, S64, X1); d := Parameter(b, S64, X2)
    e := Parameter(b, S64, X3); f := Parameter(b, S64, X4); g := Parameter(b, S64, X5)
    sum := Value(b, S64); difference := Value(b, S64); product := Value(b, S64); masked := Value(b, S64)
    joined := Value(b, S64); mixed := Value(b, S64); negated := Value(b, S64); inverted := Value(b, S64)
    Enter(b, Blocks(b, 1))
    ids.arithmetic[0] = Three(b, .IntegerAdd, X0, sum, X0, a, X1, c)
    ids.arithmetic[1] = Three(b, .IntegerSubtract, X4, difference, X4, f, X5, g)
    ids.arithmetic[2] = Three(b, .IntegerMultiply, X4, product, X4, difference, X0, sum)
    ids.arithmetic[3] = Three(b, .IntegerAnd, X0, masked, X0, sum, X4, product)
    ids.arithmetic[4] = Three(b, .IntegerOr, X2, joined, X2, d, X3, e)
    ids.arithmetic[5] = Three(b, .IntegerXor, X0, mixed, X0, masked, X2, joined)
    ids.arithmetic[6] = Two(b, .IntegerNegate, X0, negated, X0, mixed)
    ids.arithmetic[7] = Two(b, .IntegerNot, X5, inverted, X5, g)
    ids.arithmetic[8] = Two(b, .Move, X5, inverted, X5, inverted)
    ids.arithmetic[9] = Two(b, .Move, X0, negated, X0, negated)
    unused Return(b, X0, negated)
    End(b, 0)

    ids.stack = Begin(b, "stack")
    sa := Parameter(b, S64, X0); sb := Parameter(b, S32, X1); sc := Parameter(b, U8, X2)
    // Slot ids differ from the spilled registers, so a spill that stored
    // the slot's number as its register fails here.
    byte_slot := Object(b, .Spill, 1, -137, sc, U8)
    word_slot := Object(b, .Spill, 4, -136, sb, S32)
    wide_slot := Object(b, .Spill, 8, -128, sa, S64)
    Enter(b, Blocks(b, 1))
    ids.stack_ops[0] = SpillTo(b, wide_slot, X0, sa)
    ids.stack_ops[1] = SpillTo(b, word_slot, X1, sb)
    ids.stack_ops[2] = SpillTo(b, byte_slot, X2, sc)
    ids.stack_ops[3] = ReloadFrom(b, X0, wide_slot, sa)
    ids.stack_ops[4] = ReloadFrom(b, X1, word_slot, sb)
    ids.stack_ops[5] = ReloadFrom(b, X2, byte_slot, sc)
    unused Return(b, X0, sa)
    End(b, 160)

    unused Begin(b, "memory")
    pointer := Parameter(b, POINTER, X0); byte := Parameter(b, U8, X1); word := Parameter(b, U16, X2)
    loaded := Value(b, S64); loaded_word := Value(b, S32); loaded_half := Value(b, U16); loaded_byte := Value(b, S8)
    Enter(b, Blocks(b, 1))
    ids.memory[0] = Two(b, .Load, X3, loaded, X0, pointer)
    ids.memory[1] = Two(b, .Load, X4, loaded_word, X0, pointer)
    ids.memory[2] = Two(b, .Load, X5, loaded_half, X0, pointer)
    ids.memory[3] = Two(b, .Load, X6, loaded_byte, X0, pointer)
    unused Two(b, .Move, X3, loaded_word, X3, loaded)
    unused Two(b, .Move, X4, loaded, X4, loaded_word)
    ids.memory[4] = Store(b, X0, pointer, X1, byte)
    ids.memory[5] = Store(b, X0, pointer, X2, word)
    ids.memory[6] = Store(b, X0, pointer, X3, loaded_word)
    ids.memory[7] = Store(b, X0, pointer, X4, loaded)
    unused Return(b, X0, pointer)
    End(b, 0)

    ids.branch = Begin(b, "branch")
    x := Parameter(b, U64, X0); y := Parameter(b, U64, X1)
    less := Value(b, BOOL); one := Value(b, S64); two := Value(b, S64); merged := Value(b, S64)
    first := Blocks(b, 4)
    Enter(b, first)
    ids.branch_ops[0] = Compare(b, X0, x, X1, y, .Less)
    ids.branch_ops[1] = SetCondition(b, X2, less, .Less)
    ids.branch_ops[2] = BranchOn(b, X2, less, first + 2, first + 1)
    Enter(b, first + 1)
    unused Constant(b, X0, one, 1)
    unused Two(b, .Move, X0, merged, X0, one)
    ids.branch_ops[3] = Jump(b, first + 2)
    Enter(b, first + 2)
    unused Constant(b, X0, two, 2)
    unused Two(b, .Move, X0, merged, X0, two)
    ids.branch_ops[4] = Jump(b, first + 3)
    Enter(b, first + 3)
    ids.branch_ops[5] = Return(b, X0, merged)
    End(b, 0)

    ids.branch2 = Begin(b, "branch-both")
    flag := Parameter(b, BOOL, X0)
    second := Blocks(b, 3)
    Enter(b, second)
    ids.branch2_ops[0] = BranchOn(b, X0, flag, second + 2, second + 2)
    Enter(b, second + 1)
    ids.branch2_ops[1] = Unreachable(b)
    Enter(b, second + 2)
    ids.branch2_ops[2] = Return(b, -1, -1)
    End(b, 0)

    // When the taken block falls through, a zero value leaves for the other.
    unused Begin(b, "branch-fallthrough")
    falls := Parameter(b, BOOL, X0)
    third := Blocks(b, 3)
    Enter(b, third)
    ids.branch_fallthrough = BranchOn(b, X0, falls, third + 1, third + 2)
    Enter(b, third + 1)
    unused Return(b, -1, -1)
    Enter(b, third + 2)
    unused Return(b, -1, -1)
    End(b, 0)

    ids.loop = Begin(b, "loop")
    limit := Parameter(b, S64, X0)
    count := Value(b, S64); step := Value(b, S64); next := Value(b, S64)
    head := Blocks(b, 4)
    Enter(b, head)
    unused Constant(b, X0, count, 0)
    ids.loop_ops[0] = Jump(b, head + 1)
    Enter(b, head + 1)
    ids.loop_ops[1] = Fuel(b, 1)
    ids.loop_ops[2] = Compare(b, X0, count, X0, count, .Less)
    ids.loop_ops[3] = BranchFlags(b, .Less, head + 2, head + 3)
    Enter(b, head + 2)
    unused Constant(b, X1, step, 1)
    ids.loop_ops[4] = Three(b, .IntegerAdd, X0, next, X0, count, X1, step)
    unused Two(b, .Move, X0, count, X0, next)
    ids.loop_ops[5] = Jump(b, head + 1)
    Enter(b, head + 3)
    unused Return(b, X0, count)
    End(b, 0)

    ids.fuel = Begin(b, "fuel")
    Enter(b, Blocks(b, 1))
    ids.fuel_ops[0] = Fuel(b, 1000)
    ids.fuel_ops[1] = Fuel(b, 0x100000000)
    unused Return(b, -1, -1)
    End(b, 0)

    // A signed W value widens with SXTW, and 64-bit bits move between the
    // banks with FMOV Dd, Xn and FMOV Xd, Dn.
    unused Begin(b, "convert")
    narrow := Parameter(b, S32, X0)
    widened := Value(b, S64); double_bits := Value(b, F64); general_bits := Value(b, S64)
    Enter(b, Blocks(b, 1))
    ids.convert_ops[0] = Two(b, .Convert, X0, widened, X0, narrow)
    ids.convert_ops[1] = Two(b, .Bitcast, 0, double_bits, X0, widened)
    ids.convert_ops[2] = Two(b, .Bitcast, X0, general_bits, 0, double_bits)
    unused Return(b, X0, general_bits)
    End(b, 0)

    unused Begin(b, "divide")
    dividend := Parameter(b, S64, X0); divisor := Parameter(b, S64, X1)
    quotient := Value(b, S64); remainder := Value(b, S64)
    Enter(b, Blocks(b, 1))
    ids.divide[0] = Divide(b, .IntegerDivide, X0, quotient, X0, dividend, X1, divisor)
    unused Two(b, .Move, X0, dividend, X0, quotient)
    ids.divide[1] = Divide(b, .IntegerRemainder, X0, remainder, X0, dividend, X1, divisor)
    unused Return(b, X0, remainder)
    End(b, 0)

    unused Begin(b, "unsigned-divide")
    ua := Parameter(b, U32, X0); unused Parameter(b, U32, X1); uc := Parameter(b, U32, X2)
    modulo := Value(b, U32)
    Enter(b, Blocks(b, 1))
    ids.unsigned_divide[0] = Divide(b, .IntegerRemainder, X0, modulo, X0, ua, X2, uc)
    unused Return(b, X0, modulo)
    End(b, 0)

    unused Begin(b, "shift")
    sh_a := Parameter(b, S32, X0); sh_b := Parameter(b, U64, X1); sh_c := Parameter(b, S32, X2)
    sh_n := Parameter(b, S32, X3)
    arithmetic := Value(b, S32); logical := Value(b, U64); left := Value(b, S32)
    Enter(b, Blocks(b, 1))
    ids.shift[0] = Three(b, .ShiftRight, X0, arithmetic, X0, sh_a, X3, sh_n)
    ids.shift[1] = Three(b, .ShiftRight, X1, logical, X1, sh_b, X3, sh_n)
    ids.shift[2] = Three(b, .ShiftLeft, X2, left, X2, sh_c, X3, sh_n)
    unused Two(b, .Move, X0, arithmetic, X0, arithmetic)
    unused Return(b, X0, arithmetic)
    End(b, 0)

unused Begin(b, "bytes-equal")
be_left := Parameter(b, POINTER, X10); be_left_count := Parameter(b, U64, X11)
be_right := Parameter(b, POINTER, X12); be_right_count := Parameter(b, U64, X13)
    equal := Value(b, S64)
    Enter(b, Blocks(b, 1))
ids.bytes_equal = BytesEqualOp(b, equal, be_left, be_left_count, be_right, be_right_count)
    unused Return(b, X0, equal)
    End(b, 0)

    ids.resize_function = Begin(b, "resize")
    record := Parameter(b, RECORD_POINTER, X10); old_count := Parameter(b, S64, X11)
    new_count := Parameter(b, S64, X12)
    resized := Value(b, RECORD_POINTER)
    Enter(b, Blocks(b, 1))
    ids.resize = ResizeOp(b, resized, record, old_count, new_count)
    unused Return(b, X0, resized)
    End(b, 0)
    b.entry = ids.answer
}

Basics :: () -> bool {
    b: Builder
    defer BuilderFree(*b)
    ids: Ids
    BuildBasics(*b, *ids)
    limits := MachineDefaultLimits()
    verified := Apply(*b, .Verify, null, limits).diagnostic
    if verified.problem != .None { Report("basics allocated verifier", verified); return false }
    measured := Apply(*b, .Measure, null, limits)
    if measured.diagnostic.problem != .None { Report("basics measure", measured.diagnostic); return false }
    owner: A64.MachineA64Owner
    defer A64.MachineA64Free(*owner)
    encoded := Apply(*b, .Encode, *owner, limits).diagnostic
    if encoded.problem != .None { Report("basics encode", encoded); return false }
    image := A64.MachineA64View(*owner)
    if !Check(owner.valid && image.code.count == measured.code_bytes &&
            image.relocations.count == measured.relocations, "measured size equals encoded size") ||
        !Check(Apply(*b, .Validate, null, limits).diagnostic.problem == .None, "valid program validates") ||
        !Check(Accounted(*b, image), "contiguous exact byte accounting") ||
        !Check(image.entry == ids.answer, "image entry") { return false }

    answer := image.functions[ids.answer]
    if !Bytes(image.code, answer.begin, answer.end,
            "fd 7b bf a9 fd 03 00 91 40 05 80 d2 fd 7b c1 a8 c0 03 5f d6", "whole answer function") ||
        !Check(answer.body == answer.begin + 8, "frame setup prologue") { return false }

    expected_arithmetic: [10]string = .["00 00 01 8b", "84 00 05 cb", "84 7c 00 9b", "00 00 04 8a",
        "42 00 03 aa", "00 00 02 ca", "e0 03 00 cb", "e5 03 25 aa", "", ""]
    for index: 0..9 {
        if !Instruction(image, ids.arithmetic[index], expected_arithmetic[index],
                "three-operand arithmetic") { return false }
    }

    stack := image.functions[ids.stack]
    if !Bytes(image.code, stack.begin, stack.body, "fd 7b bf a9 fd 03 00 91 ff 83 02 d1",
            "stack frame prologue") { return false }
    expected_stack: [6]string = .["a0 03 18 f8", "a1 83 17 b8", "a2 73 17 38", "a0 03 58 f8",
        "a1 83 97 b8", "a2 73 57 38 42 1c 00 53"]
    for index: 0..5 {
        if !Instruction(image, ids.stack_ops[index], expected_stack[index], "spill and reload slots") {
            return false
        }
    }
    if !Check(stack.end - stack.begin == 52, "stack function size") { return false }

    expected_memory: [8]string = .["03 00 40 f9", "04 00 80 b9", "05 00 40 79",
        "06 00 80 39", "01 00 00 39", "02 00 00 79", "03 00 00 b9", "04 00 00 f9"]
    for index: 0..7 {
        if !Instruction(image, ids.memory[index], expected_memory[index], "load and store widths") {
            return false
        }
    }

    expected_branch: [6]string = .["1f 00 01 eb", "e2 27 9f 1a", "42 00 00 35", "", "",
        "fd 7b c1 a8 c0 03 5f d6"]
    for index: 0..5 {
        if !Instruction(image, ids.branch_ops[index], expected_branch[index], "branch forms") {
            return false
        }
    }
    branch := image.functions[ids.branch]
    if !Check(branch.end - branch.begin == 36, "branch function size") { return false }
    if !Instruction(image, ids.branch2_ops[0], "c0 00 00 35 05 00 00 14", "two-way value branch") ||
        !Instruction(image, ids.branch2_ops[1], TRAP_UNREACHABLE, "unreachable trap") ||
        !Instruction(image, ids.branch2_ops[2], "fd 7b c1 a8 c0 03 5f d6", "void return") ||
        !Instruction(image, ids.branch_fallthrough, "60 00 00 34", "zero branch to the other block") { return false }

    loop := image.functions[ids.loop]
    fuel_range := image.instructions[ids.loop_ops[1]]
    if !Instruction(image, ids.loop_ops[0], "", "fallthrough into loop") ||
        !Bytes(image.code, fuel_range.begin, fuel_range.end,
            "10 00 80 d2 10 00 a0 f2 10 00 c0 f2 10 00 e0 f2 11 02 40 f9 31 06 00 f1 11 02 00 f9 a2 00 00 54 e0 ff bf 52 80 00 80 72 00 00 00 94 00 00 20 d4",
            "fuel through the counter") ||
        !Instruction(image, ids.loop_ops[2], "1f 00 00 eb", "loop compare") ||
        !Instruction(image, ids.loop_ops[3], "8a 00 00 54", "inverse flags branch") ||
        !Instruction(image, ids.loop_ops[4], "00 00 01 8b", "loop add") ||
        !Instruction(image, ids.loop_ops[5], "f0 ff ff 17", "backward jump") ||
        !Check(loop.end - loop.begin == 88, "loop function size") { return false }
    jump := image.instructions[ids.loop_ops[5]]
    jump_field := Words(image.code, jump.begin)
    jump_delta := cast(s64)(jump_field & 0x3ffffff)
    if jump_delta >= 0x2000000 { jump_delta -= 0x4000000 }
    if !Check(jump.begin + jump_delta * 4 == image.blocks[b.functions[ids.loop].block_begin + 1],
            "backward jump reaches the loop head") { return false }

    if !Instruction(image, ids.fuel_ops[0],
            "10 00 80 d2 10 00 a0 f2 10 00 c0 f2 10 00 e0 f2 11 02 40 f9 31 a2 0f f1 11 02 00 f9 a2 00 00 54 e0 ff bf 52 80 00 80 72 00 00 00 94 00 00 20 d4",
            "fuel imm12") ||
        !Instruction(image, ids.fuel_ops[1],
            "10 00 80 d2 10 00 a0 f2 10 00 c0 f2 10 00 e0 f2 11 02 40 f9 0b 00 80 d2 0b 00 a0 f2 2b 00 c0 f2 31 02 0b eb 11 02 00 f9 a2 00 00 54 e0 ff bf 52 80 00 80 72 00 00 00 94 00 00 20 d4",
            "fuel through scratch") { return false }
    if !Instruction(image, ids.convert_ops[0], "00 7c 40 93", "signed widening") ||
        !Instruction(image, ids.convert_ops[1], "00 00 67 9e", "general bits to double") ||
        !Instruction(image, ids.convert_ops[2], "00 00 66 9e", "double bits to general") { return false }

    if !Instruction(image, ids.divide[0],
            "ff 03 01 eb a1 00 00 54 e0 ff bf 52 40 00 80 72 00 00 00 94 00 00 20 d4 00 0c c1 9a",
            "signed divide") ||
        !Instruction(image, ids.divide[1],
            "ff 03 01 eb a1 00 00 54 e0 ff bf 52 40 00 80 72 00 00 00 94 00 00 20 d4 0f 0c c1 9a e0 81 01 9b",
            "signed remainder") ||
        !Instruction(image, ids.unsigned_divide[0],
            "ff 03 02 6b a1 00 00 54 e0 ff bf 52 40 00 80 72 00 00 00 94 00 00 20 d4 0f 08 c2 1a e0 81 02 1b",
            "unsigned remainder") { return false }
    expected_shift: [3]string = .["7f 80 00 71 a3 00 00 54 e0 ff bf 52 60 00 80 72 00 00 00 94 00 00 20 d4 00 28 c3 1a",
        "7f 00 01 71 a3 00 00 54 e0 ff bf 52 60 00 80 72 00 00 00 94 00 00 20 d4 21 24 c3 9a",
        "7f 80 00 71 a3 00 00 54 e0 ff bf 52 60 00 80 72 00 00 00 94 00 00 20 d4 42 20 c3 1a"]
    for index: 0..2 {
        if !Instruction(image, ids.shift[index], expected_shift[index], "guarded shifts") { return false }
    }
    if !Instruction(image, ids.bytes_equal,
            "7f 01 0d eb 81 01 00 54 10 00 80 d2 1f 02 0b eb e2 00 00 54 4e 69 70 38 8f 69 70 38 df 01 0f 6b a1 00 00 54 10 06 00 91 f9 ff ff 17 20 00 80 52 02 00 00 14 e0 03 1f 2a",
            "bytes equal form") ||
        !Instruction(image, ids.resize,
            "e1 0b bf a9 e3 13 bf a9 e5 1b bf a9 e7 23 bf a9 ea 0f 1f f8 ec 0f 1f f8 11 00 80 d2 11 00 a0 f2 11 00 c0 f2 11 00 e0 f2 8a 05 00 b4 50 fd 6c d3 2d 0a 40 f9 1f 02 0d eb a3 00 00 54 c0 ff bf 52 e0 ff 9f 72 00 00 00 94 00 00 20 d4 09 ea 7b d3 2d 16 40 f9 29 01 0d 8b 4d ad 60 d3 2e 21 40 79 bf 01 0e eb a0 00 00 54 c0 ff bf 52 e0 ff 9f 72 00 00 00 94 00 00 20 d4 30 25 40 79 10 02 40 d3 1f 02 00 f1 a1 00 00 54 c0 ff bf 52 e0 ff 9f 72 00 00 00 94 00 00 20 d4 30 25 40 79 10 0a 42 d3 1f 02 00 f1 a1 00 00 54 c0 ff bf 52 e0 ff 9f 72 00 00 00 94 00 00 20 d4 4d 7d 40 d3 bf 01 00 f1 a0 00 00 54 c0 ff bf 52 e0 ff 9f 72 00 00 00 94 00 00 20 d4 2a 01 40 f9 40 01 1f aa 61 01 1f aa 82 01 1f aa 03 02 80 d2 00 00 00 94 ec 07 41 f8 ed 07 41 f8 11 00 80 d2 11 00 a0 f2 11 00 c0 f2 11 00 e0 f2 0e 02 80 d2 8e 7d 0e 9b 40 00 00 b5 0c 06 00 b5 ed 01 00 b4 aa fd 6c d3 49 e9 7b d3 30 16 40 f9 29 01 10 8b 2b 21 40 79 6b 05 00 91 2b 21 00 79 3f 25 00 79 10 00 82 d2 7f 01 10 eb 82 00 00 54 30 02 40 f9 30 15 00 b9 2a 02 00 f9 00 04 00 b4 0f 00 1f aa 2a 02 40 f9 ea 00 00 b4 40 e9 7b d3 30 16 40 f9 00 00 10 8b 10 14 40 b9 30 02 00 f9 04 00 00 14 2a 06 40 f9 50 05 00 91 30 06 00 f9 30 0a 40 f9 5f 01 10 eb a3 00 00 54 e0 ff bf 52 e0 00 80 72 00 00 00 94 00 00 20 d4 40 e9 7b d3 30 16 40 f9 00 00 10 8b 0f 00 00 f9 0e 04 00 f9 f0 00 80 52 10 24 00 79 1f 14 00 b9 10 20 40 79 10 7e 60 d3 40 4d 54 d3 00 00 10 aa e7 23 c1 a8 e5 1b c1 a8 e3 13 c1 a8 e1 0b c1 a8",
            "runtime resize form") { return false }

    // Relocations: every inline trap calls the handler and every fuel check
    // names the counter, at exact word offsets and halfword addends.
    fuel_counters: s64 = 0
    traps: s64 = 0
    resize_relocations: s64 = 0
    stack_limits: s64 = 0
    pointer_runtimes: s64 = 0
    for relocation: image.relocations {
        if relocation.kind == .FuelCounter {
            fuel_counters += 1
            if !Check(relocation.addend == (fuel_counters - 1) % 4 * 2, "fuel counter halfword addend") {
                return false
            }
        }
        if relocation.kind == .TrapHandler {
            traps += 1
            if !Check(relocation.addend == -4 && (Words(image.code, relocation.offset) >> 26) == 0x25,
                    "trap handler bl field") { return false }
        }
        // Stack limits and the pointer header load x17 through four
        // MOVZ/MOVK halves; the addend names the half times two.
        if relocation.kind == .StackLimit || relocation.kind == .PointerRuntime {
            if relocation.kind == .StackLimit { stack_limits += 1 } else { pointer_runtimes += 1 }
            half := ifx relocation.kind == .StackLimit then stack_limits - 1 else pointer_runtimes - 1
            word := Words(image.code, relocation.offset)
            opcode := cast(u32)0x794 + cast(u32)(half % 4)
            if half % 4 == 0 { opcode = 0x694 }
            if !Check(relocation.addend == half % 4 * 2 && (word & 0x1f) == 17 && (word >> 21) == opcode,
                    "pointer header and stack limit halves") { return false }
        }
        if relocation.kind == .RuntimeResize {
            resize_relocations += 1
            if !Check(relocation.addend == -4 && (Words(image.code, relocation.offset) >> 26) == 0x25,
                    "runtime resize bl field") { return false }
        }
    }
    if !Check(fuel_counters == 12 && traps == 17 && resize_relocations == 1 && stack_limits == 4 &&
            pointer_runtimes == 8, "relocation counts") {
        print("fuel % traps % resize % stack % pointer %\n", fuel_counters, traps, resize_relocations,
            stack_limits, pointer_runtimes)
        return false
    }
    if !Check(image.relocations[0].kind == .TrapHandler && image.relocations[0].instruction == ids.branch2_ops[1],
            "unreachable trap relocation first") ||
        !Check(image.relocations[1].offset == fuel_range.begin && image.relocations[1].addend == 0 &&
            image.relocations[4].offset == fuel_range.begin + 12 && image.relocations[4].addend == 6 &&
            image.relocations[5].kind == .TrapHandler && image.relocations[5].offset == fuel_range.begin + 40 &&
            image.relocations[5].instruction == ids.loop_ops[1], "loop fuel relocation fields") { return false }
    found := false
    for index: cast(s64)0..image.relocations.count - 1 {
        relocation := image.relocations[index]
        if relocation.kind == .TrapHandler && relocation.instruction == ids.fuel_ops[0] {
            found = Check(relocation.offset == image.instructions[ids.fuel_ops[0]].begin + 40,
                "imm12 fuel trap field")
            if !found { return false }
        }
        if relocation.kind == .TrapHandler && relocation.instruction == ids.fuel_ops[1] {
            found = Check(relocation.offset == image.instructions[ids.fuel_ops[1]].begin + 52,
                "register fuel trap field")
            if !found { return false }
        }
        if relocation.kind == .RuntimeResize && relocation.instruction == ids.resize {
            found = Check(relocation.offset == image.instructions[ids.resize].begin + 232,
                "resize relocation field")
            if !found { return false }
        }
    }
    if !Check(found, "fuel and resize relocation fields") { return false }

    second: A64.MachineA64Owner
    defer A64.MachineA64Free(*second)
    if !Check(Apply(*b, .Encode, *second, limits).diagnostic.problem == .None &&
        Fingerprint(A64.MachineA64View(*second)) == Fingerprint(image), "deterministic encoding") {
        return false
    }
    // The resize form adds its checked-token path and the slot update, and
    // its function's prologue checks the stack limit: 48 bytes, 4 halves
    // and one trap.
    resize_begin := image.functions[ids.resize_function].begin
    if !Bytes(image.code, resize_begin, image.instructions[ids.resize].begin, "fd 7b bf a9 fd 03 00 91 11 00 80 d2 11 00 a0 f2 11 00 c0 f2 11 00 e0 f2 31 02 40 f9 f0 03 00 91 1f 02 11 eb a2 00 00 54 e0 ff bf 52 c0 00 80 72 00 00 00 94 00 00 20 d4", "resize prologue checks the stack limit") { return false }
    if !Bytes(image.code, image.instructions[ids.resize].end, image.functions[ids.resize_function].end, "fd 7b c1 a8 c0 03 5f d6", "resize epilogue") { return false }
    if !Check(measured.code_bytes == 1352 && measured.relocations == 42, "measured image totals") {
        print("measured % bytes, % relocations, image % bytes\n", measured.code_bytes, measured.relocations, image.code.count)
        return false
    }
    return true
}

// A record result's address passes in x8 and is computed after the
// arguments, so an argument in x0 survives, and the callee stores x8.
RecordCalls :: () -> bool {
    b: Builder
    defer BuilderFree(*b)
    Setup(*b)
    maker := Begin(*b, "maker")
    made_function := b.functions[maker]
    made_function.result_type = RECORD
    b.functions[maker] = made_function
    unused Parameter(*b, S64, X0)
    made := Value(*b, RECORD)
    unused Object(*b, .ResultAddress, 8, -8, -1, 0)
    made_slot := Object(*b, .Value, 16, -32, made, RECORD)
    made_value := b.virtuals[made]
    made_value.stack_object = made_slot
    b.virtuals[made] = made_value
    Enter(*b, Blocks(*b, 1))
    unused Fuel(*b, 1)
    returned := Open(*b, .Return)
    unused Slot(*b, made_slot, .Use, made)
    unused Close(*b, returned)
    End(*b, 32)

    caller := Begin(*b, "caller")
    argument := Value(*b, S64)
    got := Value(*b, RECORD)
    got_slot := Object(*b, .Value, 16, -16, got, RECORD)
    got_value := b.virtuals[got]
    got_value.stack_object = got_slot
    b.virtuals[got] = got_value
    zero := Value(*b, S64)
    Enter(*b, Blocks(*b, 1))
    unused Constant(*b, X0, argument, 5)
    instruction := Open(*b, .CallDirect)
    instruction.call = cast(s32)b.calls.count
    result_operand := Slot(*b, got_slot, .Define, got)
    target := Symbol(*b, .Function, maker)
    argument_begin := cast(s32)b.operands.count
    unused Physical(*b, X0, .Use, argument)
    call := Close(*b, instruction)
    unused VecPush(b.calls, .{instruction = call, calling = .Internal, argument_begin = argument_begin,
        argument_count = 1, result_operand = result_operand, stack_argument_bytes = 0,
        clobber_general = 0x3ffff, clobber_float = 0xffff00ff, clobber_vector = 0xffffffff})
    unused VecPush(b.relocations, .{instruction = call, operand = target, kind = .FunctionCall, symbol = maker})
    unused Constant(*b, X0, zero, 0)
    unused Return(*b, X0, zero)
    End(*b, 16)
    b.entry = caller

    limits := MachineDefaultLimits()
    verified := Apply(*b, .Verify, null, limits).diagnostic
    if verified.problem != .None { Report("record calls allocated verifier", verified); return false }
    owner: A64.MachineA64Owner
    defer A64.MachineA64Free(*owner)
    encoded := Apply(*b, .Encode, *owner, limits).diagnostic
    if encoded.problem != .None { Report("record calls encode", encoded); return false }
    image := A64.MachineA64View(*owner)
    range := image.instructions[call]
    if !Check(range.end - range.begin >= 8, "record call computes its result address") { return false }
    last := Words(image.code, range.end - 4)
    before := Words(image.code, range.end - 8)
    writes_x0 := false
    at := range.begin
    while at < range.end - 4 {
        if (Words(image.code, at) & cast(u32)31) == 0 { writes_x0 = true }
        at += 4
    }
    stores_x8 := false
    function := image.functions[maker]
    at = function.begin
    while at < function.end {
        word := Words(image.code, at)
        store := (word & cast(u32)0xffc00000) == cast(u32)0xf9000000 ||
            (word & cast(u32)0xffe00c00) == cast(u32)0xf8000000
        if store && (word & cast(u32)31) == 8 { stores_x8 = true }
        at += 4
    }
    return Check((last & cast(u32)0xfc000000) == cast(u32)0x94000000, "record call ends in bl") &&
        Check((before & cast(u32)31) == 8, "record call computes x8 just before bl") &&
        Check(!writes_x0, "record call keeps its x0 argument") &&
        Check(stores_x8, "record callee stores its x8 result address")
}

Calls :: () -> bool {
    b: Builder
    defer BuilderFree(*b)
    Setup(*b)
    callee := Begin(*b, "callee")
    ca := Parameter(*b, S64, X0)
    Enter(*b, Blocks(*b, 1))
    unused Fuel(*b, 1)
    unused Two(*b, .Move, X0, ca, X0, ca)
    unused Return(*b, X0, ca)
    End(*b, 0)

    caller := Begin(*b, "caller")
    values: [8]s32
    types: [8]s32 = .[S64, S64, S64, S64, FUNCTION, S64, S64, POINTER]
    for index: 0..7 { values[index] = Value(*b, types[index]) }
    Enter(*b, Blocks(*b, 1))
    unused Constant(*b, X0, values[0], 5)
    backward := CallTo(*b, callee, -1, -1, values[1], X0, values[0])
    unused Constant(*b, X0, values[2], 6)
    forward := CallTo(*b, callee + 2, -1, -1, values[3], X0, values[2])
    address := AddressOf(*b, .FunctionAddress, X8, values[4], callee + 2, 0)
    unused Constant(*b, X0, values[5], 7)
    indirect := CallTo(*b, -1, X8, values[4], values[6], X0, values[5])
    global := AddressOf(*b, .GlobalAddress, X9, values[7], 0, 0)
    unused Return(*b, X0, values[6])
    End(*b, 0)

    later := Begin(*b, "later")
    la := Parameter(*b, S64, X0)
    Enter(*b, Blocks(*b, 1))
    unused Fuel(*b, 1)
    unused Two(*b, .Move, X0, la, X0, la)
    unused Return(*b, X0, la)
    End(*b, 0)

    failing := Begin(*b, "failing")
    Enter(*b, Blocks(*b, 1))
    explicit := Trap(*b, 9)
    End(*b, 0)
    b.entry = caller

    limits := MachineDefaultLimits()
    verified := Apply(*b, .Verify, null, limits).diagnostic
    if verified.problem != .None { Report("calls allocated verifier", verified); return false }
    owner: A64.MachineA64Owner
    defer A64.MachineA64Free(*owner)
    encoded := Apply(*b, .Encode, *owner, limits).diagnostic
    if encoded.problem != .None { Report("calls encode", encoded); return false }
    image := A64.MachineA64View(*owner)
    measured := Apply(*b, .Measure, null, limits)
    // Only the caller calls, so only its prologue checks the stack limit:
    // x17 = [limit]; x16 = sp; cmp; b.hs; then the stack trap.
    if !Check(measured.code_bytes == 272 && image.code.count == 272 && measured.relocations == 24,
            "call image size") ||
        !Check(Accounted(*b, image), "call image accounting") ||
        !Check(image.functions[caller].begin == 64 && image.functions[later].begin == 184 &&
            image.functions[failing].begin == 248, "function offsets") ||
        !Bytes(image.code, image.functions[caller].begin + 8, image.functions[caller].begin + 56,
            "11 00 80 d2 11 00 a0 f2 11 00 c0 f2 11 00 e0 f2 31 02 40 f9 f0 03 00 91 1f 02 11 eb a2 00 00 54 e0 ff bf 52 c0 00 80 72 00 00 00 94 00 00 20 d4",
            "caller stack limit check") ||
        !Instruction(image, backward, "e1 ff ff 97", "backward direct call") ||
        !Instruction(image, forward, "0d 00 00 94", "forward direct call") ||
        !Instruction(image, address, "08 00 80 d2 08 00 a0 f2 08 00 c0 f2 08 00 e0 f2",
            "function address") ||
        !Instruction(image, indirect, "00 01 3f d6", "indirect call") ||
        !Instruction(image, global, "09 00 80 d2 09 00 a0 f2 09 00 c0 f2 09 00 e0 f2",
            "relocated global address") ||
        !Instruction(image, explicit, "00 00 a0 52 20 01 80 72 00 00 00 94 00 00 20 d4",
            "explicit trap") { return false }
    call_field := Words(image.code, image.instructions[forward].begin)
    call_delta := cast(s64)(call_field & 0x3ffffff)
    if call_delta >= 0x2000000 { call_delta -= 0x4000000 }
    if !Check(image.instructions[forward].begin + call_delta * 4 == image.functions[later].begin,
            "forward call reaches callee") { return false }
    kinds: [24]A64.MachineA64RelocationKind = .[.FuelCounter, .FuelCounter, .FuelCounter, .FuelCounter,
        .TrapHandler, .StackLimit, .StackLimit, .StackLimit, .StackLimit, .TrapHandler, .FunctionAddress, .FunctionAddress, .FunctionAddress, .FunctionAddress,
        .GlobalAddress, .GlobalAddress, .GlobalAddress, .GlobalAddress,
        .FuelCounter, .FuelCounter, .FuelCounter, .FuelCounter, .TrapHandler, .TrapHandler]
    offsets: [24]s64 = .[8, 12, 16, 20, 48, 72, 76, 80, 84, 112, 136, 140, 144, 148, 160, 164, 168, 172,
        192, 196, 200, 204, 232, 264]
    addends: [24]s64 = .[0, 2, 4, 6, -4, 0, 2, 4, 6, -4, 0, 2, 4, 6, 0, 2, 4, 6, 0, 2, 4, 6, -4, -4]
    for index: 0..23 {
        relocation := image.relocations[index]
        if !Check(relocation.kind == kinds[index] && relocation.offset == offsets[index] &&
            relocation.addend == addends[index], "call image relocation") {
            print("relocation %: kind % offset % addend %\n", index, cast(s32)relocation.kind,
                relocation.offset, relocation.addend)
            return false
        }
    }
    return Check(image.entry == caller && image.relocations[10].symbol == 2 &&
        image.relocations[10].instruction == address && image.relocations[14].symbol == 0 &&
        image.relocations[14].instruction == global, "call entry and symbol relocations") &&
        Check(image.relocations[5].instruction == MachineNoId && image.relocations[9].instruction == MachineNoId,
            "prologue relocations name no instruction")
}

NegativeKind :: enum s32 {
    CallRegister; MissingRelocation; DuplicateRelocation; GlobalAddendHigh; GlobalAddendLow
    ReservedTrap; FuelFlags; DynamicFrame; HugeFrame; Opcode; Stage; Target
}

// Defects MachineVerifyAllocated itself rejects, so no encoder pass runs:
// missing or duplicate stable call references, a call argument outside its
// ABI register, relocation addends outside i32, the stage and the target.
Early :: (kind: NegativeKind) -> bool {
    return kind == .MissingRelocation || kind == .DuplicateRelocation ||
        kind == .CallRegister || kind == .GlobalAddendHigh || kind == .GlobalAddendLow ||
        kind == .Stage || kind == .Target
}

// A small allocated program with one defect. Early kinds fail the allocated
// verifier; every other kind passes it and the encoder must reject it.
BuildNegative :: (b: *Builder, kind: NegativeKind) -> s32 {
    Setup(b)
    if kind == .CallRegister || kind == .MissingRelocation || kind == .DuplicateRelocation {
        callee := Begin(b, "callee")
        Enter(b, Blocks(b, 1))
        unused Fuel(b, 1)
        unused Return(b, -1, -1)
        End(b, 0)
        unused Begin(b, "caller")
        register: s32 = ifx kind == .CallRegister then cast(s32)X6 else X0
        argument := Parameter(b, S64, register)
        Enter(b, Blocks(b, 1))
        id := CallTo(b, callee, -1, -1, -1, register, argument,
            relocated = kind != .MissingRelocation)
        if kind == .DuplicateRelocation { unused VecPush(b.relocations, b.relocations[b.relocations.count - 1]) }
        unused Return(b, -1, -1)
        End(b, 0)
        return id
    }
    unused Begin(b, "negative")
    first := Parameter(b, S64, X0)
    second := Parameter(b, S64, X1)
    result := Value(b, S64)
    Enter(b, Blocks(b, 1))
    id: s32 = -1
    if kind == .Opcode {
        id = Three(b, .FloatAdd, X0, result, X0, first, X1, second)
    } else if kind == .ReservedTrap {
        id = Trap(b, A64.MachineA64TrapFuel)
        End(b, 0)
        return id
    } else if kind == .FuelFlags {
        unused Fuel(b, 1)
        id = SetCondition(b, X0, result, .Equal)
    } else if kind == .DynamicFrame || kind == .HugeFrame {
        id = Constant(b, X0, result, 1)
    } else if kind == .GlobalAddendHigh || kind == .GlobalAddendLow {
        id = AddressOf(b, .GlobalAddress, X0, result, 0,
            ifx kind == .GlobalAddendHigh then cast(s64)2147483648 else -2147483649)
    }
    unused Return(b, X0, result)
    End(b, ifx kind == .HugeFrame then cast(s64)2147483648 else 0)
    if kind == .DynamicFrame {
        frame := b.frames[0]
        frame.dynamic_allocation = true
        b.frames[0] = frame
        instruction := b.instructions[id]
        instruction.opcode = .Allocate
        b.instructions[id] = instruction
    }
    if kind == .Stage { b.stage = .Virtual }
    if kind == .Target { b.target = Target.TargetDescribe(.Wasm32, .Browser).target }
    return id
}

Negative :: (kept: *A64.MachineA64Owner, kind: NegativeKind, problem: MachineProblem, at_instruction: bool,
    label: string) -> bool {
    b: Builder
    defer BuilderFree(*b)
    id := BuildNegative(*b, kind)
    limits := MachineDefaultLimits()
    before := Fingerprint(A64.MachineA64View(kept))
    count := A64.MachineA64View(kept).code.count
    verified := Apply(*b, .Verify, null, limits).diagnostic
    if Early(kind) {
        if verified.problem == problem && (!at_instruction || verified.instruction == id) { return true }
        Report(label, verified)
        return Check(false, label)
    }
    if verified.problem != .None { Report(label, verified); return Check(false, label) }
    validated := Apply(*b, .Validate, null, limits).diagnostic
    measured := Apply(*b, .Measure, null, limits)
    encoded := Apply(*b, .Encode, kept, limits).diagnostic
    if validated.problem != problem || measured.diagnostic.problem != problem || encoded.problem != problem ||
        at_instruction && (validated.instruction != id || encoded.instruction != id) {
        Report(label, validated)
        return Check(false, label)
    }
    return Check(kept.valid && A64.MachineA64View(kept).code.count == count &&
        Fingerprint(A64.MachineA64View(kept)) == before, "rejected program leaves the output unchanged")
}

Negatives :: () -> bool {
    b: Builder
    defer BuilderFree(*b)
    ids: Ids
    BuildBasics(*b, *ids)
    limits := MachineDefaultLimits()
    kept: A64.MachineA64Owner
    defer A64.MachineA64Free(*kept)
    if !Check(Apply(*b, .Encode, *kept, limits).diagnostic.problem == .None, "kept image encodes") {
        return false
    }
    if !Negative(*kept, .CallRegister, .Constraint, true, "call argument outside its ABI register") ||
        !Negative(*kept, .MissingRelocation, .Call, true, "direct call without relocation") ||
        !Negative(*kept, .DuplicateRelocation, .Call, true, "two relocations for one call") ||
        !Negative(*kept, .GlobalAddendHigh, .Relocation, true, "global address addend above i32") ||
        !Negative(*kept, .GlobalAddendLow, .Relocation, true, "global address addend below i32") ||
        !Negative(*kept, .ReservedTrap, .Unsupported, true, "reserved trap code") ||
        !Negative(*kept, .FuelFlags, .Flags, true, "condition read from fuel flags") ||
        !Negative(*kept, .DynamicFrame, .Frame, false, "dynamic frame allocation") ||
        !Negative(*kept, .HugeFrame, .Frame, false, "frame beyond imm32") ||
        !Negative(*kept, .Opcode, .Unsupported, true, "unsupported opcode") ||
        !Negative(*kept, .Stage, .Stage, false, "virtual stage") ||
        !Negative(*kept, .Target, .UnsupportedTarget, false, "unsupported target") { return false }

    // Limits: a work budget too small for the program must leave the kept
    // output untouched, and encoding without an owner reports the owner.
    small := limits
    small.work = 10
    before := Fingerprint(A64.MachineA64View(*kept))
    if !Check(Apply(*b, .Encode, *kept, small).diagnostic.problem == .Limit &&
        Fingerprint(A64.MachineA64View(*kept)) == before, "work limit leaves the output unchanged") {
        return false
    }
    if !Check(Apply(*b, .Encode, null, limits).diagnostic.problem == .Owner, "missing owner") { return false }

    A64.MachineA64Free(*kept)
    A64.MachineA64Free(*kept)
    view := A64.MachineA64View(*kept)
    return Check(!kept.valid && view.code.count == 0 && view.entry == -1, "repeated cleanup")
}

main :: () -> s32 {
    if !Basics() || !Calls() || !RecordCalls() || !Negatives() { return 1 }
    print("aarch64 encoder: exact words, three-operand forms, branch fields, fixed ABI forms, fuel, traps, relocation fields, pre-encoding rejection of invalid programs, no-output diagnostics and ownership local tests passed\n")
    return 0
}
