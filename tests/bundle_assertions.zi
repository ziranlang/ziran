// Independent byte-level assertions and corruptions of actual compiler output.
#import "native_test"
#import "check_support"
#import "std/byte_text_linux"
#import "std/text_tools"
using Vectors :: #import "std/vec"

BundleTestU32 :: (test: *NativeTest, data: string, at: s64) -> u32 {
    if !NativeAssert(test, at >= 0 && at <= data.count && data.count - at >= 4, "bundle field leaves its input") { return 0 }
    value: u32
    for index: cast(s64)0..3 { value |= cast(u32)data[at + index] << cast(u32)(index * 8) }
    return value
}

BundleTestReplace :: (test: *NativeTest, path: string, data: string, at: s64, count: s64, replacement: string) -> bool {
    if !NativeAssert(test, at >= 0 && count >= 0 && at <= data.count && count <= data.count - at, "bundle mutation leaves its input") { return false }
    parts := string.[data[:at], replacement, data[at + count:]]
    return NativeWrite(test, CheckPath(test.work, path), TextJoin(parts[:], ""))
}

// Revision 28 keeps the capability count in its manifest, section kind 1.
BundleTestManifestCapabilities :: (test: *NativeTest, data: string) -> u32 {
    sections := BundleTestU32(test, data, 32)
    for index: cast(s64)0..cast(s64)sections - 1 {
        record := 64 + index * 32
        if BundleTestU32(test, data, record) == 1 {
            return BundleTestU32(test, data, cast(s64)BundleTestU32(test, data, record + 8) + 12)
        }
    }
    unused NativeAssert(test, false, "executable bundle has no manifest")
    return 0
}

BundleTestCapabilities :: (test: *NativeTest, mutate: bool) -> bool {
    data := NativeRead(test, CheckPath(test.work, "source.zx"))
    executable := data.count >= 8 && data[:8] == "ZX\x00\x00\x1c\x00\x00\x00"
    if !NativeAssert(test, executable || data.count >= 8 && data[:8] == "ZX\x00\x00\x1a\x00\x00\x00", "host bundle header differs") { return false }
    if mutate {
        at := TextFind(data, "AddTenHost")
        if !NativeAssert(test, at >= 0, "bundle is missing the capability being corrupted") { return false }
        return BundleTestReplace(test, "tampered.zx", data, at, 1, "X")
    }
    count: u32
    if executable { count = BundleTestManifestCapabilities(test, data) }
    else {
        at: s64 = 8
        for index: 0..1 {
            length := BundleTestU32(test, data, at); at += 4
            if !NativeAssert(test, !test.failed && cast(u64)length <= cast(u64)(data.count - at), "bundle entry string leaves its input") { return false }
            at += cast(s64)length
        }
        count = BundleTestU32(test, data, at)
    }
    return NativeAssert(test, !test.failed && count == 7 && !TextContains(data, "UnusedHost"), "bundle capability closure includes unused imports or omits a reachable import")
}

BundleTestAssets :: (test: *NativeTest) -> bool {
    data := NativeRead(test, CheckPath(test.work, "source.zx")); path := "assets/a.bin"; at := TextFind(data, path)
    if !NativeAssert(test, at >= 8, "bundle asset path is missing") { return false }
    names := string.["traversal", "absolute", "backslash", "nul"]
    values := string.["../bad/a.bin", "/ssets/a.bin", "assets\\a.bin", "assets\x00a.bin"]
    for index: cast(s64)0..names.count - 1 {
        if !NativeAssert(test, values[index].count == path.count, "asset corruption must preserve field length") ||
            !BundleTestReplace(test, CheckConcat(names[index], ".zx"), data, at, path.count, values[index]) { return false }
    }
    if !NativeWrite(test, CheckPath(test.work, "truncated.zx"), data[:data.count - 1]) { return false }
    maximum: [4]u8 = .[255, 255, 255, 255]
    if !BundleTestReplace(test, "oversized.zx", data, at - 8, 4, TextFromBytes(maximum[:])) { return false }
    nested := "assets/sub/z.bin"; nested_at := TextFind(data, nested)
    if !NativeAssert(test, nested_at >= 0, "nested asset is missing") { return false }
    return BundleTestReplace(test, "unsorted.zx", data, nested_at, nested.count, "assets/aaa/z.bin")
}

BundleTestLibraries :: (test: *NativeTest) -> bool {
    names := string.["common", "thin", "standalone"]
    for name: names {
        data := NativeRead(test, CheckPath(test.work, CheckConcat(name, ".zx")))
        if !NativeAssert(test, TextContains(data, "LIBRARY_NATIVE_FN") == (name != "thin") && !TextContains(data, "LIBRARY_NATIVE_BLOCK"),
            CheckConcat("bundle lost procedure assembly or retained a local assembly block: ", name)) { return false }
    }
    return !test.failed
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "bundle-assertions-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    if !NativeAssert(*test, argc == 4, "pass a bundle assertion mode") { return 1 }
    mode := TextFromCString(argv[3]); valid := false
    if mode == "capabilities" { valid = BundleTestCapabilities(*test, false) }
    else if mode == "tamper-capabilities" { valid = BundleTestCapabilities(*test, true) }
    else if mode == "assets" { valid = BundleTestAssets(*test) }
    else if mode == "libraries" { valid = BundleTestLibraries(*test) }
    return ifx valid && !test.failed then 0 else 1
}
