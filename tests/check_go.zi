// Go's file-list mode ignores build constraints. Consult the real Go tool for
// generated tagged companions, then forward the original command unchanged
// apart from files that Go itself marks ignored.
#import "check_support"
#import "std/file"
#import "std/file_tree_linux"
#import "std/text_tools"
#import "std/byte_text_linux"
#import "std/process_run_linux"
#import "std/json_document"
using Vectors :: #import "std/vec"

CheckGoCandidate :: struct { argument: string; path: string; directory: string }

CheckGo :: (executable: string, arguments: []string) -> s32 {
    candidates: Vec(CheckGoCandidate)
    flags: Vec(string)
    ignored: Vec(string)
    if arguments.count > 0 && (arguments[0] == "run" || arguments[0] == "build" || arguments[0] == "test") {
        skip := false
        for index: cast(s64)1..arguments.count - 1 {
            argument := arguments[index]
            if skip { skip = false; continue }
            if argument == "--" { break }
            takes_value := argument == "-o" || argument == "-C" || argument == "-gcflags" ||
                argument == "-asmflags" || argument == "-ldflags" || argument == "-tags" ||
                argument == "-modfile" || argument == "-pkgdir" || argument == "-overlay"
            if takes_value {
                if argument == "-tags" && index + 1 < arguments.count {
                    VecPush(flags, argument); VecPush(flags, arguments[index + 1])
                }
                skip = true
                continue
            }
            if TextHasPrefix(argument, "-tags=") { VecPush(flags, argument); continue }
            if !TextHasSuffix(argument, ".go") || !IsFile(argument) { continue }
            file := OpenRead(argument)
            if !file.valid { continue }
            bytes: [4096]u8
            count := ReadAt(file, bytes[:], 0)
            CloseFile(file)
            if count <= 0 { continue }
            generated := false
            tagged := false
            line_count: s64 = 0
            lines := TextLines(TextFromBytes(bytes[:count]))
            for line: lines {
                if line_count >= 8 { break }
                generated = generated || TextContains(line, "Code generated by zi2go")
                tagged = tagged || TextHasPrefix(line, "//go:build ")
                line_count += 1
            }
            if generated && tagged {
                path := TextDetach(ResolvePath(argument))
                VecPush(candidates, CheckGoCandidate.{argument, path, TextDetach(TextCopy(PathParent(path)))})
            }
        }
        directories: Vec(string)
        for candidate: candidates {
            seen := false
            for directory: directories { if directory == candidate.directory { seen = true } }
            if !seen { VecPush(directories, candidate.directory) }
        }
        for directory: directories {
            command: Vec(string)
            VecPush(command, executable); VecPush(command, "list"); VecPush(command, "-e"); VecPush(command, "-json")
            for flag: flags { VecPush(command, flag) }
            VecPush(command, ".")
            output, code := CheckCapture(command[:], directory)
            document: JsonDocument
            if code != 0 || !JsonRead(*document, output) { continue }
            files := JsonMember(*document, document.root, "IgnoredGoFiles")
            for index: cast(s32)0..JsonCount(*document, files) - 1 {
                VecPush(ignored, CheckPath(directory, JsonString(*document, JsonElement(*document, files, index))))
            }
        }
    }
    command: Vec(string)
    VecPush(command, executable)
    for argument: arguments {
        omit := false
        for candidate: candidates {
            if candidate.argument == argument {
                for path: ignored { if path == candidate.path { omit = true } }
            }
        }
        if !omit { VecPush(command, argument) }
    }
    options: ProcessOptions = .{.arguments = command[:]}
    run: ProcessRun
    if !RunProcess(options, *run) { return 127 }
    return run.code
}
