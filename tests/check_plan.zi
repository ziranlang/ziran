FindCheckProgram :: (name: string) -> CheckProgram {
    for check: check_programs[:] {
        if check.name == name { return check }
    }
    return .{}
}

CheckArguments :: (name: string, bin: string, repo: string) -> Vec(string) {
    result: Vec(string)
    tests := CheckPath(repo, "tests")
    ziran := CheckPath(bin, "ziran")
    check := FindCheckProgram(name)
    if check.name != "" {
        prefix := string.[ziran, "run", "--target=c", "--root", tests]
        for argument: prefix { VecPush(result, argument) }
        if check.module_path != "" {
            VecPush(result, "--module-path")
            VecPush(result, CheckPath(repo, check.module_path))
        }
        VecPush(result, CheckPath(tests, ifx check.source == "" then check.name else check.source))
        if !check.no_compiler_argument {
            VecPush(result, "--")
            VecPush(result, ziran)
        }
        return result
    }
    if name == "check_runner" {
        VecPush(result, CheckPath(bin, "check-runner"))
        VecPush(result, "--self-test")
        return result
    }
    if name == "bundle-link-test" {
        VecPush(result, CheckPath(bin, name))
        return result
    }
    VecPush(result, "sh")
    VecPush(result, CheckPath(tests, name))
    VecPush(result, CheckPath(bin, "ziran"))
    extra := ""
    if name == "host_capability.sh" { extra = "host-capability-test" }
    if name == "host_slices.sh" { extra = "slice-host-test" }
    if name == "host_arrays.sh" { extra = "array-host-test" }
    if name == "portable_host_records.sh" { extra = "record-host-test" }
    if name == "record_fields_by_name.sh" { extra = "record-fields-by-name-test" }
    if name == "process.sh" { extra = "process-host-test" }
    if name == "native_wx.sh" { extra = "native-wx-test" }
    if name == "native_load.sh" { extra = "native-load-test" }
    if extra != "" { VecPush(result, CheckPath(bin, extra)) }
    return result
}

DiscoverChecks :: (repo: string, bin: string, filter: string) -> Vec(CheckCase) {
    checks: Vec(CheckCase)
    tests := CheckPath(repo, "tests")
    for check: check_programs[:] {
        if TextContains(check.name, filter) { VecPush(checks, CheckCase.{.name = check.name, .cost = check.cost}) }
    }
    if TextContains("check_runner", filter) { VecPush(checks, CheckCase.{.name = "check_runner"}) }
    if TextContains("bundle-link-test", filter) { VecPush(checks, CheckCase.{.name = "bundle-link-test"}) }
    names: Vec(string)
    if !ListDirectory(tests, *names) { return .{} }
    for name: names {
        if TextHasSuffix(name, ".sh") && TextContains(name, filter) {
            VecPush(checks, CheckCase.{.name = name, .cost = CheckCost(CheckPath(tests, name))})
        }
    }
    return checks
}
