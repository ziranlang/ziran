// Check selection is independent of execution. Every ordinary run selects the
// complete retained suite, with expensive checks first.
#import "check_support"
#import "std/file"
#import "std/file_tree_linux"
#import "std/text_tools"
#import "std/byte_text_linux"
#import "std/process_run_linux"
using Vectors :: #import "std/vec"

CheckCase :: struct {
    name: string
    cost: s64
    log: string
    scratch: string
    started: s64
    nanoseconds: s64
    code: s32
    reused: bool
    finished: bool
    run: ProcessRun
}

CheckCost :: (path: string) -> s64 {
    file := OpenRead(path)
    if !file.valid { return 0 }
    bytes: [4096]u8
    count := ReadAt(file, bytes[:], 0)
    CloseFile(file)
    if count <= 0 { return 0 }
    lines := TextLines(TextFromBytes(bytes[:count]))
    for line: lines {
        prefix := "# check-cost: "
        if TextHasPrefix(line, prefix) {
            value, valid := TextInteger(line[prefix.count:])
            if valid && value >= 0 { return value }
        }
    }
    return 0
}

PlanChecks :: (checks: []CheckCase) -> Vec(s64) {
    costly: Vec(s64)
    rest: Vec(s64)
    selected: Vec(s64)
    for index: cast(s64)0..checks.count - 1 {
        if checks[index].cost <= 0 { VecPush(rest, index); continue }
        VecPush(costly, index)
        at := costly.count - 1
        while at > 0 {
            left := costly[at - 1]
            right := costly[at]
            if checks[left].cost > checks[right].cost || checks[left].cost == checks[right].cost &&
                CheckTextOrder(checks[left].name, checks[right].name) <= 0 { break }
            before := costly[at - 1]
            costly[at - 1] = costly[at]
            costly[at] = before
            at -= 1
        }
    }
    for index: costly { VecPush(selected, index) }
    for index: rest { VecPush(selected, index) }
    return selected
}

// Ziran case files that drive the compiler named by their first argument.
CheckCompilerCase :: (name: string) -> bool {
    return name == "module_parameters_cases.zi"
}

CheckArguments :: (name: string, bin: string, repo: string) -> Vec(string) {
    result: Vec(string)
    tests := CheckPath(repo, "tests")
    if CheckCompilerCase(name) {
        command := string.[CheckPath(bin, "ziran"), "run", "--target=c", "--root", tests,
            CheckPath(tests, name), "--", CheckPath(bin, "ziran")]
        for argument: command { VecPush(result, argument) }
        return result
    }
    if name == "native_backend_policy" || name == "x86_encoder" || name == "aarch64_encoder" {
        VecPush(result, CheckPath(bin, "ziran"))
        VecPush(result, "run")
        VecPush(result, "--target=c")
        VecPush(result, "--root")
        VecPush(result, tests)
        if name == "x86_encoder" {
            VecPush(result, "--module-path")
            VecPush(result, CheckPath(tests, "../cmd"))
            VecPush(result, CheckPath(tests, "x86_encoder_cases.zi"))
        } else if name == "aarch64_encoder" {
            VecPush(result, "--module-path")
            VecPush(result, CheckPath(tests, "../cmd"))
            VecPush(result, CheckPath(tests, "aarch64_encoder_cases.zi"))
        } else {
            VecPush(result, CheckPath(tests, "native_backend_policy_cases.zi"))
        }
        return result
    }
    if name == "bundle-link-test" {
        VecPush(result, CheckPath(bin, name))
        return result
    }
    if name == "artifact_consumer_cases.zi" || name == "native_disk_cache_cases.zi" {
        VecPush(result, CheckPath(bin, "ziran"))
        VecPush(result, "run")
        VecPush(result, "--target=c")
        VecPush(result, "--root")
        VecPush(result, tests)
        VecPush(result, CheckPath(tests, name))
        VecPush(result, "--")
        VecPush(result, CheckPath(bin, "ziran"))
        return result
    }
    if name == "temp_arena_cases.zi" {
        VecPush(result, CheckPath(bin, "ziran"))
        VecPush(result, "run")
        VecPush(result, "--target=c")
        VecPush(result, "--root")
        VecPush(result, tests)
        VecPush(result, CheckPath(tests, name))
        VecPush(result, "--")
        VecPush(result, CheckPath(bin, "ziran"))
        return result
    }
    VecPush(result, "sh")
    VecPush(result, CheckPath(tests, name))
    VecPush(result, CheckPath(bin, "ziran"))
    extra := ""
    if name == "host_capability.sh" { extra = "host-capability-test" }
    if name == "host_slices.sh" { extra = "slice-host-test" }
    if name == "host_arrays.sh" { extra = "array-host-test" }
    if name == "portable_host_records.sh" { extra = "record-host-test" }
    if name == "record_fields_by_name.sh" { extra = "record-fields-by-name-test" }
    if name == "process.sh" { extra = "process-host-test" }
    if name == "native_wx.sh" { extra = "native-wx-test" }
    if name == "native_load.sh" { extra = "native-load-test" }
    if extra != "" { VecPush(result, CheckPath(bin, extra)) }
    return result
}

DiscoverChecks :: (repo: string, bin: string, filter: string) -> Vec(CheckCase) {
    checks: Vec(CheckCase)
    tests := CheckPath(repo, "tests")
    compiler_cases := string.["module_parameters_cases.zi"]
    for name: compiler_cases {
        if TextContains(name, filter) { VecPush(checks, CheckCase.{.name = name, .cost = 2}) }
    }
    if TextContains("native_backend_policy", filter) {
        VecPush(checks, CheckCase.{.name = "native_backend_policy"})
    }
    if TextContains("x86_encoder", filter) {
        VecPush(checks, CheckCase.{.name = "x86_encoder", .cost = 2})
    }
    if TextContains("aarch64_encoder", filter) {
        VecPush(checks, CheckCase.{.name = "aarch64_encoder", .cost = 2})
    }
    if TextContains("bundle-link-test", filter) { VecPush(checks, CheckCase.{.name = "bundle-link-test"}) }
    if TextContains("artifact_consumer_cases.zi", filter) {
        VecPush(checks, CheckCase.{.name = "artifact_consumer_cases.zi"})
    }
    if TextContains("native_disk_cache_cases.zi", filter) {
        VecPush(checks, CheckCase.{.name = "native_disk_cache_cases.zi"})
    }
    if TextContains("temp_arena_cases.zi", filter) {
        VecPush(checks, CheckCase.{.name = "temp_arena_cases.zi", .cost = 2})
    }
    names: Vec(string)
    if !ListDirectory(tests, *names) { return .{} }
    for name: names {
        if TextHasSuffix(name, ".sh") && TextContains(name, filter) {
            VecPush(checks, CheckCase.{.name = name, .cost = CheckCost(CheckPath(tests, name))})
        }
    }
    return checks
}
