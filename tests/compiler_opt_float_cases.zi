using IR :: #import "compiler_lowered_ir"
using Opt :: #import "compiler_opt"

#scope_file

// KIND 0 converts an f64 constant to f32, 1 an f32 constant to f64, 2 negates
// an f64 constant and 3 an f32 constant. FOLDS false keeps the instruction.
// The expected patterns are what the hardware conversion produces: ties go to
// even, overflow to infinity, tiny values to the subnormals or zero.
Vector :: struct {
    kind: s32
    input: u64
    output: u64
    folds: bool
}

Table :: () -> [28]Vector {
    return Vector.[
    .{0, 0x3ff0000000000000, 0x3f800000, true}, .{0, 0x3fb999999999999a, 0x3dcccccd, true},
    .{0, 0xc004000000000000, 0xc0200000, true}, .{0, 0x4170000010000000, 0x4b800000, true},
    .{0, 0x3ff0000010000000, 0x3f800000, true}, .{0, 0x3ff0000030000000, 0x3f800002, true},
    .{0, 0x483d6329f1c35ca5, 0x7f800000, true}, .{0, 0xc83d6329f1c35ca5, 0xff800000, true},
    .{0, 0x37a16c262777579c, 0x000116c2, true}, .{0, 0x358dee7a4ad4b81f, 0x00000000, true},
    .{0, 0xb58dee7a4ad4b81f, 0x80000000, true}, .{0, 0x47effffff0000000, 0x7f800000, true},
    .{0, 0x47efffffe0000000, 0x7f7fffff, true}, .{0, 0x36a0000000000000, 0x00000001, true},
    .{0, 0x3690000000000000, 0x00000000, true}, .{0, 0x7ff0000000000000, 0x7f800000, true},
    .{0, 0x8000000000000000, 0x80000000, true}, .{0, 0x7ff8000000000000, 0, false},
    .{1, 0x3dcccccd, 0x3fb99999a0000000, true}, .{1, 0x00000001, 0x36a0000000000000, true},
    .{1, 0x007fffff, 0x380fffffc0000000, true}, .{1, 0x7f7fffff, 0x47efffffe0000000, true},
    .{1, 0xff800000, 0xfff0000000000000, true}, .{1, 0x80000000, 0x8000000000000000, true},
    .{1, 0x7fc00000, 0, false},
    .{2, 0x3ff0000000000000, 0xbff0000000000000, true}, .{2, 0x0000000000000000, 0x8000000000000000, true},
    .{3, 0x3f800000, 0xbf800000, true}]
}

#scope_export

// One function per vector: a constant, the operation and a return.
OptFloatCases :: () -> s32 {
    types := LirType.[.{kind = .Float, bits = 64}, .{kind = .Float, bits = 32}]
    vectors := Table()
    count: s64 = 28
    constants: [28]LirConstant
    values: [56]s32
    instructions: [84]LirInstruction
    operands: [28]s32
    returns: [28]s32
    blocks: [28]LirBlock
    functions: [28]LirFunction
    modules := string.["optimizer"]
    for index: cast(s64)0..count - 1 {
        vector := vectors[index]
        source: s32 = 0
        result: s32 = 0
        if vector.kind == 0 { source = 0; result = 1 }
        else if vector.kind == 1 { source = 1; result = 0 }
        else if vector.kind == 3 { source = 1; result = 1 }
        constants[index] = .{type = source, bits = vector.input}
        values[index * 2] = source
        values[index * 2 + 1] = result
        operands[index] = 0
        returns[index] = 1
        instructions[index * 3] = .{op = .Constant, result = 0, symbol = cast(s32)index, origin = -1}
        convert := ifx vector.kind >= 2 then LirOp.Negate else LirOp.Convert
        instructions[index * 3 + 1] = .{op = convert, result = 1, operands = operands[index:index + 1],
            symbol = -1, origin = -1}
        instructions[index * 3 + 2] = .{op = .Return, result = -1, symbol = -1, operands = returns[index:index + 1], origin = -1}
        blocks[index] = .{instructions = instructions[index * 3:index * 3 + 3]}
        functions[index] = .{module = 0, name = "float", result = result, values = values[index * 2:index * 2 + 2],
            blocks = blocks[index:index + 1], entry = 0, origin = -1}
    }
    program := LirProgram.{version = LirVersion, modules = modules[:], types = types[:],
        constants = constants[:], functions = functions[:], entry = 0}
    if LirVerify(program, LirDefaultLimits()).problem != .None { return 1 }
    owner: LirOptOwner
    built := LirOptBuild(*owner, program, LirDefaultLimits(), LirOptDefaultOptions())
    if built.problem != .None || !owner.valid { return 2 }
    optimized := LirOptProgram(*owner)
    if LirVerify(optimized, LirDefaultLimits()).problem != .None { return 3 }
    for index: cast(s64)0..count - 1 {
        vector := vectors[index]
        body := optimized.functions[index].blocks[0].instructions
        if !vector.folds {
            // A NaN keeps its operation: its payload is the hardware's.
            if body.count != 3 || body[1].op == .Constant {
                print("float fold folded a NaN: vector %\n", index)
                return 4
            }
            continue
        }
        if body.count != 2 || body[0].op != .Constant || optimized.constants[body[0].symbol].bits != vector.output {
            print("float fold vector % expected % got %\n", index, vector.output,
                ifx body.count > 0 && body[0].op == .Constant then optimized.constants[body[0].symbol].bits else 0)
            return 5
        }
    }
    LirOptFree(*owner)
    print("compiler optimizer: float conversions and negations fold to the hardware's patterns, NaNs stay\n")
    return 0
}
