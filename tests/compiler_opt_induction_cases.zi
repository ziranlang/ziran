using IR :: #import "compiler_lowered_ir"
using Verify :: #import "compiler_lowered_verify"
using Codec :: #import "compiler_exec_serial"
using Exec :: #import "compiler_exec"
using Induction :: #import "compiler_opt_induction"
using Opt :: #import "compiler_opt"
using Vectors :: #import "std/vec"

#scope_file
Execute :: (program: LirProgram, fuel: s64 = 10000) -> LirExecResult {
    plan: LirExecPlan
    defer LirExecPlanFree(*plan)
    built := LirExecPlanBuild(program, LirDefaultLimits(), *plan)
    if built.problem != .None { return built }
    limits := LirExecDefaultLimits()
    limits.fuel = fuel
    instance: LirExecInstance
    defer LirExecInstanceClose(*instance)
    opened := LirExecInstanceOpen(*plan, limits, 903, *instance)
    if opened.problem != .None { return opened }
    arguments: [0]LirExecArgument
    return LirExecCall(*instance, 0, arguments[:])
}

Fixture :: (iterations: s64, mode: s32, early: bool, commuted: bool) -> s32 {
    width: s32 = ifx mode == 1 || mode == 2 then 8 else 64
    types := LirType.[.{kind = .Void}, .{kind = .Integer, bits = 64, is_signed = true},
        .{kind = .Bool, bits = 1}, .{kind = .Integer, bits = width, is_signed = mode != 1}]
    constants := LirConstant.[.{type = 1, bits = 0}, .{type = 1, bits = 1}, .{type = 1, bits = cast(u64)iterations},
        .{type = 3, bits = 3}, .{type = 3, bits = 2}, .{type = 3, bits = 13},
        .{type = 3, bits = 0}, .{type = 1, bits = ifx early then 2 else cast(u64)iterations}]
    if mode == 1 { constants[3].bits = 250; constants[4].bits = 7 }
    if mode == 2 { constants[4].bits = 7; constants[5].bits = 251 }
    if mode == 3 { constants[3].bits = 9223372036854775806; constants[4].bits = 18446744073709551613; constants[5].bits = 9223372036854775809 }
    if mode == 4 { constants[5].bits = 2 }
    modules := string.["induction"]
    sources := string.["induction.zi"]
    origins := LirOrigin.[.{file = 0, line = 1, column = 1, begin = 0, end = 1, parent = -1},
        .{file = 0, line = 2, column = 1, begin = 1, end = 2, parent = -1},
        .{file = 0, line = 3, column = 1, begin = 2, end = 3, parent = -1},
        .{file = 0, line = 4, column = 1, begin = 3, end = 4, parent = -1}]
    values := s32.[1, 1, 1, 3, 3, 3, 1, 3, 3, 2, 3, 3, 3, 1, 1, 2, 3]
    parameters := s32.[6, 7, 8]
    initial := s32.[0, 3, 16]
    cmp := s32.[6, 2]
    mul := s32.[7, 5]
    if commuted { mul[0] = 5; mul[1] = 7 }
    sum := s32.[8, 10]
    inc := s32.[7, 4]
    if mode == 5 { inc[1] = 10 }
    if commuted && mode != 2 { old := inc[0]; inc[0] = inc[1]; inc[1] = old }
    counter := s32.[6, 1]
    next := s32.[13, 12, 11]
    condition := s32.[9]
    early_compare := s32.[6, 14]
    early_condition := s32.[15]
    ret := s32.[8]
    entry_edges := LirEdge.[.{block = 1, arguments = initial[:]}]
    header_edges := LirEdge.[.{block = 2}, .{block = 4}]
    body_edges := LirEdge.[.{block = 4}, .{block = 3}]
    latch_edges := LirEdge.[.{block = 1, arguments = next[:]}]
    entry := LirInstruction.[.{op = .Constant, result = 0, symbol = 0}, .{op = .Constant, result = 1, symbol = 1},
        .{op = .Constant, result = 2, symbol = 2}, .{op = .Constant, result = 3, symbol = 3},
        .{op = .Constant, result = 4, symbol = 4}, .{op = .Constant, result = 5, symbol = 5},
        .{op = .Constant, result = 16, symbol = 6}, .{op = .Constant, result = 14, symbol = 7},
        .{op = .Jump, result = -1, symbol = -1, edges = entry_edges[:]}]
    header := LirInstruction.[.{op = .Fuel, result = -1, symbol = -1, immediate = 3, effect = 1, origin = 1},
        .{op = .Less, result = 9, symbol = -1, operands = cmp[:]},
        .{op = .Branch, result = -1, symbol = -1, operands = condition[:], edges = header_edges[:]}]
    body := LirInstruction.[.{op = .Fuel, result = -1, symbol = -1, immediate = 5, effect = 1, origin = 2},
        .{op = .Multiply, result = 10, symbol = -1, operands = mul[:], origin = 2},
        .{op = .Add, result = 11, symbol = -1, operands = sum[:]},
        .{op = .Equal, result = 15, symbol = -1, operands = early_compare[:]},
        .{op = .Branch, result = -1, symbol = -1, operands = early_condition[:], edges = body_edges[:]}]
    latch := LirInstruction.[.{op = .Fuel, result = -1, symbol = -1, immediate = 7, effect = 1, origin = 3},
        .{op = ifx mode == 2 then .Subtract else .Add, result = 12, symbol = -1, operands = inc[:], origin = 3},
        .{op = .Add, result = 13, symbol = -1, operands = counter[:]},
        .{op = .Jump, result = -1, symbol = -1, edges = latch_edges[:]}]
    exit := LirInstruction.[.{op = .Return, result = -1, symbol = -1, operands = ret[:]}]
    blocks := LirBlock.[.{instructions = entry[:]}, .{parameters = parameters[:], instructions = header[:]},
        .{instructions = body[:]}, .{instructions = latch[:]}, .{instructions = exit[:]}]
    functions := LirFunction.[.{module = 0, name = "sum", result = 3, values = values[:], blocks = blocks[:], entry = 0, origin = 0}]
    program := LirProgram.{version = LirVersion, modules = modules[:], sources = sources[:], types = types[:],
        constants = constants[:], origins = origins[:], functions = functions[:], entry = 0}
    if LirVerify(program, LirDefaultLimits()).problem != .None { return 1 }
    before := Execute(program)
    if before.problem != .None { return 2 }
    empty: []u8
    measured := LirWrite(program, empty)
    encoded: Vec(u8)
    defer VecFree(encoded)
    if measured.problem != .None || !VecResize(encoded, measured.size) || LirWrite(program, encoded[:]).problem != .None { return 3 }
    owner: LirReadOwner
    defer LirReadFree(*owner)
    if LirRead(*owner, TextView(encoded[:]), LirDefaultLimits()).problem != .None { return 4 }
    tiny := LirInduction(*owner, LirDefaultLimits(), 0)
    if tiny.problem != .Limit || LirReadProgram(*owner).functions[0].values.count != 17 { return 5 }
    changed := LirInduction(*owner, LirDefaultLimits(), 100000)
    expected: s64 = ifx mode == 4 || mode == 5 then 0 else 1
    if changed.problem != .None || changed.codec.problem != .None || changed.products != expected {
        print("induction problems % codec % products % verify %\n", cast(s32)changed.problem, cast(s32)changed.codec.problem, changed.products, cast(s32)changed.codec.diagnostic.problem)
        return 6
    }
    output := LirReadProgram(*owner)
    if LirVerify(output, LirDefaultLimits()).problem != .None { return 7 }
    if expected == 1 {
        f := output.functions[0]
        if f.blocks[1].parameters.count != 4 || f.blocks[2].instructions[1].op != .Bitcast ||
            f.blocks[2].instructions[1].operands[0] != 17 || f.blocks[0].instructions.count != 11 ||
            f.blocks[3].instructions.count != 5 || f.blocks[3].instructions[3].op != latch[1].op { return 8 }
    }
    after := Execute(output)
    if after.problem != before.problem || after.value.bits != before.value.bits { return 9 }
    for fuel: 0..130 {
        x := Execute(program, fuel)
        y := Execute(output, fuel)
        if x.problem != y.problem || x.origin != y.origin || x.fuel_remaining != y.fuel_remaining { return 10 }
    }
    repeated := LirInduction(*owner, LirDefaultLimits(), 100000)
    if repeated.problem != .None || repeated.codec.problem != .None || repeated.products != 0 { return 11 }
    integrated: LirOptOwner
    defer LirOptFree(*integrated)
    options := LirOptOptions.{propagate_copies = true, eliminate_dead = true, simplify_cfg = true, maximum_rounds = 4}
    optimized := LirOptBuild(*integrated, program, LirDefaultLimits(), options)
    if optimized.problem != .None || optimized.counters.induction.instructions != expected {
        print("induction integration problem % verify % b % i %\n", cast(s32)optimized.problem,
            cast(s32)optimized.diagnostic.problem, optimized.diagnostic.block, optimized.diagnostic.instruction)
        return 12
    }
    final := LirOptProgram(*integrated)
    complete := Execute(final)
    if complete.problem != before.problem || complete.value.bits != before.value.bits { return 13 }
    fuel_cases := s64.[0, 3, 8, 10, 31, 129]
    for fuel: fuel_cases {
        x := Execute(program, fuel)
        y := Execute(final, fuel)
        if x.problem != y.problem || x.origin != y.origin || x.fuel_remaining != y.fuel_remaining { return 14 }
    }
    return 0
}

#scope_export
OptInductionCases :: () -> s32 {
    for iterations: cast(s64)0..7 {
        for mode: cast(s32)0..5 {
            for flags: 0..3 {
                result := Fixture(iterations, mode, (flags & 1) != 0, (flags & 2) != 0)
                if result != 0 { print("induction case % iterations % mode % flags % failed\n", result, iterations, mode, flags); return result }
            }
        }
    }
    print("compiler optimizer: modular affine products, signed/unsigned wrap, early exits, fuel and unsupported recurrences passed\n")
    return 0
}
