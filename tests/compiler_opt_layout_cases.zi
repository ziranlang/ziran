using IR :: #import "compiler_lowered_ir"
using Codec :: #import "compiler_exec_serial"
using Exec :: #import "compiler_exec"
using Layout :: #import "compiler_opt_layout"
using LoopCases :: #import "compiler_opt_loop_cases"
using Vectors :: #import "std/vec"

#scope_file
Execute :: (program: LirProgram, fuel: s64 = 10000) -> LirExecResult {
    plan: LirExecPlan
    defer LirExecPlanFree(*plan)
    built := LirExecPlanBuild(program, LirDefaultLimits(), *plan)
    if built.problem != .None { return built }
    limits := LirExecDefaultLimits()
    limits.fuel = fuel
    instance: LirExecInstance
    defer LirExecInstanceClose(*instance)
    opened := LirExecInstanceOpen(*plan, limits, 901, *instance)
    if opened.problem != .None { return opened }
    arguments: [0]LirExecArgument
    return LirExecCall(*instance, 0, arguments[:])
}

Fixture :: (iterations: s64) -> s32 {
    types := LirType.[.{kind = .Void}, .{kind = .Integer, bits = 64, is_signed = true}, .{kind = .Bool, bits = 1}]
    constants := LirConstant.[.{type = 1, bits = 0}, .{type = 1, bits = 1}, .{type = 1, bits = cast(u64)iterations}, .{type = 1, bits = 7}]
    modules := string.["layout"]
    sources := string.["layout.zi"]
    origins := LirOrigin.[.{file = 0, line = 1, column = 1, begin = 0, end = 1, parent = -1},
        .{file = 0, line = 2, column = 1, begin = 1, end = 2, parent = -1},
        .{file = 0, line = 3, column = 1, begin = 2, end = 3, parent = -1}]
    values := s32.[1, 1, 1, 1, 1, 1, 2, 1, 1]
    parameters := s32.[4, 5]
    initial := s32.[0, 0]
    cmp := s32.[4, 2]
    sum := s32.[5, 3]
    inc := s32.[4, 1]
    next := s32.[8, 7]
    condition := s32.[6]
    ret := s32.[5]
    entry_edges := LirEdge.[.{block = 2, arguments = initial[:]}]
    header_edges := LirEdge.[.{block = 1}, .{block = 0}]
    latch_edges := LirEdge.[.{block = 2, arguments = next[:]}]
    entry := LirInstruction.[.{op = .Constant, result = 0, symbol = 0}, .{op = .Constant, result = 1, symbol = 1},
        .{op = .Constant, result = 2, symbol = 2}, .{op = .Constant, result = 3, symbol = 3},
        .{op = .Jump, result = -1, symbol = -1, edges = entry_edges[:]}]
    header := LirInstruction.[.{op = .Fuel, result = -1, symbol = -1, immediate = 3, effect = 1, origin = 1},
        .{op = .Less, result = 6, symbol = -1, operands = cmp[:]},
        .{op = .Branch, result = -1, symbol = -1, operands = condition[:], edges = header_edges[:]}]
    body := LirInstruction.[.{op = .Fuel, result = -1, symbol = -1, immediate = 5, effect = 1, origin = 2},
        .{op = .Add, result = 7, symbol = -1, operands = sum[:]}, .{op = .Add, result = 8, symbol = -1, operands = inc[:]},
        .{op = .Jump, result = -1, symbol = -1, edges = latch_edges[:]}]
    exit := LirInstruction.[.{op = .Return, result = -1, symbol = -1, operands = ret[:]}]
    // Deliberately reversed source order, with the function entry last.
    blocks := LirBlock.[.{instructions = exit[:]}, .{instructions = body[:]},
        .{parameters = parameters[:], instructions = header[:]}, .{instructions = entry[:]}]
    functions := LirFunction.[.{module = 0, name = "sum", result = 1, values = values[:], blocks = blocks[:], entry = 3, origin = 0}]
    program := LirProgram.{version = LirVersion, modules = modules[:], sources = sources[:], types = types[:],
        constants = constants[:], origins = origins[:], functions = functions[:], entry = 0}
    if LirVerify(program, LirDefaultLimits()).problem != .None { return 1 }
    analysis := OptLoopAnalysisCases(functions[0])
    if analysis != 0 { print("loop analysis case % failed\n", analysis); return 2 }
    before := Execute(program)
    if before.problem != .None || before.value.bits != cast(u64)(iterations * 7) { return 3 }
    empty: []u8
    measured := LirWrite(program, empty)
    encoded: Vec(u8)
    defer VecFree(encoded)
    if measured.problem != .None || !VecResize(encoded, measured.size) || LirWrite(program, encoded[:]).problem != .None { return 4 }
    owner: LirReadOwner
    defer LirReadFree(*owner)
    if LirRead(*owner, TextView(encoded[:]), LirDefaultLimits()).problem != .None { return 5 }
    tiny := LirLayout(*owner, LirDefaultLimits(), 0)
    if tiny.problem != .Limit || LirReadProgram(*owner).functions[0].entry != 3 { return 6 }
    ordered := LirLayout(*owner, LirDefaultLimits(), 100000)
    if ordered.problem != .None || ordered.codec.problem != .None || ordered.functions != 1 { return 7 }
    output := LirReadProgram(*owner)
    if LirVerify(output, LirDefaultLimits()).problem != .None { return 8 }
    f := output.functions[0]
    if f.entry != 0 || f.blocks[0].instructions[0].op != .Constant || f.blocks[1].parameters.count != 2 ||
        f.blocks[2].instructions[0].origin != 2 || f.blocks[3].instructions[0].op != .Return { return 9 }
    after := Execute(output)
    if after.problem != before.problem || after.value.bits != before.value.bits { return 10 }
    for fuel: 0..100 {
        x := Execute(program, fuel)
        y := Execute(output, fuel)
        if x.problem != y.problem || x.origin != y.origin || x.fuel_remaining != y.fuel_remaining { return 11 }
    }
    repeated := LirLayout(*owner, LirDefaultLimits(), 100000)
    if repeated.problem != .None || repeated.codec.problem != .None || repeated.functions != 0 { return 12 }
    return 0
}

#scope_export
OptLayoutCases :: () -> s32 {
    for iterations: cast(s64)0..7 {
        result := Fixture(iterations)
        if result != 0 { print("layout case % iterations % failed\n", result, iterations); return result }
    }
    print("compiler optimizer: deterministic trace order preserves SSA, zero/many iterations and fuel; loop analysis and budgets passed\n")
    return 0
}
