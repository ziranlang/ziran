using IR :: #import "compiler_lowered_ir"
using Verify :: #import "compiler_lowered_verify"
using Codec :: #import "compiler_exec_serial"
using Exec :: #import "compiler_exec"
using Licm :: #import "compiler_opt_licm"
using Vectors :: #import "std/vec"

#scope_file
Execute :: (program: LirProgram, fuel: s64 = 10000) -> LirExecResult {
    plan: LirExecPlan
    defer LirExecPlanFree(*plan)
    built := LirExecPlanBuild(program, LirDefaultLimits(), *plan)
    if built.problem != .None { return built }
    limits := LirExecDefaultLimits()
    limits.fuel = fuel
    instance: LirExecInstance
    defer LirExecInstanceClose(*instance)
    opened := LirExecInstanceOpen(*plan, limits, 902, *instance)
    if opened.problem != .None { return opened }
    arguments: [0]LirExecArgument
    return LirExecCall(*instance, 0, arguments[:])
}

Fixture :: (iterations: s64, trapping: bool) -> s32 {
    types := LirType.[.{kind = .Void}, .{kind = .Integer, bits = 64, is_signed = true}, .{kind = .Bool, bits = 1}]
    constants := LirConstant.[.{type = 1, bits = 0}, .{type = 1, bits = 1}, .{type = 1, bits = cast(u64)iterations},
        .{type = 1, bits = 6}, .{type = 1, bits = 7}, .{type = 1, bits = ifx trapping then 0 else 1}]
    modules := string.["licm"]
    sources := string.["licm.zi"]
    origins := LirOrigin.[.{file = 0, line = 1, column = 1, begin = 0, end = 1, parent = -1},
        .{file = 0, line = 2, column = 1, begin = 1, end = 2, parent = -1},
        .{file = 0, line = 3, column = 1, begin = 2, end = 3, parent = -1},
        .{file = 0, line = 4, column = 1, begin = 3, end = 4, parent = -1}]
    values := s32.[1, 1, 1, 1, 1, 1, 1, 1, 2, 1, 1, 1, 1, 1, 1, 1]
    parameters := s32.[6, 7]
    initial := s32.[0, 0]
    cmp := s32.[6, 2]
    invariant_add := s32.[3, 4]
    invariant_mul := s32.[9, 15]
    sum := s32.[7, 10]
    inc := s32.[6, 14]
    divide := s32.[3, 5]
    next := s32.[12, 11]
    condition := s32.[8]
    ret := s32.[7]
    entry_edges := LirEdge.[.{block = 2, arguments = initial[:]}]
    header_edges := LirEdge.[.{block = 1}, .{block = 0}]
    latch_edges := LirEdge.[.{block = 2, arguments = next[:]}]
    entry := LirInstruction.[.{op = .Constant, result = 0, symbol = 0}, .{op = .Constant, result = 1, symbol = 1},
        .{op = .Constant, result = 2, symbol = 2}, .{op = .Constant, result = 3, symbol = 3},
        .{op = .Constant, result = 4, symbol = 4}, .{op = .Constant, result = 5, symbol = 5},
        .{op = .Jump, result = -1, symbol = -1, edges = entry_edges[:]}]
    header := LirInstruction.[.{op = .Fuel, result = -1, symbol = -1, immediate = 3, effect = 1, origin = 1},
        .{op = .Add, result = 9, symbol = -1, operands = invariant_add[:], origin = 1},
        .{op = .Less, result = 8, symbol = -1, operands = cmp[:]},
        .{op = .Branch, result = -1, symbol = -1, operands = condition[:], edges = header_edges[:]}]
    body := LirInstruction.[.{op = .Fuel, result = -1, symbol = -1, immediate = 5, effect = 1, origin = 2},
        .{op = .Constant, result = 14, symbol = 1, origin = 2},
        .{op = .Constant, result = 15, symbol = 4, origin = 2},
        .{op = .Multiply, result = 10, symbol = -1, operands = invariant_mul[:], origin = 2},
        .{op = .Divide, result = 13, symbol = -1, operands = divide[:], origin = 3},
        .{op = .Add, result = 11, symbol = -1, operands = sum[:]},
        .{op = .Add, result = 12, symbol = -1, operands = inc[:]},
        .{op = .Jump, result = -1, symbol = -1, edges = latch_edges[:]}]
    exit := LirInstruction.[.{op = .Return, result = -1, symbol = -1, operands = ret[:]}]
    // Body precedes header in storage: hoisting their dependent invariant
    // chain requires a fixed point and dependency order in the preheader.
    blocks := LirBlock.[.{instructions = exit[:]}, .{instructions = body[:]},
        .{parameters = parameters[:], instructions = header[:]}, .{instructions = entry[:]}]
    functions := LirFunction.[.{module = 0, name = "sum", result = 1, values = values[:], blocks = blocks[:], entry = 3, origin = 0}]
    program := LirProgram.{version = LirVersion, modules = modules[:], sources = sources[:], types = types[:],
        constants = constants[:], origins = origins[:], functions = functions[:], entry = 0}
    if LirVerify(program, LirDefaultLimits()).problem != .None { return 1 }
    before := Execute(program)
    if (!trapping || iterations == 0) && (before.problem != .None || before.value.bits != cast(u64)(iterations * 91)) { return 2 }
    if trapping && iterations > 0 && before.problem == .None { return 3 }
    empty: []u8
    measured := LirWrite(program, empty)
    encoded: Vec(u8)
    defer VecFree(encoded)
    if measured.problem != .None || !VecResize(encoded, measured.size) || LirWrite(program, encoded[:]).problem != .None { return 4 }
    owner: LirReadOwner
    defer LirReadFree(*owner)
    if LirRead(*owner, TextView(encoded[:]), LirDefaultLimits()).problem != .None { return 5 }
    tiny := LirLicm(*owner, LirDefaultLimits(), 0)
    if tiny.problem != .Limit || LirReadProgram(*owner).functions[0].blocks[3].instructions.count != 7 { return 6 }
    moved := LirLicm(*owner, LirDefaultLimits(), 100000)
    if moved.problem != .None || moved.codec.problem != .None || moved.loops != 1 || moved.instructions != 3 { return 7 }
    output := LirReadProgram(*owner)
    if LirVerify(output, LirDefaultLimits()).problem != .None { return 8 }
    f := output.functions[0]
    pre := f.blocks[3].instructions
    if pre.count != 10 || pre[6].result != 15 || pre[7].result != 9 || pre[8].result != 10 ||
        pre[6].origin != 2 || pre[7].origin != 1 || pre[8].origin != 2 ||
        f.blocks[1].instructions[1].op != .Constant || f.blocks[1].instructions[1].result != 14 ||
        f.blocks[1].instructions[2].op != .Divide || f.blocks[1].instructions[2].origin != 3 ||
        f.blocks[2].instructions[0].op != .Fuel || f.blocks[2].instructions[0].effect != 1 { return 9 }
    after := Execute(output)
    if after.problem != before.problem || after.origin != before.origin || after.value.bits != before.value.bits { return 10 }
    for fuel: 0..100 {
        x := Execute(program, fuel)
        y := Execute(output, fuel)
        if x.problem != y.problem || x.origin != y.origin || x.fuel_remaining != y.fuel_remaining { return 11 }
    }
    repeated := LirLicm(*owner, LirDefaultLimits(), 100000)
    if repeated.problem != .None || repeated.codec.problem != .None || repeated.instructions != 0 { return 12 }
    return 0
}

// A loop with no call adds the float constant 1.5 each iteration: the
// constant moves to the preheader, where it stays in a register, while the
// integer constants stay at their uses. The sum is unchanged.
FloatConstantCase :: () -> s32 {
    types := LirType.[.{kind = .Void}, .{kind = .Integer, bits = 64, is_signed = true}, .{kind = .Bool, bits = 1},
        .{kind = .Float, bits = 64}]
    constants := LirConstant.[.{type = 1, bits = 0}, .{type = 1, bits = 1}, .{type = 1, bits = 5},
        .{type = 3, bits = 0x3ff8000000000000}, .{type = 3, bits = 0}]
    modules := string.["licm"]
    values := s32.[1, 3, 1, 3, 1, 2, 3, 3, 1, 1]
    start := s32.[0, 1]
    parameters := s32.[2, 3]
    less := s32.[2, 4]
    flag := s32.[5]
    grow := s32.[3, 6]
    step := s32.[2, 8]
    next := s32.[9, 7]
    sum := s32.[3]
    to_header := LirEdge.[.{block = 1, arguments = start[:]}]
    split := LirEdge.[.{block = 2}, .{block = 3}]
    back := LirEdge.[.{block = 1, arguments = next[:]}]
    entry := LirInstruction.[.{op = .Constant, result = 0, symbol = 0, origin = -1}, .{op = .Constant, result = 1, symbol = 4, origin = -1},
        .{op = .Jump, result = -1, symbol = -1, edges = to_header[:], origin = -1}]
    header := LirInstruction.[.{op = .Fuel, result = -1, symbol = -1, immediate = 1, effect = 1, origin = -1},
        .{op = .Constant, result = 4, symbol = 2, origin = -1}, .{op = .Less, result = 5, symbol = -1, operands = less[:], origin = -1},
        .{op = .Branch, result = -1, symbol = -1, operands = flag[:], edges = split[:], origin = -1}]
    body := LirInstruction.[.{op = .Constant, result = 6, symbol = 3, origin = -1},
        .{op = .Add, result = 7, symbol = -1, operands = grow[:], origin = -1}, .{op = .Constant, result = 8, symbol = 1, origin = -1},
        .{op = .Add, result = 9, symbol = -1, operands = step[:], origin = -1},
        .{op = .Jump, result = -1, symbol = -1, edges = back[:], origin = -1}]
    exit := LirInstruction.[.{op = .Return, result = -1, symbol = -1, operands = sum[:], origin = -1}]
    blocks := LirBlock.[.{instructions = entry[:]}, .{parameters = parameters[:], instructions = header[:]},
        .{instructions = body[:]}, .{instructions = exit[:]}]
    functions := LirFunction.[.{module = 0, name = "float_sum", result = 3, values = values[:], blocks = blocks[:],
        entry = 0, origin = -1}]
    program := LirProgram.{version = LirVersion, modules = modules[:], types = types[:],
        constants = constants[:], functions = functions[:], entry = 0}
    if LirVerify(program, LirDefaultLimits()).problem != .None { return 21 }
    before := Execute(program)
    if before.problem != .None || before.value.bits != 0x401e000000000000 { return 22 }
    empty: []u8
    measured := LirWrite(program, empty)
    encoded: Vec(u8)
    defer VecFree(encoded)
    if measured.problem != .None || !VecResize(encoded, measured.size) || LirWrite(program, encoded[:]).problem != .None { return 23 }
    owner: LirReadOwner
    defer LirReadFree(*owner)
    if LirRead(*owner, TextView(encoded[:]), LirDefaultLimits()).problem != .None { return 24 }
    moved := LirLicm(*owner, LirDefaultLimits(), 100000)
    if moved.problem != .None || moved.codec.problem != .None || moved.instructions != 1 { return 25 }
    output := LirReadProgram(*owner)
    if LirVerify(output, LirDefaultLimits()).problem != .None { return 26 }
    hoisted := false
    for instruction: output.functions[0].blocks[0].instructions { if instruction.result == 6 { hoisted = true } }
    kept := false
    for instruction: output.functions[0].blocks[2].instructions {
        if instruction.result == 6 { return 27 }
        if instruction.result == 8 { kept = true }
    }
    if !hoisted || !kept { return 28 }
    after := Execute(output)
    if after.problem != .None || after.value.bits != before.value.bits { return 29 }
    return 0
}

#scope_export
OptLicmCases :: () -> s32 {
    float_constant := FloatConstantCase()
    if float_constant != 0 { print("LICM float constant case % failed\n", float_constant); return float_constant }
    for iterations: cast(s64)0..7 {
        for mode: 0..1 {
            result := Fixture(iterations, mode == 1)
            if result != 0 { print("LICM case % iterations % trap % failed\n", result, iterations, mode); return result }
        }
    }
    print("compiler optimizer: invariant chains, float constants, zero/many iterations, traps, fuel and budgets passed\n")
    return 0
}
