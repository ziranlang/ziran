// Discover emitted codes independently from the registry used by explain.
#import "native_test"
#import "check_support"
#import "std/byte_text_linux"
#import "std/json_document"
#import "std/sort"
#import "std/text_tools"
Code :: #import "compiler_scan"
Source :: #import "compiler_source"
using Vectors :: #import "std/vec"

ExplainSpace :: (byte: u8) -> bool { return byte == 32 || byte >= 9 && byte <= 13 }
ExplainCodeByte :: (byte: u8) -> bool { return byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 || byte >= 48 && byte <= 57 || byte == 95 || byte == 46 || byte == 45 }
ExplainNameByte :: (byte: u8) -> bool { return byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 || byte >= 48 && byte <= 57 || byte == 95 }

ExplainAdd :: (codes: *Vec(string), value: string) {
    for index: cast(s64)0..codes.count - 1 { if (<<codes)[index] == value { return } }
    VecPush(<<codes, TextDetach(TextCopy(value)))
}

ExplainLiteral :: (text: string, start: s64, limit: s64) -> string {
    if start < 0 || start >= limit || text[start] != 34 { return "" }
    at := start + 1
    while at < limit && ExplainCodeByte(text[at]) { at += 1 }
    if at > start + 1 && at < limit && text[at] == 34 { return text[start + 1:at] }
    return ""
}

ExplainCalls :: (text: string, names: []string, codes: *Vec(string), mode: s32) {
    for name: names {
        cursor: s64
        while cursor < text.count {
            found := TextFind(text, name, cursor)
            if found < 0 { break }; cursor = found + name.count
            if mode == 2 && found > 0 && ExplainNameByte(text[found - 1]) { continue }
            at := cursor
            while at < text.count && ExplainSpace(text[at]) { at += 1 }
            if at >= text.count || text[at] != 40 { continue }; at += 1
            if mode == 0 {
                limit := TextFind(text, ");", at); if limit < 0 { limit = text.count - 1 }
                first := at
                while first < limit && ExplainSpace(text[first]) { first += 1 }
                declaration := "ZirSourceSpan"
                if first + declaration.count <= limit && text[first:first + declaration.count] == declaration && (first + declaration.count == limit || !ExplainNameByte(text[first + declaration.count])) { continue }
                quote := at
                while quote < limit {
                    if text[quote] == 34 {
                        value := ExplainLiteral(text, quote, limit)
                        if value != "" { ExplainAdd(codes, value); break }
                    }
                    quote += 1
                }
                continue
            }
            if mode == 1 {
                while at < text.count && ExplainSpace(text[at]) { at += 1 }
                value := ExplainLiteral(text, at, text.count)
                if value != "" { ExplainAdd(codes, value) }
                continue
            }
            start := at
            while at < text.count && text[at] != 34 && text[at] != 10 && text[at] != 41 { at += 1 }
            if at >= text.count || text[at] != 34 { continue }
            prefix := TextTrimEnd(text[start:at])
            if prefix.count > 0 && prefix[prefix.count - 1] == 44 {
                value := ExplainLiteral(text, at, text.count)
                if value != "" { ExplainAdd(codes, value) }
            }
        }
    }
}

ExplainNextToken :: (text: string, token: Code.Scan) -> Code.Scan {
    return Code.NextCodeToken(text, token.end, token.after_line, token.after_column)
}

ExplainSecondArgument :: (text: string, open: Code.Scan) -> Code.Scan {
    depth: s32
    token := ExplainNextToken(text, open)
    while token.kind != .Eof {
        value := text[token.begin:token.end]
        if value == "," && depth == 0 { return ExplainNextToken(text, token) }
        if value == "(" || value == "[" || value == "{" { depth += 1 }
        if value == ")" || value == "]" || value == "}" {
            if depth == 0 { break }
            depth -= 1
        }
        token = ExplainNextToken(text, token)
    }
    return .{}
}

ExplainDiagnosticCode :: (text: string, open: Code.Scan) -> string {
    literal := ExplainSecondArgument(text, open)
    name := text[literal.begin:literal.end]
    wrapped := literal.kind == .Ident && (name == "CStr" || name == "CheckCString" || name == "ParserCString")
    if wrapped {
        wrapper := ExplainNextToken(text, literal)
        if text[wrapper.begin:wrapper.end] != "(" { return "" }
        literal = ExplainNextToken(text, wrapper)
    }
    if literal.kind != .String { return "" }
    after := ExplainNextToken(text, literal)
    if wrapped {
        if text[after.begin:after.end] != ")" { return "" }
        after = ExplainNextToken(text, after)
    }
    delimiter := text[after.begin:after.end]
    if delimiter != "," && delimiter != ")" { return "" }
    return ExplainLiteral(text, literal.begin, literal.end)
}

ExplainZiDiagnostics :: (test: *NativeTest, source: string, codes: *Vec(string)) -> bool {
    if TextFind(source, "Diagnostic", 0) < 0 && TextFind(source, "Warning", 0) < 0 { return true }
    text := source
    rewritten: Vec(u8)
    defer VecFree(rewritten)
    if TextFind(source, "#string", 0) >= 0 {
        measured := Source.RewriteRawStrings(source, rewritten[:], 128)
        if !NativeAssert(test, measured.error == .None && VecResize(rewritten, measured.count),
            "cannot prepare diagnostic source for scanning") { return false }
        result := Source.RewriteRawStrings(source, rewritten[:], 128)
        if !NativeAssert(test, result.error == .None && result.count == rewritten.count,
            "diagnostic source rewrite changed size") { return false }
        text = TextView(rewritten[:])
    }
    token := Code.NextCodeToken(text, 0, 1, 1)
    while token.kind != .Eof {
        name := text[token.begin:token.end]
        open := ExplainNextToken(text, token)
        if token.kind == .Ident && (name == "Diagnostic" || name == "DiagnosticDetailed" || name == "DiagnosticTarget" || name == "Warning") && text[open.begin:open.end] == "(" {
            value := ExplainDiagnosticCode(text, open)
            if value != "" { ExplainAdd(codes, value) }
        }
        token = open
    }
    return true
}

ExplainModularDiscovery :: (test: *NativeTest) -> bool {
    source := #string ZI
IR :: #import "compiler_ir"
Example :: #string SAMPLE
Diagnostic(span, CStr("fixture.raw"), CStr("message"))
SAMPLE
Emit :: (span: IR.ZirSourceSpan) {
    // Diagnostic(span, CStr("fixture.comment"), CStr("message"))
    example := "Diagnostic(span, CStr(\"fixture.string\"), CStr(\"message\"))"
    OtherDiagnostic(span, CStr("fixture.other"), CStr("message"))
    Diagnostic(SpanOf(.[span, span], 0),
        CStr /* code */ ("fixture.wrapped"), CStr("fixture.message"))
    Diagnostic(span, "fixture.literal", "message")
    DiagnosticDetailed(span, CheckCString("fixture.detailed"), details, "message")
    DiagnosticTarget(span, ParserCString("fixture.target"), target, capability, "message")
    Warning(span, ParserCString("fixture.warning"), "message")
    Diagnostic(span, code, CStr("fixture.computed"))
}
ZI
    module := CheckPath(test.work, "emitter-module.zi")
    if !NativeWrite(test, module, source) { return false }
    codes: Vec(string)
    if !ExplainZiDiagnostics(test, NativeRead(test, module), *codes) { return false }
    return NativeAssert(test, codes.count == 5 && codes[0] == "fixture.wrapped" && codes[1] == "fixture.literal" && codes[2] == "fixture.detailed" && codes[3] == "fixture.target" && codes[4] == "fixture.warning",
        "modular diagnostics must discover only literal code arguments")
}

ExplainInventory :: (test: *NativeTest) -> bool {
    item: JsonDocument; listing: JsonDocument
    if !NativeAssert(test, JsonRead(*item, NativeRead(test, CheckPath(test.work, "item.json"))) && JsonRead(*listing, NativeRead(test, CheckPath(test.work, "list.json"))), "malformed explain JSON") { return false }
    if !NativeAssert(test, JsonCount(*item, item.root) == 5 && CheckInteger(*item, item.root, "schema_version") == 1 && CheckField(*item, item.root, "stability") == "stable-code" &&
        CheckField(*item, item.root, "code") == "zir.noncanonical" && CheckField(*item, item.root, "summary") == "A saved-IR input or serialization is invalid or noncanonical." &&
        CheckField(*item, item.root, "next_step") == "Regenerate .zir from current source instead of editing it, and verify that source and saved-IR checks agree.", "explain changed its stable noncanonical-IR description") { return false }
    nodes := JsonMember(*listing, listing.root, "codes")
    if !NativeAssert(test, CheckInteger(*listing, listing.root, "schema_version") == 1 && CheckField(*listing, listing.root, "stability") == "stable-code" && JsonKindOf(*listing, nodes) == .Array && JsonCount(*listing, nodes) > 0, "invalid explain registry schema") { return false }
    codes: Vec(string); suffixes := string.[".c", ".h"]; c_roots := string.["cmd", "bootstrap/runtime"]; calls := string.["Diagnostic", "DiagnosticV", "DiagnosticDetailed", "DiagnosticTarget", "Warning", "WasmGap"]
    for c_root: c_roots {
        for suffix: suffixes {
            files := NativeFiles(CheckPath(test.repo, c_root), suffix, true)
            for path: files {
                text := NativeRead(test, path); ExplainCalls(text, calls[:], *codes, 0)
                names := string.["DiagnosticOutOfMemory"]
                // Its fixed diagnostic code is supplied internally, with no literal argument.
                for name: names {
                    cursor: s64
                    while cursor < text.count {
                        at := TextFind(text, name, cursor); if at < 0 { break }; cursor = at + name.count
                        next := cursor; while next < text.count && ExplainSpace(text[next]) { next += 1 }
                        if next < text.count && text[next] == 40 { ExplainAdd(*codes, "compiler.memory"); break }
                    }
                }
            }
        }
    }
    files := NativeFiles(CheckPath(test.repo, "cmd"), ".zi")
    first_calls := string.["PkgFailCode", "Diagnostics.Emit", "WasmDiagnose"]; second_calls := string.["Diagnose", "Fatal", "Fail", "Report", "SayTarget", "Gap"]
    for path: files {
        text := NativeRead(test, path)
        ExplainCalls(text, first_calls[:], *codes, 1)
        ExplainCalls(text, second_calls[:], *codes, 2)
        if !ExplainZiDiagnostics(test, text, *codes) { return false }
    }
    if test.failed { return false }
    SortText(codes[:])
    if codes.count != JsonCount(*listing, nodes) {
        for code: codes {
            found := false
            for index: cast(s32)0..JsonCount(*listing, nodes) - 1 { found = found || JsonIs(*listing, JsonElement(*listing, nodes, index), code) }
            if !found { print("Missing explain code: %\n", code) }
        }
        for index: cast(s32)0..JsonCount(*listing, nodes) - 1 {
            code := JsonString(*listing, JsonElement(*listing, nodes, index)); found := false
            for emitted: codes { found = found || emitted == code }
            if !found { print("Unemitted explain code: %\n", code) }
        }
    }
    if !NativeAssert(test, codes.count == JsonCount(*listing, nodes), "explain registry count differs from independently discovered emitted codes") { return false }
    for index: cast(s64)0..codes.count - 1 {
        if !NativeAssert(test, JsonIs(*listing, JsonElement(*listing, nodes, cast(s32)index), codes[index]), CheckConcat("explain registry sorting or coverage differs at emitted code ", codes[index])) { return false }
    }
    return true
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "explain-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    return ifx ExplainModularDiscovery(*test) && ExplainInventory(*test) && !test.failed then 0 else 1
}
