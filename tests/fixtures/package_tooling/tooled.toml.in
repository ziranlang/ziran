[package]
name = "Tooled"
entry = "src/app.zi"
tool = "Tooling"
links = ["gio-2.0", "gdk_pixbuf-2.0"]
[toolchain]
git = "@TOOLCHAIN@"
ref = "master"
[dependencies.Tooling]
git = "@TOOLING@"
ref = "master"
[install]
bin = "tooled"
[tool.Tooling]
mode = "fast"
[tool.Tooling.targets.b]
kind = "x"
[tool.Tooling.targets.a]
kind = "y"
level = "3"
