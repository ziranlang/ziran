
#import "vorbis_linux"
#import "vorbis"
#import "file"
#import "number_text"
#import "text_tools"
#import "byte_text_linux"

Append :: (out: *Vec(u8), value: s64) {
    digits: [24]u8
    text := FormatInteger(value, digits[:])
    for at: 0..text.count - 1 { VecPush(<<out, text[at]) }
    VecPush(<<out, cast(u8)10)
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    report: Vec(u8)
    if TextFromCString(argv[1]) == "sizes" {
        value0: OggSyncState
        Append(*report, size_of(OggSyncState))
        Append(*report, cast(s64)(cast(usize)*value0.data - cast(usize)*value0))
        Append(*report, cast(s64)(cast(usize)*value0.storage - cast(usize)*value0))
        Append(*report, cast(s64)(cast(usize)*value0.fill - cast(usize)*value0))
        Append(*report, cast(s64)(cast(usize)*value0.returned - cast(usize)*value0))
        Append(*report, cast(s64)(cast(usize)*value0.unsynced - cast(usize)*value0))
        Append(*report, cast(s64)(cast(usize)*value0.headerbytes - cast(usize)*value0))
        Append(*report, cast(s64)(cast(usize)*value0.bodybytes - cast(usize)*value0))
        value1: OggStreamState
        Append(*report, size_of(OggStreamState))
        Append(*report, cast(s64)(cast(usize)*value1.body_data - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.body_storage - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.body_fill - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.body_returned - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.lacing_vals - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.granule_vals - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.lacing_storage - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.lacing_fill - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.lacing_packet - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.lacing_returned - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.header - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.header_fill - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.e_o_s - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.b_o_s - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.serialno - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.pageno - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.packetno - cast(usize)*value1))
        Append(*report, cast(s64)(cast(usize)*value1.granulepos - cast(usize)*value1))
        value2: OggPackBuffer
        Append(*report, size_of(OggPackBuffer))
        Append(*report, cast(s64)(cast(usize)*value2.endbyte - cast(usize)*value2))
        Append(*report, cast(s64)(cast(usize)*value2.endbit - cast(usize)*value2))
        Append(*report, cast(s64)(cast(usize)*value2.buffer - cast(usize)*value2))
        Append(*report, cast(s64)(cast(usize)*value2.ptr - cast(usize)*value2))
        Append(*report, cast(s64)(cast(usize)*value2.storage - cast(usize)*value2))
        value3: VorbisInfo
        Append(*report, size_of(VorbisInfo))
        Append(*report, cast(s64)(cast(usize)*value3.version - cast(usize)*value3))
        Append(*report, cast(s64)(cast(usize)*value3.channels - cast(usize)*value3))
        Append(*report, cast(s64)(cast(usize)*value3.rate - cast(usize)*value3))
        Append(*report, cast(s64)(cast(usize)*value3.bitrate_upper - cast(usize)*value3))
        Append(*report, cast(s64)(cast(usize)*value3.bitrate_nominal - cast(usize)*value3))
        Append(*report, cast(s64)(cast(usize)*value3.bitrate_lower - cast(usize)*value3))
        Append(*report, cast(s64)(cast(usize)*value3.bitrate_window - cast(usize)*value3))
        Append(*report, cast(s64)(cast(usize)*value3.codec_setup - cast(usize)*value3))
        value4: VorbisDspState
        Append(*report, size_of(VorbisDspState))
        Append(*report, cast(s64)(cast(usize)*value4.analysisp - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.vi - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.pcm - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.pcmret - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.pcm_storage - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.pcm_current - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.pcm_returned - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.preextrapolate - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.eofflag - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.lW - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.W - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.nW - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.centerW - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.granulepos - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.sequence - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.glue_bits - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.time_bits - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.floor_bits - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.res_bits - cast(usize)*value4))
        Append(*report, cast(s64)(cast(usize)*value4.backend_state - cast(usize)*value4))
        value5: VorbisBlock
        Append(*report, size_of(VorbisBlock))
        Append(*report, cast(s64)(cast(usize)*value5.pcm - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.opb - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.lW - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.W - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.nW - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.pcmend - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.mode - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.eofflag - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.granulepos - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.sequence - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.vd - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.localstore - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.localtop - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.localalloc - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.totaluse - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.reap - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.glue_bits - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.time_bits - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.floor_bits - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.res_bits - cast(usize)*value5))
        Append(*report, cast(s64)(cast(usize)*value5.internal - cast(usize)*value5))
        value6: VorbisCallbacks
        Append(*report, size_of(VorbisCallbacks))
        Append(*report, cast(s64)(cast(usize)*value6.read - cast(usize)*value6))
        Append(*report, cast(s64)(cast(usize)*value6.seek - cast(usize)*value6))
        Append(*report, cast(s64)(cast(usize)*value6.close - cast(usize)*value6))
        Append(*report, cast(s64)(cast(usize)*value6.tell - cast(usize)*value6))
        value7: VorbisFile
        Append(*report, size_of(VorbisFile))
        Append(*report, cast(s64)(cast(usize)*value7.datasource - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.seekable - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.offset - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.end - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.oy - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.links - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.offsets - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.dataoffsets - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.serialnos - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.pcmlengths - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.vi - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.vc - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.pcm_offset - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.ready_state - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.current_serialno - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.current_link - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.bittrack - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.samptrack - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.os - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.vd - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.vb - cast(usize)*value7))
        Append(*report, cast(s64)(cast(usize)*value7.callbacks - cast(usize)*value7))
        return ifx WriteEntireFile(TextFromCString(argv[2]), BuilderFinish(report)) then 0 else 3
    }
    input: Vec(u8)
    if TextFromCString(argv[1]) == "probe" {
        if !ReadFileInto(TextFromCString(argv[2]), *input) { return 3 }
        declared: VorbisAudio
        if !VorbisProbe(VecSlice(input, 0, input.count), *declared) {
            return ifx declared.frames == 0 && declared.channels == 0 then 2 else 4
        }
        Append(*report, declared.channels); Append(*report, declared.rate); Append(*report, declared.frames)
        return ifx WriteEntireFile(TextFromCString(argv[3]), BuilderFinish(report)) then 0 else 3
    }
    if !ReadFileInto(TextFromCString(argv[1]), *input) { return 3 }
    limit, ok := TextInteger(TextFromCString(argv[3]))
    if !ok { return 3 }
    pcm: Vec(u8)
    audio: VorbisAudio
    if !VorbisDecode(VecSlice(input, 0, input.count), *pcm, limit, *audio) {
        if pcm.count != 0 || audio.frames != 0 { return 4 }
        return 2
    }
    if pcm.count != audio.frames * audio.channels * 2 { return 4 }
    Append(*report, audio.channels); Append(*report, audio.rate); Append(*report, audio.frames)
    if !WriteEntireFile(TextFromCString(argv[4]), BuilderFinish(report)) { return 3 }
    return ifx WriteEntireFile(TextFromCString(argv[2]), BuilderFinish(pcm)) then 0 else 3
}
