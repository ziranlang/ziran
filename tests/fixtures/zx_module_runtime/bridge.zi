using Modules :: #import "std/zx_module"

host_api :: #system_library "host_api";
AddExternal :: (handle: u64, amount: s32) -> s32 #foreign host_api;

Total :: (amount: s32) -> s32 {
    counter := Modules.Load("Counter.v1")
    if counter == 0 { return -1 }
    total := AddExternal(counter, amount)
    if !Modules.Release(counter) { return -2 }
    return total
}
