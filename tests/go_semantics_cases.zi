GoSliceNil :: (go: *GoCase) {
    GoSources(go, "native.zi")
    GoRun(go, "$ziran ir --root $work --module-path std -o $work/ir $work/native.zi")
    GoBlank(go, "native.zir", "go_slice_nil.txt")
    for form: go_forms {
        GoForm(go, form, "native")
        GoRun(go, "$ziran build --target=go --no-main --pkg main --root $root --module-path std -o $out $file")
        GoHost(go)
        GoRun(go, "GO111MODULE=off go run -race $out/*.go")
        GoRun(go, "$ziran bundle --entry native:Answer --root $root --module-path std -o $work/$form.zx $file")
        GoPrints(go, "$ziran run $work/$form.zx", "42")
    }
    GoSame(go, "native.go")
    template := #string ZI
#import "go_types"
#import "vec"
builtin :: #system_library "go:builtin";
Box :: struct { values: Vec(u8) }
Result :: struct { value: bool }
%s
ZI
    declarations := #string ZI
Bad :: () -> bool #foreign builtin "is_nil";
Bad :: (value: []u8, second: []u8) -> bool #foreign builtin "is_nil";
Bad :: (value: []u8) -> isize #foreign builtin "is_nil";
Bad :: (value: []u8) #foreign builtin "is_nil";
Bad :: (value: [2]u8) -> bool #foreign builtin "is_nil";
Bad :: (value: string) -> bool #foreign builtin "is_nil";
Bad :: (value: Any) -> bool #foreign builtin "is_nil";
Bad :: (value: *u8) -> bool #foreign builtin "is_nil";
Bad :: (value: Vec(u8)) -> bool #foreign builtin "is_nil";
Bad :: (value: []Box) -> bool #foreign builtin "is_nil";
Bad :: (value: []u8) -> Result #go_results #foreign builtin "is_nil";
Bad :: (value: []u8) -> bool #go_defer #foreign builtin "is_nil";
ZI
    GoRejects(go, "$ziran check --root $work --module-path std $work/bad.zi", template, declarations, "invalid Go nil check accepted")
    GoPassed(go, "Go slice nilness, allocated empty storage, typed signatures and saved IR: passed")
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    // Heaviest cases launch first so shorter cases fill their shadow.
    cases := GoCaseEntry.[.{"bind", GoBind}, .{"defer", GoDefer}, .{"error_values", GoErrorValues},
        .{"fields", GoFields}, .{"many_parameters", GoManyParameters}, .{"foreign_types", GoForeignTypes},
        .{"results", GoResults}, .{"slice_nil", GoSliceNil}, .{"select", GoSelect}, .{"maps", GoMaps}]
    return GoGroup(argc, argv, "go-semantics-", cases[:])
}
