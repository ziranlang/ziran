#import "native_test"
#import "check_support"
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_tree_linux"
#import "std/path"
#import "std/text_tools"
using Vectors :: #import "std/vec"

HostNumber :: (number: s64) -> string {
    text := CheckNumber(number)
    while text.count < 3 { text = CheckConcat("0", text) }
    return text
}

QualifiedHostCalls :: (test: *NativeTest) -> bool {
    source := CheckPath(test.work, "qualified.zi")
    bundle := CheckPath(test.work, "qualified.zx")
    prefix := "using Host :: #import \"solo\";\n#program_export\nAnswer :: () -> s64 { return "
    command: [9]string = .[test.ziran, "bundle", "--root", test.work,
        "--entry", "qualified:Answer", "-o", bundle, source]
    if !NativeWrite(test, source, CheckConcat(prefix, "Host.Only(Host.seed) }\n")) { return false }
    unused NativeRun(test, command[:])
    run: [2]string = .[CheckPath(test.work, "test"), bundle]
    unused NativeRun(test, run[:])
    ir := CheckPath(test.work, "qualified-ir")
    save: [8]string = .[test.ziran, "ir", "--target=zx", "--root", test.work, "-o", ir, source]
    unused NativeRun(test, save[:])
    saved_bundle := CheckPath(test.work, "qualified-saved.zx")
    from_ir: [9]string = .[test.ziran, "bundle", "--root", ir, "--entry", "qualified:Answer",
        "-o", saved_bundle, CheckPath(ir, "qualified.zir")]
    unused NativeRun(test, from_ir[:])
    if !NativeAssert(test, NativeSameFile(bundle, saved_bundle), "qualified source and saved bundles differ") { return false }

    implementation := CheckPath(test.work, "implementation.zi")
    if !NativeWrite(test, implementation,
        "#program_export\nOnly :: (value: s64) -> s64 { return value + 1 }\n") { return false }
    bound: [12]string = .[test.ziran, "run", "--backend", "engine", "--root", test.work,
        "--entry", "qualified:Answer", "--bind-host", "implementation", source, implementation]
    result := NativeRun(test, bound[:])
    if !NativeAssert(test, result.output == "9\n", "qualified call did not use its Ziran host provider") { return false }

    calls: [3]string = .["Host.Missing()", "Host.Hidden(7)", "Host.Only(\"bad\")"]
    errors: [3]string = .["unresolved function: Host.Missing", "unresolved function: Host.Hidden", "argument type mismatch"]
    for call, index: calls {
        if !NativeWrite(test, source, CheckConcat(prefix, CheckConcat(call, " }\n"))) { return false }
        rejected := NativeInvoke(test, command[:])
        if !NativeAssert(test, rejected.code != 0 && TextContains(rejected.error, errors[index]),
            CheckConcat("unexpected diagnostic for ", CheckConcat(call, CheckConcat("\n", rejected.error)))) { return false }
    }
    if !NativeWrite(test, source,
        "Host :: #import \"solo\";\n#program_export\nAnswer :: () -> s64 { Host.Only(7); return 0 }\n") { return false }
    discarded := NativeInvoke(test, command[:])
    return NativeAssert(test, discarded.code != 0 && TextContains(discarded.error, "#must return value is ignored"),
        CheckConcat("qualified call dropped a required result\n", discarded.error))
}

// A rejected --bind names the side that is missing, or both providers when
// a capability is bound twice. Uses the solo host module and the
// implementation provider QualifiedHostCalls writes.
BindingDiagnostics :: (test: *NativeTest) -> bool {
    source := CheckPath(test.work, "qualified.zi")
    implementation := CheckPath(test.work, "implementation.zi")
    second := CheckPath(test.work, "second.zi")
    if !NativeWrite(test, source, "using Host :: #import \"solo\";\n#program_export\nAnswer :: () -> s64 { return Host.Only(Host.seed) }\n") ||
       !NativeWrite(test, second, "#program_export\nOnly :: (value: s64) -> s64 { return value + 2 }\n") { return false }
    specs: [3]string = .["solo:Nope=implementation:Only", "solo:Only=implementation:Nope", "solo:Only=second:Only"]
    errors: [3]string = .["host capability is missing: solo:Nope=implementation:Only; module solo declares no host capability Nope",
        "exported Ziran provider is missing: solo:Only=implementation:Nope; no module implementation exports Nope",
        "host capability solo:Only is already bound by implementation:Only ("]
    for spec, index: specs {
        command: [15]string = .[test.ziran, "run", "--backend", "engine", "--root", test.work, "--entry", "qualified:Answer",
            "--bind", "solo:Only=implementation:Only", "--bind", spec, source, implementation, second]
        if index < 2 { command[9] = spec }
        rejected := NativeInvoke(test, command[:])
        if !NativeAssert(test, rejected.code != 0 && TextContains(rejected.error, errors[index]),
            CheckConcat("unexpected --bind diagnostic for ", CheckConcat(spec, CheckConcat("\n", rejected.error)))) { return false }
        if index == 2 && !NativeAssert(test, TextContains(rejected.error, "implementation.zi); second:Only (") &&
           TextContains(rejected.error, "second.zi) also provides it"), CheckConcat("--bind diagnostic names no files\n", rejected.error)) { return false }
    }
    return true
}

// An authored provider named main is an ordinary module procedure. Its C
// symbol must also survive lowering saved modules as separate programs.
SavedNativeProvider :: (test: *NativeTest) -> bool {
    root := CheckPath(test.work, "native-provider")
    source := CheckPath(root, "main.zi")
    bridge := CheckPath(root, "bridge.zi")
    selected := CheckPath(root, "selected.tsx")
    if !NativeWrite(test, source,
        "using Bridge :: #import \"bridge\";\n#program_export\nmain :: (argc: s32, argv: **u8) -> s32 { unused argc; unused argv; return Bridge.Call() }\n") ||
       !NativeWrite(test, bridge,
        "host :: #system_library \"host_api\";\nRun :: () -> s32 #foreign host;\nCall :: () -> s32 { return Run() }\n") ||
       !NativeWrite(test, selected, "export function main(): s32 { return s32(7); }\n") { return false }
    ir := CheckPath(root, "ir")
    save := string.[test.ziran, "ir", "--target=c", "--entry", "main:main",
        "--bind", "bridge:Run=selected:main", "--root", root, "-o", ir, source, bridge, selected]
    unused NativeRun(test, save[:])
    forms := string.["source", "saved"]
    for form: forms {
        output := CheckPath(root, form)
        command: Vec(string)
        build := string.[test.ziran, "build", "--target=c", "--no-main"]
        for argument: build { VecPush(command, argument) }
        if form == "source" {
            inputs := string.["--entry", "main:main", "--bind", "bridge:Run=selected:main",
                "--root", root, "-o", output, source, bridge, selected]
            for argument: inputs { VecPush(command, argument) }
        } else {
            inputs := string.["--root", ir, "-o", output]
            for argument: inputs { VecPush(command, argument) }
            files := NativeFiles(ir, ".zir")
            for file: files { VecPush(command, file) }
        }
        unused NativeRun(test, command[:])
        executable := CheckPath(root, CheckConcat(form, "-native"))
        compile: Vec(string)
        compiler := string.["cc", "-std=c11", "-O2", "-o", executable]
        for argument: compiler { VecPush(compile, argument) }
        files := NativeFiles(output, ".c")
        for file: files { VecPush(compile, file) }
        VecPush(compile, "-lm")
        unused NativeRun(test, compile[:])
        run := string.[executable]
        unused NativeRun(test, run[:], expected = 7)
        if test.failed { return false }
    }
    return true
}

// An imported foreign declaration keeps its native signature and ABI through
// TSX namespaces, re-exports, nested arguments and saved checked IR.
ImportedForeignCalls :: (test: *NativeTest) -> bool {
    root := CheckPath(test.work, "imported-foreign")
    guest := CheckPath(root, "guest.tsx")
    driver := CheckPath(root, "driver.zi")
    if !NativeWrite(test, CheckPath(root, "capabilities.zi"),
        "host :: #system_library \"host_api\";\nFrame :: struct { value: s32; }\nRead :: (value: s32) -> Frame #must #foreign host;\n#scope_module\nHidden :: () -> s32 #foreign host;\n") ||
       !NativeWrite(test, CheckPath(root, "facade.zi"), "using Capabilities :: #import \"capabilities\";\n") ||
       !NativeWrite(test, guest,
        "import * as Native from \"facade\";\nimport { Read } from \"capabilities\";\nexport function Answer(): s32 { const result: Native.Frame = Native.Read(Read(s32(6)).value); return result.value === s32(8) ? s32(0) : s32(1); }\n") ||
       !NativeWrite(test, driver,
        "Guest :: #import \"guest\";\nCapabilities :: #import \"capabilities\";\n#program_export\nRead :: (value: s32) -> Capabilities.Frame { return .{value = value + 1} }\n#program_export\nAnswer :: () -> s32 { return Guest.Answer() }\n") { return false }
    ir := CheckPath(root, "ir")
    save := string.[test.ziran, "ir", "--entry", "driver:Answer", "--bind",
        "capabilities:Read=driver:Read", "--root", root, "-o", ir, driver]
    unused NativeRun(test, save[:])
    forms := string.["source", "saved"]
    targets := string.["c", "go", "zx"]
    backends := string.["engine", "native"]
    for form: forms {
        source_root := ifx form == "source" then root else ir
        input := CheckPath(source_root, ifx form == "source" then "driver.zi" else "driver.zir")
        for target: targets {
            output := CheckPath(root, CheckConcat(form, CheckConcat("-", target)))
            command: Vec(string)
            VecPush(command, test.ziran)
            if target == "zx" {
                VecPush(command, "bundle")
                output = CheckConcat(output, ".zx")
            } else {
                VecPush(command, "build")
                VecPush(command, CheckConcat("--target=", target))
                VecPush(command, "--exe")
                if target == "go" { VecPush(command, "--pkg"); VecPush(command, "main") }
            }
            arguments := string.["--entry", "driver:Answer", "--root", source_root, "-o", output]
            for argument: arguments { VecPush(command, argument) }
            if form == "source" {
                VecPush(command, "--bind"); VecPush(command, "capabilities:Read=driver:Read")
            }
            VecPush(command, input)
            unused NativeRun(test, command[:])
            if target == "zx" {
                tools := PathParent(test.ziran)
                for backend: backends {
                    run := string.[CheckPath(tools, "zi2zx"), "run", "--backend", backend, output]
                    if !NativeExpect(test, run[:], "0\n") { return false }
                }
            } else if target == "c" {
                run := string.[CheckPath(output, "driver")]
                unused NativeRun(test, run[:])
            } else {
                run := string.["env", "GO111MODULE=off", "go", "run", "."]
                unused NativeRun(test, run[:], output)
            }
            if test.failed { return false }
        }
    }
    if !NativeAssert(test, NativeSameFile(CheckPath(root, "source-zx.zx"), CheckPath(root, "saved-zx.zx")),
        "imported host source and saved bundles differ") { return false }
    check := string.[test.ziran, "check", "--root", root, guest]
    failures := string.["Native.Read(\"wrong\")", "Native.Hidden()", "Native.Read(s32(6))"]
    errors := string.["argument type mismatch", "unresolved function: Native.Hidden", "#must return value is ignored"]
    for call, index: failures {
        text := CheckConcat("import * as Native from \"facade\";\nexport function Answer(): s32 { ",
            CheckConcat(call, "; return s32(0); }\n"))
        if !NativeWrite(test, guest, text) || !NativeReject(test, check[:], errors[index]) { return false }
    }
    // Native foreign symbols retain the declared external name after projection.
    if !NativeWrite(test, CheckPath(root, "native.zi"),
        "c :: #system_library \"c\";\nAbs :: (value: s32) -> s32 #foreign c \"abs\";\nhost :: #system_library \"host_api\";\nabs :: (value: s32) -> s32 #foreign host;\n") ||
       !NativeWrite(test, guest,
        "import { Abs, abs } from \"native\";\nexport function main(): s32 { return Abs(s32(-42)) === s32(42) && abs(s32(-42)) === s32(42) ? s32(0) : s32(1); }\n") { return false }
    native_ir := CheckPath(root, "native-ir")
    save_native := string.[test.ziran, "ir", "--target=c", "--entry", "guest:main",
        "--root", root, "-o", native_ir, guest]
    unused NativeRun(test, save_native[:])
    for form: forms {
        source_root := ifx form == "source" then root else native_ir
        input := CheckPath(source_root, ifx form == "source" then "guest.tsx" else "guest.zir")
        native := CheckPath(root, CheckConcat("native-c-", form))
        build := string.[test.ziran, "build", "--target=c", "--exe", "--entry", "guest:main",
            "--root", source_root, "-o", native, input]
        unused NativeRun(test, build[:])
        run := string.[CheckPath(native, "guest")]
        unused NativeRun(test, run[:])
        if test.failed { return false }
    }
    return !test.failed
}

// Reuse the real host oracle: TSX imports must request only solo.Only,
// including the original declaration's module initializer and saved IR.
ImportedCapabilityIdentity :: (test: *NativeTest) -> bool {
    source := CheckPath(test.work, "imported.tsx")
    if !NativeWrite(test, source,
        "import * as Host from \"solo\";\nimport { Only } from \"solo\";\nexport function Answer(): s64 { return Only(Host.seed); }\n") { return false }
    ir := CheckPath(test.work, "imported-ir")
    save := string.[test.ziran, "ir", "--root", test.work, "-o", ir, source]
    unused NativeRun(test, save[:])
    forms := string.["source", "saved"]
    for form: forms {
        root := ifx form == "source" then test.work else ir
        input := ifx form == "source" then source else CheckPath(ir, "imported.zir")
        bundle := CheckPath(test.work, CheckConcat("imported-", CheckConcat(form, ".zx")))
        build := string.[test.ziran, "bundle", "--entry", "imported:Answer", "--root", root, "-o", bundle, input]
        unused NativeRun(test, build[:])
        run := string.[CheckPath(test.work, "test"), bundle]
        unused NativeRun(test, run[:])
        bound := string.[test.ziran, "run", "--backend", "engine", "--root", root,
            "--entry", "imported:Answer", "--bind-host", "implementation", input, CheckPath(test.work, "implementation.zi")]
        if !NativeExpect(test, bound[:], "9\n") { return false }
    }
    return NativeAssert(test, NativeSameFile(CheckPath(test.work, "imported-source.zx"),
        CheckPath(test.work, "imported-saved.zx")), "imported source and saved capabilities differ")
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "host-bindings-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    declarations: Vec(u8)
    calls: Vec(u8)
    provider_calls: Vec(u8)
    BuilderAppend(declarations, "host_api :: #system_library \"host_api\";\n")
    for index: cast(s64)0..63 {
        name := CheckConcat("H", HostNumber(index))
        BuilderAppend(declarations, CheckConcat(name, " :: (value: s64) -> s64 #foreign host_api;\n"))
        BuilderAppend(calls, CheckConcat("value = ", CheckConcat(name, "(value)\n")))
        BuilderAppend(provider_calls, CheckConcat("value = ", CheckConcat(name,
            ifx index == 0 then "(Identity(value))\n" else "(value)\n")))
    }
    host := TextDetach(BuilderFinish(declarations))
    called := TextDetach(BuilderFinish(calls))
    provider: [4]string = .[host,
        "NeverCalled :: () -> s64 #foreign host_api;\nIdentity :: (value: $T) -> T { return value }\n#program_export\nNext :: (input: s64) -> s64 {\nvalue := input\n",
        TextDetach(BuilderFinish(provider_calls)), "return value\n}\n#program_export\nmain :: () -> s64 { return Next(7) }\n"]
    if !NativeWrite(*test, CheckPath(test.work, "provider.zi"), TextJoin(provider[:], "")) { return 1 }
    app: [5]string = .["#import \"provider\"\n", host, "seed: s64 = H000(7);\n#program_export\nAnswer :: () -> s64 {\nvalue := Next(seed)\n", called, "return value\n}\n"]
    if !NativeWrite(*test, CheckPath(test.work, "app.zi"), TextJoin(app[:], "")) { return 1 }
    expected: u64 = (cast(u64)7 * cast(u64)48271 + cast(u64)1001) & cast(u64)9223372036854775807
    for group: cast(u64)0..cast(u64)1 {
        for index: cast(u64)0..cast(u64)63 {
            expected = (expected * cast(u64)48271 + index + cast(u64)1 + group * cast(u64)1000) & cast(u64)9223372036854775807
        }
    }
    ir := CheckPath(test.work, "ir")
    save: [7]string = .[test.ziran, "ir", "--root", test.work, "-o", ir, CheckPath(test.work, "app.zi")]
    unused NativeRun(*test, save[:])
    forms: [2]string = .["source", "saved"]
    for form: forms {
        root := ifx form == "source" then test.work else ir
        input := ifx form == "source" then CheckPath(test.work, "app.zi") else CheckPath(ir, "app.zir")
        bundle := CheckPath(test.work, CheckConcat("app-", CheckConcat(form, ".zx")))
        command: [9]string = .[test.ziran, "bundle", "--root", root, "--entry", "app:Answer", "-o", bundle, input]
        unused NativeRun(*test, command[:])
        run: [3]string = .[CheckPath(test.work, "test"), bundle, NativeUnsigned(expected)]
        unused NativeRun(*test, run[:])
    }
    if !NativeAssert(*test, NativeSameFile(CheckPath(test.work, "app-source.zx"),
        CheckPath(test.work, "app-saved.zx")), "source/saved host bundles differ") { return 1 }
    solo := CheckPath(test.work, "solo.zi")
    if !NativeWrite(*test, solo, "host_api :: #system_library \"host_api\";\nOnly :: (value: s64) -> s64 #must #foreign host_api;\n#scope_module\nHidden :: (value: s64) -> s64 #foreign host_api;\n#scope_export\nseed: s64 = Only(7);\n#program_export\nAnswer :: () -> s64 { return Only(seed) }\n") { return 1 }
    single_ir := CheckPath(test.work, "single-ir")
    single: [7]string = .[test.ziran, "ir", "--root", test.work, "-o", single_ir, solo]
    unused NativeRun(*test, single[:])
    for form: forms {
        root := ifx form == "source" then test.work else single_ir
        input := ifx form == "source" then solo else CheckPath(single_ir, "solo.zir")
        bundle := CheckPath(test.work, CheckConcat("single-", CheckConcat(form, ".zx")))
        command: [9]string = .[test.ziran, "bundle", "--root", root, "--entry", "solo:Answer", "-o", bundle, input]
        unused NativeRun(*test, command[:])
        run: [2]string = .[CheckPath(test.work, "test"), bundle]
        unused NativeRun(*test, run[:])
    }
    if !NativeAssert(*test, NativeSameFile(CheckPath(test.work, "single-source.zx"), CheckPath(test.work, "single-saved.zx")), "single host bundles differ") { return 1 }
    if !QualifiedHostCalls(*test) || !BindingDiagnostics(*test) || !SavedNativeProvider(*test) ||
       !ImportedForeignCalls(*test) || !ImportedCapabilityIdentity(*test) { return 1 }
    // A host result record whose name is longer than eight bytes, as
    // Kryon's ReadBundleInput returns BundleInput: lowering keeps the whole
    // name and resolves the record.
    records := CheckPath(test.work, "records.zi")
    if !NativeWrite(*test, records, "host_api :: #system_library \"host_api\";\nProcessStart :: struct { handle: s32; error: string }\nStartHostProcess :: (handle: s32) -> ProcessStart #foreign host_api;\n#program_export\nAnswer :: () -> s32 { started := StartHostProcess(1); return started.handle }\n") { return 1 }
    record_bundle: [9]string = .[test.ziran, "bundle", "--root", test.work, "--entry", "records:Answer",
        "-o", CheckPath(test.work, "records.zx"), records]
    unused NativeRun(*test, record_bundle[:])
    if test.failed { return 1 }
    print("128 host bindings passed in source and saved bundles; qualified host calls and long-named result records passed\n")
    return 0
}
