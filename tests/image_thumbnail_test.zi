// Frozen Pillow 12.3.0 PNG/RGBA oracles. No Python or Pillow at test time.
I :: #import "std/image"
#import "std/png_linux"
#import "std/file"
#import "std/text_tools"
#import "std/binary"
#import "std/math"
#import "std/format"

Same :: (left: *I.Image, right: *I.Image) -> bool {
    if left.width != right.width || left.height != right.height || left.pixels.count != right.pixels.count { return false }
    for at: 0..left.pixels.count - 1 {
        if left.pixels[at] != right.pixels[at] { return false }
    }
    return true
}

// This entry is also exercised through Go and source/saved-IR portable VM.
Portable :: () -> s32 {
    source := I.NewImage(3, 2)
    pixels: [24]u8 = .[200,100,50,0, 40,80,120,128, 90,170,220,255, 220,80,30,255, 70,150,210,17, 10,230,110,192]
    for at: 0..23 { source.pixels[at] = pixels[at] }
    copy := I.Thumbnail(*source, 256, 512)
    if !Same(*source, *copy) { return 1 }
    copy.pixels[0] = 1
    if source.pixels[0] != 200 { return 2 }
    equal := I.ResizeBicubic(*source, 3, 2)
    if !Same(*source, *equal) { return 3 }
    reduced := I.ResizeBicubic(*source, 2, 1)
    expected: [8]u8 = .[185,71,47,103,49,181,168,169]
    if reduced.width != 2 || reduced.height != 1 { return 4 }
    for at: 0..7 { if reduced.pixels[at] != expected[at] { return 5 } }
    with_gap := I.ResizeBicubic(*source, 2, 1, 1.0)
    if !Same(*reduced, *with_gap) { return 6 }
    narrow := I.NewImage(5, 7, 17, 39, 219, 128)
    aspect := I.Thumbnail(*narrow, 1, 80)
    if aspect.width != 1 || aspect.height != 2 { return 7 }
    invalid: I.Image
    empty := I.Thumbnail(*invalid, 256, 512)
    if I.ImageValid(*empty) { return 8 }
    bad_size := I.Thumbnail(*source, 0, 20)
    if I.ImageValid(*bad_size) { return 9 }
    bad_gap := I.ResizeBicubic(*source, 2, 1, 0.5)
    if I.ImageValid(*bad_gap) { return 10 }
    bad_nan := I.ResizeBicubic(*source, 2, 1, NotANumber())
    bad_inf := I.Thumbnail(*source, 1, 1, Infinity())
    if I.ImageValid(*bad_nan) || I.ImageValid(*bad_inf) { return 11 }
    // Pillow thumbnail returns an unchanged image before validating the gap;
    // resize validates the gap even for an unchanged size.
    noop_bad_gap := I.Thumbnail(*source, 256, 512, 0.5)
    if !Same(*source, *noop_bad_gap) { return 12 }
    equal_bad_gap := I.ResizeBicubic(*source, 3, 2, 0.5)
    if I.ImageValid(*equal_bad_gap) { return 13 }
    return 0
}

Number :: (text: string) -> s32 {
    value, ok := TextInteger(text)
    return ifx ok then cast(s32)value else -1
}

Fixture :: (name: string, extension: string) -> string {
    path: Vec(u8)
    Append(*path, "tests/data/image_thumbnail/")
    Append(*path, name)
    Append(*path, extension)
    return BuilderFinish(path)
}

Transform :: (image: *I.Image, thumbnail: bool, width: s32, height: s32, gap: float64) -> I.Image {
    if thumbnail {
        if gap == 2.0 { return I.Thumbnail(image, width, height) }
        return I.Thumbnail(image, width, height, gap)
    }
    if gap == 0.0 { return I.ResizeBicubic(image, width, height) }
    return I.ResizeBicubic(image, width, height, gap)
}

main :: () -> s32 {
    smoke := Portable()
    if smoke != 0 { print("image thumbnail portable case % failed\n", smoke); return 1 }
    manifest, found := ReadEntireFile(Fixture("oracles", ".txt"))
    if !found { print("Missing image thumbnail oracle manifest\n"); return 2 }
    count: s32 = 0
    lines := TextLines(manifest)
    for lines {
        if it.count == 0 || TextHasPrefix(it, "#") { continue }
        fields := TextSplit(it, " ")
        if fields.count != 9 { return 3 }
        name := fields[0]
        image := ReadPNGFile(Fixture(fields[1], ".png"))
        if !I.ImageValid(*image) { print("Invalid input %\n", name); return 4 }
        original := I.CopyImage(*image)
        width := Number(fields[3])
        height := Number(fields[4])
        gap := ifx fields[5] == "4.5" then 4.5 else cast(float64)Number(fields[5])
        actual := Transform(*image, fields[2] == "t", width, height, gap)
        if !Same(*image, *original) { print("Source changed: %\n", name); return 5 }
        reference, ok := ReadEntireFile(Fixture(name, ".rgba"))
        if !ok || reference.count < 8 { print("Missing oracle %\n", name); return 6 }
        reference_width := cast(s32)ReadU32LE(reference, 0)
        reference_height := cast(s32)ReadU32LE(reference, 4)
        if reference_width != Number(fields[6]) || reference_height != Number(fields[7]) { return 7 }
        if actual.width != reference_width || actual.height != reference_height || actual.pixels.count != reference.count - 8 {
            print("Dimensions %: got %x%, expected %x%\n", name, actual.width, actual.height, reference_width, reference_height)
            return 8
        }
        for at: 0..actual.pixels.count - 1 {
            if actual.pixels[at] != reference[at + 8] {
                print("RGBA % byte %: got %, expected %\n", name, at, actual.pixels[at], reference[at + 8])
                return 9
            }
        }
        count += 1
    }
    if count != 40 { return 10 }
    print("std/image: % frozen Pillow 12.3.0 thumbnail/bicubic oracles match width, height and every RGBA byte\n", count)
    return 0
}
