#import "native_test"
#import "check_support"
#import "check_cache"
#import "std/byte_text_linux"
#import "std/file_linux"
#import "std/file_tree_linux"
#import "std/process_run_linux"
#import "std/text_tools"
#import "std/timer_linux"
using Vectors :: #import "std/vec"

// ZX Runner and its desktop integration: the .zx file type and the
// default opener, checked with the desktop's own tools inside the test prefix.
CheckZxRunner :: (test: *NativeTest, share: string, data: string) -> bool {
    hello := CheckPath(test.work, "hello.zx")
    source := CheckPath(test.work, "hello_zx.zi")
    if !NativeWrite(test, source, "main :: () { print(\"Hello, zx\\n\") }\n") { return false }
    build := string.[test.ziran, "bundle", "--root", test.work, "--entry", "hello_zx:main", "-o", hello, source]
    unused NativeRun(test, build[:])
    entry := CheckPath(data, "applications/org.ziran_lang.zx.desktop")
    types := CheckPath(data, "mime/packages/ziran-zx.xml")
    validate := string.["desktop-file-validate", entry]
    unused NativeRun(test, validate[:])
    xml := string.["xmllint", "--noout", types]
    unused NativeRun(test, xml[:])
    if test.failed { return false }
    text := NativeRead(test, entry)
    runner := CheckPath(share, "build/bin/zx")
    exec := CheckConcat(CheckConcat("\nExec=", runner), " %f\n")
    if !NativeAssert(test, TextContains(text, exec) && TextContains(text, "\nMimeType=application/x-ziran-bundle;\n"), "desktop entry does not open .zx files with the installed zx") { return false }
    if !NativeAssert(test, TextContains(NativeRead(test, CheckPath(data, "mime/globs2")), "application/x-ziran-bundle:*.zx\n"), "update-mime-database did not register *.zx") { return false }
    icon_sizes := string.["16x16", "22x22", "24x24", "32x32", "48x48", "64x64", "128x128", "256x256", "512x512"]
    for size: icon_sizes {
        app_icon := NativeRead(test, CheckPath(CheckPath(CheckPath(data, "icons/hicolor"), size), "apps/org.ziran_lang.zx.png"))
        mime_icon := NativeRead(test, CheckPath(CheckPath(CheckPath(data, "icons/hicolor"), size), "mimetypes/application-x-ziran-bundle.png"))
        if !NativeAssert(test, app_icon.count > 8 && app_icon[0] == 137 && app_icon[1] == #char "P" && app_icon[2] == #char "N" && app_icon[3] == #char "G", "installed app icon is not a PNG") { return false }
        if !NativeAssert(test, mime_icon.count > 8 && mime_icon[0] == 137 && mime_icon[1] == #char "P" && mime_icon[2] == #char "N" && mime_icon[3] == #char "G", "installed .zx mime icon is not a PNG") { return false }
    }
    // The header alone identifies a .zx program that lost its extension.
    unnamed := CheckPath(test.work, "hello-copy")
    if !NativeWrite(test, unnamed, NativeRead(test, hello)) { return false }
    by_name := string.["xdg-mime", "query", "filetype", hello]
    by_header := string.["xdg-mime", "query", "filetype", unnamed]
    opener := string.["xdg-mime", "query", "default", "application/x-ziran-bundle"]
    unused NativeExpect(test, by_name[:], "application/x-ziran-bundle\n")
    unused NativeExpect(test, by_header[:], "application/x-ziran-bundle\n")
    unused NativeExpect(test, opener[:], "org.ziran_lang.zx.desktop\n")
    // What the file manager runs: the entry's Exec line with the file for %f.
    line := text[TextFind(text, "\nExec=") + 6:]
    line = line[0:TextFind(line, "\n")]
    words := TextSplit(line, " ")
    for words { if it == "%f" { words[it_index] = hello } }
    unused NativeExpect(test, VecSlice(words, 0, words.count), "Hello, zx\n")
    junk := CheckPath(test.work, "junk.zx")
    if !NativeWrite(test, junk, "not a program\n") { return false }
    wrong := string.[runner, junk]
    rejected := NativeRun(test, wrong[:], "", 1)
    if !NativeAssert(test, !test.failed && TextContains(rejected.error, "junk.zx is not a ZX program"), "zx did not explain a file that is not a ZX program") { return false }
    // A capability the runner lacks is an error; nothing else runs the app.
    window := CheckPath(test.work, "window_gap.zx")
    importer := CheckPath(test.work, "window_gap.zi")
    if !NativeWrite(test, importer, "host_api :: #system_library \"host_api\";\nOpenWindowHost :: (width: s32, height: s32) -> s32 #foreign host_api;\nmain :: () -> s32 { return OpenWindowHost(640, 480) }\n") { return false }
    gap_build := string.[test.ziran, "bundle", "--root", test.work, "--entry", "window_gap:main", "-o", window, importer]
    unused NativeRun(test, gap_build[:])
    gap := string.[runner, window]
    missing := NativeRun(test, gap[:], "", 1)
    if !NativeAssert(test, !test.failed && TextContains(missing.error, "window_gap.zx needs capabilities this ZX Runner does not provide: window_gap:OpenWindowHost"), "zx did not name a capability it lacks") { return false }
    // The base capabilities: arguments, files and the bundle's own assets.
    assets := CheckPath(test.work, "zx-assets")
    if !CreateDirectory(assets) || !NativeWrite(test, CheckPath(assets, "greeting.txt"), "from the bundle\n") { return false }
    base_source := CheckPath(test.work, "base_zx.zi")
    if !NativeWrite(test, base_source, "Process :: #import \"std/guest_process\";\nFiles :: #import \"std/guest_files\";\nAssets :: #import \"std/guest_assets\";\nmain :: () -> s32 {\n    path := Process.Argument(1)\n    greeting, found := Assets.AssetFind(\"zx-assets/greeting.txt\")\n    if !found || !Files.FileWrite(path, greeting) { return 2 }\n    copy, ok := Files.FileRead(path)\n    print(\"% % %\", Process.ArgumentCount(), ok, copy)\n    return 0\n}\n") { return false }
    base := CheckPath(test.work, "base_zx.zx")
    base_build := string.[test.ziran, "bundle", "--root", test.work, "--asset-dir", CheckConcat("zx-assets=", assets), "--entry", "base_zx:main", "-o", base, base_source]
    unused NativeRun(test, base_build[:])
    copied := string.[runner, base, CheckPath(test.work, "base-copy.txt")]
    if !NativeExpect(test, copied[:], "2 true from the bundle\n") { return false }
    // The window set, on a private display.
    window_source := CheckPath(test.work, "window_zx.zi")
    if !NativeWrite(test, window_source, "#import \"std/guest_window\"\nmain :: () -> s32 {\n    if !WindowOpen(\"zx check\", 64, 48, false) { return 2 }\n    pixels: [64 * 48 * 4]u8\n    for index: 0..pixels.count - 1 { pixels[index] = 200 }\n    shown := WindowPresent(pixels[:], 64, 48)\n    print(\"window % % %\\n\", WindowWidth(), WindowHeight(), shown)\n    WindowClose()\n    return 0\n}\n") { return false }
    window_bundle := CheckPath(test.work, "window_zx.zx")
    window_build := string.[test.ziran, "bundle", "--root", test.work, "--entry", "window_zx:main", "-o", window_bundle, window_source]
    unused NativeRun(test, window_build[:])
    NativeSet(test, "SDL_VIDEODRIVER", "x11")
    shown := string.["xvfb-run", "-a", runner, window_bundle]
    return NativeExpect(test, shown[:], "window 64 48 true\n")
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "install-user-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    make := CheckExecutable("gmake"); if make == "" { make = CheckExecutable("make") }
    share := CheckPath(test.work, "bootstrap")
    bin := CheckPath(test.work, "bin")
    data := CheckPath(test.work, "data")
    // The desktop tools read and write only this prefix's data and settings.
    NativeSet(*test, "HOME", test.work)
    NativeSet(*test, "XDG_DATA_HOME", data)
    NativeSet(*test, "XDG_CONFIG_HOME", CheckPath(test.work, "config"))
    desktops := string.["XDG_CURRENT_DESKTOP", "DESKTOP_SESSION", "KDE_FULL_SESSION", "GNOME_DESKTOP_SESSION_ID"]
    for name: desktops { NativeUnset(*test, name) }
    // Reuse the exact already-built toolchain during a disposable installation.
    command := string.[make, "--no-print-directory", "-s", "-o", "all", "install-user", CheckConcat("BUILD_DIR=", PathParent(PathParent(test.ziran))), CheckConcat("USER_BIN=", bin), CheckConcat("USER_SHARE=", share), CheckConcat("USER_DATA=", data)]
    unused NativeRun(*test, command[:])
    source := CheckPath(test.work, "live.zi")
    if !NativeWrite(*test, source, "#program_export\nmain :: () -> s32 { while true {} return 0 }\n") { return 1 }
    bundle := CheckPath(test.work, "live.zx")
    build := string.[test.ziran, "bundle", "--root", test.work, "--entry", "live:main", "-o", bundle, source]
    unused NativeRun(*test, build[:])
    installed := CheckPath(share, "build/bin/zi2zx")
    before := PathStatus(installed)
    run := string.[installed, "run", bundle]
    child: ProcessRun
    options: ProcessOptions = .{.arguments = run[:], .environment = test.environment[:], .new_session = true,
        .output_path = CheckPath(test.work, "busy.stdout"), .error_path = CheckPath(test.work, "busy.stderr")}
    if !NativeAssert(*test, !test.failed && StartProcess(options, *child), "start installed runner") { return 1 }
    defer {
        if !PollProcess(*child) { unused SignalProcess(*child, 15, true) }
        unused WaitProcess(*child)
    }
    unused SleepMilliseconds(100)
    if !NativeAssert(*test, !PollProcess(*child), "busy runner exited before reinstall") { return 1 }
    unused NativeRun(*test, command[:])
    after := PathStatus(installed)
    if !NativeAssert(*test, before.identity_valid && after.identity_valid && before.inode != after.inode && !PollProcess(*child), "installation interrupted the busy executable or overwrote its inode") { return 1 }
    if !NativeAssert(*test, NativeSameFile(installed, CheckPath(PathParent(test.ziran), "zi2zx")), "installed binary differs") { return 1 }
    version := string.[CheckPath(bin, "ziran"), "version"]
    actual := NativeRun(*test, version[:])
    if !NativeAssert(*test, TextHasPrefix(actual.output, "ziran "), "installed launcher failed") { return 1 }
    hello := CheckPath(test.work, "hello.zi")
    if !NativeWrite(*test, hello, "main :: () { print(\"Hello, World!\\n\") }\n") { return 1 }
    ziran := string.[CheckPath(bin, "ziran"), "run", "hello.zi"]
    direct := string.[CheckPath(bin, "zi2zx"), "run", "hello.zi"]
    unused NativeExpect(*test, ziran[:], "Hello, World!\n", test.work)
    unused NativeExpect(*test, direct[:], "Hello, World!\n", test.work)
    if !NativeAssert(*test, NativeSameFile(CheckPath(share, "build/bin/zx"), CheckPath(PathParent(test.ziran), "zx")), "installed zx differs") { return 1 }
    if !CheckZxRunner(*test, share, data) { return 1 }
    tools := string.["ziran", "zi2zx", "zx"]
    marker := "#!/bin/sh\n# Owner's existing launcher\nexit 23\n"
    for tool: tools { if !NativeWrite(*test, CheckPath(bin, tool), marker) { return 1 } }
    unused NativeRun(*test, command[:])
    for tool: tools {
        if !NativeAssert(*test, NativeRead(*test, CheckPath(bin, tool)) == marker, "installation overwrote an existing launcher") { return 1 }
    }
    if test.failed { return 1 }
    print("Local installation tests: busy binaries, existing launchers, both one-line run commands and ZX Runner's desktop integration passed\n")
    return 0
}
