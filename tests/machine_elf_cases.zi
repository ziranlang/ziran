using Elf :: #import "compiler_machine_elf"
using Image :: #import "compiler_machine_image"
using Lir :: #import "compiler_lowered_ir"
using Machine :: #import "compiler_machine_ir"
using Pipeline :: #import "compiler_machine_pipeline"
using Target :: #import "compiler_target"
using X64 :: #import "compiler_x86_64"

Check :: (condition: bool, message: string) -> bool {
    if condition { return true }
    print("machine ELF local test failed: %\n", message)
    return false
}

Little :: (bytes: []u8, at: s64, count: s32) -> u64 {
    value: u64 = 0
    for index: 0..count - 1 {
        value = value | (cast(u64)bytes[at + index] << cast(u64)(index * 8))
    }
    return value
}

Signed32 :: (bytes: []u8, at: s64) -> s64 {
    value := Little(bytes, at, 4)
    return ifx value >= 0x80000000 then cast(s64)value - 4294967296 else cast(s64)value
}

Equal :: (left: []u8, right: []u8) -> bool {
    if left.count != right.count { return false }
    for index: cast(s64)0..left.count - 1 { if left[index] != right[index] { return false } }
    return true
}

// A finite budget, so the fixture keeps its fuel check: an unbounded one, the
// default, builds without fuel.
TestFuel :: 1000000
// The budget a bundle run starts with, which measuring takes.
Unbounded :: 9223372036854775807

// The fixture calls no host capability, so its executable links nothing.
Static :: () -> Elf.MachineElfHosts {
    hosts: Elf.MachineElfHosts
    return hosts
}

// How far the data segment maps above its file offset.
DataShift :: (layout: Elf.MachineElfResult) -> s64 { return layout.data_address - layout.data_offset }

Instruction :: (op: Lir.LirOp, result: s32 = -1) -> Lir.LirInstruction {
    return .{op = op, result = result, symbol = -1, origin = -1}
}

BuildTarget :: (owner: *Pipeline.MachineNativeOwner, target: Target.TargetDescription,
    readonly: bool = false,
    limits: Machine.MachineLimits = Machine.MachineDefaultLimits(),
    startup: bool = false) -> Machine.MachineDiagnostic {
    modules: [1]string = .["machine_elf"]
    types: [7]Lir.LirType = .[.{kind = .Void}, .{kind = .Bool, bits = 1},
        .{kind = .Integer, bits = 64, is_signed = true}, .{kind = .Pointer, element = 2},
        .{kind = .Integer, bits = 8}, .{kind = .Array, element = 4, count = 8},
        .{kind = .Pointer, element = 5}]
    readonly_bytes: [8]u8 = .[42, 0, 0, 0, 0, 0, 0, 0]
    constants: [2]Lir.LirConstant = .[.{type = 2, bits = 42},
        .{type = 5, bytes = readonly_bytes[:]}]
    globals: [1]Lir.LirGlobal = .[.{module = 0, name = "state",
        type = ifx readonly then 5 else 2, constant = ifx readonly then 1 else -1,
        writable = !readonly}]
    values: [3]s32 = .[ifx readonly then 6 else 3, 2, 2]
    store_operands: [2]s32 = .[0, 1]
    load_operands: [1]s32 = .[0]
    return_operands: [1]s32 = .[2]
    readonly_return: [1]s32 = .[1]
    instructions: [6]Lir.LirInstruction
    instructions[0] = Instruction(.Fuel); instructions[0].immediate = 1; instructions[0].effect = 1
    instructions[1] = Instruction(.GlobalAddress, 0); instructions[1].symbol = 0
    instructions[2] = Instruction(.Constant, 1); instructions[2].symbol = 0
    instructions[3] = Instruction(.Store); instructions[3].operands = store_operands[:]; instructions[3].effect = 2
    instructions[4] = Instruction(.Load, 2); instructions[4].operands = load_operands[:]; instructions[4].effect = 3
    instructions[5] = Instruction(.Return); instructions[5].operands = return_operands[:]
    code := instructions[:]
    function_values := values[:]
    if readonly {
        instructions[2] = Instruction(.Constant, 1); instructions[2].symbol = 0
        instructions[3] = Instruction(.Return); instructions[3].operands = readonly_return[:]
        code = instructions[0:4]
        function_values = values[0:2]
    }
    blocks: [1]Lir.LirBlock = .[.{instructions = code}]
    init_instructions: [1]Lir.LirInstruction = .[Instruction(.Return)]
    init_blocks: [1]Lir.LirBlock = .[.{instructions = init_instructions[:]}]
    functions: [2]Lir.LirFunction = .[.{module = 0, name = "initialize", result = 0,
        blocks = init_blocks[:], entry = 0, origin = -1},
        .{module = 0, name = "answer", result = 2,
        values = function_values, blocks = blocks[:], entry = 0, origin = -1}]
    initializer_ids: [1]s32 = .[0]
    initializers := initializer_ids[0:0]
    if startup { initializers = initializer_ids[:] }
    program := Lir.LirProgram.{version = Lir.LirVersion, modules = modules[:], types = types[:],
        constants = constants[:], globals = globals[:], initializers = initializers,
        functions = functions[:], entry = 1}
    links: Pipeline.MachineHostLinks
    return Pipeline.MachineNativeBuild(program, target, limits, owner, TestFuel, links)
}

StartupInitializers :: () -> bool {
    owner: Pipeline.MachineNativeOwner
    diagnostic := BuildTarget(*owner, Target.TargetLinuxX64(), false,
        Machine.MachineDefaultLimits(), true)
    if !Check(diagnostic.problem == .None, "startup initializer pipeline") {
        Pipeline.MachineNativeFree(*owner); return false
    }
    bytes := Pipeline.MachineNativeView(*owner)
    empty: [0]u8
    layout := Elf.MachineElfEncode(owner.machine.program, owner.encoded.image, empty[:], Unbounded, Static())
    initializer_target := cast(s64)(0x400000 + layout.text_offset + layout.startup_size +
        owner.encoded.image.functions[0].begin)
    // No function checks its stack, so _start sets no limit and first calls
    // the initializer, then the entry.
    field := cast(s64)(0x400000 + layout.text_offset + 1)
    result := Check(bytes[layout.text_offset] == 0xe8 && bytes[layout.text_offset + 5] == 0xe8 &&
        Signed32(bytes, layout.text_offset + 1) == initializer_target - 4 - field,
        "startup calls the initializer before entry")
    image := Pipeline.MachineCodeImageView(*owner)
    result = result && Check(image.initializers.count == 1 && image.initializers[0] == 0,
        "machine image retains ordered initializer identities")
    Pipeline.MachineNativeFree(*owner)
    return result
}

PlatformImage :: () -> bool {
    modules: [2]string = .["machine_platform", "ziran.platform"]
    types: [4]Lir.LirType = .[.{kind = .Void}, .{kind = .Integer, bits = 64},
        .{kind = .Integer, bits = 8}, .{kind = .Pointer, element = 2}]
    constants: [2]Lir.LirConstant = .[.{type = 1, bits = 1}, .{type = 1, bits = 0}]
    values: [3]s32 = .[1, 3, 1]
    empty: [0]s32
    arguments: [3]s32 = .[0, 1, 2]
    instructions: [6]Lir.LirInstruction
    instructions[0] = Instruction(.Constant, 0); instructions[0].symbol = 0
    instructions[1] = Instruction(.Null, 1)
    instructions[2] = Instruction(.Constant, 2); instructions[2].symbol = 1
    instructions[3] = Instruction(.Fuel); instructions[3].immediate = 1; instructions[3].effect = 1
    instructions[4] = Instruction(.HostCall); instructions[4].symbol = 1
    instructions[4].operands = arguments[:]; instructions[4].effect = 2
    instructions[5] = Instruction(.Return)
    blocks: [1]Lir.LirBlock = .[.{instructions = instructions[:]}]
    parameters: [3]s32 = .[1, 3, 1]
    functions: [2]Lir.LirFunction = .[
        .{module = 0, name = "main", result = 0, values = values[:], blocks = blocks[:],
            entry = 0, origin = -1},
        .{module = 1, name = "ziran.platform.write_all", result = 0,
            parameters = parameters[:], calling = .Host, external = true, entry = -1, origin = -1}]
    program := Lir.LirProgram.{version = Lir.LirVersion, modules = modules[:], types = types[:],
        constants = constants[:], functions = functions[:], entry = 0}
    owner: Pipeline.MachineNativeOwner
    diagnostic := Pipeline.MachineCodeBuild(program, Target.TargetLinuxX64(),
        Machine.MachineDefaultLimits(), *owner)
    if !Check(diagnostic.problem == .None && Pipeline.MachineNativeView(*owner).count == 0,
        "machine-code build accepts a platform service without requiring an ELF veneer") {
        Pipeline.MachineNativeFree(*owner); return false
    }
    image := Pipeline.MachineCodeImageView(*owner)
    saw_platform := false
    for relocation: image.relocations {
        if relocation.kind == .PlatformService && relocation.symbol == 1 { saw_platform = true }
    }
    result := Check(Image.MachineImageValidate(image).problem == .None && saw_platform,
        "machine image retains the platform-service relocation")
    Pipeline.MachineNativeFree(*owner)
    return result
}

Build :: (owner: *Pipeline.MachineNativeOwner, readonly: bool = false) -> Machine.MachineDiagnostic {
    return BuildTarget(owner, Target.TargetLinuxX64(), readonly)
}

Headers :: (owner: *Pipeline.MachineNativeOwner) -> bool {
    bytes := Pipeline.MachineNativeView(owner)
    machine_image := Pipeline.MachineCodeImageView(owner)
    if !Check(Image.MachineImageValidate(machine_image).problem == .None &&
        machine_image.code.bytes.count == owner.encoded.image.code.count &&
        machine_image.global_offsets.count == owner.machine.program.globals.count,
        "pipeline publishes the target-neutral machine image") { return false }
    empty: [0]u8
    measured := Elf.MachineElfEncode(owner.machine.program, owner.encoded.image, empty[:], Unbounded, Static())
    if !Check(measured.diagnostic.problem == .None && measured.size == bytes.count,
        "measure matches published write") { return false }
    if !Check(bytes.count > measured.data_offset + measured.data_size && measured.text_offset == 240 &&
            measured.data_offset >= measured.text_offset + measured.text_size, "headers, text, data, then section data") ||
        !Check(Little(bytes, 40, 8) + 10 * 64 == cast(u64)bytes.count &&
            Little(bytes, 58, 2) == 64 && Little(bytes, 60, 2) == 10 &&
            Little(bytes, 62, 2) == 9, "the section header table describes the image") ||
        !Check(Little(bytes, 0, 4) == 0x464c457f, "ELF magic") ||
        !Check(bytes[4] == 2 && bytes[5] == 1 && bytes[6] == 1, "ELF64 little-endian identity") ||
        !Check(Little(bytes, 16, 2) == 2 && Little(bytes, 18, 2) == 62, "ET_EXEC x86-64") ||
        !Check(Little(bytes, 24, 8) == cast(u64)(0x400000 + measured.text_offset), "process entry starts the text") ||
        !Check(Little(bytes, 32, 8) == 64 && Little(bytes, 54, 2) == 56 &&
            Little(bytes, 56, 2) == 3, "exact program header table") ||
        !Check(Little(bytes, 64, 4) == 1 && Little(bytes, 68, 4) == 5 &&
            Little(bytes, 64 + 48, 8) == 4096, "RX load segment") ||
        !Check(Little(bytes, 120, 4) == 1 && Little(bytes, 124, 4) == 6 &&
            Little(bytes, 120 + 48, 8) == 4096, "RW non-executable load segment") {
        return false
    }
    // The unwind records follow the text inside the read-only load, and the
    // program header table names them for debuggers and perf.
    sections := cast(s64)Little(bytes, 40, 8)
    eh := sections + 8 * 64
    if !Check(measured.eh_frame_offset >= measured.text_offset + measured.text_size &&
            measured.eh_frame_size > 0 &&
            measured.eh_frame_offset + measured.eh_frame_size <= measured.data_offset,
            "unwind records lie after the text in the first load") ||
        !Check(Little(bytes, 176, 4) == 0x6474e550 && Little(bytes, 180, 4) == 4 &&
            Little(bytes, 184, 8) == cast(u64)measured.eh_frame_offset &&
            Little(bytes, 192, 8) == cast(u64)(0x400000 + measured.eh_frame_offset) &&
            Little(bytes, 200, 8) == cast(u64)(0x400000 + measured.eh_frame_offset) &&
            Little(bytes, 208, 8) == cast(u64)measured.eh_frame_size &&
            Little(bytes, 216, 8) == cast(u64)measured.eh_frame_size &&
            Little(bytes, 224, 8) == 4,
            "PT_GNU_EH_FRAME names the mapped unwind records") ||
        !Check(Little(bytes, eh + 4, 4) == 1 && (Little(bytes, eh + 8, 8) & 2) == 2 &&
            Little(bytes, eh + 16, 8) == cast(u64)(0x400000 + measured.eh_frame_offset) &&
            Little(bytes, eh + 24, 8) == cast(u64)measured.eh_frame_offset &&
            Little(bytes, eh + 32, 8) == cast(u64)measured.eh_frame_size &&
            Little(bytes, eh + 48, 8) == 4,
            ".eh_frame is an allocated read-only section") {
        return false
    }
    if !Check(Little(bytes, 120 + 8, 8) == cast(u64)measured.data_offset &&
            Little(bytes, 120 + 16, 8) == cast(u64)(0x400000 + measured.data_address) &&
            DataShift(measured) == 4096, "data maps one page above its file offset") ||
        !Check(Little(bytes, measured.fuel_offset, 8) == TestFuel, "deterministic initial fuel") ||
        !Check(measured.trap_status_offset >= measured.data_offset + measured.data_size, "trap status is zero fill") {
        return false
    }
    storage: [16384]u8
    written := Elf.MachineElfEncode(owner.machine.program, owner.encoded.image,
        storage[0:measured.size], TestFuel, Static())
    return Check(written.diagnostic.problem == .None && written.size == measured.size &&
        Equal(bytes, storage[0:measured.size]), "exact repeated measure/write bytes")
}

Relocations :: (owner: *Pipeline.MachineNativeOwner) -> bool {
    bytes := Pipeline.MachineNativeView(owner)
    empty: [0]u8
    layout := Elf.MachineElfEncode(owner.machine.program, owner.encoded.image, empty[:], Unbounded, Static())
    if !Check(layout.diagnostic.problem == .None && owner.encoded.image.relocations.count >= 3,
        "global, fuel and trap relocations are retained") { return false }
    // Globals are reached through checked pointers: their tokens are
    // constants, and resolving one names the pointer runtime header. An
    // access the shared facts prove (this fixture's only global, at the start
    // of the data) addresses the global's bytes directly.
    saw_global := false; saw_fuel := false; saw_trap := false
    for relocation: owner.encoded.image.relocations {
        target: s64 = 0
        shift := DataShift(layout)
        if relocation.kind == .PointerRuntime { target = 0x400000 + layout.pointer_offset + shift; saw_global = true }
        else if relocation.kind == .GlobalAddress { target = 0x400000 + layout.data_address; saw_global = true }
        else if relocation.kind == .FuelCounter { target = 0x400000 + layout.fuel_offset + shift; saw_fuel = true }
        else if relocation.kind == .TrapHandler {
            target = 0x400000 + layout.text_offset + layout.startup_size + owner.encoded.image.code.count
            saw_trap = true
        } else { return Check(false, "unsupported relocation escaped") }
        field_file := layout.text_offset + layout.startup_size + relocation.offset
        field_virtual := 0x400000 + field_file
        if !Check(Signed32(bytes, field_file) == target + relocation.addend - field_virtual,
            "checked PC-relative relocation value") { return false }
    }
    return Check(saw_global && saw_fuel && saw_trap, "all relocation classes resolved")
}

Rejections :: (owner: *Pipeline.MachineNativeOwner) -> bool {
    sentinel: [32]u8
    for index: 0..31 { sentinel[index] = 0xa5 }
    first := owner.encoded.relocations[0]
    owner.encoded.relocations[0].kind = .Invalid
    rejected := Elf.MachineElfEncode(owner.machine.program, owner.encoded.image, sentinel[:], Unbounded, Static())
    owner.encoded.relocations[0] = first
    if !Check(rejected.diagnostic.problem == .Relocation, "invalid relocation kind rejected") { return false }
    for byte: sentinel { if !Check(byte == 0xa5, "invalid relocation preserves output") { return false } }

    global: s64 = -1
    for index: cast(s64)0..owner.encoded.relocations.count - 1 {
        kind := owner.encoded.relocations[index].kind
        if kind == .PointerRuntime || kind == .GlobalAddress { global = index; break }
    }
    if !Check(global >= 0, "global relocation fixture") { return false }
    saved := owner.encoded.relocations[global]
    owner.encoded.relocations[global].symbol = 99
    rejected = Elf.MachineElfEncode(owner.machine.program, owner.encoded.image, sentinel[:], Unbounded, Static())
    owner.encoded.relocations[global] = saved
    if !Check(rejected.diagnostic.problem == .Relocation, "unresolved runtime symbol rejected") { return false }
    owner.encoded.relocations[global].addend = 2147483648
    rejected = Elf.MachineElfEncode(owner.machine.program, owner.encoded.image, sentinel[:], Unbounded, Static())
    owner.encoded.relocations[global] = saved
    if !Check(rejected.diagnostic.problem == .Relocation, "out-of-range relocation rejected") { return false }
    owner.encoded.relocations[global].offset = owner.encoded.image.code.count
    rejected = Elf.MachineElfEncode(owner.machine.program, owner.encoded.image, sentinel[:], Unbounded, Static())
    owner.encoded.relocations[global] = saved
    if !Check(rejected.diagnostic.problem == .Relocation, "malformed relocation field rejected") { return false }
    relocations := owner.encoded.image.relocations
    owner.encoded.image.relocations = relocations[0:relocations.count - 1]
    rejected = Elf.MachineElfEncode(owner.machine.program, owner.encoded.image, sentinel[:], Unbounded, Static())
    owner.encoded.image.relocations = relocations
    return Check(rejected.diagnostic.problem == .Relocation, "missing relocation rejected")
}

Preservation :: (owner: *Pipeline.MachineNativeOwner) -> bool {
    before := Pipeline.MachineNativeView(owner)
    before_count := before.count
    fingerprint: u64 = 1469598103934665603
    for byte: before { fingerprint = (fingerprint ^ byte) * 1099511628211 }
    unsupported := Target.TargetDescribe(.AArch64, .Windows).target
    diagnostic := BuildTarget(owner, unsupported)
    after := Pipeline.MachineNativeView(owner)
    actual: u64 = 1469598103934665603
    for byte: after { actual = (actual ^ byte) * 1099511628211 }
    if !Check(diagnostic.problem == .UnsupportedTarget && before_count == after.count && fingerprint == actual,
        "failed pipeline preserves prior output") { return false }
    diagnostic = Build(owner, true)
    if !Check(diagnostic.problem == .None, "read-only initialized data is supported") { return false }
    after = Pipeline.MachineNativeView(owner)
    empty: [0]u8
    measured := Elf.MachineElfEncode(owner.machine.program, owner.encoded.image, empty[:], Unbounded, Static())
    // When the program resolves pointers at all, the read-only global's
    // pointer slot is live and not writable, so a store through it traps.
    flags: u64 = Image.MachinePointerLive
    if measured.pointer_offset >= 0 {
        table := cast(s64)Little(after, measured.pointer_offset + Image.MachinePointerHeaderTable, 8) - 0x400000 -
            DataShift(measured)
        flags = Little(after, table + Image.MachinePointerEntryBytes + Image.MachinePointerEntryFlags, 2)
    }
    if !Check(measured.diagnostic.problem == .None && !owner.machine.program.globals[0].writable &&
        flags == Image.MachinePointerLive, "read-only global has a read-only pointer slot") { return false }
    machine_image := Pipeline.MachineCodeImageView(owner)
    if !Check(machine_image.constants.bytes.count == 8 && machine_image.constants.bytes[0] == 42 &&
        machine_image.constant_offsets[0] == 0 && machine_image.global_offsets[0] == -1,
        "machine image carries initialized read-only bytes") { return false }
    return Check(Build(owner).problem == .None,
        "writable image restores after read-only preservation test")
}

Fingerprint :: (bytes: []u8) -> u64 {
    result: u64 = 1469598103934665603
    for byte: bytes { result = (result ^ byte) * 1099511628211 }
    return result
}

TransactionalView :: (owner: *Pipeline.MachineNativeOwner) -> bool {
    before := Pipeline.MachineNativeView(owner)
    if !Check(before.count > 0, "transaction starts with a nonempty native view") { return false }
    before_count := before.count
    before_fingerprint := Fingerprint(before)
    if !Check(Build(owner).problem == .None, "successful transactional replacement") { return false }
    replaced := Pipeline.MachineNativeView(owner)
    if !Check(replaced.count == before_count && Fingerprint(replaced) == before_fingerprint,
        "successful replacement publishes the built ELF view") { return false }

    limits := Machine.MachineDefaultLimits()
    limits.bytes = replaced.count - 1
    diagnostic := BuildTarget(owner, Target.TargetLinuxX64(), false, limits)
    preserved := Pipeline.MachineNativeView(owner)
    return Check(diagnostic.problem == .Limit && preserved.count == before_count &&
        Fingerprint(preserved) == before_fingerprint,
        "late ELF size failure preserves the prior owner bytes and view")
}

#program_export
main :: () -> s32 {
    owner: Pipeline.MachineNativeOwner
    diagnostic := Build(*owner)
    if !Check(diagnostic.problem == .None, "end-to-end pipeline") { return 1 }
    second: Pipeline.MachineNativeOwner
    if !Check(Build(*second).problem == .None &&
        Equal(Pipeline.MachineNativeView(*owner), Pipeline.MachineNativeView(*second)),
        "independent builds are byte deterministic") {
        Pipeline.MachineNativeFree(*second); Pipeline.MachineNativeFree(*owner); return 2
    }
    if !Check(Build(*owner).problem == .None &&
        Equal(Pipeline.MachineNativeView(*owner), Pipeline.MachineNativeView(*second)),
        "successful rebuild atomically replaces an existing owner") {
        Pipeline.MachineNativeFree(*second); Pipeline.MachineNativeFree(*owner); return 2
    }
    Pipeline.MachineNativeFree(*second)
    if !Headers(*owner) { Pipeline.MachineNativeFree(*owner); return 3 }
    if !Relocations(*owner) { Pipeline.MachineNativeFree(*owner); return 4 }
    if !Rejections(*owner) { Pipeline.MachineNativeFree(*owner); return 5 }
    if !Preservation(*owner) { Pipeline.MachineNativeFree(*owner); return 6 }
    if !TransactionalView(*owner) { Pipeline.MachineNativeFree(*owner); return 7 }
    if !StartupInitializers() { Pipeline.MachineNativeFree(*owner); return 8 }
    if !PlatformImage() { Pipeline.MachineNativeFree(*owner); return 9 }
    Pipeline.MachineNativeFree(*owner)
    return 0
}
