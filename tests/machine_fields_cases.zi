using Lir :: #import "compiler_lowered_ir"
using Lower :: #import "compiler_machine_lower"
using Machine :: #import "compiler_machine_ir"
using Verify :: #import "compiler_machine_verify"
using Target :: #import "compiler_target"
using Pipeline :: #import "compiler_machine_pipeline"

#scope_file

Instruction :: (op: Lir.LirOp, result: s32 = -1) -> Lir.LirInstruction {
    return .{op = op, result = result, symbol = -1, origin = -1}
}

// Every native target reads and changes members in place: ARM code once
// copied the whole record for each member read, which made frames larger
// than a thread's stack (Shovey's LevelReplayPump).
Targets :: () -> [3]Target.TargetDescription {
    return Target.TargetDescription.[Target.TargetLinuxX64(), Target.TargetDescribe(.ArmV7, .Android).target,
        Target.TargetDescribe(.AArch64, .Android).target]
}

// PROGRAM lowers, verifies and encodes for TARGET; its lowered form is in OWNER.
Lowered :: (owner: *Machine.MachineOwner, program: Lir.LirProgram, target: Target.TargetDescription,
    what: string) -> bool {
    limits := Machine.MachineDefaultLimits()
    lowered := Lower.MachineLower(owner, program, target, Machine.MachineDefaultOptions(), limits)
    if lowered.problem != .None {
        print("% lowering failed: arch % problem % lir %\n", what, cast(s32)target.arch,
            cast(s32)lowered.problem, lowered.lir_diagnostic_problem)
        return false
    }
    if Verify.MachineVerify(Lower.MachineProgramView(owner), limits).problem != .None {
        print("% verification failed: arch %\n", what, cast(s32)target.arch)
        return false
    }
    native: Pipeline.MachineNativeOwner
    defer Pipeline.MachineNativeFree(*native)
    built := Pipeline.MachineCodeBuild(program, target, limits, *native)
    if built.problem != .None {
        print("% encoding failed: arch % problem % instruction %\n", what, cast(s32)target.arch,
            cast(s32)built.problem, built.instruction)
        return false
    }
    return true
}

// A 128 KiB record read by one scalar field, through a nested array, across
// a write/call, through a nested view across a write, across blocks, or
// as a complete escaping snapshot.
Fixture :: (owner: *Machine.MachineOwner, target: Target.TargetDescription, mode: s32, checks: bool) -> bool {
    modules := string.["fields"]
    fields := s32.[2, 1]
    types := Lir.LirType.[.{kind = .Void}, .{kind = .Integer, bits = 32, is_signed = true},
        .{kind = .Array, element = 1, count = 32768}, .{kind = .Record, fields = fields[:]},
        .{kind = .Pointer, element = 3}, .{kind = .Pointer, element = 1}]
    constants := Lir.LirConstant.[.{type = 1, bits = 42}]
    globals := Lir.LirGlobal.[.{module = 0, name = "record", type = 3, constant = -1, writable = true}]
    values := s32.[4, 5, 1, 3, 1, 1]
    instructions: [8]Lir.LirInstruction
    address := s32.[0]
    storing := s32.[1, 2]
    aggregate := s32.[3]
    array_index := s32.[4, 2]
    answer := s32.[4]
    escaping := s32.[3]
    instructions[0] = Instruction(.GlobalAddress, 0); instructions[0].symbol = 0
    instructions[1] = Instruction(.FieldAddress, 1); instructions[1].operands = address[:]
    instructions[1].immediate = 1
    instructions[2] = Instruction(.Constant, 2); instructions[2].symbol = 0
    instructions[3] = Instruction(.Load, 3); instructions[3].operands = address[:]
    instructions[3].effect = 1
    at: s64 = 4
    count: s64 = 5
    if mode == 1 {
        instructions[at] = Instruction(.Store); instructions[at].operands = storing[:]
        instructions[at].effect = 2; at += 1
    } else if mode == 2 {
        instructions[at] = Instruction(.Call); instructions[at].symbol = 1
        instructions[at].effect = 2; at += 1
    }
    instructions[at] = Instruction(.Extract, 4)
    instructions[at].operands = aggregate[:]; instructions[at].immediate = 1
    at += 1
    if mode == 3 || mode == 5 {
        values[4] = 2
        count = 6
        instructions[at - 1].immediate = 0
        if mode == 5 {
            instructions[at] = Instruction(.Store); instructions[at].operands = storing[:]
            instructions[at].effect = 2; at += 1
        }
        instructions[at] = Instruction(.Extract, 5); instructions[at].operands = array_index[:]
        at += 1
        answer[0] = 5
    }
    instructions[at] = Instruction(.Return)
    instructions[at].operands = ifx mode == 4 then escaping[:] else answer[:]
    // Put the consumer first in the block array to exercise discovery of
    // load roots before uses, independently of block storage order.
    jump := Lir.LirInstruction.[Instruction(.Jump)]
    edges := Lir.LirEdge.[.{block = 0}]
    jump[0].edges = edges[:]
    cross_definition: [5]Lir.LirInstruction
    blocks := Lir.LirBlock.[.{instructions = instructions[:at + 1]}, .{}]
    block_count: s64 = 1
    if mode == 6 {
        for index: cast(s64)0..3 { cross_definition[index] = instructions[index] }
        cross_definition[4] = jump[0]
        blocks[0].instructions = instructions[4:at + 1]
        blocks[1].instructions = cross_definition[:]
        block_count = 2
    }
    empty_return := Lir.LirInstruction.[Instruction(.Return)]
    empty_blocks := Lir.LirBlock.[.{instructions = empty_return[:]}]
    functions := Lir.LirFunction.[
        .{module = 0, name = "read", result = ifx mode == 4 then 3 else 1,
            values = values[:count], blocks = blocks[:block_count], entry = ifx mode == 6 then 1 else 0, origin = -1},
        .{module = 0, name = "barrier", result = 0, blocks = empty_blocks[:], entry = 0, origin = -1}]
    program := Lir.LirProgram.{version = Lir.LirVersion, modules = modules[:], types = types[:],
        constants = constants[:], globals = globals[:], functions = functions[:], entry = 0, checks = checks}
    if !Lowered(owner, program, target, "field") { return false }
    mir := Lower.MachineProgramView(owner)
    copies: s64
    sparse: s64
    for instruction: mir.instructions {
        if instruction.opcode != .Load { continue }
        result := mir.operands[instruction.operand_begin]
        if result.class == .Stack {
            copies += 1
            if instruction.operand_count == 3 {
                selected := mir.operands[instruction.operand_begin + 2]
                if selected.kind != .Immediate || selected.immediate != 2 { return false }
                sparse += 1
            }
        }
    }
    expected_sparse: s64 = ifx target.arch == .X86_64 && !checks &&
        (mode == 1 || mode == 2 || mode == 6) then 1 else 0
    if sparse != expected_sparse {
        print("field snapshot mask failed: arch % mode % checks % sparse %\n",
            cast(s32)target.arch, mode, checks, sparse)
        return false
    }
    preserve := checks || mode == 1 || mode == 2 || mode == 4 || mode == 5 || mode == 6
    if (copies > 0) != preserve || !preserve && mir.stack_objects.count != 0 {
        print("field snapshot failed: arch % mode % checks % copies % objects %\n",
            cast(s32)target.arch, mode, checks, copies, mir.stack_objects.count)
        return false
    }
    return true
}

// Zero builds stored to a global. A record of a 64-element zero array and
// an s32 member: all zero (one zeroing, no member stores), with a nonzero
// member (the array alone is zeroed, then the record built), or with
// --checks (every member stored, as checked code zeroes nothing through a
// raw address). An array of 8 small records, each kept as split fields, is
// zeroed once too.
ZeroFixture :: (owner: *Machine.MachineOwner, target: Target.TargetDescription, nonzero: bool, checks: bool,
    records: bool = false) -> bool {
    modules := string.["zero"]
    fields := s32.[2, 1]
    small := s32.[1, 6]
    types := Lir.LirType.[.{kind = .Void}, .{kind = .Integer, bits = 32, is_signed = true},
        .{kind = .Array, element = 1, count = 64}, .{kind = .Record, fields = fields[:]},
        .{kind = .Pointer, element = 3}, .{kind = .Record, fields = small[:]}, .{kind = .Float, bits = 64},
        .{kind = .Array, element = 5, count = 8}, .{kind = .Pointer, element = 7}]
    constants := Lir.LirConstant.[.{type = 1, bits = 0}, .{type = 1, bits = 42}, .{type = 6, bits = 0}]
    globals := Lir.LirGlobal.[.{module = 0, name = "record", type = ifx records then cast(s32)7 else 3,
        constant = -1, writable = true}]
    values := s32.[4, 1, 2, 3, 1]
    // Records: the global's address, the s32 and float64 zeros, one small
    // record and the array of them.
    record_values := s32.[8, 1, 6, 5, 7]
    zeros: [64]s32
    for at: 0..63 { zeros[at] = 1 }
    members := s32.[2, ifx nonzero then cast(s32)4 else 1]
    pair := s32.[1, 2]
    cells := s32.[3, 3, 3, 3, 3, 3, 3, 3]
    storing := s32.[0, ifx records then cast(s32)4 else 3]
    instructions: [10]Lir.LirInstruction
    instructions[0] = Instruction(.GlobalAddress, 0); instructions[0].symbol = 0
    instructions[1] = Instruction(.Constant, 1); instructions[1].symbol = 0
    instructions[2] = Instruction(.Constant, 4); instructions[2].symbol = 1
    at: s64 = 3
    if records {
        instructions[2] = Instruction(.Constant, 2); instructions[2].symbol = 2
        instructions[at] = Instruction(.Aggregate, 3); instructions[at].operands = pair[:]; at += 1
        instructions[at] = Instruction(.Aggregate, 4); instructions[at].operands = cells[:]; at += 1
    } else {
        instructions[at] = Instruction(.Aggregate, 2); instructions[at].operands = zeros[:]; at += 1
        instructions[at] = Instruction(.Aggregate, 3); instructions[at].operands = members[:]; at += 1
    }
    instructions[at] = Instruction(.Store); instructions[at].operands = storing[:]; instructions[at].effect = 1; at += 1
    instructions[at] = Instruction(.Return); at += 1
    blocks := Lir.LirBlock.[.{instructions = instructions[:at]}]
    functions := Lir.LirFunction.[.{module = 0, name = "clear", result = 0,
        values = ifx records then record_values[:] else values[:],
        blocks = blocks[:], entry = 0, origin = -1}]
    program := Lir.LirProgram.{version = Lir.LirVersion, modules = modules[:], types = types[:],
        constants = constants[:], globals = globals[:], functions = functions[:], entry = 0, checks = checks}
    if !Lowered(owner, program, target, "zero build") { return false }
    mir := Lower.MachineProgramView(owner)
    zeroed: s64
    built: s64
    for instruction: mir.instructions {
        if instruction.opcode == .Zero { zeroed += 1 }
        if instruction.opcode == .AggregateBuild { built += 1 }
    }
    expected_zeroed: s64 = ifx checks then 0 else 1
    expected_built: s64 = ifx checks then 2 else ifx nonzero then 1 else 0
    if zeroed != expected_zeroed || built != expected_built {
        print("zero build failed: arch % nonzero % checks % records % zeroes % builds %\n", cast(s32)target.arch,
            nonzero, checks, records, zeroed, built)
        return false
    }
    return true
}

// A record read from an array, changed, then put back while the original
// snapshot remains live. The array needs storage; the small records do not.
RecordArray :: (owner: *Machine.MachineOwner, target: Target.TargetDescription, checks: bool) -> bool {
    modules := string.["record_array"]
    fields := s32.[1, 2, 3]
    types := Lir.LirType.[.{kind = .Void}, .{kind = .Integer, bits = 64, is_signed = true},
        .{kind = .Float, bits = 64}, .{kind = .Bool, bits = 1}, .{kind = .Record, fields = fields[:]},
        .{kind = .Array, element = 4, count = 4}, .{kind = .Pointer, element = 5}]
    constants := Lir.LirConstant.[.{type = 1, bits = 1}, .{type = 1, bits = 42}]
    globals := Lir.LirGlobal.[.{module = 0, name = "items", type = 5, constant = -1, writable = true}]
    values := s32.[6, 5, 1, 4, 1, 4, 5, 1]
    instructions := Lir.LirInstruction.[Instruction(.GlobalAddress, 0), Instruction(.Load, 1),
        Instruction(.Constant, 2), Instruction(.Extract, 3), Instruction(.Constant, 4),
        Instruction(.Insert, 5), Instruction(.Insert, 6), Instruction(.Store),
        Instruction(.Extract, 7), Instruction(.Return)]
    load := s32.[0]; read := s32.[1, 2]; change := s32.[3, 4]
    put := s32.[1, 5, 2]; store := s32.[0, 6]; old := s32.[3]; answer := s32.[7]
    instructions[0].symbol = 0
    instructions[1].operands = load[:]; instructions[1].effect = 1
    instructions[2].symbol = 0
    instructions[3].operands = read[:]
    instructions[4].symbol = 1
    instructions[5].operands = change[:]
    instructions[6].operands = put[:]
    instructions[7].operands = store[:]; instructions[7].effect = 2
    instructions[8].operands = old[:]
    instructions[9].operands = answer[:]
    blocks := Lir.LirBlock.[.{instructions = instructions[:]}]
    functions := Lir.LirFunction.[.{module = 0, name = "update", result = 1,
        values = values[:], blocks = blocks[:], entry = 0, origin = -1}]
    program := Lir.LirProgram.{version = Lir.LirVersion, modules = modules[:], types = types[:],
        constants = constants[:], globals = globals[:], functions = functions[:], entry = 0, checks = checks}
    if !Lowered(owner, program, target, "record array") { return false }
    mir := Lower.MachineProgramView(owner)
    copied := false
    for object: mir.stack_objects { if object.size == 17 { copied = true } }
    if copied != checks {
        print("record array snapshot storage failed: arch % checks % copied %\n", cast(s32)target.arch, checks, copied)
        return false
    }
    return true
}

#scope_export

MachineFieldsCases :: () -> bool {
    owner: Machine.MachineOwner
    defer Lower.MachineFree(*owner)
    targets := Targets()
    for target: targets {
        if !RecordArray(*owner, target, false) || !RecordArray(*owner, target, true) { return false }
        for mode: cast(s32)0..6 { if !Fixture(*owner, target, mode, false) { return false } }
        for mode: cast(s32)0..6 { if !Fixture(*owner, target, mode, true) { return false } }
        if !ZeroFixture(*owner, target, false, false) || !ZeroFixture(*owner, target, true, false) ||
            !ZeroFixture(*owner, target, false, true) || !ZeroFixture(*owner, target, false, false, true) { return false }
    }
    print("machine fields: on x86-64, ARMv7 and AArch64, scalar and nested reads avoid aggregate copies; nested writes, calls, cross-block uses, escapes and checks retain snapshots; all-zero builds zero their storage once\n")
    return true
}
