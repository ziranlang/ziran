using IR :: #import "compiler_lowered_ir"
using Machine :: #import "compiler_machine_ir"
using Pipeline :: #import "compiler_machine_pipeline"
using Target :: #import "compiler_target"
Check :: (condition: bool, message: string) -> bool {
    if condition { return true }
    print("native service local test failed: %\n", message)
    return false
}

Encode :: (functions: []LirFunction, modules: []string, types: []LirType) -> Machine.MachineDiagnostic {
    program := LirProgram.{.version = LirVersion, .modules = modules,
        .types = types, .functions = functions, .entry = 0}
    owner: Pipeline.MachineNativeOwner
    diagnostic := Pipeline.MachineCodeBuild(program, Target.TargetLinuxX64(),
        Machine.MachineDefaultLimits(), *owner)
    Pipeline.MachineNativeFree(*owner)
    return diagnostic
}

Symbols :: (functions: []LirFunction, modules: []string, types: []LirType) -> bool {
    constants: [1]LirConstant = .[.{.type = 2, .bits = 65}]
    globals: [1]LirGlobal = .[.{.module = 0, .name = "byte", .type = 2, .constant = 0, .writable = true}]
    for mode: 0..1 {
        program := LirProgram.{.version = LirVersion, .modules = modules,
            .types = types, .functions = functions, .constants = constants[:],
            .globals = globals[:mode], .entry = 0}
        owner: Pipeline.MachineNativeOwner
        result := Pipeline.MachineCodeBuild(program, Target.TargetLinuxX64(),
            Machine.MachineDefaultLimits(), *owner)
        if !Check(result.problem == .None && owner.valid,
            "build the service symbol fixture") {
            Pipeline.MachineNativeFree(*owner); return false
        }
        machine := owner.machine.program
        saw_service := false
        global_published := machine.globals.count == mode
        if machine.functions.count == 2 && machine.functions[1].calling == .Platform &&
            machine.functions[1].parameter_count == 3 && machine.functions[1].result_type == 0 {
            saw_service = true
        }
        published := saw_service && global_published
        Pipeline.MachineNativeFree(*owner)
        if !Check(published,
            "service declaration and writable global survive the machine program") { return false }
    }
    return true
}

#program_export
main :: () -> s32 {
    types: [4]LirType = .[
        .{.kind = .Void},
        .{.kind = .Integer, .bits = 64},
        .{.kind = .Integer, .bits = 8},
        .{.kind = .Pointer, .element = 2}
    ]
    modules: [2]string = .["native_services_cases", "ziran.platform"]
    returned: [1]LirInstruction = .[.{.op = .Return, .result = -1, .symbol = -1, .origin = -1}]
    blocks: [1]LirBlock = .[.{.instructions = returned[:]}]
    good_parameters: [3]s32 = .[1, 3, 1]
    functions: [2]LirFunction = .[
        .{.module = 0, .name = "main", .result = 0, .blocks = blocks[:],
            .entry = 0, .origin = -1},
        .{.module = 1, .name = "ziran.platform.write_all", .result = 0,
            .parameters = good_parameters[:], .calling = .Host, .external = true,
            .entry = -1, .origin = -1}
    ]
    if !Check(Encode(functions[:], modules[:], types[:]).problem == .None,
        "exact write_all(u64, *u8, u64) signature") { return 1 }
    if !Symbols(functions[:], modules[:], types[:]) { return 7 }
    return 0
}
