SliceAction :: #type (values: []float64) -> float64;
InvokeSlice :: (action: Scoped(SliceAction), values: []float64) -> float64 { return action(values) }
Parts :: (parts: [5]string) -> s32 {
    if parts.count != 5 { return 1 }
    if parts[0] != "Count: " || parts[1] != "7" || parts[2] != " " || parts[3] != "tail" || parts[4] != "!" { return 2 }
    return 0
}
