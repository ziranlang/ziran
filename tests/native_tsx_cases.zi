// The native TSX frontend constructs the same checked IR as other sources.
// Use library-neutral typed callables; no UI package is available to this test.
#import "native_test"
#import "check_support"
#import "package_fixture_support"
#import "std/path"
#import "std/file_tree_linux"
#import "std/text_tools"
using Vectors :: #import "std/vec"

TSX_DOMAIN :: #string ZI
#load "private_a.zi";
#load "private_b.zi";
using Vectors :: #import "std/vec"
using Callables :: #import "std/callable"
Model :: struct { value: float64; id: u64; }
Box :: struct($T: Type) { value: T; }
InspectBox :: (box: Box($T)) -> T { return box.value }
Instance :: struct { id: s64; }
RecordAction :: #type (instance: Instance) -> void;
seen_record: s64;
MarkRecord :: (value: s64) { seen_record = value }
SeenRecord :: () -> s64 { return seen_record }
InvokeRecord :: (action: Owned(RecordAction), instance: Instance) { action(instance) }
DefaultValue :: () -> s32 { return 7 }
WithDefaults :: (value: s32, extra: s32 = DefaultValue(), location: Source_Code_Location = #caller_location) -> s32 {
    if location.line_number <= 0 || location.fully_pathed_filename.count == 0 { return -1 }
    return value + extra
}
Snapshot :: () -> Model { return .{value = 42, id = 18446744073709551615} }
BorrowModel :: (model: *Model) { model.value += 1 }
Wrapped :: () -> Box(float64) { return .{value = 6} }
number_calls: s32;
NumberCalls :: () -> s32 { return number_calls }
Numbers :: () -> Vec(float64) {
    number_calls += 1
    values: Vec(float64)
    unused VecPush(values, 1.0); unused VecPush(values, 2.0); unused VecPush(values, 3.0)
    return values
}
Increment :: (id: u64) -> float64 { return ifx id == 18446744073709551615 then 1 else -1 }
Action :: #type (value: float64) -> float64;
Invoke :: (action: Action, value: float64) -> float64 { return action(value) }
InvokeOwned :: (action: Owned(Action), value: float64) -> float64 { return action(value) }
InvokeScoped :: (action: Scoped(Action), value: float64) -> float64 { return action(value) }
Parts :: (parts: [5]string) -> s32 {
    if parts.count != 5 { return 1 }
    if parts[0] != "Count: " || parts[1] != "7" || parts[2] != " " || parts[3] != "tail" || parts[4] != "!" { return 2 }
    return 0
}
Report :: () { print("native TSX passed\n") }
ZI

TSX_PRIVATE_A :: "#scope_file\nCell :: struct($T: Type) { first: T; }\nLeaf :: struct { first: s32; }\n#scope_export\nPrivateA :: () -> s32 { item: Cell(Box(Leaf)) = .{first = .{value = .{first = 11}}}; return item.first.value.first }\n"
TSX_PRIVATE_B :: "#scope_file\nCell :: struct($T: Type) { second: T; }\nLeaf :: struct { second: s32; }\n#scope_export\nPrivateB :: () -> s32 { item: Cell(Box(Leaf)) = .{second = .{value = .{second = 12}}}; return item.second.value.second }\n"

TSX_LOGIC :: #string TS
export interface Box<T> { other: T; }
export function Wrapped(): Box<number> { return {other: 9}; }
function HalfImpl(value: number): number { return value / 2; }
export function Half(value: number): number { return HalfImpl(value); }
let starts: s32 = s32(0);
function Seed(): s32 { starts = starts + s32(1); return starts; }
export let publicValue: s32 = Seed();
let nextValue: s32 = Seed();
export function Globals(): s32 { return starts * s32(10) + publicValue + nextValue; }
export function BumpGlobals(): s32 { publicValue = publicValue + s32(1); return publicValue; }
TS

TSX_GENERIC_PROPS :: #string TS
import * as DomainTypes from "domain";
export interface WidgetProps<T> { model: DomainTypes.Model; props: T; }
export function Read(props: WidgetProps<DomainTypes.Model>): number { return props.model.value + props.props.value; }
TS

TSX_FACADE :: "using Export :: #import \"generic_widget\";\n"
TSX_SCOPE :: "import { Scoped } from \"std/callable\";\nexport interface ScopeProps { children: Scoped<() => void>; }\nexport function Scope(props: ScopeProps): void { props.children(); }\n"
TSX_GENERIC_SUPPORT :: "Step :: (value: s32) -> s32 { return value }\n"
TSX_GENERIC_WIDGET :: #string ZI
Support :: #import "generic_support";
Props :: struct { value: s32; }
#scope_file
Hidden :: (value: s32) -> s32 { return value }
#scope_export
DrawSession :: (value: s32, props: Props) -> s32 { return value + props.value }
Draw :: (frame: $T, props: Props) -> s32 { return Support.Step(DrawSession(frame.slot, props) + Hidden(1)) }
ZI

TSX_APP :: #string TSX
import * as Domain from "domain";
import * as OtherAlias from "domain";
import * as Facade from "generic_facade";
import * as GenericProps from "generic_props";
import { Scope } from "scope_component";
import { Vec } from "std/vec";
import { Owned, Scoped } from "std/callable";
import { Text, TextCopy } from "std/vec";
interface Props { value: number; other: number; }
interface PartsProps { children: [string, string, string, string, string]; }
interface EmptyProps {}
interface DeferredProps { children: Scoped<() => void>; }
interface MarkerProps { value: s32; }
let deferredTrace: s32 = s32(0);
function Deferred(props: DeferredProps): void {
    deferredTrace = deferredTrace * s32(10) + s32(1);
    props.children();
    deferredTrace = deferredTrace * s32(10) + s32(3);
}
function Marker(props: MarkerProps): void {
    deferredTrace = deferredTrace * s32(10) + props.value;
}
type Transform = (value: number) => number;
interface ActionProps { action: (value: number) => number; value: number; }
interface OwnedActionProps { action: Owned<Domain.Action>; value: number; }
interface Holder<T> { value: T; }
interface Box<T> { local: T; }
interface Model { local: number; }
interface GenericFrame { slot: s32; }
type Factory = (value: number) => Holder<number>;
function Echo(props: Props): number { return props.value + props.other; }
function Tail(props: EmptyProps): string { return "tail"; }
function Parts(props: PartsProps): s32 { return Domain.Parts(props.children); }
function Apply(props: ActionProps): number { return props.action(props.value); }
function ApplyOwned(props: OwnedActionProps): number { return props.action(props.value); }
function Offset(delta: number): Owned<Domain.Action> {
    return (value: number): number => value + delta;
}
function TextAction(): Owned<Domain.Action> {
    const label: Text = TextCopy("owned");
    return (value: number): number => value + number(TextView(label).count);
}
function Wrap(value: number): Holder<number> { return {value: value}; }
export function main(): s32 {
    if (Logic.Globals() !== s32(23) || Logic.BumpGlobals() !== s32(2) || Logic.Globals() !== s32(24)) { return s32(30); }
    const genericFrame: GenericFrame = {slot: s32(40)};
    if (Facade.Draw(genericFrame, {value: s32(1)}) !== s32(42)) { return s32(25); }
    const snapshot: Domain.Model = Domain.Snapshot();
    let borrowedModel: Domain.Model = snapshot;
    const modelPointer: *Domain.Model = &borrowedModel;
    Domain.BorrowModel(modelPointer);
    if ((*modelPointer).value !== snapshot.value + 1 || borrowedModel.value !== snapshot.value + 1) { return s32(32); }
    if (Domain.WithDefaults(s32(2)) !== s32(9) || Domain.WithDefaults(s32(2), s32(3)) !== s32(5)) { return s32(26); }
    if (GenericProps.Read({model: snapshot, props: snapshot}) !== snapshot.value * 2) { return s32(27); }
    let genericBox: Domain.Box<number> = Domain.Wrapped();
    if (Domain.InspectBox(genericBox) !== 6) { return s32(28); }
    const recordDelta: s64 = s64(8);
    const recordAction: Owned<OtherAlias.RecordAction> = (instance: OtherAlias.Instance): void => { Domain.MarkRecord(recordDelta); };
    Domain.InvokeRecord(recordAction, {id: s64(1)});
    if (OtherAlias.SeenRecord() !== recordDelta) { return s32(29); }
    let value: number = <Echo other={0} value={snapshot.value}/>;
    let count: number = 0;
    while (count < 3) { count += 1; }
    if (count !== 3) { return s32(4); }
    let total: number = 0;
    for (let index = 0; index < 9; index += 2) {
        if (index === 2) { continue; }
        if (index === 8) { break; }
        total += index;
        let inner = 0;
        while (inner < 1) { inner += 1; continue; }
    }
    if (total !== 10) { return s32(8); }
    const values: [number, number, number, number] = [1, 2, 3, 4];
    const view: number[] = values[:];
    const middle: number[] = values[s32(1):s32(3)];
    if (view.count !== s64(4) || middle.count !== s64(2) || middle[s32(0)] !== 2) { return s32(33); }
    total = 0;
    for (const value of values) {
        if (value === 2) { continue; }
        if (value === 4) { break; }
        for (let index = 0; index < 2; index += 1) { if (index === 0) { continue; } }
        total += value;
    }
    if (total !== 4 || values[s64(1)] !== 2) { return s32(13); }
    const owned: Vec<number> = Domain.Numbers();
    total = 0;
    for (let value of owned) { value += 1; total += value; }
    for (const value of Domain.Numbers()) { total += value; }
    if (total !== 15 || owned.count !== s64(3) || Domain.NumberCalls() !== s32(2)) { return s32(14); }
    if (!VecPush(owned, 4)) { return s32(16); }
    const make: Factory = (value: number): Holder<number> => Wrap(value);
    if (make(4).value !== 4 || owned.count !== s64(4)) { return s32(17); }
    const wrapped: Domain.Box<number> = Domain.Wrapped();
    const localBox: Box<number> = {local: 8};
    const logicBox: Logic.Box<number> = Logic.Wrapped();
    const nestedBox: Holder<Box<Domain.Box<number>>> = {value: {local: wrapped}};
    const reverseBox: Domain.Box<Box<number>> = {value: localBox};
    const modelBox: Box<Domain.Model> = {local: snapshot};
    const aliasedBox: Box<OtherAlias.Model> = modelBox;
    if (aliasedBox.local.value !== snapshot.value || Domain.PrivateA() !== s32(11) || Domain.PrivateB() !== s32(12)) { return s32(19); }
    if (localBox.local !== 8 || logicBox.other !== 9 || reverseBox.value.local !== 8) { return s32(18); }
    if (nestedBox.value.local.value !== 6) { return s32(15); }
    if (Domain.Increment(u64(18446744073709551615n)) !== 1) { return s32(5); }
    if (Divide(5) !== 2.5) { return s32(6); }
    const half: Domain.Action = (value: number): number => value / 2;
    const nested: Transform = (value: number): number => {
        const inner: Transform = (value: number): number => value / 2;
        return inner(value);
    };
    if (Domain.Invoke(half, 10) !== 5 || nested(10) !== 5) { return s32(9); }
    const borrowedLabel: string = "borrowed";
    const scopedText: Text = TextCopy("state");
    const scoped: Scoped<Domain.Action> = (value: number): number => value + number(borrowedLabel.count);
    const nestedScoped: Scoped<Domain.Action> = (value: number): number => scoped(value) + number(TextView(scopedText).count);
    if (Domain.InvokeScoped(nestedScoped, 1) !== 14 || TextView(scopedText).count !== s64(5)) { return s32(34); }
    if ((<Apply action={(value: number): number => { return value + 1; }} value={4}/>) !== 5) { return s32(10); }
    const offset: Owned<Domain.Action> = Offset(3);
    const record: Domain.Model = Domain.Snapshot();
    const byRecord: Owned<Domain.Action> = (value: number): number => value + record.value;
    if (Domain.InvokeOwned(offset, 4) !== 7 || Domain.InvokeOwned(byRecord, 1) !== snapshot.value + 1) { return s32(20); }
    const textAction: Owned<Domain.Action> = TextAction();
    if (Domain.InvokeOwned(textAction, 2) !== 7) { return s32(21); }
    if ((<ApplyOwned value={4} action={(value: number): number => value + snapshot.value}/>) !== snapshot.value + 4) { return s32(22); }
    const stateless: Owned<Domain.Action> = (value: number): number => value + 2;
    if (Domain.InvokeOwned(stateless, 3) !== 5) { return s32(23); }
    const nestedOwned: Owned<Domain.Action> = (value: number): number => {
        const inner: Owned<Domain.Action> = (extra: number): number => extra + snapshot.value;
        return Domain.InvokeOwned(inner, value);
    };
    if (Domain.InvokeOwned(nestedOwned, 1) !== snapshot.value + 1) { return s32(24); }
    if ((<Tail>
    </Tail>) !== "tail") { return s32(11); }
    const partLabel: string = "7";
    if ((<Parts>Count: {partLabel} <Tail/>!</Parts>) !== s32(0)) { return s32(7); }
    const marker: MarkerProps = {value: s32(2)};
    <Scope><Deferred>
        <Marker value={marker.value}/>
        <Deferred><Marker value={s32(4)}/></Deferred>
    </Deferred></Scope>;
    if (deferredTrace !== s32(121433)) { return s32(31); }
    Domain.Report();
    return s32(Divide(value) - 21);
}
import { Half as Divide } from "logic";
import * as Logic from "logic";
TSX

TsxApplication :: () -> string {
    // More callback declarations than the initial module allocation exercise
    // relocation while the enclosing function is still being parsed.
    callbacks := "let callbacksTotal: number = 0;\n"
    for index: 0..39 {
        name := CheckConcat("callback", CheckNumber(index))
        callbacks = CheckConcat(callbacks, CheckConcat("const ", CheckConcat(name,
            ": Transform = (value: number): number => value / 2;\n")))
        callbacks = CheckConcat(callbacks, CheckConcat("callbacksTotal += ", CheckConcat(name, "(2);\n")))
    }
    callbacks = CheckConcat(callbacks, "if (callbacksTotal !== 40) { return s32(12); }\n")
    return TextDetach(TextReplace(TSX_APP, "    const snapshot:", CheckConcat(callbacks, "    const snapshot:")))
}

TsxTargets :: (test: *NativeTest, source: string, root: string, label: string) -> bool {
    expected := "native TSX passed\n"
    targets := string.["c", "go"]
    for target: targets {
        directory := CheckPath(test.work, CheckConcat(label, CheckConcat("-", target)))
        arguments := string.[test.ziran, "build", CheckConcat("--target=", target), "--exe",
            "--entry", "native_app:main", "--root", root, "-o", directory]
        command: Vec(string)
        for argument: arguments { VecPush(command, argument) }
        if target == "go" { VecPush(command, "--pkg"); VecPush(command, "main") }
        VecPush(command, source)
        unused NativeRun(test, command[:])
        if test.failed { return false }
        run: Vec(string)
        if target == "c" { VecPush(run, CheckPath(directory, "native_app")) }
        else {
            VecPush(run, "go"); VecPush(run, "run")
            files := NativeFiles(directory, ".go")
            for file: files { VecPush(run, file) }
        }
        if !NativeExpect(test, run[:], expected) { return false }
    }
    bundle := CheckPath(test.work, CheckConcat(label, ".zx"))
    build := string.[test.ziran, "bundle", "--entry", "native_app:main", "--root", root, "-o", bundle, source]
    unused NativeRun(test, build[:])
    tools := PathParent(test.ziran)
    backends := string.["engine", "native"]
    for backend: backends {
        run := string.[CheckPath(tools, "zi2zx"), "run", "--backend", backend, bundle]
        if test.failed || !NativeExpect(test, run[:], CheckConcat(expected, "0\n")) { return false }
    }
    executable := CheckPath(test.work, CheckConcat(label, "-native"))
    native := string.[test.ziran, "build", "--entry", "native_app:main", "--root", root, "-o", executable, source]
    unused NativeRun(test, native[:])
    native_run := string.[executable]
    if test.failed || !NativeExpect(test, native_run[:], expected) { return false }
    wasm := CheckPath(test.work, CheckConcat(label, ".wasm"))
    compile := string.[CheckPath(tools, "zx2wasm"), "-o", wasm, bundle]
    unused NativeRun(test, compile[:])
    run := string.["node", CheckPath(test.repo, "scripts/site_target_wasm.cjs"), wasm, "--output"]
    return !test.failed && NativeExpect(test, run[:], expected)
}

TsxReject :: (test: *NativeTest, root: string, name: string, body: string, diagnostic: string) -> bool {
    path := CheckPath(root, CheckConcat(name, ".tsx"))
    if !NativeWrite(test, path, body) { return false }
    command := string.[test.ziran, "check", "--root", root, path]
    result := NativeInvoke(test, command[:])
    return NativeAssert(test, result.code > 0 && result.code < 124 &&
        TextContains(result.error, diagnostic) && TextContains(result.error, CheckConcat(name, ".tsx:")),
        CheckConcat("missing authored TSX diagnostic: ", result.error))
}

TsxNestedRecord :: (leaf: string, value: string) -> string {
    source := CheckConcat("import { Scoped } from \"std/callable\";\ntype Action = () => s32;\ninterface Box0 { value: ",
        CheckConcat(leaf, "; }\n"))
    // Go past the old borrow walk's depth cap without changing the leaf's type.
    for index: 1..34 {
        source = CheckConcat(source, CheckConcat("interface Box", CheckConcat(CheckNumber(index),
            CheckConcat(" { value: Box", CheckConcat(CheckNumber(index - 1), "; }\n")))))
    }
    source = CheckConcat(source, CheckConcat("export function Escape(): Box34 {\n", value))
    source = CheckConcat(source, "const box0: Box0 = {value: value};\n")
    for index: 1..34 {
        number := CheckNumber(index)
        source = CheckConcat(source, CheckConcat("const box", CheckConcat(number,
            CheckConcat(": Box", CheckConcat(number, CheckConcat(" = {value: box",
            CheckConcat(CheckNumber(index - 1), "};\n")))))))
    }
    return CheckConcat(source, "return box34;\n}\n")
}

TsxNestedBorrows :: (test: *NativeTest, root: string) -> bool {
    valid := CheckPath(root, "nested_scalar.tsx")
    source := CheckConcat(TsxNestedRecord("s32", "const value = s32(7);\n"),
        "interface Branch { children: Branch[]; value: s32; }\nexport function Read(branch: Branch): s32 { return branch.value; }\n")
    if !NativeWrite(test, valid, source) { return false }
    command := string.[test.ziran, "check", "--root", root, valid]
    unused NativeRun(test, command[:])
    if test.failed { return false }
    return TsxReject(test, root, "nested_scoped_escape",
        TsxNestedRecord("Scoped<Action>", "const captured = s32(7);\nconst value: Scoped<Action> = (): s32 => captured;\n"),
        "Scoped callable cannot be returned or retained") &&
        TsxReject(test, root, "recursive_scoped_escape",
        "import { Scoped } from \"std/callable\";\ntype Action = () => s32;\ninterface Branch { children: Branch[]; action: Scoped<Action>; }\nexport function Escape(branch: Branch): Branch { return branch; }\n",
        "Scoped callable cannot be returned or retained")
}

// Exercise ordinary project discovery/self exports and dependency invalidation.
// The fixture uses the normal development override for this in-flight toolchain;
// released clean-project pins are verified separately by the migration campaign.
TsxProject :: (test: *NativeTest) -> bool {
    if !FixtureIsolation(test, test.work) { return false }
    project := CheckPath(test.work, "project")
    manifest := string.["[package]\nname = \"TSXProject\"\nentry = \"src/native_app.tsx\"\nmodule_roots = [\"src\"]\n[toolchain]\ngit = ",
        FixtureQuote(FixtureUri(test.repo)), "\nref = \"master\"\n[exports]\nModel = \"src/domain.zi\"\nLogic = \"src/logic.ts\"\nComponents = \"src/label.tsx\"\n"]
    aliases := string.["ziran"]; paths := string.[test.repo]
    source := TextDetach(TextReplace(TsxApplication(), "from \"domain\"", "from \"TSXProject/Model\""))
    source = TextDetach(TextReplace(source, "from \"logic\"", "from \"TSXProject/Logic\""))
    source = CheckConcat("import { Label } from \"TSXProject/Components\";\n", source)
    source = TextDetach(TextReplace(source, "<Echo other={0} value={snapshot.value}/>", "<Label value={snapshot.value}/>"))
    logic := TSX_LOGIC
    if !NativeWrite(test, CheckPath(project, "ziran.toml"), TextJoin(manifest[:], "")) ||
        !FixtureOverrides(test, project, aliases[:], paths[:]) ||
        !NativeWrite(test, CheckPath(project, "src/native_app.tsx"), source) ||
        !NativeWrite(test, CheckPath(project, "src/domain.zi"), TSX_DOMAIN) ||
        !NativeWrite(test, CheckPath(project, "src/private_a.zi"), TSX_PRIVATE_A) ||
        !NativeWrite(test, CheckPath(project, "src/private_b.zi"), TSX_PRIVATE_B) ||
        !NativeWrite(test, CheckPath(project, "src/generic_facade.zi"), TSX_FACADE) ||
        !NativeWrite(test, CheckPath(project, "src/generic_widget.zi"), TSX_GENERIC_WIDGET) ||
        !NativeWrite(test, CheckPath(project, "src/generic_support.zi"), TSX_GENERIC_SUPPORT) ||
        !NativeWrite(test, CheckPath(project, "src/generic_props.ts"), TSX_GENERIC_PROPS) ||
        !NativeWrite(test, CheckPath(project, "src/scope_component.tsx"), TSX_SCOPE) ||
        !NativeWrite(test, CheckPath(project, "src/logic.ts"), logic) ||
        !NativeWrite(test, CheckPath(project, "src/label.tsx"), "export interface Props { value: number; } export function Label(props: Props): number { return props.value; }\n") { return false }
    lock := string.["lock", "--offline"]; unused PackageCommand(test, project, lock[:])
    check := string.["check", "--project", "--offline"]; unused PackageCommand(test, project, check[:])
    build := string.["build", "--offline"]; unused PackageCommand(test, project, build[:])
    run := string.[test.ziran, "run", "--offline"]
    if test.failed || !NativeExpect(test, run[:], "native TSX passed\n", project) { return false }
    script := string.[test.ziran, "run", "--target=c", "--offline"]
    if !NativeExpect(test, script[:], "native TSX passed\n", project) { return false }
    if !NativeWrite(test, CheckPath(project, "src/logic.ts"), TextReplace(logic, "value / 2", "value / 3")) { return false }
    unused NativeRun(test, script[:], project, 6)
    if !NativeWrite(test, CheckPath(project, "src/logic.ts"), logic) ||
        !NativeWrite(test, CheckPath(project, "src/domain.zi"), TextReplace(TSX_DOMAIN, "value = 42", "value = 84")) { return false }
    unused NativeRun(test, script[:], project, 21)
    if !NativeWrite(test, CheckPath(project, "src/domain.zi"), TSX_DOMAIN) ||
        !NativeExpect(test, script[:], "native TSX passed\n", project) { return false }
    changed := TextDetach(TextReplace(TSX_DOMAIN, "value: float64", "value: bool"))
    changed = TextDetach(TextReplace(changed, "value = 42", "value = true"))
    if !NativeWrite(test, CheckPath(project, "src/domain.zi"), changed) { return false }
    rejected := PackageCommand(test, project, check[:], false)
    return !test.failed && NativeAssert(test, TextContains(rejected, "native_app.tsx:"),
        "changed Ziran declarations did not invalidate checked TSX types")
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "native-tsx-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    NativeSet(*test, "GO111MODULE", "off"); NativeSet(*test, "GOTOOLCHAIN", "local")
    NativeSet(*test, "GOPROXY", "off"); NativeSet(*test, "GOSUMDB", "off")
    root := CheckPath(test.work, "source")
    source := CheckPath(root, "native_app.tsx")
    saved_root := CheckPath(test.work, "ir")
    if !NativeWrite(*test, source, TsxApplication()) ||
        !NativeWrite(*test, CheckPath(root, "domain.zi"), TSX_DOMAIN) ||
        !NativeWrite(*test, CheckPath(root, "private_a.zi"), TSX_PRIVATE_A) ||
        !NativeWrite(*test, CheckPath(root, "private_b.zi"), TSX_PRIVATE_B) ||
        !NativeWrite(*test, CheckPath(root, "generic_facade.zi"), TSX_FACADE) ||
        !NativeWrite(*test, CheckPath(root, "generic_widget.zi"), TSX_GENERIC_WIDGET) ||
        !NativeWrite(*test, CheckPath(root, "generic_support.zi"), TSX_GENERIC_SUPPORT) ||
        !NativeWrite(*test, CheckPath(root, "generic_props.ts"), TSX_GENERIC_PROPS) ||
        !NativeWrite(*test, CheckPath(root, "scope_component.tsx"), TSX_SCOPE) ||
        !NativeWrite(*test, CheckPath(root, "logic.ts"), TSX_LOGIC) { return 1 }
    warm := string.[test.ziran, "check", "--root", root, source]
    unused NativeRun(*test, warm[:])
    unused NativeRun(*test, warm[:])
    save := string.[test.ziran, "ir", "--root", root, "-o", saved_root, source]
    unused NativeRun(*test, save[:])
    if test.failed || !TsxTargets(*test, source, root, "source") ||
        !TsxTargets(*test, CheckPath(saved_root, "native_app.zir"), saved_root, "saved") { return 1 }
    if !TsxReject(*test, root, "coercion", "export function main(): s32 { if (1 == 1) { return s32(0); } return s32(1); }", "coercive equality is unsupported") ||
        !TsxReject(*test, root, "untyped", "interface Props { value: any; }", "no native checked representation") ||
        !TsxReject(*test, root, "duplicate", "interface Props { value: number; } function Item(props: Props): number { return props.value; } export function main(): s32 { return s32(<Item value={1} value={2}/>); }", "duplicate JSX property") ||
        !TsxReject(*test, root, "constant", "export function main(): s32 { const value = 1; value = 2; return s32(value); }", "cannot assign to a const binding") ||
        !TsxReject(*test, root, "uninitialized", "export function main(): s32 { let value: number; return s32(value); }", "native bindings require an initializer") ||
        !TsxReject(*test, root, "collection_const", "export function main(): s32 { const values: [number] = [1]; for (const value of values) { value = 2; } return s32(0); }", "cannot assign to a const binding") ||
        !TsxReject(*test, root, "collection_borrow", "import * as Domain from \"domain\"; import { Vec } from \"std/vec\"; export function main(): s32 { const values: Vec<number> = Domain.Numbers(); for (const value of values) { VecPush(values, value); } return s32(0); }", "borrow") ||
        !TsxReject(*test, root, "generic_identity", "import * as Domain from \"domain\"; interface Box<T> { value: T; } export function main(): s32 { const box: Box<number> = Domain.Wrapped(); return s32(box.value); }", "type") ||
        !TsxReject(*test, root, "generic_nested_identity", "import * as Domain from \"domain\"; interface Box<T> { value: T; } interface Holder<T> { value: T; } export function main(): s32 { const native: Holder<Domain.Box<number>> = {value: Domain.Wrapped()}; const local: Holder<Box<number>> = native; return s32(0); }", "type") ||
        !TsxReject(*test, root, "generic_type", "interface Box<T> { value: T; } export function main(): s32 { const box: Box<number> = {value: true}; return s32(box.value); }", "type") ||
        !TsxReject(*test, root, "action", "import * as Domain from \"domain\"; export function main(): s32 { Domain.Increment(true); return s32(0); }", "argument") ||
        !TsxReject(*test, root, "visibility", "import { HalfImpl } from \"logic\"; export function main(): s32 { return s32(HalfImpl(0)); }", "unresolved function:") ||
        !TsxReject(*test, root, "capture", "type Action = () => number; export function main(): s32 { const value = 1; const action: Action = (): number => value; return s32(action()); }", "requires an Owned(Signature) context") ||
        !TsxReject(*test, root, "capture_view", "import { Owned } from \"std/callable\"; type Action = () => number; export function main(): s32 { const text: string = \"borrowed\"; const action: Owned<Action> = (): number => number(text.count); return s32(0); }", "callback capture must be a scalar, enum, or owned value without borrowed fields") ||
        !TsxReject(*test, root, "scoped_escape", "import { Scoped } from \"std/callable\"; type Action = () => number; export function Leak(): Scoped<Action> { const value = 1; const action: Scoped<Action> = (): number => value; return action; }", "Scoped callable cannot be returned or retained") ||
        !TsxReject(*test, root, "capture_record_view", "import { Owned } from \"std/callable\"; interface Borrowed { text: string; } type Action = () => number; export function main(): s32 { const record: Borrowed = {text: \"borrowed\"}; const action: Owned<Action> = (): number => number(record.text.count); return s32(0); }", "callback capture must be a scalar, enum, or owned value without borrowed fields") ||
        !TsxReject(*test, root, "capture_escape", "import { Owned } from \"std/callable\"; import { Text, TextCopy } from \"std/vec\"; type Action = () => string; export function main(): s32 { const text: Text = TextCopy(\"owned\"); const action: Owned<Action> = (): string => TextView(text); return s32(0); }", "returned text view borrows local or temporary storage") ||
        !TsxReject(*test, root, "capture_write", "import { Owned } from \"std/callable\"; type Action = () => number; export function main(): s32 { const value = 1; const action: Owned<Action> = (): number => { value = 2; return value; }; return s32(0); }", "callback captures are immutable snapshots") ||
        !TsxReject(*test, root, "capture_move", "import { Owned } from \"std/callable\"; import { Text, TextCopy } from \"std/vec\"; type Action = () => number; export function main(): s32 { const text: Text = TextCopy(\"owned\"); const action: Owned<Action> = (): number => number(TextView(text).count); return s32(TextView(text).count); }", "after moving") ||
        !TsxReject(*test, root, "callback", "type Action = (value: number) => number; export function main(): s32 { const action: Action = (value: boolean): number => 1; return s32(0); }", "type") ||
        !TsxReject(*test, root, "property", "interface Props { value: number; } function Item(props: Props): number { return props.value; } export function main(): s32 { return s32(<Item value={true}/>); }", "type") ||
        !TsxReject(*test, root, "missing_property", "interface Props { value: number; } function Item(props: Props): number { return props.value; } export function main(): s32 { return s32(<Item/>); }", "missing required initializer field") ||
        !TsxReject(*test, root, "missing_generic_field", "interface Box<T> { value: T; } export function main(): s32 { const box: Box<number> = {}; return s32(box.value); }", "missing required initializer field") ||
        !TsxReject(*test, root, "local_view", "import { Text, TextCopy } from \"std/vec\"; export function Leak(): string { const owned: Text = TextCopy(\"temporary\"); return TextView(owned); }", "returned text view borrows local or temporary storage") ||
        !TsxReject(*test, root, "closing", "interface Props { children: string[]; } function Item(props: Props): s32 { return s32(0); } export function main(): s32 { return <Item>text</Other>; }", "closing component does not match") { return 1 }
    foreign_source := CheckPath(root, "foreign_scoped.zi")
    if !NativeWrite(*test, foreign_source, "using C :: #import \"std/callable\";\nAction :: #type () -> float64;\nlib :: #system_library \"c\";\nForeign :: (action: Scoped(Action)) -> float64 #foreign lib \"foreign_scoped\";\n") { return 1 }
    foreign_check := string.[test.ziran, "check", "--root", root, foreign_source]
    foreign_result := NativeInvoke(*test, foreign_check[:])
    if !NativeAssert(*test, foreign_result.code > 0 && foreign_result.code < 124 &&
        TextContains(foreign_result.error, "Scoped parameters require a checked nonescaping procedure body") &&
        TextContains(foreign_result.error, "foreign_scoped.zi:"), "foreign procedure accepted a scoped callback without a checked body") { return 1 }
    if !TsxNestedBorrows(*test, root) || !TsxProject(*test) { return 1 }
    print("native TSX: typed imports, JSX, cache/project invalidation and source/saved C, Go, engine, native executable and Wasm parity passed\n")
    return 0
}
