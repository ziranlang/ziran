#import "package_common"
#import "package_lock"
#import "byte_text_linux"

// Resolves one locked package source into the cache under XDG_CACHE_HOME.
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 3 { return 78 }
    path := PkgCheckout(TextFromCString(argv[1]), TextFromCString(argv[2]), false)
    if path == "" { return 1 }
    print("%\n", path)
    return 0
}
