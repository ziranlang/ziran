#import "native_test"
#import "package_fixture_support"
#import "check_support"
#import "std/byte_text_linux"
#import "std/file"
#import "std/file_tree_linux"
#import "std/text_tools"
using Vectors :: #import "std/vec"

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "package-generated-modules-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    if !FixtureIsolation(*test, test.work) { return 1 }
    library := CheckPath(test.work, "library")
    if !FixtureInit(*test, library) || !NativeWrite(*test, CheckPath(library, "ziran.toml"), "[package]\nname = \"GeneratedLibrary\"\nmodule_roots = [\"src\"]\n[exports]\nShared = \"src/Shared.zi\"\n") ||
        !NativeWrite(*test, CheckPath(library, "src/Value.zi"), "Value :: () -> s32 { return 40 }\n") || !NativeWrite(*test, CheckPath(library, "src/Shared.zi"), "#import \"Value\"\nShared :: () -> s32 { return Value() }\n") { return 1 }
    unused FixtureCommit(*test, library, "fixture")
    app := CheckPath(test.work, "app")
    manifest := string.["[package]\nname = \"GeneratedApp\"\nentry = \"src/app.zi\"\nmodule_roots = [\"src\"]\n[toolchain]\ngit = ", FixtureQuote(FixtureUri(test.repo)),
        "\nref = \"master\"\n[dependencies.lib]\ngit = ", FixtureQuote(FixtureUri(library)), "\nref = \"master\"\n"]
    if !NativeWrite(*test, CheckPath(app, "ziran.toml"), TextJoin(manifest[:], "")) { return 1 }
    aliases := string.["ziran"]; paths := string.[test.repo]
    if !FixtureOverrides(*test, app, aliases[:], paths[:]) || !NativeWrite(*test, CheckPath(app, "src/plain.zi"), "#import \"Shared\"\nPlain :: () -> s32 { return Shared() }\n") ||
        !NativeWrite(*test, CheckPath(app, "src/app.zi"), "#import \"Shared\"\n#import \"translations\"\n#import \"Value\"\n#program_export\nmain :: () -> s32 {\nif Shared() == 40 && Value() == 2 && Translated() == 3 { return 0 }\nreturn 1\n}\n") { return 1 }
    commands := string.["lock", "update", "fetch"]
    for name: commands { command := string.[name]; unused PackageCommand(*test, app, command[:]) }
    plain := string.["check", "--project", CheckPath(app, "src/plain.zi")]; unused PackageCommand(*test, app, plain[:])
    missing := string.["check", "--project", "--module-path", "build/gen"]
    absent := PackageCommand(*test, app, missing[:], false)
    if !NativeAssert(*test, TextContains(absent, "--module-path folder does not exist: build/gen"), "missing generated root lost its diagnostic") { return 1 }
    check := string.["check", "--project"]
    unresolved := PackageCommand(*test, app, check[:], false)
    if !NativeAssert(*test, TextContains(unresolved, "module translations is not in package root"), "undeclared generated module was accepted") { return 1 }
    generated := CheckPath(app, "build/gen")
    if !NativeWrite(*test, CheckPath(generated, "translations.zi"), "#import \"Value\"\nTranslated :: () -> s32 { return Value() + 1 }\n") ||
        !NativeWrite(*test, CheckPath(generated, "Value.zi"), "Value :: () -> s32 { return 2 }\n") { return 1 }
    explicit := string.["check", "--project", "--module-path", generated]; unused PackageCommand(*test, app, explicit[:])
    bundle := CheckPath(test.work, "generated.zx")
    portable := string.["bundle", "--project", "--module-path", "build/gen", "--entry", "app:main", "-o", bundle, CheckPath(app, "src/app.zi")]
    unused PackageCommand(*test, app, portable[:])
    run := string.["run", bundle]
    if !NativeAssert(*test, TextTrim(PackageCommand(*test, app, run[:])) == "0", "generated/library Value ownership was confused at runtime") { return 1 }
    if !NativeWrite(*test, CheckPath(generated, "plain.zi"), "Other :: () -> s32 { return 0 }\n") { return 1 }
    clash := PackageCommand(*test, app, explicit[:], false)
    if !NativeAssert(*test, TextContains(clash, "generated module plain in") && !TextContains(clash, "cannot build project import map"), "generated name collision lost its specific diagnostic") { return 1 }
    unused RemoveFile(CheckPath(generated, "plain.zi"))
    named := string.["check", "--project", "--module-path", "lib=build/gen"]
    bad_package := PackageCommand(*test, app, named[:], false)
    if !NativeAssert(*test, TextContains(bad_package, "packages come from ziran.lock"), "generated root impersonated a package") { return 1 }
    path := string.["pkg", "path", "lib"]
    package := TextTrim(PackageCommand(*test, app, path[:]))
    inside := string.["check", "--project", "--module-path", CheckPath(package, "src")]
    rejected := PackageCommand(*test, app, inside[:], false)
    if !NativeAssert(*test, TextContains(rejected, "is inside locked package"), "generated root extended an immutable dependency") || test.failed { return 1 }
    print("Local generated-module tests: root ownership, independent library imports and explicit collision diagnostics passed\n")
    return 0
}
