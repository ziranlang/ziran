#import "native_test"
#import "package_fixture_support"
#import "check_support"
#import "std/file_tree_linux"
#import "std/text_tools"
using Vectors :: #import "std/vec"

#scope_file
// Complete machine-code records across every format folder of the corpus.
Records :: (corpus: string) -> s64 {
    formats: Vec(string)
    if !ListDirectory(corpus, *formats) { return 0 }
    total: s64 = 0
    for format: formats {
        if !TextHasPrefix(format, "zx") { continue }
        programs := CheckPath(corpus, format)
        folders: Vec(string)
        if !ListDirectory(programs, *folders) { continue }
        for folder: folders {
            files: Vec(string)
            if !ListDirectory(CheckPath(programs, folder), *files) { continue }
            for file: files { if TextHasSuffix(file, ".record.json") { total += 1 } }
        }
    }
    return total
}

Build :: (test: *NativeTest, root: string, name: string) -> bool {
    command := string.["build", "--root", CheckPath(root, "src"), "-o", CheckPath(root, name),
        CheckPath(root, CheckConcat("src/", CheckConcat(name, ".zi")))]
    unused PackageCommand(test, root, command[:])
    return !test.failed
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "package-learn-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    root := test.work
    if !FixtureIsolation(*test, root) { return 1 }
    unset := string.["XDG_CONFIG_HOME", "XDG_DATA_HOME", "ZIRAN_LEARN", "ZIRAN_LEARN_DIR"]
    for name: unset { NativeUnset(*test, name) }
    corpus := CheckPath(root, "home/.local/share/ziran/learn")
    if !NativeWrite(*test, CheckPath(root, "src/hello.zi"), "main :: () {\n    print(\"hello\\n\");\n}\n") ||
        !NativeWrite(*test, CheckPath(root, "src/sum.zi"), "main :: () {\n    total: s64 = 0\n    for i: 0..9 { total += i }\n    print(\"%\\n\", total)\n}\n") ||
        !NativeWrite(*test, CheckPath(root, "src/three.zi"), "main :: () {\n    print(\"three\\n\");\n}\n") { return 1 }

    status := string.["learn", "status"]
    if !NativeAssert(*test, TextContains(PackageCommand(*test, root, status[:]), "recording: on (default)"), "recording is not on by default") { return 1 }
    NativeSet(*test, "ZIRAN_LEARN", "off")
    if !Build(*test, root, "hello") { return 1 }
    if !NativeAssert(*test, !IsDirectory(corpus), "ZIRAN_LEARN=off still recorded") { return 1 }
    NativeUnset(*test, "ZIRAN_LEARN")
    if !Build(*test, root, "hello") { return 1 }
    if !NativeAssert(*test, Records(corpus) == 1, "a default native build was not recorded") { return 1 }
    formats: Vec(string)
    if !NativeAssert(*test, ListDirectory(corpus, *formats), "cannot list the corpus") { return 1 }
    format := ""
    for name: formats { if TextHasPrefix(name, "zx") { format = name } }
    if !NativeAssert(*test, TextHasPrefix(format, "zx") && TextContains(format, "-lir"),
        "the record is not filed under its zx<R>-lir<S> format") { return 1 }
    programs: Vec(string)
    if !NativeAssert(*test, ListDirectory(CheckPath(corpus, format), *programs) && programs.count == 1, "missing program folder") { return 1 }
    folder := CheckPath(CheckPath(corpus, format), programs[0])
    files: Vec(string)
    if !NativeAssert(*test, ListDirectory(folder, *files), "cannot list the record") { return 1 }
    map := ""
    for file: files { if TextHasSuffix(file, ".map.json") { map = CheckPath(folder, file) } }
    if !NativeAssert(*test, IsFile(CheckPath(folder, "program.zx")) && map != "" &&
        TextContains(NativeRead(*test, map), "ziran-native-map"), "the record lacks its program or machine map") { return 1 }
    lir := TextReplace(map, ".map.json", ".lir")
    if !NativeAssert(*test, IsFile(lir) && TextHasPrefix(NativeRead(*test, lir), "lir "), "the record lacks its lowered input") { return 1 }
    record := TextDetach(TextReplace(map, ".map.json", ".record.json"))
    made := NativeRead(*test, record)
    if !NativeAssert(*test, TextContains(made, CheckConcat("\"format\":\"", CheckConcat(format, "\""))) &&
        NativeIdentifierAfter(made, "\"zx2native_sha256\":\"").count == 64 &&
        NativeIdentifierAfter(made, "\"zi2zx_sha256\":\"").count == 64 &&
        TextContains(made, "\"ziran\":\"") && TextContains(made, "\"entry\":\"hello:main\"") &&
        TextContains(made, "/src/hello.zi\"") && NativeIdentifierAfter(made, "\"recorded_unix\":").count > 0,
        CheckConcat("the record does not name its compiler and source:\n", made)) { return 1 }

    // The record is written last; a record without it is incomplete and redone.
    if !NativeAssert(*test, RemoveFile(record), "cannot remove the record") { return 1 }
    if !Build(*test, root, "hello") { return 1 }
    if !NativeAssert(*test, Records(corpus) == 1 && IsFile(record), "an incomplete record was not redone") { return 1 }
    if !Build(*test, root, "hello") { return 1 }
    if !NativeAssert(*test, Records(corpus) == 1, "rebuilding the same program recorded it twice") { return 1 }
    off := string.["learn", "off"]
    unused PackageCommand(*test, root, off[:])
    if !Build(*test, root, "sum") { return 1 }
    if !NativeAssert(*test, Records(corpus) == 1, "learn off still recorded") { return 1 }

    on := string.["learn", "on", "--limit-mb", "64"]
    unused PackageCommand(*test, root, on[:])
    if !Build(*test, root, "sum") { return 1 }
    if !NativeAssert(*test, Records(corpus) == 2, "a new program was not recorded after learn on") { return 1 }
    if !NativeWrite(*test, CheckPath(corpus, "bytes"), "999999999\n") || !Build(*test, root, "three") { return 1 }
    if !NativeAssert(*test, Records(corpus) == 2, "a full corpus still recorded") { return 1 }
    report := PackageCommand(*test, root, status[:])
    if !NativeAssert(*test, TextContains(report, "recording: on") && !TextContains(report, "(default)") &&
        TextContains(report, "programs: 2, machine-code records: 2") &&
        TextContains(report, CheckConcat(CheckConcat("  ", format), ": 2 programs, 2 records")) &&
        TextContains(report, "of 64 MB"), CheckConcat("unexpected status:\n", report)) { return 1 }

    // A record that cannot be written stays out of the build's output.
    broken := CheckPath(root, "broken")
    if !NativeWrite(*test, CheckPath(broken, format), "not a folder\n") { return 1 }
    NativeSet(*test, "ZIRAN_LEARN_DIR", broken)
    quiet := string.["build", "--root", CheckPath(root, "src"), "-o", CheckPath(root, "three"), CheckPath(root, "src/three.zi")]
    output := PackageCommand(*test, root, quiet[:])
    if !NativeAssert(*test, !TextContains(output, "learn") && !TextContains(output, "record"),
        CheckConcat("a failed record printed during the build:\n", output)) { return 1 }
    if !NativeAssert(*test, TextContains(PackageCommand(*test, root, status[:]), "last error: could not record"),
        "status does not report the failed record") { return 1 }
    NativeUnset(*test, "ZIRAN_LEARN_DIR")
    bad := string.["learn", "on", "--limit-mb", "0"]
    unused PackageCommand(*test, root, bad[:], false)
    if test.failed { return 1 }
    // Unknown teacher semantics cannot overwrite an existing approved table.
    proposal := CheckPath(root, "proposal.json")
    table := CheckPath(root, "approved.zi")
    if !NativeWrite(*test, proposal, "{\"schema_version\":99}") ||
        !NativeWrite(*test, table, "keep this table\n") { return 1 }
    reject := string.["learn", "verify", "--candidates", proposal, "--repo", test.repo, "--output", table]
    unused PackageCommand(*test, root, reject[:], false)
    if !NativeAssert(*test, NativeRead(*test, table) == "keep this table\n", "a rejected teacher proposal replaced the table") { return 1 }
    print("Learning corpus: on by default, records each new native build once under its ZX format with its compiler, and honors off, ZIRAN_LEARN and the size cap\n")
    return 0
}
