#import "native_test"
#import "package_proxy"
#import "check_support"
#import "check_cache"
#import "case_pool"
#import "std/byte_text_linux"
#import "std/environment_linux"
#import "std/file_tree_linux"
#import "std/text_tools"
using Vectors :: #import "std/vec"

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc > 1 && TextFromCString(argv[1]) == "--guard-git" { return PackageProxy(argc, argv, "--guard-git") }
    local_only := false
    for index: cast(s32)2..argc - 1 { if TextFromCString(argv[index]) == "--local-overrides-only" { local_only = true } }
    test := NativeStart(ifx argc > 2 && TextFromCString(argv[2]) == "--local-overrides-only" then 2 else argc, argv, "packages-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    if local_only {
        real_git := CheckExecutable("git")
        if !NativeAssert(*test, real_git != "", "constrained fixtures require Git") { return 1 }
        guard := CheckPath(test.work, "guard/git")
        if !NativeWrite(*test, guard, "#!/bin/sh\nexec \"$ZIRAN_FIXTURE_GUARD_PROXY\" --guard-git \"$@\"\n") { return 1 }
        chmod := string.["chmod", "755", guard]; unused NativeRun(*test, chmod[:])
        NativeSet(*test, "ZIRAN_FIXTURE_GUARD_REAL_GIT", real_git)
        NativeSet(*test, "ZIRAN_FIXTURE_GUARD_PROXY", TextDetach(ResolvePath("/proc/self/exe")))
        NativeSet(*test, "PATH", CheckConcat(PathParent(guard), CheckConcat(":", EnvironmentText("PATH"))))
    }
    // Heaviest suites launch first so shorter suites fill their shadow.
    local_cases := string.["package_pin", "package_unborn", "package_batch_paths", "package_self_import", "package_native_links"]
    full_cases := string.["package_resolution", "package_artifacts", "package_templates", "package_override_graph",
        "package_pin", "package_unborn", "package_cache_repair", "package_batch_paths", "package_self_import",
        "package_native_links", "package_transitive_add", "package_bridges", "package_wide_exports", "package_tooling",
        "package_generated_modules", "package_diagnostics", "package_learn_tuning", "package_learn"]
    selected := ifx local_only then local_cases[:] else full_cases[:]
    commands: Vec(string)
    for name: selected {
        command: Vec(string)
        prefix := string.[test.ziran, "run", "--target=c", "--root", CheckPath(test.repo, "tests"),
            CheckPath(test.repo, CheckConcat("tests/", CheckConcat(name, "_cases.zi"))), "--", test.ziran, CheckPath(test.work, name)]
        for argument: prefix { VecPush(command, argument) }
        if local_only && name == "package_pin" { VecPush(command, "--local-overrides-only") }
        VecPush(commands, CaseCommand(command[:]))
    }
    result := RunCases(*test, selected, commands[:])
    if result != 0 { return result }
    if local_only { print("Local constrained package suite passed without clones, worktrees or fetching\n") }
    else { print("Local package integration suites passed\n") }
    return 0
}
