// Command-line form of the saved IR edits in saved_ir.zi, for shell checks.
#import "native_test"
#import "saved_ir"
#import "std/byte_text_linux"

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test: NativeTest
    if argc == 6 && (TextFromCString(argv[1]) == "--replace-first" || TextFromCString(argv[1]) == "--replace-all") {
        replaced := SavedIrReplace(*test, TextFromCString(argv[2]), TextFromCString(argv[3]),
            TextFromCString(argv[4]), TextFromCString(argv[5]), TextFromCString(argv[1]) == "--replace-all")
        return ifx replaced then 0 else 1
    }
    if argc != 3 { print("pass saved IR and signature fixture\n"); return 2 }
    return ifx SavedIrBlankSignatures(*test, TextFromCString(argv[1]), TextFromCString(argv[2])) then 0 else 1
}
