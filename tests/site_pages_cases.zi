#import "native_test"
#import "check_support"
#import "reference_doc"
#import "std/byte_text_linux"
#import "std/file_tree_linux"
#import "std/json_document"
#import "std/text_tools"
using Vectors :: #import "std/vec"

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "site-pages-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    script := CheckPath(test.repo, "scripts/site_pages.py")
    source := CheckPath(test.work, "src")
    loader := CheckPath(source, "loader.zi")
    if !NativeWrite(*test, loader, "// Loader module.\n\n#load \"part.zi\";\n") ||
        !NativeWrite(*test, CheckPath(source, "part.zi"), "// Part file.\n\n\n\n\n\n// Doubles a number.\nDouble :: (n: s32) -> s32 {\n    return n * 2;\n}\n") { return 1 }
    query := string.["python3", script, "--ziran", test.ziran, "--module-api", loader, "--module-root", source]
    result := NativeRun(*test, query[:])
    document: JsonDocument
    if !NativeAssert(*test, JsonRead(*document, result.output), "invalid generated module documentation") { return 1 }
    root := document.root
    entries := JsonMember(*document, root, "entries")
    entry := JsonElement(*document, entries, 0)
    if !NativeAssert(*test, CheckField(*document, root, "summary") == "Loader module." && JsonCount(*document, entries) == 1 &&
        JsonString(*document, JsonElement(*document, entry, 1)) == "Double :: (n: s32) -> s32" &&
        JsonString(*document, JsonElement(*document, entry, 2)) == "Doubles a number.", "loaded declaration documentation came from the wrong file or line") { return 1 }
    native_api := CheckPath(source, "native_api.zi")
    if !NativeWrite(*test, CheckPath(source, "provider.zi"),
        "#if TARGET == .C {\nNativeValue :: () -> s32 { return 42 }\n}\n") ||
        !NativeWrite(*test, native_api,
        "Provider :: #import \"provider\";\nRead :: () -> s32 { return Provider.NativeValue() }\n") { return 1 }
    default_api := string.[test.ziran, "api", "--json", "--root", source, native_api]
    default_result := NativeRun(*test, default_api[:], expected = 1)
    if !NativeAssert(*test, default_result.output == "" &&
        TextContains(default_result.error, "Provider.NativeValue"), "default API query must check the portable import graph") { return 1 }
    native_query := string.["python3", script, "--ziran", test.ziran, "--module-api", native_api, "--module-target", "c"]
    native_result := NativeRun(*test, native_query[:])
    if !NativeAssert(*test, TextContains(native_result.output, "Read :: () -> s32"),
        "native site API query did not check the target-conditional provider") { return 1 }
    unknown_api := string.[test.ziran, "api", "--json", "--target", "unknown", "--root", source, native_api]
    unknown_result := NativeRun(*test, unknown_api[:], expected = 2)
    if !NativeAssert(*test, unknown_result.output == "" &&
        TextContains(unknown_result.error, "unknown API target: unknown"), "invalid API target must be rejected") { return 1 }
    hello := NativeRead(*test, CheckPath(test.repo, "examples/hello.zi"))
    if !NativeWrite(*test, CheckPath(test.work, "hello.zi"), hello) { return 1 }
    run := string.[test.ziran, "run", "hello.zi"]
    direct := string.[CheckPath(PathParent(test.ziran), "zi2zx"), "run", "hello.zi"]
    unused NativeExpect(*test, run[:], "Hello, World!\n", test.work)
    unused NativeExpect(*test, direct[:], "Hello, World!\n", test.work)
    examples := NativeRead(*test, CheckPath(test.repo, "site/examples.html"))
    started := NativeRead(*test, CheckPath(test.repo, "site/get-started.html"))
    if !NativeAssert(*test, TextContains(examples, "ziran run hello.zi") && TextContains(started, "ziran run hello.zi") &&
        !TextContains(examples, "build/bin/ziran bundle") && !TextContains(started, "build/bin/ziran bundle"), "website examples lost the direct run command") { return 1 }
    status := NativeRead(*test, CheckPath(test.repo, "site/status.html"))
    usage := NativeRead(*test, CheckPath(test.repo, "site/guide/usage.html"))
    index := NativeRead(*test, CheckPath(test.repo, "site/docs.html"))
    version := TextTrim(NativeRead(*test, CheckPath(test.repo, "VERSION")))
    released := CheckConcat(CheckConcat("v", version), " and Unreleased")
    if !NativeAssert(*test, TextContains(status, released) &&
        TextContains(status, "Source → ZIR → LIR → optimized LIR → ZX → native") &&
        TextContains(status, "Safety is manual by default") && TextContains(usage, "--checks") &&
        !TextContains(index, "migration.html") && !TextContains(usage, ".lirb") &&
        !TextContains(usage, "--emit exec"), "website must describe only the current pipeline and opt-in checks") { return 1 }
    webp := NativeRead(*test, CheckPath(test.repo, "site/packages/webp.html"))
    api := NativeRead(*test, CheckPath(test.repo, "site/api.html"))
    if !NativeAssert(*test, !TextContains(webp, "legacy_compare.sh") &&
        !TextContains(webp, "original Kryon decoder") && TextContains(api, "revision 29") &&
        !TextContains(api, "version 24"), "public references retained an obsolete pipeline or format") { return 1 }
    if !CheckReferenceDoc(*test) { return 1 }
    // Check the live site after the fixtures so stale generated pages do not
    // hide failures in the module API checks.
    check := string.["python3", script, "--ziran", test.ziran, "--check"]
    unused NativeRun(*test, check[:])
    if test.failed { return 1 }
    print("Local site tests: generated pages, loaded-file documentation, one-line examples and the checked reference passed\n")
    return 0
}
