// AV1's 8-bit 8x8 DCT_DCT inverse transform as a typed #asm routine, the
// real-kernel check of #asm: SSSE3, AArch64 and ARMv7 NEON variants beside
// the portable body, compared with AV1's s64 reference by
// tests/asm_dct8.sh. tests/asm_dct8_templates.zi generates the templates.

// The 8-bit DCT_DCT 8x8 inverse transform of AV1 7.13.3 at 16-bit lanes:
// the row pass, Round2 by 1, the column pass and Round2 by 4, row-major
// s32 Dequant in, row-major s32 Residual out. With 8-bit content every
// Hadamard sum saturates at 16 bits as the specification clamps it, and
// Round2 by 1 and 4 are exact, so the only values 16 bits cannot carry
// are rotation results. The routine returns 0 and writes nothing when an
// input or a rotation result reaches the 16-bit bounds, so callers then
// take the general transform; otherwise it returns 1.

// ARM rotation constants as lanes, then x86 pmaddwd pairs (c, -s) and
// (s, c) for the four rotations, the 12-bit rounding term and the Round2
// multipliers for pmulhrsw.
Dct8Table: [96]s16 = .[
    799, 4017, 3406, 2276, 2896, 1567, 3784, 0,
    799, -4017, 799, -4017, 799, -4017, 799, -4017,
    4017, 799, 4017, 799, 4017, 799, 4017, 799,
    3406, -2276, 3406, -2276, 3406, -2276, 3406, -2276,
    2276, 3406, 2276, 3406, 2276, 3406, 2276, 3406,
    2896, -2896, 2896, -2896, 2896, -2896, 2896, -2896,
    2896, 2896, 2896, 2896, 2896, 2896, 2896, 2896,
    1567, -3784, 1567, -3784, 1567, -3784, 1567, -3784,
    3784, 1567, 3784, 1567, 3784, 1567, 3784, 1567,
    2048, 0, 2048, 0, 2048, 0, 2048, 0,
    16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384,
    2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048];

Dct8Lane :: struct { v: [8]s64; }

Dct8Saturate :: (v: s64) -> s64 {
    if v > 32767 { return 32767 }
    if v < -32768 { return -32768 }
    return v
}

// B(a, b, flip): the rotation by (c, s), rounded by 12 bits; false when a
// result reaches the 16-bit bounds.
Dct8Rotate :: (t: *Dct8Lane, a: s64, b: s64, c: s64, s: s64, flip: bool) -> bool {
    x := (t.v[a & 7] * c - t.v[b & 7] * s + 2048) >> 12
    y := (t.v[a & 7] * s + t.v[b & 7] * c + 2048) >> 12
    if flip { t.v[a & 7] = y; t.v[b & 7] = x } else { t.v[a & 7] = x; t.v[b & 7] = y }
    return x > -32768 && x < 32767 && y > -32768 && y < 32767
}

// H(a, b): sum and difference, clamped to 16 bits.
Dct8Sum :: (t: *Dct8Lane, a: s64, b: s64) {
    x := t.v[a & 7]; y := t.v[b & 7]
    t.v[a & 7] = Dct8Saturate(x + y); t.v[b & 7] = Dct8Saturate(x - y)
}

// The 8-point inverse DCT of 7.13.2.3 with 16-bit Hadamard clamps.
Dct8 :: (t: *Dct8Lane) -> bool {
    p := t.*
    t.v[0] = p.v[0]; t.v[1] = p.v[4]; t.v[2] = p.v[2]; t.v[3] = p.v[6]
    t.v[4] = p.v[1]; t.v[5] = p.v[5]; t.v[6] = p.v[3]; t.v[7] = p.v[7]
    if !Dct8Rotate(t, 4, 7, 799, 4017, false) || !Dct8Rotate(t, 5, 6, 3406, 2276, false) ||
        !Dct8Rotate(t, 0, 1, 2896, 2896, true) || !Dct8Rotate(t, 2, 3, 1567, 3784, false) {
        return false
    }
    Dct8Sum(t, 4, 5); Dct8Sum(t, 7, 6); Dct8Sum(t, 0, 3); Dct8Sum(t, 1, 2)
    if !Dct8Rotate(t, 6, 5, 2896, 2896, true) { return false }
    for i: 0..3 { Dct8Sum(t, i, 7 - i) }
    return true
}

