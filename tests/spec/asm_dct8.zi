// AV1's 8-bit 8x8 DCT_DCT inverse transform as a typed #asm routine, the
// real-kernel check of #asm: SSSE3, AArch64 and ARMv7 NEON variants beside
// the portable body, compared with AV1's s64 reference by
// tests/asm_dct8.sh. In-file #run templates build each architecture below.
// The InverseDct8x8 #asm templates: x86-64 SSSE3, AArch64
// and ARMv7 NEON from one description of the transform, with the registers
// each step frees reused by the next. This file runs Program for each
// architecture with #run while it compiles.
#import "std/format"
using Vectors :: #import "std/vec";

#scope_file
X86 :: 0;
A64 :: 1;
ARM :: 2;

// Rotations by 799/4017, 3406/2276, 2896/2896 and 1567/3784. The NEON
// variants read cosine and sine from lanes of the table's first row,
// [799, 4017, 3406, 2276, 2896, 1567, 3784, 0]; x86 multiplies pairs from
// byte 16 + 32 * key (x = a*c - b*s) and 32 + 32 * key (y = a*s + b*c).
K799 :: 0;
K3406 :: 1;
K2896 :: 2;
K1567 :: 3;
CosLane :: s64.[0, 2, 4, 5];
SinLane :: s64.[1, 3, 4, 6];
// x86 table offsets: the rounding dwords and the pmulhrsw factors.
ROUND :: 144;
HALF :: 160;
SIXTEENTH :: 176;

Gen :: struct {
    arch: s64;
    free: [24]s64;
    count: s64;
    failed: bool;
    text: Vec(u8);
}

Release :: (g: *Gen, r: s64) {
    i: s64 = 0
    while i < g.count { if g.free[i] == r { g.failed = true }; i += 1 }
    g.free[g.count] = r
    g.count += 1
}

Take :: (g: *Gen) -> s64 {
    if g.count == 0 { g.failed = true; return 0 }
    r := g.free[0]
    i: s64 = 1
    while i < g.count { g.free[i - 1] = g.free[i]; i += 1 }
    g.count -= 1
    return r
}

// Start an instruction line, which the caller then prints into g.text; the
// template is the lines joined by newlines.
Line :: (g: *Gen) {
    if g.text.count > 0 { BuilderAppend(g.text, "\n") }
    BuilderAppend(g.text, "    ")
}

Put :: (g: *Gen, line: string) {
    Line(g)
    BuilderAppend(g.text, line)
}

Label :: (g: *Gen, name: string) {
    BuilderAppend(g.text, "\n")
    BuilderAppend(g.text, name)
}

// x86 operands: %%xmmN registers and N(%[name]) memory.
X :: (r: s64) -> string {
    name: Vec(u8)
    BuilderPrint(*name, "%%%%xmm%", r)
    return BuilderFinish(name)
}

Memory :: (offset: s64, operand: string) -> string {
    name: Vec(u8)
    if offset != 0 { BuilderPrint(*name, "%", offset) }
    BuilderPrint(*name, "(%%[%])", operand)
    return BuilderFinish(name)
}

E :: (g: *Gen, op: string, a: string, b: string) {
    Line(g); BuilderPrint(*g.text, "% %, %", op, a, b)
}

XMAX :: "%%xmm13";
XMIN :: "%%xmm14";

Track :: (g: *Gen, r: s64) {
    if g.arch == X86 {
        E(g, "pmaxsw", X(r), XMAX)
        E(g, "pminsw", X(r), XMIN)
    } else if g.arch == A64 {
        Line(g); BuilderPrint(*g.text, "smax v28.8h, v28.8h, v%.8h", r)
        Line(g); BuilderPrint(*g.text, "smin v29.8h, v29.8h, v%.8h", r)
    } else {
        Line(g); BuilderPrint(*g.text, "vmax.s16 q1, q1, q%", r)
        Line(g); BuilderPrint(*g.text, "vmin.s16 q2, q2, q%", r)
    }
}

Prologue :: (g: *Gen) {
    if g.arch == X86 {
        E(g, "movdqu", Memory(ROUND, "table"), "%%xmm12")
        E(g, "pxor", XMAX, XMAX)
        E(g, "pxor", XMIN, XMIN)
    } else if g.arch == A64 {
        Put(g, "ld1 {v0.8h}, [%[table]]")
        Put(g, "movi v28.8h, #0")
        Put(g, "movi v29.8h, #0")
    } else {
        Put(g, "vld1.16 {d0-d1}, [%[table]]")
        Put(g, "vmov.i16 q1, #0")
        Put(g, "vmov.i16 q2, #0")
        Put(g, "mov r12, %[dequant]")
    }
}

// Row i of the dequantized s32 block, narrowed to eight s16 lanes.
LoadRow :: (g: *Gen, i: s64) -> s64 {
    v := Take(g)
    if g.arch == X86 {
        t := Take(g)
        E(g, "movdqu", Memory(32 * i, "dequant"), X(v))
        E(g, "movdqu", Memory(32 * i + 16, "dequant"), X(t))
        E(g, "packssdw", X(t), X(v))
        Release(g, t)
    } else if g.arch == A64 {
        a := Take(g)
        b := Take(g)
        Line(g); BuilderPrint(*g.text, "ldp q%, q%, [%%[dequant], #%]", a, b, 32 * i)
        Line(g); BuilderPrint(*g.text, "sqxtn v%.4h, v%.4s", v, a)
        Line(g); BuilderPrint(*g.text, "sqxtn2 v%.8h, v%.4s", v, b)
        Release(g, a)
        Release(g, b)
    } else {
        Put(g, "vld1.32 {d24-d27}, [r12]!")
        Line(g); BuilderPrint(*g.text, "vqmovn.s32 d%, q12", 2 * v)
        Line(g); BuilderPrint(*g.text, "vqmovn.s32 d%, q13", 2 * v + 1)
    }
    Track(g, v)
    return v
}

// x86: interleave a and b's low and high halves into a and a new register.
Pair :: (g: *Gen, low: string, high: string, rows: []s64, o: s64, a: s64, b: s64, out: []s64) {
    t := Take(g)
    E(g, "movdqa", X(rows[a]), X(t))
    E(g, low, X(rows[b]), X(rows[a]))
    E(g, high, X(rows[b]), X(t))
    Release(g, rows[b])
    out[o] = rows[a]
    out[o + 1] = t
}

// AArch64: trn1 and trn2 of a and b into two new registers.
Step :: (g: *Gen, size: string, a: s64, b: s64, out: []s64, x: s64, y: s64) {
    t0 := Take(g)
    t1 := Take(g)
    Line(g); BuilderPrint(*g.text, "trn1 v%.%, v%.%, v%.%", t0, size, a, size, b, size)
    Line(g); BuilderPrint(*g.text, "trn2 v%.%, v%.%, v%.%", t1, size, a, size, b, size)
    Release(g, a)
    Release(g, b)
    out[x] = t0
    out[y] = t1
}

// Transpose the eight rows in r, leaving the columns in r.
Transpose :: (g: *Gen, r: []s64) {
    p: [8]s64
    q: [8]s64
    if g.arch == X86 {
        for m: 0..3 { Pair(g, "punpcklwd", "punpckhwd", r, 2 * m, 2 * m, 2 * m + 1, p[:]) }
        Pair(g, "punpckldq", "punpckhdq", p[:], 0, 0, 2, q[:])
        Pair(g, "punpckldq", "punpckhdq", p[:], 2, 1, 3, q[:])
        Pair(g, "punpckldq", "punpckhdq", p[:], 4, 4, 6, q[:])
        Pair(g, "punpckldq", "punpckhdq", p[:], 6, 5, 7, q[:])
        Pair(g, "punpcklqdq", "punpckhqdq", q[:], 0, 0, 4, r)
        Pair(g, "punpcklqdq", "punpckhqdq", q[:], 2, 1, 5, r)
        Pair(g, "punpcklqdq", "punpckhqdq", q[:], 4, 2, 6, r)
        Pair(g, "punpcklqdq", "punpckhqdq", q[:], 6, 3, 7, r)
    } else if g.arch == A64 {
        for m: 0..3 { Step(g, "8h", r[2 * m], r[2 * m + 1], p[:], 2 * m, 2 * m + 1) }
        bases := s64.[0, 4]
        for base: bases {
            Step(g, "4s", p[base], p[base + 2], q[:], base, base + 2)
            Step(g, "4s", p[base + 1], p[base + 3], q[:], base + 1, base + 3)
        }
        for k: 0..3 { Step(g, "2d", q[k], q[k + 4], r, k, k + 4) }
    } else {
        for m: 0..3 {
            Line(g); BuilderPrint(*g.text, "vtrn.16 q%, q%", r[2 * m], r[2 * m + 1])
        }
        firsts := s64.[0, 1, 4, 5]
        for a: firsts {
            Line(g); BuilderPrint(*g.text, "vtrn.32 q%, q%", r[a], r[a + 2])
        }
        for k: 0..3 {
            Line(g); BuilderPrint(*g.text, "vswp d%, d%", 2 * r[k] + 1, 2 * r[k + 4])
        }
    }
}

// Lanes x and y of t become a*c - b*s and a*s + b*c, Round2 by 12, from
// a = t[x] and b = t[y]; returns in p and q, which may swap x and y.
EmitButterfly :: (g: *Gen, t: []s64, x: s64, y: s64, p: s64, q: s64, key: s64) {
    a := t[x]
    b := t[y]
    if g.arch == X86 {
        t0 := Take(g)
        t1 := Take(g)
        k := Take(g)
        E(g, "movdqa", X(a), X(t0))
        E(g, "punpcklwd", X(b), X(t0))
        E(g, "punpckhwd", X(b), X(a))
        E(g, "movdqa", X(t0), X(b))
        E(g, "movdqa", X(a), X(t1))
        E(g, "movdqu", Memory(16 + 32 * key, "table"), X(k))
        E(g, "pmaddwd", X(k), X(t0))
        E(g, "pmaddwd", X(k), X(a))
        E(g, "movdqu", Memory(32 + 32 * key, "table"), X(k))
        E(g, "pmaddwd", X(k), X(b))
        E(g, "pmaddwd", X(k), X(t1))
        products := s64.[t0, a, b, t1]
        for r: products { E(g, "paddd", "%%xmm12", X(r)) }
        for r: products { E(g, "psrad", "$12", X(r)) }
        E(g, "packssdw", X(a), X(t0))
        E(g, "packssdw", X(t1), X(b))
        Track(g, t0)
        Track(g, b)
        Release(g, a)
        Release(g, t1)
        Release(g, k)
        t[p] = t0
        t[q] = b
        return
    }
    if g.arch == A64 {
        c := CosLane[key]
        s := SinLane[key]
        w: [4]s64
        for i: 0..3 { w[i] = Take(g) }
        Line(g); BuilderPrint(*g.text, "smull v%.4s, v%.4h, v0.h[%]", w[0], a, c)
        Line(g); BuilderPrint(*g.text, "smull2 v%.4s, v%.8h, v0.h[%]", w[1], a, c)
        Line(g); BuilderPrint(*g.text, "smlsl v%.4s, v%.4h, v0.h[%]", w[0], b, s)
        Line(g); BuilderPrint(*g.text, "smlsl2 v%.4s, v%.8h, v0.h[%]", w[1], b, s)
        Line(g); BuilderPrint(*g.text, "smull v%.4s, v%.4h, v0.h[%]", w[2], a, s)
        Line(g); BuilderPrint(*g.text, "smull2 v%.4s, v%.8h, v0.h[%]", w[3], a, s)
        Line(g); BuilderPrint(*g.text, "smlal v%.4s, v%.4h, v0.h[%]", w[2], b, c)
        Line(g); BuilderPrint(*g.text, "smlal2 v%.4s, v%.8h, v0.h[%]", w[3], b, c)
        Line(g); BuilderPrint(*g.text, "sqrshrn v%.4h, v%.4s, #12", a, w[0])
        Line(g); BuilderPrint(*g.text, "sqrshrn2 v%.8h, v%.4s, #12", a, w[1])
        Line(g); BuilderPrint(*g.text, "sqrshrn v%.4h, v%.4s, #12", b, w[2])
        Line(g); BuilderPrint(*g.text, "sqrshrn2 v%.8h, v%.4s, #12", b, w[3])
        Track(g, a)
        Track(g, b)
        for i: 0..3 { Release(g, w[i]) }
    } else {
        c := CosLane[key]
        s := SinLane[key]
        Line(g); BuilderPrint(*g.text, "vmull.s16 q12, d%, d%[%]", 2 * a, c / 4, c % 4)
        Line(g); BuilderPrint(*g.text, "vmull.s16 q13, d%, d%[%]", 2 * a + 1, c / 4, c % 4)
        Line(g); BuilderPrint(*g.text, "vmlsl.s16 q12, d%, d%[%]", 2 * b, s / 4, s % 4)
        Line(g); BuilderPrint(*g.text, "vmlsl.s16 q13, d%, d%[%]", 2 * b + 1, s / 4, s % 4)
        Line(g); BuilderPrint(*g.text, "vmull.s16 q14, d%, d%[%]", 2 * a, s / 4, s % 4)
        Line(g); BuilderPrint(*g.text, "vmull.s16 q15, d%, d%[%]", 2 * a + 1, s / 4, s % 4)
        Line(g); BuilderPrint(*g.text, "vmlal.s16 q14, d%, d%[%]", 2 * b, c / 4, c % 4)
        Line(g); BuilderPrint(*g.text, "vmlal.s16 q15, d%, d%[%]", 2 * b + 1, c / 4, c % 4)
        Line(g); BuilderPrint(*g.text, "vqrshrn.s32 d%, q12, #12", 2 * a)
        Line(g); BuilderPrint(*g.text, "vqrshrn.s32 d%, q13, #12", 2 * a + 1)
        Line(g); BuilderPrint(*g.text, "vqrshrn.s32 d%, q14, #12", 2 * b)
        Line(g); BuilderPrint(*g.text, "vqrshrn.s32 d%, q15, #12", 2 * b + 1)
        Track(g, a)
        Track(g, b)
    }
    t[p] = a
    t[q] = b
}

// t[x], t[y] = t[x] + t[y], t[x] - t[y], saturating.
EmitHadamard :: (g: *Gen, t: []s64, x: s64, y: s64) {
    a := t[x]
    b := t[y]
    r := Take(g)
    if g.arch == X86 {
        E(g, "movdqa", X(a), X(r))
        E(g, "paddsw", X(b), X(a))
        E(g, "psubsw", X(b), X(r))
        Release(g, b)
        t[x] = a
        t[y] = r
        return
    }
    if g.arch == A64 {
        Line(g); BuilderPrint(*g.text, "sqadd v%.8h, v%.8h, v%.8h", r, a, b)
        Line(g); BuilderPrint(*g.text, "sqsub v%.8h, v%.8h, v%.8h", b, a, b)
    } else {
        Line(g); BuilderPrint(*g.text, "vqadd.s16 q%, q%, q%", r, a, b)
        Line(g); BuilderPrint(*g.text, "vqsub.s16 q%, q%, q%", b, a, b)
    }
    Release(g, a)
    t[x] = r
    t[y] = b
}

// AV1's 8-point inverse DCT over the eight registers in p, in place.
EmitDct8 :: (g: *Gen, p: []s64) {
    t: [8]s64
    order := s64.[0, 4, 2, 6, 1, 5, 3, 7]
    for i: 0..7 { t[i] = p[order[i]] }
    EmitButterfly(g, t[:], 4, 7, 4, 7, K799)
    EmitButterfly(g, t[:], 5, 6, 5, 6, K3406)
    EmitButterfly(g, t[:], 0, 1, 1, 0, K2896)
    EmitButterfly(g, t[:], 2, 3, 2, 3, K1567)
    EmitHadamard(g, t[:], 4, 5)
    EmitHadamard(g, t[:], 7, 6)
    EmitHadamard(g, t[:], 0, 3)
    EmitHadamard(g, t[:], 1, 2)
    EmitButterfly(g, t[:], 6, 5, 5, 6, K2896)
    for i: 0..3 {
        EmitHadamard(g, t[:], i, 7 - i)
        p[i] = t[i]
        p[7 - i] = t[7 - i]
    }
}

// Round2(v, bits) in every lane.
RoundShift :: (g: *Gen, r: []s64, bits: s64) {
    if g.arch == X86 {
        k := Take(g)
        E(g, "movdqu", Memory(ifx bits == 1 then HALF else SIXTEENTH, "table"), X(k))
        for i: 0..7 { E(g, "pmulhrsw", X(k), X(r[i])) }
        Release(g, k)
        return
    }
    for i: 0..7 {
        if g.arch == A64 { Line(g); BuilderPrint(*g.text, "srshr v%.8h, v%.8h, #%", r[i], r[i], bits) }
        else { Line(g); BuilderPrint(*g.text, "vrshr.s16 q%, q%, #%", r[i], r[i], bits) }
    }
}

// Return 0 and write nothing when any lane saturated; otherwise widen the
// rows into the residual and return 1.
Finish :: (g: *Gen, rows: []s64) {
    if g.arch == X86 {
        k := Take(g)
        t := Take(g)
        E(g, "pcmpeqd", X(k), X(k))
        E(g, "psrlw", "$1", X(k))
        E(g, "pcmpeqw", XMAX, X(k))
        E(g, "pcmpeqd", X(t), X(t))
        E(g, "psllw", "$15", X(t))
        E(g, "pcmpeqw", XMIN, X(t))
        E(g, "por", X(t), X(k))
        E(g, "pmovmskb", X(k), "%%eax")
        Put(g, "movl $0, %[out]")
        Put(g, "testl %%eax, %%eax")
        Put(g, "jnz 9f")
        for i: 0..7 {
            v := rows[i]
            E(g, "movdqa", X(v), X(t))
            E(g, "punpcklwd", X(v), X(t))
            E(g, "psrad", "$16", X(t))
            E(g, "punpckhwd", X(v), X(v))
            E(g, "psrad", "$16", X(v))
            E(g, "movdqu", X(t), Memory(32 * i, "residual"))
            E(g, "movdqu", X(v), Memory(32 * i + 16, "residual"))
        }
        Put(g, "movl $1, %[out]")
    } else if g.arch == A64 {
        Put(g, "mvni v30.8h, #0x80, lsl #8")
        Put(g, "movi v31.8h, #0x80, lsl #8")
        Put(g, "cmeq v30.8h, v28.8h, v30.8h")
        Put(g, "cmeq v31.8h, v29.8h, v31.8h")
        Put(g, "orr v30.16b, v30.16b, v31.16b")
        Put(g, "umaxv h30, v30.8h")
        Put(g, "umov w9, v30.h[0]")
        Put(g, "mov %w[out], #0")
        Put(g, "cbnz w9, 9f")
        for i: 0..7 {
            a := Take(g)
            b := Take(g)
            Line(g); BuilderPrint(*g.text, "sxtl v%.4s, v%.4h", a, rows[i])
            Line(g); BuilderPrint(*g.text, "sxtl2 v%.4s, v%.8h", b, rows[i])
            Line(g); BuilderPrint(*g.text, "stp q%, q%, [%%[residual], #%]", a, b, 32 * i)
            Release(g, a)
            Release(g, b)
        }
        Put(g, "mov %w[out], #1")
    } else {
        Put(g, "vmvn.i16 q12, #0x8000")
        Put(g, "vmov.i16 q13, #0x8000")
        Put(g, "vceq.i16 q12, q1, q12")
        Put(g, "vceq.i16 q13, q2, q13")
        Put(g, "vorr q12, q12, q13")
        Put(g, "vorr d24, d24, d25")
        Put(g, "vmov r2, r3, d24")
        Put(g, "orrs r2, r2, r3")
        Put(g, "mov %[out], #0")
        Put(g, "bne 9f")
        Put(g, "mov r12, %[residual]")
        for i: 0..7 {
            Line(g); BuilderPrint(*g.text, "vmovl.s16 q12, d%", 2 * rows[i])
            Line(g); BuilderPrint(*g.text, "vmovl.s16 q13, d%", 2 * rows[i] + 1)
            Put(g, "vst1.32 {d24-d27}, [r12]!")
        }
        Put(g, "mov %[out], #1")
    }
    Label(g, "9:")
}

// The whole kernel for one architecture: rows, columns, then the check.
Program :: (arch: s64) -> string {
    g: Gen
    g.arch = arch
    if arch == X86 {
        for i: 0..11 { Release(*g, i) }
        Release(*g, 15)
    } else if arch == A64 {
        for i: 1..7 { Release(*g, i) }
        for i: 16..27 { Release(*g, i) }
    } else {
        for i: 3..11 { Release(*g, i) }
    }
    Prologue(*g)
    rows: [8]s64
    for i: 0..7 { rows[i] = LoadRow(*g, i) }
    Transpose(*g, rows[:])
    EmitDct8(*g, rows[:])
    RoundShift(*g, rows[:], 1)
    Transpose(*g, rows[:])
    EmitDct8(*g, rows[:])
    RoundShift(*g, rows[:], 4)
    Finish(*g, rows[:])
    if g.failed { return "" }
    return BuilderFinish(g.text)
}

#scope_export

// The 8-bit DCT_DCT 8x8 inverse transform of AV1 7.13.3 at 16-bit lanes:
// the row pass, Round2 by 1, the column pass and Round2 by 4, row-major
// s32 Dequant in, row-major s32 Residual out. With 8-bit content every
// Hadamard sum saturates at 16 bits as the specification clamps it, and
// Round2 by 1 and 4 are exact, so the only values 16 bits cannot carry
// are rotation results. The routine returns 0 and writes nothing when an
// input or a rotation result reaches the 16-bit bounds, so callers then
// take the general transform; otherwise it returns 1.

// ARM rotation constants as lanes, then x86 pmaddwd pairs (c, -s) and
// (s, c) for the four rotations, the 12-bit rounding term and the Round2
// multipliers for pmulhrsw.
Dct8Table: [96]s16 = .[
    799, 4017, 3406, 2276, 2896, 1567, 3784, 0,
    799, -4017, 799, -4017, 799, -4017, 799, -4017,
    4017, 799, 4017, 799, 4017, 799, 4017, 799,
    3406, -2276, 3406, -2276, 3406, -2276, 3406, -2276,
    2276, 3406, 2276, 3406, 2276, 3406, 2276, 3406,
    2896, -2896, 2896, -2896, 2896, -2896, 2896, -2896,
    2896, 2896, 2896, 2896, 2896, 2896, 2896, 2896,
    1567, -3784, 1567, -3784, 1567, -3784, 1567, -3784,
    3784, 1567, 3784, 1567, 3784, 1567, 3784, 1567,
    2048, 0, 2048, 0, 2048, 0, 2048, 0,
    16384, 16384, 16384, 16384, 16384, 16384, 16384, 16384,
    2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048];

Dct8Lane :: struct { v: [8]s64; }

Dct8Saturate :: (v: s64) -> s64 {
    if v > 32767 { return 32767 }
    if v < -32768 { return -32768 }
    return v
}

// B(a, b, flip): the rotation by (c, s), rounded by 12 bits; false when a
// result reaches the 16-bit bounds.
Dct8Rotate :: (t: *Dct8Lane, a: s64, b: s64, c: s64, s: s64, flip: bool) -> bool {
    x := (t.v[a & 7] * c - t.v[b & 7] * s + 2048) >> 12
    y := (t.v[a & 7] * s + t.v[b & 7] * c + 2048) >> 12
    if flip { t.v[a & 7] = y; t.v[b & 7] = x } else { t.v[a & 7] = x; t.v[b & 7] = y }
    return x > -32768 && x < 32767 && y > -32768 && y < 32767
}

// H(a, b): sum and difference, clamped to 16 bits.
Dct8Sum :: (t: *Dct8Lane, a: s64, b: s64) {
    x := t.v[a & 7]; y := t.v[b & 7]
    t.v[a & 7] = Dct8Saturate(x + y); t.v[b & 7] = Dct8Saturate(x - y)
}

// The 8-point inverse DCT of 7.13.2.3 with 16-bit Hadamard clamps.
Dct8 :: (t: *Dct8Lane) -> bool {
    p := t.*
    t.v[0] = p.v[0]; t.v[1] = p.v[4]; t.v[2] = p.v[2]; t.v[3] = p.v[6]
    t.v[4] = p.v[1]; t.v[5] = p.v[5]; t.v[6] = p.v[3]; t.v[7] = p.v[7]
    if !Dct8Rotate(t, 4, 7, 799, 4017, false) || !Dct8Rotate(t, 5, 6, 3406, 2276, false) ||
        !Dct8Rotate(t, 0, 1, 2896, 2896, true) || !Dct8Rotate(t, 2, 3, 1567, 3784, false) {
        return false
    }
    Dct8Sum(t, 4, 5); Dct8Sum(t, 7, 6); Dct8Sum(t, 0, 3); Dct8Sum(t, 1, 2)
    if !Dct8Rotate(t, 6, 5, 2896, 2896, true) { return false }
    for i: 0..3 { Dct8Sum(t, i, 7 - i) }
    return true
}

// One description of the transform, generated for each target as the spec
// compiles.
DCT8_X86 :: #run Program(X86);
DCT8_A64 :: #run Program(A64);
DCT8_ARM :: #run Program(ARM);

// table is Dct8Table; dequant and residual hold at least 64 values.
InverseDct8x8Lanes :: (dequant: []s32, residual: []s32, table: []s16) -> s32
#asm("x86_64+ssse3", DCT8_X86, "=&r", "r;r;r", "rax;xmm0..xmm15;cc")
#asm("aarch64", DCT8_A64, "=&r", "r;r;r", "x9;v0..v7;v16..v31;cc")
#asm("arm+neon", DCT8_ARM, "=&r", "r;r;r", "r2;r3;r12;q0..q15;cc") {
    unused table
    block: [64]s64
    for i: 0..63 {
        v := cast(s64)dequant[i]
        if v <= -32768 || v >= 32767 { return 0 }
        block[i] = v
    }
    lane: Dct8Lane
    for i: 0..7 {
        for j: 0..7 { lane.v[j] = block[i * 8 + j] }
        if !Dct8(*lane) { return 0 }
        for j: 0..7 { block[i * 8 + j] = (lane.v[j] + 1) >> 1 }
    }
    for j: 0..7 {
        for i: 0..7 { lane.v[i] = block[i * 8 + j] }
        if !Dct8(*lane) { return 0 }
        for i: 0..7 { block[i * 8 + j] = (lane.v[i] + 8) >> 4 }
    }
    for i: 0..63 { residual[i] = cast(s32)block[i] }
    return 1
}

// The 8-bit 8x8 DCT_DCT inverse transform of validated coefficients;
// false leaves residual alone for the general transform.
InverseDct8x8 :: (dequant: []s32, residual: []s32) -> bool {
    if dequant.count < 64 || residual.count < 64 { return false }
    return InverseDct8x8Lanes(dequant, residual, Dct8Table[:]) == 1
}
// cos128(angle) * 4096 for angles 0..255, the four quadrants of the
// specification's 65-entry table resolved ahead.
Cos128Signed :: s32.[
    4096,4095,4091,4085,4076,4065,4052,4036,4017,3996,3973,3948,3920,3889,3857,3822,
    3784,3745,3703,3659,3612,3564,3513,3461,3406,3349,3290,3229,3166,3102,3035,2967,
    2896,2824,2751,2675,2598,2520,2440,2359,2276,2191,2106,2019,1931,1842,1751,1660,
    1567,1474,1380,1285,1189,1092,995,897,799,700,601,501,401,301,201,101,
    0,-101,-201,-301,-401,-501,-601,-700,-799,-897,-995,-1092,-1189,-1285,-1380,-1474,
    -1567,-1660,-1751,-1842,-1931,-2019,-2106,-2191,-2276,-2359,-2440,-2520,-2598,-2675,-2751,-2824,
    -2896,-2967,-3035,-3102,-3166,-3229,-3290,-3349,-3406,-3461,-3513,-3564,-3612,-3659,-3703,-3745,
    -3784,-3822,-3857,-3889,-3920,-3948,-3973,-3996,-4017,-4036,-4052,-4065,-4076,-4085,-4091,-4095,
    -4096,-4095,-4091,-4085,-4076,-4065,-4052,-4036,-4017,-3996,-3973,-3948,-3920,-3889,-3857,-3822,
    -3784,-3745,-3703,-3659,-3612,-3564,-3513,-3461,-3406,-3349,-3290,-3229,-3166,-3102,-3035,-2967,
    -2896,-2824,-2751,-2675,-2598,-2520,-2440,-2359,-2276,-2191,-2106,-2019,-1931,-1842,-1751,-1660,
    -1567,-1474,-1380,-1285,-1189,-1092,-995,-897,-799,-700,-601,-501,-401,-301,-201,-101,
    0,101,201,301,401,501,601,700,799,897,995,1092,1189,1285,1380,1474,
    1567,1660,1751,1842,1931,2019,2106,2191,2276,2359,2440,2520,2598,2675,2751,2824,
    2896,2967,3035,3102,3166,3229,3290,3349,3406,3461,3513,3564,3612,3659,3703,3745,
    3784,3822,3857,3889,3920,3948,3973,3996,4017,4036,4052,4065,4076,4085,4091,4095]

Round2Signed :: (value: s64, bits: u32) -> s64 {
    if bits == 0 { return value }
    return (value + (cast(s64)1 << (bits - 1))) >> bits
}

Cos128 :: (angle: s64) -> s64 { return cast(s64)Cos128Signed[angle & 255] }

// Reverses the low `bits` (at most 8) bits of x: an 8-bit swap network,
// then the reversed byte shifted down to `bits` bits.
Brev :: (bits: s64, x: s64) -> s64 {
    value := x & 255
    value = ((value & 240) >> 4) | ((value & 15) << 4)
    value = ((value & 204) >> 2) | ((value & 51) << 2)
    value = ((value & 170) >> 1) | ((value & 85) << 1)
    return value >> cast(u32)(8 - bits)
}

// One row or column of a transform, at most 64 values. Indices are masked
// to the lane, which keeps every access provably in range.
TransformLane :: struct { values: [64]s64; }

// B(a,b,angle,flip): rotation, rounded by 12 bits, optionally exchanged.
Butterfly :: (t: *TransformLane, a: s64, b: s64, angle: s64, flip: bool) {
    c := Cos128(angle); s := Cos128(angle - 64)
    x := Round2Signed(t.values[a & 63] * c - t.values[b & 63] * s, 12)
    y := Round2Signed(t.values[a & 63] * s + t.values[b & 63] * c, 12)
    if flip { t.values[a & 63] = y; t.values[b & 63] = x } else { t.values[a & 63] = x; t.values[b & 63] = y }
}

// H(a,b,flip,r): sum/difference clamped to signed r bits.
Hadamard :: (t: *TransformLane, a: s64, b: s64, flip: bool, r: u32) {
    first := ifx flip then b else a; second := ifx flip then a else b
    x := t.values[first & 63]; y := t.values[second & 63]
    high := (cast(s64)1 << (r - 1)) - 1; low := -high - 1
    sum := x + y; difference := x - y
    if sum < low { sum = low }; if sum > high { sum = high }
    if difference < low { difference = low }; if difference > high { difference = high }
    t.values[first & 63] = sum; t.values[second & 63] = difference
}

InverseDCT :: (t: *TransformLane, n: s64, r: u32) {
    count := cast(s64)1 << cast(u32)n
    // The bit-reversal permutation, as swaps in place.
    for i: 0..count - 1 {
        j := Brev(n, i)
        if i < j { value := t.values[i & 63]; t.values[i & 63] = t.values[j & 63]; t.values[j & 63] = value }
    }
    if n == 6 { for i: 0..15 { Butterfly(t, 32 + i, 63 - i, 63 - 4 * Brev(4, i), false) } }
    if n >= 5 { for i: 0..7 { Butterfly(t, 16 + i, 31 - i, 6 + (Brev(3, 7 - i) << 3), false) } }
    if n == 6 { for i: 0..15 { Hadamard(t, 32 + i * 2, 33 + i * 2, (i & 1) == 1, r) } }
    if n >= 4 { for i: 0..3 { Butterfly(t, 8 + i, 15 - i, 12 + (Brev(2, 3 - i) << 4), false) } }
    if n >= 5 { for i: 0..7 { Hadamard(t, 16 + 2 * i, 17 + 2 * i, (i & 1) == 1, r) } }
    if n == 6 { for i: 0..3 { for j: 0..1 {
        Butterfly(t, 62 - i * 4 - j, 33 + i * 4 + j, 60 - 16 * Brev(2, i) + 64 * j, true)
    } } }
    if n >= 3 { for i: 0..1 { Butterfly(t, 4 + i, 7 - i, 56 - 32 * i, false) } }
    if n >= 4 { for i: 0..3 { Hadamard(t, 8 + 2 * i, 9 + 2 * i, (i & 1) == 1, r) } }
    if n >= 5 { for i: 0..1 { for j: 0..1 {
        Butterfly(t, 30 - 4 * i - j, 17 + 4 * i + j, 24 + (j << 6) + ((1 - i) << 5), true)
    } } }
    if n == 6 { for i: 0..7 { for j: 0..1 { Hadamard(t, 32 + i * 4 + j, 35 + i * 4 - j, (i & 1) == 1, r) } } }
    for i: 0..1 { Butterfly(t, 2 * i, 2 * i + 1, 32 + 16 * i, i == 0) }
    if n >= 3 { for i: 0..1 { Hadamard(t, 4 + 2 * i, 5 + 2 * i, i == 1, r) } }
    if n >= 4 { for i: 0..1 { Butterfly(t, 14 - i, 9 + i, 48 + 64 * i, true) } }
    if n >= 5 { for i: 0..3 { for j: 0..1 { Hadamard(t, 16 + 4 * i + j, 19 + 4 * i - j, (i & 1) == 1, r) } } }
    if n == 6 { for i: 0..1 { for j: 0..3 {
        Butterfly(t, 61 - i * 8 - j, 34 + i * 8 + j, 56 - i * 32 + (j >> 1) * 64, true)
    } } }
    for i: 0..1 { Hadamard(t, i, 3 - i, false, r) }
    if n >= 3 { Butterfly(t, 6, 5, 32, true) }
    if n >= 4 { for i: 0..1 { for j: 0..1 { Hadamard(t, 8 + 4 * i + j, 11 + 4 * i - j, i == 1, r) } } }
    if n >= 5 { for i: 0..3 { Butterfly(t, 29 - i, 18 + i, 48 + (i >> 1) * 64, true) } }
    if n == 6 { for i: 0..3 { for j: 0..3 { Hadamard(t, 32 + 8 * i + j, 39 + 8 * i - j, (i & 1) == 1, r) } } }
    if n >= 3 { for i: 0..3 { Hadamard(t, i, 7 - i, false, r) } }
    if n >= 4 { for i: 0..1 { Butterfly(t, 13 - i, 10 + i, 32, true) } }
    if n >= 5 { for i: 0..1 { for j: 0..3 { Hadamard(t, 16 + i * 8 + j, 23 + i * 8 - j, i == 1, r) } } }
    if n == 6 { for i: 0..7 { Butterfly(t, 59 - i, 36 + i, ifx i < 4 then 48 else 112, true) } }
    if n >= 4 { for i: 0..7 { Hadamard(t, i, 15 - i, false, r) } }
    if n >= 5 { for i: 0..3 { Butterfly(t, 27 - i, 20 + i, 32, true) } }
    if n == 6 { for i: 0..7 { Hadamard(t, 32 + i, 47 - i, false, r); Hadamard(t, 48 + i, 63 - i, true, r) } }
    if n >= 5 { for i: 0..15 { Hadamard(t, i, 31 - i, false, r) } }
    if n == 6 { for i: 0..7 { Butterfly(t, 55 - i, 40 + i, 32, true) } }
    if n == 6 { for i: 0..31 { Hadamard(t, i, 63 - i, false, r) } }
}

// The reference: AV1's s64 lanes with the specification's clamps.
Reference8x8 :: (dequant: []s32, residual: []s32) {
    lane: TransformLane
    block: [64]s64
    for i: 0..7 {
        for j: 0..7 { lane.values[j] = dequant[i * 8 + j] }
        InverseDCT(*lane, 3, 16)
        for j: 0..7 {
            v := Round2Signed(lane.values[j], 1)
            if v < -32768 { v = -32768 }; if v > 32767 { v = 32767 }
            block[i * 8 + j] = v
        }
    }
    for j: 0..7 {
        for i: 0..7 { lane.values[i] = block[i * 8 + j] }
        InverseDCT(*lane, 3, 16)
        for i: 0..7 { residual[i * 8 + j] = cast(s32)Round2Signed(lane.values[i], 4) }
    }
}

Next :: (state: *u64) -> u64 {
    x := state.*
    x = x ^ (x << 13); x = x ^ (x >> 7); x = x ^ (x << 17)
    state.* = x
    return x
}

// Uniform in [-limit, limit - 1].
Pick :: (state: *u64, limit: s64) -> s32 {
    return cast(s32)(cast(s64)(Next(state) % cast(u64)(2 * limit)) - limit)
}

// Coefficient blocks of five kinds: sparse low-frequency, dense moderate,
// dense at full range, a single coefficient at the edges of the range, and
// blocks close to the bounds at one position.
Fill :: (block: []s32, state: *u64, kind: s64) {
    for i: 0..63 { block[i] = 0 }
    if kind == 0 {
        for i: 0..63 {
            r := i / 8 + i % 8
            if Next(state) % cast(u64)(r + 2) == 0 { block[i] = Pick(state, cast(s64)1 << cast(u32)(Next(state) % 13 + 1)) }
        }
    } else if kind == 1 {
        for i: 0..63 { block[i] = Pick(state, 2048) }
    } else if kind == 2 {
        for i: 0..63 { block[i] = Pick(state, 32768) }
    } else if kind == 3 {
        position := cast(s64)(Next(state) % 64)
        edges := s32.[32766, -32767, 32767, -32768, 23170, -23170, 16384, -16384]
        block[position] = edges[Next(state) % 8]
    } else {
        for i: 0..63 { block[i] = Pick(state, 64) }
        block[0] = Pick(state, 32768)
    }
}

// Blocks the 16-bit kernel transforms, or -1 - n when block n differs from
// the reference.
#program_export
Verify :: (seed: s64, count: s64) -> s64 {
    state := cast(u64)seed * 2654435761 + 1
    dequant: [64]s32
    residual: [64]s32
    expected: [64]s32
    accepted: s64 = 0
    for n: 0..count - 1 {
        Fill(dequant[:], *state, n % 5)
        for i: 0..63 { residual[i] = 12345 }
        if InverseDct8x8(dequant[:], residual[:]) {
            accepted += 1
            Reference8x8(dequant[:], expected[:])
            for i: 0..63 { if residual[i] != expected[i] { return -1 - n } }
        } else {
            for i: 0..63 { if residual[i] != 12345 { return -1 - n } }
        }
    }
    return accepted
}

// Transforms rounds x 64 sparse blocks with the kernel (kind 0) or the
// reference (kind 1); returns a checksum.
#program_export
Bench :: (kind: s64, rounds: s64) -> s64 {
    state: u64 = 88172645463325252
    blocks: [4096]s32
    residual: [64]s32
    for b: 0..63 { Fill(blocks[b * 64:b * 64 + 64], *state, 0) }
    checksum: s64 = 0
    for round: 0..rounds - 1 {
        for b: 0..63 {
            dequant := blocks[b * 64:b * 64 + 64]
            if kind == 1 { Reference8x8(dequant, residual[:]) }
            else if !InverseDct8x8(dequant, residual[:]) { Reference8x8(dequant, residual[:]) }
            checksum = (checksum * 31 + residual[round & 63]) & 1152921504606846975
        }
    }
    return checksum
}
