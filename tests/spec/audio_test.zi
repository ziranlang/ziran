// Migrated mixer contract: WAV, voices, gain, pitch, loops, pause and PCM streams.
#import "std/audio"
#import "std/audio_decode_wav"
#import "std/byte_text_linux"
#import "std/math"
#import "std/vec"
Types :: #import "std/audio_types";
Wav :: #import "std/audio_wav";
PI :: 3.14159265358979

// RATE Hz audio of SECONDS: a LEFT and a RIGHT sine (0 Hz for silence) at
// AMPLITUDE, as WAV or Ogg Opus bytes.
Tone :: (rate: s32, seconds: float64, left: float64, right: float64, channels: s32, amplitude: float64) -> Types.PCM {
    pcm: Types.PCM
    pcm.rate = rate
    pcm.channels = channels
    frames := cast(s64)(seconds * cast(float64)rate)
    for frame: 0..frames - 1 {
        for channel: 0..channels - 1 {
            hertz := ifx channel == 0 then left else right
            value := amplitude * Sin(2.0 * PI * hertz * cast(float64)frame / cast(float64)rate)
            VecPush(pcm.samples, cast(float32)value)
        }
    }
    return pcm
}

WavBytes :: (pcm: *Types.PCM, output: *Vec(u8)) -> bool { return Wav.WavEncode(pcm, output) == Types.OK }

TAPPED :: 262144
tapped: [TAPPED]float32;
tapped_count: s64;
Tap :: (samples: []float32, frames: s64) {
    for index: 0..frames * 2 - 1 {
        if tapped_count < TAPPED { tapped[tapped_count] = samples[index]; tapped_count += 1 }
    }
}

Near :: (a: float32, b: float32, tolerance: float32 = 0.002) -> bool {
    difference := a - b
    return difference < tolerance && difference > -tolerance
}

Fail :: (code: s32, message: string) -> s32 {
    print("desktop audio: %\n", message)
    return code
}

#program_export
main :: () -> s32 {
    output: [8192]float32

    // A sound decoded whole: a 440 Hz mono sine at half scale, played at half gain.
    low := Tone(48000, 0.25, 440.0, 0.0, 1, 0.5)
    wav: Vec(u8)
    if !WavBytes(*low, *wav) { return Fail(10, "the test WAV was not encoded") }
    low_wav := TextView(wav[:])
    sound := AudioLoad(low_wav, false)
    if sound.slot < 0 { return Fail(11, "the WAV did not load") }
    if !Near(cast(float32)AudioLength(sound), 0.25) { return Fail(12, "the WAV's length is wrong") }
    AudioUseTap(Tap)
    AudioSetGain(sound, 0.5)
    if !AudioPlay(sound) || !AudioPlaying(sound) { return Fail(13, "the sound did not play") }
    AudioRender(output[:], 1024)
    for frame: 0..1023 {
        expected := 0.5 * low.samples[frame]
        if !Near(output[frame * 2], expected) || output[frame * 2 + 1] != output[frame * 2] {
            print("frame %: % % expected %\n", frame, output[frame * 2], output[frame * 2 + 1], expected)
            return Fail(14, "the mixed sound is wrong")
        }
    }
    if tapped_count != 2048 { return Fail(15, "the tap did not see the block") }
    for index: 0..2047 { if tapped[index] != output[index] { return Fail(16, "the tap saw other samples") } }

    // Two voices mix: an 880 Hz sine on the left only joins the first.
    pair := Tone(48000, 0.25, 880.0, 0.0, 2, 0.25)
    pair_wav: Vec(u8)
    if !WavBytes(*pair, *pair_wav) { return Fail(17, "the stereo WAV was not encoded") }
    left := AudioLoad(TextView(pair_wav[:]), false)
    if left.slot < 0 || !AudioPlay(left) || !AudioPlay(sound) { return Fail(18, "the stereo WAV did not play") }
    AudioRender(output[:], 1024)
    for frame: 0..1023 {
        mono := 0.5 * low.samples[frame]
        if !Near(output[frame * 2], mono + pair.samples[frame * 2]) || !Near(output[frame * 2 + 1], mono) {
            return Fail(19, "two voices did not mix")
        }
    }
    AudioStop(left)

    // Pitch 2 plays every other frame, so the sound ends in half its time.
    AudioSetPitch(sound, 2.0)
    unused AudioPlay(sound)
    AudioRender(output[:], 512)
    for frame: 0..511 {
        if !Near(output[frame * 2], 0.5 * low.samples[frame * 2]) { return Fail(20, "pitch 2 did not skip frames") }
    }
    for block: 0..12 { AudioRender(output[:], 512) }
    if AudioState(sound) != .Finished { return Fail(21, "the sound did not finish at pitch 2") }
    AudioRender(output[:], 512)
    for index: 0..1023 { if output[index] != 0.0 { return Fail(22, "a finished sound still plays") } }

    // A loop starts over; a paused voice is silent and resumes where it was.
    AudioSetPitch(sound, 1.0)
    AudioSetLooping(sound, true)
    unused AudioPlay(sound)
    for block: 0..30 { AudioRender(output[:], 1000) }
    if AudioState(sound) != .Playing || AudioPosition(sound) >= 0.25 { return Fail(23, "the loop did not start over") }
    AudioPause(sound)
    position := AudioPosition(sound)
    AudioRender(output[:], 1024)
    for index: 0..2047 { if output[index] != 0.0 { return Fail(24, "a paused voice still plays") } }
    AudioResume(sound)
    AudioRender(output[:], 480)
    if AudioState(sound) != .Playing || !Near(cast(float32)(AudioPosition(sound) - position), 0.01, 0.0005) {
        return Fail(25, "the voice did not resume where it paused")
    }
    AudioSetLooping(sound, false)
    if !AudioSeek(sound, .1) || !Near(cast(float32)AudioPosition(sound), .1) { return Fail(34, "seek position is wrong") }
    AudioRender(output[:], 128)
    if !Near(output[0], .5 * low.samples[4800]) { return Fail(35, "seek played another frame") }
    AudioPause(sound)
    if !AudioSeek(sound, .05) || AudioState(sound) != .Paused || AudioSeek(sound, -.1) || AudioSeek(sound, .3) { return Fail(36, "seek state or bounds failed") }
    AudioRender(output[:], 128)
    if output[0] != 0.0 || !Near(cast(float32)AudioPosition(sound), .05) { return Fail(37, "paused seek advanced") }
    AudioStop(sound)

    // A PCM stream plays the blocks submitted, then silence, and never ends.
    stream := AudioOpenStream(24000, 2, 256)
    if stream.slot < 0 || !AudioStreamWritable(stream) { return Fail(26, "the PCM stream did not open") }
    block: [512]s16
    for index: 0..511 { block[index] = cast(s16)((index % 2) * 16384 - 8192) }
    if AudioStreamSubmit(stream, block[0:511]) { return Fail(27, "a short block was accepted") }
    // Play starts a stream afresh, so blocks follow it.
    if !AudioPlay(stream) || !AudioStreamSubmit(stream, block[:]) || !AudioStreamSubmit(stream, block[:]) {
        return Fail(28, "the PCM blocks were not taken")
    }
    // At half the mixer's rate each of the 512 submitted frames plays twice,
    // then the stream waits in silence.
    AudioRender(output[:], 1024)
    for frame: 0..1021 {
        if !Near(output[frame * 2], -0.25) || !Near(output[frame * 2 + 1], 0.25) {
            print("stream frame %: % %\n", frame, output[frame * 2], output[frame * 2 + 1])
            return Fail(29, "the PCM stream's samples are wrong")
        }
    }
    if output[2046] != 0.0 || output[2047] != 0.0 { return Fail(30, "an empty stream did not wait in silence") }
    if !AudioStreamSubmit(stream, block[:]) { return Fail(31, "the stream took no block after waiting") }
    AudioRender(output[:], 256)
    if !Near(output[100], -0.25) { return Fail(31, "a block after waiting did not play at once") }
    for round: 0..3 { AudioRender(output[:], 1024) }
    if AudioState(stream) != .Playing { return Fail(30, "an empty stream finished") }
    for round: 0..3 { unused AudioStreamSubmit(stream, block[:]) }
    if AudioStreamWritable(stream) || AudioStreamSubmit(stream, block[:]) { return Fail(31, "a full stream took another block") }
    if AudioSeek(stream, .01) { return Fail(38, "a live PCM stream was seekable") }
    AudioUnload(stream)
    if AudioState(stream) != .Unloaded || AudioPlay(stream) { return Fail(32, "an unloaded stream still answers") }

    AudioUnload(sound); AudioUnload(left)
    VecFree(low.samples); VecFree(pair.samples); VecFree(wav); VecFree(pair_wav)
    if AudioLoad("not audio", false).slot >= 0 { return Fail(33, "text loaded as audio") }
    print("audio mixer contract passed\n")
    return 0
}
