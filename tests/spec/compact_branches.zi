Branch :: (value: s32) -> s32 {
    if value == 0 {
        return 10
    } else if value == 1 { return 11 }
    else if value == 2 { return 12 } else { return 13 }
}

Nested :: (value: s32) -> s32 {
    result: s32 = 0
    if value < 0 {
        result = 1
    } else { if value == 0 { result = 2 } else if value == 1 { result = 3 } else { result = 4 } }
    result += 10
    return result
}

Negated :: (enabled: bool) -> s32 {
    if enabled {
        return 1
    } else if !enabled { return 2 }
    return 3
}

Pair :: struct { first: s32; second: s32; }

ContinuedStatements :: (enabled: bool) -> s32 {
    state: Pair
    if enabled {
        state.first = 1
        state.second = 2
    } else { state.first = 3; state.second = 4 }
    return state.first * 10 + state.second
}

// Blocks opened together on one line and closed together with '} }'.
SharedLines :: (limit: s32) -> s32 {
    total: s32 = 0
    for y: 0..limit { for x: 0..limit {
        total += x * 10 + y
    } }
    if limit > 0 { if total > 0 {
        total += 1000
    } }
    for y: 0..1 { if y == 1 { total += 5
    } }
    return total
}

main :: () {
    print("% % % %\n", Branch(0), Branch(1), Branch(2), Branch(3))
    print("% % % %\n", Nested(-1), Nested(0), Nested(1), Nested(2))
    print("% %\n", Negated(true), Negated(false))
    print("% %\n", ContinuedStatements(true), ContinuedStatements(false))
    print("% %\n", SharedLines(0), SharedLines(2))
}
