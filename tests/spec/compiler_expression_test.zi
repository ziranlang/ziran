Expression :: #import "compiler_expression";
Scan :: #import "compiler_scan";
Source :: #import "compiler_source";

Parser :: struct {
    source: string
    token: Scan.Scan
    depth: s32
    failed: s32
    conditional: s32
    binaries: s32
}
parser: Parser;

Begin :: () -> s64 { return parser.token.begin }
Token :: () -> string { return parser.source[parser.token.begin:parser.token.end] }
Advance :: () { parser.token = Scan.NextToken(parser.source, parser.token.end, 1, 1) }
ConditionalError :: () { parser.failed = 1; parser.conditional += 1 }
Hooks :: () -> Expression.ExpressionHooks {
    return .{*parser.depth, *parser.failed, Begin, Token, Prefix, Advance, Binary, ConditionalError}
}
Parse :: (minimum: s32) -> s32 {
    hooks := Hooks()
    return Expression.ParseBinary(*hooks, minimum)
}
Prefix :: () -> s32 {
    parser.depth += 1
    if parser.depth > 128 { parser.failed = 1; parser.depth -= 1; return -1 }
    token := Token()
    value: s32 = 0
    if token == "(" {
        Advance()
        value = Parse(1)
        if Token() != ")" { parser.failed = 1 }
        else { Advance() }
    } else if token == "-" || token == "+" {
        Advance()
        value = Prefix()
        if token == "-" { value = -value }
    } else if parser.token.kind == Scan.TokenKind.Int {
        for byte: token { value = value * 10 + cast(s32)(byte - 48) }
        Advance()
    } else { parser.failed = 1; value = -1 }
    parser.depth -= 1
    return value
}
Binary :: (start: s64, op: string, left: s32, right: s32) -> s32 {
    if start < 0 || start > parser.source.count { parser.failed = 1 }
    parser.binaries += 1
    if parser.failed != 0 { return -1 }
    if op == "+" { return left + right }
    if op == "-" { return left - right }
    if op == "*" { return left * right }
    if op == "/" { return left / right }
    if op == "%" { return left % right }
    if op == "<<" { return left << right }
    if op == ">>" { return left >> right }
    if op == "&" { return left & right }
    if op == "|" { return left | right }
    if op == "^" { return left ^ right }
    if op == "==" { return cast(s32)(left == right) }
    if op == "!=" { return cast(s32)(left != right) }
    if op == "<" { return cast(s32)(left < right) }
    if op == "<=" { return cast(s32)(left <= right) }
    if op == ">" { return cast(s32)(left > right) }
    if op == ">=" { return cast(s32)(left >= right) }
    if op == "&&" { return cast(s32)(left != 0 && right != 0) }
    if op == "||" { return cast(s32)(left != 0 || right != 0) }
    parser.failed = 1
    return -1
}
Evaluate :: (source: string) -> s32 {
    parser = .{source = source}
    Advance()
    return Parse(1)
}

Grammar :: () -> bool {
    expressions: [18]string = .{"1 + 2 * 3", "9 - 3 - 2", "24 / 3 / 2", "10 % 3",
        "1 + 2 << 2", "32 >> 2 + 1", "7 & 3", "4 | 3", "7 ^ 3",
        "2 + 3 == 5", "2 != 3", "2 < 3", "2 <= 2", "3 > 2", "3 >= 3",
        "1 && 0 || 1", "-(2 + 3) * 2", "1 | 2 ^ 3 & 1"}
    values: [18]s32 = .{7, 4, 4, 1, 12, 4, 3, 7, 4, 1, 1, 1, 1, 1, 1, 1, -10, 3}
    for index: 0..17 {
        if Evaluate(expressions[index]) != values[index] || parser.failed != 0 ||
        parser.depth != 0 || Token() != "" { return false }
    }
    if Evaluate("1 +") != -1 || parser.failed != 1 || parser.depth != 0 { return false }
    unused Evaluate("1 ? 2 : 3")
    if parser.conditional != 1 || parser.depth != 0 { return false }
    parser = .{source = "1 + 2"}
    Advance()
    if Parse(12) != 1 || Token() != "+" || parser.binaries != 0 { return false }
    parser = .{source = "1", depth = 128}
    Advance()
    if Parse(1) != -1 || parser.failed != 1 || parser.depth != 128 { return false }
    parser = .{source = "1;"}
    Advance()
    return Parse(0) == 1 && Token() == ";" && parser.depth == 0
}

Characters :: () -> bool {
    literals: [10]string = .{"\"A\"", "\"\\0\"", "\"\\n\"", "\"\\r\"", "\"\\t\"",
        "\"\\\"\"", "\"\\\\\"", "\"\\x00\"", "\"\\xAf\"", "\"\\xFF\""}
    values: [10]s32 = .{65, 0, 10, 13, 9, 34, 92, 0, 175, 255}
    for index: 0..9 { if Expression.CharacterByte(literals[index]) != values[index] { return false } }
    invalid: [13]string = .{"", "\"\"", "\"AB\"", "'A'", "\"\\q\"", "\"\\xg0\"",
        "\"\\x0g\"", "\"\\x0\"", "\"\\x000\"", "\"\\u0041\"", "\"é\"", "\"A", "A\""}
    for text: invalid { if Expression.CharacterByte(text) != -1 { return false } }
    return true
}

Statements :: () -> bool {
    parts := Expression.StatementParts("answer : s32 = 1 + 2;", Source.StatementKind.Declaration)
    if !parts.has_declaration || !parts.has_value || parts.name != "answer" || parts.type != "s32" ||
    parts.value != " 1 + 2;" || parts.error != Expression.StatementExpressionError.None { return false }
    parts = Expression.StatementParts("value: [2]s32; ", Source.StatementKind.Declaration)
    if !parts.has_declaration || parts.has_value || parts.type != "[2]s32" { return false }
    parts = Expression.StatementParts("value: s32 #wrong", Source.StatementKind.Declaration)
    if parts.error != Expression.StatementExpressionError.Modifier || parts.modifier != "#wrong" { return false }
    parts = Expression.StatementParts("value: [2]s32 = {1, 2}", Source.StatementKind.Declaration)
    if parts.error != Expression.StatementExpressionError.ArrayLiteral { return false }
    parts = Expression.StatementParts("array[index(\"+=\")] <<= 2", Source.StatementKind.Assignment)
    if parts.assignment != "<<=" || parts.lhs != "array[index(\"+=\")] " || parts.value != " 2" { return false }
    operators: [11]string = .{"=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>="}
    for op: operators {
        parts = Expression.StatementParts(op, Source.StatementKind.Assignment)
        if parts.assignment != op || !parts.has_value || parts.lhs != "" || parts.value != "" { return false }
    }
    parts = Expression.StatementParts("else if (ok) { \t", Source.StatementKind.If)
    if !parts.is_else || !parts.has_value || parts.value != " (ok)" { return false }
    parts = Expression.StatementParts("while(ok) {", Source.StatementKind.While)
    if parts.value != "(ok)" { return false }
    parts = Expression.StatementParts("if #complete item == {", Source.StatementKind.IfCase)
    if parts.value != "item" { return false }
    parts = Expression.StatementParts("return 42;", Source.StatementKind.Return)
    if parts.value != " 42;" { return false }
    parts = Expression.StatementParts("unused thing", Source.StatementKind.Unused)
    if parts.value != " thing" { return false }
    if Expression.StatementParts(" ;", Source.StatementKind.Expression).has_value ||
    Expression.StatementParts("break", Source.StatementKind.Break).has_value { return false }
    return true
}

// Use the grammar with independent tree storage, including borrowed names
// that survive token advancement and recursively parsed call arguments.
TreeNode :: struct {
    kind: s32
    name: string
    left: s32
    right: s32
    third: s32
    first: s32
    sibling: s32
    argument: string
}
TreeParser :: struct {
    source: string
    token: Scan.Scan
    depth: s32
    failed: s32
    errors: s32
    defaults: s32
    count: s32
    nodes: [256]TreeNode
}
tree: TreeParser;
TreeBegin :: () -> s64 { return tree.token.begin }
TreeToken :: () -> string { return tree.source[tree.token.begin:tree.token.end] }
TreeKind :: () -> Scan.TokenKind { return tree.token.kind }
TreeAdvance :: () { tree.token = Scan.NextToken(tree.source, tree.token.end, 1, 1) }
TreeLink :: (previous: s32, next: s32) { tree.nodes[previous].sibling = next }
TreeAdd :: (kind: s32, name: string, left: s32 = -1, right: s32 = -1,
    third: s32 = -1, first: s32 = -1) -> s32 {
    if tree.count >= 256 { tree.failed = 1; return -1 }
    index := tree.count
    tree.nodes[index] = .{kind = kind, name = name, left = left, right = right,
        third = third, first = first, sibling = -1}
    tree.count += 1
    return index
}
TreeName :: (callee: s32) -> string {
    if callee >= 0 && tree.nodes[callee].kind == 0 { return tree.nodes[callee].name }
    return ""
}
TreeArgument :: (child: s32, name: string) { tree.nodes[child].argument = name }
TreeDefaults :: (callee: s32, first: s32, last: s32) -> Expression.ExpressionChildren {
    if TreeName(callee) != "Default" { return .{first, last} }
    tree.defaults += 1
    child := TreeAdd(0, "default")
    if last >= 0 { TreeLink(last, child) } else { first = child }
    return .{first, child}
}
TreeError :: (error: Expression.PostfixError) {
    tree.failed = 1
    tree.errors = cast(s32)error + 1
}
TreeConditionalError :: () { tree.failed = 1 }
TreePostfixNode :: (start: s64, kind: Expression.PostfixKind, name: string,
    left: s32, right: s32, third: s32, first: s32) -> s32 {
    if start < 0 || start > tree.source.count { tree.failed = 1 }
    return TreeAdd(10 + cast(s32)kind, name, left, right, third, first)
}
TreeFieldType :: (type: string, name: string, ordinal: s32) -> string {
    if type == "Root" && (name == "nested" || (name == "" && ordinal == 0)) { return "Child" }
    return "Element"
}
TreeField :: (start: s64, name: string, named: bool, value: s32) -> s32 {
    if start < 0 || start > tree.source.count { tree.failed = 1 }
    return TreeAdd(2, name, cast(s32)named, value)
}
TreeInitializer :: (start: s64, type: string, first: s32) -> s32 {
    if start < 0 || start > tree.source.count { tree.failed = 1 }
    return TreeAdd(3, type, first = first)
}
TreeCursor :: () -> Expression.SyntaxCursor {
    return .{*tree.depth, *tree.failed, tree.source, TreeBegin, TreeToken,
        TreeKind, TreeAdvance, TreeParse, TreeLink}
}
TreePrefix :: () -> s32 {
    tree.depth += 1
    if tree.depth > 128 { tree.failed = 1; tree.depth -= 1; return -1 }
    start := TreeBegin()
    value: s32 = -1
    if TreeToken() == "{" {
        cursor := TreeCursor()
        hooks: Expression.InitializerHooks = .{*cursor, TreeFieldType, TreeField, TreeInitializer}
        value = Expression.ParseInitializer(*hooks, start, "Root", "{", "}")
    } else if TreeToken() == "(" {
        TreeAdvance()
        value = TreeParse(1)
        if TreeToken() != ")" { tree.failed = 1 } else { TreeAdvance() }
    } else if TreeKind() == Scan.TokenKind.Int || TreeKind() == Scan.TokenKind.Ident {
        value = TreeAdd(0, TreeToken())
        TreeAdvance()
    } else { tree.failed = 1 }
    cursor := TreeCursor()
    hooks: Expression.PostfixHooks = .{*cursor, TreePostfixNode, TreeArgument,
        TreeDefaults, TreeName, TreeError}
    value = Expression.ParsePostfix(*hooks, start, value)
    tree.depth -= 1
    return value
}
TreeBinary :: (start: s64, op: string, left: s32, right: s32) -> s32 {
    if start < 0 || start > tree.source.count { tree.failed = 1 }
    return TreeAdd(1, op, left, right)
}
TreeParse :: (minimum: s32) -> s32 {
    hooks: Expression.ExpressionHooks = .{*tree.depth, *tree.failed, TreeBegin,
        TreeToken, TreePrefix, TreeAdvance, TreeBinary, TreeConditionalError}
    return Expression.ParseBinary(*hooks, minimum)
}
TreeRead :: (source: string) -> s32 {
    tree = .{source = source}
    TreeAdvance()
    return TreeParse(1)
}
SyntaxGrammar :: () -> bool {
    root := TreeRead("Run(first = Next(2), second = items[1:3].value).*[0]")
    if tree.failed != 0 || tree.depth != 0 || TreeToken() != "" || tree.nodes[root].kind != 10 { return false }
    pointer := tree.nodes[root].left
    call := tree.nodes[pointer].left
    if tree.nodes[pointer].kind != 13 || tree.nodes[call].kind != 14 || tree.nodes[call].name != "Run" { return false }
    first := tree.nodes[call].first
    second := tree.nodes[first].sibling
    if tree.nodes[first].argument != "first" || tree.nodes[first].name != "Next" ||
    tree.nodes[second].argument != "second" || tree.nodes[second].name != "value" ||
    tree.nodes[second].kind != 12 || tree.nodes[tree.nodes[second].left].kind != 11 { return false }
    expressions: [4]string = .{"items[:]", "items[:3]", "items[1:]", "items[1:3]"}
    for index: 0..3 {
        root = TreeRead(expressions[index])
        if tree.failed != 0 || tree.nodes[root].kind != 11 ||
        (tree.nodes[root].right >= 0) != (index >= 2) ||
        (tree.nodes[root].third >= 0) != (index == 1 || index == 3) { return false }
    }
    root = TreeRead("Default()")
    if tree.failed != 0 || tree.defaults != 1 || tree.nodes[tree.nodes[root].first].name != "default" { return false }
    root = TreeRead("provider.method(1)(named = 2)")
    if tree.failed != 0 || tree.nodes[root].name != "" || tree.nodes[tree.nodes[root].left].kind != 14 ||
    tree.nodes[tree.nodes[root].first].argument != "named" { return false }
    root = TreeRead("{.nested = {1, 2}, trailing = Default(3), 4,}")
    if tree.failed != 0 || TreeToken() != "" || tree.depth != 0 || tree.nodes[root].name != "Root" { return false }
    first = tree.nodes[root].first
    second = tree.nodes[first].sibling
    if tree.nodes[first].name != "nested" || tree.nodes[first].left != 1 ||
    tree.nodes[tree.nodes[first].right].name != "Child" || tree.nodes[second].name != "trailing" ||
    tree.nodes[tree.nodes[second].sibling].left != 0 || tree.defaults != 1 { return false }
    root = TreeRead("{}")
    if tree.failed != 0 || tree.nodes[root].first != -1 { return false }
    invalid: [8]string = .{"items[1", "items[]", "items.", "Call(1,)",
        "{named = }", "{1", "{.1 = 2}", "Call(named = )"}
    for input: invalid {
        unused TreeRead(input)
        if tree.failed != 1 || tree.depth != 0 { return false }
    }
    errors: [3]string = .{"value->field", "value++", "value?"}
    for index: 0..2 {
        unused TreeRead(errors[index])
        if tree.failed != 1 || tree.errors != index + 1 || tree.depth != 0 { return false }
    }
    unused TreeRead("value ?")
    if tree.failed != 1 || tree.errors != 0 || tree.depth != 0 { return false }
    tree = .{source = "{{1}}", depth = 128}
    TreeAdvance()
    cursor := TreeCursor()
    hooks: Expression.InitializerHooks = .{*cursor, TreeFieldType, TreeField, TreeInitializer}
    return Expression.ParseInitializer(*hooks, 0, "Root", "{", "}") == -1 &&
        tree.failed == 1 && tree.depth == 128
}

#program_export
Answer :: () -> s32 {
    if !Grammar() { return 1 }
    if !Characters() { return 2 }
    if !Statements() { return 3 }
    if !SyntaxGrammar() { return 4 }
    return 42
}

HashText :: (hash: u32, text: string) -> u32 {
    result := hash
    for byte: text { result = result * cast(u32)16777619 ^ cast(u32)byte }
    return result
}

// Deterministic bounded byte corpus, including malformed tokens and
// incomplete declarations. Hash all borrowed ranges to compare backends.
#program_export
Fingerprint :: () -> s64 {
    corpus := " aZ09_=+-*/%&|^<>!;:\"\\x\n\t?{}[]()#\0é"
    hash: u32 = 2166136261
    random: u32 = 17
    input: [64]u8
    for trial: 0..191 {
        random = random * cast(u32)1664525 + cast(u32)1013904223
        count := cast(s64)(random % cast(u32)64)
        for index: 0..count - 1 {
            random = random * cast(u32)1664525 + cast(u32)1013904223
            input[index] = corpus[cast(s64)(random % cast(u32)corpus.count)]
        }
        text := TextView(input[0:count])
        hash = hash * cast(u32)16777619 ^ cast(u32)Expression.CharacterByte(text)
        hash = hash * cast(u32)16777619 ^ cast(u32)Expression.BinaryPrecedence(text)
        for kind: 0..16 {
            parts := Expression.StatementParts(text, cast(Source.StatementKind)kind)
            hash = HashText(HashText(HashText(hash, parts.name), parts.type), parts.value)
            hash = HashText(HashText(HashText(hash, parts.lhs), parts.assignment), parts.modifier)
            hash = hash * cast(u32)16777619 ^ cast(u32)parts.error
            hash = hash * cast(u32)16777619 ^ cast(u32)parts.has_value
            hash = hash * cast(u32)16777619 ^ cast(u32)parts.is_else
        }
        unused TreeRead(text)
        hash = hash * cast(u32)16777619 ^ cast(u32)tree.failed
        hash = hash * cast(u32)16777619 ^ cast(u32)tree.depth
        hash = hash * cast(u32)16777619 ^ cast(u32)tree.errors
        for index: 0..tree.count - 1 {
            node := tree.nodes[index]
            hash = HashText(HashText(hash, node.name), node.argument)
            hash = hash * cast(u32)16777619 ^ cast(u32)node.kind
            hash = hash * cast(u32)16777619 ^ cast(u32)node.left
            hash = hash * cast(u32)16777619 ^ cast(u32)node.right
            hash = hash * cast(u32)16777619 ^ cast(u32)node.third
            hash = hash * cast(u32)16777619 ^ cast(u32)node.first
            hash = hash * cast(u32)16777619 ^ cast(u32)node.sibling
        }
    }
    return cast(s64)hash
}

Run :: () { print("% %\n", Answer(), Fingerprint()) }
