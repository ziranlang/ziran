ElementTraps :: (test: *NativeTest) {
    types: [33]LirType
    ElementTypes(types[:])
    constants: [4]LirConstant = .[
        .{.type = 6, .bits = 0xffffffff}, .{.type = 9, .bits = 3},
        .{.type = 7, .bits = 0}, .{.type = 7, .bits = 0}]
    globals: [3]LirGlobal = .[
        .{.module = 0, .name = "numbers", .type = 11, .constant = -1, .writable = true},
        .{.module = 0, .name = "wrong-type", .type = 14, .constant = -1, .writable = true},
        .{.module = 0, .name = "zero-count", .type = 31, .constant = -1, .writable = true}]
    empty: [0]s32
    element_operands: [2]s32 = .[0, 1]
    element_pointer: [1]s32 = .[2]
    returned: [1]s32 = .[3]
    modules: [1]string = .["native-test"]
    for mode: 0..3 {
        instructions: [5]LirInstruction
        values: [4]s32
        instructions[0] = Instruction(.GlobalAddress, 0, empty[:], ifx mode == 3 then 2 else 0)
        instructions[1] = Instruction(.Constant, 1, empty[:], ifx mode == 0 then 0 else ifx mode == 1 then 1 else 2)
        if mode == 2 { instructions[0] = Instruction(.Null, 0, empty[:]) }
        instructions[2] = Instruction(.ElementAddress, 2, element_operands[:])
        instructions[3] = Instruction(.Load, 3, element_pointer[:]); instructions[3].effect = 1
        instructions[4] = Instruction(.Return, -1, returned[:])
        values[0] = ifx mode == 3 then 32 else 22
        values[1] = ifx mode == 0 then 6 else ifx mode == 1 then 9 else 7
        values[2] = 10
        values[3] = 7
        blocks: [1]LirBlock = .[.{.instructions = instructions[:]}]
        functions: [1]LirFunction = .[.{.name = "element-trap", .module = 0, .result = 7,
            .values = values[:], .blocks = blocks[:], .origin = -1}]
        program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
            .constants = constants[:], .globals = globals[:], .functions = functions[:], .entry = 0}
        Execute(test, program, 125, CheckConcat("element address trap mode ", CheckNumber(mode)))
    }
    constants[3].bits = 4
    root_index: [2]s32 = .[0, 1]
    dynamic_index: [3]s32 = .[2, 1, 3]
    dynamic_pointer: [1]s32 = .[4]
    dynamic_returned: [1]s32 = .[5]
    dynamic_instructions: [7]LirInstruction = .[
        Instruction(.GlobalAddress, 0, empty[:], 0), Instruction(.Constant, 1, empty[:], 2),
        Instruction(.ElementAddress, 2, root_index[:]), Instruction(.Constant, 3, empty[:], 3),
        Instruction(.ElementAddress, 4, dynamic_index[:]), Instruction(.Load, 5, dynamic_pointer[:]),
        Instruction(.Return, -1, dynamic_returned[:])]
    dynamic_instructions[5].effect = 1
    dynamic_values: [6]s32 = .[22, 7, 10, 7, 10, 7]
    dynamic_blocks: [1]LirBlock = .[.{.instructions = dynamic_instructions[:]}]
    dynamic_functions: [1]LirFunction = .[.{.name = "forged-dynamic-count", .module = 0,
        .result = 7, .values = dynamic_values[:], .blocks = dynamic_blocks[:], .origin = -1}]
    dynamic_program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .globals = globals[:], .functions = dynamic_functions[:], .entry = 0}
    Execute(test, dynamic_program, 125, "dynamic element count beyond remaining extent traps")
    valid_instructions: [5]LirInstruction = .[
        Instruction(.GlobalAddress, 0, empty[:], 0), Instruction(.Constant, 1, empty[:], 2),
        Instruction(.ElementAddress, 2, element_operands[:]), Instruction(.Load, 3, element_pointer[:]),
        Instruction(.Return, -1, returned[:])]
    valid_instructions[3].effect = 1
    valid_values: [4]s32 = .[22, 7, 10, 7]
    valid_blocks: [1]LirBlock = .[.{.instructions = valid_instructions[:]}]
    valid_functions: [1]LirFunction = .[.{.name = "wrong-element-token", .module = 0, .result = 7,
        .values = valid_values[:], .blocks = valid_blocks[:], .origin = -1}]
    valid_program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .globals = globals[:], .functions = valid_functions[:], .entry = 0}
    Execute(test, valid_program, 0, "valid element address token")
    if !native_execution || test.failed { return }
    no_bytes: [0]u8
    measured := LirX64Elf(valid_program, no_bytes[:])
    image := LirX64ElfLayout(valid_program)
    bytes: Vec(u8)
    defer VecFree(bytes)
    if !NativeAssert(test, measured.problem == .None && image.problem == .None &&
        VecResize(bytes, measured.size), "allocate wrong element token fixture") { return }
    written := LirX64Elf(valid_program, bytes[:])
    if !NativeAssert(test, written.problem == .None, "encode wrong element token fixture") { return }
    address_at: s64 = -1
    for index: image.text_offset..image.text_offset + image.text_size - 10 {
        if bytes[index] == 72 && bytes[index + 1] == 184 && Little(bytes[:], index + 2, 8) == 1 {
            if address_at != -1 {
                unused NativeAssert(test, false, "unique element parent token")
                return
            }
            address_at = index
        }
    }
    if !NativeAssert(test, address_at >= image.text_offset, "locate element parent token") { return }
    bytes[address_at + 2] = 2
    path := CheckPath(test.work, "wrong-element-token")
    if !NativeWrite(test, path, TextFromBytes(bytes[:])) { return }
    chmod: [3]string = .["/usr/bin/chmod", "700", path]
    unused NativeRun(test, chmod[:])
    command: [1]string = .[path]
    unused NativeRun(test, command[:], "", 125)
}

