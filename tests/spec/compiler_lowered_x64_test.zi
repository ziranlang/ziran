    for index: cast(s64)0..globals.count - 1 {
        globals[index] = .{.module = 0, .name = "bounded", .type = 7,
            .constant = -1, .writable = true}
    }
    empty: [0]s32
    returned: [1]s32 = .[0]
    instructions: [2]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 0), Instruction(.Return, -1, returned[:])]
