AggregateOracle :: (test: *NativeTest) {
    if !native_execution || test.failed { return }
    source := #string END
#include <stdint.h>
#include <string.h>
typedef struct { uint32_t value; uint32_t data[3]; } Row;
typedef struct { Row head; Row rows[2]; void *pointer; float f32; double f64; } Top;
int main(void) {
    Top original = {0};
    uint32_t negative_zero = 0x80000000u;
    original.head.data[2] = 3;
    memcpy(&original.f32, &negative_zero, sizeof(negative_zero));
    Top changed = original;
    changed.head.data[2] = 9;
    uint32_t observed = 0;
    memcpy(&observed, &changed.f32, sizeof(observed));
    return (int)(changed.head.data[2] + 30 + (observed == negative_zero));
}
END
    source_path := CheckPath(test.work, "aggregate-oracle.c")
    executable_path := CheckPath(test.work, "aggregate-oracle")
    if !NativeWrite(test, source_path, source) { return }
    compile: [5]string = .["/usr/bin/cc", "-std=c11", source_path, "-o", executable_path]
    unused NativeRun(test, compile[:])
    command: [1]string = .[executable_path]
    unused NativeRun(test, command[:], "", 40)
}

