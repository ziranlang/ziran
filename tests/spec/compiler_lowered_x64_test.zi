using IR :: #import "compiler_lowered_ir"
using Native :: #import "compiler_lowered_x64"
using Test :: #import "native_test"
using Vectors :: #import "std/vec"
using Check :: #import "check_support"
using Bytes :: #import "std/byte_text_linux"
using Files :: #import "std/file"
using Texts :: #import "std/text_tools"

#scope_file
native_execution: bool;
aggregate_record_fields: [2]s32 = .[7, 11];
aggregate_top_fields: [5]s32 = .[12, 13, 10, 15, 16];
native_recursive_signature_parameters: [3]s32 = .[7, 12, 17];
native_holder_fields: [2]s32 = .[17, 7];
native_selector_signature_parameters: [1]s32 = .[1];
native_wide_signature_parameters: [9]s32 = .[7, 15, 12, 17, 7, 7, 7, 7, 7];
native_float_signature_parameters: [1]s32 = .[15];

#scope_export

Little :: (bytes: []u8, at: s64, count: s64) -> u64 {
    if at < 0 || count < 0 || at > bytes.count || count > bytes.count - at { return 0 }
    result: u64
    for index: cast(s64)0..count - 1 { result |= cast(u64)bytes[at + index] << cast(u64)(index * 8) }
    return result
}

PackedSize :: (program: LirProgram, type_id: s32) -> s64 {
    type := program.types[type_id]
    if type.kind == .Bool { return 1 }
    if type.kind == .Integer || type.kind == .Float { return type.bits / 8 }
    if type.kind == .Pointer || type.kind == .Function { return 8 }
    if type.kind == .Array { return type.count * PackedSize(program, type.element) }
    size: s64
    for field: type.fields { size += PackedSize(program, field) }
    return size
}

GlobalOffset :: (program: LirProgram, global: s64) -> s64 {
    offset: s64
    for index: cast(s64)0..global - 1 {
        if program.globals[index].writable == program.globals[global].writable {
            offset += PackedSize(program, program.globals[index].type)
        }
    }
    return offset
}

HasAllocations :: (program: LirProgram) -> bool {
    for function: program.functions { for block: function.blocks { for instruction: block.instructions {
        if instruction.op == .Allocate { return true }
    } } }
    return false
}

Symbols :: (test: *NativeTest, program: LirProgram, bytes: []u8, ranges: []LirNativeRange,
    image: LirX64ImageLayout) -> bool {
    globals := program.globals.count != 0 || HasAllocations(program)
    section_count := ifx globals then 6 + cast(s64)(image.data_size != 0) else 5
    names_index := section_count - 3
    section_bits := Little(bytes, 40, 8)
    if !NativeAssert(test, section_bits <= cast(u64)bytes.count &&
        Little(bytes, 60, 2) == cast(u64)section_count &&
        Little(bytes, 62, 2) == cast(u64)names_index, "ELF section directory and names index") { return false }
    section_at := cast(s64)section_bits
    if !NativeAssert(test, section_at % 8 == 0 && section_at + section_count * 64 == bytes.count,
        "ELF section directory extent") { return false }
    symbol_header := section_at + (section_count - 1) * 64
    string_header := section_at + (section_count - 2) * 64
    symbol_at := Little(bytes, symbol_header + 24, 8)
    symbol_size := Little(bytes, symbol_header + 32, 8)
    string_at := Little(bytes, string_header + 24, 8)
    string_size := Little(bytes, string_header + 32, 8)
    if !NativeAssert(test, Little(bytes, symbol_header + 4, 4) == 2 &&
        Little(bytes, symbol_header + 40, 4) == cast(u64)(section_count - 2) &&
        Little(bytes, symbol_header + 44, 4) == 1 &&
        Little(bytes, symbol_header + 48, 8) == 8 && Little(bytes, symbol_header + 56, 8) == 24 &&
        symbol_size == cast(u64)(program.functions.count + program.globals.count + 3) * 24 &&
        symbol_at + symbol_size == section_bits &&
        string_at <= symbol_at && string_size <= symbol_at - string_at, "ELF symbol and string table layout") { return false }
    for index: cast(s64)0..23 {
        if !NativeAssert(test, bytes[cast(s64)symbol_at + index] == 0, "ELF null symbol") { return false }
    }
    for function_index: cast(s64)0..program.functions.count - 1 {
        function := program.functions[function_index]
        symbol := cast(s64)symbol_at + (function_index + 3) * 24
        name := Little(bytes, symbol, 4)
        expected := CheckConcat(CheckConcat(program.modules[function.module], ":"), function.name)
        if !NativeAssert(test, name < string_size && cast(u64)expected.count < string_size - name,
            "ELF function name extent") { return false }
        for index: cast(s64)0..expected.count - 1 {
            if !NativeAssert(test, bytes[cast(s64)(string_at + name) + index] == expected[index], "ELF qualified function names") { return false }
        }
        if !NativeAssert(test, bytes[cast(s64)(string_at + name) + expected.count] == 0 &&
            Little(bytes, symbol + 4, 1) == 18 && Little(bytes, symbol + 6, 2) == 1,
            "ELF function symbol kind and code section") { return false }
        begin: s64 = -1
        end := image.text_size
        for range: ranges {
            if range.block == -1 && range.function == cast(s32)function_index { begin = range.begin }
            if range.block == -1 && range.function == cast(s32)function_index + 1 { end = range.begin }
        }
        if !NativeAssert(test, begin >= 35 && Little(bytes, symbol + 8, 8) == image.text_address + cast(u64)begin &&
            Little(bytes, symbol + 16, 8) == cast(u64)(end - begin), "ELF symbols match final mapped function bytes") { return false }
    }
    name_at: s64 = 18
    for function: program.functions {
        name_at += program.modules[function.module].count + function.name.count + 2
    }
    for global_index: cast(s64)0..program.globals.count - 1 {
        global := program.globals[global_index]
        symbol := cast(s64)symbol_at + (program.functions.count + global_index + 3) * 24
        name := Little(bytes, symbol, 4)
        expected := CheckConcat(CheckConcat(program.modules[global.module], ":"), global.name)
        if !NativeAssert(test, name == cast(u64)name_at && name < string_size &&
            cast(u64)expected.count < string_size - name, "ELF global name extent") { return false }
        for index: cast(s64)0..expected.count - 1 {
            if !NativeAssert(test, bytes[cast(s64)(string_at + name) + index] == expected[index],
                "ELF qualified global names") { return false }
        }
        section := ifx global.writable then cast(u64)3 else cast(u64)2
        base := ifx global.writable then image.data_address else image.readonly_address
        if !NativeAssert(test, Little(bytes, symbol + 4, 1) == 17 && Little(bytes, symbol + 6, 2) == section &&
            Little(bytes, symbol + 8, 8) == base + cast(u64)GlobalOffset(program, global_index) &&
            Little(bytes, symbol + 16, 8) == cast(u64)PackedSize(program, global.type),
            "ELF object symbols match packed globals") { return false }
        name_at += program.modules[global.module].count + global.name.count + 2
    }
    if globals {
        readonly_header := section_at + 128
        data_header := section_at + 192
        segments := cast(u64)1 + cast(u64)(image.readonly_size != 0) + cast(u64)(image.data_size != 0)
        if !NativeAssert(test, Little(bytes, 56, 2) == segments &&
            Little(bytes, 64, 4) == 1 && Little(bytes, 68, 4) == 5 &&
            Little(bytes, 96, 8) == cast(u64)(image.text_offset + image.text_size) &&
            Little(bytes, 104, 8) == cast(u64)(image.text_offset + image.text_size) &&
            Little(bytes, 112, 8) == 4096 &&
            Little(bytes, readonly_header + 4, 4) == 1 &&
            Little(bytes, readonly_header + 8, 8) == 2 &&
            Little(bytes, readonly_header + 16, 8) == image.readonly_address &&
            Little(bytes, readonly_header + 24, 8) == cast(u64)image.readonly_offset &&
            Little(bytes, readonly_header + 32, 8) == cast(u64)image.readonly_size,
            "ELF has distinct RX text and read-only data") { return false }
        if image.data_size != 0 && !NativeAssert(test,
            Little(bytes, data_header + 4, 4) == 1 && Little(bytes, data_header + 8, 8) == 3 &&
            Little(bytes, data_header + 16, 8) == image.data_address &&
            Little(bytes, data_header + 24, 8) == cast(u64)image.data_offset &&
            Little(bytes, data_header + 32, 8) == cast(u64)image.data_size,
            "ELF emits RW data only when nonempty") { return false }
    } else {
        if !NativeAssert(test, image.text_offset == 120 && Little(bytes, 56, 2) == 1 &&
            Little(bytes, 68, 4) == 5, "legacy no-global ELF layout") { return false }
    }
    return !test.failed
}

Types :: (types: []LirType) {
    types[0] = .{.kind = .Void}
    types[1] = .{.kind = .Bool, .bits = 1}
    for index: 2..9 {
        types[index] = .{.kind = .Integer, .bits = cast(s32)(8 << ((index - 2) / 2)), .is_signed = index % 2 == 0}
    }
}

AggregateTypes :: (types: []LirType) {
    Types(types[:10])
    types[10] = .{.kind = .Pointer, .element = 7}
    types[11] = .{.kind = .Array, .element = 7, .count = 3}
    types[12] = .{.kind = .Record, .fields = aggregate_record_fields[:]}
    types[13] = .{.kind = .Array, .element = 12, .count = 2}
    types[14] = .{.kind = .Record, .fields = aggregate_top_fields[:]}
    types[15] = .{.kind = .Float, .bits = 32}
    types[16] = .{.kind = .Float, .bits = 64}
}

FunctionTypes :: (types: []LirType) {
    AggregateTypes(types[:17])
    types[17] = .{.kind = .Function, .parameters = native_recursive_signature_parameters[:], .result = 12}
    types[18] = .{.kind = .Record, .fields = native_holder_fields[:]}
    types[19] = .{.kind = .Array, .element = 18, .count = 2}
    types[20] = .{.kind = .Function, .parameters = native_selector_signature_parameters[:], .result = 17}
    types[21] = .{.kind = .Function, .parameters = native_wide_signature_parameters[:], .result = 12}
    types[22] = .{.kind = .Function, .parameters = native_float_signature_parameters[:], .result = 15}
}

GlobalTypes :: (types: []LirType) {
    AggregateTypes(types[:17])
    types[17] = .{.kind = .Pointer, .element = 1}
    types[18] = .{.kind = .Pointer, .element = 2}
    types[19] = .{.kind = .Pointer, .element = 5}
    types[20] = .{.kind = .Pointer, .element = 16}
    types[21] = .{.kind = .Pointer, .element = 12}
    types[22] = .{.kind = .Pointer, .element = 11}
    types[23] = .{.kind = .Pointer, .element = 10}
    types[24] = .{.kind = .Pointer, .element = 14}
    types[25] = .{.kind = .Pointer, .element = 15}
}

ElementTypes :: (types: []LirType) {
    GlobalTypes(types[:26])
    types[26] = .{.kind = .Pointer, .element = 13}
    types[27] = .{.kind = .Record}
    types[28] = .{.kind = .Array, .element = 27, .count = 3}
    types[29] = .{.kind = .Pointer, .element = 28}
    types[30] = .{.kind = .Pointer, .element = 27}
    types[31] = .{.kind = .Array, .element = 7, .count = 0}
    types[32] = .{.kind = .Pointer, .element = 31}
}

Instruction :: (op: LirOp, result: s64, operands: []s32, symbol: s64 = -1) -> LirInstruction {
    return .{.op = op, .result = cast(s32)result, .operands = operands, .symbol = cast(s32)symbol, .origin = -1}
}

Execute :: (test: *NativeTest, program: LirProgram, expected: s32, label: string) {
    if test.failed { return }
    empty: [0]u8
    measured := LirX64Elf(program, empty[:])
    raw_size := LirX64Encode(program, empty[:])
    image := LirX64ElfLayout(program)
    no_ranges: [0]LirNativeRange
    range_size := LirX64Ranges(program, no_ranges[:])
    ranges: Vec(LirNativeRange)
    if !NativeAssert(test, range_size.problem == .None && range_size.size > 2 &&
        VecResize(ranges, range_size.size + 1), CheckConcat("measure native ranges: ", label)) {
        print("native range problem %\n", cast(s32)range_size.problem)
        return
    }
    for range_index: cast(s64)0..ranges.count - 1 { ranges[range_index].begin = 12345 }
    short_ranges := LirX64Ranges(program, ranges[:range_size.size - 1])
    unused NativeAssert(test, short_ranges.problem == .Limit && short_ranges.size == range_size.size, "short map reports range count")
    for range: ranges { unused NativeAssert(test, range.begin == 12345, "short map leaves output unchanged") }
    mapped := LirX64Ranges(program, ranges[:])
    unused NativeAssert(test, mapped.problem == .None && mapped.size == range_size.size &&
        ranges[range_size.size].begin == 12345, "complete map leaves output tail unchanged")
    previous: s64
    for range_index: cast(s64)0..range_size.size - 1 {
        range := ranges[range_index]
        unused NativeAssert(test, range.begin == previous && range.end >= range.begin, "native map is contiguous")
        previous = range.end
    }
    unused NativeAssert(test, previous == raw_size.size, "native map covers final encoded bytes")
    if !NativeAssert(test, measured.problem == .None && image.problem == .None &&
        measured.size == image.file_size && raw_size.size == image.text_size &&
        measured.size > image.text_offset, CheckConcat("measure ", label)) {
        print("native problem %\n", cast(s32)measured.problem); return
    }
    bytes: Vec(u8); again: Vec(u8); raw: Vec(u8)
    if !NativeAssert(test, VecResize(bytes, measured.size + 16) && VecResize(again, measured.size) &&
        VecResize(raw, raw_size.size), "allocate encoding buffers") { return }
    for index: cast(s64)0..bytes.count - 1 { bytes[index] = 165 }
    short := LirX64Elf(program, bytes[:measured.size - 1])
    unused NativeAssert(test, short.problem == .Limit && short.size == measured.size, "short buffer reports full size")
    for byte: bytes { unused NativeAssert(test, byte == 165, "short buffer unchanged") }
    written := LirX64Elf(program, bytes[:])
    second := LirX64Elf(program, again[:])
    encoded := LirX64Encode(program, raw[:])
    unused NativeAssert(test, written.problem == .None && written.size == measured.size &&
        second.problem == .None && encoded.problem == .None &&
        encoded.size + image.text_offset <= measured.size, "complete encodings")
    for index: cast(s64)0..measured.size - 1 { unused NativeAssert(test, bytes[index] == again[index], "deterministic output") }
    for index: measured.size..bytes.count - 1 { unused NativeAssert(test, bytes[index] == 165, "output tail unchanged") }
    for index: cast(s64)0..raw.count - 1 {
        unused NativeAssert(test, bytes[index + image.text_offset] == raw[index], "raw and ELF code match")
    }
    if !Symbols(test, program, bytes[:measured.size], ranges[:range_size.size], image) { return }
    entry: [5]u8 = .[72, 131, 228, 240, 232]
    for index: 0..4 { unused NativeAssert(test, raw[index] == entry[index], "SysV entry bytes") }
    path := CheckPath(test.work, "direct-elf")
    if !NativeWrite(test, path, TextFromBytes(bytes[:measured.size])) { return }
    chmod: [3]string = .["/usr/bin/chmod", "700", path]
    unused NativeRun(test, chmod[:])
    command: [1]string = .[path]
    if native_execution { unused NativeRun(test, command[:], "", expected) }
    if test.failed { print("native execution: %\n", label) }
}

Scalar :: (test: *NativeTest, types: []LirType, type: s64, op: LirOp, left_bits: u64, right_bits: u64,
    expected: s32, result_type: s64 = -1) {
    result := cast(s32)(ifx result_type < 0 then type else result_type)
    constants: [2]LirConstant = .[.{.type = cast(s32)type, .bits = left_bits}, .{.type = cast(s32)type, .bits = right_bits}]
    operands: [2]s32 = .[0, 1]
    returned: [1]s32 = .[2]
    values: [3]s32 = .[cast(s32)type, cast(s32)type, result]
    empty: [0]s32
    unary := op == .Negate || op == .BitNot || op == .Convert || op == .Bitcast
    instructions: [4]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 0), Instruction(.Constant, 1, empty[:], 1),
        Instruction(op, 2, operands[:ifx unary then 1 else 2]), Instruction(.Return, -1, returned[:])]
    blocks: [1]LirBlock = .[.{.instructions = instructions[:]}]
    functions: [1]LirFunction = .[.{.name = "scalar", .module = 0, .result = result,
        .values = values[:], .blocks = blocks[:], .entry = 0, .origin = -1}]
    modules: [1]string = .["native-test"]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types,
        .constants = constants[:], .functions = functions[:], .entry = 0}
    label := CheckConcat(LirOpName(op), CheckConcat(" type ", CheckNumber(type)))
    Execute(test, program, expected, label)
}

DynamicArrayValues :: (test: *NativeTest) {
    for mode: 0..8 {
        types: [7]LirType = .[.{.kind = .Void}, .{.kind = .Integer, .bits = 32, .is_signed = true},
            .{.kind = .Integer, .bits = 8}, .{.kind = .Integer, .bits = 8, .is_signed = true},
            .{.kind = .Array, .element = 1, .count = 300}, .{.kind = .Pointer, .element = 4},
            .{.kind = .Integer, .bits = 64}]
        constants: [3]LirConstant = .[.{.type = 2, .bits = 255}, .{.type = 1, .bits = 42},
            .{.type = 2, .bits = 255}]
        values: [7]s32 = .[5, 4, 2, 1, 4, 2, 1]
        if mode == 1 { types[4].count = 3; constants[0].bits = 2; constants[2].bits = 2 }
        if mode == 2 { types[4].count = 0; constants[0].bits = 0; constants[2].bits = 0 }
        if mode == 3 { constants[0].type = 3; values[2] = 3 }
        if mode == 4 || mode == 5 {
            constants[0].type = 6; values[2] = 6; constants[2].type = 6; values[5] = 6
            constants[0].bits = ifx mode == 4 then cast(u64)4294967296 else cast(u64)299
            constants[2].bits = constants[0].bits
        }
        if mode == 6 { constants[2].type = 3; values[5] = 3 }
        if mode == 7 { constants[2].type = 6; values[5] = 6; constants[2].bits = 300 }
        if mode == 8 { constants[2].bits = 0 }
        empty: [0]s32; loaded: [1]s32 = .[0]
        inserted: [3]s32 = .[1, 3, 2]; extracted: [2]s32 = .[4, 5]; returned: [1]s32 = .[6]
        instructions: [8]LirInstruction = .[
            Instruction(.GlobalAddress, 0, empty[:], 0), Instruction(.Load, 1, loaded[:]),
            Instruction(.Constant, 2, empty[:], 0), Instruction(.Constant, 3, empty[:], 1),
            Instruction(.Insert, 4, inserted[:]), Instruction(.Constant, 5, empty[:], 2),
            Instruction(.Extract, 6, extracted[:]), Instruction(.Return, -1, returned[:])]
        instructions[1].effect = 1
        blocks: [1]LirBlock = .[.{.instructions = instructions[:]}]
        modules := string.["dynamic-array"]
        globals: [1]LirGlobal = .[.{.module = 0, .name = "zero-array", .type = 4, .constant = -1, .writable = true}]
        functions: [1]LirFunction = .[.{.module = 0, .name = "replace", .result = 1,
            .values = values[:], .blocks = blocks[:], .origin = -1}]
        program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
            .constants = constants[:], .globals = globals[:], .functions = functions[:], .entry = 0}
        trapping := mode >= 2 && mode <= 4 || mode == 6 || mode == 7
        Execute(test, program, ifx trapping then 125 else ifx mode == 8 then 0 else 42, "dynamic-array")
        if test.failed { return }
    }
}

NestedAggregates :: (test: *NativeTest) {
    types: [17]LirType
    AggregateTypes(types[:])
    constants: [10]LirConstant = .[
        .{.type = 7, .bits = 10}, .{.type = 7, .bits = 20}, .{.type = 7, .bits = 30},
        .{.type = 7, .bits = 40}, .{.type = 7, .bits = 50},
        .{.type = 15, .bits = 0x80000000}, .{.type = 16, .bits = 0x7ff8000000000042},
        .{.type = 7, .bits = 0x80000000}, .{.type = 9, .bits = 0x7ff8000000000042},
        .{.type = 9, .bits = 0x8000000000000000}]
    empty: [0]s32
    array_values: [3]s32 = .[0, 1, 2]
    first_record_values: [2]s32 = .[3, 7]
    second_record_values: [2]s32 = .[4, 7]
    record_array_values: [2]s32 = .[8, 9]
    top_values: [5]s32 = .[8, 10, 11, 5, 6]
    top_array: [1]s32 = .[12]
    second_record: [1]s32 = .[13]
    nested_array: [1]s32 = .[14]
    last_array_value: [1]s32 = .[15]
    replace_array_value: [2]s32 = .[15, 4]
    first_array_value: [1]s32 = .[17]
    top_pointer: [1]s32 = .[12]
    pointer_equal: [2]s32 = .[19, 20]
    top_float32: [1]s32 = .[12]
    float32_bits: [1]s32 = .[22]
    float32_equal: [2]s32 = .[23, 24]
    top_float64: [1]s32 = .[12]
    float64_bits: [1]s32 = .[26]
    float64_equal: [2]s32 = .[27, 28]
    pointer_answer: [1]s32 = .[21]
    float32_answer: [1]s32 = .[25]
    float64_answer: [1]s32 = .[29]
    first_sum: [2]s32 = .[16, 18]
    second_sum: [2]s32 = .[33, 30]
    third_sum: [2]s32 = .[34, 31]
    fourth_sum: [2]s32 = .[35, 32]
    unsigned_source: [1]s32 = .[37]
    unsigned_float: [1]s32 = .[38]
    unsigned_equal: [2]s32 = .[37, 39]
    unsigned_answer: [1]s32 = .[40]
    final_sum: [2]s32 = .[36, 41]
    returned: [1]s32 = .[42]
    instructions: [44]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 0), Instruction(.Constant, 1, empty[:], 1),
        Instruction(.Constant, 2, empty[:], 2), Instruction(.Constant, 3, empty[:], 3),
        Instruction(.Constant, 4, empty[:], 4), Instruction(.Constant, 5, empty[:], 5),
        Instruction(.Constant, 6, empty[:], 6),
        Instruction(.Aggregate, 7, array_values[:]), Instruction(.Aggregate, 8, first_record_values[:]),
        Instruction(.Aggregate, 9, second_record_values[:]), Instruction(.Aggregate, 10, record_array_values[:]),
        Instruction(.Null, 11, empty[:]), Instruction(.Aggregate, 12, top_values[:]),
        Instruction(.Extract, 13, top_array[:]), Instruction(.Extract, 14, second_record[:]),
        Instruction(.Extract, 15, nested_array[:]), Instruction(.Extract, 16, last_array_value[:]),
        Instruction(.Insert, 17, replace_array_value[:]), Instruction(.Extract, 18, first_array_value[:]),
        Instruction(.Extract, 19, top_pointer[:]), Instruction(.Null, 20, empty[:]),
        Instruction(.Equal, 21, pointer_equal[:]), Instruction(.Extract, 22, top_float32[:]),
        Instruction(.Bitcast, 23, float32_bits[:]), Instruction(.Constant, 24, empty[:], 7),
        Instruction(.Equal, 25, float32_equal[:]), Instruction(.Extract, 26, top_float64[:]),
        Instruction(.Bitcast, 27, float64_bits[:]), Instruction(.Constant, 28, empty[:], 8),
        Instruction(.Equal, 29, float64_equal[:]), Instruction(.Convert, 30, pointer_answer[:]),
        Instruction(.Convert, 31, float32_answer[:]), Instruction(.Convert, 32, float64_answer[:]),
        Instruction(.Add, 33, first_sum[:]), Instruction(.Add, 34, second_sum[:]),
        Instruction(.Add, 35, third_sum[:]), Instruction(.Add, 36, fourth_sum[:]),
        Instruction(.Constant, 37, empty[:], 9), Instruction(.Convert, 38, unsigned_source[:]),
        Instruction(.Convert, 39, unsigned_float[:]), Instruction(.Equal, 40, unsigned_equal[:]),
        Instruction(.Convert, 41, unsigned_answer[:]), Instruction(.Add, 42, final_sum[:]),
        Instruction(.Return, -1, returned[:])]
    instructions[13].immediate = 1
    instructions[14].immediate = 1
    instructions[15].immediate = 1
    instructions[16].immediate = 2
    instructions[17].immediate = 0
    instructions[18].immediate = 0
    instructions[19].immediate = 2
    instructions[22].immediate = 3
    instructions[26].immediate = 4
    values: [43]s32 = .[
        7, 7, 7, 7, 7, 15, 16, 11, 12, 12, 13, 10, 14, 13, 12, 11, 7, 11, 7,
        10, 10, 1, 15, 7, 7, 1, 16, 9, 9, 1, 7, 7, 7, 7, 7, 7, 7,
