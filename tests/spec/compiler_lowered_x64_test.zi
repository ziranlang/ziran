FunctionOracle :: (test: *NativeTest) {
    if !native_execution || test.failed { return }
    source := #string END
#include <stdbool.h>
#include <stdint.h>
typedef struct { uint32_t value; uint32_t data[3]; } Row;
typedef Row (*Step)(uint32_t, Row);
typedef Row (*Wide)(uint32_t, float, Row, Step, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t);
typedef float (*FloatIdentity)(float);
typedef struct { Step callback; uint32_t marker; } Holder;
static Row recursive(uint32_t depth, Row state) {
    if (depth == 0) return state;
    state = recursive(depth - 1, state);
    state.value += 1;
    return state;
}
static Step select_step(bool choose) { return choose ? recursive : 0; }
static Row wide(uint32_t depth, float add, Row state, Step callback,
    uint32_t a, uint32_t b, uint32_t c, uint32_t d, uint32_t e) {
    state = callback(depth, state);
    state.value += (uint32_t)add + a + b + c + d + e;
    return state;
}
static float identity(float value) { return value; }
int main(void) {
    Row state = {5, {0, 1, 2}};
    Step selected = select_step(true);
    Holder callbacks[2] = {{selected, 1}, {0, 0}};
    Wide operation = wide;
    FloatIdentity same_float = identity;
    Row result = operation(2, 3.0f, state, callbacks[0].callback, 1, 1, 1, 1, 1);
    return (int)(result.value + (uint32_t)same_float(3.0f) +
        (recursive == recursive) + (recursive != 0) + (selected == recursive) +
        (callbacks[0].callback == recursive) + (callbacks[1].callback == 0));
}
END
    source_path := CheckPath(test.work, "function-oracle.c")
    executable_path := CheckPath(test.work, "function-oracle")
    if !NativeWrite(test, source_path, source) { return }
    compile: [5]string = .["/usr/bin/cc", "-std=c11", source_path, "-o", executable_path]
    unused NativeRun(test, compile[:])
    command: [1]string = .[executable_path]
    unused NativeRun(test, command[:], "", 23)
}

