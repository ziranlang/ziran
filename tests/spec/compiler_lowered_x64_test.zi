    recursive_body[5].immediate = 0
    recursive_values: [11]s32 = .[7, 12, 17, 7, 1, 7, 7, 12, 7, 7, 12]

    wide_parameter_values: [9]s32 = .[0, 1, 2, 3, 4, 5, 6, 7, 8]
    wide_callback_arguments: [4]s32 = .[3, 0, 2, 3]
    wide_result: [1]s32 = .[9]
    wide_float: [1]s32 = .[1]
    wide_sum0: [2]s32 = .[10, 11]
    wide_sum1: [2]s32 = .[12, 4]
    wide_sum2: [2]s32 = .[13, 5]
    wide_sum3: [2]s32 = .[14, 6]
    wide_sum4: [2]s32 = .[15, 7]
    wide_sum5: [2]s32 = .[16, 8]
    wide_insert: [2]s32 = .[9, 17]
    wide_return: [1]s32 = .[18]
    wide_body: [11]LirInstruction = .[
        Instruction(.CallIndirect, 9, wide_callback_arguments[:]), Instruction(.Extract, 10, wide_result[:]),
        Instruction(.Convert, 11, wide_float[:]), Instruction(.Add, 12, wide_sum0[:]),
        Instruction(.Add, 13, wide_sum1[:]), Instruction(.Add, 14, wide_sum2[:]),
        Instruction(.Add, 15, wide_sum3[:]), Instruction(.Add, 16, wide_sum4[:]),
        Instruction(.Add, 17, wide_sum5[:]), Instruction(.Insert, 18, wide_insert[:]),
        Instruction(.Return, -1, wide_return[:])]
    wide_body[0].effect = 1
    wide_body[1].immediate = 0
    wide_body[9].immediate = 0
    wide_values: [19]s32 = .[7, 15, 12, 17, 7, 7, 7, 7, 7, 12, 7, 7, 7, 7, 7, 7, 7, 7, 12]

    selector_parameter_values: [1]s32 = .[0]
    selector_return: [1]s32 = .[1]
    selector_body: [2]LirInstruction = .[
        Instruction(.FunctionAddress, 1, empty[:], 1), Instruction(.Return, -1, selector_return[:])]
    selector_values: [2]s32 = .[1, 17]
    float_parameter_values: [1]s32 = .[0]
    float_return: [1]s32 = .[0]
    float_body: [1]LirInstruction = .[Instruction(.Return, -1, float_return[:])]
    float_values: [1]s32 = .[15]

    entry_blocks: [1]LirBlock = .[.{.instructions = entry_instructions[:]}]
    recursive_blocks: [3]LirBlock = .[
        .{.instructions = recursive_base[:]}, .{.instructions = recursive_body[:]},
        .{.parameters = recursive_parameter_values[:], .instructions = recursive_dispatch[:]}]
    wide_blocks: [1]LirBlock = .[.{.parameters = wide_parameter_values[:], .instructions = wide_body[:]}]
    selector_blocks: [1]LirBlock = .[.{.parameters = selector_parameter_values[:], .instructions = selector_body[:]}]
    float_blocks: [1]LirBlock = .[.{.parameters = float_parameter_values[:], .instructions = float_body[:]}]
    functions: [5]LirFunction = .[
        .{.name = "function-entry", .module = 0, .result = 7,
            .values = entry_values[:], .blocks = entry_blocks[:], .origin = -1},
        .{.name = "recursive-callback", .module = 0, .parameters = native_recursive_signature_parameters[:], .result = 12,
            .values = recursive_values[:], .blocks = recursive_blocks[:], .entry = 2, .origin = -1},
        .{.name = "wide-callback", .module = 0, .parameters = native_wide_signature_parameters[:], .result = 12,
            .values = wide_values[:], .blocks = wide_blocks[:], .origin = -1},
        .{.name = "callback-selector", .module = 0, .parameters = native_selector_signature_parameters[:], .result = 17,
            .values = selector_values[:], .blocks = selector_blocks[:], .origin = -1},
        .{.name = "float-identity", .module = 0, .parameters = native_float_signature_parameters[:], .result = 15,
            .values = float_values[:], .blocks = float_blocks[:], .origin = -1}]
    modules: [1]string = .["native-test"]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .functions = functions[:], .entry = 0}
    FunctionOracle(test)
    Execute(test, program, 23, "typed function values, nested callbacks, wide mixed calls, and recursion")
}

FunctionFlow :: (test: *NativeTest) {
    types: [11]LirType
    Types(types[:10])
    no_parameters: [0]s32
    types[10] = .{.kind = .Function, .parameters = no_parameters[:], .result = 6}
    constants: [5]LirConstant = .[
        .{.type = 6, .bits = 0}, .{.type = 6, .bits = 1}, .{.type = 6, .bits = 2},
        .{.type = 6, .bits = 10}, .{.type = 6, .bits = 20}]
    empty: [0]s32
    initial_arguments: [3]s32 = .[0, 1, 2]
    initial_edge: [1]LirEdge = .[.{.block = 1, .arguments = initial_arguments[:]}]
    initial: [4]LirInstruction = .[
        Instruction(.FunctionAddress, 0, empty[:], 1), Instruction(.FunctionAddress, 1, empty[:], 2),
        Instruction(.Constant, 2, empty[:], 0),
        .{.op = .Jump, .result = -1, .edges = initial_edge[:], .symbol = -1, .origin = -1}]
    loop_parameters: [3]s32 = .[3, 4, 5]
    increment: [2]s32 = .[5, 6]
    compare: [2]s32 = .[7, 8]
    condition: [1]s32 = .[9]
    swapped_arguments: [3]s32 = .[4, 3, 7]
    final_arguments: [2]s32 = .[3, 4]
    loop_edges: [2]LirEdge = .[
        .{.block = 1, .arguments = swapped_arguments[:]},
        .{.block = 2, .arguments = final_arguments[:]}]
    loop: [5]LirInstruction = .[
        Instruction(.Constant, 6, empty[:], 1), Instruction(.Add, 7, increment[:]),
        Instruction(.Constant, 8, empty[:], 2), Instruction(.Less, 9, compare[:]),
        .{.op = .Branch, .result = -1, .operands = condition[:], .edges = loop_edges[:],
            .symbol = -1, .origin = -1}]
    final_parameters: [2]s32 = .[10, 11]
    indirect_arguments: [1]s32 = .[10]
    final_return: [1]s32 = .[12]
    final: [2]LirInstruction = .[
        Instruction(.CallIndirect, 12, indirect_arguments[:]), Instruction(.Return, -1, final_return[:])]
    final[0].effect = 1
    values: [13]s32 = .[10, 10, 6, 10, 10, 6, 6, 6, 6, 1, 10, 10, 6]
    first_return: [1]s32 = .[0]
    first_body: [2]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 3), Instruction(.Return, -1, first_return[:])]
    second_return: [1]s32 = .[0]
    second_body: [2]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 4), Instruction(.Return, -1, second_return[:])]
    target_values: [1]s32 = .[6]
    entry_blocks: [3]LirBlock = .[
        .{.instructions = initial[:]}, .{.parameters = loop_parameters[:], .instructions = loop[:]},
        .{.parameters = final_parameters[:], .instructions = final[:]}]
    first_blocks: [1]LirBlock = .[.{.instructions = first_body[:]}]
    second_blocks: [1]LirBlock = .[.{.instructions = second_body[:]}]
    functions: [3]LirFunction = .[
        .{.name = "function-flow", .module = 0, .result = 6,
            .values = values[:], .blocks = entry_blocks[:], .origin = -1},
        .{.name = "first-target", .module = 0, .result = 6,
            .values = target_values[:], .blocks = first_blocks[:], .origin = -1},
        .{.name = "second-target", .module = 0, .result = 6,
            .values = target_values[:], .blocks = second_blocks[:], .origin = -1}]
    modules: [1]string = .["native-test"]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .functions = functions[:], .entry = 0}
    Execute(test, program, 20, "function value parallel-copy cycle")
}

FunctionTraps :: (test: *NativeTest) {
    types: [11]LirType
    Types(types[:10])
    no_parameters: [0]s32
    types[10] = .{.kind = .Function, .parameters = no_parameters[:], .result = 6}
    empty: [0]s32
    null_arguments: [1]s32 = .[0]
    null_return: [1]s32 = .[1]
    null_instructions: [3]LirInstruction = .[
        Instruction(.Null, 0, empty[:]), Instruction(.CallIndirect, 1, null_arguments[:]),
        Instruction(.Return, -1, null_return[:])]
    null_instructions[1].effect = 1
    null_values: [2]s32 = .[10, 6]
    null_blocks: [1]LirBlock = .[.{.instructions = null_instructions[:]}]
    null_functions: [1]LirFunction = .[.{.name = "null-function", .module = 0, .result = 6,
        .values = null_values[:], .blocks = null_blocks[:], .origin = -1}]
    modules: [1]string = .["native-test"]
    null_program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .functions = null_functions[:], .entry = 0}
    Execute(test, null_program, 125, "null indirect function target traps")
    if !native_execution || test.failed { return }

    one_parameter: [1]s32 = .[6]
    invalid_types: [12]LirType
    Types(invalid_types[:10])
    invalid_types[10] = .{.kind = .Function, .parameters = no_parameters[:], .result = 6}
    invalid_types[11] = .{.kind = .Function, .parameters = one_parameter[:], .result = 6}
    constants: [1]LirConstant = .[.{.type = 6, .bits = 42}]
    address_arguments: [1]s32 = .[0]
    entry_return: [1]s32 = .[1]
    entry_instructions: [3]LirInstruction = .[
        Instruction(.FunctionAddress, 0, empty[:], 1), Instruction(.CallIndirect, 1, address_arguments[:]),
        Instruction(.Return, -1, entry_return[:])]
    entry_instructions[1].effect = 1
    entry_values: [2]s32 = .[10, 6]
    good_return: [1]s32 = .[0]
    good_instructions: [2]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 0), Instruction(.Return, -1, good_return[:])]
    good_values: [1]s32 = .[6]
    bad_parameter_values: [1]s32 = .[0]
    bad_return: [1]s32 = .[0]
    bad_instructions: [1]LirInstruction = .[Instruction(.Return, -1, bad_return[:])]
    bad_values: [1]s32 = .[6]
    entry_blocks: [1]LirBlock = .[.{.instructions = entry_instructions[:]}]
    good_blocks: [1]LirBlock = .[.{.instructions = good_instructions[:]}]
    bad_blocks: [1]LirBlock = .[.{.parameters = bad_parameter_values[:], .instructions = bad_instructions[:]}]
    functions: [3]LirFunction = .[
        .{.name = "invalid-entry", .module = 0, .result = 6,
            .values = entry_values[:], .blocks = entry_blocks[:], .origin = -1},
        .{.name = "valid-target", .module = 0, .result = 6,
            .values = good_values[:], .blocks = good_blocks[:], .origin = -1},
        .{.name = "wrong-signature", .module = 0, .parameters = one_parameter[:], .result = 6,
            .values = bad_values[:], .blocks = bad_blocks[:], .origin = -1}]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = invalid_types[:],
        .constants = constants[:], .functions = functions[:], .entry = 0}
    Execute(test, program, 42, "valid typed indirect function target")
    if test.failed { return }
    no_bytes: [0]u8
    measured := LirX64Elf(program, no_bytes[:])
    bytes: Vec(u8)
    defer VecFree(bytes)
    if !NativeAssert(test, measured.problem == .None && VecResize(bytes, measured.size),
        "allocate invalid indirect target fixture") { return }
    written := LirX64Elf(program, bytes[:])
    if !NativeAssert(test, written.problem == .None, "encode invalid indirect target fixture") { return }
    address_at: s64 = -1
    for index: cast(s64)120..bytes.count - 10 {
        if bytes[index] == 72 && bytes[index + 1] == 184 && Little(bytes[:], index + 2, 8) == 2 {
            if address_at != -1 {
                unused NativeAssert(test, false, "unique function address encoding")
                return
            }
            address_at = index
        }
    }
    if !NativeAssert(test, address_at >= 120, "locate function address encoding") { return }
    bytes[address_at + 2] = 3
    path := CheckPath(test.work, "invalid-function-elf")
    if !NativeWrite(test, path, TextFromBytes(bytes[:])) { return }
    chmod: [3]string = .["/usr/bin/chmod", "700", path]
    unused NativeRun(test, chmod[:])
    command: [1]string = .[path]
    unused NativeRun(test, command[:], "", 125)
}

GlobalOracle :: (test: *NativeTest) {
    if !native_execution || test.failed { return }
    source := #string END
#include <stdbool.h>
#include <stdint.h>
typedef struct { uint32_t value; uint32_t data[3]; } Row;
typedef struct { Row head; Row rows[2]; uint32_t *pointer; float f32; double f64; } Top;
int main(void) {
    bool flag = true;
    int8_t narrow = -2;
    uint16_t wide = 20;
    double real = 3.0;
    uint32_t counter = 9;
    Top state = {0};
    uint32_t *saved = 0;
    state.head.value = 7;
    state.head.data[0] = 1;
    state.head.data[1] = 2;
    state.head.data[2] = 3;
    uint32_t *first = &state.head.value;
    saved = first;
    uint32_t *second = &counter;
    uint32_t *temporary = first;
    first = second;
    second = temporary;
    return (int)((uint32_t)flag + (uint32_t)narrow + wide + (uint32_t)real +
        *first + *second + *saved + state.head.data[0] + state.head.data[1] +
        state.head.data[2] + state.head.value);
}
END
    source_path := CheckPath(test.work, "global-oracle.c")
    executable_path := CheckPath(test.work, "global-oracle")
    if !NativeWrite(test, source_path, source) { return }
    compile: [5]string = .["/usr/bin/cc", "-std=c11", source_path, "-o", executable_path]
    unused NativeRun(test, compile[:])
    command: [1]string = .[executable_path]
    unused NativeRun(test, command[:], "", 58)
}

