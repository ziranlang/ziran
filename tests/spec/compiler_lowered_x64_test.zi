}

ElementOracle :: (test: *NativeTest) {
    if !native_execution || test.failed { return }
    source := #string END
#include <stdbool.h>
#include <stdint.h>
typedef struct { uint32_t value; uint32_t data[3]; } Row;
typedef struct { Row head; Row rows[2]; uint32_t *pointer; float f32; double f64; } Top;
static Row *select_row(Row rows[2], int32_t index) { return &rows[index]; }
int main(void) {
    Row matrix[2] = {0};
    Top top = {0};
    int32_t row_index = 1;
    Row *row = select_row(matrix, row_index);
    row->value = 7;
    uint8_t column = 2;
    uint32_t *element = &row->data[column];
    *element = 9;
    uint32_t *same = &row->data[column];
    top.pointer = element;
    return (int)(*top.pointer + row->value + (element == same) +
        (top.pointer == element) + 1);
}
END
    source_path := CheckPath(test.work, "element-oracle.c")
    executable_path := CheckPath(test.work, "element-oracle")
    if !NativeWrite(test, source_path, source) { return }
    compile: [5]string = .["/usr/bin/cc", "-std=c11", source_path, "-o", executable_path]
    unused NativeRun(test, compile[:])
    command: [1]string = .[executable_path]
    unused NativeRun(test, command[:], "", 19)
}

