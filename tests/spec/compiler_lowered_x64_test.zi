Arithmetic :: (test: *NativeTest, types: []LirType) {
    for type: 2..9 {
        bits := cast(u64)types[type].bits
        mask := ifx bits == cast(u64)64 then cast(u64)0 - cast(u64)1 else (cast(u64)1 << bits) - cast(u64)1
        minimum := cast(u64)1 << (bits - cast(u64)1)
        Scalar(test, types, type, .Add, mask, 43, 42)
        Scalar(test, types, type, .Subtract, 0, 1, 255)
        Scalar(test, types, type, .Multiply, mask, 2, 254)
        Scalar(test, types, type, .Negate, 1, 0, 255)
        Scalar(test, types, type, .BitNot, 0, 0, 255)
        Scalar(test, types, type, .BitAnd, 126, 42, 42)
        Scalar(test, types, type, .BitOr, 32, 10, 42)
        Scalar(test, types, type, .BitXor, 63, 21, 42)
        Scalar(test, types, type, .ShiftLeft, 21, 1, 42)
        Scalar(test, types, type, .ShiftRight, mask, 1, ifx types[type].is_signed || bits > 8 then 255 else 127)
        Scalar(test, types, type, .ShiftLeft, 1, bits, 125)
        Scalar(test, types, type, .ShiftRight, 1, mask, 125)
        Scalar(test, types, type, .Divide, 126, 3, 42)
        Scalar(test, types, type, .Remainder, 127, 85, 42)
        Scalar(test, types, type, .Divide, 42, 0, 125)
        Scalar(test, types, type, .Remainder, 42, 0, 125)
        Scalar(test, types, type, .Equal, mask, mask, 1, 1)
        Scalar(test, types, type, .NotEqual, mask, 0, 1, 1)
        Scalar(test, types, type, .Less, mask, 0, ifx types[type].is_signed then 1 else 0, 1)
        Scalar(test, types, type, .Greater, mask, 0, ifx types[type].is_signed then 0 else 1, 1)
        Scalar(test, types, type, .LessEqual, 42, 42, 1, 1)
        Scalar(test, types, type, .GreaterEqual, 42, 42, 1, 1)
        if types[type].is_signed {
            Scalar(test, types, type, .Divide, minimum, mask, ifx bits == 8 then 128 else 0)
            Scalar(test, types, type, .Remainder, minimum, mask, 0)
            Scalar(test, types, type, .Divide, mask - cast(u64)125, 3, 214)
            Scalar(test, types, type, .Remainder, mask - cast(u64)126, 85, 214)
        } else {
            Scalar(test, types, type, .Divide, mask, 2, ifx bits == 8 then 127 else 255)
        }
        for destination: 2..9 {
            Scalar(test, types, type, .Convert, mask, 0, 255, destination)
        }
        Scalar(test, types, type, .Bitcast, mask, 0, 255, ifx type % 2 == 0 then type + 1 else type - 1)
    }
}

Flow :: (test: *NativeTest, types: []LirType, choose: bool) {
    empty: [0]s32
    constants: [5]LirConstant = .[.{.type = 6, .bits = 1}, .{.type = 6, .bits = 2},
        .{.type = 6, .bits = 0}, .{.type = 6, .bits = 1}, .{.type = 6, .bits = 2}]
    p0: [3]s32 = .[3, 4, 5]
    initial: [3]s32 = .[0, 1, 2]
    swap: [3]s32 = .[4, 3, 7]
    add: [2]s32 = .[5, 6]
    less: [2]s32 = .[7, 8]
    final_parameters: [1]s32 = .[10]
    final_argument: [1]s32 = .[3]
    final_return: [1]s32 = .[10]
    first_edge: [1]LirEdge = .[.{.block = 1, .arguments = initial[:]}]
    edges: [2]LirEdge = .[.{.block = 1, .arguments = swap[:]}, .{.block = 2, .arguments = final_argument[:]}]
    condition: [1]s32 = .[9]
    first: [4]LirInstruction = .[Instruction(.Constant, 0, empty[:], 0), Instruction(.Constant, 1, empty[:], 1),
        Instruction(.Constant, 2, empty[:], 2), .{.op = .Jump, .result = -1, .edges = first_edge[:], .symbol = -1, .origin = -1}]
    loop: [5]LirInstruction = .[Instruction(.Constant, 6, empty[:], 3), Instruction(.Add, 7, add[:]),
        Instruction(.Constant, 8, empty[:], 4), Instruction(.Less, 9, less[:]),
        .{.op = .Branch, .result = -1, .operands = condition[:], .edges = edges[:], .symbol = -1, .origin = -1}]
    last: [1]LirInstruction = .[Instruction(.Return, -1, final_return[:])]
    values: [11]s32 = .[6, 6, 6, 6, 6, 6, 6, 6, 6, 1, 6]
    if !choose { constants[4].bits = 1 }
    blocks: [3]LirBlock = .[.{.instructions = first[:]}, .{.parameters = p0[:], .instructions = loop[:]},
        .{.parameters = final_parameters[:], .instructions = last[:]}]
    functions: [1]LirFunction = .[.{.name = "cyclic-edge", .module = 0, .result = 6, .values = values[:], .blocks = blocks[:], .origin = -1}]
    modules: [1]string = .["native-test"]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types,
        .constants = constants[:], .functions = functions[:], .entry = 0}
    Execute(test, program, ifx choose then 2 else 1, "loop parallel copies and branch")
}

Calls :: (test: *NativeTest, types: []LirType) {
    empty: [0]s32
    constants: [6]LirConstant
    for index: 0..5 { constants[index] = .{.type = 6, .bits = cast(u64)(index + 1)} }
    operands: [6]s32 = .[0, 1, 2, 3, 4, 5]
    returned: [1]s32 = .[9]
    caller_values: [10]s32 = .[6, 6, 6, 6, 6, 6, 6, 6, 6, 6]
    caller: [11]LirInstruction
    for index: 0..5 { caller[index] = Instruction(.Constant, index, empty[:], index) }
    caller[6] = Instruction(.Call, 6, operands[:], 1); caller[6].effect = 1
    preserved: [2]s32 = .[6, 5]
    combined: [2]s32 = .[7, 8]
    caller[7] = Instruction(.Add, 7, preserved[:])
    caller[8] = Instruction(.Call, 8, operands[:], 1); caller[8].effect = 2
    caller[9] = Instruction(.Add, 9, combined[:])
    caller[10] = Instruction(.Return, -1, returned[:])
    parameters: [6]s32 = .[6, 6, 6, 6, 6, 6]
    callee_values: [11]s32 = .[6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6]
    adds: [10]s32 = .[0, 1, 6, 2, 7, 3, 8, 4, 9, 5]
    callee: [6]LirInstruction
    for index: 0..4 { callee[index] = Instruction(.Add, index + 6, adds[index * 2:index * 2 + 2]) }
    ret: [1]s32 = .[10]
    callee[5] = Instruction(.Return, -1, ret[:])
    caller_blocks: [1]LirBlock = .[.{.instructions = caller[:]}]
    callee_blocks: [1]LirBlock = .[.{.parameters = operands[:], .instructions = callee[:]}]
    functions: [2]LirFunction = .[
        .{.name = "caller", .module = 0, .result = 6, .values = caller_values[:], .blocks = caller_blocks[:], .origin = -1},
        .{.name = "callee", .module = 0, .parameters = parameters[:], .result = 6,
            .values = callee_values[:], .blocks = callee_blocks[:], .origin = -1}]
    modules: [1]string = .["native-test"]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types,
        .constants = constants[:], .functions = functions[:], .entry = 0}
    Execute(test, program, 48, "six register calls preserve live values")
    bytes: [512]u8
    for index: 0..511 { bytes[index] = 165 }
    functions[0].parameters = parameters[:1]
    caller_blocks[0].parameters = operands[:1]
    rejected := LirX64Elf(program, bytes[:])
    unused NativeAssert(test, rejected.problem == .Calling, "entry arguments rejected")
    for byte: bytes { unused NativeAssert(test, byte == 165, "rejection leaves output unchanged") }
}

Recursive :: (test: *NativeTest, types: []LirType) {
    empty: [0]s32
    parameters: [1]s32 = .[6]
    parameter_values: [1]s32 = .[0]
    values: [7]s32 = .[6, 6, 1, 6, 6, 6, 6]
    constants: [3]LirConstant = .[.{.type = 6, .bits = 0}, .{.type = 6, .bits = 1}, .{.type = 6, .bits = 10}]
    equal: [2]s32 = .[0, 1]
    condition: [1]s32 = .[2]
    edges: [2]LirEdge = .[.{.block = 0}, .{.block = 1}]
    first: [3]LirInstruction = .[Instruction(.Constant, 1, empty[:], 0), Instruction(.Equal, 2, equal[:]),
        .{.op = .Branch, .result = -1, .symbol = -1, .origin = -1, .operands = condition[:], .edges = edges[:]}]
    base: [1]LirInstruction = .[Instruction(.Return, -1, parameter_values[:])]
    subtract: [2]s32 = .[0, 3]
    argument: [1]s32 = .[4]
    add: [2]s32 = .[0, 5]
    returned: [1]s32 = .[6]
    recursive: [5]LirInstruction = .[Instruction(.Constant, 3, empty[:], 1), Instruction(.Subtract, 4, subtract[:]),
        Instruction(.Call, 5, argument[:], 0), Instruction(.Add, 6, add[:]), Instruction(.Return, -1, returned[:])]
    recursive[2].effect = 1
    blocks: [3]LirBlock = .[.{.instructions = base[:]}, .{.instructions = recursive[:]},
        .{.parameters = parameter_values[:], .instructions = first[:]}]
    caller_values: [2]s32 = .[6, 6]
    caller_return: [1]s32 = .[1]
    caller: [3]LirInstruction = .[Instruction(.Constant, 0, empty[:], 2),
        Instruction(.Call, 1, parameter_values[:], 0), Instruction(.Return, -1, caller_return[:])]
    caller[1].effect = 1
    caller_blocks: [1]LirBlock = .[.{.instructions = caller[:]}]
    functions: [2]LirFunction = .[
        .{.name = "recursive-sum", .module = 0, .parameters = parameters[:], .result = 6,
            .values = values[:], .blocks = blocks[:], .entry = 2, .origin = -1},
        .{.name = "entry", .module = 0, .result = 6, .values = caller_values[:], .blocks = caller_blocks[:], .origin = -1}]
    modules: [1]string = .["native-test"]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types,
        .constants = constants[:], .functions = functions[:], .entry = 1}
    Execute(test, program, 55, "recursive backward calls and nonzero entries")
}

Rejections :: (test: *NativeTest) {
    for mode: 0..8 {
        types: [11]LirType
        Types(types[:10])
        types[10] = .{.kind = .Integer, .bits = 64}
        constants: [1]LirConstant = .[.{.type = 6, .bits = 42}]
        empty: [0]s32
        value: [1]s32 = .[0]
        values: [1]s32 = .[6]
        instructions: [2]LirInstruction = .[Instruction(.Constant, 0, empty[:], 0), Instruction(.Return, -1, value[:])]
        blocks: [1]LirBlock = .[.{.instructions = instructions[:]}]
        functions: [1]LirFunction = .[.{.name = "reject", .module = 0, .result = 6,
            .values = values[:], .blocks = blocks[:], .origin = -1}]
        problem: LirProblem = .Unsupported
        if mode == 0 { types[10] = .{.kind = .Capability} }
        if mode == 1 { types[10] = .{.kind = .Float, .bits = 16}; problem = .Type }
        if mode == 2 { types[10] = .{.kind = .Record} }
        if mode == 3 { types[10].native_width = true }
        if mode == 4 { functions[0].calling = .C }
        if mode == 5 { functions[0].variadic = true }
        if mode == 6 { instructions[1].operands = empty[:]; problem = .Operand }
        if mode == 7 { instructions[0].symbol = 99; problem = .Constant }
        if mode == 8 { instructions[0].origin = 99; problem = .Origin }
        modules: [1]string = .["native-test"]
        program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
            .constants = constants[:], .functions = functions[:], .entry = 0}
        bytes: [512]u8
        for index: 0..511 { bytes[index] = 165 }
        result := LirX64Elf(program, bytes[:])
        unused NativeAssert(test, result.problem == problem && result.size == 0, CheckConcat("reject mode ", CheckNumber(mode)))
        result = LirX64Encode(program, bytes[:])
        unused NativeAssert(test, result.problem == problem && result.size == 0, "raw rejection agrees")
        for byte: bytes { unused NativeAssert(test, byte == 165, "rejected program leaves output unchanged") }
    }
}

Markers :: (test: *NativeTest, types: []LirType) {
    for mode: 0..2 {
        empty: [0]s32
        returned: [1]s32 = .[0]
        values: [1]s32 = .[6]
        constants: [1]LirConstant = .[.{.type = 6, .bits = 42}]
        instructions: [3]LirInstruction = .[Instruction(.Fuel, -1, empty[:]),
            Instruction(.Constant, 0, empty[:], 0), Instruction(.Return, -1, returned[:])]
        instructions[0].immediate = 1; instructions[0].effect = 1
        if mode > 0 { instructions[2] = Instruction(ifx mode == 1 then LirOp.Trap else LirOp.Unreachable, -1, empty[:]) }
        if mode == 1 { instructions[2].effect = 2 }
        blocks: [1]LirBlock = .[.{.instructions = instructions[:]}]
        functions: [1]LirFunction = .[.{.name = "markers", .module = 0, .result = 6,
            .values = values[:], .blocks = blocks[:], .origin = -1}]
        modules: [1]string = .["native-test"]
        program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types,
            .constants = constants[:], .functions = functions[:], .entry = 0}
        Execute(test, program, ifx mode == 0 then 42 else 125, "unbudgeted AOT fuel and traps")
        if mode == 0 {
            expected: [70]u8 = .[
                72, 131, 228, 240, 232, 26, 0, 0, 0, 72, 137, 199, 184, 231, 0, 0, 0, 15, 5, 15, 11,
                191, 125, 0, 0, 0, 184, 231, 0, 0, 0, 15, 5, 15, 11,
                85, 72, 137, 229, 72, 129, 236, 16, 0, 0, 0,
                184, 42, 0, 0, 0, 72, 99, 192, 72, 137, 133, 248, 255, 255, 255,
                72, 139, 133, 248, 255, 255, 255, 201, 195]
            bytes: [70]u8
            result := LirX64Encode(program, bytes[:])
            unused NativeAssert(test, result.problem == .None && result.size == 70, "known encoding size")
            for index: 0..69 { unused NativeAssert(test, bytes[index] == expected[index], "known instruction bytes") }
            tool := OpenRead("/usr/bin/objdump")
            if tool.valid { CloseFile(tool) }
            if tool.valid && native_execution {
                command: [3]string = .["/usr/bin/objdump", "-d", CheckPath(test.work, "direct-elf")]
                disassembled := NativeRun(test, command[:])
                unused NativeAssert(test, TextContains(disassembled.output, "Disassembly of section .text") &&
                    TextContains(disassembled.output, "<_start>:") && TextContains(disassembled.output, "<_zir_trap>:") &&
                    TextContains(disassembled.output, CheckConcat(program.modules[0], ":")) &&
                    TextContains(disassembled.output, "syscall") && TextContains(disassembled.output, "ret"), "inspect symbolized final ELF instructions")
            }
        }
    }
}

AllocationMetadata :: (test: *NativeTest, program: LirProgram, word: s64,
    value: u64, expected: s32, label: string) {
    if test.failed { return }
    no_bytes: [0]u8
    measured := LirX64Elf(program, no_bytes[:])
    image := LirX64ElfLayout(program)
    bytes: Vec(u8)
    defer VecFree(bytes)
    if !NativeAssert(test, measured.problem == .None && image.problem == .None &&
        image.data_size >= 8 && VecResize(bytes, measured.size), "allocate counter fixture") { return }
    written := LirX64Elf(program, bytes[:])
    if !NativeAssert(test, written.problem == .None && written.size == measured.size,
        "encode allocate counter fixture") { return }
    counter_at := image.data_offset
    for global: program.globals { counter_at += PackedSize(program, global.type) }
    for function: program.functions { for block: function.blocks { for instruction: block.instructions {
        if instruction.op == .Allocate { counter_at += 8 }
    } } }
    counter_at += word * 8
    if !NativeAssert(test, counter_at >= image.data_offset && counter_at + 8 <=
        image.data_offset + image.data_size, "allocation metadata word extent") { return }
    for index: cast(s64)0..7 {
        bytes[counter_at + index] = cast(u8)(value >> cast(u64)(index * 8))
    }
    path := CheckPath(test.work, label)
    if !NativeWrite(test, path, TextFromBytes(bytes[:])) { return }
    chmod: [3]string = .["/usr/bin/chmod", "700", path]
    unused NativeRun(test, chmod[:])
    command: [1]string = .[path]
    if native_execution { unused NativeRun(test, command[:], "", expected) }
}

Allocations :: (test: *NativeTest) {
    types: [3]LirType = .[.{.kind = .Void}, .{.kind = .Integer, .bits = 32, .is_signed = true},
        .{.kind = .Pointer, .element = 1}]
    constants: [2]LirConstant = .[.{.type = 1, .bits = 9}, .{.type = 1, .bits = 7}]
    empty: [0]s32
    initialized: [1]s32 = .[1]
    pointer: [1]s32 = .[0]
    returned: [1]s32 = .[2]
    values: [3]s32 = .[2, 1, 1]
    instructions: [4]LirInstruction = .[
        Instruction(.Constant, 1, empty[:], 0), Instruction(.Allocate, 0, initialized[:]),
        Instruction(.Load, 2, pointer[:]), Instruction(.Return, -1, returned[:])]
    instructions[1].effect = 1
    instructions[2].effect = 2
    blocks: [1]LirBlock = .[.{.instructions = instructions[:]}]
    functions: [1]LirFunction = .[.{.name = "allocate", .module = 0, .result = 1,
        .values = values[:], .blocks = blocks[:], .origin = -1}]
    modules: [1]string = .["native-test"]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .functions = functions[:], .entry = 0}
    Execute(test, program, 9, "descriptors-only seven-section ELF allocation")
    if test.failed { return }
    no_bytes: [0]u8
    image := LirX64ElfLayout(program)
    measured := LirX64Elf(program, no_bytes[:])
    bytes: Vec(u8)
    defer VecFree(bytes)
    if !NativeAssert(test, image.problem == .None && image.text_offset == 176 &&
        image.data_size == 24 && measured.problem == .None && VecResize(bytes, measured.size),
        "descriptor image layout query") { return }
    written := LirX64Elf(program, bytes[:])
    if !NativeAssert(test, written.problem == .None &&
        Little(bytes[:], 60, 2) == 7 && Little(bytes[:], 62, 2) == 4,
        "descriptors-only programs use seven ELF sections") { return }
    escape_values: [1]s32 = .[2]
    escape_returned: [1]s32 = .[0]
    escape_instructions: [2]LirInstruction = .[
        Instruction(.Allocate, 0, empty[:]), Instruction(.Return, -1, escape_returned[:])]
    escape_instructions[0].effect = 1
    escape_blocks: [1]LirBlock = .[.{.instructions = escape_instructions[:]}]
    caller_values: [3]s32 = .[1, 2, 1]
    store: [2]s32 = .[1, 0]
    caller_load: [1]s32 = .[1]
    caller_instructions: [5]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 0), Instruction(.Call, 1, empty[:], 1),
        Instruction(.Store, -1, store[:]), Instruction(.Load, 2, caller_load[:]),
        Instruction(.Return, -1, returned[:])]
    caller_instructions[1].effect = 1
    caller_instructions[2].effect = 2
    caller_instructions[3].effect = 3
    caller_blocks: [1]LirBlock = .[.{.instructions = caller_instructions[:]}]
    stale_functions: [2]LirFunction = .[
        .{.name = "stale-entry", .module = 0, .result = 1, .values = caller_values[:],
            .blocks = caller_blocks[:], .origin = -1},
        .{.name = "escape", .module = 0, .result = 2, .values = escape_values[:],
            .blocks = escape_blocks[:], .origin = -1}]
    stale := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .functions = stale_functions[:], .entry = 0}
    Execute(test, stale, 125, "stale allocation pointer traps")

    scalar_types: [8]LirType = .[.{.kind = .Void},
        .{.kind = .Integer, .bits = 32, .is_signed = true},
        .{.kind = .Pointer, .element = 1}, .{.kind = .Bool, .bits = 1},
        .{.kind = .Pointer, .element = 3}, .{.kind = .Float, .bits = 32},
        .{.kind = .Pointer, .element = 5}, .{.kind = .Pointer, .element = 2}]
    scalar_constants: [3]LirConstant = .[.{.type = 1, .bits = 39},
        .{.type = 3, .bits = 1}, .{.type = 5, .bits = 0x3f800000}]
    int_initial: [1]s32 = .[0]; int_pointer: [1]s32 = .[1]
    bool_initial: [1]s32 = .[3]; bool_pointer: [1]s32 = .[4]; bool_value: [1]s32 = .[5]
    float_initial: [1]s32 = .[7]; float_pointer: [1]s32 = .[8]; float_value: [1]s32 = .[9]
    pointer_initial: [1]s32 = .[11]; pointer_pointer: [1]s32 = .[12]
    pointer_equal: [2]s32 = .[11, 13]; pointer_bool: [1]s32 = .[14]
    zero_pointer: [1]s32 = .[16]
    sum_a: [2]s32 = .[2, 6]; sum_b: [2]s32 = .[18, 10]
    sum_c: [2]s32 = .[19, 15]; sum_d: [2]s32 = .[20, 17]
    scalar_returned: [1]s32 = .[21]
    scalar_values: [22]s32 = .[1, 2, 1, 3, 4, 3, 1, 5, 6, 5, 1,
        2, 7, 2, 3, 1, 2, 1, 1, 1, 1, 1]
    scalar_instructions: [23]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 0), Instruction(.Allocate, 1, int_initial[:]),
        Instruction(.Load, 2, int_pointer[:]), Instruction(.Constant, 3, empty[:], 1),
        Instruction(.Allocate, 4, bool_initial[:]), Instruction(.Load, 5, bool_pointer[:]),
        Instruction(.Convert, 6, bool_value[:]), Instruction(.Constant, 7, empty[:], 2),
        Instruction(.Allocate, 8, float_initial[:]), Instruction(.Load, 9, float_pointer[:]),
        Instruction(.Convert, 10, float_value[:]), Instruction(.Null, 11, empty[:]),
        Instruction(.Allocate, 12, pointer_initial[:]), Instruction(.Load, 13, pointer_pointer[:]),
        Instruction(.Equal, 14, pointer_equal[:]), Instruction(.Convert, 15, pointer_bool[:]),
        Instruction(.Allocate, 16, empty[:]), Instruction(.Load, 17, zero_pointer[:]),
        Instruction(.Add, 18, sum_a[:]), Instruction(.Add, 19, sum_b[:]),
        Instruction(.Add, 20, sum_c[:]), Instruction(.Add, 21, sum_d[:]),
        Instruction(.Return, -1, scalar_returned[:])]
    scalar_instructions[1].effect = 1; scalar_instructions[2].effect = 2
    scalar_instructions[4].effect = 3; scalar_instructions[5].effect = 4
    scalar_instructions[8].effect = 5; scalar_instructions[9].effect = 6
    scalar_instructions[12].effect = 7; scalar_instructions[13].effect = 8
    scalar_instructions[16].effect = 9; scalar_instructions[17].effect = 10
    scalar_blocks: [1]LirBlock = .[.{.instructions = scalar_instructions[:]}]
    scalar_functions: [1]LirFunction = .[.{.name = "allocation-scalars", .module = 0, .result = 1,
        .values = scalar_values[:], .blocks = scalar_blocks[:], .origin = -1}]
    scalars := LirProgram.{.version = LirVersion, .modules = modules[:], .types = scalar_types[:],
        .constants = scalar_constants[:], .functions = scalar_functions[:], .entry = 0}
    Execute(test, scalars, 42, "zero and initialized scalar allocations")

    zero_entry_returned: [1]s32 = .[1]
    zero_entry_instructions: [3]LirInstruction = .[
        Instruction(.Call, 0, empty[:], 1), Instruction(.Call, 1, empty[:], 2),
        Instruction(.Return, -1, zero_entry_returned[:])]
    zero_entry_instructions[0].effect = 1; zero_entry_instructions[1].effect = 2
    zero_entry_values: [2]s32 = .[1, 1]
    zero_entry_blocks: [1]LirBlock = .[.{.instructions = zero_entry_instructions[:]}]
    poison_initial: [1]s32 = .[0]
    poison_returned: [1]s32 = .[0]
    poison_instructions: [3]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 1), Instruction(.Allocate, 1, poison_initial[:]),
        Instruction(.Return, -1, poison_returned[:])]
    poison_instructions[1].effect = 1
    poison_values: [2]s32 = .[1, 2]
    poison_blocks: [1]LirBlock = .[.{.instructions = poison_instructions[:]}]
    uninitialized_pointer: [1]s32 = .[0]
    uninitialized_returned: [1]s32 = .[1]
    uninitialized_instructions: [3]LirInstruction = .[
        Instruction(.Allocate, 0, empty[:]), Instruction(.Load, 1, uninitialized_pointer[:]),
        Instruction(.Return, -1, uninitialized_returned[:])]
    uninitialized_instructions[0].effect = 1; uninitialized_instructions[1].effect = 2
    uninitialized_values: [2]s32 = .[2, 1]
    uninitialized_blocks: [1]LirBlock = .[.{.instructions = uninitialized_instructions[:]}]
    zero_functions: [3]LirFunction = .[
        .{.name = "zero-entry", .module = 0, .result = 1, .values = zero_entry_values[:],
            .blocks = zero_entry_blocks[:], .origin = -1},
        .{.name = "poison-stack", .module = 0, .result = 1, .values = poison_values[:],
            .blocks = poison_blocks[:], .origin = -1},
        .{.name = "uninitialized-zero", .module = 0, .result = 1, .values = uninitialized_values[:],
            .blocks = uninitialized_blocks[:], .origin = -1}]
    zeroed := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .functions = zero_functions[:], .entry = 0}
    Execute(test, zeroed, 0, "uninitialized allocation clears reused stack storage")

    AllocationMetadata(test, program, 0, 1099511627775, 125, "allocation-counter-max")
    AllocationMetadata(test, program, 0, 1099511627774, 125, "allocation-counter-max-minus-one")
    AllocationMetadata(test, program, 0, 1099511627773, 9, "allocation-counter-last-valid")
    AllocationMetadata(test, program, 1, 268435416, 9, "allocation-region-last-valid")
    AllocationMetadata(test, program, 1, 268435417, 125, "allocation-region-record-overflow")
    AllocationMetadata(test, program, 1, 268435456, 125, "allocation-region-full")
    AllocationMetadata(test, program, 1, 18446744073709551615, 125, "allocation-region-bump-overflow")

    no_parameters: [0]s32
    function_types: [4]LirType = .[.{.kind = .Void},
        .{.kind = .Integer, .bits = 32, .is_signed = true},
        .{.kind = .Function, .parameters = no_parameters[:], .result = 1},
        .{.kind = .Pointer, .element = 2}]
    function_constants: [1]LirConstant = .[.{.type = 1, .bits = 0}]
    function_values: [2]s32 = .[3, 1]
    function_returned: [1]s32 = .[1]
    function_instructions: [3]LirInstruction = .[
        Instruction(.Allocate, 0, empty[:]), Instruction(.Constant, 1, empty[:], 0),
        Instruction(.Return, -1, function_returned[:])]
    function_instructions[0].effect = 1
    function_blocks: [1]LirBlock = .[.{.instructions = function_instructions[:]}]
    function_functions: [1]LirFunction = .[.{.name = "function-allocation-rejected", .module = 0,
        .result = 1, .values = function_values[:], .blocks = function_blocks[:], .origin = -1}]
    function_program := LirProgram.{.version = LirVersion, .modules = modules[:],
        .types = function_types[:], .constants = function_constants[:],
        .functions = function_functions[:], .entry = 0}
    supported := LirX64Elf(function_program, no_bytes[:])
    unused NativeAssert(test, supported.problem == .None && supported.size > 0,
        "procedure-value allocation has checked native storage")
}

AllocationLoop :: (test: *NativeTest) {
    types: [4]LirType = .[.{.kind = .Void},
        .{.kind = .Integer, .bits = 32, .is_signed = true},
        .{.kind = .Bool, .bits = 1}, .{.kind = .Pointer, .element = 1}]
    constants: [4]LirConstant = .[.{.type = 1, .bits = 0}, .{.type = 1, .bits = 7},
        .{.type = 1, .bits = 1}, .{.type = 1, .bits = 11}]
    empty: [0]s32
    entry_arguments: [2]s32 = .[0, 1]
    entry_edges: [1]LirEdge = .[.{.block = 1, .arguments = entry_arguments[:]}]
    entry: [3]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 0), Instruction(.Null, 1, empty[:]),
        Instruction(.Jump, -1, empty[:])]
    entry[2].edges = entry_edges[:]
    loop_parameters: [2]s32 = .[2, 3]
    comparison: [2]s32 = .[2, 0]
    condition: [1]s32 = .[5]
    branch_edges: [2]LirEdge = .[.{.block = 2}, .{.block = 3}]
    loop: [3]LirInstruction = .[
        Instruction(.Allocate, 4, empty[:]), Instruction(.Equal, 5, comparison[:]),
        Instruction(.Branch, -1, condition[:])]
    loop[0].effect = 1; loop[2].edges = branch_edges[:]
    first_store: [2]s32 = .[4, 6]
    next_arguments: [2]s32 = .[7, 4]
    next_edges: [1]LirEdge = .[.{.block = 1, .arguments = next_arguments[:]}]
    first: [4]LirInstruction = .[
        Instruction(.Constant, 6, empty[:], 1), Instruction(.Store, -1, first_store[:]),
        Instruction(.Constant, 7, empty[:], 2), Instruction(.Jump, -1, empty[:])]
    first[1].effect = 1; first[3].edges = next_edges[:]
    second_store: [2]s32 = .[4, 8]
    first_pointer: [1]s32 = .[3]; second_pointer: [1]s32 = .[4]
    sum: [2]s32 = .[9, 10]; returned: [1]s32 = .[11]
    second: [6]LirInstruction = .[
        Instruction(.Constant, 8, empty[:], 3), Instruction(.Store, -1, second_store[:]),
        Instruction(.Load, 9, first_pointer[:]), Instruction(.Load, 10, second_pointer[:]),
        Instruction(.Add, 11, sum[:]), Instruction(.Return, -1, returned[:])]
    second[1].effect = 1; second[2].effect = 2; second[3].effect = 3
    values: [12]s32 = .[1, 3, 1, 3, 3, 2, 1, 1, 1, 1, 1, 1]
    blocks: [4]LirBlock = .[.{.instructions = entry[:]},
        .{.parameters = loop_parameters[:], .instructions = loop[:]},
        .{.instructions = first[:]}, .{.instructions = second[:]}]
    modules: [1]string = .["native-test"]
    functions: [1]LirFunction = .[.{.name = "allocation-loop", .module = 0, .result = 1,
        .values = values[:], .blocks = blocks[:], .origin = -1}]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .functions = functions[:], .entry = 0}
    Execute(test, program, 18, "same allocation site stays distinct across loop iterations")
}

AllocationRecursive :: (test: *NativeTest) {
    types: [4]LirType = .[.{.kind = .Void},
        .{.kind = .Integer, .bits = 32, .is_signed = true},
        .{.kind = .Bool, .bits = 1}, .{.kind = .Pointer, .element = 1}]
    constants: [2]LirConstant = .[.{.type = 1, .bits = 0}, .{.type = 1, .bits = 1}]
    empty: [0]s32
    entry_call: [1]s32 = .[0]; entry_return: [1]s32 = .[1]
    entry_instructions: [3]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 1), Instruction(.Call, 1, entry_call[:], 1),
        Instruction(.Return, -1, entry_return[:])]
    entry_instructions[1].effect = 1
    entry_values: [2]s32 = .[1, 1]
    entry_blocks: [1]LirBlock = .[.{.instructions = entry_instructions[:]}]
    parameters: [1]s32 = .[1]; parameter_values: [1]s32 = .[0]
    initialized: [1]s32 = .[0]
    comparison: [2]s32 = .[0, 2]; condition: [1]s32 = .[3]
    recursive_edges: [2]LirEdge = .[.{.block = 1}, .{.block = 2}]
    recursive_entry: [4]LirInstruction = .[
        Instruction(.Allocate, 1, initialized[:]), Instruction(.Constant, 2, empty[:], 0),
        Instruction(.Equal, 3, comparison[:]), Instruction(.Branch, -1, condition[:])]
    recursive_entry[0].effect = 1; recursive_entry[3].edges = recursive_edges[:]
    own_pointer: [1]s32 = .[1]; base_return: [1]s32 = .[4]
    base: [2]LirInstruction = .[
        Instruction(.Load, 4, own_pointer[:]), Instruction(.Return, -1, base_return[:])]
    base[0].effect = 1
    inner_argument: [1]s32 = .[2]; outer_return: [1]s32 = .[6]
    recurse: [3]LirInstruction = .[
        Instruction(.Call, 5, inner_argument[:], 1), Instruction(.Load, 6, own_pointer[:]),
        Instruction(.Return, -1, outer_return[:])]
    recurse[0].effect = 1; recurse[1].effect = 2
    recursive_values: [7]s32 = .[1, 3, 1, 2, 1, 1, 1]
    recursive_blocks: [3]LirBlock = .[
        .{.parameters = parameter_values[:], .instructions = recursive_entry[:]},
        .{.instructions = base[:]}, .{.instructions = recurse[:]}]
    modules: [1]string = .["native-test"]
    functions: [2]LirFunction = .[
        .{.name = "allocation-recursive-entry", .module = 0, .result = 1,
            .values = entry_values[:], .blocks = entry_blocks[:], .origin = -1},
        .{.name = "allocation-recursive-site", .module = 0, .parameters = parameters[:],
            .result = 1, .values = recursive_values[:], .blocks = recursive_blocks[:], .origin = -1}]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .functions = functions[:], .entry = 0}
    Execute(test, program, 1, "recursive allocation retains the outer live address")
}

AllocationAlias :: (test: *NativeTest) {
    types: [3]LirType = .[.{.kind = .Void},
        .{.kind = .Integer, .bits = 32, .is_signed = true},
        .{.kind = .Pointer, .element = 1}]
    constants: [1]LirConstant = .[.{.type = 1, .bits = 42}]
    empty: [0]s32
    initialized: [1]s32 = .[0]; arguments: [1]s32 = .[1]
    pointer: [1]s32 = .[1]; sum: [2]s32 = .[2, 3]; returned: [1]s32 = .[4]
    caller: [6]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 0), Instruction(.Allocate, 1, initialized[:]),
        Instruction(.Call, 2, arguments[:], 1), Instruction(.Load, 3, pointer[:]),
        Instruction(.Add, 4, sum[:]), Instruction(.Return, -1, returned[:])]
    caller[1].effect = 1; caller[2].effect = 2; caller[3].effect = 3
    caller_values: [5]s32 = .[1, 2, 1, 1, 1]
    caller_blocks: [1]LirBlock = .[.{.instructions = caller[:]}]
    parameters: [1]s32 = .[2]; parameter_values: [1]s32 = .[0]
    callee_pointer: [1]s32 = .[0]; callee_returned: [1]s32 = .[1]
    callee: [2]LirInstruction = .[
        Instruction(.Load, 1, callee_pointer[:]), Instruction(.Return, -1, callee_returned[:])]
    callee[0].effect = 1
    callee_values: [2]s32 = .[2, 1]
    callee_blocks: [1]LirBlock = .[.{.parameters = parameter_values[:], .instructions = callee[:]}]
    modules: [1]string = .["native-test"]
    functions: [2]LirFunction = .[
        .{.name = "allocation-alias-entry", .module = 0, .result = 1,
            .values = caller_values[:], .blocks = caller_blocks[:], .origin = -1},
        .{.name = "allocation-alias-read", .module = 0, .parameters = parameters[:],
            .result = 1, .values = callee_values[:], .blocks = callee_blocks[:], .origin = -1}]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .functions = functions[:], .entry = 0}
    Execute(test, program, 84, "active allocation aliases across calls")
}

AllocationReusedFrame :: (test: *NativeTest) {
    types: [3]LirType = .[.{.kind = .Void},
        .{.kind = .Integer, .bits = 32, .is_signed = true},
        .{.kind = .Pointer, .element = 1}]
    constants: [1]LirConstant = .[.{.type = 1, .bits = 9}]
    empty: [0]s32
    argument: [1]s32 = .[0]; stale_pointer: [1]s32 = .[1]; returned: [1]s32 = .[3]
    caller: [5]LirInstruction = .[
        Instruction(.Constant, 0, empty[:], 0), Instruction(.Call, 1, argument[:], 1),
        Instruction(.Call, 2, argument[:], 1), Instruction(.Load, 3, stale_pointer[:]),
        Instruction(.Return, -1, returned[:])]
    caller[1].effect = 1; caller[2].effect = 2; caller[3].effect = 3
    caller_values: [4]s32 = .[1, 2, 2, 1]
    caller_blocks: [1]LirBlock = .[.{.instructions = caller[:]}]
    parameters: [1]s32 = .[1]; parameter_values: [1]s32 = .[0]
    initialized: [1]s32 = .[0]; pointer_return: [1]s32 = .[1]
    callee: [2]LirInstruction = .[
        Instruction(.Allocate, 1, initialized[:]), Instruction(.Return, -1, pointer_return[:])]
    callee[0].effect = 1
    callee_values: [2]s32 = .[1, 2]
    callee_blocks: [1]LirBlock = .[.{.parameters = parameter_values[:], .instructions = callee[:]}]
    modules: [1]string = .["native-test"]
    functions: [2]LirFunction = .[
        .{.name = "allocation-reused-frame-entry", .module = 0, .result = 1,
            .values = caller_values[:], .blocks = caller_blocks[:], .origin = -1},
        .{.name = "allocation-reused-frame", .module = 0, .parameters = parameters[:],
            .result = 2, .values = callee_values[:], .blocks = callee_blocks[:], .origin = -1}]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .functions = functions[:], .entry = 0}
    Execute(test, program, 125, "stale allocation traps after frame-address reuse")
}

main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "lowered-x64")
    defer NativeCleanup(*test)
    host_command := string.["uname", "-s", "-m"]
    host := NativeRun(*test, host_command[:])
    native_execution = TextContains(host.output, "Linux") && TextContains(host.output, "x86_64")
    if !native_execution { print("direct ELF encoding/maps only: execution requires Linux x86-64\n") }
    types: [10]LirType
    Types(types[:])
    Arithmetic(*test, types[:])
    Scalar(*test, types[:], 1, .Equal, 0, 1, 0, 1)
    Scalar(*test, types[:], 1, .NotEqual, 0, 1, 1, 1)
    NestedAggregates(*test)
    DynamicArrayValues(*test)
    AggregateCalls(*test)
    AggregateRecursive(*test)
    AggregateFlow(*test)
    FunctionValues(*test)
    FunctionFlow(*test)
    FunctionTraps(*test)
    GlobalOracle(*test)
    GlobalValues(*test)
    GlobalPointerTraps(*test)
    ReadOnlyData(*test)
    Allocations(*test)
    AllocationLoop(*test)
    AllocationRecursive(*test)
    AllocationAlias(*test)
    AllocationReusedFrame(*test)
    GlobalLimits(*test)
    ElementOracle(*test)
    ElementValues(*test)
    ElementTraps(*test)
    ElementLimits(*test)
    Flow(*test, types[:], true)
    Flow(*test, types[:], false)
    Calls(*test, types[:])
    Recursive(*test, types[:])
    Rejections(*test)
    Markers(*test, types[:])
    if test.failed { return 1 }
    print("direct lowered x86-64 ELF local tests passed\n")
    return 0
}
