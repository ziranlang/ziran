        .{.parameters = loop_parameters[:], .instructions = loop_instructions[:]},
        .{.parameters = final_parameters[:], .instructions = final_instructions[:]}]
    identity_parameters: [1]s32 = .[10]
    identity_parameter_values: [1]s32 = .[0]
    identity_return: [1]s32 = .[0]
    identity_instructions: [1]LirInstruction = .[Instruction(.Return, -1, identity_return[:])]
    identity_blocks: [1]LirBlock = .[
        .{.parameters = identity_parameter_values[:], .instructions = identity_instructions[:]}]
    mutator_parameters: [1]s32 = .[24]
    mutator_parameter_values: [1]s32 = .[0]
    top_operand: [1]s32 = .[0]
    row_operand: [1]s32 = .[5]
    value_store: [2]s32 = .[6, 1]
    array_operands: [3]s32 = .[2, 3, 4]
    array_store: [2]s32 = .[7, 8]
    mutator_return: [1]s32 = .[6]
    mutator_instructions: [11]LirInstruction = .[
        Instruction(.Constant, 1, empty[:], 7), Instruction(.Constant, 2, empty[:], 8),
        Instruction(.Constant, 3, empty[:], 9), Instruction(.Constant, 4, empty[:], 10),
        Instruction(.FieldAddress, 5, top_operand[:]), Instruction(.FieldAddress, 6, row_operand[:]),
        Instruction(.Store, -1, value_store[:]), Instruction(.FieldAddress, 7, row_operand[:]),
        Instruction(.Aggregate, 8, array_operands[:]), Instruction(.Store, -1, array_store[:]),
        Instruction(.Return, -1, mutator_return[:])]
    mutator_instructions[4].immediate = 0
    mutator_instructions[5].immediate = 0
    mutator_instructions[6].effect = 1
    mutator_instructions[7].immediate = 1
    mutator_instructions[9].effect = 2
    mutator_values: [9]s32 = .[24, 7, 7, 7, 7, 21, 10, 22, 11]
    mutator_blocks: [1]LirBlock = .[
        .{.parameters = mutator_parameter_values[:], .instructions = mutator_instructions[:]}]
    functions: [3]LirFunction = .[
        .{.name = "global-entry", .module = 0, .result = 7,
            .values = entry_values[:], .blocks = entry_blocks[:], .origin = -1},
        .{.name = "pointer-identity", .module = 0, .parameters = identity_parameters[:], .result = 10,
            .values = identity_parameters[:], .blocks = identity_blocks[:], .origin = -1},
        .{.name = "mutate-global", .module = 0, .parameters = mutator_parameters[:], .result = 10,
            .values = mutator_values[:], .blocks = mutator_blocks[:], .origin = -1}]
    modules: [1]string = .["native-test"]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .globals = globals[:], .functions = functions[:], .entry = 0}
    Execute(test, program, 58, "packed static globals and checked pointer flow")
    if test.failed { return }
    no_bytes: [0]u8
    image := LirX64ElfLayout(program)
    measured := LirX64Elf(program, no_bytes[:])
    bytes: Vec(u8)
    defer VecFree(bytes)
    if !NativeAssert(test, image.problem == .None && image.text_offset == 176 &&
        image.data_offset % 4096 == 0 && image.data_size == 92 &&
        measured.problem == .None && VecResize(bytes, measured.size), "global image layout query") { return }
    written := LirX64Elf(program, bytes[:])
    if !NativeAssert(test, written.problem == .None &&
        Little(bytes[:], image.data_offset, 1) == 1 &&
        Little(bytes[:], image.data_offset + 1, 1) == 0xfe &&
        Little(bytes[:], image.data_offset + 2, 2) == 20 &&
        Little(bytes[:], image.data_offset + 4, 8) == 0x4008000000000000 &&
        Little(bytes[:], image.data_offset + 12, 4) == 9,
        "global scalar initializers and packed offsets") { return }
    for index: image.data_offset + 16..image.data_offset + image.data_size - 1 {
        unused NativeAssert(test, bytes[index] == 0, "default aggregate and pointer globals are zero")
    }
}

GlobalPointerTraps :: (test: *NativeTest) {
    types: [12]LirType
    Types(types[:10])
    types[10] = .{.kind = .Pointer, .element = 7}
    types[11] = .{.kind = .Pointer, .element = 1}
    constants: [2]LirConstant = .[.{.type = 7, .bits = 9}, .{.type = 1, .bits = 1}]
    globals: [2]LirGlobal = .[
        .{.module = 0, .name = "number", .type = 7, .constant = 0, .writable = true},
        .{.module = 0, .name = "flag", .type = 1, .constant = 1, .writable = true}]
    empty: [0]s32
    pointer: [1]s32 = .[0]
    returned: [1]s32 = .[1]
    instructions: [3]LirInstruction = .[
        Instruction(.GlobalAddress, 0, empty[:], 0), Instruction(.Load, 1, pointer[:]),
        Instruction(.Return, -1, returned[:])]
    instructions[1].effect = 1
    values: [2]s32 = .[10, 7]
    blocks: [1]LirBlock = .[.{.instructions = instructions[:]}]
    functions: [1]LirFunction = .[.{.name = "pointer-traps", .module = 0, .result = 7,
        .values = values[:], .blocks = blocks[:], .origin = -1}]
    modules: [1]string = .["native-test"]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .globals = globals[:], .functions = functions[:], .entry = 0}
    Execute(test, program, 9, "valid checked global pointer")
    null_instructions: [3]LirInstruction = .[
        Instruction(.Null, 0, empty[:]), Instruction(.Load, 1, pointer[:]),
        Instruction(.Return, -1, returned[:])]
    null_instructions[1].effect = 1
    null_blocks: [1]LirBlock = .[.{.instructions = null_instructions[:]}]
    null_functions: [1]LirFunction = .[.{.name = "null-pointer", .module = 0, .result = 7,
        .values = values[:], .blocks = null_blocks[:], .origin = -1}]
    null_program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .functions = null_functions[:], .entry = 0}
    Execute(test, null_program, 125, "null global pointer traps")
    if !native_execution || test.failed { return }
    no_bytes: [0]u8
    measured := LirX64Elf(program, no_bytes[:])
    image := LirX64ElfLayout(program)
    bytes: Vec(u8)
    defer VecFree(bytes)
    if !NativeAssert(test, measured.problem == .None && image.problem == .None &&
        VecResize(bytes, measured.size), "allocate hostile pointer fixture") { return }
    written := LirX64Elf(program, bytes[:])
    if !NativeAssert(test, written.problem == .None, "encode hostile pointer fixture") { return }
    address_at: s64 = -1
    for index: image.text_offset..image.text_offset + image.text_size - 10 {
        if bytes[index] == 72 && bytes[index + 1] == 184 && Little(bytes[:], index + 2, 8) == 1 {
            if address_at != -1 {
                unused NativeAssert(test, false, "unique global pointer token")
                return
            }
            address_at = index
        }
    }
    if !NativeAssert(test, address_at >= image.text_offset, "locate global pointer token") { return }
    hostile: [4]u64 = .[0, 2, 3, 0x100000003]
    for mode: 0..3 {
        written = LirX64Elf(program, bytes[:])
        if !NativeAssert(test, written.problem == .None, "reset hostile pointer fixture") { return }
        for byte: 0..7 {
            bytes[address_at + 2 + byte] = cast(u8)(hostile[mode] >> cast(u64)(byte * 8))
        }
        path := CheckPath(test.work, CheckConcat("hostile-pointer-", CheckNumber(mode)))
        if !NativeWrite(test, path, TextFromBytes(bytes[:])) { return }
        chmod: [3]string = .["/usr/bin/chmod", "700", path]
        unused NativeRun(test, chmod[:])
        command: [1]string = .[path]
        unused NativeRun(test, command[:], "", 125)
    }
}

ReadOnlyData :: (test: *NativeTest) {
    types: [6]LirType = .[
        .{.kind = .Void}, .{.kind = .Integer, .bits = 8},
        .{.kind = .Integer, .bits = 8, .is_signed = false},
        .{.kind = .Array, .element = 2, .count = 2},
        .{.kind = .Pointer, .element = 3}, .{.kind = .Pointer, .element = 2}]
    bytes: [2]u8 = .[42, 43]
    constants: [3]LirConstant = .[
        .{.type = 3, .bytes = bytes[:]}, .{.type = 1, .bits = 0}, .{.type = 2, .bits = 7}]
    globals: [2]LirGlobal = .[
        .{.module = 0, .name = "literal", .type = 3, .constant = 0},
        .{.module = 0, .name = "mutable", .type = 1, .constant = 1, .writable = true}]
    empty: [0]s32
    indexed: [2]s32 = .[0, 1]
    pointer: [1]s32 = .[2]
    returned: [1]s32 = .[3]
    instructions: [5]LirInstruction = .[
        Instruction(.GlobalAddress, 0, empty[:], 0), Instruction(.Constant, 1, empty[:], 1),
        Instruction(.ElementAddress, 2, indexed[:]), Instruction(.Load, 3, pointer[:]),
        Instruction(.Return, -1, returned[:])]
    instructions[3].effect = 1
    values: [5]s32 = .[4, 1, 5, 2, 2]
    blocks: [1]LirBlock = .[.{.instructions = instructions[:]}]
    functions: [1]LirFunction = .[.{.name = "readonly-data", .module = 0, .result = 2,
        .values = values[:4], .blocks = blocks[:], .origin = -1}]
    modules: [1]string = .["native-test"]
    program := LirProgram.{.version = LirVersion, .modules = modules[:], .types = types[:],
        .constants = constants[:], .globals = globals[:], .functions = functions[:], .entry = 0}
    Execute(test, program, 42, "read-only bytes execute from a separate load")
    if test.failed { return }
    image := LirX64ElfLayout(program)
    no_bytes: [0]u8
    measured := LirX64Elf(program, no_bytes[:])
    encoded: Vec(u8)
    defer VecFree(encoded)
    if !NativeAssert(test, image.problem == .None && image.readonly_size == 2 &&
        image.data_size == 1 && image.readonly_offset == image.text_offset + image.text_size &&
        image.readonly_address % 4096 == cast(u64)(image.readonly_offset % 4096) && image.data_offset % 4096 == 0 &&
        measured.problem == .None && VecResize(encoded, measured.size),
        "split read-only image layout") { return }
    written := LirX64Elf(program, encoded[:])
    if !NativeAssert(test, written.problem == .None && Little(encoded[:], 56, 2) == 3 &&
        Little(encoded[:], 124, 4) == 4 && Little(encoded[:], 180, 4) == 6,
        "read-only bytes use PF_R while mutable data uses PF_R|PF_W") { return }

    stored: [2]s32 = .[2, 4]
    store_instructions: [7]LirInstruction
    for index: 0..3 { store_instructions[index] = instructions[index] }
    store_instructions[4] = Instruction(.Constant, 4, empty[:], 2)
    store_instructions[5] = Instruction(.Store, -1, stored[:]); store_instructions[5].effect = 2
    store_instructions[6] = instructions[4]
    store_blocks: [1]LirBlock = .[.{.instructions = store_instructions[:]}]
    store_functions: [1]LirFunction = .[.{.name = "readonly-store", .module = 0, .result = 2,
        .values = values[:], .blocks = store_blocks[:], .origin = -1}]
    store_program := program
    store_program.functions = store_functions[:]
    Execute(test, store_program, 125, "attempted read-only mutation traps")
}

GlobalLimits :: (test: *NativeTest) {
