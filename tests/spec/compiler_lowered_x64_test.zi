        Instruction(.Constant, 22, empty[:], 6),
        .{.op = .Branch, .result = -1, .operands = loop_condition[:],
            .edges = loop_edges[:], .symbol = -1, .origin = -1}]
    final_parameters: [2]s32 = .[23, 24]
    first_pointer: [1]s32 = .[23]
    second_pointer: [1]s32 = .[24]
    loaded_pointer: [1]s32 = .[17]
    top_pointer: [1]s32 = .[5]
    top_value: [1]s32 = .[28]
    row_value: [1]s32 = .[29]
    array_value: [1]s32 = .[30]
    sums: [20]s32 = .[
        11, 12, 35, 13, 36, 14, 37, 25, 38, 26,
        39, 27, 40, 31, 41, 32, 42, 33, 43, 34]
    returned: [1]s32 = .[44]
    final_instructions: [21]LirInstruction = .[
        Instruction(.Load, 25, first_pointer[:]), Instruction(.Load, 26, second_pointer[:]),
        Instruction(.Load, 27, loaded_pointer[:]), Instruction(.Load, 28, top_pointer[:]),
        Instruction(.Extract, 29, top_value[:]), Instruction(.Extract, 30, row_value[:]),
        Instruction(.Extract, 31, array_value[:]), Instruction(.Extract, 32, array_value[:]),
        Instruction(.Extract, 33, array_value[:]), Instruction(.Extract, 34, row_value[:]),
        Instruction(.Add, 35, sums[0:2]), Instruction(.Add, 36, sums[2:4]),
        Instruction(.Add, 37, sums[4:6]), Instruction(.Add, 38, sums[6:8]),
        Instruction(.Add, 39, sums[8:10]), Instruction(.Add, 40, sums[10:12]),
