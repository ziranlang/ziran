#import "constant_time"

#program_export
SelfTest :: () -> s32 {
    first: [8]u8 = .[1, 2, 3, 4, 5, 6, 7, 8]
    second: [8]u8 = .[1, 2, 3, 4, 5, 6, 7, 8]
    if !ConstantTimeEqual(first[:], second[:]) { return 1 }

    changed: [8]u8 = .[1, 2, 3, 4, 5, 6, 7, 9]
    if ConstantTimeEqual(first[:], changed[:]) { return 2 }

    changed[7] = cast(u8)8
    changed[0] = cast(u8)2
    if ConstantTimeEqual(first[:], changed[:]) { return 3 }

    short: [7]u8 = .[1, 2, 3, 4, 5, 6, 7]
    if ConstantTimeEqual(first[:], short[:]) { return 4 }

    empty: [0]u8
    if !ConstantTimeEqual(empty[:], empty[:]) { return 5 }

    return 42
}
