#import "file_plan9"
#import "c_string"

#scope_file
Path :: (root: string, name: string, output: []u8) -> string {
    used: s32 = 0
    index: s32 = 0
    while cast(s64)index < root.count { output[used] = root[index]; used += 1; index += 1 }
    output[used] = 47
    used += 1
    index = 0
    while cast(s64)index < name.count { output[used] = name[index]; used += 1; index += 1 }
    return TextView(output[0:used])
}

Run :: (root: string) -> s32 {
    cwd: [4096]u8
    tiny: [1]u8
    current := CurrentDirectory(cwd[:])
    if current.count == 0 || current[0] != cast(u8)47 || !DirectoryExists(current) ||
        CurrentDirectory(tiny[:]) != "" { return 24 }
    // Names equal to their ABI symbol use libc's existing declarations too.
    missing: [1024]u8
    missing_path := Path(root, "missing", missing[:])
    error: [256]u8
    if PathInfo(missing_path).valid || LastError(error[:]) == "" || LastError(tiny[:]) != "" { return 32 }
    if !CopyCString(missing_path, missing[:]) ||
        open(cast(*s8)(*missing[0]), 0) >= 0 ||
        dirstat(cast(*s8)(*missing[0])) != null { return 12 }
    directory_bytes: [1024]u8
    first_bytes: [1024]u8
    second_bytes: [1024]u8
    other_bytes: [1024]u8
    directory := Path(root, "file-test", directory_bytes[:])
    first := Path(directory, "first", first_bytes[:])
    second := Path(directory, "second", second_bytes[:])
    other := Path(root, "other", other_bytes[:])
    if !CreatePrivateDirectory(directory) || !CreatePrivateDirectory(directory) ||
        !PathExists(directory) || !DirectoryExists(directory) { return 1 }
    if CreatePrivateDirectoryExclusive(directory) ||
        !CreatePrivateDirectoryExclusive(other) || !DirectoryExists(other) ||
        CreatePrivateDirectoryExclusive(other) || !RemoveFile(other) { return 23 }
    opened_directory := CreatePrivateDirectoryHandle(other)
    if !opened_directory.valid || CreatePrivateDirectoryHandle(other).valid ||
        !SetFileAttributes(opened_directory, cast(u32)320, cast(u32)1700000000) ||
        (HandleInfo(opened_directory).mode & cast(u32)0x80000000) == 0 ||
        (HandleInfo(opened_directory).mode & cast(u32)511) != cast(u32)320 ||
        !SetFileAttributes(opened_directory, cast(u32)448, cast(u32)1700000000) ||
        !CloseFile(opened_directory) || !RemoveFile(other) { return 30 }
    file := OpenPrivateReplace(first)
    if !file.valid { return 2 }
    bytes: [4]u8 = .[65, 0, 66, 67]
    if WriteAt(file, bytes[:], 0) != 4 || WriteAt(file, bytes[0:0], 4) != 0 ||
        FileSize(file) != 4 || !CloseFile(file) { return 3 }
    if !PathExists(first) || DirectoryExists(first) || CreateDirectory(first) { return 4 }
    original := PathInfo(first)
    if !original.valid || original.length != 4 || (original.mode & cast(u32)0x80000000) != 0 ||
        !PathInfo(directory).valid || (PathInfo(directory).mode & cast(u32)0x80000000) == 0 ||
        PathInfo("bad\u0000path").valid || PathInfo(missing_path).valid { return 25 }
    file = OpenRead(first)
    snapshot := HandleInfo(file)
    if !snapshot.valid || snapshot.identity != original.identity || snapshot.device != original.device ||
        snapshot.type != original.type || snapshot.length != 4 || !CloseFile(file) { return 26 }
    file = OpenRead(first)
    sequential: [2]u8
    if FileSize(file) != 4 || Read(file, sequential[:]) != 2 || sequential[0] != cast(u8)65 || sequential[1] != cast(u8)0 ||
        FileSize(file) != 4 || Read(file, sequential[:]) != 2 || sequential[0] != cast(u8)66 || sequential[1] != cast(u8)67 ||
        !CloseFile(file) { return 33 }
    file = OpenUpdate(first)
    if !file.valid || !SetFileAttributes(file, cast(u32)416, cast(u32)1700000000) ||
        SetFileAttributes(file, cast(u32)512, cast(u32)1700000000) || !CloseFile(file) { return 27 }
    attributes := PathInfo(first)
    if (attributes.mode & cast(u32)511) != cast(u32)416 || attributes.modified != cast(u32)1700000000 { return 28 }
    if RenameNoReplace(first, other) || !PathExists(first) || PathExists(other) { return 5 }
    if !RenameNoReplace(first, second) || PathExists(first) || !PathExists(second) { return 6 }
    file = OpenReplace(first)
    if !file.valid || !CloseFile(file) || RenameNoReplace(second, first) { return 7 }
    file = OpenUpdate(second)
    if !file.valid || FileSize(file) != 4 || WriteAt(file, bytes[2:3], 0) != 1 ||
        !CloseFile(file) { return 8 }
    file = OpenRead(second)
    received: [8]u8
    if !file.valid || ReadAt(file, received[:], 0) != 4 || received[0] != 66 ||
        received[1] != 0 || received[2] != 66 || received[3] != 67 ||
        ReadAt(file, received[:], 4) != 0 || ReadAt(file, received[:], -1) != -1 ||
        !CloseFile(file) { return 9 }
    invalid: FileHandle
    if HandleInfo(invalid).valid || SetFileAttributes(invalid, cast(u32)384, cast(u32)1700000000) { return 29 }
    if FileSize(invalid) != -1 || ReadAt(invalid, received[:], 0) != -1 ||
        WriteAt(invalid, bytes[:], 0) != -1 || CloseFile(invalid) { return 10 }
    cursor := OpenDirectory(directory)
    malformed: DirectoryCursor = .{count = 1, valid = true}
    if NextDirectoryEntry(*malformed).valid || !malformed.failed || !CloseDirectory(*malformed) { return 31 }
    found: s32 = 0
    listed: FileInfo
    if !cursor.valid { return 13 }
    while true {
        entry := NextDirectoryEntry(*cursor)
        if !entry.valid { break }
        name := TextView(entry.name[0:entry.name_count])
        if !entry.info.valid { return 34 }
        if name == "first" { listed = entry.info }
        if name == "first" { found |= 1 }
        if name == "second" { found |= 2 }
    }
    if found != 3 || cursor.failed || !CloseDirectory(*cursor) || cursor.valid ||
        CloseDirectory(*cursor) || OpenDirectory(first).valid { return 14 }
    file_info := PathInfo(first)
    if !listed.valid || listed.identity != file_info.identity || listed.device != file_info.device ||
        listed.type != file_info.type || listed.mode != file_info.mode || listed.length != file_info.length { return 35 }
    file = OpenWrite(second)
    if !file.valid || Write(file, bytes[0:1]) != 1 || !CloseFile(file) { return 15 }
    file = OpenRead(second)
    if !file.valid || Read(file, received[:]) != 4 || received[0] != 65 ||
        Read(file, received[:]) != 0 || !CloseFile(file) { return 16 }
    // An exclusive create must leave an existing file's contents intact.
    file = CreatePrivateExclusive(second, false)
    if file.valid { CloseFile(file); return 17 }
    file = OpenRead(second)
    if !file.valid || Read(file, received[:]) != 4 || received[0] != 65 ||
        !CloseFile(file) { return 18 }
    // A close/exit lease excludes competing clients and can be acquired again.
    file = CreatePrivateExclusive(other, true)
    if !file.valid || !PathExists(other) { return 19 }
    competing := CreatePrivateExclusive(other, true)
    if competing.valid { CloseFile(competing); CloseFile(file); return 20 }
    if !CloseFile(file) || PathExists(other) { return 21 }
    file = CreatePrivateExclusive(other, false)
    if !file.valid || !CloseFile(file) || !PathExists(other) ||
        !RemoveFile(other) || CreatePrivateExclusive("bad\u0000path", true).valid { return 22 }
    if OpenRead("bad\u0000path").valid || RenameNoReplace(second, directory) ||
        !RemoveFile(first) || !RemoveFile(second) || !RemoveFile(directory) { return 11 }
    return 0
}

libc :: #system_library "libc";
open :: (path: *s8, flags: s32) -> s32 #foreign libc "open";
dirstat :: (path: *s8) -> *void #foreign libc "dirstat";
Getenv :: (name: *s8) -> *s8 #foreign libc "getenv";
Free :: (memory: *void) #foreign libc "free";
Descriptor :: struct { data: *u8; length: usize; }

#scope_export
#program_export
main :: () -> s32 {
    name: [32]u8
    CopyCString("ZIRAN_TEST_ROOT", name[:])
    value := Getenv(cast(*s8)(*name[0]))
    if value == null { print("file-plan9-test-failed: missing test root\n"); return 99 }
    length: s32 = 0
    while value[length] != 0 { length += 1 }
    view: string = ""
    descriptor := cast(*Descriptor)(*view)
    descriptor.data = cast(*u8)value
    descriptor.length = cast(usize)length
    result := Run(view)
    Free(cast(*void)value)
    if result != 0 { print("file-plan9-test-failed: %\n", result) }
    else { print("file-plan9-test-ok\n") }
    return result
}
