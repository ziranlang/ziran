#import "std/vec"

MarkEnds :: (view: []u8, marker: u8) {
    view[0] = marker
    view[view.count - 1] = marker
}

HasEnds :: (view: []u8, marker: u8) -> bool {
    return view[0] == marker && view[view.count - 1] == marker
}

// Returning the small allocation keeps it above the scratch allocation
// when scratch is dropped. The next round still has its predecessor live.
Sample :: (marker: u8) -> Vec(u8) {
    scratch: Vec(u8)
    if !VecResize(scratch, 524288) { return .{} }
    MarkEnds(VecSlice(scratch, 0, 524288), marker)
    survivor: Vec(u8)
    if !VecResize(survivor, 4) { return .{} }
    MarkEnds(VecSlice(survivor, 0, 4), marker)
    if !VecResize(scratch, 1048576) || !HasEnds(VecSlice(scratch, 0, 524288), marker) { return .{} }
    grown := VecSlice(scratch, 524288, 1048576)
    if grown[0] != 0 || grown[grown.count - 1] != 0 { return .{} }
    return survivor
}

#program_export
main :: () -> s32 {
    held: Vec(u8)
    for round: 1..64 {
        next := Sample(cast(u8)round)
        if next.count != 4 || !HasEnds(VecSlice(next, 0, 4), cast(u8)round) { return 1 }
        if round > 1 && (held.count != 4 || !HasEnds(VecSlice(held, 0, 4), cast(u8)(round - 1))) { return 2 }
        VecFree(held)
        held = next
    }
    return 42
}

#program_export
Stale :: () -> s32 {
    earlier := New(s32)
    survivor := New(s32)
    <<survivor = 21
    stale := earlier
    free(earlier)
    replacement := New(s32)
    <<replacement = 21
    return <<survivor + <<stale
}

Pixel :: struct { value: u8 }
pixels: [350000]Pixel;

#program_export
CrossBranchAddresses :: () -> s32 {
    kept := *pixels[0]
    alias := *pixels[0]
    total: s32
    for index: 0..349999 {
        pixel := *pixels[index]
        if (index & 1) == 0 { pixel.value = 1 }
        else { pixel.value = 2 }
        total += cast(s32)pixel.value
    }
    if total != 525000 || kept != alias || kept.value != 1 { return 1 }
    kept.value = 42
    return cast(s32)alias.value
}

Pair :: struct { first: Pixel; second: Pixel }

#program_export
StaleDerivedAddress :: () -> s32 {
    pair := New(Pair)
    older := *pair.first
    free(pair)
    replacement := New(Pair)
    replacement.first.value = 42
    return cast(s32)older.value
}

WriteModelByte :: (data: *s8, index: s64, value: s8) { data[index] = value }

ReadModelByte :: (data: *s8, index: s64) -> s8 {
    byte := *data[index]
    return <<byte
}

ModelEntry :: struct { name: [16]s8; id: s32 }

#program_export
TypedModelMemory :: () -> s32 {
    model := New(ModelEntry)
    defer free(model)
    WriteModelByte(*model.name[1], 4, 97)
    if ReadModelByte(*model.name[1], 4) != 97 || model.name[5] != 97 { return 1 }
    entries: Vec(ModelEntry)
    if !VecResize(entries, 4) { return 2 }
    view := VecSlice(entries, 0, 4)
    WriteModelByte(*view[2].name[1], 4, 42)
    if view[2].name[5] != 42 || view[2].name[4] != 0 || view[1].name[5] != 0 { return 3 }
    return cast(s32)ReadModelByte(*view[2].name[1], 4)
}

#program_export
NegativeModelIndex :: () -> s32 {
    buffer: [4]s8
    return cast(s32)ReadModelByte(*buffer[1], -1)
}

#program_export
PastModelExtent :: () -> s32 {
    buffer: [4]s8
    return cast(s32)ReadModelByte(*buffer[1], 3)
}
