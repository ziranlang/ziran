// One fixture graph for the JSON backend matrix. The individual modules keep
// their focused assertions; no backend rebuild is needed per assertion group.
Scan :: #import "json_scan_test"
Reuse :: #import "json_array_reuse_test"
Document :: #import "json_document_cases"
Python :: #import "json_python_cases"
Lifetime :: #import "json_document_lifetime_test"
Secure :: #import "json_document_secure_test"

#program_export
JsonPortable :: () -> s32 {
    if Scan.SelfTest() != 42 { return 1 }
    if Reuse.SelfTest() != 42 { return 2 }
    if Lifetime.Answer() != 42 { return 4 }
    if Python.PythonCases() != 0 { return 8 }
    return 42
}
#program_export
JsonNative :: () -> s32 {
    if Scan.NativeMain() != 0 { return 1 }
    if Reuse.NativeMain() != 0 { return 2 }
    if Document.DocumentCases() != 0 { return 4 }
    if Python.PythonCases() != 0 { return 5 }
    return 0
}
#program_export
JsonPython :: () -> s32 {
    // The sanitizer entry exercises tree writes as well as Python reads.
    if Document.DocumentCases() != 0 { return 1 }
    return Python.PythonCases()
}
#program_export
JsonOwnership :: () -> s32 {
    if Lifetime.Answer() != 42 || Lifetime.Memory() != 42 || Secure.Secure() != 42 || Secure.Faults() != 42 { return 1 }
    return 0
}
