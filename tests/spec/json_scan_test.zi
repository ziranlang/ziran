#import "json_scan"

#program_export
SelfTest :: () -> s32 {
    body: string = "{\"skip\":[true,{\"quoted\":\"a\\\"b\"}],\"value\":1.25e2}"
    if ValueEnd(body, 0, 0) != cast(s32)body.count { return 1 }
    value_at: s32 = FieldAt(body, 0, "value")
    value: JsonNumber = ReadNumber(body, value_at)
    if !value.valid || value.value != 125.0 { return 2 }
    skip_at: s32 = FieldAt(body, 0, "skip")
    if ArrayCount(body, skip_at) != 2 || ArrayCount("[]", 0) != 0 ||
       ArrayCount("[1,]", 0) != -1 || ArrayCount("[1 2]", 0) != -1 {
        return 8
    }
    item_at: s32 = ElementAt(body, skip_at, 1)
    quote_at: s32 = FieldAt(body, item_at, "quoted")
    quoted: JsonSpan = ReadString(body, quote_at)
    if !quoted.valid || quoted.end - quoted.start != 4 { return 3 }
    if ValueEnd("{\"a\":[1,]}", 0, 0) >= 0 { return 4 }
    if ReadString("\"\\q\"", 0).valid { return 5 }
    if ReadNumber("01", 0).valid { return 6 }
    tiny: JsonNumber = ReadNumber("1.25e-1", 0)
    if !tiny.valid || tiny.value != 0.125 { return 7 }
    // a " b newline e-acute (C3 A9) grinning face (F0 9F 98 80).
    decoded: [16]u8
    escaped: string = "\"a\\\"b\\n\\u00e9\\ud83d\\ude00\""
    if ReadStringText(escaped, 0, decoded[:]) != 10 { return 9 }
    if decoded[0] != cast(u8)97 || decoded[1] != cast(u8)34 || decoded[2] != cast(u8)98 ||
       decoded[3] != cast(u8)10 || decoded[4] != cast(u8)195 || decoded[5] != cast(u8)169 ||
       decoded[6] != cast(u8)240 || decoded[7] != cast(u8)159 || decoded[8] != cast(u8)152 ||
       decoded[9] != cast(u8)128 || decoded[10] != cast(u8)0 {
        return 10
    }
    // A lone surrogate becomes U+FFFD (EF BF BD).
    if ReadStringText("\"\\ud800x\"", 0, decoded[:]) != 4 || decoded[0] != cast(u8)239 ||
       decoded[3] != cast(u8)120 {
        return 11
    }
    tight: [4]u8
    if ReadStringText("\"abcd\"", 0, tight[:]) != -1 || tight[0] != cast(u8)0 { return 12 }
    if ReadStringText("\"abc\"", 0, tight[:]) != 3 { return 13 }
    if ReadStringText("12", 0, decoded[:]) != -1 { return 14 }
    positions: [4]s32
    array: string = " [1, {\"nested\":[true,\"café\"]}, \"escaped\\\"quote\", null] "
    if ArrayPositions(array, 0, positions[:]) != 4 { return 15 }
    for i: 0..cast(s32)3 {
        if positions[i] != ElementAt(array, 0, cast(s32)i) { return 16 }
    }
    short: [1]s32
    if ArrayPositions(array, 0, short[:]) != 4 || short[0] != positions[0] { return 17 }
    empty: []s32
    if ArrayPositions(array, 0, empty) != 4 { return 18 }
    if ArrayPositions("[]", 0, positions[:]) != 0 ||
       ArrayPositions("[1,]", 0, positions[:]) != -1 ||
       ArrayPositions("[1 2]", 0, positions[:]) != -1 ||
       ArrayPositions("[1", 0, positions[:]) != -1 ||
       ArrayPositions("{}", 0, positions[:]) != -1 ||
       ArrayPositions(array, -1, positions[:]) != -1 { return 19 }
    // Positions refer to the caller's current contents, including nested arrays.
    nested: s32 = FieldAt(array, positions[1], "nested")
    if ArrayPositions(array, nested, positions[:]) != 2 ||
       !ReadString(array, positions[1]).valid { return 20 }
    names: [4]string = .{"value", "skip", "missing", "value"}
    members: [5]s32
    members[4] = 777
    if !ObjectPositions(body, 0, names[:], members[:]) ||
        members[0] != value_at || members[1] != skip_at || members[2] != -1 ||
        members[3] != value_at || members[4] != 777 { return 21 }
    if !ObjectPositions("{\"value\":1,\"value\":2}", 0, names[:], members[:]) ||
        ReadNumber("{\"value\":1,\"value\":2}", members[0]).value != 1.0 { return 22 }
    if ObjectPositions(body, 0, names[:], short[:]) ||
        ObjectPositions("{\"value\":1,}", 0, names[:], members[:]) ||
        ObjectPositions("{\"value\":1 2}", 0, names[:], members[:]) ||
        ObjectPositions("{\"value\":", 0, names[:], members[:]) ||
        ObjectPositions("{\"skip\":[1,]}", 0, names[:], members[:]) ||
        ObjectPositions("[]", 0, names[:], members[:]) ||
        ObjectPositions(body, -1, names[:], members[:]) { return 23 }
    if !ObjectPositions("{}", 0, names[:], members[:]) || members[0] != -1 { return 24 }
    no_names: []string
    if !ObjectPositions(body, 0, no_names, empty) { return 25 }
    if ReadStringText("\"café 日本語\"", 0, decoded[:]) != 15 || decoded[15] != cast(u8)0 { return 26 }
    if ReadStringText("\"raw\\nbytes\"", 0, decoded[:]) != 9 || decoded[3] != cast(u8)10 { return 27 }
    return 42
}

#program_export
NativeMain :: () -> s32 { return ifx SelfTest() == 42 then 0 else 1 }
