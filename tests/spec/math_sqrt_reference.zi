#import "std/math"
#import "std/binary"

// Independent integer digit-by-digit square root. The 106-bit radicand
// is read two bits at a time from the significand followed by 52 zeros;
// root and remainder fit u64. No floating arithmetic chooses rounding.
#program_export
ReferenceSqrt :: (bits: u64) -> float64 {
    magnitude := bits & cast(u64)0x7fffffffffffffff
    if magnitude == 0 { return Float64FromBits(bits) }
    if (bits >> cast(u64)63) != 0 { return NotANumber() }
    field := (bits >> cast(u64)52) & cast(u64)2047
    if field == 2047 { return Float64FromBits(bits) }
    significand := bits & cast(u64)0x000fffffffffffff
    exponent: s64 = -1022
    if field != 0 {
        significand |= cast(u64)0x0010000000000000
        exponent = cast(s64)field - 1023
    } else {
        while significand < cast(u64)0x0010000000000000 {
            significand <<= cast(u64)1
            exponent -= 1
        }
    }
    if exponent % 2 != 0 {
        significand <<= cast(u64)1
        exponent -= 1
    }
    root: u64
    remainder: u64
    digit: s64 = 52
    while digit >= 0 {
        pair: u64
        if digit >= 26 { pair = (significand >> cast(u64)(2 * digit - 52)) & cast(u64)3 }
        remainder = (remainder << cast(u64)2) | pair
        trial := (root << cast(u64)2) | cast(u64)1
        root <<= cast(u64)1
        if remainder >= trial { remainder -= trial; root |= cast(u64)1 }
        digit -= 1
    }
    // The midpoint's square is root^2 + root + 1/4. Since the
    // radicand is an integer, remainder > root rounds upward, with no tie.
    if remainder > root { root += 1 }
    encoded := (cast(u64)(exponent / 2 + 1023) << cast(u64)52) +
        root - cast(u64)0x0010000000000000
    return Float64FromBits(encoded)
}
