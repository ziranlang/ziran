// Division and remainder by constants give C's truncating results at every
// integer width. Native x86-64 code divides by most of these with a high
// multiply; a negative divisor keeps the general path.
Mix :: (hash: u64, value: u64) -> u64 { return (hash ^ value) * 1099511628211 }

Signed64 :: (n: s64, hash: u64) -> u64 {
    h := hash
    h = Mix(h, cast(u64)((n * (n + 1)) / 2))
    h = Mix(h, cast(u64)((n * (3 - n)) / 2))
    h = Mix(h, cast(u64)((n * 6) / 2))
    h = Mix(h, cast(u64)((n * (n + 2)) / 2))
    h = Mix(h, cast(u64)(n / 3)); h = Mix(h, cast(u64)(n % 3))
    h = Mix(h, cast(u64)(n / 7)); h = Mix(h, cast(u64)(n % 7))
    h = Mix(h, cast(u64)(n / 10)); h = Mix(h, cast(u64)(n % 10))
    h = Mix(h, cast(u64)(n / 287)); h = Mix(h, cast(u64)(n % 287))
    h = Mix(h, cast(u64)(n / 139968)); h = Mix(h, cast(u64)(n % 139968))
    h = Mix(h, cast(u64)(n / 1000000007)); h = Mix(h, cast(u64)(n % 1000000007))
    h = Mix(h, cast(u64)(n / 4294967311)); h = Mix(h, cast(u64)(n % 4294967311))
    h = Mix(h, cast(u64)(n / 9223372036854775807)); h = Mix(h, cast(u64)(n % 9223372036854775807))
    h = Mix(h, cast(u64)(n / -7)); h = Mix(h, cast(u64)(n % -7))
    return h
}

Unsigned64 :: (n: u64, hash: u64) -> u64 {
    h := hash
    h = Mix(h, n / 3); h = Mix(h, n % 3)
    h = Mix(h, n / 7); h = Mix(h, n % 7)
    h = Mix(h, n / 10); h = Mix(h, n % 10)
    h = Mix(h, n / 641); h = Mix(h, n % 641)
    h = Mix(h, n / 1000000007); h = Mix(h, n % 1000000007)
    h = Mix(h, n / 4294967311); h = Mix(h, n % 4294967311)
    h = Mix(h, n / 9223372036854775807); h = Mix(h, n % 9223372036854775807)
    return h
}

Narrow :: (n: s64, hash: u64) -> u64 {
    h := hash
    a := cast(s32)n
    h = Mix(h, cast(u64)(a / 7)); h = Mix(h, cast(u64)(a % 7))
    h = Mix(h, cast(u64)(a / 1000)); h = Mix(h, cast(u64)(a % 641))
    b := cast(u32)n
    h = Mix(h, cast(u64)(b / 10)); h = Mix(h, cast(u64)(b % 7))
    h = Mix(h, cast(u64)(b / 641)); h = Mix(h, cast(u64)(b % 1000000007))
    c := cast(s16)n
    h = Mix(h, cast(u64)(c / 3)); h = Mix(h, cast(u64)(c % 5))
    e := cast(s8)n
    h = Mix(h, cast(u64)((e * (e + 1)) / 2))
    d := cast(u8)n
    h = Mix(h, cast(u64)(d / 3)); h = Mix(h, cast(u64)(d % 10))
    return h
}

All :: (n: s64, hash: u64) -> u64 {
    return Narrow(n, Unsigned64(cast(u64)n, Signed64(n, hash)))
}

main :: () -> s32 {
    edges: [13]s64 = .[0, 1, -1, 2, -2, 6, -6, 127, 9223372036854775807, -9223372036854775807 - 1,
        4294967296, -4294967296, 1000000006]
    hash: u64 = 14695981039346656037
    for edge: edges { hash = All(edge, hash) }
    seed: u64 = 88172645463325252
    for i: 0..4999 {
        seed ^= seed << 13; seed ^= seed >> 7; seed ^= seed << 17
        hash = All(cast(s64)seed, hash)
        hash = All(cast(s64)(seed >> 40) - 8388608, hash)
    }
    print("constant division %\n", hash)
    return 0
}
