// Members of a large global record are read and changed in place, and
// all-zero records are zeroed in one pass, on every native target. ARM code
// once copied the whole global into the frame for each member read, which
// gave Shovey's LevelReplayPump a 12 MB frame and a frame-limit trap at
// entry on ARMv7 and AArch64 (tests/machine_fields_cases.zi checks the frame
// and the zeroing). The checksum must match C, through fixed and dynamic
// indexes, nested records, 64-bit and float members, member copies, local
// records and a zeroed array of records rebuilt on every iteration.
Cell :: struct {
    kind: s32
    weight: s64
    heat: float64
    marks: [6]u8
}

Board :: struct {
    cells: [64]Cell
    player: s32
    won: bool
}

Huge :: struct {
    level: s32
    trace: [200000]u8
    history: [200000]u8
    trace_count: s32
    trace_at: s32
    same: bool
    total: s64
    scale: float64
    board: Board
    spare: [200000]u8
}

huge: Huge;

Mix :: (hash: u64, value: u64) -> u64 { return (hash ^ value) * 1099511628211 }

// Each member read and write here once copied the whole record.
Step :: (cell: s32) -> bool {
    at := huge.trace_at
    if at + 2 > huge.trace_count || cast(s32)huge.trace[at] != cell { huge.same = false }
    huge.trace_at += 2
    huge.total += cast(s64)huge.trace[at + 1] * 1000003 + cast(s64)huge.history[at % 1000]
    huge.spare[at] = cast(u8)cell
    huge.scale = huge.scale * 0.5 + cast(float64)huge.level
    return huge.same
}

Fill :: (count: s32) {
    huge.trace_count = count
    for at: cast(s32)0..count - 1 {
        huge.trace[at] = cast(u8)((at * 37 + 11) % 251)
        huge.history[at] = cast(u8)(at % 13)
    }
    for at: cast(s32)0..63 {
        huge.board.cells[at].kind = at % 7
        huge.board.cells[at].weight = cast(s64)at * 4294967311
        huge.board.cells[at].heat = cast(float64)at * 0.25
        huge.board.cells[at].marks[at % 6] = cast(u8)at
    }
}

// A member copied out of the global, changed, and stored back.
Swap :: (left: s32, right: s32) {
    keep := huge.board.cells[left]
    huge.board.cells[left] = huge.board.cells[right]
    keep.weight += 1
    keep.marks[2] += 9
    huge.board.cells[right] = keep
}

// Local records read through dynamic indexes.
Local :: (seed: s32) -> u64 {
    cells: [16]Cell
    for at: cast(s32)0..15 {
        cells[at].kind = (seed + at) % 5
        cells[at].weight = cast(s64)(seed * at)
        cells[at].heat = cast(float64)at * 0.5
    }
    hash: u64 = 1469598103934665603
    for at: cast(s32)0..15 {
        pick := (at * 7 + seed) % 16
        hash = Mix(hash, cast(u64)cells[pick].kind)
        hash = Mix(hash, cast(u64)cells[pick].weight)
        hash = Mix(hash, cast(u64)(cells[pick].heat * 8.0))
    }
    return hash
}

// A loop-local array of records starts zeroed on every iteration.
Fresh :: (rounds: s32) -> u64 {
    hash: u64 = 1099511628211
    for round: cast(s32)0..rounds - 1 {
        boards: [8]Board
        boards[round % 8].cells[round % 64].weight += cast(s64)round + 1
        boards[(round + 3) % 8].player = round
        for board: boards[:] {
            hash = Mix(hash, cast(u64)board.player)
            hash = Mix(hash, cast(u64)board.cells[round % 64].weight)
            hash = Mix(hash, cast(u64)board.cells[63].marks[5])
        }
    }
    return hash
}

// Exercise exact copy/zero tails on both sides of the native vector and
// loop cutoffs. The unaligned member has sentinels on both sides, and the
// by-value argument must survive clearing its aliased caller storage.
CopyBox :: struct($T: Type) { before: u8; bytes: T; after: u8 }

CopyAndClear :: (value: $T, alias: *CopyBox(T)) -> T {
    zero: CopyBox(T)
    alias.bytes = zero.bytes
    result := value
    for byte, at: value { result[at] = byte ^ cast(u8)at }
    return result
}

CopyBoundary :: (shape: $T) -> bool {
    box: CopyBox(T)
    box.before = 173
    box.after = 219
    for byte, at: shape { box.bytes[at] = cast(u8)((at * 37 + 11) % 251) }
    saved := box.bytes
    result := CopyAndClear(box.bytes, *box)
    if box.before != 173 || box.after != 219 { return false }
    for byte, at: shape {
        expected := cast(u8)((at * 37 + 11) % 251)
        if box.bytes[at] != 0 || saved[at] != expected ||
            result[at] != (expected ^ cast(u8)at) { return false }
    }
    return true
}

CopyBoundaries :: () -> bool {
    short7: [7]u8
    short11: [11]u8
    short13: [13]u8
    short14: [14]u8
    a: [15]u8
    b: [16]u8
    c: [17]u8
    d: [63]u8
    e: [64]u8
    f: [65]u8
    g: [255]u8
    h: [256]u8
    i: [511]u8
    j: [512]u8
    k: [513]u8
    return CopyBoundary(short7) && CopyBoundary(short11) &&
        CopyBoundary(short13) && CopyBoundary(short14) &&
        CopyBoundary(a) && CopyBoundary(b) && CopyBoundary(c) &&
        CopyBoundary(d) && CopyBoundary(e) && CopyBoundary(f) &&
        CopyBoundary(g) && CopyBoundary(h) && CopyBoundary(i) &&
        CopyBoundary(j) && CopyBoundary(k)
}

// A packed record snapshot keeps its original fields across an aliased
// write, a call and a branch. Only the selected fields need copying, while a
// nested field remains a complete value that can be read after the change.
SnapshotRecord :: struct {
    tag: u8
    padding: [256]u8
    count: s32
    heat: float64
    total: s64
    cell: Cell
}

snapshot_record: SnapshotRecord;

ClearSnapshot :: (alias: *SnapshotRecord) {
    alias.count = 99
    alias.heat = 13.0
    alias.total = 17
    for at: cast(s32)0..255 { alias.padding[at] = cast(u8)at }
    alias.cell.weight = 23
    alias.cell.marks[5] = 29
}

SnapshotFields :: (branch: bool) -> bool {
    snapshot_record.count = 41
    snapshot_record.heat = 2.5
    snapshot_record.total = 4294967311
    snapshot_record.cell.weight = 9000000007
    snapshot_record.cell.marks[5] = 31
    saved := snapshot_record
    nested := saved.cell
    ClearSnapshot(*snapshot_record)
    if branch {
        return saved.count == 41 && saved.heat == 2.5 && saved.total == 4294967311 &&
            nested.weight == 9000000007 && nested.marks[5] == 31
    }
    snapshot_record.count = 0
    return saved.count == 41 && saved.total == 4294967311 && nested.weight == 9000000007 &&
        nested.marks[5] == 31 && snapshot_record.heat == 13.0
}

// The results of separate return blocks may share a callee destination,
// while two calls must still produce independent values in their caller.
TerminalRecord :: (first: bool, seed: s32) -> SnapshotRecord {
    if first {
        return .{tag = 7, count = seed, heat = 3.25, total = 4294967311,
            cell = Cell.{kind = seed + 1, weight = 9000000007}}
    }
    return .{tag = 11, count = seed + 2, heat = 6.5, total = 4294967357,
        cell = Cell.{kind = seed + 3, weight = 9000000037}}
}

TerminalRecords :: () -> bool {
    first := TerminalRecord(true, 37)
    second := TerminalRecord(false, 43)
    return first.tag == 7 && first.count == 37 && first.heat == 3.25 &&
        first.total == 4294967311 && first.cell.kind == 38 && first.cell.weight == 9000000007 &&
        second.tag == 11 && second.count == 45 && second.heat == 6.5 &&
        second.total == 4294967357 && second.cell.kind == 46 && second.cell.weight == 9000000037 &&
        first.padding[255] == 0 && second.padding[0] == 0 && first.cell.marks[5] == 0
}

main :: () -> s32 {
    if !CopyBoundaries() || !SnapshotFields(true) || !SnapshotFields(false) || !TerminalRecords() { return 1 }
    huge.level = 3
    huge.scale = 1.0
    huge.same = true
    Fill(4000)
    for at: cast(s32)0..499 {
        cell := cast(s32)huge.trace[huge.trace_at]
        if at % 97 == 13 { cell += 1 }
        unused Step(cell)
        huge.same = true
    }
    Swap(3, 60)
    Swap(10, 11)
    huge.board.player = huge.board.cells[60].kind + huge.board.cells[3].kind
    huge.board.won = huge.board.cells[60].marks[2] > 9
    hash: u64 = 14695981039346656037
    hash = Mix(hash, cast(u64)huge.trace_at)
    hash = Mix(hash, cast(u64)huge.total)
    hash = Mix(hash, cast(u64)(huge.scale * 1000000.0))
    for at: cast(s32)0..63 {
        cell := huge.board.cells[at]
        hash = Mix(hash, cast(u64)cell.kind)
        hash = Mix(hash, cast(u64)cell.weight)
        hash = Mix(hash, cast(u64)(cell.heat * 4.0))
        for mark: cell.marks { hash = Mix(hash, cast(u64)mark) }
    }
    hash = Mix(hash, cast(u64)huge.board.player)
    hash = Mix(hash, cast(u64)huge.spare[huge.trace_at - 2])
    hash = Mix(hash, ifx huge.board.won then cast(u64)1 else cast(u64)0)
    hash = Mix(hash, Local(5))
    hash = Mix(hash, Fresh(20))
    print("large global fields %\n", hash)
    return 0
}
