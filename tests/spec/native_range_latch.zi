// Inclusive ranges with computed bounds: native x86-64 code drops the
// latch's second test (the next value is at most the last one) when the
// loop has just left on reaching the last value. The counts and sums must
// match C, including bounds at a type's maximum, where a wrong test would
// step past the end.
Mix :: (hash: u64, value: u64) -> u64 { return (hash ^ value) * 1099511628211 }

// Opaque bounds, so ranges are computed rather than constant.
Bound :: (seed: s64, offset: s64) -> s64 {
    if seed == 0 { return offset }
    return Bound(seed - 1, offset)
}

Up :: (first: s64, last: s64, hash: u64) -> u64 {
    h := hash
    count: s64
    for i: first..last { h = Mix(h, cast(u64)i); count += 1 }
    return Mix(h, cast(u64)count)
}

Down :: (first: s64, last: s64, hash: u64) -> u64 {
    h := hash
    for < i: first..last { h = Mix(h, cast(u64)i) }
    return h
}

Skips :: (last: s64, hash: u64) -> u64 {
    h := hash
    for i: 0..last {
        if i % 3 == 0 { continue }
        if i > 40 { break }
        for j: i..last { if j > i + 2 { break }; h = Mix(h, cast(u64)(i * 100 + j)) }
    }
    return h
}

Narrow :: (first: u8, last: u8, hash: u64) -> u64 {
    h := hash
    for value: first..last { h = Mix(h, cast(u64)value) }
    return h
}

main :: () -> s32 {
    hash: u64 = 14695981039346656037
    hash = Up(Bound(3, 0), Bound(2, 9), hash)
    hash = Up(Bound(1, 5), Bound(1, 5), hash)
    hash = Up(Bound(1, 7), Bound(1, 6), hash)
    hash = Up(Bound(2, 9223372036854775800), Bound(1, 9223372036854775807), hash)
    hash = Down(Bound(1, -3), Bound(2, 4), hash)
    hash = Down(Bound(1, -9223372036854775807 - 1), Bound(1, -9223372036854775807 + 5), hash)
    hash = Skips(Bound(4, 60), hash)
    hash = Narrow(cast(u8)Bound(2, 250), cast(u8)Bound(3, 255), hash)
    print("range latch %\n", hash)
    return 0
}
