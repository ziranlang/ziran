#import "package_manifest"
#import "byte_text_linux"

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 3 { return 1 }
    manifest := PkgNewManifest()
    if !PkgParseManifest(TextFromCString(argv[1]), manifest) || !manifest.valid { return 2 }
    if manifest.name != "native-manifest" || manifest.tool_git != "https://github.com/ziranlang/ziran.git" { return 3 }
    if manifest.root_count != 2 || manifest.roots[1] != "generated" || manifest.dependency_count != 2 { return 4 }
    dep := *manifest.dependencies[0]
    if dep.alias != "kryon" || dep.ref != "feature#text" || dep.alias_count != 1 || dep.aliases[0].value != "Renamed" { return 5 }
    other := *manifest.dependencies[1]
    if other.alias != "helper" || !other.source || other.ref != "master" { return 6 }
    if manifest.export_count != 2 || manifest.exports[0].value != "src/Entry.zi" ||
       manifest.exports[1].name != "host/desktop" || manifest.exports[1].value != "src/Desktop.zi" { return 7 }
    if PkgParseManifest(TextFromCString(argv[2]), PkgNewManifest()) { return 8 }
    if !PkgSystemLibraryName("gio-2.0") || !PkgSystemLibraryName("gdk_pixbuf-2.0") ||
       !PkgSystemLibraryName("stdc++") { return 9 }
    if PkgSystemLibraryName("") || PkgSystemLibraryName("-lgtk-3") ||
       PkgSystemLibraryName("../lib") || PkgSystemLibraryName("x y") ||
       PkgSystemLibraryName("x;touch") || PkgSystemLibraryName("$(shell id)") { return 10 }
    if manifest.link_count != 2 || manifest.links[1] != "gdk_pixbuf-2.0" { return 11 }
    if !PkgExportName("host/desktop") || !PkgExportName("host/web/renderer") ||
       PkgExportName("host//desktop") || PkgExportName("host/desktop/") { return 12 }
    return 0
}
