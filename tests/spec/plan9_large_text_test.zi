// Long UTF-8 text must not overflow 8c macro expansion or lose NUL bytes.
LongText :: "";

#program_export
main :: () -> s32 {
    text := LongText
    if text.count != 3840 || text[0] != cast(u8)97 || text[3839] != cast(u8)104 { return 1 }
    for i: cast(s32)0..3839 { if text[i] != cast(u8)(97 + i % 8) { return 2 } }
    escaped := "café\0Ω\"\\\n"
    if escaped.count != 11 || escaped[5] != cast(u8)0 || escaped[6] != cast(u8)206 ||
        escaped[7] != cast(u8)169 || escaped[8] != cast(u8)34 ||
        escaped[9] != cast(u8)92 || escaped[10] != cast(u8)10 { return 3 }
    if escaped[:5] != "café" || escaped[6:8] != "Ω" { return 4 }
    if "".count != 0 { return 5 }
    print("Large text and embedded NUL preserved\n"); return 0
}
