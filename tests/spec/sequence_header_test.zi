#import "std/byte_text_linux"
#import "std/text"

libc :: #system_library "libc";
Compare :: (first: *u8, second: *u8, count: usize) -> s32 #foreign libc "memcmp";

// Layout, rather than these arbitrary names, defines the header cast.
StringHeader :: struct { address: *u8; size: usize }
SliceHeader :: struct { elements: *s32; used: s64 }
CollisionHeader :: struct { _state: *u8; _data: usize }

Main :: () -> s32 {
    value := "A\x00é"
    header := cast(*StringHeader)(*value)
    alias := cast(*StringHeader)(*value)
    if header != alias || header.size != 4 || header.address[1] != cast(u8)0 ||
        header.address[2] != cast(u8)195 || Compare(header.address, alias.address, 4) != 0 { return 1 }
    value = "other"
    if header.size != 5 || header.address[0] != cast(u8)111 { return 2 }
    header.size = 3
    if value != "oth" || alias.size != 3 { return 3 }
    copied := <<header
    if copied.size != 3 || copied.address[2] != cast(u8)104 { return 4 }

    bytes: [5]u8 = .[0, 120, 0, 122, 0]
    fresh: string
    descriptor := cast(*TextDescriptor)(*fresh)
    descriptor.data = *bytes[1]
    descriptor.length = 3
    if fresh != "x\x00z" || TextFromCString(*bytes[1]) != "x" { return 5 }
    collision := cast(*CollisionHeader)(*fresh)
    if collision._state[2] != cast(u8)122 || collision._data != 3 { return 6 }

    borrowed := BytesFromPointer(*bytes[1], 3)
    if borrowed.count != 3 || borrowed[2] != cast(u8)122 { return 7 }
    borrowed[0] = cast(u8)121
    if bytes[1] != cast(u8)121 { return 8 }
    numbers: [4]s32 = .[10, 20, 30, 40]
    slice := numbers[1:4]
    integers := cast(*SliceHeader)(*slice)
    if integers.used != 3 || integers.elements[1] != 30 { return 9 }
    integers.used = 2
    integers.elements[1] = 31
    if slice.count != 2 || slice[1] != 31 || numbers[2] != 31 { return 10 }
    integers.elements = *numbers[0]
    if slice[0] != 10 || slice[1] != 20 { return 11 }

    strings: [2]string = .["first", "second"]
    headers := cast(*StringHeader)(*strings[0])
    if headers[1].size != 6 || headers[1].address[0] != cast(u8)115 { return 12 }
    replacement: StringHeader = .{address = *bytes[1], size = 3}
    <<descriptor = .{data = *bytes[1], length = 3}
    if fresh != "y\x00z" { return 13 }
    headers[1] = replacement
    if strings[1] != "y\x00z" { return 14 }
    // The pointer and length can be written in either order. A transient
    // header is not read until both fields describe a valid borrowed range.
    fresh = "a longer old value"
    descriptor.data = *bytes[1]
    descriptor.length = 3
    if fresh != "y\x00z" || fresh[1:3] != "\x00z" ||
        Compare(descriptor.data, *bytes[1], 3) != 0 { return 15 }
    out: Vec(u8)
    BuilderPrint(*out, "%|%", fresh, fresh[1:3])
    if BuilderFinish(out) != "y\x00z|\x00z" { return 20 }
    fresh = ""
    descriptor.length = 3
    descriptor.data = *bytes[1]
    if fresh != "y\x00z" { return 16 }
    blank: []s32
    blank_header := cast(*SliceHeader)(*blank)
    blank_header.used = 2
    blank_header.elements = *numbers[0]
    if blank.count != 2 || blank[1] != 20 { return 17 }
    empty: []s32
    empty_header := cast(*SliceHeader)(*empty)
    empty_header.elements = *numbers[1]
    empty_alias := cast(*SliceHeader)(*empty)
    if empty_alias.used != 0 || empty_alias.elements != *numbers[1] { return 18 }
    if TextFromCString(null) != "" || BytesFromPointer(null, 4).count != 0 ||
        BytesFromPointer(*bytes[0], cast(u64)9223372036854775808).count != 0 { return 19 }
    return 0
}
