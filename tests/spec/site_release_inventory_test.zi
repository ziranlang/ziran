#import "native_test"
#import "check_support"
#import "std/file_tree_linux"
#import "std/json_document"

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "site-inventory-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    script := CheckPath(test.repo, "scripts/site_pages.py")
    work := test.work
    if !CreateDirectories(CheckPath(work, "site")) || !CreateDirectories(CheckPath(work, "std")) { return 2 }
    if !NativeWrite(*test, CheckPath(work, "VERSION"), "0.0.9\n") ||
        !NativeWrite(*test, CheckPath(work, "std/plain.zi"), "// Released module.\nAnswer :: 42;\n") ||
        !NativeWrite(*test, CheckPath(work, "std/future.zi"), "// Unreleased module.\nFuture :: 43;\n") { return 3 }
    inventory := CheckPath(work, "site/stdlib-release.json")
    if !NativeWrite(*test, inventory, "{\"version\":\"0.0.9\",\"modules\":[\"plain\"]}") { return 4 }
    // Invoke the generator's real CLI. All fixtures and assertions live here;
    // release status cannot be inferred from a matching Git tag.
    args := string.["python3", script, "--ziran", test.ziran, "--stdlib-inventory", work]
    result := NativeRun(*test, args[:])
    if test.failed { return 5 }
    document: JsonDocument
    defer JsonReset(*document)
    if !NativeAssert(*test, JsonRead(*document, result.output), "invalid inventory JSON") { return 6 }
    if !NativeAssert(*test, JsonString(*document, JsonElement(*document, document.root, 1)) == "v0.0.9", "unexpected inventory version") { return 7 }
    modules := JsonElement(*document, document.root, 0)
    if !NativeAssert(*test, JsonCount(*document, modules) == 2, "unexpected inventory module count") { return 8 }
    future := JsonElement(*document, modules, 0); plain := JsonElement(*document, modules, 1)
    if !NativeAssert(*test, JsonString(*document, JsonMember(*document, future, "name")) == "future" &&
        JsonString(*document, JsonMember(*document, future, "status")) == "in-progress" &&
        JsonString(*document, JsonMember(*document, plain, "name")) == "plain" &&
        JsonString(*document, JsonMember(*document, plain, "status")) == "stable", "unexpected inventory module status") { return 9 }
    bad := string.[
        "{\"version\":\"0.0.8\",\"modules\":[\"plain\"]}",
        "{\"version\":\"0.0.9\",\"modules\":[\"plain\",\"plain\"]}",
        "{\"version\":\"0.0.9\",\"modules\":\"plain\"}",
        "{\"version\":\"0.0.9\",\"modules\":[\"../bad\"]}",
        "{\"version\":\"0.0.9\",\"modules\":[]}"
    ]
    for value: bad {
        if !NativeWrite(*test, inventory, value) { return 10 }
        invalid := NativeInvoke(*test, args[:])
        if !NativeAssert(*test, !invalid.timed_out && !invalid.interrupted && invalid.code == 1, "invalid inventory must fail with code 1") { return 11 }
    }
    print("Release inventory preserves shipped/unreleased module status independently of Git tags\n")
    return 0
}
