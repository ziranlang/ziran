#import "sort"

// Deterministic pseudo-random values; the fixed seed keeps every target equal.
SortTestNext :: (state: u32) -> u32 {
    return state * 1664525 + 1013904223
}

#program_export
SelfTest :: () -> s32 {
    empty: [0]s32
    Sort(empty[:])
    if !IsSorted(empty[:]) || BinarySearch(empty[:], 3) != -1 ||
        LowerBound(empty[:], 3) != 0 { return 1 }

    one: [1]s32 = .[5]
    Sort(one[:])
    if one[0] != 5 || BinarySearch(one[:], 5) != 0 { return 2 }

    values: [9]s32 = .[5, -3, 9, 0, 5, 12, -3, 7, 1]
    if IsSorted(values[:]) { return 3 }
    Sort(values[:])
    expected: [9]s32 = .[-3, -3, 0, 1, 5, 5, 7, 9, 12]
    index: s32 = 0
    while index < 9 {
        if values[index] != expected[index] { return 4 }
        index += 1
    }
    if !IsSorted(values[:]) { return 5 }
    if LowerBound(values[:], 5) != 4 || LowerBound(values[:], 6) != 6 ||
        LowerBound(values[:], -10) != 0 || LowerBound(values[:], 99) != 9 { return 6 }
    if BinarySearch(values[:], 7) != 6 || BinarySearch(values[:], 2) != -1 { return 7 }
    found: s64 = BinarySearch(values[:], -3)
    if found < 0 || values[found] != -3 { return 8 }

    // Sorting a subslice leaves the rest alone.
    part: [6]s64 = .[9, 8, 7, 6, 5, 4]
    Sort(part[1:5])
    if part[0] != 9 || part[1] != 5 || part[4] != 8 || part[5] != 4 { return 9 }

    reals: [4]float64 = .[2.5, -1.25, 0.0, 2.25]
    Sort(reals[:])
    if reals[0] != -1.25 || reals[3] != 2.5 || !IsSorted(reals[:]) { return 10 }

    bytes: [5]u8 = .[200, 3, 255, 0, 17]
    Sort(bytes[:])
    if bytes[0] != 0 || bytes[4] != 255 || BinarySearch(bytes[:], 17) != 2 { return 11 }

    many: [257]u32
    state: u32 = 7
    index = 0
    while index < 257 {
        state = SortTestNext(state)
        many[index] = state % 1000
        index += 1
    }
    Sort(many[:])
    if !IsSorted(many[:]) { return 12 }

    return 42
}
