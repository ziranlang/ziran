// Runtime input values exercise C/native multiplication selection at every
// integer width, including truncation, sign extension and wraparound.
Emit :: (x: u64) {
    print("% % % % % % % %\n", x * 2, x * 3, x * 5, x * 9, x * 8, x * 32, x * 128, x * 1073741824)
    a := cast(u8)x
    b := cast(u16)x
    c := cast(u32)x
    print("% % % % % %\n", cast(u8)(a * 3), cast(u8)(a * 32),
        cast(u16)(b * 5), cast(u16)(b * 128), cast(u32)(c * 9), cast(u32)(c * 1073741824))
    d := cast(s8)x
    e := cast(s16)x
    f := cast(s32)x
    print("% % % % % %\n", cast(s8)(d * 3), cast(s8)(d * 32),
        cast(s16)(e * 5), cast(s16)(e * 128), cast(s32)(f * 9), cast(s32)(f * 1073741824))
    // Constant divisors use shifts in native code, including signed
    // truncation toward zero, signed remainders and full-width masks.
    sx := cast(s64)x
    print("% % % % % % % % % %\n", sx / 2, sx % 2, sx / 8, sx % 8,
        sx / 4294967296, sx % 4294967296, x / 2, x % 2,
        x / 9223372036854775808, x % 9223372036854775808)
    print("% % % % % % % %\n", cast(s8)(d / 2), cast(s8)(d % 2),
        cast(s16)(e / 8), cast(s16)(e % 8), cast(s32)(f / 256), cast(s32)(f % 256),
        cast(u8)(a / 128), cast(u8)(a % 128))
    // Both ends of the imm8 range, and the adjacent imm32 values.
    print("% % % %\n", x * cast(u64)-128, x * cast(u64)127, x * cast(u64)-129, x * cast(u64)128)
}

// Recursive entry returns exercise the actual call ABI, including live
// caller values across both an early return and an ordinary framed call.
EntryFib :: (n: s64) -> s64 {
    if n < 2 { return n }
    return EntryFib(n - 1) + EntryFib(n - 2)
}
EntrySigned :: (n: s64) -> s64 {
    if n < 2 { return n }
    return n + EntrySigned(1)
}
EntryUnsigned :: (n: u64) -> u64 {
    if n > 1000 { return n }
    return n + EntryUnsigned(1001)
}
EntryConstant :: (n: s64) -> s64 {
    if n < 2 { return 42 }
    return EntryConstant(n - 1) + 1
}
CallSetupCheck :: () -> bool {
    previous: s64
    next: s64 = 1
    for n: cast(s64)0..20 {
        if EntryFib(n) != previous { return false }
        sum := previous + next
        previous = next
        next = sum
    }
    bits := u64.[0, 1, 2, 3, 1000, 1001, 2147483647, 2147483648,
        9223372036854775807, 9223372036854775808, 18446744073709551615]
    for value: bits {
        signed := cast(s64)value
        expected_signed := ifx signed < 2 then signed else signed + 1
        expected_unsigned := ifx value > 1000 then value else value + 1001
        if EntrySigned(signed) != expected_signed || EntryUnsigned(value) != expected_unsigned { return false }
        // Repeating calls after the opposite branch also checks preservation.
        if EntrySigned(12) != 13 || EntryUnsigned(12) != 1013 { return false }
    }
    for n: cast(s64)0..12 {
        expected := ifx n < 2 then cast(s64)42 else 41 + n
        if EntryConstant(n) != expected { return false }
    }
    return true
}

// Round an unsigned integer using integer discarded bits and ties to even.
// The final significand conversion is exact for both precisions; subsequent
// multiplications by two are exact too, including a carry out of the mantissa.
RoundedInteger :: (value: u64, precision: s64) -> float64 {
    significand := value
    shift: s64
    maximum := (cast(u64)1 << cast(u64)precision) - 1
    while significand > maximum { significand >>= cast(u64)1; shift += 1 }
    if shift > 0 {
        remainder := value & ((cast(u64)1 << cast(u64)shift) - 1)
        halfway := cast(u64)1 << cast(u64)(shift - 1)
        if remainder > halfway || (remainder == halfway && (significand & 1) != 0) { significand += 1 }
    }
    result := cast(float64)significand
    for bit: cast(s64)0..shift - 1 { result *= 2.0 }
    return result
}
IntegerFloatCheck :: (bits: u64) -> bool {
    signed := cast(s64)bits
    magnitude := ifx signed < 0 then cast(u64)0 - bits else bits
    sign := ifx signed < 0 then -1.0 else 1.0
    return cast(float64)bits == RoundedInteger(bits, 53) &&
        cast(float64)(cast(float32)bits) == RoundedInteger(bits, 24) &&
        cast(float64)signed == sign * RoundedInteger(magnitude, 53) &&
        cast(float64)(cast(float32)signed) == sign * RoundedInteger(magnitude, 24)
}

main :: () -> s32 {
    if !CallSetupCheck() { return 1 }
    boundaries := u64.[0, 1, 127, 128, 255, 256, 32767, 32768, 65535, 65536,
        16777215, 16777216, 16777217, 16777219, 33554431,
        2147483647, 2147483648, 4294967295, 4294967296, 9007199254740991,
        9007199254740992, 9007199254740993, 9007199254740995, 9223372036854775807,
        9223372036854775808, 18446744073709551615]
    for value: boundaries {
        if !IntegerFloatCheck(value) { return 2 }
        Emit(value)
    }
    random: u64 = 521288629
    for iteration: 0..2047 {
        random = (random ^ (random << 13))
        random = (random ^ (random >> 7))
        random = (random ^ (random << 17))
        if !IntegerFloatCheck(random) { return 3 }
        Emit(random)
    }
    return 0
}
