#import "text_tools"

#program_export
SelfTest :: () -> s32 {
    output: Vec(u8)
    VecPush(output, #char "o")
    if !TextHexDecodeInto("", *output, 0) || output.count != 1 { return 1 }
    if !TextHexDecodeInto("00aB", *output, 2) || output.count != 3 ||
        output[1] != 0 || output[2] != 171 { return 2 }

    failures: [5]string = .["41z", "41424", "414241", "", "4142zz"]
    limits: [5]s64 = .[1, 1, -1, -1, 3]
    for at: cast(s64)0..4 {
        if TextHexDecodeInto(failures[at], *output, limits[at]) { return cast(s32)(10 + at) }
        if output.count != 3 || output[0] != #char "o" || output[1] != 0 || output[2] != 171 {
            return cast(s32)(20 + at)
        }
    }
    if output.count != 3 || output[0] != #char "o" || output[1] != 0 || output[2] != 171 { return 3 }

    aliased: Vec(u8)
    if !BuilderAppend(aliased, "4142434445464748") || aliased.count != 16 { return 4 }
    aliased_hex := TextView(VecSlice(aliased, 0, aliased.count))
    if !TextHexDecodeInto(aliased_hex, *aliased, 8) || aliased.count != 24 ||
        aliased[16] != 65 || aliased[17] != 66 { return 5 }
    if TextHexDecodeInto("41424344454647484z", *aliased, 9) || aliased.count != 24 { return 6 }
    return 42
}
