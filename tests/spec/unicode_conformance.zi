// Generated Unicode 17.0.0 case mappings and property boundaries.
// Unicode License V3; see LICENSE-Unicode.
U :: #import "std/unicode";

// Each row stores two byte counts followed by the input and expected UTF-8.
CheckMappings :: (mode: s32, data: string) -> bool {
    at: s64
    while at < data.count {
        input_count := cast(s64)data[at]
        expected_count := cast(s64)data[at + 1]
        start := at + 2
        split := start + input_count
        at = split + expected_count
        input := data[start:split]
        expected := data[split:at]
        matches := false
        if mode == 0 { matches = U.CaseFold(input) == expected }
        else if mode == 1 { matches = U.Lower(input) == expected }
        else { matches = U.Capitalize(input) == expected }
        if !matches { print("Unicode mapping % differs for %\n", mode, input); return false }
    }
    return true
}

// Each row stores the code point followed by four expected property bits.
CheckProperties :: (data: []u32) -> bool {
    for row: data {
        point := row >> 4
        if U.IsWord(point) != ((row & 1) != 0) || U.IsSpace(point) != ((row & 2) != 0) ||
           U.IsDecimal(point) != ((row & 4) != 0) || U.IsPrintable(point) != ((row & 8) != 0) {
            print("Unicode properties differ for code point %\n", point)
            return false
        }
    }
    return true
}

