Row :: struct { value: s32; text: string; bytes: [3]u8 }
Handler :: #type (s32) -> s32;

Next :: (value: s32) -> s32 { return value + 1 }
Burn :: (row: *Row) -> s32 {
    scratch: [32768]u8
    scratch[32767] = cast(u8)row.value
    row.value += 1
    return cast(s32)scratch[32767]
}
Snapshot :: (row: Row, ignored: s32) -> s32 {
    unused ignored
    if row.text != "leaf" || row.bytes[1] != 2 { return -1 }
    return row.value
}

#program_export
main :: () -> s32 {
    handler: Handler = Next
    maximum: u64 = 18446744073709551615
    small: float32 = 16777217.0
    if maximum != cast(u64)18446744073709551615 || small != cast(float32)16777216.0 ||
        size_of(u64) != 8 || !true || false { return 1 }
    for i: 0..399 {
        row: Row
        row.value = cast(s32)i; row.text = "leaf"; row.bytes = u8.[1, 2, 3]
        saved := Snapshot(row, Burn(*row))
        if saved != i || row.value != i + 1 || handler(cast(s32)i) != i + 1 { return 2 }
        reference := *row
        text := row.text
        if reference == null || reference.value != i + 1 || text != "leaf" { return 3 }
    }
    return 0
}
