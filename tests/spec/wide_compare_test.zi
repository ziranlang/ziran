Entry :: struct { padding: [64]u8; unsigned: u64; signed: s64; }
entries: [2]Entry;
next: s32;

Pick :: () -> s32 { result := next; next += 1; return result }
Change :: () -> u64 { entries[0].unsigned = cast(u64)0; return cast(u64)1 }

BytesMatch :: () -> bool {
    bytes := u8.[104, 101, 108, 108, 111, 32, 104, 101, 108, 108, 111, 32, 104, 101, 108, 108, 111]
    expected := "hello hello hello"
    for index: 0..16 { if bytes[index] != expected[index] { return false } }
    return true
}

ZeroArrayPreservesRecord :: () -> bool {
    expected := "hello hello hello"
    bytes: [19]u8
    for index: 0..18 { if bytes[index] != cast(u8)0 { return false } }
    bytes[0] = cast(u8)77; bytes[18] = cast(u8)88
    return expected == "hello hello hello" && expected[0] == cast(u8)104
}

SignedMinimumLiteral :: () -> bool {
    minimum: s64 = -9223372036854775808
    if minimum != -9223372036854775808 || -9223372036854775808 != minimum ||
        !(minimum == -9223372036854775808) || !(-9223372036854775808 == minimum) ||
        !(minimum <= -9223372036854775808) || !(-9223372036854775808 <= minimum) ||
        !(minimum >= -9223372036854775808) || !(-9223372036854775808 >= minimum) ||
        minimum < -9223372036854775808 || -9223372036854775808 < minimum ||
        minimum > -9223372036854775808 || -9223372036854775808 > minimum { return false }
    values := s64.[-9223372036854775807, -1, 0, 1, 9223372036854775807]
    for value: values {
        if !(value > -9223372036854775808) || !(-9223372036854775808 < value) ||
            !(value >= -9223372036854775808) || !(-9223372036854775808 <= value) ||
            value < -9223372036854775808 || -9223372036854775808 > value ||
            value <= -9223372036854775808 || -9223372036854775808 >= value ||
            value == -9223372036854775808 || -9223372036854775808 == value ||
            !(value != -9223372036854775808) || !(-9223372036854775808 != value) { return false }
    }
    one: s64 = 1
    if one / -9223372036854775808 != 0 || one % -9223372036854775808 != one { return false }
    expected: float64 = cast(float64)minimum
    if cast(float64)(-9223372036854775808) != expected { return false }
    high: u64 = cast(u64)9223372036854775808
    maximum: u64 = cast(u64)18446744073709551615
    return -high == high && -maximum == cast(u64)1 &&
        high > cast(u64)0 && maximum > high
}

// Constants that native x86-64 code takes as immediates of a compare, add,
// subtract, multiply or bitwise operation, at the edges of a sign-extended
// 32-bit field and of narrow and unsigned types, through fused branches and
// || / && joins. LIMIT is zero at run time.
Immediates :: (limit: s64) -> bool {
    high := limit + 2147483647
    if !(high > 2147483646) || high >= 2147483648 || high - 2147483647 != limit { return false }
    low := limit - 2147483648
    if !(low < -2147483647) || low <= -2147483649 || low + 2147483648 != limit { return false }
    if (limit * 7 + 3) * -5 != -15 || ((limit | 12) & 10) != 8 || (limit ^ -1) != -1 { return false }
    narrow: s8 = cast(s8)(limit - 128)
    if !(narrow < -127) || narrow != -128 || !(narrow <= -128) || narrow > -128 { return false }
    byte: u8 = cast(u8)(limit + 200)
    if !(byte > 199) || byte >= 201 || byte != 200 { return false }
    word: u32 = cast(u32)limit + cast(u32)4294967295
    if !(word > cast(u32)4294967294) || word != cast(u32)4294967295 || !(cast(u32)limit + cast(u32)5 < cast(u32)7) {
        return false
    }
    flag := limit == 0
    if flag != true || !flag || (limit > 5 || limit < -5) || !(limit >= 0 && limit <= 0) { return false }
    count: s64
    for i: 0..40 { if i % 3 == 0 || i > 37 && i != 39 { count += 1 } }
    return count == 16
}

#program_export
main :: () -> s32 {
    entries[0].unsigned = cast(u64)4294967296
    entries[1].unsigned = cast(u64)18446744073709551615
    entries[0].signed = -9223372036854775808
    entries[1].signed = 9223372036854775807
    left: s32 = 0; right: s32 = 1
    if !(entries[left].unsigned < entries[right].unsigned) ||
        !(entries[right].unsigned > entries[left].unsigned) ||
        !(entries[left].unsigned <= entries[right].unsigned) ||
        !(entries[right].unsigned >= entries[left].unsigned) ||
        entries[left].unsigned == entries[right].unsigned ||
        !(entries[left].unsigned != entries[right].unsigned) { return 1 }
    if !(entries[left].signed < entries[right].signed) ||
        !(entries[right].signed > entries[left].signed) ||
        entries[left].signed == entries[right].signed { return 2 }
    next = 0
    if !(entries[Pick()].unsigned < entries[Pick()].unsigned) || next != 2 { return 3 }
    // The left field is read before the right call changes it.
    if entries[left].unsigned < Change() || entries[left].unsigned != cast(u64)0 { return 4 }
    if !BytesMatch() { return 5 }
    if !ZeroArrayPreservesRecord() { return 6 }
    if !SignedMinimumLiteral() { return 7 }
    if !Immediates(cast(s64)next - 2) { return 8 }
    print("wide-compare-test-ok\n")
    return 0
}
