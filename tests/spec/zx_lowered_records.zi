// Records in arrays, read and changed by member: every read must see the
// value as it was when read, whichever order the reads and writes come in.

Point :: struct { x: s64; y: s64 }
Pair :: struct { left: Point; right: Point; tags: [3]s64 }
Box :: struct { x: float32; y: float32; width: float32; height: float32 }
Framed :: struct { clip: Box; left: s32; height: s32 }

// A record result with more integer arguments than registers: the last one
// passes on the stack beside the record argument and the result address.
Frame :: (bounds: Box, a: s32, b: s32, c: s32, d: s32, e: s32, f: s32, guard: s32) -> Framed {
    framed: Framed
    framed.clip = Box.{bounds.x + cast(float32)a, bounds.y - cast(float32)guard,
        bounds.width, bounds.height + cast(float32)(guard * 2)}
    framed.left = cast(s32)bounds.x + a - b
    framed.height = c + d + e + f
    return framed
}
Guard :: (scale: s32) -> s32 { return scale * 3 }
Moved :: (point: Point, by: s64) -> Point { point.x += by; return point }
Mover :: #type (point: Point, by: s64) -> Point;
Holder :: struct { move: Mover; point: Point }

// Signed interval checks may use one unsigned comparison, including narrow
// signed values and either order of the original short-circuit expression.
Outside8 :: (value: s8) -> bool { return value > 100 || value < 0 }
Outside16 :: (value: s16) -> bool { return value < 0 || value > 1000 }
Outside32 :: (value: s32) -> bool { return value > 1000 || value < 0 }
Outside64 :: (value: s64) -> bool { return value > 1000 || value < 0 }
OutsideMax :: (value: s64) -> bool { return value > 9223372036854775807 || value < 0 }
OutsideNarrow :: (value: s8) -> bool { return value > cast(s64)1000 || value < 0 }
OutsideOther :: (left: s64, right: s64) -> bool { return left > 1000 || right < 0 }
OutsideUnsigned :: (value: u64) -> bool { return value > 1000 || value < 0 }
OutsideFloat :: (value: float64) -> bool { return value > 1000.0 || value < 0.0 }
BoundsCalls: s32;
BoundsNext :: (value: s64) -> s64 { BoundsCalls += 1; return value }

BoundsCases :: () -> bool {
    for number: -128..127 {
        expected := number < 0
        if number > 100 { expected = true }
        if Outside8(cast(s8)number) != expected { return false }
        if OutsideNarrow(cast(s8)number) != (number < 0) { return false }
    }
    numbers := s64.[-9223372036854775808, -32768, -1, 0, 1, 999, 1000, 1001,
        32767, 2147483647, 9223372036854775807]
    records: [11]Point
    for number, index: numbers {
        records[index] = Point.{x = number, y = number}
        expected := number < 0
        if number > 1000 { expected = true }
        if Outside64(number) != expected || OutsideMax(number) != (number < 0) { return false }
        member := records[index].x > 1000 || records[index].x < 0
        reversed := records[index].y < 0 || records[index].y > 1000
        if member != expected || reversed != expected { return false }
        if number >= -32768 && number <= 32767 {
            if Outside16(cast(s16)number) != expected { return false }
        }
        if number >= -2147483648 && number <= 2147483647 {
            if Outside32(cast(s32)number) != expected { return false }
        }
    }
    if !OutsideOther(1, -1) || OutsideOther(1, 0) { return false }
    if !OutsideUnsigned(18446744073709551615) || OutsideUnsigned(1000) { return false }
    if !OutsideFloat(-0.5) || OutsideFloat(1000.0) { return false }
    BoundsCalls = 0
    // Distinct calls must run twice when the first predicate is false.
    if !(BoundsNext(1) > 1000 || BoundsNext(-1) < 0) || BoundsCalls != 2 { return false }
    // The right call must still be skipped when the first predicate is true.
    if !(BoundsNext(1001) > 1000 || BoundsNext(-1) < 0) || BoundsCalls != 3 { return false }
    print("bounds % %\n", Outside64(1001), BoundsCalls)
    return true
}

// Repeated conditional float arguments need copies into several registers.
// A copy into XMM11 must leave its source available for later copies, even
// though XMM11 shares the general scratch register R11's number.
WeightedCoordinates :: (x: float32, y: float32, width: float32, height: float32,
    u0: float32, v0: float32, u1: float32, v1: float32) -> s32 {
    return cast(s32)(x + y + width + height + u0 * 2.0 + v0 * 3.0 + u1 * 5.0 + v1 * 7.0)
}
ConditionalCoordinates :: (x0: s32, y0: s32, x1: s32, y1: s32, side: s32,
    u0: float32, v0: float32, u1: float32, v1: float32) -> s32 {
    total: s32
    for corner: cast(s32)0..3 {
        right := (corner & 1) != 0
        bottom := corner >= 2
        left := ifx right then x1 - side else x0
        top := ifx bottom then y1 - side else y0
        total += WeightedCoordinates(cast(float32)left, cast(float32)top,
            cast(float32)(left + side), cast(float32)(top + side),
            ifx right then u1 else u0, ifx bottom then v1 else v0,
            ifx right then u0 else u1, ifx bottom then v0 else v1)
    }
    return total
}

main :: () -> s32 {
    if !BoundsCases() { return 1 }
    if ConditionalCoordinates(10, 20, 80, 90, 4, 1.0, 2.0, 3.0, 4.0) != 976 { return 1 }
    points: [4]Point
    for i: 0..3 { points[i] = Point.{x = i, y = 10 * i} }

    // A record read, then its source changed, then the record used.
    kept := points[1]
    points[1].x = 99
    print("% %\n", kept.x, points[1].x)

    // Changed and put back where it came from, with the source read before
    // it goes back.
    moved := points[2]
    moved.y = 7
    before := points[2].y
    points[2] = moved
    print("% % %\n", before, points[2].y, moved.y)

    // Put back somewhere else.
    copied := points[0]
    copied.x = 55
    points[3] = copied
    print("% % %\n", points[0].x, points[3].x, points[3].y)

    // Members updated in place in a loop.
    for round: 0..9 {
        for i: 0..3 {
            points[i].x += points[i].y
            points[i].y -= 1
        }
    }
    total: s64
    for i: 0..3 { total += points[i].x * 3 + points[i].y }
    print("%\n", total)

    // Records inside records, an array inside a record.
    pairs: [2]Pair
    pairs[0].left.x = 1
    pairs[0].right.y = 2
    pairs[0].tags[1] = 3
    pairs[1] = pairs[0]
    pairs[1].tags[1] += 40
    inner := pairs[1].left
    pairs[1].left.x = 8
    print("% % % % %\n", pairs[0].tags[1], pairs[1].tags[1], inner.x, pairs[1].left.x, pairs[1].right.y)

    // A read used in another block.
    seen := points[1]
    if seen.x > 0 { points[1].x = 0 }
    print("% %\n", seen.x, points[1].x)

    // Record results through direct and indirect calls.
    bounds := Box.{10.0, 20.0, 220.0, 40.0}
    framed := Frame(bounds, 12, 0, 14, 14, 10, 4, Guard(1))
    constant := Frame(bounds, 12, 0, 14, 14, 10, 4, 1)
    print("% % % % % % %\n", framed.clip.x, framed.clip.y, framed.clip.height, framed.left,
        framed.height, constant.clip.y, constant.clip.height)
    holder: Holder
    mover: Mover = Moved
    holder.move = mover
    holder.point = Point.{x = 5, y = 6}
    holder.point = holder.move(holder.point, 30)
    print("% %\n", holder.point.x, holder.point.y)
    return 0
}
