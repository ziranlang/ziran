// Long array literals and large locals, pinned by tests/zx_lowered_parity.sh.
// A literal of 64 or more numeric literals is read-only data decoded by one
// loop, and a fixed-array or record local or parameter of more than 4096
// bytes lives in a frame slot, so a loop over it does not copy it on every
// iteration.
Grid :: struct { cells: [600]s64; total: s64 }

table: [64]s32 = .[
    -31000, -30000, -29000, -28000, -27000, -26000, -25000, -24000, -23000, -22000, -21000, -20000, -19000, -18000, -17000, -16000,
    -15000, -14000, -13000, -12000, -11000, -10000, -9000, -8000, -7000, -6000, -5000, -4000, -3000, -2000, -1000, 0,
    1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000, 10000, 11000, 12000, 13000, 14000, 15000, 16000,
    17000, 18000, 19000, 20000, 21000, 22000, 23000, 24000, 25000, 26000, 27000, 28000, 29000, 30000, 31000, 32000
];

Sum16 :: (values: [64]s16) -> s64 {
    total: s64
    for i: 0..63 { total += cast(s64)values[i] * cast(s64)(i + 1) }
    return total
}

Total :: (cells: [600]s64) -> s64 {
    total: s64
    for i: 0..599 { total += cells[i] * cast(s64)(i % 5) }
    return total
}

Fill :: (grid: Grid) -> Grid {
    for i: 0..599 {
        grid.cells[i] = cast(s64)i * 3
        grid.total += grid.cells[i]
    }
    return grid
}

main :: () -> s32 {
    words: [64]s16 = .[
        -105, -68, -31, 6, 43, 80, -94, -57, -20, 17, 54, 91, -83, -46, -9, 28,
        65, 102, -72, -35, 2, 39, 76, -98, -61, -24, 13, 50, 87, -87, -50, -13,
        24, 61, 98, -76, -39, -2, 35, 72, -102, -65, -28, 9, 46, 83, -91, -54,
        -17, 20, 57, 94, -80, -43, -6, 31, 68, 105, -69, -32, 5, 42, 79, -95
    ]
    small: [64]s8 = .[
        -100, -71, -42, -13, 16, 45, 74, -97, -68, -39, -10, 19, 48, 77, -94, -65,
        -36, -7, 22, 51, 80, -91, -62, -33, -4, 25, 54, 83, -88, -59, -30, -1,
        28, 57, 86, -85, -56, -27, 2, 31, 60, 89, -82, -53, -24, 5, 34, 63,
        92, -79, -50, -21, 8, 37, 66, 95, -76, -47, -18, 11, 40, 69, 98, -73
    ]
    bytes: [64]u8 = .[
        0, 53, 106, 159, 212, 9, 62, 115, 168, 221, 18, 71, 124, 177, 230, 27,
        80, 133, 186, 239, 36, 89, 142, 195, 248, 45, 98, 151, 204, 1, 54, 107,
        160, 213, 10, 63, 116, 169, 222, 19, 72, 125, 178, 231, 28, 81, 134, 187,
        240, 37, 90, 143, 196, 249, 46, 99, 152, 205, 2, 55, 108, 161, 214, 11
    ]
    reals: [64]float32 = .[
        -6.25, 1.25, -5.25, 2.25, -4.25, 3.25, -3.25, 4.25, -2.25, 5.25, -1.25, 6.25, 0.25, -6.25, 1.25, -5.25,
        2.25, -4.25, 3.25, -3.25, 4.25, -2.25, 5.25, -1.25, 6.25, 0.25, -6.25, 1.25, -5.25, 2.25, -4.25, 3.25,
        -3.25, 4.25, -2.25, 5.25, -1.25, 6.25, 0.25, -6.25, 1.25, -5.25, 2.25, -4.25, 3.25, -3.25, 4.25, -2.25,
        5.25, -1.25, 6.25, 0.25, -6.25, 1.25, -5.25, 2.25, -4.25, 3.25, -3.25, 4.25, -2.25, 5.25, -1.25, 6.25
    ]
    narrow: s64
    wide: u64
    real: float32
    for i: 0..63 {
        narrow += cast(s64)small[i] * cast(s64)i
        wide += cast(u64)bytes[i] * cast(u64)(i + 1)
        real += reals[i]
    }
    grid: Grid
    grid = Fill(grid)
    big: [600]s64
    for i: 0..599 { big[i] = grid.cells[i] + cast(s64)i }
    print("tables % % % % % % % %\n", Sum16(words), narrow, wide, real, table[0], table[63], grid.total,
        Total(big))
    return cast(s32)(grid.cells[47] - 99)
}
