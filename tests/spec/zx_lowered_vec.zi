// Owned vectors on revision-28 ZX, pinned by tests/zx_lowered_parity_cases.zi:
// growth, indexing, slices, VecClear and VecFree, and the drops at block
// close, return, break and continue.
#import "std/vec"

Pair :: struct { key: s32; value: s64 }

Fill :: (bytes: []u8) -> s64 {
    total: s64
    for byte: bytes { total += byte }
    return total
}

Rounds :: (limit: s32) -> s64 {
    total: s64
    for round: 0..limit - 1 {
        scratch: Vec(u8)
        for i: 0..round { VecPush(scratch, cast(u8)(i + round)) }
        if round == 3 { continue }
        if round == 6 { break }
        total += Fill(scratch[:]) + scratch.capacity
    }
    return total
}

Early :: (stop: bool) -> s64 {
    kept: Vec(s64)
    VecPush(kept, 5)
    VecPush(kept, 6)
    if stop { return kept[0] }
    total := kept[1] + kept.count
    VecFree(kept)
    return total
}

Header :: struct { count: s64; capacity: s64 }

// Both the reserved path and several growth edges keep the live scalar
// accumulator and the header correct. A returned snapshot must survive the
// later count/capacity updates, and the owned vector escapes through a call.
Remember :: (values: []s64, capacity: s64) -> Header {
    return .{values.count, capacity}
}

Consume :: (values: Vec(s64), expected: s64) -> bool {
    total: s64
    for i: 0..values.count - 1 { total += values[i] }
    return total == expected
}

ScalarGrowth :: (count: s64, reserve: bool) -> bool {
    values: Vec(s64)
    if reserve && !VecReserve(values, count) { return false }
    saved := Remember(values[:], values.capacity)
    total: s64
    for i: 0..count - 1 {
        value := i * 3 - 7
        if !VecPush(values, value) { return false }
        total += value
    }
    if values.count != count || values.capacity < count || saved.count != 0 { return false }
    if reserve && values.capacity != saved.capacity { return false }
    if !reserve && saved.capacity != 0 { return false }
    return Consume(values, total)
}

main :: () -> s32 {
    for count: s64.[0, 1, 8, 9, 16, 17, 65, 1000] {
        if !ScalarGrowth(count, false) || !ScalarGrowth(count, true) { return 2 }
    }
    pairs: Vec(Pair)
    for i: 0..19 { VecPush(pairs, Pair.{cast(s32)i, cast(s64)i * i}) }
    pairs[3].value = 1000
    sum: s64
    for pair: pairs[:] { sum += pair.value + pair.key }
    big: Vec(s32)
    for i: 0..999 { if !VecPush(big, cast(s32)i) { return 1 } }
    print("pairs % % % cap %\n", pairs.count, sum, pairs[19].value, pairs.capacity)
    print("rounds % early % %\n", Rounds(8), Early(true), Early(false))
    print("big % % %\n", big.count, big[999], big.capacity)
    VecClear(big)
    return cast(s32)big.count + 7
}
