// Fixture for the wasm execution tier: integers of every width with
// their wrapping rules, unsigned shifts and masks, float casts,
// recursion, compound assignment, break and continue, else-if chains,
// logical operators, a conditional expression, and records and fixed
// arrays with value copies, literals, member and index places.
// The instruction engine and the wasm module must agree on the result.

using Vectors :: #import "vec"

Fib :: (n: s32) -> s64 {
    if n < 2 { return cast(s64)n }
    return Fib(n - 1) + Fib(n - 2)
}

Mix :: (a: s64, scale: s32) -> s64 {
    return (a * cast(s64)scale + 7) / 7
}

Point :: struct {
    x: s32
    y: s32
}

MixPoints :: (left: Point, right: Point) -> Point {
    return Point.{x = left.x + right.y, y = left.y + right.x}
}

Pair :: struct {
    a: Point
    tag: u8
}

ConstructorViews :: () -> bool {
    partial := Point.{x = 17}
    snapshot := partial
    partial.x = 31
    swapped := Point.{x = snapshot.y, y = snapshot.x}
    nested := Pair.{a = Point.{x = swapped.y, y = 23}, tag = 5}
    return partial.x == 31 && partial.y == 0 && snapshot.x == 17 && snapshot.y == 0 &&
           swapped.x == 0 && nested.a.x == 17 && nested.a.y == 23 && nested.tag == 5
}

// Members built where their parent keeps them: call results, nested
// constructors and returned values. A member that reads the parent it
// replaces, or a call given the parent, must still see the old contents.
Layer :: struct { offset: float32; blur: float32; spread: float32; alpha: float32 }
Layers :: struct { rest: Layer; raised: [2]Layer }
Tokens :: struct { dark: bool; layers: Layers; corner: Pair; series: [3]u32 }
member_tokens: Tokens;
member_ready: bool;
MakeLayers :: (dark: bool) -> Layers {
    layers: Layers
    layers.rest = Layer.{1.0, 2.0, 0.0, 0.25}
    if dark { layers.raised[0] = Layer.{8.0, 22.0, 0.0, 0.5} }
    else { layers.raised[1] = Layer.{6.0, 18.0, 0.0, 0.75} }
    return layers
}
MakeCorner :: (seed: Pair) -> Pair { return Pair.{a = Point.{x = seed.a.y, y = seed.a.x}, tag = seed.tag + 1} }
MakeTokens :: (dark: bool) -> Tokens {
    tokens: Tokens
    tokens.dark = dark
    tokens.layers = MakeLayers(dark)
    tokens.corner = MakeCorner(Pair.{a = Point.{x = 3, y = 4}, tag = 6})
    tokens.series = .{cast(u32)7, cast(u32)8, cast(u32)9}
    return tokens
}
CurrentTokens :: () -> Tokens {
    if !member_ready { return MakeTokens(false) }
    return member_tokens
}
MemberPlaces :: () -> bool {
    first := CurrentTokens()
    if first.dark || first.layers.rest.alpha != 0.25 || first.layers.raised[1].blur != 18.0 ||
       first.layers.raised[0].blur != 0.0 || first.corner.a.x != 4 || first.corner.a.y != 3 ||
       first.corner.tag != 7 || first.series[2] != 9 { return false }
    member_tokens = MakeTokens(true)
    member_ready = true
    second := CurrentTokens()
    if !second.dark || second.layers.raised[0].alpha != 0.5 || second.layers.raised[1].alpha != 0.0 { return false }
    // The replacement reads the member it replaces.
    second.corner = MakeCorner(second.corner)
    if second.corner.a.x != 3 || second.corner.a.y != 4 || second.corner.tag != 8 { return false }
    second.corner = Pair.{a = Point.{x = second.corner.a.y, y = second.corner.a.x}, tag = second.corner.tag}
    if second.corner.a.x != 4 || second.corner.a.y != 3 || second.corner.tag != 8 { return false }
    second.layers.raised[1] = second.layers.raised[0]
    second.layers.raised[0] = Layer.{second.layers.raised[1].blur, second.layers.rest.blur, 1.0, 0.125}
    if second.layers.raised[0].offset != 22.0 || second.layers.raised[0].blur != 2.0 ||
       second.layers.raised[1].offset != 8.0 { return false }
    // A parent made after its member, and also kept as a snapshot.
    inner := Point.{x = 5, y = 6}
    outer: Pair
    kept := outer
    outer.a = inner
    if outer.a.x != 5 || outer.a.y != 6 || kept.a.x != 0 || kept.a.y != 0 { return false }
    // Members chosen by a condition join in the block that stores them,
    // including one that reads the member it replaces.
    joined: Pair
    joined.a = ifx second.dark then MixPoints(inner, outer.a) else Point.{x = 1, y = 2}
    if joined.a.x != 11 || joined.a.y != 11 { return false }
    joined.a = ifx second.dark then MixPoints(joined.a, inner) else joined.a
    if joined.a.x != 17 || joined.a.y != 16 { return false }
    member_ready = false
    return member_tokens.dark && member_tokens.corner.tag == 7 && CurrentTokens().series[0] == 7
}

// Pointer-backed aggregate member reads must preserve snapshots across
// stores, calls, block edges and nested extracts. Independent pointers must
// retain distinct bases even when their aggregate frame slots coalesce.
FieldRecord :: struct { padding: [32768]s32; value: s32 }
field_left: FieldRecord;
field_right: FieldRecord;
FieldRead :: (record: *FieldRecord) -> s32 { return record.value }
FieldPair :: (left: *FieldRecord, right: *FieldRecord, index: s64) -> s32 {
    return left.padding[index] + right.padding[index] + left.value + right.value
}
FieldWrite :: () { field_left.value = 23 }
FieldByValue :: (record: FieldRecord) -> FieldRecord {
    record.value += 3
    return record
}
FieldNestedByValue :: (record: FieldRecord) -> s32 {
    record.padding[42] += 4
    return record.padding[42]
}
FieldObserve :: (record: FieldRecord, alias: *FieldRecord) -> s32 {
    alias.value = 29
    return record.value
}
FieldSnapshot :: (record: *FieldRecord, choose: bool) -> s32 {
    snapshot := <<record
    record.value = 19
    if choose { return snapshot.value }
    return snapshot.padding[42]
}
FieldContainer :: struct { before: s32; inner: FieldRecord; after: s32 }
field_container: FieldContainer;
PaddingWrite :: (record: *FieldRecord, value: s32) { record.padding[42] = value }
FieldLocalCopy :: (record: *FieldContainer) -> bool {
    local := record.inner
    PaddingWrite(*local, 13)
    return local.padding[42] == 13 && record.inner.padding[42] == 17
}
ReplaceRecord :: struct { before: s32; inner: Pair; after: s32 }
ReplaceEdges :: (record: *ReplaceRecord) {
    record.before = 37
    record.after = 43
}
ReplaceInner :: (record: *ReplaceRecord) -> Pair {
    ReplaceEdges(record)
    return Pair.{a = Point.{x = 13, y = 17}, tag = 5}
}
FieldReplace :: (record: *ReplaceRecord) -> s32 {
    snapshot := record.*
    snapshot.inner = ReplaceInner(record)
    return snapshot.before * 10000 + snapshot.after * 100 + snapshot.inner.a.x
}
ReadSavedTail :: (record: *ReplaceRecord) -> s32 {
    snapshot := record.*
    ReplaceEdges(record)
    return snapshot.after
}
FieldViews :: () -> bool {
    field_left.value = 7
    field_right.value = 5
    field_left.padding[42] = 3
    field_right.padding[42] = 10
    if FieldRead(*field_left) != 7 || FieldPair(*field_left, *field_right, 42) != 25 { return false }
    argument := field_left
    changed_parameter := FieldByValue(argument)
    if changed_parameter.value != 10 || argument.value != 7 || field_left.value != 7 { return false }
    if FieldNestedByValue(argument) != 7 || argument.padding[42] != 3 { return false }
    if FieldObserve(field_left, *field_left) != 7 || field_left.value != 29 { return false }
    field_left.value = 7
    snapshot := field_left
    nested := snapshot.padding
    field_left.padding[42] = 17
    if nested[42] != 3 { return false }
    call_snapshot := field_left
    FieldWrite()
    if call_snapshot.value != 7 || field_left.value != 23 { return false }
    if FieldSnapshot(*field_left, true) != 23 { return false }
    if FieldSnapshot(*field_left, false) != 17 { return false }
    field_container.inner.padding[42] = 17
    if !FieldLocalCopy(*field_container) { return false }
    record := ReplaceRecord.{before = 31, inner = Pair.{a = Point.{x = 7}}, after = 41}
    if FieldReplace(*record) != 314113 || record.before != 37 || record.after != 43 || record.inner.a.x != 7 { return false }
    record.after = 41
    if ReadSavedTail(*record) != 41 || record.after != 43 { return false }
    changed := field_left
    changed.padding[42] = 31
    return changed.padding[42] == 31 && field_left.padding[42] == 17
}

clear_vectors: [2]Vec(s32);
VectorMemberStores :: () -> bool {
    VecClear(clear_vectors[0])
    VecClear(clear_vectors[1])
    if !VecPush(clear_vectors[0], cast(s32)31) || !VecPush(clear_vectors[1], cast(s32)17) { return false }
    capacity := clear_vectors[0].capacity
    VecClear(clear_vectors[0])
    return clear_vectors[0].count == 0 && clear_vectors[0].capacity == capacity &&
        clear_vectors[1].count == 1 && clear_vectors[1][0] == 17
}

// Zeroed records are written as zero runs, or filled past 320 bytes; a
// zero member beside other members keeps their values.
ZeroBlock :: struct { length: s32; bytes: [40]u8 }
ZeroLarge :: struct { tag: s32; bytes: [400]u8 }
ZeroMixed :: struct { first: s32; middle: s64; flag: bool; inner: Point; last: s32 }
zero_blocks: Vec(ZeroBlock);
zero_large: Vec(ZeroLarge);
ZeroMixedAt :: (middle: s64) -> ZeroMixed { return ZeroMixed.{middle = middle, last = 3} }
ZeroRecords :: () -> bool {
    VecClear(zero_blocks)
    VecClear(zero_large)
    for round: 0..2 {
        extra: ZeroBlock
        if !VecPush(zero_blocks, extra) { return false }
        zero_blocks[round].bytes[39] = cast(u8)(round + 7)
        zero_blocks[round].length = cast(s32)round + 1
        large: ZeroLarge
        if !VecPush(zero_large, large) { return false }
        zero_large[round].bytes[399] = cast(u8)(round + 9)
    }
    mixed := ZeroMixedAt(5)
    kept: ZeroBlock
    kept.bytes[1] = 4
    kept = ZeroBlock.{}
    return zero_blocks[1].bytes[39] == 8 && zero_blocks[2].length == 3 && zero_blocks[2].bytes[0] == 0 &&
        zero_large[2].bytes[399] == 11 && zero_large[1].tag == 0 && zero_large[1].bytes[0] == 0 &&
        mixed.first == 0 && mixed.middle == 5 && !mixed.flag && mixed.inner.y == 0 && mixed.last == 3 &&
        kept.bytes[1] == 0
}

// Ten snapshots of a 1 MB global, each read in place for one field, reserve
// no frame: only slots a lowered value still uses are packed into it.
FrameRecord :: struct { level: s32; data: [1000000]u8; tail: s32 }
FramePair :: struct { a: s64; b: s64 }
frame_record: FrameRecord;
frame_bumps: s64;
FrameBump :: () { frame_bumps += 1 }
FrameSum :: (pair: FramePair, depth: s32) -> s64 {
    if depth > 0 { return FrameSum(pair, depth - 1) }
    return pair.a + pair.b
}
FrameReads :: () -> bool {
    frame_record.level = 3
    frame_bumps = 0
    total: s64 = 0
    if frame_record.level == 3 { total += 1 }
    FrameBump()
    if frame_record.level == 3 { total += 1 }
    FrameBump()
    if frame_record.level == 3 { total += 1 }
    FrameBump()
    if frame_record.level == 3 { total += 1 }
    FrameBump()
    if frame_record.level == 3 { total += 1 }
    FrameBump()
    if frame_record.level == 3 { total += 1 }
    FrameBump()
    if frame_record.level == 3 { total += 1 }
    FrameBump()
    if frame_record.level == 3 { total += 1 }
    FrameBump()
    if frame_record.level == 3 { total += 1 }
    FrameBump()
    if frame_record.level == 3 { total += 1 }
    FrameBump()
    pair := FramePair.{a = total, b = frame_bumps}
    return FrameSum(pair, 2) == 20 && frame_record.tail == 0
}

#program_export
Answer :: () -> s64 {
    if !FieldViews() || !ConstructorViews() || !MemberPlaces() || !VectorMemberStores() || !ZeroRecords() || !FrameReads() { return -1 }
    total: s64 = 0

    u: u16 = 65535
    u += 3
    total += cast(s64)u

    s: s8 = 127
    s += 1
    total += cast(s64)s

    big: u64 = 1
    big = big << 40
    big |= 255
    total += cast(s64)(big & 255)

    f: float64 = 2.75
    total += cast(s64)(f * 2.0)

    for k: 0..10 {
        if k == 3 { continue }
        if k == 8 { break }
        total += cast(s64)k
    }

    total += Fib(20)
    total += Mix(100, 3)

    flag: bool = true
    negate: bool = !flag
    if flag && !negate { total += 1000 }
    else if negate { total += 2000 }
    else { total += 3000 }

    shifted: s32 = 1
    shifted <<= 10
    total += cast(s64)shifted

    negative: s64 = -5
    total += -negative

    total += ifx 0 == 1 then 7 else 11

    points: [4]Point
    points[0] = Point.{x = 3, y = 4}
    points[1] = MixPoints(points[0], points[0])
    pair: Pair
    pair.a = points[1]
    pair.tag = 9
    for k: 0..3 {
        total += cast(s64)points[k].x + cast(s64)points[k].y
    }
    total += cast(s64)pair.a.x * cast(s64)pair.tag
    return total
}
