#import "native_test"
#import "check_support"
#import "std/byte_text_linux"
#import "std/json_document"
#import "std/text_tools"
using Vectors :: #import "std/vec"

MutationFixture :: (test: *NativeTest, name: string) -> string { return NativeRead(test, CheckPath(test.repo, CheckConcat("tests/fixtures/text_call_mutation/", name))) }

MutationTests :: (test: *NativeTest) -> bool {
    fixtures: JsonDocument
    if !NativeAssert(test, JsonRead(*fixtures, MutationFixture(test, "negative.json")) && JsonCount(*fixtures, fixtures.root) == 15, "invalid text mutation rejection fixtures") { return false }
    node := MutationFixture(test, "node.zi.in"); item := JsonFirst(*fixtures, fixtures.root)
    while item >= 0 {
        name := TextDetach(JsonKey(*fixtures, item)); source := CheckPath(test.work, CheckConcat(name, ".zi"))
        if !NativeWrite(test, source, CheckConcat(node, CheckConcat(JsonString(*fixtures, item), "\n"))) { return false }
        command := string.[test.ziran, "check", "--diagnostics=json", "--root", test.work, source]; result := NativeInvoke(test, command[:], "", 30000); lines := TextLines(TextTrimEnd(result.error))
        if !NativeAssert(test, result.code > 0 && result.code < 124 && lines.count > 0, CheckConcat("unsafe text mutation was accepted or failed without diagnostics: ", name)) { return false }
        found := false
        for line: lines {
            document: JsonDocument
            if !NativeAssert(test, JsonRead(*document, line), "malformed text mutation diagnostic") { return false }
            if CheckField(*document, document.root, "code") == "check.slice_lifetime" && TextContains(CheckField(*document, document.root, "message"), "mutating text backing storage") { found = true }
        }
        if !NativeAssert(test, found, CheckConcat("wrong unsafe text mutation rejection: ", name)) { return false }
        item = JsonNext(*fixtures, item)
    }
    source := CheckPath(test.work, "safe.zi")
    ir := CheckPath(test.work, "safe-ir")
    if !NativeWrite(test, source, MutationFixture(test, "safe.zi.in")) { return false }
    save := string.[test.ziran, "ir", "--root", test.work, "-o", ir, source]
    unused NativeRun(test, save[:])
    for form: 0..1 {
        input := ifx form == 0 then source else CheckPath(ir, "safe.zir")
        if test.failed { return false }
        output := CheckPath(test.work, ifx form == 0 then "c-source" else "c-saved")
        build := string.[test.ziran, "build", "--target=c", "--no-main", "--root", test.work, "-o", output, input]
        unused NativeRun(test, build[:])
        if !NativeWrite(test, CheckPath(output, "main.c"), "#include \"safe.h\"\nint main(void) { return Answer() == 42 ? 0 : 1; }\n") { return false }
        command: Vec(string)
        if !NativeWords(NativeCompiler(), *command) { return false }
        flags := string.["-std=c11", CheckConcat("-I", CheckPath(test.repo, "include")), CheckConcat("-I", output)]
        for flag: flags { VecPush(command, flag) }
        files := NativeFiles(output, ".c")
        for file: files { VecPush(command, file) }
        VecPush(command, "-o")
        VecPush(command, CheckPath(output, "test"))
        VecPush(command, "-lm")
        unused NativeRun(test, command[:])
        execute := string.[CheckPath(output, "test")]
        unused NativeRun(test, execute[:])
        if test.failed { return false }
        bundle := CheckPath(test.work, ifx form == 0 then "source.zx" else "saved.zx")
        encode := string.[test.ziran, "bundle", "--root", test.work, "--entry", "safe:Answer", "-o", bundle, input]
        unused NativeRun(test, encode[:])
    }
    source_bundle := CheckPath(test.work, "source.zx")
    if test.failed || !NativeAssert(test, NativeSameFile(source_bundle, CheckPath(test.work, "saved.zx")), "source and saved IR changed the borrow-safe portable program") { return false }
    run := string.[test.ziran, "run", source_bundle]
    if !NativeExpect(test, run[:], "42\n") { return false }
    print("text mutation: 15 unsafe aliases rejected; descriptor copies, siblings and identity callbacks execute from source and saved IR in local tests\n")
    return true
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "text-call-mutation-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    return ifx MutationTests(*test) && !test.failed then 0 else 1
}
