#import "native_test"
#import "check_support"
#import "std/byte_text_linux"
#import "std/environment_linux"
#import "std/file_tree_linux"
#import "std/json_document"
#import "std/text_tools"
using Vectors :: #import "std/vec"

ToolDiagnostics :: (test: *NativeTest, arguments: []string, code: string) -> JsonDocument {
    result := NativeInvoke(test, arguments, "", 30000)
    if !NativeAssert(test, result.code > 0 && result.code <= 127 && result.code != 124, CheckConcat("diagnostic command unexpectedly succeeded, timed out or crashed: ", TextDetach(TextJoin(arguments, " ")))) { return .{} }
    records: JsonDocument; records.root = JsonNewArray(*records); found := false; lines := TextLines(result.error)
    if !NativeAssert(test, lines.count > 0, "diagnostic tool emitted no JSON") { return .{} }
    for line: lines {
        item: JsonDocument
        if !NativeAssert(test, JsonRead(*item, line) && CheckInteger(*item, item.root, "schema_version") == 2 &&
            (CheckField(*item, item.root, "severity") == "error" || CheckField(*item, item.root, "severity") == "warning") &&
            JsonKindOf(*item, JsonMember(*item, item.root, "code")) == .String && JsonKindOf(*item, JsonMember(*item, item.root, "message")) == .String, "diagnostic tool violated JSON schema") { return .{} }
        fields := string.["path", "line", "column", "end_line", "end_column"]
        for field: fields { if !NativeAssert(test, JsonMember(*item, item.root, field) >= 0, "diagnostic tool omitted source coordinates") { return .{} } }
        found = found || CheckField(*item, item.root, "code") == code
        JsonAppend(*records, records.root, JsonCopy(*records, *item, item.root))
    }
    if !NativeAssert(test, found, CheckConcat("missing tool diagnostic code: ", CheckConcat(code, CheckConcat("\n", result.error)))) { return .{} }
    return records
}

// Ordinary declarations exercise every table; defaults create real helpers.
ToolDeclarationNames :: (test: *NativeTest) -> bool {
    source := CheckPath(test.work, "names.zi")
    ordinary := "Byte :: 3\nCText: s32 = 4;\nRecordPath :: struct { value: s32 }\nText :: #import \"std/text\";\nSetBlocks :: (value: s32 = 5) -> s32 { return value }\n#program_export\nAnswer :: () -> s32 { path: RecordPath = .{value = 9}; return Byte + CText + path.value + SetBlocks() }\n"
    if !NativeWrite(test, source, ordinary) { return false }
    check := string.[test.ziran, "check", "--root", test.work, source]
    unused NativeRun(test, check[:])
    if test.failed { return false }
    declarations := string.[
        "zi_default_helper :: () -> s32 { return 1 }",
        "zi_default_value :: 3",
        "zi_default_count: s32 = 4;",
        "zi_default_point :: struct { x: s32 }",
        "zi_default_lib :: #import \"std/text\";",
        "zi_default_0123456789abcde :: 3",
        "zi_default_0123456789abcdeg :: 3",
        "zi_default_0123456789abcdef_field_ :: 3",
        "zi_default_0123456789abcdef_field_x :: 3",
        "zi_default_0123456789abcdef_extra :: 3",
    ]
    for declaration: declarations {
        if !NativeWrite(test, source, CheckConcat(declaration, "\n#program_export\nAnswer :: () -> s32 { return 0 }\n")) { return false }
        command := string.[test.ziran, "check", "--diagnostics=json", "--root", test.work, source]
        unused ToolDiagnostics(test, command[:], "check.reserved_name")
        if test.failed { return false }
    }
    return true
}

// Habits from other languages: each gives exactly one error naming the
// Ziran spelling, with no cascade through names the compiler generated.
AuthoringHint :: struct { source: string; message: string; }


AUTHORING_HINT_COUNT :: 20;

authoring_hints: [AUTHORING_HINT_COUNT]AuthoringHint = .[
    .{"let x = 1;\nmain :: () -> s32 { return 0 }\n", "let is not Ziran syntax; declare a local with name := value"},
    .{"fn main() { }\n", "fn is not Ziran syntax; declare a procedure with Name :: (a: s32) -> s32"},
    .{"func main() { }\n", "func is not Ziran syntax"},
    .{"def main():\n    return 0\n", "def is not Ziran syntax"},
    .{"function main() { return 0; }\n", "function is not Ziran syntax"},
    .{"const LIMIT = 3;\nmain :: () -> s32 { return 0 }\n", "const is not Ziran syntax; declare a constant with NAME"},
    .{"main :: () -> s32 {\n    var y = 1\n    return 0\n}\n", "var is not Ziran syntax"},
    .{"main :: () -> s32 { n := 3; for i in 0..n { print(\"%\", i) } return 0 }\n", "for ... in is not Ziran syntax; write for i: first..last"},
    .{"main :: () -> s32 { x := 0; for (i := 0; i < 3; i += 1) { x += i } return 0 }\n", "C-style for (;;) is not Ziran syntax"},
    .{"main :: () -> s32 { x: s64 = 1; p := *x; *p = 6; return 0 }\n", "store through a pointer with <<p = value"},
    .{"main :: () -> s32 { x := 1; switch x { case 1: return 1 } return 0 }\n", "use if value == { case ... }"},
    .{"main :: () -> s32 { s := \"hello\"; n := s.len(); return 0 }\n", "have .count, and Ziran has no methods"},
    .{"main :: () -> s32 { v: Vec(s64); n := v.len(); return 0 }\n", "have .count, and Ziran has no methods"},
    .{"main :: () -> s32 { print(\"%s\\n\", \"x\"); return 0 }\n", "print format uses a C or Go conversion such as %d or %s"},
    .{"main :: () -> s32 { out: Vec(u8); BuilderPrint(*out, \"%d items\\n\", 7); return 0 }\n", "BuilderPrint format uses a C or Go conversion"},
    .{"#import \"std/text_tools\"\nmain :: () -> s32 { s := TextLines(\"a b\")[0:1]; return cast(s32)s.count }\n", "a Vec returned by a call must be bound to a local before it is sliced"},
    .{"#import \"std/text_tools\"\nmain :: () -> s32 { t := TextLins(\"a b\"); return 0 }\n", "unresolved function: TextLins (did you mean TextLines?)"},
    .{"main :: () -> s32 { parts := TextSplit(\"a,b\", \",\"); return cast(s32)parts.count }\n", "add #import \"std/text_tools\""},
    .{"#import \"std/text_tools\"\nmain :: () -> s32 { f := TextFind(\"abc\"); return 0 }\n", "it takes (text: string, needle: string, from: s64 = 0)"},
    .{"main :: () -> s32 { x: s64 = 1; p := *x; <<p; return 0 }\n", "reading through a pointer alone does nothing; store with <<p = value"},
];

ToolAuthoringHints :: (test: *NativeTest) -> bool {
    source := CheckPath(test.work, "hint.zi")
    for hint: authoring_hints[:] {
        if !NativeWrite(test, source, hint.source) { return false }
        command := string.[test.ziran, "check", "--root", test.work, source]
        result := NativeInvoke(test, command[:])
        lines := TextLines(result.error)
        errors: s64 = 0
        // Each error starts a "hint.zi:LINE:COLUMN:" line; the source line,
        // caret, expected and fix lines below it are part of that error.
        for line: lines { if TextHasPrefix(line, "hint.zi:") { errors += 1 } }
        if !NativeAssert(test, result.code == 1 && errors == 1 && TextContains(result.error, hint.message),
            CheckConcat(CheckConcat("authoring hint is missing or cascades for:\n", hint.source), result.error)) { return false }
    }
    // The JSON form carries the suggestion as an edit.
    if !NativeWrite(test, source, "#import \"std/text_tools\"\nmain :: () -> s32 { t := TextLins(\"a b\"); return 0 }\n") { return false }
    json := string.[test.ziran, "check", "--diagnostics=json", "--root", test.work, source]
    records := ToolDiagnostics(test, json[:], "check.type")
    if test.failed || !NativeAssert(test, CheckField(*records, JsonElement(*records, records.root, 0), "suggested_name") == "TextLines",
        "an imported procedure was not suggested for a misspelled call") { return false }
    // Ziran spellings that look similar stay valid.
    valid := "#import \"std/text_tools\"\nmain :: () -> s32 {\n    fn := 3\n    total := 0\n    for i: 0..fn { total += i }\n    for TextLines(\"a\\nb\") { total += it.count }\n    for word, at: TextSplit(\"x y\", \" \") { total += word.count + at }\n    print(\"100%% %days\\n\", total)\n    print(\"% (%s%)\\n\", 1, 2, 3)\n    print(\"v%.4s %x%\\n\", 1, 2, 3)\n    return 0\n}\n"
    if !NativeWrite(test, source, valid) { return false }
    // One file without --root checks with its folder as the root.
    check := string.[test.ziran, "check", source]
    unused NativeRun(test, check[:])
    if test.failed { return false }
    // --lint names a constant -1 divisor; the program still checks.
    if !NativeWrite(test, source, "main :: () -> s32 { x: s64 = 5; return cast(s32)(x / -1 + x % -1) }\n") { return false }
    lint := string.[test.ziran, "check", "--lint", "--root", test.work, source]
    linted := NativeInvoke(test, lint[:])
    return NativeAssert(test, linted.code == 0 && TextContains(linted.error, "dividing by -1 overflows") &&
        TextContains(linted.error, "% -1 is always 0"), CheckConcat("--lint missed a -1 divisor:\n", linted.error))
}

// Text mode shows the source line, a caret under the span and the fix; JSON
// keeps only its fields.
SourceGolden :: struct { source: string; text: string; }

ToolSourceExcerpts :: (test: *NativeTest) -> bool {
    goldens := SourceGolden.[
        .{"#import \"std/text_tools\"\nmain :: () -> s32 {\n    t := TextLins(\"a b\")\n    return 0\n}\n",
            "golden.zi:3:10: unresolved function: TextLins (did you mean TextLines?)\n        t := TextLins(\"a b\")\n             ^^^^^^^^\n  fix: replace TextLins with TextLines\n"},
        .{"main :: () -> s32 {\n    let x = 1\n    return 0\n}\n",
            "golden.zi:2:5: let is not Ziran syntax; declare a local with name := value or name: Type = value, a constant with NAME :: value;\n        let x = 1\n        ^\n"},
        .{"#import \"std/text_tools\"\nmain :: () -> s32 {\n\tt := TextLins(\"a b\")\n\treturn 0\n}\n",
            "golden.zi:3:7: unresolved function: TextLins (did you mean TextLines?)\n    \tt := TextLins(\"a b\")\n    \t     ^^^^^^^^\n  fix: replace TextLins with TextLines\n"},
    ]
    source := CheckPath(test.work, "golden.zi")
    for golden: goldens {
        if !NativeWrite(test, source, golden.source) { return false }
        text := string.[test.ziran, "check", "--root", test.work, source]
        result := NativeInvoke(test, text[:])
        if !NativeAssert(test, result.code == 1 && result.error == golden.text,
            CheckConcat(CheckConcat("text diagnostic changed; expected:\n", golden.text), CheckConcat("found:\n", result.error))) { return false }
        json := string.[test.ziran, "check", "--diagnostics=json", "--root", test.work, source]
        records := NativeInvoke(test, json[:])
        if !NativeAssert(test, !TextContains(records.error, "    ^") && !TextContains(records.error, "  fix: "),
            "JSON diagnostics gained the text-mode excerpt") { return false }
    }
    return true
}

// A program that passes ziran check also builds as strict ISO C and runs:
// empty literals, named constant array lengths, and fields or locals named
// like C keywords or predefined macros.
BuildCase :: struct { name: string; source: string; code: s32; }

ToolCheckBuildAgree :: (test: *NativeTest) -> bool {
    cases := BuildCase.[
        .{"empty_init", "Point :: struct { x: s32; y: s32; }\nHolder :: struct { values: [4]s32; p: Point; }\norigin: Point = .{};\nheld: Holder = .{};\nmain :: () -> s32 {\n    p: Point = .{}\n    a: [3]s32 = .{}\n    return p.x + a[0] + origin.x + held.p.y + 7\n}\n", 7},
        .{"const_length", "MONTHS :: 12;\ndays: [MONTHS]s32 = .[31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\nSecond :: (table: [12]s32) -> s32 { return table[1] }\nmain :: () -> s32 {\n    local: [MONTHS]s32 = days\n    return Second(local)\n}\n", 28},
        .{"for_call", "#import \"std/text_tools\"\nmain :: () -> s32 {\n    total: s64 = 0\n    for line: TextLines(\"ab\\ncde\") { total += line.count }\n    for < TextSplit(\"x,yz\", \",\") { total += it.count + it_index }\n    return cast(s32)total\n}\n", 9},
        .{"cast_constant", "LIMIT :: cast(s64)9223372036854775807;\nSMALL :: cast(u8)200;\nmain :: () -> s32 {\n    big: s64 = LIMIT\n    small: u8 = SMALL\n    return ifx big > 0 then cast(s32)small - 190 else 1\n}\n", 10},
        .{"owned_view", "Name :: () -> Text { return TextCopy(\"ada\") }\nmain :: () -> s32 {\n    name := Name()\n    view := TextView(name)\n    return cast(s32)view.count\n}\n", 3},
        .{"colon_text", "Pair :: struct { name: string; text: string; }\npairs: [2]Pair = .[\n    .{name = \"a\", text = \"NAME :: value;\"},\n    .{name = \"bc\", text = \"x\"},\n];\nmain :: () -> s32 { return cast(s32)(pairs[0].text.count + pairs[1].name.count) }\n", 16},
        .{"c_names", "Flags :: struct { bool: s32; signed: s32; unsigned: s32; true: s32; }\nmain :: () -> s32 {\n    f: Flags\n    f.bool = 1\n    f.unsigned = 2\n    linux := 3\n    unix := 4\n    return f.bool + f.signed + f.unsigned + cast(s32)(linux + unix)\n}\n", 10},
    ]
    for build: cases {
        source := CheckPath(test.work, CheckConcat(build.name, ".zi"))
        output := CheckPath(test.work, CheckConcat(build.name, "-c"))
        if !NativeWrite(test, source, build.source) { return false }
        check := string.[test.ziran, "check", "--root", test.work, source]
        unused NativeRun(test, check[:])
        emit := string.[test.ziran, "build", "--target=c", "--exe", "--entry", CheckConcat(build.name, ":main"), "--root", test.work, "-o", output, source]
        unused NativeRun(test, emit[:])
        if test.failed { return false }
        strict := string.[NativeCompiler(), "-std=c11", "-pedantic", "-Werror", "-fsyntax-only", CheckConcat("-I", CheckPath(test.repo, "include")),
            CheckConcat("-I", output), CheckPath(output, CheckConcat(build.name, ".c"))]
        unused NativeRun(test, strict[:])
        program := string.[CheckPath(output, build.name)]
        unused NativeRun(test, program[:], expected = build.code)
        if test.failed { return false }
    }
    return true
}

// ziran std --list names every standard module; ziran api lists the Vec
// operations the compiler implements under std/vec.
ToolDiscovery :: (test: *NativeTest) -> bool {
    listing := string.[test.ziran, "std", "--list", "--json"]
    result := NativeInvoke(test, listing[:])
    document: JsonDocument
    if !NativeAssert(test, result.code == 0 && JsonRead(*document, result.output), "ziran std --list --json is not JSON") { return false }
    modules := JsonMember(*document, document.root, "modules")
    files := NativeFiles(CheckPath(test.repo, "std"), ".zi")
    described: s64 = 0
    for index: cast(s32)0..JsonCount(*document, modules) - 1 {
        if CheckField(*document, JsonElement(*document, modules, index), "purpose") != "" { described += 1 }
    }
    if !NativeAssert(test, JsonCount(*document, modules) == files.count && described == files.count,
        "ziran std --list must name every std module with a one-line summary") { return false }
    source := CheckPath(test.work, "builtins.zi")
    if !NativeWrite(test, source, "main :: () -> s32 { v: Vec(s64); VecPush(v, 1); return 0 }\n") { return false }
    api := string.[test.ziran, "api", "--root", test.work, source]
    listed := NativeInvoke(test, api[:])
    return NativeAssert(test, listed.code == 0 && TextContains(listed.output, "builtin VecPush :: (values: Vec($T), value: T) -> bool") &&
        TextContains(listed.output, "builtin VecPop"), CheckConcat("ziran api omitted the Vec builtins:\n", listed.output))
}

ToolCases :: (test: *NativeTest) -> bool {
    if !ToolDeclarationNames(test) { return false }
    if !ToolAuthoringHints(test) || !ToolSourceExcerpts(test) || !ToolDiscovery(test) || !ToolCheckBuildAgree(test) { return false }
    binary := PathParent(test.ziran); tools := string.["zi2c", "zi2go", "zi2zir", "zi2zx", "zi-api", "zi-inspect", "zi-fmt", "zi-edit"]
    for tool: tools { command := string.[CheckPath(binary, tool), "--unknown", "--diagnostics=json"]; unused ToolDiagnostics(test, command[:], "command.arguments"); if test.failed { return false } }
    unknown := string.[test.ziran, "build", "--target=unknown", "--diagnostics=json"]; unused ToolDiagnostics(test, unknown[:], "package.command")
    check := string.[test.ziran, "check", "--diagnostics=json", "--root", test.work, CheckPath(test.work, "missing.zi")]; unused ToolDiagnostics(test, check[:], "module.input")
    verbs := string.["inspect", "run", "fmt"]; suffixes := string.["missing.zir", "missing.zx", "missing.zi"]; codes := string.["zir.input", "zx.input", "format.input"]
    for index: cast(s64)0..verbs.count - 1 {
        command := string.[test.ziran, verbs[index], "--diagnostics=json", CheckPath(test.work, suffixes[index])]; unused ToolDiagnostics(test, command[:], codes[index])
        if test.failed { return false }
    }
    raw_name := u8.[255, 46, 122, 105, 114]
    names := string.[TextDetach(TextCopy(TextFromBytes(raw_name[:]))), "文🙂.zir"]; expected := string.["ÿ.zir", "文🙂.zir"]
    for index: cast(s64)0..names.count - 1 {
        command := string.[test.ziran, "inspect", "--diagnostics=json", CheckPath(test.work, names[index])]
        diagnostics := ToolDiagnostics(test, command[:], "zir.input")
        if !NativeAssert(test, !test.failed && TextHasSuffix(CheckField(*diagnostics, JsonElement(*diagnostics, diagnostics.root, 0), "path"), expected[index]), "native byte or multilingual path was not valid JSON") { return false }
    }
    unformatted := CheckPath(test.work, "format.zi")
    if !NativeWrite(test, unformatted, "Answer::()->s32{return 42}\n") { return false }
    format := string.[test.ziran, "fmt", "--check", "--diagnostics=json", unformatted]; unused ToolDiagnostics(test, format[:], "format.changed")
    source := CheckPath(test.work, "native.zi"); string_entry := CheckPath(test.work, "text_entry.zi")
    if !NativeWrite(test, source, "#program_export\nAnswer :: () -> s32 { return 42 }\n") ||
        !NativeWrite(test, string_entry, "#program_export\nAnswer :: () -> string { return \"text\" }\n") { return false }
    entry := string.[test.ziran, "build", "--target=c", "--exe", "--entry", "text_entry:Answer", "--diagnostics=json", "--root", test.work, "-o", CheckPath(test.work, "string"), string_entry]
    unused ToolDiagnostics(test, entry[:], "zir_c.entry")
    // Enough programs for forked C emission workers, which text diagnostics
    // keep enabled. The build succeeds quietly and writes every module.
    modules: Vec(string)
    for index: cast(s64)0..47 {
        module := CheckPath(test.work, CheckConcat("emit/m", CheckConcat(CheckNumber(index), ".zi")))
        if !NativeWrite(test, module, "Read :: () -> s32 { return 1 }\n") { return false }
        VecPush(modules, module)
    }
    NativeSet(test, "ZIRAN_JOBS", "2")
    emit_output := CheckPath(test.work, "emit-c")
    emit := string.[test.ziran, "build", "--target=c", "--root", CheckPath(test.work, "emit"), "-o", emit_output]
    emit_command: Vec(string)
    for part: emit { VecPush(emit_command, part) }
    for module: modules { VecPush(emit_command, module) }
    emitted := NativeInvoke(test, emit_command[:])
    NativeUnset(test, "ZIRAN_JOBS")
    emitted_files := NativeFiles(emit_output, ".c")
    if !NativeAssert(test, emitted.code == 0 && emitted.error == "" && emitted_files.count >= modules.count,
        CheckConcat("forked C emission failed or wrote no modules:\n", emitted.error)) { return false }
    fixture_output := CheckPath(test.work, "fixture")
    fixture := string.[test.ziran, "build", "--target=c", "--exe", "--root", CheckPath(test.repo, "tests"), "--entry", "process_fixture:main", "-o", fixture_output, CheckPath(test.repo, "tests/process_fixture.zi")]
    unused NativeRun(test, fixture[:])
    fake := CheckPath(test.work, "cc")
    if !NativeWrite(test, fake, CheckConcat("#!/bin/sh\nexec ", CheckConcat(CheckQuote(CheckPath(fixture_output, "process_fixture")), " diagnostic-noise \"$@\"\n"))) { return false }
    chmod := string.["chmod", "700", fake]; unused NativeRun(test, chmod[:])
    original_cc := TextDetach(TextCopy(EnvironmentText("CC"))); NativeSet(test, "CC", fake)
    command := string.[test.ziran, "build", "--target=c", "--exe", "--entry", "native:Answer", "--diagnostics=json", "--root", test.work, "-o", CheckPath(test.work, "c"), source]
    diagnostics := ToolDiagnostics(test, command[:], "zir_c.toolchain"); truncated := false
    for index: cast(s32)0..JsonCount(*diagnostics, diagnostics.root) - 1 {
        item := JsonElement(*diagnostics, diagnostics.root, index); message := CheckField(*diagnostics, item, "message")
        truncated = truncated || TextContains(message, "文🙂") && TextContains(message, "ÿ") && JsonKindOf(*diagnostics, JsonMember(*diagnostics, JsonMember(*diagnostics, item, "truncation"), "message")) == .True
    }
    if !NativeAssert(test, truncated, "compiler diagnostics did not preserve multilingual/byte output and report truncation") { return false }
    NativeSet(test, "CC", CheckPath(test.work, "missing-cc")); unused ToolDiagnostics(test, command[:], "zir_c.toolchain")
    if original_cc == "" { NativeUnset(test, "CC") } else { NativeSet(test, "CC", original_cc) }
    launcher := CheckPath(test.work, "launcher")
    if !NativeAssert(test, CopyFileNew(test.ziran, launcher), "copy launcher fixture") { return false }
    launch := string.[launcher, "check", "--diagnostics=json", "--root", test.work, source]; unused ToolDiagnostics(test, launch[:], "package.process")
    probe := CheckPath(test.work, "diagnostic.c")
    if !NativeWrite(test, probe, NativeRead(test, CheckPath(test.repo, "tests/fixtures/tool_diagnostic.c"))) { return false }
    compile: Vec(string)
    flags := string.[NativeCompiler(), "-std=c11", CheckConcat("-I", CheckPath(test.repo, "include")), CheckConcat("-I", CheckPath(test.repo, "cmd/zir"))]
    for arg: flags { VecPush(compile, arg) }
    fixture_headers := string.["ir", "context_types", "parse_types", "parse_s14_types", "check_types", "text", "statement", "declaration", "source", "scan", "diagnostic"]
    for module: fixture_headers {
        VecPush(compile, CheckConcat("-I", CheckPath(test.repo, CheckConcat("bootstrap/compiler_", module))))
    }
    fixture_sources := string.["bootstrap/compiler_diagnostic/compiler_diagnostic.c", "cmd/zir/zir_diagnostic_host.c", "cmd/zir/zir_atomics.c", "cmd/zir/zir_memory.c"]
    for file: fixture_sources {
        VecPush(compile, CheckPath(test.repo, file))
    }
    probe_link_flags := string.[probe, "-o", CheckPath(test.work, "probe")]
    for arg: probe_link_flags { VecPush(compile, arg) }
    unused NativeRun(test, compile[:]);
    run := string.[CheckPath(test.work, "probe")]; memory := ToolDiagnostics(test, run[:], "compiler.memory")
    if !NativeAssert(test, !test.failed && JsonCount(*memory, memory.root) == 2 && TextHasPrefix(CheckField(*memory, JsonElement(*memory, memory.root, 0), "message"), "🙂ÿ"), "allocation-free OOM or malformed UTF-8 diagnostics changed") { return false }
    // A command that fails without a diagnostic still reports exactly one.
    silent := string.[CheckPath(test.work, "probe"), "silent"]; unreported := ToolDiagnostics(test, silent[:], "compiler.internal")
    if !NativeAssert(test, !test.failed && JsonCount(*unreported, unreported.root) == 1, "silent failure did not report exactly one diagnostic") { return false }
    worker := string.[CheckPath(test.work, "probe"), "worker"]; reported := NativeInvoke(test, worker[:])
    return NativeAssert(test, reported.code == 1 && reported.error == "", "a failure a worker already reported was reported twice")
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "tool-diagnostics-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    if !ToolCases(*test) { return 1 }
    print("Native tool diagnostics: authoring hints, source excerpts, check/build agreement, lint, std and builtin discovery, arguments, inputs, byte paths, forked C emission, bounded compiler output, silent failures and allocation-free OOM local tests passed\n")
    return 0
}
