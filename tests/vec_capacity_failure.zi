#import "vec"
host_api :: #system_library "host_api";
ArmAllocator :: (after: s64) #foreign host_api;
Item :: struct { bytes: Vec(u8); text: string; }

#program_export
Check :: () -> s32 {
    bytes: Vec(u8)
    if !VecResize(bytes, 4) { return -1 }
    bytes[0] = 71
    capacity := bytes.capacity
    ArmAllocator(0)
    if VecReserve(bytes, 128) { return -2 }
    ArmAllocator(0)
    if VecResize(bytes, 128) { return -3 }
    if bytes.count != 4 || bytes.capacity != capacity || bytes[0] != 71 { return -4 }
    items: Vec(Item)
    if !VecResize(items, 2) || !VecResize(items[0].bytes, 3) { return -5 }
    items[0].bytes[0] = 91
    old_capacity := items.capacity
    for fail_at: 1..3 {
        ArmAllocator(fail_at)
        if VecResize(items, 128) { return -6 }
        if items.count != 2 || items.capacity != old_capacity || items[0].bytes[0] != 91 { return -7 }
    }
    if !VecReserve(items, 128) { return -8 }
    for fail_at: 2..3 {
        ArmAllocator(fail_at)
        if VecResize(items, 128) { return -9 }
        if items.count != 2 || items.capacity != 128 || items[0].bytes[0] != 91 { return -10 }
    }
    if !VecResize(items, 3) || items[2].bytes.count != 0 || items[2].text.count != 0 { return -11 }
    return 42
}

#program_export
BoundedCheck :: () -> s32 {
    bytes: Vec(u8)
    if !VecResizeBounded(bytes, 4, 128) { return -1 }
    bytes[0] = 71
    capacity := bytes.capacity
    ArmAllocator(0)
    if VecReserve(bytes, 128) { return -2 }
    ArmAllocator(0)
    if VecResizeBounded(bytes, 128, 128) { return -3 }
    if bytes.count != 4 || bytes.capacity != capacity || bytes[0] != 71 { return -4 }
    items: Vec(Item)
    if !VecResizeBounded(items, 2, 128) || !VecResizeBounded(items[0].bytes, 3, 128) { return -5 }
    items[0].bytes[0] = 91
    old_capacity := items.capacity
    for fail_at: 1..3 {
        ArmAllocator(fail_at)
        if VecResizeBounded(items, 128, 128) { return -6 }
        if items.count != 2 || items.capacity != old_capacity || items[0].bytes[0] != 91 { return -7 }
    }
    if !VecReserve(items, 128) { return -8 }
    for fail_at: 2..3 {
        ArmAllocator(fail_at)
        if VecResizeBounded(items, 128, 128) { return -9 }
        if items.count != 2 || items.capacity != 128 || items[0].bytes[0] != 91 { return -10 }
    }
    if !VecResizeBounded(items, 3, 128) || items[2].bytes.count != 0 || items[2].text.count != 0 { return -11 }
    return 42
}
