// Revision-28 executable ZX parity. Each program lowers to revision-28 ZX
// (zi2asm --emit zx) and runs on the verified-instruction interpreter, and
// the C target runs it as an independent reference.
// Standard output must be identical and the interpreter's exit status must
// be the C program's. Programs expected to trap must trap on both. A bundle
// of the same source (zi2zx bundle, then zi2zx run) prints the interpreter's
// output and then the entry's result line.
// Native ELF output must run with the same status or stop at a named
// assembly.gap diagnostic. The wasm32 module from the same ZX must be
// reproducible and print the same output.
// The interpreter must end every program with no live heap block.
#import "native_test"
#import "check_support"
#import "std/file"
#import "std/text_tools"
#import "std/file_tree_linux"
using Vectors :: #import "std/vec"

ParityCase :: struct { root: string; entry: string; file: string; traps: bool }

ParityAdd :: (cases: *Vec(ParityCase), root: string, entry: string, file: string, traps: bool = false) {
    VecPush(<<cases, ParityCase.{root, entry, file, traps})
}


ParityRun :: (test: *NativeTest, tools: string, item: ParityCase, label: string, wasm_modules: *s64) {
    if test.failed { return }
    bundled := CheckPath(test.work, CheckConcat(label, ".bundle.zx"))
    lowered := CheckPath(test.work, CheckConcat(label, ".lowered.zx"))
    elf := CheckPath(test.work, CheckConcat(label, ".elf"))
    zi2zx := CheckPath(tools, "zi2zx")
    zi2asm := CheckPath(tools, "zi2asm")
    std := CheckPath(test.repo, "std")
    lower := string.[zi2asm, "--root", item.root, "-I", std, "--entry", item.entry,
        "--emit", "zx", "-o", lowered, item.file]
    unused NativeRun(test, lower[:])
    if test.failed { return }
    c_run := string.[test.ziran, "run", "--target=c", "--root", item.root, "--module-path", std,
        "--entry", item.entry, item.file]
    interpreter := string.[zi2asm, "--run", "--heap-report", "--work", "4000000000", "--fuel", "4000000000",
        "--frames", "100000", "--input", "zx", lowered]
    reference := NativeInvoke(test, c_run[:])
    actual := NativeInvoke(test, interpreter[:])
    if item.traps {
        unused NativeAssert(test, reference.code != 0 && actual.code == 125,
            CheckConcat(item.entry, ": an expected trap did not trap on both routes"))
        return
    }
    if !NativeAssert(test, actual.output == reference.output,
        CheckConcat(item.entry, CheckConcat(": interpreter output differs from C: ",
            actual.output[0:ifx actual.output.count > 400 then 400 else actual.output.count]))) { return }
    if !NativeAssert(test, actual.code == reference.code,
        CheckConcat(item.entry, CheckConcat(": interpreter status ", CheckConcat(CheckNumber(actual.code),
            CheckConcat(", C status ", CheckNumber(reference.code)))))) { return }
    // Drops and moves free every heap block before the entry returns.
    if !NativeAssert(test, TextContains(actual.error, "heap: 0 live blocks"),
        CheckConcat(item.entry, CheckConcat(": heap blocks were still live: ", actual.error))) { return }
    // A bundle runs the same program and prints the entry's result on its
    // own last line, where the interpreter returns it as the process status.
    bundle := string.[zi2zx, "bundle", "--root", item.root, "--module-path", std,
        "--entry", item.entry, "-o", bundled, item.file]
    unused NativeRun(test, bundle[:])
    if test.failed { return }
    command := string.[zi2zx, "run", bundled]
    reread := NativeInvoke(test, command[:])
    printed := reread.output
    agrees := reread.code == 0 && printed.count >= actual.output.count &&
        printed[0:actual.output.count] == actual.output
    if agrees {
        result := printed[actual.output.count:printed.count]
        value, valid := TextInteger(result[0:ifx result.count > 0 then result.count - 1 else 0])
        agrees = result == "" && actual.code == 0 || valid && (value % 256 + 256) % 256 == cast(s64)actual.code
    }
    if !NativeAssert(test, agrees, CheckConcat(item.entry, ": zi2zx run of the bundle differs from the interpreter")) { return }
    // The same ZX lowers to one wasm32 module, byte for byte, which prints
    // what the interpreter prints.
    wasm := CheckPath(test.work, CheckConcat(label, ".wasm"))
    again := CheckPath(test.work, CheckConcat(label, ".again.wasm"))
    emit := string.[zi2asm, "--input", "zx", "--emit", "wasm", "-o", wasm, lowered]
    emitted := NativeInvoke(test, emit[:])
    if !NativeAssert(test, emitted.code == 0,
        CheckConcat(item.entry, CheckConcat(": wasm output failed: ", emitted.error))) { return }
    repeat := string.[zi2asm, "--input", "zx", "--emit", "wasm", "-o", again, lowered]
    unused NativeRun(test, repeat[:])
    same := string.["cmp", "-s", wasm, again]
    node := string.["node", CheckPath(test.repo, "scripts/site_target_wasm.cjs"), wasm, "--output"]
    compared := NativeInvoke(test, same[:])
    module_run := NativeInvoke(test, node[:])
    if !NativeAssert(test, compared.code == 0,
        CheckConcat(item.entry, ": one ZX gave two different wasm modules")) { return }
    if !NativeAssert(test, module_run.code == 0 && module_run.output == actual.output,
        CheckConcat(item.entry, ": wasm output differs from the interpreter")) { return }
    wasm_modules.* += 1
    native := string.[zi2asm, "--input", "zx", "-o", elf, lowered]
    encoded := NativeInvoke(test, native[:])
    if encoded.code != 0 {
        unused NativeAssert(test, TextContains(encoded.error, "assembly.gap."),
            CheckConcat(item.entry, CheckConcat(": native output failed without a named gap: ", encoded.error)))
        return
    }
    executable := string.[elf]
    ran := NativeInvoke(test, executable[:])
    unused NativeAssert(test, ran.output == actual.output && ran.code == actual.code,
        CheckConcat(item.entry, ": native ELF differs from the interpreter"))
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "zx-lowered-parity-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    tools := TextDetach(TextCopy(PathParent(test.ziran)))
    cases: Vec(ParityCase)
    examples := string.["arrays", "conditions", "defer", "enums", "fizzbuzz", "functions", "greet",
        "hello", "loops", "primes", "structs", "text_basics", "values", "variables"]
    for name: examples {
        ParityAdd(*cases, CheckPath(test.repo, "examples"), CheckConcat(name, ":main"),
            CheckPath(test.repo, CheckConcat("examples/", CheckConcat(name, ".zi"))))
    }
    spec := string.["assembly_slices:Answer", "assembly_string_index:Answer", "compact_branches:main",
        "constant_time_test:SelfTest", "date_parse_test:Check", "grapheme_conformance:NativeMain",
        "language_contract:Answer", "path_test:main", "queue_test:SelfTest", "std_binary:SelfTest",
        "std_c_string:main", "std_grapheme:SelfTest", "std_math:main", "std_math_sqrt:SelfTest",
        "std_number_text:SelfTest", "std_string:main", "std_text:SelfTest", "utf8_copy_valid:SelfTest",
        "vm_concurrent_instances_test:Next", "wide_compare_test:main", "zip_test:SelfTest",
        "sort_test:SelfTest", "vm_local_reads_test:main", "vm_u64_enums_test:main",
        "vm_deep_marking_test:Answer", "vm_return_storage_test:Answer", "vm_leaf_eval_test:main",
        "image_resize_fallible:NativeMain", "vm_inline_records_test:Answer",
        "vm_scalar_plans_test:Answer", "vm_storage_reads_test:main", "json_scan_test:SelfTest",
        "json_scan_test:NativeMain", "json_string_value_test:SelfTest", "json_string_scan_test:SelfTest",
        "json_document_lifetime_test:Answer", "std_float_text:SelfTest",
        "generic_assembly_test:Answer", "native_assembly_test:Answer"]
    spec_root := CheckPath(test.repo, "tests/spec")
    ParityAdd(*cases, spec_root, "zx_lowered_features:main", CheckPath(spec_root, "zx_lowered_features.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_vec:main", CheckPath(spec_root, "zx_lowered_vec.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_owned:main", CheckPath(spec_root, "zx_lowered_owned.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_text:main", CheckPath(spec_root, "zx_lowered_text.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_pointers:main", CheckPath(spec_root, "zx_lowered_pointers.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_swap:main", CheckPath(spec_root, "zx_lowered_swap.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_globals:main", CheckPath(spec_root, "zx_lowered_globals.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_reserve:main", CheckPath(spec_root, "zx_lowered_reserve.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_shared:main", CheckPath(spec_root, "zx_lowered_shared.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_resize:main", CheckPath(spec_root, "zx_lowered_resize.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_take:main", CheckPath(spec_root, "zx_lowered_take.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_addresses:main", CheckPath(spec_root, "zx_lowered_addresses.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_cases:main", CheckPath(spec_root, "zx_lowered_cases.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_simd:main", CheckPath(spec_root, "zx_lowered_simd.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_using:main", CheckPath(spec_root, "zx_lowered_using.zi"))
    ParityAdd(*cases, spec_root, "zx_lowered_tables:main", CheckPath(spec_root, "zx_lowered_tables.zi"))
    for entry: spec {
        at: s64
        while entry[at] != cast(u8)58 { at += 1 }
        ParityAdd(*cases, spec_root, entry, CheckPath(spec_root, CheckConcat(entry[0:at], ".zi")))
    }
    ParityAdd(*cases, spec_root, "std_string_bad:main", CheckPath(spec_root, "std_string_bad.zi"), true)
    wasm_modules: s64
    for index: cast(s64)0..cases.count - 1 {
        ParityRun(*test, tools, cases[index], CheckConcat("case-", CheckNumber(index)), *wasm_modules)
    }
    if test.failed { return 1 }
    print("revision-28 ZX parity: % programs match the C target on the interpreter and as bundles; native runs or names its gap; % ran as wasm32 modules\n",
        cases.count, wasm_modules)
    return 0
}
