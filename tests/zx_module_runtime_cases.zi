#import "native_test"
#import "check_support"
#import "std/byte_text_linux"
#import "std/c_string"
#import "std/environment_linux"
#import "std/file"
#import "std/file_tree_linux"
#import "std/text_tools"
using Vectors :: #import "std/vec"

Build :: (test: *NativeTest, command: []string) -> bool {
    unused NativeRun(test, command)
    return !test.failed
}

// The host test links the runtime without also emitting its compiler modules.
#if #defined(ZX_MODULE_HOSTED_TEST) {
using Host :: #import "std/bundle_host"
Mutex :: #import "std/mutex_linux";
Threads :: #import "std/thread_linux";
#import "std/timer_linux"

// Public C ABI from ziran_zx_module.h and ziran_host.h.
hosting :: #system_library "ziran";
BackendOptions :: struct { backend: s32; max_steps: s32; unbounded: s32 }
ReleaseImage :: #type (context: *void, data: *u8, size: usize) #c_call;
OpenOwnedBytes :: (data: *u8, size: usize, release: ReleaseImage, context: *void) -> *void #foreign hosting "BundleOpenOwnedBytes";
ReadAt :: #type (context: *void, offset: u64, output: *u8, size: usize) -> usize #c_call;
OpenReadAt :: (size: u64, read_at: ReadAt, context: *void, unsupported: *s32) -> *void #foreign hosting "BundleOpenReadAt";
ShrinkStorage :: #type (storage: *void, size: usize) -> *void #c_call;
OpenEngineReadAt :: (size: u64, read_at: ReadAt, context: *void, unsupported: *s32,
    shrink: ShrinkStorage) -> *void #foreign hosting "BundleOpenEngineReadAt";
libc :: #system_library "c";
AllocateStorage :: (size: usize) -> *void #foreign libc "malloc";
ResizeStorage :: (storage: *void, size: usize) -> *void #foreign libc "realloc";
FreeStorage :: (storage: *void) #foreign libc "free";
CopyStorage :: (output: *void, input: *void, size: usize) -> *void #foreign libc "memcpy";
CodeIdentity :: (bundle: *void, digest: *u8) #foreign hosting "BundleCodeIdentity";
AssetCount :: (bundle: *void) -> usize #foreign hosting "BundleAssetCount";
AssetName :: (bundle: *void, index: usize) -> *u8 #foreign hosting "BundleAssetName";
AssetData :: (bundle: *void, index: usize) -> *u8 #foreign hosting "BundleAssetData";
AssetSize :: (bundle: *void, index: usize) -> usize #foreign hosting "BundleAssetSize";
Image :: struct { data: *u8; size: usize; release: ReleaseImage }
ResolveImage :: #type (context: *void, path: *u8, image: *Image) -> s32 #c_call;
ConsoleWrite :: #type (context: *void, descriptor: s32, data: *u8, size: usize) -> s32 #c_call;
LoaderConfig :: struct {
    roots: **u8
    root_count: usize
    options: BackendOptions
    library_bindings: *Host.HostBinding
    library_binding_count: usize
    resolve: ResolveImage
    resolve_context: *void
    write: ConsoleWrite
    console_context: *void
}
OpenLoader :: (config: *LoaderConfig) -> *void #foreign hosting "ZxModuleLoaderOpenConfigured";
CloseLoader :: (loader: *void) #foreign hosting "ZxModuleLoaderClose";
LoaderProblem :: (loader: *void) -> *u8 #foreign hosting "ZxModuleLoaderError";
OpenProgram :: (loader: *void, bundle: *void, bindings: *Host.HostBinding,
    count: usize) -> *void #foreign hosting "ZxModuleProgramOpen";
ProgramBackend :: (program: *void) -> s32 #foreign hosting "ZxModuleProgramBackend";
RunProgram :: (program: *void, result: *s64, present: *s32) -> s32 #foreign hosting "ZxModuleProgramRun";
BorrowProgramString :: (program: *void, module: *u8, function: *u8,
    parameter: usize) -> s32 #foreign hosting "ZxModuleProgramBorrowHostString";
BorrowProgramSlice :: (program: *void, module: *u8, function: *u8,
    parameter: usize) -> s32 #foreign hosting "ZxModuleProgramBorrowHostSlice";
CloseProgram :: (program: *void) #foreign hosting "ZxModuleProgramClose";
RenewSteps :: () -> s32 #foreign hosting "BundleHostRenewSteps";
RunStatus :: enum s32 { Error; Ok; Cancelled }
CreateRunControl :: () -> *void #foreign hosting "ZxRunControlCreate";
RequestRunStop :: (control: *void) #foreign hosting "ZxRunControlRequest";
RunStopRequested :: (control: *void) -> s32 #foreign hosting "ZxRunControlRequested";
FreeRunControl :: (control: *void) #foreign hosting "ZxRunControlFree";
OpenControlled :: (loader: *void, bundle: *void, bindings: *Host.HostBinding, count: usize,
    control: *void, status: *RunStatus) -> *void #foreign hosting "ZxModuleProgramOpenControlled";
RunControlled :: (program: *void, result: *s64, present: *s32,
    control: *void) -> RunStatus #foreign hosting "ZxModuleProgramRunControlled";

HostedState :: struct {
    bridge: string
    counter: string
    releases: s32
    console: Vec(u8)
}

HostedBytes :: (text: string) -> *u8 {
    descriptor := cast(*TextDescriptor)*text
    return descriptor.data
}

OwnedImage :: struct { bytes: Vec(u8); releases: s32; matched: bool }

#program_export
FreeOwnedTestImage :: (opaque: *void, data: *u8, size: usize) {
    image := cast(*OwnedImage)opaque
    image.releases += 1
    if image.bytes.count == 0 { return }
    image.matched = data == *image.bytes[0] && size == cast(usize)image.bytes.count
    for index: cast(s64)0..image.bytes.count - 1 { image.bytes[index] = 0 }
    VecFree(image.bytes)
}

OpenOwnedTestImage :: (test: *NativeTest, bytes: string) -> *void {
    image: OwnedImage
    defer VecFree(image.bytes)
    if !NativeAssert(test, VecResize(image.bytes, bytes.count), "allocate transferred image") { return null }
    for index: cast(s64)0..bytes.count - 1 { image.bytes[index] = bytes[index] }
    bundle := OpenOwnedBytes(*image.bytes[0], cast(usize)bytes.count, FreeOwnedTestImage, cast(*void)*image)
    if !NativeAssert(test, image.releases == 1 && image.matched && image.bytes.count == 0,
        "release the exact transferred image before returning") {
        Host.CloseBundle(bundle)
        return null
    }
    return bundle
}

#program_export
ReleaseHostedImage :: (opaque: *void, data: *u8, size: usize) {
    unused data; unused size
    state := cast(*HostedState)opaque
    state.releases += 1
}

#program_export
ResolveHostedImage :: (opaque: *void, path: *u8, output: *Image) -> s32 {
    state := cast(*HostedState)opaque
    bytes: string = ""
    candidate := TextFromCString(path)
    if candidate == "/zx-guest/demo/bridge.zx" { bytes = state.bridge }
    if candidate == "/zx-guest/demo/counter.zx" { bytes = state.counter }
    if bytes == "" { return 0 }
    <<output = .{HostedBytes(bytes), cast(usize)bytes.count, ReleaseHostedImage}
    return 1
}

#program_export
WriteHostedConsole :: (opaque: *void, descriptor: s32, data: *u8, size: usize) -> s32 {
    state := cast(*HostedState)opaque
    if descriptor != 1 { return 0 }
    for byte: BytesFromPointer(data, cast(u64)size) {
        if !VecPush(state.console, byte) { return 0 }
    }
    return 1
}

GrantContext :: struct { argument: s64; answer: s64; calls: s32 }

#program_export
HostedGrant :: (opaque: *void, module: *u8, function: *u8, args: *Host.HostValue,
    count: s32, result: *Host.HostValue) -> s32 {
    unused module; unused function
    grant := cast(*GrantContext)opaque
    if count != 1 || args[0].kind != cast(s32)Host.HostValueKind.HostInteger ||
        args[0].integer != grant.argument || TextFromCString(args[0].type_name) != "s32" { return 0 }
    grant.calls += 1
    result.kind = cast(s32)Host.HostValueKind.HostInteger
    result.integer = grant.answer
    return 1
}

HostedApp :: #string ZI
using Modules :: #import "std/zx_module"
host_api :: #system_library "host_api";
Grant :: (value: s32) -> s32 #foreign host_api;
Total :: (handle: u64, amount: s32) -> s32 #foreign host_api;
seed: s32 = Start();
Start :: () -> s32 {
    print("app init\n")
    return Grant(3)
}
main :: () -> s32 {
    print("app run\n")
    handle := Modules.Load("Bridge.v1")
    if handle == 0 { return -1 }
    return Total(handle, seed)
}
ZI;

HostedCounter :: #string ZI
host_api :: #system_library "host_api";
Grant :: (value: s32) -> s32 #foreign host_api;
seed: s32 = Start();
Start :: () -> s32 {
    print("lib init\n")
    return Grant(4)
}
Add :: (value: s32) -> s32 {
    print("lib run\n")
    return seed + value
}
ZI;

CheckHostedProgram :: (test: *NativeTest, config: *LoaderConfig, bundle: *void, binding: *Host.HostBinding,
    problem: string = "") -> bool {
    loader := OpenLoader(config)
    if !NativeAssert(test, loader != null, "open configured module loader") { return false }
    defer CloseLoader(loader)
    program := OpenProgram(loader, bundle, binding, ifx binding != null then 1 else 0)
    defer CloseProgram(program)
    if problem != "" {
        actual := TextFromCString(LoaderProblem(loader))
        return NativeAssert(test, program == null && TextContains(actual, problem), CheckConcat(problem, CheckConcat(": ", actual)))
    }
    result: s64; present: s32
    return NativeAssert(test, ProgramBackend(program) == 1 && RunProgram(program, *result, *present) != 0 &&
        present == 1 && result == 42, CheckConcat("run application with virtual transitive library: ", TextFromCString(LoaderProblem(loader))))
}

HostedCases :: (test: *NativeTest, compiler: string, std: string, bridge: string) -> bool {
    source := CheckPath(test.work, "hosted_app.zi")
    provider := CheckPath(test.work, "hosted_counter.zi")
    app_image := CheckPath(test.work, "hosted-app.zx")
    counter_image := CheckPath(test.work, "hosted-counter.zx")
    assets := CheckPath(test.work, "hosted-assets")
    if !NativeWrite(test, source, HostedApp) || !NativeWrite(test, provider, HostedCounter) ||
        !CreateDirectory(assets) || !NativeWrite(test, CheckPath(assets, "label.txt"), "embedded label") { return false }
    compile := string.[compiler, "--root", test.work, "--module-path", std, "--entry", "hosted_app:main",
        "--asset-dir", CheckConcat("assets=", assets), "--require-module", "Bridge.v1=demo/bridge",
        "--import", "hosted_app:Total=Bridge.v1:Total", "-o", app_image, source]
    library := string.[compiler, "--root", test.work, "--library", "demo/counter", "--export", "hosted_counter:Add", "-o", counter_image, provider]
    if !Build(test, compile[:]) || !Build(test, library[:]) { return false }
    bytes := NativeRead(test, app_image)
    borrowed := Host.OpenBundleBytes(HostedBytes(bytes), cast(u64)bytes.count)
    defer Host.CloseBundle(borrowed)
    bundle := OpenOwnedTestImage(test, bytes)
    defer Host.CloseBundle(bundle)
    invalid := OpenOwnedTestImage(test, "invalid ZX bytes")
    defer Host.CloseBundle(invalid)
    if !NativeAssert(test, !test.failed && borrowed != null && bundle != null && invalid == null,
        "verify both input lifetimes and reject a malformed owned image") { return false }
    borrowed_id: [32]u8; owned_id: [32]u8
    CodeIdentity(borrowed, *borrowed_id[0])
    CodeIdentity(bundle, *owned_id[0])
    if !NativeAssert(test, TextView(borrowed_id[:]) == TextView(owned_id[:]) && AssetCount(bundle) == 1 &&
        TextFromCString(AssetName(bundle, 0)) == "assets/label.txt" &&
        TextView(BytesFromPointer(AssetData(bundle, 0), cast(u64)AssetSize(bundle, 0))) == "embedded label",
        "preserve exact code identity and assets after releasing the original image") { return false }
    source_snapshot := SourceFixture.{bytes = bytes}
    unsupported: s32
    unsupported_bundle := OpenReadAt(cast(u64)bytes.count, ReadSourceFixture, cast(*void)*source_snapshot, *unsupported)
    Host.CloseBundle(unsupported_bundle)
    if !NativeAssert(test, unsupported_bundle == null && unsupported == 1,
        "report an image with assets and module linkage outside the source profile") { return false }
    library_grant := GrantContext.{4, 23, 0}
    entry_grant := GrantContext.{3, 19, 0}
    app_binding := Host.HostBinding.{HostedBytes("hosted_app"), HostedBytes("Grant"), HostedGrant, cast(*void)*entry_grant}
    lib_binding := Host.HostBinding.{HostedBytes("hosted_counter"), HostedBytes("Grant"), HostedGrant, cast(*void)*library_grant}
    // The second root contains real host files. A configured resolver must
    // still report missing when it declines to supply those files.
    host_root: [4096]u8
    if !NativeAssert(test, CopyCString(PathParent(test.work), host_root[:]), "copy host test root") { return false }
    roots: [2]*u8 = .[HostedBytes("/zx-guest/"), *host_root[0]]
    hosted := HostedState.{bridge = NativeRead(test, bridge), counter = NativeRead(test, counter_image)}
    defer VecFree(hosted.console)
    config := LoaderConfig.{roots = *roots[0], root_count = 2, options = .{1, 200, 0},
        library_bindings = *lib_binding, library_binding_count = 1,
        resolve = ResolveHostedImage, resolve_context = cast(*void)*hosted,
        write = WriteHostedConsole, console_context = cast(*void)*hosted}
    counter := hosted.counter
    hosted.counter = ""
    if !CheckHostedProgram(test, *config, bundle, *app_binding, "ZX module not found: demo/counter") { return false }
    hosted.counter = "invalid ZX bytes"
    if !CheckHostedProgram(test, *config, bundle, *app_binding, "cannot open verified ZX module") { return false }
    if !NativeAssert(test, hosted.releases == 3, "resolver releases both valid and rejected images") { return false }
    if !NativeWrite(test, provider, "Add :: (value: u32) -> s32 { return cast(s32)value }\n") || !Build(test, library[:]) { return false }
    hosted.counter = NativeRead(test, counter_image)
    if !CheckHostedProgram(test, *config, bundle, *app_binding, "import signature mismatch") { return false }
    hosted.counter = counter
    config.library_binding_count = 0
    if !CheckHostedProgram(test, *config, bundle, *app_binding, "needs one loader host binding") { return false }
    config.library_binding_count = 1
    if !CheckHostedProgram(test, *config, bundle, null, "initialization failed") { return false }
    config.options.backend = 2
    if !CheckHostedProgram(test, *config, bundle, *app_binding, "initialization failed") { return false }
    config.options.backend = 1
    if !NativeAssert(test, hosted.console.count == 0 && entry_grant.calls == 0 && library_grant.calls == 0,
        "failed preflight never invokes grants or console") { return false }
    if !CheckHostedProgram(test, *config, bundle, *app_binding) { return false }
    return NativeAssert(test, entry_grant.calls == 1 && library_grant.calls == 1 &&
        TextView(hosted.console[:]) == "app init\napp run\nlib init\nlib run\n", "entry and library use separate typed grants and one console")
}

FuelApp :: #string ZI
host_api :: #system_library "host_api";
Pulse :: () #foreign host_api;
seed: s32 = Start();
Start :: () -> s32 {
    Pulse()
    return 17
}
main :: () -> s32 {
    if padding[seed] != 120 { return 0 }
    for i: 0..999 { Pulse() }
    return seed
}
runaway :: () -> s32 {
    Pulse()
    while true { seed += 1 }
    return seed
}
ZI;

PulseContext :: struct { calls: s32; renewals: s32 }

#program_export
HostedPulse :: (opaque: *void, module: *u8, function: *u8, args: *Host.HostValue,
    count: s32, result: *Host.HostValue) -> s32 {
    unused module; unused function; unused args; unused result
    if count != 0 { return 0 }
    pulse := cast(*PulseContext)opaque
    pulse.calls += 1
    pulse.renewals += RenewSteps()
    return 1
}

SourceReadMode :: enum s32 { Complete; Short; Changed; ReadError }
SourceFixture :: struct {
    bytes: string
    reads: s32
    seen: [16]bool
    repeated: bool
    mode: SourceReadMode
}

#program_export
ReadSourceFixture :: (opaque: *void, offset: u64, output: *u8, size: usize) -> usize {
    source := cast(*SourceFixture)opaque
    source.reads += 1
    length := cast(u64)source.bytes.count
    if offset > length || cast(u64)size > length - offset { return 0 }
    if source.mode == .Short && source.reads == 1 { return size - 1 }
    for at: cast(s64)0..cast(s64)size - 1 { output[at] = source.bytes[cast(s64)offset + at] }
    window := offset / 32768
    if window >= 16 { return 0 }
    if source.seen[window] {
        source.repeated = true
        if source.mode == .Changed { output[0] = output[0] ^ 1 }
        if source.mode == .ReadError { return 0 }
    }
    source.seen[window] = true
    return size
}

#program_export
ReallocFixture :: (storage: *void, size: usize) -> *void {
    return ResizeStorage(storage, size)
}

CheckSourceReader :: (test: *NativeTest, bytes: string, borrowed: *void, engine: bool) -> *void {
    image_size := cast(u64)bytes.count
    limit: u64 = 256 * 1024 * 1024
    for size: u64.[0, limit + 1, 18446744073709551615] {
        source := SourceFixture.{bytes = bytes}
        unsupported: s32 = -1
        rejected := OpenReadAt(size, ReadSourceFixture, cast(*void)*source, *unsupported)
        Host.CloseBundle(rejected)
        if !NativeAssert(test, rejected == null && unsupported == 0 && source.reads == 0,
            "reject an out-of-range source size before any read") { return null }
    }
    at_limit := SourceFixture.{bytes = bytes, mode = .Short}
    limited := OpenReadAt(limit, ReadSourceFixture, cast(*void)*at_limit, null)
    Host.CloseBundle(limited)
    if !NativeAssert(test, limited == null && at_limit.reads == 1,
        "accept the largest allowed size for reading and reject its short read") { return null }
    for mode: SourceReadMode.[.Short, .Changed, .ReadError] {
        source := SourceFixture.{bytes = bytes, mode = mode}
        unsupported: s32 = -1
        rejected := OpenReadAt(image_size, ReadSourceFixture, cast(*void)*source, *unsupported)
        Host.CloseBundle(rejected)
        if !NativeAssert(test, rejected == null && unsupported == 0 && (mode == .Short || source.repeated),
            "reject a short read, changed page, or read error before accepting a source") { return null }
    }
    source := SourceFixture.{bytes = bytes}
    truncated := OpenReadAt(image_size - 1, ReadSourceFixture, cast(*void)*source, null)
    Host.CloseBundle(truncated)
    if !NativeAssert(test, truncated == null, "reject a truncated ZX source") { return null }
    input: Vec(u8)
    if !NativeAssert(test, BuilderAppend(input, bytes), "allocate a disposable source") { return null }
    source = .{bytes = TextView(input[:])}
    unsupported: s32 = -1
    bundle: *void
    if engine {
        bundle = OpenEngineReadAt(image_size, ReadSourceFixture, cast(*void)*source, *unsupported, ReallocFixture)
    } else {
        bundle = OpenReadAt(image_size, ReadSourceFixture, cast(*void)*source, *unsupported)
    }
    // Retire both the reader and its bytes before querying or running the bundle.
    source = .{}
    for at: cast(s64)0..input.count - 1 { input[at] = 0 }
    VecFree(input)
    if !NativeAssert(test, bundle != null && unsupported == 0, "verify a source across several windows") {
        Host.CloseBundle(bundle)
        return null
    }
    borrowed_id: [32]u8; source_id: [32]u8
    CodeIdentity(borrowed, *borrowed_id[0])
    CodeIdentity(bundle, *source_id[0])
    if !NativeAssert(test, TextView(borrowed_id[:]) == TextView(source_id[:]), "preserve raw source identity") {
        Host.CloseBundle(bundle)
        return null
    }
    return bundle
}

FuelCase :: (test: *NativeTest, path: string, runaway: bool, engine: bool) -> bool {
    bytes := NativeRead(test, path)
    borrowed := Host.OpenBundleBytes(HostedBytes(bytes), cast(u64)bytes.count)
    if !NativeAssert(test, borrowed != null, "verify fuel fixture") { return false }
    defer Host.CloseBundle(borrowed)
    source_bundle: *void
    if !runaway {
        source_bundle = CheckSourceReader(test, bytes, borrowed, engine)
    } else if engine {
        source := SourceFixture.{bytes = bytes}
        source_bundle = OpenEngineReadAt(cast(u64)bytes.count, ReadSourceFixture, cast(*void)*source, null, ReallocFixture)
    }
    defer Host.CloseBundle(source_bundle)
    bundle := ifx runaway && !engine then borrowed else source_bundle
    if bundle == null { return false }
    if engine && !NativeAssert(test, TextContains(Host.GetBundleNativeProblem(bundle), "requires the instruction engine"),
        "native preflight rejects an engine-only bundle") { return false }
    config := LoaderConfig.{options = .{1, 200, 0}}
    loader := OpenLoader(*config)
    defer CloseLoader(loader)
    pulse: PulseContext
    binding := Host.HostBinding.{HostedBytes("fuel"), HostedBytes("Pulse"), HostedPulse, cast(*void)*pulse}
    control := CreateRunControl()
    defer FreeRunControl(control)
    if !NativeAssert(test, control != null, "allocate clear control for finite fuel") { return false }
    // A clear control leaves finite fuel unchanged; the plain calls cover uncontrolled callers.
    status := RunStatus.Ok
    program: *void
    if engine { program = OpenControlled(loader, bundle, *binding, 1, control, *status) }
    else { program = OpenProgram(loader, bundle, *binding, 1) }
    defer CloseProgram(program)
    if !NativeAssert(test, program != null && status == .Ok && pulse.calls == 1 && pulse.renewals == 0 && RenewSteps() == 0,
        "fuel renewal requires an active entry callback") { return false }
    result: s64; present: s32
    if engine { status = RunControlled(program, *result, *present, control) }
    else { status = cast(RunStatus)RunProgram(program, *result, *present) }
    if runaway {
        return NativeAssert(test, status == .Error && pulse.calls == 2 && pulse.renewals == 1 &&
            RunProgram(program, *result, *present) == 0, "runaway after one renewal exhausts the fresh budget")
    }
    return NativeAssert(test, status == .Ok && result == 17 && present == 1 && pulse.calls == 1001 && pulse.renewals == 1000,
        "one bounded invocation handles 1000 recurring checkpoints")
}

FuelCases :: (test: *NativeTest, compiler: string) -> bool {
    source := CheckPath(test.work, "fuel.zi")
    // A live literal crosses enough read windows to force a refetch.
    line: [3072]u8
    for at: 0..3071 { line[at] = 120 }
    text: Vec(u8)
    defer VecFree(text)
    if !BuilderAppend(text, FuelApp) || !BuilderAppend(text, "\npadding :: #string ZX_PADDING\n") { return false }
    for row: 0..63 {
        if !BuilderAppend(text, TextView(line[:])) || !BuilderAppend(text, "\n") { return false }
    }
    if !BuilderAppend(text, "ZX_PADDING;\n") || !NativeWrite(test, source, TextView(text[:])) { return false }
    entries := string.["fuel:main", "fuel:runaway"]
    for entry: entries {
        output := CheckPath(test.work, "fuel.zx")
        compile := string.[compiler, "--root", test.work, "--entry", entry, "-o", output, source]
        if !Build(test, compile[:]) { return false }
        for engine: bool.[false, true] {
            if !FuelCase(test, output, entry == "fuel:runaway", engine) { return false }
        }
    }
    return true
}

CancellationGuest :: #string ZI
Modules :: #import "std/zx_module";

host_api :: #system_library "host_api";
Ready :: () #foreign host_api;
Apply :: (handle: u64) -> s32 #foreign host_api;

spin :: () -> s32 {
    Ready()
    counter: u32
    while true { counter += 1 }
    return cast(s32)counter
}

#if #defined(CANCEL_INITIALIZER) {
    seed: s32 = spin();
} else {
    seed: s32;
}

value :: () -> s32 { return seed + 42 }
blocked :: () -> s32 { Ready(); return 42 }
call_library :: () -> s32 {
    handle := Modules.Load("Cancel.v1")
    if handle == 0 { return 1 }
    return Apply(handle)
}
ZI;

CancellationState :: struct {
    gate: Mutex.Mutex
    control: *void
    entered: bool
    stop_after_entry: bool
    wait_in_callback: bool
}

#program_export
CancellationReady :: (opaque: *void, module: *u8, function: *u8, args: *Host.HostValue,
    count: s32, result: *Host.HostValue) -> s32 {
    unused module; unused function; unused args; unused result
    state := cast(*CancellationState)opaque
    if count != 0 || !Mutex.Lock(*state.gate) { return 0 }
    state.entered = true
    unused Mutex.Unlock(*state.gate)
    if !state.wait_in_callback { return 1 }
    deadline := MonotonicMilliseconds() + 3000
    while RunStopRequested(state.control) == 0 && MonotonicMilliseconds() < deadline {
        unused SleepMilliseconds(1)
    }
    // A device wakeup can return a host error. The caller must see Cancelled.
    return 0
}

RequestAfterEntry :: (opaque: *void) {
    state := cast(*CancellationState)opaque
    deadline := MonotonicMilliseconds() + 3000
    while MonotonicMilliseconds() < deadline {
        if !Mutex.Lock(*state.gate) { break }
        entered := state.entered
        unused Mutex.Unlock(*state.gate)
        if entered {
            state.stop_after_entry = true
            // Let the guest return from Ready into its CPU loop.
            unused SleepMilliseconds(25)
            break
        }
        unused SleepMilliseconds(1)
    }
    RequestRunStop(state.control)
}

CancellationTrial :: (test: *NativeTest, loader: *void, bundle: *void, binding: *Host.HostBinding,
    state: *CancellationState, entry: string, initialize: bool) -> bool {
    state.control = CreateRunControl()
    defer FreeRunControl(state.control)
    state.entered = false
    state.stop_after_entry = false
    state.wait_in_callback = entry == "blocked"
    if !NativeAssert(test, state.control != null && RunStopRequested(state.control) == 0,
        "allocate an initially clear run control") { return false }
    program: *void
    defer CloseProgram(program)
    status: RunStatus
    count: usize = ifx binding != null then 1 else 0
    if !initialize {
        program = OpenControlled(loader, bundle, binding, count, state.control, *status)
        if !NativeAssert(test, program != null && status == .Ok, "open cancellable entry") { return false }
    }
    supervisor: Threads.Thread
    stop: Threads.ThreadProcedure = RequestAfterEntry
    if !NativeAssert(test, Threads.ThreadStart(*supervisor, stop, cast(*void)state), "start stop requester") {
        return false
    }
    result: s64 = 123
    present: s32 = 17
    if initialize { program = OpenControlled(loader, bundle, binding, count, state.control, *status) }
    else { status = RunControlled(program, *result, *present, state.control) }
    Threads.ThreadWait(*supervisor)
    return NativeAssert(test, status == .Cancelled && state.stop_after_entry &&
        RunStopRequested(state.control) != 0 && result == 123 && present == 17 &&
        (ifx initialize then program == null else RunProgram(program, null, null) == 0), entry)
}

CancellationCases :: (test: *NativeTest, compiler: string, std: string) -> bool {
    source := CheckPath(test.work, "cancel_guest.zi")
    if !NativeWrite(test, source, CancellationGuest) { return false }
    state: CancellationState
    if !NativeAssert(test, Mutex.Open(*state.gate), "open cancellation test gate") { return false }
    defer { unused Mutex.Close(*state.gate) }
    binding := Host.HostBinding.{HostedBytes("cancel_guest"), HostedBytes("Ready"),
        CancellationReady, cast(*void)*state}
    root := HostedBytes(test.work)
    config := LoaderConfig.{roots = *root, root_count = 1, options = .{1, 0, 0},
        library_bindings = *binding, library_binding_count = 1}
    loader := OpenLoader(*config)
    defer CloseLoader(loader)
    if !NativeAssert(test, loader != null, "open cancellation test loader") { return false }
    ordinary := CheckPath(test.work, "cancel_normal.zx")
    normal_compile := string.[compiler, "--root", test.work, "--entry", "cancel_guest:value", "-o", ordinary, source]
    if !Build(test, normal_compile[:]) { return false }
    bytes := NativeRead(test, ordinary)
    normal := Host.OpenBundleBytes(HostedBytes(bytes), cast(u64)bytes.count)
    defer Host.CloseBundle(normal)
    other := OpenProgram(loader, normal, null, 0)
    defer CloseProgram(other)
    if !NativeAssert(test, other != null, "open independent app before cancellation") { return false }

    kinds := string.["spin", "initialize", "call_library", "load_library", "blocked"]
    for kind: kinds {
        output := CheckPath(test.work, "cancel_test.zx")
        initialize := kind == "initialize"
        library_call := kind == "call_library" || kind == "load_library"
        if library_call {
            library := ifx kind == "load_library" then "idle-provider" else "spin-provider"
            provider := CheckPath(test.work, CheckConcat(library, ".zx"))
            symbol := ifx kind == "load_library" then "value" else "spin"
            define := ifx kind == "load_library" then "CANCEL_INITIALIZER" else "NO_INIT"
            build_library := string.[compiler, "--root", test.work, "--library", library, "--define", define,
                "--export", CheckConcat("cancel_guest:", symbol), "-o", provider, source]
            import_function := CheckConcat("cancel_guest:Apply=Cancel.v1:", symbol)
            build_app := string.[compiler, "--root", test.work, "--module-path", std, "--entry", "cancel_guest:call_library",
                "--require-module", CheckConcat("Cancel.v1=", library), "--import", import_function, "-o", output, source]
            if !Build(test, build_library[:]) || !Build(test, build_app[:]) { return false }
        } else {
            entry := ifx initialize then "cancel_guest:value" else CheckConcat("cancel_guest:", kind)
            define := ifx initialize then "CANCEL_INITIALIZER" else "NO_INIT"
            build_app := string.[compiler, "--root", test.work, "--entry", entry, "--define", define, "-o", output, source]
            if !Build(test, build_app[:]) { return false }
        }
        bytes := NativeRead(test, output)
        bundle := Host.OpenBundleBytes(HostedBytes(bytes), cast(u64)bytes.count)
        defer Host.CloseBundle(bundle)
        app_binding := ifx library_call then null else *binding
        if !NativeAssert(test, bundle != null, kind) ||
            !CancellationTrial(test, loader, bundle, app_binding, *state, kind, initialize) { return false }
    }

    control := CreateRunControl()
    defer FreeRunControl(control)
    if !NativeAssert(test, control != null, "allocate the independent run control") { return false }
    RequestRunStop(control)
    RequestRunStop(control)
    status: RunStatus
    skipped := OpenControlled(loader, normal, null, 0, control, *status)
    defer CloseProgram(skipped)
    result: s64 = 123
    present: s32 = 17
    if !NativeAssert(test, skipped == null && status == .Cancelled &&
        RunControlled(other, *result, *present, control) == .Cancelled && result == 123 && present == 17,
        "a pre-requested control skips open and run") { return false }
    return NativeAssert(test, RunProgram(other, *result, *present) != 0 && result == 42 && present == 1,
        "later independent runs still work after skipping a request")
}

BorrowApp :: #string ZI
host_api :: #system_library "host_api";
Nested :: struct { text: string }
Probe :: (text: string, later: Nested, items: []u8) -> string #foreign host_api;
main :: () -> s32 {
    items: [1]u8 = .[1]
    later := Nested.{"A later argument still serializes its nested bytes even when the first argument is borrowed."}
    value := Probe("first", later, items[:])
    saved := Probe(value, later, items[:])
    empty := Probe("", later, items[:])
    if value != "first" || saved != "first" || empty != "" { return 1 }
    return cast(s32)items[0]
}
ZI;

BorrowContext :: struct { program: *void; calls: s32 }

#program_export
HostedBorrowProbe :: (opaque: *void, module: *u8, function: *u8, args: *Host.HostValue,
    count: s32, result: *Host.HostValue) -> s32 {
    state := cast(*BorrowContext)opaque
    if count != 3 || args[0].kind != cast(s32)Host.HostValueKind.HostString ||
        TextFromCString(args[0].type_name) != "string" ||
        args[1].kind != cast(s32)Host.HostValueKind.HostRecord || args[1].field_count != 1 ||
        args[2].kind != cast(s32)Host.HostValueKind.HostSlice || args[2].length != 1 { return 0 }
    if BorrowProgramString(state.program, module, function, 0) != 0 ||
        RunProgram(state.program, null, null) != 0 { return 0 }
    later := args[1].fields[0].value
    if later.kind != cast(s32)Host.HostValueKind.HostString ||
        TextView(BytesFromPointer(later.data, cast(u64)later.length)) !=
        "A later argument still serializes its nested bytes even when the first argument is borrowed." { return 0 }
    if args[2].elements[0].bits != cast(u64)(state.calls + 1) { return 0 }
    if state.calls < 2 {
        if args[0].length != 5 || args[0].data == null ||
            TextView(BytesFromPointer(args[0].data, 5)) != "first" { return 0 }
    } else if args[0].data != null || args[0].length != 0 { return 0 }
    state.calls += 1
    args[2].elements[0].bits += 1
    // The adapter must serialize this result while the input bytes are valid.
    result.kind = args[0].kind
    result.data = args[0].data
    result.length = args[0].length
    return 1
}

BorrowCase :: (test: *NativeTest, loader: *void, bundle: *void, enable: bool) -> bool {
    context: BorrowContext
    module := HostedBytes("borrow_app")
    function := HostedBytes("Probe")
    binding := Host.HostBinding.{module, function, HostedBorrowProbe, cast(*void)*context}
    context.program = OpenProgram(loader, bundle, *binding, 1)
    defer CloseProgram(context.program)
    if !NativeAssert(test, context.program != null, "open borrow fixture") { return false }
    if enable && !NativeAssert(test,
        BorrowProgramString(context.program, module, HostedBytes("Missing"), 0) == 0 &&
        BorrowProgramString(context.program, module, function, 1) == 0 &&
        BorrowProgramString(context.program, module, function, 2) == 0 &&
        BorrowProgramString(context.program, module, function, 64) == 0 &&
        BorrowProgramString(context.program, module, function, 0) != 0,
        "only a granted top-level string can opt in") { return false }
    result: s64; present: s32
    return NativeAssert(test, RunProgram(context.program, *result, *present) != 0 &&
        present == 1 && result == 4 && context.calls == 3,
        "host string, nested image, mutable copy-back, empty input and borrowed result")
}

ShrinkCalls: s32;
ShrinkMove: bool;
ShrinkMoved: bool;

#program_export
ShrinkFixture :: (storage: *void, size: usize) -> *void {
    if storage == null || size == 0 { return null }
    ShrinkCalls += 1
    if !ShrinkMove { return null }
    replacement := AllocateStorage(size)
    if replacement == null { return null }
    unused CopyStorage(replacement, storage, size)
    FreeStorage(storage)
    ShrinkMoved = true
    return replacement
}

BorrowCases :: (test: *NativeTest, compiler: string) -> bool {
    source := CheckPath(test.work, "borrow_app.zi")
    output := CheckPath(test.work, "borrow-app.zx")
    compile := string.[compiler, "--root", test.work, "--entry", "borrow_app:main", "-o", output, source]
    if !NativeWrite(test, source, BorrowApp) || !Build(test, compile[:]) { return false }
    bytes := NativeRead(test, output)
    bundle := Host.OpenBundleBytes(HostedBytes(bytes), cast(u64)bytes.count)
    defer Host.CloseBundle(bundle)
    if !NativeAssert(test, bundle != null, "verify borrow fixture") { return false }
    config := LoaderConfig.{options = .{1, 200, 0}}
    loader := OpenLoader(*config)
    defer CloseLoader(loader)
    if !BorrowCase(test, loader, bundle, false) || !BorrowCase(test, loader, bundle, true) { return false }
    for move: bool.[false, true] {
        ShrinkCalls = 0
        ShrinkMove = move
        ShrinkMoved = false
        source_input := SourceFixture.{bytes = bytes}
        engine := OpenEngineReadAt(cast(u64)bytes.count, ReadSourceFixture, cast(*void)*source_input, null, ShrinkFixture)
        defer Host.CloseBundle(engine)
        source_input = .{}
        if !NativeAssert(test, engine != null && ShrinkCalls == 1 && ShrinkMoved == move,
            "engine reader accepts the original or relocated packed allocation") ||
            !BorrowCase(test, loader, engine, false) || !BorrowCase(test, loader, engine, true) { return false }
        if !NativeAssert(test, ShrinkCalls == 1, "shrink only during open") { return false }
    }
    return true
}

ScalarSliceApp :: #string ZI
host_api :: #system_library "host_api";
Pair :: struct { first: [1]u32; pad: u8; second: [1]u32 }
Read :: (first: []u32, second: []u32, other: []string) -> s32 #reads #foreign host_api;
Update :: (values: []u32) -> void #foreign host_api;

main :: () -> s32 {
    pair: Pair
    pair.first[0] = 0x78563412
    pair.second[0] = 0x21436587
    other: [0]string
    if Read(pair.first[:], pair.second[:], other[:]) != 17 { return 1 }
    if Read(pair.first[0:0], pair.second[0:0], other[:]) != 17 { return 2 }
    if pair.first[0] != 0x78563412 || pair.second[0] != 0x21436587 { return 3 }
    Update(pair.first[:])
    return cast(s32)pair.first[0]
}

bounds :: () -> s32 {
    pair: Pair
    other: [0]string
    size: s64 = 2
    return Read(pair.first[:size], pair.second[:], other[:])
}
ZI;

ScalarSliceContext :: struct {
    program: *void
    borrowed: bool
    fail: bool
    reads: s32
    updates: s32
}

SliceWord :: (arg: Host.HostValue, borrowed: bool, populated: bool, expected: u64) -> bool {
    if TextFromCString(arg.type_name) != "[]u32" || arg.length != cast(usize)populated { return false }
    if !borrowed {
        return arg.kind == cast(s32)Host.HostValueKind.HostSlice &&
            (!populated || arg.elements[0].bits == expected)
    }
    if arg.kind != cast(s32)Host.HostValueKind.HostBorrowedSlice || arg.elements != null { return false }
    if !populated { return arg.data == null }
    return arg.data != null && arg.data[0] == cast(u8)expected &&
        arg.data[1] == cast(u8)(expected >> 8) && arg.data[2] == cast(u8)(expected >> 16) &&
        arg.data[3] == cast(u8)(expected >> 24)
}

#program_export
HostedScalarRead :: (opaque: *void, module: *u8, function: *u8, args: *Host.HostValue,
    count: s32, result: *Host.HostValue) -> s32 {
    state := cast(*ScalarSliceContext)opaque
    full := state.reads == 0
    if count != 3 || !SliceWord(args[0], state.borrowed, full, 0x78563412) ||
        !SliceWord(args[1], state.borrowed, full, 0x21436587) ||
        args[2].kind != cast(s32)Host.HostValueKind.HostSlice || args[2].length != 0 { return 0 }
    if state.borrowed {
        // A packed record places the two u32 values five bytes apart. The
        // callback must read an unaligned one correctly and keep it through
        // a rejected reentrant run.
        if full && (cast(usize)args[1].data - cast(usize)args[0].data) != 5 { return 0 }
        if BorrowProgramSlice(state.program, module, function, 0) != 0 ||
            RunProgram(state.program, null, null) != 0 ||
            !SliceWord(args[0], true, full, 0x78563412) { return 0 }
    }
    state.reads += 1
    if state.fail { return 0 }
    result.kind = cast(s32)Host.HostValueKind.HostInteger
    result.integer = 17
    return 1
}

#program_export
HostedScalarUpdate :: (opaque: *void, module: *u8, function: *u8, args: *Host.HostValue,
    count: s32, result: *Host.HostValue) -> s32 {
    if count != 1 || !SliceWord(args[0], false, true, 0x78563412) { return 0 }
    state := cast(*ScalarSliceContext)opaque
    state.updates += 1
    args[0].elements[0].bits = 23
    return 1
}

ScalarSliceCase :: (test: *NativeTest, bundle: *void, backend: s32, borrow: bool,
    fail: bool = false, bounds: bool = false, mismatched_type: bool = false) -> bool {
    config := LoaderConfig.{options = .{backend, 2000, 0}}
    loader := OpenLoader(*config)
    defer CloseLoader(loader)
    context := ScalarSliceContext.{borrowed = borrow, fail = fail}
    module := HostedBytes("scalar_slice_app")
    read := HostedBytes("Read")
    update := HostedBytes("Update")
    bindings := Host.HostBinding.[.{module, read, HostedScalarRead, cast(*void)*context},
        .{module, update, HostedScalarUpdate, cast(*void)*context}]
    context.program = OpenProgram(loader, bundle, *bindings[0], cast(usize)bindings.count)
    defer CloseProgram(context.program)
    if !NativeAssert(test, context.program != null, "open scalar slice host fixture") { return false }
    if mismatched_type {
        return NativeAssert(test, BorrowProgramSlice(context.program, module, read, 0) == 0,
            "reject borrowed slice with an interface width different from the checked scalar width")
    }
    if !NativeAssert(test, BorrowProgramSlice(context.program, module, read, 2) == 0 &&
        BorrowProgramSlice(context.program, module, read, 64) == 0 &&
        BorrowProgramSlice(context.program, module, HostedBytes("Missing"), 0) == 0 &&
        BorrowProgramSlice(context.program, module, update, 0) == 0,
        "reject unsupported, absent and potentially mutable parameters") { return false }
    if borrow || backend == 2 {
        if !NativeAssert(test,
            (BorrowProgramSlice(context.program, module, read, 0) != 0) == borrow &&
            (BorrowProgramSlice(context.program, module, read, 1) != 0) == borrow,
            "borrow fixed-width scalar slices only on the instruction engine") { return false }
    }
    result: s64; present: s32
    ran := RunProgram(context.program, *result, *present) != 0
    if bounds { return NativeAssert(test, !ran && context.reads == 0, "reject invalid extent before callback") }
    if fail { return NativeAssert(test, !ran && context.reads == 1 && context.updates == 0, "propagate host failure") }
    return NativeAssert(test, ran && present == 1 && result == 23 && context.reads == 2 && context.updates == 1,
        "read nonempty and empty slices, and preserve ordinary mutable copy-back")
}

ScalarSliceCases :: (test: *NativeTest, compiler: string) -> bool {
    source := CheckPath(test.work, "scalar_slice_app.zi")
    output := CheckPath(test.work, "scalar-slice.zx")
    if !NativeWrite(test, source, ScalarSliceApp) { return false }
    entries := string.["main", "bounds"]
    for entry: entries {
        compile := string.[compiler, "--root", test.work, "--entry", CheckConcat("scalar_slice_app:", entry), "-o", output, source]
        if !Build(test, compile[:]) { return false }
        bytes := NativeRead(test, output)
        ordinary := Host.OpenBundleBytes(HostedBytes(bytes), cast(u64)bytes.count)
        defer Host.CloseBundle(ordinary)
        source_input := SourceFixture.{bytes = bytes}
        packed := OpenEngineReadAt(cast(u64)bytes.count, ReadSourceFixture, cast(*void)*source_input, null, ReallocFixture)
        defer Host.CloseBundle(packed)
        if !NativeAssert(test, ordinary != null && packed != null, "open scalar slice image with both readers") { return false }
        bounds := entry == "bounds"
        bundles: [2]*void = .[ordinary, packed]
        for bundle: bundles {
            if !ScalarSliceCase(test, bundle, 1, false, bounds = bounds) ||
                !ScalarSliceCase(test, bundle, 1, true, bounds = bounds) { return false }
            if !bounds && !ScalarSliceCase(test, bundle, 1, true, fail = true) { return false }
        }
        if Host.GetBundleNativeProblem(ordinary) == "" &&
            !ScalarSliceCase(test, ordinary, 2, false, bounds = bounds) { return false }
    }
    return true
}

PackedArithmeticApp :: #string ZI
host_api :: #system_library "host_api";
Mode :: () -> s32 #foreign host_api;
Observe :: (index: s32, value: s32) -> void #foreign host_api;

Mix :: (value: s32, divisor: s32, shift: s32) -> s32 {
    narrow := cast(s8)value
    multiplied := value * 13 + 2147483647
    shifted := (-multiplied) >> shift
    return (shifted / divisor) ^ (multiplied % divisor) ^ (cast(s32)narrow * 589)
}

main :: () -> s32 {
    mode := Mode()
    words: [2]s32
    words[0] = 92372101
    for index: cast(s32)0..11 {
        divisor: s32 = 19
        shift: s32 = 5
        slot: s64 = 0
        if index == 7 {
            if mode == 1 { divisor = 0 }
            if mode == 2 { shift = 32 }
            if mode == 4 { slot = 2 }
            if mode == 0 { divisor = -1 }
        }
        value := Mix(words[0], divisor, shift)
        wider := cast(s64)value + 4294967296
        if (wider & 256) != 0 { value ^= 32767 }
        view := words[:]
        view[slot] = value
        Observe(index, words[0])
    }
    return words[0]
}
ZI;

PackedArithmeticState :: struct { mode: s32; calls: s32; checksum: u64; inspect: bool; executable: s64 }
PackedArithmeticResult :: struct { ran: bool; present: s32; value: s64; calls: s32; checksum: u64 }

AnonymousExecutableMappings :: () -> s64 {
    maps, read := ReadEntireFile("/proc/self/maps")
    if !read { return -1 }
    lines := TextLines(maps)
    defer VecFree(lines)
    count: s64 = 0
    for line: lines {
        permissions := TextFind(line, " ")
        if permissions < 0 { continue }
        fields := line[permissions + 1:]
        if !TextHasPrefix(fields, "r-xp ") { continue }
        inode := TextFind(fields, " 00:00 0")
        if inode >= 0 && TextTrim(fields[inode + 8:]) == "" { count += 1 }
    }
    return count
}

#program_export
PackedArithmeticMode :: (opaque: *void, module: *u8, name: *u8, args: *Host.HostValue,
    count: s32, result: *Host.HostValue) -> s32 {
    if count != 0 { return 0 }
    state := cast(*PackedArithmeticState)opaque
    result.kind = cast(s32)Host.HostValueKind.HostInteger
    result.integer = state.mode
    return 1
}

#program_export
PackedArithmeticObserve :: (opaque: *void, module: *u8, name: *u8, args: *Host.HostValue,
    count: s32, result: *Host.HostValue) -> s32 {
    state := cast(*PackedArithmeticState)opaque
    if count != 2 || args[0].integer != cast(s64)state.calls { return 0 }
    state.checksum = state.checksum * 16777619 ^ args[1].bits
    state.calls += 1
    if state.inspect && state.calls == 7 { state.executable = AnonymousExecutableMappings() }
    return cast(s32)(state.mode != 3 || state.calls != 8)
}

RunPackedArithmetic :: (test: *NativeTest, bundle: *void, mode: s32, steps: s32,
    backend: s32 = 1, inspect: bool = false) -> PackedArithmeticResult {
    config := LoaderConfig.{options = .{backend, steps, 0}}
    loader := OpenLoader(*config)
    defer CloseLoader(loader)
    state := PackedArithmeticState.{mode = mode, inspect = inspect}
    module := HostedBytes("packed_arithmetic")
    bindings := Host.HostBinding.[.{module, HostedBytes("Mode"), PackedArithmeticMode, cast(*void)*state},
        .{module, HostedBytes("Observe"), PackedArithmeticObserve, cast(*void)*state}]
    program := OpenProgram(loader, bundle, *bindings[0], cast(usize)bindings.count)
    output: PackedArithmeticResult
    if !NativeAssert(test, program != null, "open packed arithmetic instance") { return output }
    before := ifx inspect then AnonymousExecutableMappings() else -1
    output.ran = RunProgram(program, *output.value, *output.present) != 0
    output.calls = state.calls
    output.checksum = state.checksum
    CloseProgram(program)
    if inspect {
        unused NativeAssert(test, before >= 0 && state.executable > before &&
            AnonymousExecutableMappings() == before, "hot packed code is executable and released after close")
    }
    return output
}

SamePackedArithmetic :: (left: PackedArithmeticResult, right: PackedArithmeticResult) -> bool {
    return left.ran == right.ran && left.present == right.present && left.value == right.value &&
        left.calls == right.calls && left.checksum == right.checksum
}

PackedArithmeticCases :: (test: *NativeTest, compiler: string) -> bool {
    source := CheckPath(test.work, "packed_arithmetic.zi")
    output := CheckPath(test.work, "packed-arithmetic.zx")
    if !NativeWrite(test, source, PackedArithmeticApp) { return false }
    compile := string.[compiler, "--root", test.work, "--entry", "packed_arithmetic:main", "-o", output, source]
    if !Build(test, compile[:]) { return false }
    bytes := NativeRead(test, output)
    ordinary := Host.OpenBundleBytes(HostedBytes(bytes), cast(u64)bytes.count)
    defer Host.CloseBundle(ordinary)
    input := SourceFixture.{bytes = bytes}
    packed := OpenEngineReadAt(cast(u64)bytes.count, ReadSourceFixture, cast(*void)*input, null, ReallocFixture)
    defer Host.CloseBundle(packed)
    if !NativeAssert(test, ordinary != null && packed != null, "open packed arithmetic fixture") { return false }
    expected_calls := s32.[12, 7, 7, 8, 7]
    inspect := EnvironmentText("ZIRAN_TEST_I386_BLOCKS") == "1"
    for mode: cast(s32)0..4 {
        expected := RunPackedArithmetic(test, ordinary, mode, 6000)
        actual := RunPackedArithmetic(test, packed, mode, 6000, inspect = inspect && mode == 0)
        if !NativeAssert(test, expected.ran == (mode == 0) && expected.calls == expected_calls[mode] &&
            SamePackedArithmetic(expected, actual), "packed arithmetic, checked failure and host-effect parity") { return false }
        if mode == 0 && Host.GetBundleNativeProblem(ordinary) == "" {
            native := RunPackedArithmetic(test, ordinary, mode, 6000, backend = 2)
            if !NativeAssert(test, SamePackedArithmetic(expected, native), "native arithmetic and host-effect parity") { return false }
        }
    }
    for steps: s32.[8, 25, 60, 120, 200, 300, 500, 1000] {
        expected := RunPackedArithmetic(test, ordinary, 0, steps)
        actual := RunPackedArithmetic(test, packed, 0, steps)
        if !NativeAssert(test, SamePackedArithmetic(expected, actual), "packed arithmetic fuel boundary parity") { return false }
    }
    return !test.failed
}

PackedSourceCase :: (test: *NativeTest, compiler: string) -> bool {
    source := CheckPath(test.work, "packed_source.zi")
    output := CheckPath(test.work, "packed-source.zx")
    text: Vec(u8)
    defer VecFree(text)
    if !BuilderAppend(text, "step_z :: () -> s32 { return 0 }\n") { return false }
    // Many small reachable functions let the reader reuse one scratch body.
    suffixes := "zabcdefghijklmnopqrstuvwx"
    for index: 1..suffixes.count - 1 {
        if !BuilderAppend(text, "step_") || !BuilderAppend(text, suffixes[index:index + 1]) ||
            !BuilderAppend(text, " :: () -> s32 {\n    value := step_") ||
            !BuilderAppend(text, suffixes[index - 1:index]) || !BuilderAppend(text,
                "()\n    if (value & 1) == 0 { return value + 3 }\n    return value - 1\n}\n") { return false }
    }
    if !BuilderAppend(text, "main :: () -> s32 { return step_x() }\n") ||
        !NativeWrite(test, source, TextView(text[:])) { return false }
    compile := string.[compiler, "--root", test.work, "--entry", "packed_source:main", "-o", output, source]
    if !Build(test, compile[:]) { return false }
    bytes := NativeRead(test, output)
    ordinary := Host.OpenBundleBytes(HostedBytes(bytes), cast(u64)bytes.count)
    defer Host.CloseBundle(ordinary)
    source_input := SourceFixture.{bytes = bytes}
    packed := OpenEngineReadAt(cast(u64)bytes.count, ReadSourceFixture, cast(*void)*source_input, null, ReallocFixture)
    defer Host.CloseBundle(packed)
    if !NativeAssert(test, ordinary != null && packed != null, "verify a multi-function image with both readers") { return false }
    ordinary_id: [32]u8; packed_id: [32]u8
    CodeIdentity(ordinary, *ordinary_id[0])
    CodeIdentity(packed, *packed_id[0])
    if !NativeAssert(test, TextView(ordinary_id[:]) == TextView(packed_id[:]), "preserve the multi-function image identity") { return false }
    config := LoaderConfig.{options = .{1, 2000, 0}}
    loader := OpenLoader(*config)
    defer CloseLoader(loader)
    bundles: [2]*void = .[ordinary, packed]
    for bundle: bundles {
        program := OpenProgram(loader, bundle, null, 0)
        defer CloseProgram(program)
        result: s64; present: s32
        if !NativeAssert(test, program != null && RunProgram(program, *result, *present) != 0 &&
            present == 1 && result == 24, "both readers preserve cross-function calls and branching") { return false }
    }
    return true
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "zx-module-hosted-")
    if test.failed || (argc != 4 && argc != 5) { return 1 }
    defer NativeCleanup(*test)
    if argc == 5 {
        bytes := NativeRead(*test, TextFromCString(argv[4]))
        bundle := Host.OpenBundleBytes(HostedBytes(bytes), cast(u64)bytes.count)
        defer Host.CloseBundle(bundle)
        if !NativeAssert(*test, bundle != null, "open verified slice declaration fixture") ||
            !ScalarSliceCase(*test, bundle, 1, false, mismatched_type = true) { return 1 }
        return 0
    }
    compiler := CheckPath(PathParent(test.ziran), "zi2zx")
    std := CheckPath(test.repo, "std")
    bridge := TextFromCString(argv[3])
    if !HostedCases(*test, compiler, std, bridge) || !FuelCases(*test, compiler) ||
        !CancellationCases(*test, compiler, std) ||
        !BorrowCases(*test, compiler) || !ScalarSliceCases(*test, compiler) ||
        !PackedArithmeticCases(*test, compiler) || !PackedSourceCase(*test, compiler) { return 1 }
    return 0
}
}

#if !#defined(ZX_MODULE_HOSTED_TEST) {
using Bundle :: #import "compiler_bundle"
using Link :: #import "compiler_exec_link"
using Lir :: #import "compiler_lowered_ir"

Provider :: (test: *NativeTest, compiler: string, fixtures: string, path: string, source: string) -> bool {
    command := string.[compiler, "--module-path", fixtures, "--library", "demo/counter", "--export", "counter:Add", "--export", "counter:Echo",
        "--export", "counter:Move", "--export", "counter:Reset", "-o", path, source]
    return Build(test, command[:])
}

Reject :: (test: *NativeTest, command: []string, expected: string) -> bool {
    result := NativeInvoke(test, command)
    return NativeAssert(test, result.code != 0 && result.output == "" && TextContains(result.error, expected),
        CheckConcat(expected, CheckConcat("\n", CheckConcat(result.output, result.error))))
}

Reframe :: (test: *NativeTest, source: string, output: string, linkage: string, rename_scalar: bool = false) -> bool {
    data, found := ReadEntireFile(source)
    if !NativeAssert(test, found, "read verified ZX fixture") { return false }
    no_assets: []Bundle.Asset
    empty: []u8
    layout := Bundle.ExecutableDecode(data, no_assets)
    owner: Link.ZxExecOwner
    defer Link.ZxExecReadFree(*owner)
    read := Link.ZxExecRead(*owner, data, Lir.LirDefaultLimits())
    if !NativeAssert(test, read.problem == .None && layout.problem == .None, "decode fixture for linkage rewrite") { return false }
    program := Link.ZxExecReadProgram(*owner)
    interface := layout.interface
    if rename_scalar {
        if !NativeAssert(test, TextContains(interface, "[]u32"), "fixture declares a u32 slice") { return false }
        interface = TextDetach(TextReplace(interface, "u32", "u64"))
    }
    measured := Link.ZxExecWriteModule(program, no_assets, empty, interface, false, linkage)
    bytes: Vec(u8)
    defer VecFree(bytes)
    if !NativeAssert(test, measured.problem == .None && VecResize(bytes, measured.size), "measure new linkage") { return false }
    written := Link.ZxExecWriteModule(program, no_assets, bytes[:], interface, false, linkage)
    return NativeAssert(test, written.problem == .None, "encode new linkage with valid identity") &&
        NativeWrite(test, output, TextView(bytes[:]))
}

TryWasm :: (test: *NativeTest, fixtures: string, application: string, chain: string) -> bool {
    library := EnvironmentText("ZIRAN_ZX_MODULE_WASM_LIBRARY")
    if library == "" { return true }
    emcc := EnvironmentText("ZIRAN_WASM_EMCC")
    if emcc == "" { emcc = "emcc" }
    runner := CheckPath(test.work, "wasm-host.js")
    compile := string.[emcc, "-O2", "-std=gnu11", "-I", CheckPath(test.repo, "include"),
        CheckPath(fixtures, "embed.c"), library, "-s", "ENVIRONMENT=node", "-s", "NODERAWFS=1",
        "-s", "ALLOW_MEMORY_GROWTH=1", "-s", "STACK_SIZE=1048576", "-o", runner]
    if !Build(test, compile[:]) { return false }
    programs := string.[application, chain]
    for program: programs[:] {
        run := string.["node", runner, test.work, program, "wasm"]
        result := NativeInvoke(test, run[:])
        if !NativeAssert(test, result.code == 0 && result.output == "42\n",
            CheckConcat("Wasm module execution: ", CheckConcat(result.output, result.error))) { return false }
    }
    return true
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "zx-module-runtime-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    compiler := CheckPath(PathParent(test.ziran), "zi2zx")
    fixtures := CheckPath(test.repo, "tests/fixtures/zx_module_runtime")
    counter := CheckPath(fixtures, "counter.zi")
    app := CheckPath(fixtures, "application.zi")
    std := CheckPath(test.repo, "std")
    library := CheckPath(test.work, "demo/counter.zx")
    replacement_source := CheckPath(test.work, "counter.zi")
    compatible := CheckPath(test.work, "counter-next.zx")
    incompatible := CheckPath(test.work, "counter-incompatible.zx")
    application := CheckPath(test.work, "app.zx")
    if !NativeAssert(*test, CreateDirectories(PathParent(library)), "create module search root") { return 1 }
    replacement, found := ReadEntireFile(CheckPath(fixtures, "replacement.zi.in"))
    if !NativeAssert(*test, found, "read replacement source") || !NativeWrite(*test, replacement_source, replacement) { return 1 }
    if !Provider(*test, compiler, fixtures, library, counter) ||
       !Provider(*test, compiler, fixtures, compatible, replacement_source) { return 1 }
    bad := string.[compiler, "--library", "demo/counter", "--export", "counter:Add", "-o", incompatible, counter]
    if !Build(*test, bad[:]) { return 1 }
    compile := string.[compiler, "--root", fixtures, "--module-path", std, "--entry", "application:main",
        "--require-module", "Counter.v1=demo/counter", "--import", "application:AddExternal=Counter.v1:Add",
        "--import", "application:EchoExternal=Counter.v1:Echo", "--import", "application:MoveExternal=Counter.v1:Move",
        "--import", "application:ResetExternal=Counter.v1:Reset", "-o", application, app]
    if !Build(*test, compile[:]) { return 1 }
    bridge := string.[compiler, "--root", fixtures, "--module-path", std, "--library", "demo/bridge",
        "--export", "bridge:Total", "--require-module", "Counter.v1=demo/counter",
        "--import", "bridge:AddExternal=Counter.v1:Add", "-o", CheckPath(test.work, "demo/bridge.zx"),
        CheckPath(fixtures, "bridge.zi")]
    chain := CheckPath(test.work, "chain.zx")
    chain_build := string.[compiler, "--root", fixtures, "--module-path", std, "--entry", "chain:main",
        "--require-module", "Bridge.v1=demo/bridge", "--import", "chain:TotalExternal=Bridge.v1:Total",
        "-o", chain, CheckPath(fixtures, "chain.zi")]
    if !Build(*test, bridge[:]) || !Build(*test, chain_build[:]) { return 1 }
    platform := string.["uname", "-s"]
    host := NativeInvoke(*test, platform[:])
    if !NativeAssert(*test, host.code == 0, "read test host platform") { return 1 }
    backends := string.["engine", "native"]
    tier_count: s64 = ifx host.output == "Linux\n" then 2 else 1
    for backend: backends[0:tier_count] {
        run := string.[compiler, "run", "--backend", backend, "--module-root", test.work, application]
        result := NativeInvoke(*test, run[:])
        if !NativeAssert(*test, result.code == 0 && result.output == "42\n",
            CheckConcat(backend, CheckConcat(": ", CheckConcat(result.output, result.error)))) { return 1 }
        run[6] = chain
        result = NativeInvoke(*test, run[:])
        if !NativeAssert(*test, result.code == 0 && result.output == "42\n",
            CheckConcat("nested module invocation: ", CheckConcat(result.output, result.error))) { return 1 }
    }
    forwarded := string.[test.ziran, "run", "--module-root", test.work, application]
    result := NativeInvoke(*test, forwarded[:])
    if !NativeAssert(*test, result.code == 0 && result.output == "42\n", result.error) { return 1 }
    source_run := string.[compiler, "run", "--backend", "engine", "--module-root", test.work,
        "--root", fixtures, "--module-path", std, "--entry", "application:main",
        "--require-module", "Counter.v1=demo/counter", "--import", "application:AddExternal=Counter.v1:Add",
        "--import", "application:EchoExternal=Counter.v1:Echo", "--import", "application:MoveExternal=Counter.v1:Move",
        "--import", "application:ResetExternal=Counter.v1:Reset", app]
    result = NativeInvoke(*test, source_run[:])
    if !NativeAssert(*test, result.code == 0 && result.output == "42\n", CheckConcat(result.output, result.error)) { return 1 }
    if !TryWasm(*test, fixtures, application, chain) { return 1 }
    tests := CheckPath(test.repo, "tests")
    hosted_build := CheckPath(test.work, "hosted-build")
    hosted := string.[test.ziran, "build", "--target=c", "--define", "ZX_MODULE_HOSTED_TEST", "--root", tests,
        "--exe", "--entry", "zx_module_runtime_cases:main", "-o", hosted_build, CheckPath(tests, "zx_module_runtime_cases.zi")]
    guest := string.[CheckPath(hosted_build, "zx_module_runtime_cases"), test.ziran, CheckPath(test.work, "hosted"),
        CheckPath(test.work, "demo/bridge.zx")]
    if !Build(*test, hosted[:]) || !Build(*test, guest[:]) { return 1 }
    wrong_slice := CheckPath(test.work, "wrong-slice.zx")
    wrong_slice_run := string.[guest[0], guest[1], guest[2], guest[3], wrong_slice]
    if !Reframe(*test, CheckPath(test.work, "hosted/scalar-slice.zx"), wrong_slice, "", rename_scalar = true) ||
        !Build(*test, wrong_slice_run[:]) { return 1 }

    stale := CheckPath(test.work, "stale.zx")
    stale_build := string.[compiler, "--root", fixtures, "--module-path", std, "--entry", "application:stale",
        "--require-module", "Counter.v1=demo/counter", "--import", "application:AddExternal=Counter.v1:Add", "-o", stale, app]
    stale_run := string.[compiler, "run", "--backend", "engine", "--module-root", test.work, stale]
    if !Build(*test, stale_build[:]) || !Reject(*test, stale_run[:], "invalid ZX module handle") { return 1 }
    wrong := CheckPath(test.work, "wrong.zx")
    wrong_build := string.[compiler, "--root", fixtures, "--module-path", std, "--entry", "mismatch:main",
        "--require-module", "Counter.v1=demo/counter", "--import", "mismatch:WrongExternal=Counter.v1:Add",
        "-o", wrong, CheckPath(fixtures, "mismatch.zi")]
    wrong_run := string.[compiler, "run", "--backend", "engine", "--module-root", test.work, wrong]
    if !Build(*test, wrong_build[:]) || !Reject(*test, wrong_run[:], "import signature mismatch") { return 1 }

    malformed := CheckPath(test.work, "malformed.zx")
    if !Reframe(*test, application, malformed, "require\tCounter.v1\tdemo/../counter\n") { return 1 }
    malformed_run := string.[compiler, "run", "--backend", "engine", "--module-root", test.work, malformed]
    if !Reject(*test, malformed_run[:], "invalid ZX module linkage") { return 1 }
    missing := string.[compiler, "run", "--backend", "engine", "--module-root", CheckPath(test.work, "missing"), application]
    if !Reject(*test, missing[:], "ZX module not found") { return 1 }
    other := CheckPath(test.work, "other")
    shadow := CheckPath(other, "demo/counter.zx")
    if !NativeAssert(*test, CreateDirectories(PathParent(shadow)), "create second module root") ||
       !Provider(*test, compiler, fixtures, shadow, counter) { return 1 }
    ambiguity := string.[compiler, "run", "--backend", "engine", "--module-root", test.work,
        "--module-root", other, application]
    if !Reject(*test, ambiguity[:], "ambiguous ZX module") { return 1 }
    cycle := string.[compiler, "--library", "demo/counter", "--export", "counter:Add", "--require-module",
        "Self=demo/counter", "-o", shadow, counter]
    cyclic := string.[compiler, "run", "--backend", "engine", "--module-root", other, application]
    if !Build(*test, cycle[:]) || !Reject(*test, cyclic[:], "ZX module dependency cycle") { return 1 }
    return 0
}
}
