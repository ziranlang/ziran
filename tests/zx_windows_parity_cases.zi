// Windows x86-64 parity for native executables. Every revision-28 parity
// program (tests/zx_parity_list.zi) lowers to ZX once, and zx2native writes
// it as a Linux ELF and as a Windows PE32+ .exe. The .exe runs under Wine
// with a private prefix in build/ and no display, and must print what the
// ELF prints and exit with its status, traps included. Both executables are
// reproducible. Every .exe keeps W^X sections, is ASLR- and NX-ready, and
// its base relocations reach only addresses inside its image; hello.exe
// imports exactly GetStdHandle, WriteFile and ExitProcess, and a program
// that prints nothing imports only ExitProcess.
//
// Wine is WINE, or wine on PATH. Without it the test is skipped, unless
// WINDOWS_REQUIRED=1, as in CI.
#import "native_test"
#import "zx_parity_list"
#import "check_cache"
#import "check_support"
#import "std/environment_linux"
#import "std/file"
#import "std/file_tree_linux"
#import "std/text_tools"
using Vectors :: #import "std/vec"

Little :: (bytes: string, at: s64, count: s64) -> u64 {
    value: u64 = 0
    for index: cast(s64)0..count - 1 { value = value | (cast(u64)bytes[at + index] << cast(u64)(index * 8)) }
    return value
}

PeFile :: struct { bytes: string; sections: s64; table: s64 }

// The file offset of RVA inside a section's stored bytes, or -1.
PeOffset :: (pe: PeFile, rva: u64) -> s64 {
    for index: cast(s64)0..pe.sections - 1 {
        at := pe.table + index * 40
        address := Little(pe.bytes, at + 12, 4)
        raw := Little(pe.bytes, at + 16, 4)
        if rva >= address && rva < address + raw {
            return cast(s64)(Little(pe.bytes, at + 20, 4) + rva - address)
        }
    }
    return -1
}

PeName :: (pe: PeFile, at: s64) -> string {
    end := at
    while end >= 0 && end < pe.bytes.count && pe.bytes[end] != cast(u8)0 { end += 1 }
    if at < 0 || end >= pe.bytes.count { return "" }
    return pe.bytes[at:end]
}

// The start of the section named NAME that holds FILE, or -1.
PeSection :: (pe: PeFile, file: s64, name: string) -> s64 {
    for index: cast(s64)0..pe.sections - 1 {
        at := pe.table + index * 40
        if PeName(pe, at) != name { continue }
        raw := cast(s64)Little(pe.bytes, at + 16, 4)
        start := cast(s64)Little(pe.bytes, at + 20, 4)
        if file >= start && file < start + raw { return start }
    }
    return -1
}

// Checks the exception directory: .pdata entries sorted and inside .text,
// each naming a version-1 .xdata record whose frame codes match the bytes
// at the function's start. Returns the entry count, or -1.
PeUnwind :: (test: *NativeTest, path: string, pe: PeFile, optional: s64) -> s64 {
    bytes := pe.bytes
    directory := cast(s64)Little(bytes, optional + 136, 4)
    size := cast(s64)Little(bytes, optional + 140, 4)
    if size == 0 {
        if !NativeAssert(test, directory == 0, CheckConcat(path, ": an empty exception directory has an address")) {
            return -1
        }
        return 0
    }
    table := PeOffset(pe, cast(u64)directory)
    if !NativeAssert(test, size % 12 == 0 && table >= 0 && table + size <= bytes.count,
        CheckConcat(path, ": the exception directory is outside the file")) { return -1 }
    if !NativeAssert(test, PeSection(pe, table, ".pdata") >= 0,
        CheckConcat(path, ": .pdata entries are not in a .pdata section")) { return -1 }
    previous: u64 = 0

    for index: cast(s64)0..size / 12 - 1 {
        at := table + index * 12
        begin := Little(bytes, at, 4)
        end := Little(bytes, at + 4, 4)
        info := Little(bytes, at + 8, 4)
        if !NativeAssert(test, begin >= previous && begin < end,
            CheckConcat(path, ": .pdata entries are not sorted")) { return -1 }
        previous = begin
        code := PeOffset(pe, begin)
        if !NativeAssert(test, code >= 0 && PeSection(pe, code, ".text") >= 0 &&
            PeOffset(pe, end - 1) == code + cast(s64)(end - begin) - 1,
            CheckConcat(path, ": a .pdata entry is not inside .text")) { return -1 }
        record := PeOffset(pe, info)
        if !NativeAssert(test, record >= 0 && PeSection(pe, record, ".xdata") >= 0,
            CheckConcat(path, ": an unwind record is not inside .xdata")) { return -1 }
        version := Little(bytes, record, 1) & 7
        flags := Little(bytes, record, 1) >> 3
        prologue := Little(bytes, record + 1, 1)
        count := Little(bytes, record + 2, 1)
        frame := Little(bytes, record + 3, 1)
        if !NativeAssert(test, version == 1 && flags == 0 && prologue >= 4 && prologue <= 255 &&
            count >= 2 && count <= 5 && (frame & 15) == 5,
            CheckConcat(path, ": a malformed unwind record")) { return -1 }
        if !NativeAssert(test, record + 4 + cast(s64)count * 2 <= bytes.count,
            CheckConcat(path, ": unwind codes run past the file")) { return -1 }
        push: s64 = -1
        setfp: s64 = -1
        alloc: s64 = -1
        offset: u64 = 256
        slot: s64 = 0
        while slot < cast(s64)count {
            at_code := record + 4 + slot * 2
            code_offset := Little(bytes, at_code, 1)
            operation := Little(bytes, at_code + 1, 1)
            opcode := operation & 15
            if !NativeAssert(test, code_offset <= offset && code_offset <= prologue,
                CheckConcat(path, ": unwind codes are not in prologue order")) { return -1 }
            offset = code_offset
            if opcode == 0 {
                if (operation >> 4) == 5 { push = cast(s64)code_offset }
                slot += 1
            } else if opcode == 3 {
                if (operation >> 4) == 0 { setfp = cast(s64)code_offset }
                slot += 1
            } else if opcode == 2 {
                alloc = cast(s64)code_offset
                slot += 1
            } else if opcode == 1 {
                alloc = cast(s64)code_offset
                slot += ifx (operation >> 4) == 1 then 3 else 2
            } else {
                if !NativeAssert(test, false, CheckConcat(path, ": an unknown unwind opcode")) { return -1 }
            }
        }
        if !NativeAssert(test, push >= 1 && setfp == push + 3 && bytes[code + push - 1] == cast(u8)0x55 &&
            bytes[code + setfp - 3] == cast(u8)0x48 && bytes[code + setfp - 2] == cast(u8)0x89 &&
            bytes[code + setfp - 1] == cast(u8)0xe5,
            CheckConcat(path, ": the frame codes do not match the function's prologue")) { return -1 }
        if !NativeAssert(test, alloc < 0 || alloc == setfp + 4 || alloc == setfp + 7,
            CheckConcat(path, ": the stack allocation does not follow the frame")) { return -1 }
    }
    return size / 12
}

// Checks PATH's PE32+ structure. A non-empty IMPORTS must be its exact
// kernel32 import list, in order.
PeCheck :: (test: *NativeTest, path: string, imports: []string, unwind: *s64) -> bool {
    bytes, valid := ReadEntireFile(path)
    if !NativeAssert(test, valid && bytes.count >= 512 && bytes[0] == cast(u8)77 && bytes[1] == cast(u8)90,
        CheckConcat(path, ": not an MZ image")) { return false }
    header := cast(s64)Little(bytes, 60, 4)
    optional := header + 24
    if !NativeAssert(test, header > 0 && header + 24 + 240 <= bytes.count &&
        Little(bytes, header, 4) == 0x4550 && Little(bytes, header + 4, 2) == 0x8664 &&
        Little(bytes, optional, 2) == 0x20b, CheckConcat(path, ": not a PE32+ AMD64 image")) { return false }
    pe := PeFile.{bytes = bytes, sections = cast(s64)Little(bytes, header + 6, 2),
        table = optional + cast(s64)Little(bytes, header + 20, 2)}
    image_base := Little(bytes, optional + 24, 8)
    image_size := Little(bytes, optional + 56, 4)
    if !NativeAssert(test, (Little(bytes, optional + 70, 2) & 0x0160) == 0x0160,
        CheckConcat(path, ": not DYNAMIC_BASE, HIGH_ENTROPY_VA and NX_COMPAT")) { return false }
    for index: cast(s64)0..pe.sections - 1 {
        flags := Little(bytes, pe.table + index * 40 + 36, 4)
        if !NativeAssert(test, (flags & 0x20000000) == 0 || (flags & 0x80000000) == 0,
            CheckConcat(path, ": a section is writable and executable")) { return false }
    }

    // One kernel32 descriptor; its lookup table names the imports.
    descriptor := PeOffset(pe, Little(bytes, optional + 120, 4))
    names: Vec(string)
    if descriptor >= 0 {
        dll := PeOffset(pe, Little(bytes, descriptor + 12, 4))
        thunk := PeOffset(pe, Little(bytes, descriptor, 4))
        if !NativeAssert(test, dll >= 0 && thunk >= 0 && PeName(pe, dll) == "KERNEL32.dll" &&
            Little(bytes, descriptor + 32, 4) == 0, CheckConcat(path, ": not one kernel32 import descriptor")) { return false }
        while Little(bytes, thunk, 8) != 0 {
            entry := PeOffset(pe, Little(bytes, thunk, 8))
            if !NativeAssert(test, entry >= 0, CheckConcat(path, ": an import name is outside the file")) { return false }
            VecPush(names, PeName(pe, entry + 2))
            thunk += 8
        }
    }
    if imports.count > 0 {
        same := names.count == imports.count
        for index: cast(s64)0..names.count - 1 { same = same && names[index] == imports[index] }
        if !NativeAssert(test, same, CheckConcat(path, CheckConcat(": imports ", TextDetach(TextJoin(names[:], ", "))))) {
            return false
        }
    }

    // A base relocation directory, even with no fixups, keeps the image
    // rebased; every DIR64 fixup holds an address inside the image.
    at := PeOffset(pe, Little(bytes, optional + 152, 4))
    end := at + cast(s64)Little(bytes, optional + 156, 4)
    if !NativeAssert(test, at >= 0 && end >= at + 8, CheckConcat(path, ": no base relocation directory")) { return false }
    while at >= 0 && at < end {
        page := Little(bytes, at, 4)
        block := cast(s64)Little(bytes, at + 4, 4)
        if !NativeAssert(test, block >= 8 && at + block <= end, CheckConcat(path, ": a malformed relocation block")) { return false }
        for entry: cast(s64)0..(block - 8) / 2 - 1 {
            value := Little(bytes, at + 8 + entry * 2, 2)
            if (value >> cast(u64)12) == 0 { continue }
            field := PeOffset(pe, page + (value & 4095))
            target := ifx field >= 0 then Little(bytes, field, 8) else cast(u64)0
            if !NativeAssert(test, (value >> cast(u64)12) == 10 && field >= 0 &&
                target >= image_base && target < image_base + image_size,
                CheckConcat(path, ": a base relocation is not an address inside the image")) { return false }
        }
        at += block
    }
    entries := PeUnwind(test, path, pe, optional)
    if entries < 0 { return false }
    <<unwind = entries
    return true
}

// Writes ZX as a Linux ELF and twice as a Windows .exe, which must agree.
Executables :: (test: *NativeTest, tools: string, zx: string, elf: string, exe: string) -> bool {
    zx2native := CheckPath(tools, "zx2native")
    again := CheckConcat(exe, ".again")
    elf_build := string.[zx2native, "-o", elf, zx]
    exe_build := string.[zx2native, "--target", "x86_64", "--platform", "windows", "-o", exe, zx]
    repeat := string.[zx2native, "--target", "x86_64", "--platform", "windows", "-o", again, zx]
    built := NativeInvoke(test, elf_build[:])
    if !NativeAssert(test, built.code == 0, CheckConcat(zx, CheckConcat(": native ELF output failed: ", built.error))) { return false }
    built = NativeInvoke(test, exe_build[:])
    if !NativeAssert(test, built.code == 0, CheckConcat(zx, CheckConcat(": Windows output failed: ", built.error))) { return false }
    unused NativeRun(test, repeat[:])
    same := string.["cmp", "-s", exe, again]
    return NativeAssert(test, NativeInvoke(test, same[:]).code == 0, CheckConcat(zx, ": one ZX gave two different .exe files"))
}

Excerpt :: (text: string) -> string { return text[0:ifx text.count > 300 then 300 else text.count] }

// Runs EXE under Wine and ELF natively; they must print and exit alike.
Agrees :: (test: *NativeTest, wine: string, label: string, elf: string, exe: string) -> NativeCommand {
    native := string.[elf]
    emulated := string.["env", "-u", "TMPDIR", wine, exe]
    reference := NativeInvoke(test, native[:])
    actual := NativeInvoke(test, emulated[:])
    parts := string.[label, ": under Wine status ", CheckNumber(actual.code), " (Linux ", CheckNumber(reference.code),
        "), output ", Excerpt(actual.output), ", errors ", Excerpt(actual.error)]
    unused NativeAssert(test, actual.output == reference.output && actual.code == reference.code,
        TextDetach(TextJoin(parts[:], "")))
    return reference
}

// Real named DLL imports, two providers, Win64 register/stack placement,
// aggregate arguments, floating results and narrow signed/unsigned results.
WindowsHosts :: (test: *NativeTest, tools: string, wine: string) -> bool {
    selected := EnvironmentText("WIN64_CC")
    cc := CheckExecutable(ifx selected != "" then selected else "x86_64-w64-mingw32-gcc")
    if cc == "" {
        print("SKIP: Windows host DLL test needs MinGW\n")
        return EnvironmentText("WINDOWS_REQUIRED") != "1"
    }
    source := CheckPath(test.work, "host.c")
    unused NativeWrite(test, source, "#include <stdint.h>\n#include <stdbool.h>\ntypedef struct { const char *data; int64_t length; } Text;\nstatic int32_t state;\n__declspec(dllexport) bool ZxWindowOpenHost(Text title, int32_t w, int32_t h) { return title.length == 7 && title.data[0] == 'p' && title.data[6] == 't' && w == 123 && h == 234; }\n__declspec(dllexport) int64_t Scalars(int8_t a, uint8_t b, int32_t c, uint32_t d, int64_t e, int64_t f) { return a == -3 && b == 250 && c == -30000 && d == 4000000000u && e == 5000000000LL && f == -6000000000LL ? 42 : 0; }\n__declspec(dllexport) double Mixed(int32_t a, float b, Text t, double c, int32_t e, float f) { return a == 17 && b == 1.5f && t.length == 7 && t.data[1] == 'e' && c == 2.25 && e == 23 && f == 3.5f ? 42.5 : 0; }\n__declspec(dllexport) int8_t Narrow(void) { return -7; }\n__declspec(dllexport) uint8_t Unsigned(void) { return 250; }\n__declspec(dllexport) void Note(int32_t n) { state = n; }\n__declspec(dllexport) int32_t Counter(void) { return state; }\n__declspec(dllexport) Text Bad(void) { Text t = {0}; return t; }\n")
    dll := CheckPath(test.work, "host.dll")
    compile := string.[cc, "-shared", "-O2", source, "-o", dll]
    unused NativeRun(test, compile[:])
    second := CheckPath(test.work, "second.c")
    unused NativeWrite(test, second, "__declspec(dllexport) int Second(void) { return 19; }\n__declspec(dllexport) int Counter(void) { return 99; }\n")
    dll2 := CheckPath(test.work, "second.dll")
    compile2 := string.[cc, "-shared", "-O2", second, "-o", dll2]
    unused NativeRun(test, compile2[:])
    if test.failed { return false }
    registrations := CheckPath(test.work, "hosts")
    unused NativeWrite(test, CheckPath(registrations, "a.library"), CheckConcat(dll, "\n"))
    unused NativeWrite(test, CheckPath(registrations, "b.library"), CheckConcat(dll2, "\n"))
    // Invalid candidates must be inspected as bytes, never loaded, and skipped.
    unused NativeWrite(test, CheckPath(test.work, "invalid.dll"), "MZ\n")
    unused NativeWrite(test, CheckPath(registrations, "0.library"), CheckConcat(CheckPath(test.work, "invalid.dll"), "\n"))
    NativeSet(test, "ZIRAN_HOST_PATH", registrations)
    app := CheckPath(test.work, "hosted.zi")
    declarations := "api :: #system_library \"host_api\";\nZxWindowOpenHost :: (title: string, width: s32, height: s32) -> bool #foreign api;\nScalars :: (a: s8, b: u8, c: s32, d: u32, e: s64, f: s64) -> s64 #foreign api;\nMixed :: (a: s32, b: float32, t: string, c: float64, e: s32, f: float32) -> float64 #foreign api;\nNarrow :: () -> s8 #foreign api;\nUnsigned :: () -> u8 #foreign api;\nNote :: (n: s32) #foreign api;\nCounter :: () -> s32 #foreign api;\nSecond :: () -> s32 #foreign api;\n"
    unused NativeWrite(test, app, CheckConcat(declarations, "main :: () -> s32 {\ntitle := \"pe-host\"\nNote(23)\nif !ZxWindowOpenHost(title, 123, 234) || Scalars(-3, 250, -30000, 4000000000, 5000000000, -6000000000) != 42 || Mixed(17, 1.5, title, 2.25, 23, 3.5) != 42.5 || Narrow() != -7 || Unsigned() != 250 || Second() != 19 || Counter() != 23 { return 1 }\nprint(\"Windows host DLL imports passed\\n\")\nreturn 0\n}\n"))
    zx := CheckPath(test.work, "hosted.zx")
    lower := string.[CheckPath(tools, "zi2zx"), "--root", test.work, "--entry", "hosted:main", "-o", zx, app]
    unused NativeRun(test, lower[:])
    if test.failed { return false }
    exe := CheckPath(test.work, "hosted.exe")
    build := string.[CheckPath(tools, "zx2native"), "--target", "x86_64", "--platform", "windows", "-o", exe, zx]
    unused NativeRun(test, build[:])
    if test.failed { return false }
    execute := string.["env", "-u", "TMPDIR", wine, exe]
    unused NativeExpect(test, execute[:], "Windows host DLL imports passed\n")
    if test.failed { return false }
    // Exact DLL groups and terminating descriptor; import symbols must use
    // names rather than ordinals, and every IAT slot starts as its name RVA.
    bytes := NativeRead(test, exe)
    optional := cast(s64)Little(bytes, 60, 4) + 24
    pe := PeFile.{bytes = bytes, sections = cast(s64)Little(bytes, optional - 18, 2), table = optional + 240}
    descriptor := PeOffset(pe, Little(bytes, optional + 120, 4))
    libraries := string.["KERNEL32.dll", "host.dll", "second.dll", ""]
    for index: cast(s64)0..libraries.count - 1 {
        record := descriptor + index * 20
        dll_name := Little(bytes, record + 12, 4)
        if libraries[index] == "" {
            if !NativeAssert(test, dll_name == 0 && Little(bytes, record, 4) == 0, "missing terminating import descriptor") { return false }
            continue
        }
        if !NativeAssert(test, PeName(pe, PeOffset(pe, dll_name)) == libraries[index], "incorrect host DLL import grouping") { return false }
        lookup := PeOffset(pe, Little(bytes, record, 4))
        address := PeOffset(pe, Little(bytes, record + 16, 4))
        while Little(bytes, lookup, 8) != 0 {
            rva := Little(bytes, lookup, 8)
            if !NativeAssert(test, Little(bytes, address, 8) == rva && PeOffset(pe, rva) >= 0,
                "DLL import is not a hint/name RVA in both tables") { return false }
            lookup += 8; address += 8
        }
        if !NativeAssert(test, Little(bytes, address, 8) == 0, "unterminated IAT") { return false }
    }
    // The map measures the same PE with the same linked hosts.
    map_command := string.[CheckPath(tools, "zx2native"), "--platform", "windows", "--emit", "map", "-o", CheckPath(test.work, "hosted.map"), zx]
    unused NativeRun(test, map_command[:])
    again := CheckPath(test.work, "again.exe")
    repeat := string.[CheckPath(tools, "zx2native"), "--platform", "windows", "-o", again, zx]
    unused NativeRun(test, repeat[:])
    if !NativeAssert(test, NativeSameFile(exe, again), "DLL-linked PE is not deterministic") { return false }
    // An unavailable provider errors before opening output; no engine fallback.
    NativeSet(test, "ZIRAN_HOST_PATH", CheckPath(test.work, "missing-hosts"))
    unused NativeReject(test, build[:], "assembly.gap.machine-host")
    if !NativeAssert(test, NativeSameFile(exe, again), "host gap modified the executable") { return false }
    NativeSet(test, "ZIRAN_HOST_PATH", registrations)
    unused NativeWrite(test, app, "api :: #system_library \"host_api\";\nPair :: struct { a: s64; b: s64 }\nBad :: () -> Pair #foreign api;\nmain :: () -> s32 { value := Bad(); return cast(s32)value.a }\n")
    unused NativeRun(test, lower[:])
    unused NativeReject(test, build[:], "assembly.gap.machine-host-abi")
    return NativeAssert(test, NativeSameFile(exe, again), "ABI gap modified the executable") && !test.failed
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    test := NativeStart(argc, argv, "zx-windows-parity-")
    if test.failed { return 1 }
    defer NativeCleanup(*test)
    selected := EnvironmentText("WINE")
    wine := CheckExecutable(ifx selected != "" then selected else "wine")
    if wine == "" {
        print("SKIP: Windows parity needs Wine\n")
        return ifx EnvironmentText("WINDOWS_REQUIRED") == "1" then 1 else 0
    }
    // A private prefix in build/, kept between runs; no display, Mono or
    // Gecko.
    prefix := CheckPath(test.repo, "build/wine-prefix")
    NativeSet(*test, "WINEPREFIX", prefix)
    NativeSet(*test, "WINEDEBUG", "-all")
    NativeSet(*test, "WINEDLLOVERRIDES", "mscoree,mshtml=")
    // Wine commands start without the check's private TMPDIR: Wine 9.0 run as
    // root (CI containers) aborts with "free(): invalid pointer" whenever
    // TMPDIR is set, and Wine needs none.
    tools := TextDetach(TextCopy(PathParent(test.ziran)))
    zi2zx := CheckPath(tools, "zi2zx")
    std := CheckPath(test.repo, "std")

    // A program that prints nothing exits with its status and imports only
    // ExitProcess.
    app := CheckPath(test.work, "app.zi")
    app_zx := CheckPath(test.work, "app.zx")
    unused NativeWrite(*test, app, "#program_export\nAnswer :: () -> s32 {\n    total: s64 = 0\n    for index: 0..6 { total += index }\n    return cast(s32)total + 21\n}\n")
    quiet := string.[zi2zx, "--root", test.work, "--entry", "app:Answer", "-o", app_zx, app]
    unused NativeRun(*test, quiet[:])
    app_elf := CheckPath(test.work, "app.elf")
    app_exe := CheckPath(test.work, "app.exe")
    if test.failed || !Executables(*test, tools, app_zx, app_elf, app_exe) { return 1 }
    exit_only := string.["ExitProcess"]
    unwind: s64 = 0
    if !PeCheck(*test, app_exe, exit_only[:], *unwind) { return 1 }
    quiet_run := Agrees(*test, wine, "app:Answer", app_elf, app_exe)
    if !NativeAssert(*test, quiet_run.code == 42, "the quiet program did not exit 42") { return 1 }

    cases := ParityCases(test.repo)
    console := string.["ExitProcess", "GetStdHandle", "WriteFile"]
    none: [0]string
    for index: cast(s64)0..cases.count - 1 {
        item := cases[index]
        label := CheckConcat("case-", CheckNumber(index))
        zx := CheckPath(test.work, CheckConcat(label, ".zx"))
        elf := CheckPath(test.work, CheckConcat(label, ".elf"))
        exe := CheckPath(test.work, CheckConcat(label, ".exe"))
        // A trap case is built with --checks, as on every other route.
        lower := string.[zi2zx, "--root", item.root, "-I", std, "--entry", item.entry, "-o", zx, item.file]
        lower_checked := string.[zi2zx, "--checks", "--root", item.root, "-I", std, "--entry", item.entry,
            "-o", zx, item.file]
        unused NativeRun(*test, ifx item.traps then lower_checked[:] else lower[:])
        if test.failed || !Executables(*test, tools, zx, elf, exe) { return 1 }
        expected := ifx item.entry == "hello:main" then console[:] else none[:]
        count: s64 = 0
        if !PeCheck(*test, exe, expected, *count) { return 1 }
        unwind += count
        reference := Agrees(*test, wine, item.entry, elf, exe)
        unused NativeAssert(*test, !item.traps || reference.code == 125,
            CheckConcat(item.entry, ": an expected trap did not trap"))
    }
    if !NativeAssert(*test, unwind > 0, "no Windows image carried x64 unwind data") { return 1 }
    unused NativeAssert(*test, WindowsHosts(*test, tools, wine), "Windows external hosts failed")
    server := CheckExecutable("wineserver")
    if server != "" {
        stop := string.["env", "-u", "TMPDIR", server, "-k"]
        unused NativeInvoke(*test, stop[:])
    }
    if test.failed { return 1 }
    print("Windows named DLL hosts: two providers, Win64 scalar/record/float arguments, IAT/map/determinism and explicit gaps passed\n")
    version := string.["env", "-u", "TMPDIR", wine, "--version"]
    print("Windows parity: % programs print and exit as their Linux native ELFs, as PE32+ executables under %",
        cases.count + 1, NativeInvoke(*test, version[:]).output)
    return 0
}
