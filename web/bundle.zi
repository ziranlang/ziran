// Generic browser compilation transport. Sources use the ordinary loader,
// checker and checked provider bindings before executable ZX lowering.
IR :: #import "compiler_ir"
Run :: #import "compiler_zx_run"
Assets :: #import "compiler_bundle"

#scope_file
compiler :: #system_library "ziran";
libc :: #system_library "libc";
ProgramsLoad :: (set: *IR.ProgramSet, root: *u8, paths: **u8, path_count: s32,
                inputs: **u8, input_count: s32) -> s32 #foreign compiler;
ProgramsFree :: (set: *IR.ProgramSet) #foreign compiler;
CheckCanonicalPrograms :: (programs: **IR.ZirProgram, count: s32, paths: **u8) -> s32 #foreign compiler;
LinkImports :: (programs: **IR.ZirProgram, count: s32) -> s32 #foreign compiler;
BindHostProvider :: (program: *IR.ZirProgram, binding: *u8) -> s32 #foreign compiler;
SetDiagnosticFormat :: (format: *u8) -> s32 #foreign compiler;
CompilerConfigureTarget :: (backend: s32, os: s32, cpu: s32) #foreign compiler;
ZxExecBuild :: (program: *IR.ZirProgram, module: *u8, function: *u8,
                link: *Run.ZxModuleBuild, assets: []Assets.Asset, debug: s32,
                size: *usize) -> *u8 #foreign compiler;
calloc :: (count: usize, size: usize) -> *void #foreign libc;
free :: (memory: *void) #foreign libc;
strdup :: (text: *u8) -> *u8 #foreign libc;
fopen :: (path: *u8, mode: *u8) -> *void #foreign libc;
fclose :: (file: *void) -> s32 #foreign libc;
fwrite :: (bytes: *u8, size: usize, count: usize, file: *void) -> usize #foreign libc;
fflush :: (file: *void) -> s32 #foreign libc;
remove :: (path: *u8) -> s32 #foreign libc;

CText :: struct { data: *u8; count: usize }
CString :: (text: string) -> *u8 { return (cast(*CText)(*text)).data }

Paths :: struct { items: **u8; count: s32; storage: *u8; valid: bool }
ReadPaths :: (text: *u8) -> Paths {
    result: Paths
    if text == null { return result }
    length: usize
    count: usize
    while text[length] != 0 {
        if text[length] != 10 && (length == 0 || text[length - 1] == 10) { count += 1 }
        length += 1
    }
    if count > 2147483647 { return result }
    result.storage = strdup(text)
    if result.storage == null { return result }
    if count > 0 {
        result.items = cast(**u8)calloc(count, size_of(*u8))
        if result.items == null { return result }
    }
    at: usize
    while at < length {
        if text[at] != 10 && (at == 0 || text[at - 1] == 10) {
            result.items[result.count] = *result.storage[at]
            result.count += 1
        }
        if text[at] == 10 { result.storage[at] = 0 }
        at += 1
    }
    result.valid = true
    return result
}
FreePaths :: (paths: Paths) { free(cast(*void)paths.items); free(cast(*void)paths.storage) }

#scope_export
// Roots, inputs and checked --bind descriptors are newline-separated. Empty
// roots/bindings are valid; source inputs and the output path are required.
#program_export "BuildBundle"
BuildBundle :: (root: *u8, search: *u8, inputs: *u8, entry_module: *u8,
                entry_function: *u8, bindings: *u8, output: *u8) -> s32 {
    if output == null { return 1 }
    unused remove(output)
    status: s32 = 1
    defer { if status != 0 { unused remove(output) }; unused fflush(null) }
    if root == null || entry_module == null || entry_function == null { return 1 }
    paths := ReadPaths(search); defer FreePaths(paths)
    sources := ReadPaths(inputs); defer FreePaths(sources)
    providers := ReadPaths(bindings); defer FreePaths(providers)
    if !paths.valid || !sources.valid || sources.count == 0 || !providers.valid { return 1 }
    unused SetDiagnosticFormat(CString("text"))
    CompilerConfigureTarget(3, 0, 0)
    set: IR.ProgramSet
    defer ProgramsFree(*set)
    if ProgramsLoad(*set, root, paths.items, paths.count, sources.items, sources.count) == 0 ||
        CheckCanonicalPrograms(set.programs, set.count, set.paths) == 0 { return 1 }
    merged: IR.ZirProgram
    merged.context = set.context
    for p: cast(s32)0..set.count - 1 { merged.module_count += set.programs[p].module_count }
    merged.modules = cast(*IR.ZirModule)calloc(cast(usize)merged.module_count, size_of(IR.ZirModule))
    if merged.modules == null { return 1 }
    defer free(cast(*void)merged.modules)
    at: s32
    for p: cast(s32)0..set.count - 1 {
        for m: cast(s32)0..set.programs[p].module_count - 1 {
            merged.modules[at] = set.programs[p].modules[m]
            at += 1
        }
    }
    program := *merged
    if LinkImports(*program, 1) == 0 { return 1 }
    for index: cast(s32)0..providers.count - 1 {
        if BindHostProvider(*merged, providers.items[index]) == 0 { return 1 }
    }
    link: Run.ZxModuleBuild
    assets: []Assets.Asset
    size: usize
    bytes := ZxExecBuild(*merged, entry_module, entry_function, *link, assets, 0, *size)
    if bytes == null { return 1 }
    defer free(cast(*void)bytes)
    file := fopen(output, CString("wb"))
    if file == null { return 1 }
    written := fwrite(bytes, 1, size, file) == size
    closed := fclose(file) == 0
    if written && closed { status = 0 }
    return status
}
